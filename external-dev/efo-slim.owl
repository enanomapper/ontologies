        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>quantification of the presence and amount of neurofibrillary tangles, pathological protein aggregates formed by hyperphosphorylation of a microtubule-associated protein known as tau</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>neurofibrillary tangles measurement</rdfs:label>
