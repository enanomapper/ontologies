        <oboInOwl:hasDbXref>SNOMEDCT:398700009</oboInOwl:hasDbXref>
        <rdfs:label>age at menarche</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004704 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004704">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0000246"/>
        <obo:IAO_0000115>The age of onset of (human) menopause, the beginning of the first menstrual cycle in an individual</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C106497</oboInOwl:hasDbXref>
