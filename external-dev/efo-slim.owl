        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005738"/>
        <obo:IAO_0000115>46C is an embryonic stem cell line, constructed in the laboratory of Austin Smith, in which a drug resistance gene is placed under the control of a Sox1 promoter.  Cells were isolated from the 129a mouse strain. [PMID: 12524553]</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PMID:12524553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_Y482</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>46C ES</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ES-46C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ES46C</oboInOwl:hasExactSynonym>
