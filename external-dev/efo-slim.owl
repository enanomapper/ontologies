        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0003040"/>
        <obo:IAO_0000115>A tumorous blood cell line made from flies homozygous for the malignant blood neoplasm mutation l(2)mbn (Gateff, 1980).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PMID:21177962</oboInOwl:hasDbXref>
        <rdfs:label>mbn2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005821 -->


