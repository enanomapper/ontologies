        <oboInOwl:hasDbXref>uniprot:P56817</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ASP2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BACE1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>aspartyl protease 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>beta-site APP cleaving enzyme 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>beta-site amyloid precursor protein cleaving enzyme 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>memapsin-2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>membrane-associated aspartic protease 2</oboInOwl:hasExactSynonym>
        <rdfs:label>beta-secretase 1 measurement</rdfs:label>
    </owl:Class>
    


