    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004461 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004461">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>An iron biomarker measurement is a measurement of some molecule e.g. protein or metabolite which is used as a measure of iron metabolism</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
