        <rdfs:label>triglyceride measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004531 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004531">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>A urate measurement is the quantification of some urate in body fluid</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C64814</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>urate levels</oboInOwl:hasExactSynonym>
