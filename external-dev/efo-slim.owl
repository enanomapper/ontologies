        <oboInOwl:hasExactSynonym>HDL measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>high density lipoprotein cholesterol measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004614 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_1001017"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004732"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004872"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>Is a quantification of apolipoprotein A 1 in a sample. It is encoded in humans by the APOA1 gene and is the major protein component of high density lipoprotein (HDL) in plasma. Apolipoprotein A 1 relates to lower observational risk of coronary artery disease.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>https://www.uniprot.org/uniprotkb/P02647/entry</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>apo-AI levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>apoA-I levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>apolipoprotein A-1 levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>apolipoprotein A-I levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>apolipoprotein A1 levels</oboInOwl:hasExactSynonym>
        <rdfs:label>apolipoprotein A 1 measurement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Is a quantification of apolipoprotein A 1 in a sample. It is encoded in humans by the APOA1 gene and is the major protein component of high density lipoprotein (HDL) in plasma. Apolipoprotein A 1 relates to lower observational risk of coronary artery disease.</owl:annotatedTarget>
        <efo:definition_citation>PMID:32113648</efo:definition_citation>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004615 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_1001017"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004732"/>
        <obo:IAO_0000115>The measurement of ApoB in blood. Apolipoprotein B is a major protein constituent of chylomicrons (apo B-48), LDL (apo B-100) and VLDL (apo B-100). Apo B-100 functions as a recognition signal for the cellular binding and internalization of LDL particles by the apoB/E receptor, and is upregulated in response to enterovirus 71.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://www.uniprot.org/uniprot/P04114</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C74734</oboInOwl:hasDbXref>
        <rdfs:label>apolipoprotein B measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004617 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004617">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>is a quantification of serum cystatin C C (formerly gamma trace, post-gamma-globulin or neuroendocrine basic polypeptide),[1] a protein encoded by the CST3 gene, is mainly used as a biomarker of kidney function and kidney disease.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C92290</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>uniprot:P01034</oboInOwl:hasDbXref>
        <rdfs:label>cystatin C measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004618 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004618">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004729"/>
        <obo:IAO_0000115>is a quantification of Vitamin K or Phylloquinone, a polycyclic aromatic ketone, based on 2-methyl-1,4-naphthoquinone, with a 3-phytyl substituent. It is a fat-soluble vitamin that is stable to air and moisture but decomposes in sunlight. It is found naturally in a wide variety of green plants, particularly leaves, since it functions as an electron acceptor during photosynthesis, forming part of the electron transport chain of Photosystem I.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C74907</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:105030006</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>phylloquinone measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>vitamin K measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004619 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004619">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>Is a quantification of factor VII in serum,  (formerly known as proconvertin) is one of the proteins that causes blood to clot in the coagulation cascade. It is an enzyme (EC 3.4.21.21) of the serine protease class. Abnormal measurements of factor VII may be associated with congenital deficiency of factor VII, disseminated intravascular coagulation (DIC), fat malabsorption, liver disease (such as cirrhosis). Vitamin K deficiency, Warfarin (Coumadin) use.</obo:IAO_0000115>
        <efo:definition_citation>http://www.nlm.nih.gov/medlineplus/ency/article/003676.htm</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C81960</oboInOwl:hasDbXref>
        <rdfs:label>factor VII measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004620 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004620">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004843"/>
        <obo:IAO_0000115>is a quantification of Vitamin B12, vitamin B12 or vitamin B-12, is a water-solublevitamin with a key role in the normal functioning of the brain and nervous system, and for the formation of blood. It is one of the eight B vitamins. It is normally involved in themetabolism of every cell of the human body, especially affecting DNA synthesis and regulation, but also fatty acid synthesis and energy production. It is the largest and most structurally complicated vitamin and can be produced industrially only through bacterial fermentation-synthesis.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://en.wikipedia.org/wiki/Vitamin_B12</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C64817</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:14598005</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vitamin B12 levels</oboInOwl:hasExactSynonym>
        <rdfs:label>vitamin B12 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004621 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004621">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004843"/>
        <obo:IAO_0000115>is a quantification of Vitamin B6 a water soluble vitamin</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://en.wikipedia.org/wiki/Vitamin_B12</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C74901</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:11829003</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vitamin B6 levels</oboInOwl:hasExactSynonym>
        <rdfs:label>vitamin B6 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004625 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004625">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>A progranulin measurement is a quantification of progranulin, typically in blood. Progranulins are secreted glycosylated peptides implicated in frontotemporal disease, and low levels of progranulin are a risk factor for frontotemporal disease</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>uniprot:P28799</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>progranulin levels</oboInOwl:hasExactSynonym>
        <rdfs:label>progranulin measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004626 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004626">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005127"/>
        <obo:IAO_0000115>Is the quantification of IGFBP-3, a member of  the insulin-like growth factor-binding protein (IGFBP) family and encodes a protein with an IGFBP domain and a thyroglobulin type-I domain. Decreased  IIGFBP3 protein levels are used as a biomarker for prostate cancer progression.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>Insulin-Like Growth Factor Binding Protein 3 levels</oboInOwl:hasExactSynonym>
        <rdfs:label>IGFBP-3 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004627 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004627">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004730"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005127"/>
        <obo:IAO_0000115>Is the quantification of Insulin-like growth factor 1 (IGF-1), also called somatomedin C. IGF-1 is a hormone similar in molecular structure to insulin. It plays an important role in childhood growth and continues to have anabolic effects in adults. Levels of IGF-1 are known to increase in some cancers.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://en.wikipedia.org/wiki/IGF-1</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>Insulin-Like Growth Factor 1 levels</oboInOwl:hasExactSynonym>
        <rdfs:label>IGF-1 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004630 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004630">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004503"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>Is a quantification of factor VIII in serum, Factor VIII (FVIII) is an essential blood clotting protein, also known as anti-hemophilic factor (AHF). In humans, Factor VIII is encoded by the F8 gene.[1][2] Defects in this gene results in hemophilia A.</obo:IAO_0000115>
        <efo:definition_citation>http://en.wikipedia.org/wiki/Factor_viii</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C81961</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>factor VIII levels</oboInOwl:hasExactSynonym>
        <rdfs:label>factor VIII measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004632 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004632">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>A nevus count is the quantification of nevi on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>https://labtestsonline.org/understanding/analytes/differential/tab/test</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>nevus count</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004633 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004633">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004503"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004813"/>
        <obo:IAO_0000115>Is a quantification of Protein C, also known as autoprothrombin IIA and blood coagulation factor XIV,] is a zymogenic (inactive) protein, the activated form of which plays an important role in regulating blood clotting, inflammation, cell death and maintaining the permeability of blood vessel walls in humans and other animals.</obo:IAO_0000115>
        <efo:definition_citation>http://en.wikipedia.org/wiki/Protein_c</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>coagulation factor XIV</oboInOwl:hasExactSynonym>
        <rdfs:label>protein C measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004635 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004635">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004730"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>is a quantification of circulating soluble leptin receptor levels, these are inversely associated with diabetes risk factors, including adiposity and insulin resistance, and highly correlated with the expression levels of leptin receptor. Variations in the leptin receptor gene are reported to be associated with obesity.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>leptin receptor levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>soluble leptin receptor levels</oboInOwl:hasExactSynonym>
        <rdfs:label>leptin receptor measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004637 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004637">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004503"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>is a quantification of protein S, a vitamin K-dependent plasma glycoprotein synthesized in the endothelium involved in anticoagulation and used in the diagnosis of thrombosis.</obo:IAO_0000115>
        <efo:definition_citation>http://en.wikipedia.org/wiki/Protein_s</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C100436</oboInOwl:hasDbXref>
        <rdfs:label>protein S measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004640 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004640">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004503"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004813"/>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>Is a quantifictaion of blood haptoglobin. This test is used as in the diagnosis of tranfusion reaction and  haemolytic anaemia.</efo:definition_citation>
        <efo:definition_citation>http://www.nlm.nih.gov/medlineplus/ency/article/003634.htm</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>uniprot:P00738</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>haptoglobin levels</oboInOwl:hasExactSynonym>
        <rdfs:label>haptoglobin measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004641 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004641">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>White matter integrity is a measure of brain white matter using brain imaging and quantification techniques. White matter integrity is used as a measure of CNS function.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>white matter integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004644 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004644">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>Is a measurement of the T-peak to T-end (TPE) interval on an electrocardiogram, is a measure of myocardial dispersion of repolarization and is associated with an increased risk of ventricular arrhythmias.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/22342860</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>TPE interval measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004670 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004670">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005194"/>
        <obo:IAO_0000115>Is the quantification of Beta-amyloid 1-42 in cerebrospinal fluid typically used as a biomarker for Alzheimer&apos;s Disease</obo:IAO_0000115>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>CSF AB1-42 levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CSF Aβ1-42 levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>amyloid-beta 1-42 measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>beta-amyloid 1-42 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004682 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004682">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0000719"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004327"/>
        <obo:IAO_0000115>The QT interval is a measure of the time between the start of the Q wave and the end of the T wave in the heart&apos;s electrical cycle</obo:IAO_0000115>
        <efo:definition_citation>http://en.wikipedia.org/wiki/QT_interval</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>MedDRA:10037701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIt:C83501</oboInOwl:hasDbXref>
        <rdfs:label>QT interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004685 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004685">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004324"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004512"/>
        <obo:IAO_0000115>Measurements of the hip.</obo:IAO_0000115>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>hip geometry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004694 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004694">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004503"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>Is a quantification of Factor XI, typically in blood. Factor Xi is a serine protease involved in the process of coagulation.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://en.wikipedia.org/wiki/Factor_XI</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>factor XI measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004695 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_2060173"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004731"/>
        <obo:IAO_0000115>Is a quantification of intraocular pressure. Increased intraocular pressure is a heritable risk factor for primary open angle glaucoma.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>intraocular pressure measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004696 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004696">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004555"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0011008"/>
        <obo:IAO_0000115>Is a quantification of sex hormone binding globulin. In men the test is used in when investigating testosterone deficiency.  The SHBG glycoprotein binds to circulating estradiol and testosterone, low levels of SHBG may be implicated in breast cancer etiology.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://labtestsonline.org.uk/understanding/analytes/shbg/tab/test/</efo:definition_citation>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/22675492</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>uniprot:P04278</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>SHBG level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SHBG levels</oboInOwl:hasExactSynonym>
        <rdfs:label>sex hormone-binding globulin measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004697 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004697">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004529"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0011007"/>
        <obo:IAO_0000115>Is a quantification of circulating estradiol a circulating steriod sex hormone.</obo:IAO_0000115>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C74782</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:37538009</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>estradiol levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oestrogen level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oestrogen levels</oboInOwl:hasExactSynonym>
        <rdfs:label>estradiol measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004703 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004703">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0000246"/>
        <obo:IAO_0000115>The age of onset of (human) menarche, the beginning of the first menstrual cycle in an individual</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
