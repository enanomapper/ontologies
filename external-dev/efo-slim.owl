    <!-- http://www.ebi.ac.uk/efo/EFO_0007098 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0007098">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005740"/>
        <obo:IAO_0000115>Human induced pluripotent stem cell line line derived from foreskin fibroblasts, isolated as described by Yu, J. et al. Human induced pluripotent stem cell lines free of vector and transgene sequences. Science 324, 797-801 (2009). Cells were received from the James Thomson laboratory, who originally reprogrammed the cells from fibroblasts provided by ATCC. The first set of numbers before the period refer to different clones, the number after the period indicates the sub-clone. Cells were maintained on mTeSR medium.</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSM706073</efo:definition_citation>
        <oboInOwl:hasDbXref>PMID:19325077</oboInOwl:hasDbXref>
