        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002926"/>
        <obo:IAO_0000115>An immortalized cell line from hTERT-infected myometrial cells (hTERT-HM). Cells were isolated from myometrial tissue obtained from women undergoing hysterectomy, and retroviral infection was used to express the catalytic subunit of telomerase in myometrial cells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PMID:12135889</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myometrial cells</oboInOwl:hasExactSynonym>
        <rdfs:label>hTERT-HM</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005913 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005913">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002926"/>
        <obo:IAO_0000115>Primary ureter cell culture of urothelial cells derived from a 12 year-old girl and immortalized by transfection with a temperature-sensitive SV-40 large T antigen gene.</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <efo:definition_citation>PMCID: PMC1240407</efo:definition_citation>
        <oboInOwl:hasDbXref>NCIt:C33841</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID: 8788275</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>UROtsa cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>human ureter cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>urothelial cell</oboInOwl:hasExactSynonym>
        <rdfs:label>urothelium cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005914 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005914">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002887"/>
