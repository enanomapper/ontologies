    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001621 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001621">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
