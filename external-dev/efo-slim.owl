        <obo:IAO_0000115>quantification of the ratio of the protein albumin to globulin in the blood serum</obo:IAO_0000115>
        <obo:IAO_0000117>Aoife McMahon</obo:IAO_0000117>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>PMID:29403010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://www.ebi.ac.uk/efo/EFO_0005128</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ALBGLOB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Albumin to Globulin Ratio Measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Albumin/Globulin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>albumin-globulin ratio measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>albumin:globulin ratio measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005131 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005131">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0006848"/>
        <obo:IAO_0000115>quantification of homovanillic acid (HVA) in cerebrospinal fluid. HVA/5-HIAA ratios may be used as biomarkers for suicidial behavior.</obo:IAO_0000115>
        <obo:IAO_0000115>quantification of homovanillic acid in cerebrospinal fluid</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>HVA measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005132 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005132">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004725"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005127"/>
        <obo:IAO_0000115>quantification of 5-hydroxyindoleacetic acid in cerebrospinal fluid or urine. 5-HIAA is a metabolite of serotonin.
 This measurement is performed during diagnosis of serotonin secreting neuroendocrine tumours.
Low levels of 5-HIAA in the cerebrospinal fluid have been associated with aggressive behavior and suicide by violent means, correlating with diminished serotonin levels.
Elevated serotonin (hyperserotonemia) is one of the most common biological findings in autism[3] and 5-HIAA may be elevated in patients with autistic spectrum disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter, Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>https://en.wikipedia.org/wiki/5-Hydroxyindoleacetic_acid</efo:definition_citation>
        <efo:definition_citation>www.ncbi.nlm.nih.gov/pubmed/25140149</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C112217</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:104741005</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>5-Hydroxyindoleacetic acid measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>5-HIAA measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005133 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005133">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0006848"/>
        <obo:IAO_0000115>quantification of 3-methoxy-4-hydroxyphenylglycol in measured in urine, plasma or cerebrospinal fluid. MHPG is reported to be associated with neuropsychiatric disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/25709459</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>MHPG measurement</rdfs:label>
    </owl:Class>
    


