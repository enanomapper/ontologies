        <oboInOwl:hasExactSynonym>MCHC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mean corpuscular haemoglobin concentration</oboInOwl:hasExactSynonym>
        <rdfs:label>mean corpuscular hemoglobin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004529 -->


