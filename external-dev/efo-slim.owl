    <!-- http://www.ebi.ac.uk/efo/EFO_0022039 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0022039">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0020980"/>
        <obo:IAO_0000115>The invisible ultraviolet spectrum makes up one specific portion of sunlight. This unique portion accounts for three percent of all solar radiation reaching the earth. UV radiation causes many health problems</obo:IAO_0000115>
        <dc:creator>Zoe May Pendlington</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-09-16T15:53:13Z</dc:date>
        <oboInOwl:hasDbXref>NCIT:C17231</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">ultraviolet radiation exposure measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0022042 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0022042">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0600058"/>
        <obo:IAO_0000115>The P-null phenotype, also referred to as the p phenotype (previously Tj[a-]), is rare, and is defined by the lack of P, P1, and Pk on red blood cells.</obo:IAO_0000115>
        <dc:creator>Zoe May Pendlington</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-11-30T11:13:58Z</dc:date>
        <oboInOwl:hasExactSynonym>Tj[a-]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>p-null phenotype</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">p phenotype</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0022042"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The P-null phenotype, also referred to as the p phenotype (previously Tj[a-]), is rare, and is defined by the lack of P, P1, and Pk on red blood cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:34539318</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0022046 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0022046">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>Sulcal opening was defined as the average distance between both banks of the pial surface.</obo:IAO_0000115>
        <obo:IAO_0000117>Santhi Ramachandran</obo:IAO_0000117>
        <dc:creator>Zoe May Pendlington</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-03T10:50:31Z</dc:date>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label xml:lang="en">sulcal opening distance</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0022046"/>
