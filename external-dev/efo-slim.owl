    <!-- http://www.ebi.ac.uk/efo/EFO_0005043 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005043">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>Is a quantification of cardiac troponin T, typically measured in blood. Cardiac troponin T measurements are used as a marker of cardiac muscle damage and used in the diagnosis of myocardial infarction.</obo:IAO_0000115>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>cardiac troponin T level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cardiac troponin T levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hs-cTnT levels</oboInOwl:hasExactSynonym>
        <rdfs:label>cardiac troponin T measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005054 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005054">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004327"/>
        <obo:IAO_0000115>A QRS complex is a combination of the three electrocardiographical measurements of the Q, R and S waves in the heart&apos;s electrical cycle. It corresponds to the depolarization of the right and left ventricles of the human heart. The QRS complex can be further classified into a set of parameters, including QRS duration, QRS amplitude and ventricular activation time (VAT).</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:definition_citation>https://en.wikipedia.org/wiki/QRS_complex</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>MedDRA:10037693</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MedDRA:10058099</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIt:C41329</oboInOwl:hasDbXref>
        <rdfs:label>QRS complex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005056 -->


