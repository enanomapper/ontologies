    <!-- http://www.ebi.ac.uk/efo/EFO_0002796 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0002796">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
