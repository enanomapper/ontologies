    <!-- http://purl.obolibrary.org/obo/RO_0002161 -->


    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002161">
        <obo:IAO_0000115>S never_in_taxon T iff: S SubClassOf in_taxon only not T</obo:IAO_0000115>
