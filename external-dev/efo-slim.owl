        <oboInOwl:hasExactSynonym>homocysteine levels</oboInOwl:hasExactSynonym>
        <rdfs:label>homocysteine measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004581 -->


