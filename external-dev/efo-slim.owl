    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004468 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004468">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0006842"/>
