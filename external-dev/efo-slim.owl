        <oboInOwl:hasDbXref>SNOMEDCT:61928009</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>blood platelet number</oboInOwl:hasExactSynonym>
        <rdfs:label>platelet count</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004312 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004312">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0003892"/>
        <obo:IAO_0000115>The volume of air that is exhaled by a maximal expiration following a maximal inspiration.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
