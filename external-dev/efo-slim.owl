        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>PRISm</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">preserved ratio impaired spirometry</rdfs:label>
    </owl:Class>
    


