    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004462 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004462">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004327"/>
        <obo:IAO_0000115>A PR interval is an  electrocardiography measurement which measures from the beginning of the P wave to the beginning of the QRS complex in the heart&apos;s electrical cycle</obo:IAO_0000115>
