        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0007987"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0803540"/>
        <obo:IAO_0000115>Is a quantification of eosinphils in blood.</obo:IAO_0000115>
        <obo:IAO_0000115>The number of granulocytes (polymorphonuclear leukocytes) in a specified volume of blood, usually 1 cubic millimeter.</obo:IAO_0000115>
