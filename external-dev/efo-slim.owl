        <obo:IAO_0000115>quantification of the microstructre of the white matter of the brain</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>white matter microstructure measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005675 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005675">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>the quantification of vitamin D-binding protein in blood as a biomarker for vitamin D-related diseases such as osteoporosis, arthritis, cardiovascular disease and cancer</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>uniprot:P02774</oboInOwl:hasDbXref>
        <rdfs:label>vitamin D-binding protein measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005677 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005677">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>quantification of the onset of puberty in human males and females through a series of proxy measurements such as genital enlargement (males) or breast development (females). These characteristics are assessed based on pre-defined scales either through self-reporting or through assessment by a medical professional.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>puberty onset measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005680 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_VT0010046"/>
        <obo:IAO_0000115>The determination of the amount of omega-6 polyunsaturated fatty acids present in a sample.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>omega-6 polyunsaturated fatty acid measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005682 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005682">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0003892"/>
        <obo:IAO_0000115>quantification of the relative amount of oxygen that is dissolved or carried in a given medium</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C60832</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:104847001</oboInOwl:hasDbXref>
        <rdfs:label>oxygen saturation measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005689 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005689">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004529"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004732"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>The quantification of NHDL cholesterol in blood, calculated by subtracting the amount of cholesterol in the HDL fraction from total cholesterol and used as an indicator for cardiovascular disease risk</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>NCIt:C116204</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>NHDL cholesterol measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>non-high density lipoprotein cholesterol measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005691 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005691">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>The quantification in blood of trimethylamine N-oxide, a product of gut microbiome and hepatic-mediated metabolism of dietary choline and L-carnitine</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>TMAO measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>plasma trimethylamine N-oxide measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005694 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005694">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <obo:IAO_0000115>KMS-11 cell line was derived from four patients with multiple myeloma. These cells represent a later stage of B-cell differentiation, and shows characteristics of plasma cells by secreting surface kappa chain immunoglobulins.</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/2768132</efo:definition_citation>
        <oboInOwl:hasDbXref>PMID:2519219</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>KMS11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>KMS_11</oboInOwl:hasExactSynonym>
        <rdfs:label>KMS-11</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005696 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005696">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>Medulloblastoma (aka D721), surgical resection from a patient with medulloblastoma as described by Darrell Bigner (1997)</obo:IAO_0000115>
        <efo:definition_citation>http://cellfinder.org/ontology?id=CELDA_00006808</efo:definition_citation>
        <oboInOwl:hasExactSynonym>D-721</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D-721 Med</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D-721Med</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D721</oboInOwl:hasExactSynonym>
        <rdfs:label>D721Med</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005697 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005697">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>M059J cells were isolated from a tumor specimen taken from a 33 year old male with untreated malignant glioblastoma. The cells were isolated concurrently from the same tumor specimen as M059K (see CRL-2365).</obo:IAO_0000115>
        <efo:definition_citation>http://www.atcc.org/products/all/CRL-2366.aspx#generalinformation</efo:definition_citation>
        <oboInOwl:hasDbXref>CLO:0007445</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_0400</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CRL_2366</oboInOwl:hasExactSynonym>
        <rdfs:label>M059J</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005698 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005698">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>The Daoy cell line was established in 1985 by P. F Jacobsen of the Royal Perth Hospital in Western Australia. The line was derived from biopsy material taken from a tumor in the posterior fossa of a 4 year old boy.</obo:IAO_0000115>
        <efo:definition_citation>http://www.atcc.org/Products/All/HTB-186.aspx</efo:definition_citation>
        <oboInOwl:hasDbXref>BTO:0004328</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0002699</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_1167</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>D-324 Med</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D-324MED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D324</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D324 MED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HTB186</oboInOwl:hasExactSynonym>
        <rdfs:label>Daoy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005700 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005700">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>This is an adherent cell line derived from a hepatic rhabdoid tumor. Hepatic rhabdoid tumors are extremely rare. This cell line has a large deletion on 22q, which indicates numerous genes in addition to SNF5 are deleted.</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/12973738</efo:definition_citation>
        <efo:definition_citation>https://genome.ucsc.edu/ENCODE/protocols/cell/human/MRTTTC549_Crawford_protocol.pdf</efo:definition_citation>
        <oboInOwl:hasExactSynonym>MRTTTC549</oboInOwl:hasExactSynonym>
        <rdfs:label>TTC549</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005702 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005702">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>A malignant rhabdoid tumor diploid cell population cloned from the A204 ATCC cell line. [PMID: 16897758]</obo:IAO_0000115>
        <efo:definition_citation>http://www.atcc.org/products/all/HTB-82.aspx</efo:definition_citation>
        <efo:definition_citation>http://www.jbc.org/content/257/15/9016.full.pdf</efo:definition_citation>
        <rdfs:label>A204.1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005703 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005703">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001643"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>This is an adherent cell line that represents the prototypical renal rhabdoid tumor [PMID: 16897758]. G401.6 is a diploid, 6-thioguanine-resistant clonal variant of the G401 cell line isolated by Weissman et al., Science, 236:175-180 (1986). The parental cell line, G401, can be ordered from the ATCC (CRL1441).</obo:IAO_0000115>
        <efo:definition_citation>http://genome.ucsc.edu/ENCODE/protocols/cell/human/MRTG401.6_Crawford_protocol.pdf</efo:definition_citation>
        <oboInOwl:hasExactSynonym>MRT_G401.6</oboInOwl:hasExactSynonym>
        <rdfs:label>G401.6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005704 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005704">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005216"/>
        <obo:IAO_0000115>HuH-7 is a well differentiated hepatocyte derived cellular carcinoma cell line that was originally taken from a liver tumor in a 57-year-old Japanese male in 1982. The line was established by Nakabayshi, H. and Sato, J. HuH-7 is an immortal cell line of epithelial-like tumorigenic cells. It usually grow in 2D monolayers. HuH7.5 developed from HuH7.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0004126</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_7927</oboInOwl:hasDbXref>
        <rdfs:label>HuH-7.5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005705 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005705">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002922"/>
        <obo:IAO_0000115>Nasal biopsies were collected from volunteer donors as an outpatient procedure as described (Feron et al., 1998). This was done by a registered otolaryngologist via an endoscopic procedure to ensure biopsy samples were taken from the superior, posterior region of the nasal septum close to the cribriform plate. Pieces of olfactory mucosa were obtained which contain stem cells in the olfactory epithelium. The stem cell population derived from human olfactory mucosa has been described as ecto-mesenchymal (Delorme et al., 2010) because it has characteristics of both neural and mesenchymal stem cells, suggesting a neural crest origin.</obo:IAO_0000115>
        <rdfs:label>olfactory neurosphere cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005706 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BTO_0000849"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115> in the Surgery Branch of the NCI.&quot;&gt;This cell line was from a melanoma metastasis tumor taken from the subcutaneous shoulder of an individual. Cell line was derived by Dr. Yardena Samuels (samuelsy[at]mail.nih.gov)</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3947167/</efo:definition_citation>
        <oboInOwl:hasDbXref>BTO:0000849</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Mel 2183</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mel_2183</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Melanoma Mel-2183</oboInOwl:hasExactSynonym>
        <rdfs:label>Mel-2183</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005707 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005707">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001643"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>This line was derived from a primary clear cell adenocarcinoma. The karyotype is hypertriploid; Y was present in 60% the cells examined. The cells display both microvilli and desmosomes, and can be grown in soft agar. The cells produce a PTH like peptides that is identical to peptides produced by breast and lung tumors.</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed?cmd=Retrieve&amp;list_uids=721102&amp;dopt=AbstractPlus</efo:definition_citation>
        <oboInOwl:hasDbXref>BTO:0003781</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIt:C117211</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_1051</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>786_0</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CRL-1932</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RCC 7860</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RCC7860</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RCC_7860</oboInOwl:hasExactSynonym>
        <rdfs:label>786-0</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005709 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005709">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>First trimester human trophoblast cells established by immortalizing a physiologic extravillous trophoblast cell via transfection with a plasmid containing the simian virus 40 large T antigen (SV40) (see Graham et al., 1993). Cells are a thin layer of ectoderm that forms the wall of many mammalian blastulas and functions in the nutrition and implantation of the embryo.</obo:IAO_0000115>
        <efo:definition_citation>http://www.sciencedirect.com/science/article/pii/S0014482783711390#</efo:definition_citation>
        <oboInOwl:hasExactSynonym>HTR-8-SVNEO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HTR-8/SVneo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HTR8-SVNEO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>htr_8_svneo</oboInOwl:hasExactSynonym>
        <rdfs:label>HTR8/SVneo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005710 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005710">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002009"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>This is an adherent cell line. HFF-Myc are human foreskin fibroblasts containing a virally integrated vector expressing the canine cMyc gene. Cells were received from Dr. Beverly Torok-Storb, Fred Hutchison Cancer Research Center, Seattle, WA.</obo:IAO_0000115>
        <efo:definition_citation>http://www.plosone.org/article/info%3Adoi%2F10.1371%2Fjournal.pone.0005951</efo:definition_citation>
        <oboInOwl:hasExactSynonym>HFF Myc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HFF cMyc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HFF-cMyc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HFF_Myc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HFF_cMyc</oboInOwl:hasExactSynonym>
        <rdfs:label>HFF-Myc</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005711 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005711">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002922"/>
        <obo:IAO_0000115>Normal benign adult human pancreatic duct cells immortalized with E6E7 gene of HPV-16. HPDE6-E6E7 cells demonstrated a near normal genotype and phenotype of pancreatic duct epithelial cells. [PMC1861644]</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1885733/</efo:definition_citation>
        <oboInOwl:hasDbXref>BTO:0002362</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>HPDE-6/E6E7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HPDE-6E6E7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HPDE-6_E6E7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HPDE6-E6E7-HPV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pancreatic duct cells E6E7</oboInOwl:hasExactSynonym>
        <rdfs:label>HPDE6-E6E7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005712 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BTO_0000849"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>Human skin malignant melanoma cells that can be ordered from ATCC. This is a hyperdiploid human cell line with the modal chromosome number of 49, occurring in 24% of cells. Polyploid cells occurred at 22%, which is high. Cells are adherent, and were first harvested in 1971 from a metastatic site in a lymph node.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0003508</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0008877</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_1666</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>RPMI 7951</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RPMI7951</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RPMI_7951</oboInOwl:hasExactSynonym>
        <rdfs:label>RPMI-7951</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005713 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005713">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>Human pancreas adenocarcinoma (PA-TU-8988T), &quot;established in 1985 from the liver metastasis of a primary pancreatic adenocarcinoma from a 64-year-old woman; sister cell line of PA-TU-8988S&quot; - DSMZ.</obo:IAO_0000115>
        <obo:IAO_0000117>Laura Huerta</obo:IAO_0000117>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/1348891</efo:definition_citation>
        <oboInOwl:hasDbXref>BTO:0001521</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>8988 T</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>8988-T</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ACC 162</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PA-TU-8988T</oboInOwl:hasExactSynonym>
        <rdfs:label>8988T</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005714 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BTO_0000256"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>Skeletal myoblasts derived from satellite cells from the pectoralis major muscle of a 41 year old caucasian heart transplant donor, immortalized with lox-hygro-hTERT (LH), and Cdk4-neo (CN), Zhu et al. (2007) in Aging Cell, vol. 6, pp 515-523. M2 is an extremely well-differentiating subclone of LHCN (thus &quot;LHCN-M2&quot;).</obo:IAO_0000115>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pubmed/17559502</efo:definition_citation>
        <oboInOwl:hasDbXref>BTO:0000023</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0005046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_8890</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>LHCN M2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>LHCNM2</oboInOwl:hasExactSynonym>
        <rdfs:label>LHCN-M2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005715 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005715">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>The WERI-Rb-1 line is one of two human retinoblastoma cell lines established in 1974 by R.M. McFall and T.W. Sery. This is a near diploid line. The modal chromosome number is 47 occurring at 38%, and the rate of polyploidy is 9%. Cells are grape-like clusters of round cells in suspension.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001178</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0009583</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0009584</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0051563</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:844036</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_1792</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>WERI Rb 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>WERI_Rb_1</oboInOwl:hasExactSynonym>
        <rdfs:label>WERI-Rb-1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005718 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005718">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>&quot;The cell line Ishikawa was established from an endometrial adenocarcinoma of a 39 year old woman. Cells can be commercially obtained from Sigma (99040201-1VL). However, it should be noted that the original source of these cells (M. Nashide, Japan) can spontaneously lose the progesterone and
estrogen receptor. For details, see Nishida M., The Ishikawa cells from birth to the
present. Hum Cell. 2002 Sep;15(3):104-17.&quot;</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0003041</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0037163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_2529</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Ishikawa cell</oboInOwl:hasExactSynonym>
        <rdfs:label>Ishikawa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005719 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005719">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002937"/>
        <obo:IAO_0000115>Established from a pleural effusion of 73 year-old woman diagnosed with B-cell non-Hodgkin lymphoma (intra-abdominal, diffuse large cell lymphoma, refractory, terminal). Cells are available from Dr Abraham Karpas, Department of Haematology, University of Cambridge, and are round and polygonal, growing in suspension. [PMID: 2297573]</obo:IAO_0000115>
        <efo:definition_citation>https://ximbio.com/reagent/152419/karpas-422-cell-line</efo:definition_citation>
        <oboInOwl:hasExactSynonym>Karpas 422 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Karpas-422</oboInOwl:hasExactSynonym>
        <rdfs:label>Karpas 422</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005720 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BTO_0000849"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>This melanoma cell line was derived from a metastatic axillary node of the skin of a 24 year old female. It is a hyperpentaploid human cell line with the modal chromosome number of 120, occurring in 9% of cells. [PMID: 1067619]</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0002134</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0009047</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIt:C117190</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12828737</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_0527</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>AA-Mel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mel-5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SK MEL 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SK-MEL-5 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SKMEL5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SK_MEL_5</oboInOwl:hasExactSynonym>
        <rdfs:label>SK-MEL-5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005721 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005721">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005214"/>
        <obo:IAO_0000115>SK-N-DZ is a neuroblastoma cell line derived in 1978 from a bone marrow metastasis from a child with poorly differentiated embryonal neuroblastoma.</obo:IAO_0000115>
        <efo:definition_citation>http://cancerres.aacrjournals.org/content/47/20/5433.full.pdf</efo:definition_citation>
        <oboInOwl:hasExactSynonym>SK N DZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SK-N-DZ cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SKNDZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SK_N_DZ</oboInOwl:hasExactSynonym>
        <rdfs:label>SK-N-DZ</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005722 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005722">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001639"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002009"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>The line was established from cells from the bone marrow of a child with rhabdomyosarcoma. Derived from a metastatic site of the bone marrow. The cells show ultrastructural elements of primitive skeletal muscle differentiation.</obo:IAO_0000115>
        <obo:IAO_0000117>Ele Holloway</obo:IAO_0000117>
        <obo:IAO_0000117>James Malone</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BTO:0005379</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0037074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RRID:CVCL_0041</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CRL-2061</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RH30</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RMS 13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RMS13</oboInOwl:hasExactSynonym>
        <rdfs:label>SJRH30</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005723 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005723">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002009"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>Fibroblasts taken from a skin punch of the arm</obo:IAO_0000115>
        <efo:definition_citation>http://wiki.encodedcc.org/index.php/Scenario_9:_Personal_Genomes#PGP1_Fibroblasts.2C_iPSC_and_Derived_Samples http://cellfinder.de/ontology?id=CF_193910</efo:definition_citation>
        <efo:definition_citation>https://www.coriell.org/0/Sections/Search/Sample_Detail.aspx?Ref=GM23248&amp;product=CC</efo:definition_citation>
        <oboInOwl:hasExactSynonym>GM23248 cell</oboInOwl:hasExactSynonym>
        <rdfs:label>GM23248</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005724 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005724">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001640"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002937"/>
        <obo:IAO_0000115>MM.1S is a B lymphoblast cell line derived in 1986. The parent cell line, MM.1, was established from peripheral blood of a multiple myeloma patient who had become resistant to steroid-based therapy. provide critical information about disease progression and the development of drug resistance. This cell line represents a valuable tool for elucidating the mechanisms of action of glucocorticoids and the development of new therapeutics. [PMID: 2926241]</obo:IAO_0000115>
        <efo:definition_citation>https://www.atcc.org/Products/All/CRL-2974.aspx</efo:definition_citation>
        <oboInOwl:hasDbXref>PMID:12691914</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>MM.1 S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MM.1-S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MM.1S cell</oboInOwl:hasExactSynonym>
        <rdfs:label>MM.1S</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005725 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005725">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005214"/>
        <obo:IAO_0000115>BE(2)-C is a clone of the SK-N-BE(2) neuroblastoma cell line (ATCC CRL-2271) that was established in November of 1972 from a bone marrow biopsy taken from child with disseminated neuroblastoma after repeated courses of chemotherapy and radiotherapy. The cells grow as clusters of flattened neuroblastic cells with occasional fine cell processes (neurites). Unlike the parent line, they generally do not detach and float.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000932</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:PMC1531688</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>BE(2) C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BE(2)-C cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BE(2)_C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BE2-C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BE2C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BE2_C</oboInOwl:hasExactSynonym>
        <rdfs:label>BE(2)-C</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005726 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BTO_0001033"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002891"/>
        <obo:IAO_0000115>LNCaP clone FGC was isolated in 1977 by J.S. Horoszewicz, et al., from a needle aspiration biopsy of the left supraclavicular lymph node of a 50-year-old Caucasian male (blood type B+) with confirmed diagnosis of metastatic prostate carcinoma. This is a hypotetraploid human cell line. The modal chromosome number was 84, occurring in 22% of cells. However, cells with chromosome counts of 86 (20%) and 87 (18%) also occurred at high frequencies. These cells are responsive to 5-alpha-dihydrotestosterone (growth modulation and acid phosphatase production).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PMID:2660395</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CRL-1740</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>LNCaP clone FGC cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>LNCaP-FGC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>LNCaP_FGC</oboInOwl:hasExactSynonym>
        <rdfs:label>LNCaP clone FGC</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005728 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005728">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001641"/>
        <obo:IAO_0000115>A cell line derived from airway epithelial cells.</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BTO:0002022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Bronchiole</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>small airway epithelial cell derived cell line</oboInOwl:hasExactSynonym>
        <rdfs:label>bronchial epithelial cell derived cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005730 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000010"/>
        <obo:IAO_0000115>An endothelial cell derived cell line is defined as a cell line that derives from an endothelial cell.</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BTO:0001519</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0000091</oboInOwl:hasDbXref>
        <rdfs:label>endothelial cell derived cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005731 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005731">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005734"/>
        <obo:IAO_0000115>A cardiac myocyte cell derived cell line is defined as a cell lineage that derives from cardiac myocyte cell</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
