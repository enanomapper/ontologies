        <oboInOwl:hasDbXref>https://biobank.ndph.ox.ac.uk/showcase/field.cgi?id=22330</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>PQ interval</oboInOwl:hasExactSynonym>
        <rdfs:label>PR interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004467 -->


