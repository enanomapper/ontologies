        <oboInOwl:hasDbXref>CLO:0000076</oboInOwl:hasDbXref>
        <rdfs:label>muscle cell derived cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005735 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005735">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005734"/>
        <obo:IAO_0000115>A cell line that derives from smooth muscle cell</obo:IAO_0000115>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
