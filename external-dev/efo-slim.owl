        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>The measurement of LDL cholesterol in blood used as a risk indicator for heart disease.</obo:IAO_0000115>
