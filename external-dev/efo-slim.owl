    <!-- http://www.ebi.ac.uk/efo/EFO_0009702 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0009702">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0008354"/>
        <obo:IAO_0000115>Quantification of the variability in reaction time (the interval of time between the presentation of a stimulus to a subject and the beginning of the subject&apos;s response to that stimulus) of an individual, over successive tasks. An increase in intra-individual reaction time variability is a hallmark of neurocogintive disturbance in many neurological and psychiatric disorders, particularly ADHD.</obo:IAO_0000115>
        <obo:IAO_0000117>Laura Harris</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>PMID:30287865</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>IIRTV measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intra-individual response time variability measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>intra-individual reaction time variability measurement</rdfs:label>
    </owl:Class>
    


