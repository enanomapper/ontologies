    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006336 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006336">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004298"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004303"/>
        <obo:IAO_0000115>The blood pressure after the contraction of the heart while the chambers of the heart refill with blood.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
