    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0803378 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0803378">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>Quantification of visual masking, a phenomenon of visual perception which occurs when the visibility of one image, called a target, is reduced by the presence of another, called a mask. Timing arrangements include forward masking, backward masking, and simultaneous masking. Spatial arrangements include pattern masking and metacontrast. Visual masking deficits are potential schizophrenia endophenotypes.</obo:IAO_0000115>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label xml:lang="en">visual masking measurement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0803378"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Quantification of visual masking, a phenomenon of visual perception which occurs when the visibility of one image, called a target, is reduced by the presence of another, called a mask. Timing arrangements include forward masking, backward masking, and simultaneous masking. Spatial arrangements include pattern masking and metacontrast. Visual masking deficits are potential schizophrenia endophenotypes.</owl:annotatedTarget>
        <efo:definition_citation>PMID:36585402</efo:definition_citation>
        <efo:definition_citation>Wikipedia:Visual_masking</efo:definition_citation>
    </owl:Axiom>
    


