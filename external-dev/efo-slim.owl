    <!-- http://www.ebi.ac.uk/efo/EFO_0006827 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006827">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>quantification of some part of the renin-angiotensin-aldosterone system (RAAS), a central pathway in cardiovascular and renal physiology, critical for regulation of blood pressure and fluid balance and influencing cardiovascular remodeling</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>RAAS measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>renin–angiotensin–aldosterone system measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006828 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006828">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0006827"/>
        <obo:IAO_0000115>Quantification of the activity of the enzyme renin in the blood. Renin activates the renin-angiotensin system by cleaving angiotensinogen, produced by the liver, to yield angiotensin I, which is further converted into angiotensin II by ACE, the angiotensin-converting enzyme primarily within the capillaries of the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>plasma renin activity measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006829 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006829">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>A quantification of the variation in an individual&apos;s glomerular filtration rate (GFR) over a period of time used in assessment of kidney function and diagnosis of kidney disease.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>GFR change measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006830 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006830">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004467"/>
        <obo:IAO_0000115>quantification of the rate at which insulin is cleared from some part of the metabolism, eg from the blood</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>insulin metabolic clearance rate measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006831 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006831">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004467"/>
        <obo:IAO_0000115>quantification of insulin release in response to a controlled glucose intake, generally  calculated as the increase in insulin concentrations at 2–8 min above the basal (fasting) insulin level after the bolus glucose injection at 0–1 min</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:definition_citation>http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2128254/</efo:definition_citation>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>acute insulin response measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006832 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006832">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004467"/>
        <obo:IAO_0000115>quantification of the disposition index, the product of measures of insulin sensitivity and firstphase insulin secretion, shown to predict conversion to diabetes</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasExactSynonym>insulin disposition index measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>disposition index measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0006833 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006833">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004468"/>
        <obo:IAO_0000115>quantification of glucose effectiveness, the capacity of glucose to enhance its own cellular uptake and to suppress endogenous glucose production</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>glucose effectiveness measurement</rdfs:label>
    </owl:Class>
    


