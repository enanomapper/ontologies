    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005736 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005736">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005735"/>
        <obo:IAO_0000115>A cell line that derives from bronchial smooth muscle cell</obo:IAO_0000115>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BTO:0004402</oboInOwl:hasDbXref>
