    <!-- http://www.ebi.ac.uk/efo/EFO_0022917 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0022917">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0003892"/>
        <obo:IAO_0000115>It is defined as forced expiratory volume in 1 s (FEV1) &lt;80% predicted and FEV1/forced vital capacity (FVC) ratio ≥0.70.</obo:IAO_0000115>
        <dc:creator>Zoe May Pendlington</dc:creator>
