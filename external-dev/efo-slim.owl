    <!-- http://www.ebi.ac.uk/efo/EFO_0005745 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005745">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002926"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002935"/>
        <obo:IAO_0000115>This stable cell line is a mix of female germ-line stem cells/ovarian somatic sheet, which contains both germ-line and somatic cells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FBtc:FBtc0000191</oboInOwl:hasDbXref>
