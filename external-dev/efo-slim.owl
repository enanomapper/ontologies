        <obo:IAO_0000115>The measurement of HDL cholesterol in blood used as a risk indicator for heart disease.</obo:IAO_0000115>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>MedDRA:10020060</oboInOwl:hasDbXref>
