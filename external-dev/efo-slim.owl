    <!-- http://www.ebi.ac.uk/efo/EFO_0009172 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0009172">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004747"/>
        <obo:IAO_0000115>Is a quantification of thyroxine-binding globulin. Inherited abnormalities in the level of serum TBG have been classified as complete deficiency (TBG-CD), partial deficiency (TBG-PD), and excess (TBG-E). Patients are euthyroid (summary by Mori et al., 1995).</obo:IAO_0000115>
        <obo:IAO_0000117>Hannah McLaren</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>OMIM:300932</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>uniprot:P05543</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>TBGQTL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thyroxine-binding globulin QTL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thyroxine-binding globulin excess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thyroxine-binding globulin quantitative trait</oboInOwl:hasExactSynonym>
        <rdfs:label>thyroxine-binding globulin measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0009176 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0009176">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004529"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004730"/>
        <obo:IAO_0000115>Quantification of the suppression of adrenal gland function, typically following stimulation with adrenocorticotrophic hormone or a synthetic equivalent. Adrenal suppression may occur as a result of primary hypoadrenalism, or secondary to a number of other conditions including tuberculosis, or chronic exposure to corticosteroids.</obo:IAO_0000115>
        <obo:IAO_0000117>Laura Harris</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
