        <oboInOwl:id>enclosed_by</oboInOwl:id>
        <rdfs:label>enclosed_by</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#encloses">
        <obo:IAO_0000115>x encloses y iff the convex hull formed by x contains all or the majority of y.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>encloses</oboInOwl:id>
        <rdfs:label>encloses</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/uberon#encloses"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>x encloses y iff the convex hull formed by x contains all or the majority of y.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#evolved_from">
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>evolved_from</oboInOwl:id>
        <rdfs:comment>Status: experimental</rdfs:comment>
        <rdfs:label>evolved_from</rdfs:label>
