        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002888"/>
        <obo:IAO_0000115>TOV-112D is a human epithelial cell line initiated in October of 1992 from a patient with early onset ovarian cancer. The patient was of French-Canadian descent with an unknown family history of ovarian cancer.</obo:IAO_0000115>
        <efo:definition_citation>http://www.lgcstandards-atcc.org/products/all/CRL-11731.aspx?geo_country=gb#characteristics</efo:definition_citation>
