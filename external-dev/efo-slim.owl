    <!-- http://www.ebi.ac.uk/efo/EFO_0009132 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0009132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_1001017"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004503"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004529"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005278"/>
        <obo:IAO_0000115>Quantification of cholesterol efflux capacity, a measure of HDL functionality that quantifies the ability of an individual’s HDL to extract cholesterol from cholesterol-loaded macrophages. Efflux capacity is considered to be a predictor of atherosclerotic burden.</obo:IAO_0000115>
