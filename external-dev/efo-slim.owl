    <!-- http://www.ebi.ac.uk/efo/EFO_0011032 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0011032">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0011031"/>
        <obo:IAO_0000115>The gold standard for functional measurements of intestinal permeability in humans is the lactulose/ mannitol test, which measures urinary excretion of the two orally administered non-metabolized sugars over a 6 h period. Analysis by high pressure liquid chromatography or liquid chromatography in combination with mass spectrometry is usually performed on urine samples.</obo:IAO_0000115>
        <obo:IAO_0000117>Annalisa Buniello</obo:IAO_0000117>
        <oboInOwl:hasDbXref>PMID:31251335</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>LacMan ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lactulose mannitol test</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">fractional excretion of lactulose to mannitol ratio</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0011032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The gold standard for functional measurements of intestinal permeability in humans is the lactulose/ mannitol test, which measures urinary excretion of the two orally administered non-metabolized sugars over a 6 h period. Analysis by high pressure liquid chromatography or liquid chromatography in combination with mass spectrometry is usually performed on urine samples.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>doi: 10.1111/nmo.12871</oboInOwl:hasDbXref>
    </owl:Axiom>
    


