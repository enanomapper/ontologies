    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000053">
        <oboInOwl:hasDbXref>BFO:0000053</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>BFO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>bearer_of</oboInOwl:id>
        <oboInOwl:shorthand>bearer_of</oboInOwl:shorthand>
        <rdfs:label>bearer of</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000056">
        <oboInOwl:hasDbXref>BFO:0000056</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>participates_in</oboInOwl:id>
        <oboInOwl:shorthand>participates_in</oboInOwl:shorthand>
        <rdfs:label>participates in</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000062">
        <obo:IAO_0000115>X preceded_by Y iff: end(Y) before_or_simultaneous_with start(X)</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BFO:0000062</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>is preceded by</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>takes place after</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>preceded_by</oboInOwl:id>
        <oboInOwl:shorthand>preceded_by</oboInOwl:shorthand>
        <rdfs:comment>disjoint_from part_of, but this cannot be expressed in OWL2</rdfs:comment>
        <rdfs:label>preceded_by</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>is preceded by</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SIO:000249</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>takes place after</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Allen:precedes</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000068">
        <obo:IAO_0000115>Relation between continuant c and occurrent s, such that every instance of c comes into existing during some s.</obo:IAO_0000115>
