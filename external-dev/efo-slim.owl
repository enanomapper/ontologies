        <oboInOwl:hasExactSynonym>LDL measurement</oboInOwl:hasExactSynonym>
        <rdfs:label>low density lipoprotein cholesterol measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004612 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_1001017"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_VT0001547"/>
