        <oboInOwl:id>evolved_multiple_times_in</oboInOwl:id>
        <rdfs:comment>Status: experimental</rdfs:comment>
        <rdfs:label>evolved_multiple_times_in</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_ends_at">
        <obo:IAO_0000115>c existence_ends_at e iff c exists_at e and not ( exists e2 : c exists_at e2 and e before e2).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_ends_at</oboInOwl:id>
        <rdfs:label>existence_ends_at</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/uberon#existence_ends_at"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>c existence_ends_at e iff c exists_at e and not ( exists e2 : c exists_at e2 and e before e2).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_ends_before">
        <obo:IAO_0000115>Relation between continuant c and occurrent s, such that every instance of c ceases to exist before s.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_ends_before</oboInOwl:id>
        <rdfs:label>existence_ends_before</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/uberon#existence_ends_before"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Relation between continuant c and occurrent s, such that every instance of c ceases to exist before s.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_ends_with">
        <obo:IAO_0000115>Relation between continuant and occurrent, such that c ceases to exist at the end of p.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_ends_with</oboInOwl:id>
        <rdfs:label>existence_ends_with</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/uberon#existence_ends_with"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Relation between continuant and occurrent, such that c ceases to exist at the end of p.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_starts_after">
        <obo:IAO_0000115>Relation between continuant c and occurrent s, such that every instance of c comes into existing after some s has completed.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_starts_after</oboInOwl:id>
        <rdfs:comment>disjoint_from existence_starts_during (but this cannot be expressed in OWL2)</rdfs:comment>
        <rdfs:label>existence_starts_after</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/uberon#existence_starts_after"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Relation between continuant c and occurrent s, such that every instance of c comes into existing after some s has completed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_starts_and_ends_during">
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_starts_and_ends_during</oboInOwl:id>
        <rdfs:label>existence_starts_and_ends_during</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_starts_at">
        <obo:IAO_0000115>c existence_starts_at e iff c exists_at e and not ( exists e2 : c exists_at e2 and e2 before e)</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_starts_at</oboInOwl:id>
        <rdfs:label>existence_starts_at</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/uberon#existence_starts_at"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>c existence_starts_at e iff c exists_at e and not ( exists e2 : c exists_at e2 and e2 before e)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_starts_or_ends_during">
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_starts_or_ends_during</oboInOwl:id>
        <rdfs:label>existence_starts_or_ends_during</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/uberon#existence_starts_with">
        <obo:IAO_0000115>Relation between continuant and occurrent, such that c comes into existence at the start of p.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_starts_with</oboInOwl:id>
        <rdfs:label>existence_starts_with</rdfs:label>
