    <!-- http://www.ebi.ac.uk/efo/EFO_0006520 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006520">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>Quantification of the amount of carbon monoxide in a person&apos;s exhalation, usually measured using a breath CO monitor. Breath CO can be used for evaluation of smoking status or assessment of carbon monoxide poisoning</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
