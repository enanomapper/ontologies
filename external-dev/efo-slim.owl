    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0007987 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0007987">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004586"/>
        <obo:IAO_0000115>The number of granulocytes (polymorphonuclear leukocytes) in a specified volume of blood, usually 1 cubic millimeter.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
