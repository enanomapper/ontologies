    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005738 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005738">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002886"/>
        <obo:IAO_0000115>ESC derived cell line is a cell line that derives from an embryonic stem cell.</obo:IAO_0000115>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>ESC cell line</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic stem cell derived cell line</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;To date, human embryonic stem cell (hESC) lines have been obtained from fresh and frozen embryos of varying quality at morula and blastocyst stages of development (Hoffman and Carpenter, 2005a).&quot;

Differences between human embryonic stem cell lines
C.Allergrucci and L.E.Young

Hum. Reprod. Update (March/April 2007) 13 (2): 103-120. doi: 10.1093/humupd/dml041 First published online: August 26, 2006


http://humupd.oxfordjournals.org/content/13/2/103.full</rdfs:comment>
        <rdfs:label>ESC derived cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005740 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005740">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002886"/>
        <obo:IAO_0000115>iPSC derived cell line is a cell line that derives from iPS cells (induced pluripotent stem cell).</obo:IAO_0000115>
        <obo:IAO_0000117>Sirarat Sarntivijai</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>induced pluripotent stem cell derived cell line</oboInOwl:hasExactSynonym>
        <rdfs:label>iPSC derived cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005742 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005742">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002009"/>
        <rdfs:label>lung fibroblast derived cell line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005743 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005743">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002926"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002935"/>
        <obo:IAO_0000115>This cell line was cloned from CME W1 in the Milner lab. The line was derived from L3 dorsal mesothoracic disc (Currie et al., 1988). Transcriptome analysis suggests similarity to cells along the A/P boundary of the wing blade primordium, possibly at the D/V boundary (Cherbas et al., 2011). The sex is male, based on roX expression - (L. Cherbas).</obo:IAO_0000115>
        <efo:definition_citation>CME W1 cl.8+</efo:definition_citation>
        <efo:definition_citation>CME-W1-cl.8+	</efo:definition_citation>
        <efo:definition_citation>CME_W1_Cl.8+	</efo:definition_citation>
        <efo:definition_citation>CME_W1_Cl.8plus</efo:definition_citation>
