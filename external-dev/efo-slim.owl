    <!-- http://www.ebi.ac.uk/efo/EFO_0005419 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_2060173"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004731"/>
        <obo:IAO_0000115>quantificiation of ability to detect sharp boundaries (stimuli) and to detect slight changes in luminance at regions without distinct contours. Psychophysical measurements of this visual function are used to evaluate visual acuity and to detect eye disease.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <rdfs:label>contrast sensitivity measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005420 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005420">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0006848"/>
        <obo:IAO_0000115>quantification of the volume of grey matter in the brain, usuallly through an MRI scan. Grey matter volume is associated with schizophrenia.</obo:IAO_0000115>
