    <!-- http://www.ebi.ac.uk/efo/EFO_0004530 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_VT0001547"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004529"/>
        <obo:IAO_0000115>A triglyceride  measurement is a quantification of triglycerides in some body fluid, used as a biomarker for cardiovascular disease.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
