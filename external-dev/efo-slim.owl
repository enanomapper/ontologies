    <!-- http://www.ebi.ac.uk/efo/EFO_0011007 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0011007">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0011008"/>
        <obo:IAO_0000115>Quantification of the levels of estrogen, or osetrogen, a category of sex hormone responsible for the development and regulation of the female reproductive system and secondary sex characteristics. There are three major endogenous estrogens that have estrogenic hormonal activity: estrone (E1), estradiol (E2), and estriol (E3). Another estrogen called estetrol (E4) is produced only during pregnancy</obo:IAO_0000115>
        <obo:IAO_0000117>Aoife McMahon</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>PMID:32701512</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>estrogen levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oestrogen levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oestrogen measurement</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">estrogen measurement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0011007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Quantification of the levels of estrogen, or osetrogen, a category of sex hormone responsible for the development and regulation of the female reproductive system and secondary sex characteristics. There are three major endogenous estrogens that have estrogenic hormonal activity: estrone (E1), estradiol (E2), and estriol (E3). Another estrogen called estetrol (E4) is produced only during pregnancy</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHEBI_50114</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Estrogen</oboInOwl:hasDbXref>
    </owl:Axiom>
    


