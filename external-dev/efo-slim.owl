    <!-- http://www.ebi.ac.uk/efo/EFO_0004869 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004869">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004555"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004872"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004873"/>
        <obo:IAO_0000115>Is a quantification of the secreted glycoprotein YKL-40  (Chitinase-3-like protein 1) YKL-40 has been associated with asthma, inflammatory disease and cancer progression.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:definition_citation>http://en.wikipedia.org/wiki/CHI3L1</efo:definition_citation>
