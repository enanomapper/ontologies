        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005738"/>
        <obo:IAO_0000115>ZHBTc4 undifferentiated mouse embryonic stem cells originated from a male mouse of the 129/Ola strain, and received as frozen ampoules from D. Levasseur (University of Iowa). These cells lack functional endogenous Oct4 alleles and harbor a regulatable Oct4 transgene.</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <efo:definition_citation>PMCID:PMC2259027</efo:definition_citation>
        <oboInOwl:hasDbXref>RRID:CVCL_C715</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://genome.ucsc.edu/ENCODE/protocols/cell/mouse/ZhBTc4_Stam_protocol.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ZHBTc4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ZHBTc4 ES</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ZHBTc4 ES cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ZHBTc4 cell</oboInOwl:hasExactSynonym>
        <rdfs:label>ZHBTc4-mESC</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0005915 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005915">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002887"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0003040"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005738"/>
        <obo:IAO_0000115>Embryonic stem cells isolated from mix of ~20% C57/B6J, ~75% 129/Sv and ~5% SJL all male strains.</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <oboInOwl:hasDbXref>PMID:7638196</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>WW6 cell</oboInOwl:hasExactSynonym>
        <rdfs:label>WW6</rdfs:label>
    </owl:Class>
    


