    <!-- http://www.ebi.ac.uk/efo/EFO_0005831 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0005831">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002926"/>
