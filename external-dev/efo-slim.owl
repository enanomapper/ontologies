    <!-- http://www.ebi.ac.uk/efo/EFO_0007986 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0007986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_0002272"/>
        <obo:IAO_0000115>The number of reticulocytes per unit volume of blood. Reticulocytes are immature red blood cells and typically compose aoubt 1% of red blood cells in the human body.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
