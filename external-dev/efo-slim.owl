    <!-- http://www.ebi.ac.uk/efo/EFO_0006864 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0006864">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0000719"/>
        <obo:IAO_0000115>breastfeeding duration is a measurement of the mean number of months each mother breastfed each child, averaged across all live births and standardized to a Z-score</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
