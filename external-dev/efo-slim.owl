        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002937"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005292"/>
        <obo:IAO_0000115>MOLT-3 is a male human malignant T-lymphoblastic cell line.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001081</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLO:0007824</oboInOwl:hasDbXref>
