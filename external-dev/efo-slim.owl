    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004303">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>The signs of life that may be monitored or measured, namely pulse rate, respiratory rate, body temperature, and blood pressure.</obo:IAO_0000115>
