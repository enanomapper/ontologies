        <rdfs:label>interleukin 18 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004585 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004585">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0001444"/>
        <obo:IAO_0000115>A quantification of the naphthyl-keratin adduct levels. naphthyl-keratin adduct is used as a marker for exposure to the xenobiotic napthalene.</obo:IAO_0000115>
