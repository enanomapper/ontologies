    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BSPO_0000096">
        <obo:IAO_0000115>x anterior_to y iff x is further along the antero-posterior axis than y, towards the head. An antero-posterior axis is an axis that bisects an organism from head end to opposite end of body or tail: bearer</obo:IAO_0000115>
        <oboInOwl:created_by>cjm</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-31T02:15:46Z</oboInOwl:creation_date>
