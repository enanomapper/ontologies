    <!-- http://www.ebi.ac.uk/efo/EFO_0001233 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0001233">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0002935"/>
        <obo:IAO_0000115>Insect - fruitfly (Drosophila melanogaster) cell line, established from the late embryo of a Drosophila melanogaster (fruitfly) in 1972; originally the cells were diploid with 5-10% XY, currently the cell line has only XX cells that are now 60-80% tetraploid.</obo:IAO_0000115>
        <obo:IAO_0000117>James Malone</obo:IAO_0000117>
