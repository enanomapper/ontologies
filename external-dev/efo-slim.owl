        <obo:IAO_0000115>Human embryonic stem cell line ELF-1 was derived from a human embryo in the Ellison Stem Cell Core at the University of Washington, Seattle, WA.</obo:IAO_0000115>
        <obo:IAO_0000117>Catherine Leroy</obo:IAO_0000117>
        <efo:definition_citation>https://www.wicell.org/home/stem-cells/catalog-of-stem-cell-lines/elf1.cmsx?closable=true</efo:definition_citation>
        <oboInOwl:hasExactSynonym>ELF-1 cell</oboInOwl:hasExactSynonym>
