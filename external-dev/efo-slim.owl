    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/efo/EFO_0803376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
