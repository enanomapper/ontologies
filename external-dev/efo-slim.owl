        <oboInOwl:hasDbXref>UMLS:C0200695</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Fetal Hemoglobin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HGBF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HbF levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hemoglobin F</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fetal haemoglobin measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fetal hemoglobin levels</oboInOwl:hasExactSynonym>
        <rdfs:label>fetal hemoglobin measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004578 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_1001001"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004298"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0005134"/>
        <obo:IAO_0000115>A homocysteine measurement is the quantification of homocsyteine in blood or urine and is used in the diagnosis of  B12 and/or folate deficiency, and as part of a cardiac risk assessment.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
