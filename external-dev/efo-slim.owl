        <oboInOwl:hasExactSynonym>erythrocyte size determination</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>red cell index</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>red cell indices</oboInOwl:hasExactSynonym>
        <rdfs:label>erythrocyte indices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004307 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004307">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004468"/>
        <obo:IAO_0000115>Quantification of the ability of an individual to maintain homeostasis of blood glucose, via a test procedure including measuring blood glucose levels in a fasting state, and at prescribed intervals before and after oral glucose intake (75 or 100 g) or intravenous infusion (0.5 g/kg).</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <efo:gwas_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</efo:gwas_trait>
        <oboInOwl:hasDbXref>MESH:D005951</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MedDRA:10018432</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIt:C45946</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:113076002</oboInOwl:hasDbXref>
        <rdfs:label>glucose tolerance test</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004309 -->


    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004309">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004586"/>
        <obo:IAO_0000115>The number of PLATELETS per unit volume in a sample of venous BLOOD.</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
