    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of various medical conditions on the anal which manifests as a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
