        <obo:OAE_0004334>10051653</obo:OAE_0004334>
        <rdfs:label>parathyroid gland enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007565 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which represent an elusive endocrine neoplasia, which lead to primary hyperparathyroidism, pHPT, a common endocrine calcium disorder characterized by hypercalcemia and normal-high parathormone secretion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30477753/</obo:IAO_0000119>
        <obo:OAE_0001849>甲状旁腺肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10033963</obo:OAE_0004334>
        <rdfs:label>parathyroid tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007566 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a fibrous cyst that forms from a persistent thyroglossal duct.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroglossal_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>甲状舌囊肿</obo:OAE_0001849>
