    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115 xml:lang="en">a muscle adverse event AE that has an outcome of abnormal muscle tone, which is  an anomaly in the resting tautness or laxity of a muscle, normally somewhere in the middle of the range between total contraction and total relaxation</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label>abnormal muscle tone AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0004142</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000611 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal muscle tone AE which has an outcome of hypertonia, which is increased muscle tension resulting in stiffness of the muscles in the resting state</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:OAE_0004334>10020852</obo:OAE_0004334>
        <rdfs:label>hypertonia AE</rdfs:label>
