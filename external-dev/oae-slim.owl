        <obo:OAE_0004334>10016180</obo:OAE_0004334>
        <rdfs:label>fallopian tube cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008485 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the fallopian tube, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
