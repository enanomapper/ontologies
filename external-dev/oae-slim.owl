        <obo:OAE_0004334>10051895</obo:OAE_0004334>
        <rdfs:label>acute chest syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008837 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which generally refers to a broad, deep chest found on a patient.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Barrel_chest</obo:IAO_0000119>
        <obo:OAE_0001849>桶状胸</obo:OAE_0001849>
        <obo:OAE_0004334>10004133</obo:OAE_0004334>
