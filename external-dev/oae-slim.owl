        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a medical condition, defined as an excess of skin in the upper or lower eyelid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
