    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000604"/>
        <obo:IAO_0000115>This is an AE which refers the involuntary excretion of urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
