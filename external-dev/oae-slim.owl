        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004255"/>
        <obo:IAO_0000115>This is an AE which is infrequent (or, in occasional usage, very light) menstruation.</obo:IAO_0000115>
