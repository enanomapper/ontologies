    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005773 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which is the part of the throat behind the mouth and nasal cavity, and above the oesophagus and trachea (the tubes going down to the stomach and the lungs) and feels it discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pharynx</obo:IAO_0000119>
        <obo:OAE_0001849>口咽不适</obo:OAE_0001849>
        <obo:OAE_0004334>10068318</obo:OAE_0004334>
        <rdfs:label>oropharyngeal discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005774 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which may impede tracheal intubation or laryngeal mask airway insertion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29634531/</obo:IAO_0000119>
        <obo:OAE_0001849>口咽伤疤</obo:OAE_0001849>
        <obo:OAE_0004334>10070837</obo:OAE_0004334>
        <rdfs:label>oropharyngeal scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005775 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001255"/>
        <obo:IAO_0000115>This is an AE which can manifest as a rare complication after surgery for obstructive sleep apnea or tonsillectomy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29634531/</obo:IAO_0000119>
        <obo:OAE_0001849>口咽狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10084375</obo:OAE_0004334>
