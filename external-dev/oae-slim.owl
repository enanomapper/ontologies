    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection of a genus of anaerobic, Gram-positive, non-spore forming bacteria .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peptostreptococcus</obo:IAO_0000119>
        <obo:OAE_0001849>消化链球菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054124</obo:OAE_0004334>
        <rdfs:label>peptostreptococcus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000211"/>
        <obo:IAO_0000115>This is an AE which is a condition in which an untreated ulcer has burned through the mucosal wall in a segment of the gastrointestinal tract (e.g., the stomach or colon) allowing gastric contents to leak into the abdominal cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perforated_ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>穿孔性溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10062065</obo:OAE_0004334>
        <rdfs:label>perforated ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005866 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is an abscess adjacent to the anus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anorectal_abscess</obo:IAO_0000119>
        <obo:OAE_0001849>肛周脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10034447</obo:OAE_0004334>
        <rdfs:label>perianal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005867 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the perianal skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>肛周的红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10056273</obo:OAE_0004334>
        <rdfs:label>perianal erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005868 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>This is an AE which is a chronic motility disorder characterized by effortless regurgitation of most meals following consumption, due to the involuntary contraction of the muscles around the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rumination_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>反刍</obo:OAE_0001849>
        <obo:OAE_0004334>10027387</obo:OAE_0004334>
        <rdfs:label>merycism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005869 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005869">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>This is an AE which is the expulsion of material from the pharynx, or esophagus, usually characterized by the presence of undigested food or blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Regurgitation_(digestion)</obo:IAO_0000119>
        <obo:OAE_0001849>反流</obo:OAE_0001849>
        <obo:OAE_0004334>10067171</obo:OAE_0004334>
        <rdfs:label>regurgitation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005870 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which can present with sonographic findings similar to hypertrophic pyloric stenosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26835566/</obo:IAO_0000119>
        <obo:OAE_0001849>幽门痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10037628</obo:OAE_0004334>
        <rdfs:label>pylorospasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005871 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a narrowing of the opening from the stomach to the first part of the small intestine (the pylorus).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pyloric_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>幽门狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10037621</obo:OAE_0004334>
        <rdfs:label>pyloric stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005872 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001644"/>
        <obo:IAO_0000115>This is an AE which causes pulmonary atelectasis, secondary pneumonia, and respiratory failure is a frequent complication particularly in patients recovering from abdominal and thoracic surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/1519152/</obo:IAO_0000119>
        <obo:OAE_0001849>痰液潴留</obo:OAE_0001849>
        <obo:OAE_0004334>10059685</obo:OAE_0004334>
        <rdfs:label>sputum retention AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005873 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002587"/>
        <obo:IAO_0000115>This is an AE which is mucus with purulent that is coughed up from the lower airways (the trachea and bronchi).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sputum</obo:IAO_0000119>
        <obo:OAE_0001849>痰中带脓</obo:OAE_0001849>
        <obo:OAE_0004334>10050090</obo:OAE_0004334>
        <rdfs:label>sputum purulent AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005874 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003241"/>
        <obo:IAO_0000115>This is an AE which is complicated inflammation of the appendix.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Appendicitis</obo:IAO_0000119>
        <obo:OAE_0001849>复杂性阑尾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10081534</obo:OAE_0004334>
        <rdfs:label>complicated appendicitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005875 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is having more body fat than is optimally healthy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Overweight</obo:IAO_0000119>
        <obo:OAE_0001849>超重</obo:OAE_0001849>
        <obo:OAE_0004334>10033307</obo:OAE_0004334>
        <rdfs:label>overweight AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005876 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>This is an AE which is a symptom of pregnancy that involves nausea or vomiting.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Morning_sickness</obo:IAO_0000119>
        <obo:OAE_0001849>晨吐</obo:OAE_0001849>
        <obo:OAE_0004334>10047704</obo:OAE_0004334>
        <rdfs:label>morning sickness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005877 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the epiglottis—the flap at the base of the tongue that prevents food entering the trachea (windpipe).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epiglottitis</obo:IAO_0000119>
        <obo:OAE_0001849>会厌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10015030</obo:OAE_0004334>
        <rdfs:label>epiglottitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005878 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000115>This is an AE which is defined as a condition in which a person does not have the physical or financial capability to eat sufficient food to meet basic nutritional needs for a sustained period.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hunger</obo:IAO_0000119>
        <obo:OAE_0001849>饥饿</obo:OAE_0001849>
        <obo:OAE_0004334>10020466</obo:OAE_0004334>
        <rdfs:label>hunger AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005879 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000115>This is an AE which is a severe deficiency in caloric energy intake, below the level needed to maintain an organism&apos;s life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Starvation</obo:IAO_0000119>
        <obo:OAE_0001849>饥饿</obo:OAE_0001849>
        <obo:OAE_0004334>10041954</obo:OAE_0004334>
        <rdfs:label>starvation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005880 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is a type of inflammatory bowel disease (IBD) that may affect any segment of the gastrointestinal tract from the mouth to the anus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Crohn%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>克罗恩氏病</obo:OAE_0001849>
        <obo:OAE_0004334>10011401</obo:OAE_0004334>
        <rdfs:label>crohn&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005881 -->


