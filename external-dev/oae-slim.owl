    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008552 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which may be associated with an inability to void, sexual dysfunction, and recurrent infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30544206/</obo:IAO_0000119>
        <obo:OAE_0001849>隐性阴茎综合征</obo:OAE_0001849>
