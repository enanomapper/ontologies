    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007489 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000019"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of kidney tissue, the most common cause being capillaries damaged by trauma, causing localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>肾挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10023413</obo:OAE_0004334>
        <rdfs:label>kidney contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007490 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000286"/>
        <obo:IAO_0000115>This is an AE which in humans is associated with RET mutations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Renal_agenesis</obo:IAO_0000119>
        <obo:OAE_0001849>肾发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10064655</obo:OAE_0004334>
