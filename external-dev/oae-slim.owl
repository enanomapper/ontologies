    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008608 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002632"/>
        <obo:IAO_0000115>This is an AE which is the cord-like structure in males formed by the vas deferens (ductus deferens) and surrounding tissue that runs from the deep inguinal ring down to each testicle and its become disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spermatic_cord</obo:IAO_0000119>
        <obo:OAE_0001849>精索疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10056348</obo:OAE_0004334>
        <rdfs:label>spermatic cord disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008609 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002632"/>
        <obo:IAO_0000115>This is an AE which is a germ cell tumor of the testicle or, more rarely, the mediastinum or other extra-gonadal locations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Seminoma</obo:IAO_0000119>
        <obo:OAE_0001849>精原细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10039956</obo:OAE_0004334>
        <rdfs:label>seminoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008610 -->


