        <obo:IAO_0000115>a paralysis AE that has an outcome of paralysis in face</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;facial paralysis&apos; was mentioned in 580 VAERS reports (0.5%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label>facial paralysis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0007209</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015469</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000441 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that has an outcome of confusion, which is a mild form of delirium.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, KM</obo:IAO_0000117>
        <obo:IAO_0000118>confused state AE</obo:IAO_0000118>
        <obo:IAO_0000118>mental confusion AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/mental+confusion</obo:IAO_0000119>
        <obo:OAE_0004334>10010300</obo:OAE_0004334>
        <obo:OAE_0004334>10010305</obo:OAE_0004334>
        <rdfs:label>confusion AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12889</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C37928</rdfs:seeAlso>
    </owl:Class>
    


