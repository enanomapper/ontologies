    <!-- http://purl.obolibrary.org/obo/OAE_0002919 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002919">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002650"/>
        <obo:IAO_0000115>a gynecomastia AE that has asymptomatic breast enlargement</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 gynecomastia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13116</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002920 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002650"/>
        <obo:IAO_0000115>a gynecomastia AE that has symptomatic (e.g., pain or psychosocial impact)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 gynecomastia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13117</rdfs:seeAlso>
