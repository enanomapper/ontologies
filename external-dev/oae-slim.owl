    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007493 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001364"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the kidneys are functioning at less than 15% of normal levels on neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_failure</obo:IAO_0000119>
        <obo:OAE_0001849>肾功能衰竭新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10038447</obo:OAE_0004334>
        <rdfs:label>renal failure neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007494 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare side effect of cisplatin that manifests with polyuria, hypovolemia, and hyponatremia, and, because of similarities in clinical settings and laboratory values, it is frequently misdiagnosed as a syndrome of inappropriate antidiuretic hormone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20622742/</obo:IAO_0000119>
        <obo:OAE_0001849>肾耗盐综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10062550</obo:OAE_0004334>
        <rdfs:label>renal salt-wasting syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007495 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a form of renal  cell injury which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肾坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10038481</obo:OAE_0004334>
        <rdfs:label>renal necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007496 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is an important contributor to graft loss in chronic renal allograft injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28209809/</obo:IAO_0000119>
        <obo:OAE_0001849>肾间质纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10038475</obo:OAE_0004334>
        <rdfs:label>renal interstitial fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007497 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001937"/>
        <obo:IAO_0000115>This is an AE which is when a solid piece of material (kidney stone) develops in the urinary tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_stone_disease</obo:IAO_0000119>
        <obo:OAE_0001849>肾结石</obo:OAE_0001849>
        <obo:OAE_0004334>10029148</obo:OAE_0004334>
        <rdfs:label>nephrolithiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007498 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a cancer of the kidneys that typically occurs in children, rarely in adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nephroblastoma</obo:IAO_0000119>
        <obo:OAE_0001849>肾胚细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029145</obo:OAE_0004334>
        <rdfs:label>nephroblastoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007499 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a rare cause of acute kidney failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Renal_cortical_necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肾皮质坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10038422</obo:OAE_0004334>
        <rdfs:label>renal cortical necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007500 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the kidneys are functioning at less than 15% of normal levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_failure</obo:IAO_0000119>
        <obo:OAE_0001849>肾前性衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10072370</obo:OAE_0004334>
        <rdfs:label>prerenal failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007501 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is an accumulation of serous fluid in a renal  cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hydrocele</obo:IAO_0000119>
        <obo:OAE_0001849>肾鞘膜积液</obo:OAE_0001849>
        <obo:OAE_0004334>10062854</obo:OAE_0004334>
        <rdfs:label>renal hydrocele AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007502 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>This is an AE which is the lodging of an embolus, a blockage-causing piece of material, inside a renal  blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolism</obo:IAO_0000119>
        <obo:OAE_0001849>肾栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10063544</obo:OAE_0004334>
        <rdfs:label>renal embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007503 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which continues to be a difficult malignancy to treat because of its ability to spread asymptomatically and its inherent resistance to conventional chemotherapy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11981272/</obo:IAO_0000119>
        <obo:OAE_0001849>肾细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10067946</obo:OAE_0004334>
        <rdfs:label>renal cell carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007504 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing in which connective tissue replaces normal parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue such as kidney fibrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis#Kidney</obo:IAO_0000119>
        <obo:OAE_0001849>肾纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10023421</obo:OAE_0004334>
        <rdfs:label>kidney fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007505 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is two reddish-brown bean-shaped organs found in vertebrates and is small.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney</obo:IAO_0000119>
        <obo:OAE_0001849>小肾</obo:OAE_0001849>
        <obo:OAE_0004334>10023435</obo:OAE_0004334>
        <rdfs:label>kidney small AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007506 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a medical condition involving the death of tubular epithelial cells that form the renal tubules of the kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_tubular_necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肾小管坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10038540</obo:OAE_0004334>
        <rdfs:label>renal tubular necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007507 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004447"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the area of the kidney known as the renal interstitium, which consists of a collection of cells, extracellular matrix, and fluid surrounding the renal tubules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Interstitial_nephritis</obo:IAO_0000119>
        <obo:OAE_0001849>肾小管间质性肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048302</obo:OAE_0004334>
        <rdfs:label>tubulointerstitial nephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007508 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004447"/>
        <obo:IAO_0000115>This is an AE which is a rare medical condition in which there is uveitis (inflammation of the uvea in the eye) together with tubulointerstitial nephritis (inflammation of the tubules inside the kidney).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tubulointerstitial_nephritis_and_uveitis</obo:IAO_0000119>
        <obo:OAE_0001849>肾小管间质性肾炎和葡萄膜炎综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10069034</obo:OAE_0004334>
        <rdfs:label>tubulointerstitial nephritis and uveitis syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007509 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002331"/>
        <obo:IAO_0000115>This is an AE which is a medical condition that involves an accumulation of acid in the body due to a failure of the kidneys to appropriately acidify the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Renal_tubular_acidosis</obo:IAO_0000119>
        <obo:OAE_0001849>肾小管酸中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10038535</obo:OAE_0004334>
        <rdfs:label>renal tubular acidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007510 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>This is an AE which is a term used to refer to several kidney diseases (usually affecting both kidneys).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glomerulonephritis</obo:IAO_0000119>
        <obo:OAE_0001849>肾小球肾炎焦</obo:OAE_0001849>
        <obo:OAE_0004334>10018369</obo:OAE_0004334>
        <rdfs:label>glomerulonephritis focal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007511 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>This is an AE which is a syndrome of the kidney that is characterized by a rapid loss of kidney function, (usually a 50% decline in the glomerular filtration rate (GFR) within 3 months) with glomerular crescent formation seen in at least 50% or 75% of glomeruli seen on kidney biopsies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rapidly_progressive_glomerulonephritis</obo:IAO_0000119>
        <obo:OAE_0001849>急性肾小球肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10018378</obo:OAE_0004334>
        <rdfs:label>glomerulonephritis rapidly progressive AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007512 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a network of small blood vessels (capillaries) known as a tuft, located at the beginning of a nephron in the kidney and its vascular becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glomerulus_(kidney)</obo:IAO_0000119>
        <obo:OAE_0001849>肾小球血管障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10018362</obo:OAE_0004334>
        <rdfs:label>glomerular vascular disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007513 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is hardening of the glomeruli in the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glomerulosclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>肾小球硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10061989</obo:OAE_0004334>
        <rdfs:label>glomerulosclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007514 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a localized renal  bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>肾血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10038459</obo:OAE_0004334>
        <rdfs:label>renal hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007515 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004447"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the area of the kidney known as the renal interstitium, which consists of a collection of cells, extracellular matrix, and fluid surrounding the renal tubules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Interstitial_nephritis</obo:IAO_0000119>
        <obo:OAE_0001849>肾炎间质</obo:OAE_0001849>
        <obo:OAE_0004334>10029134</obo:OAE_0004334>
        <rdfs:label>nephritis interstitial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007516 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004318"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the kidney, typically due to a bacterial infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pyelonephritis</obo:IAO_0000119>
        <obo:OAE_0001849>肾盂炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037584</obo:OAE_0004334>
        <rdfs:label>pyelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007517 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is a form of diabetes insipidus primarily due to pathology of the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nephrogenic_diabetes_insipidus</obo:IAO_0000119>
        <obo:OAE_0001849>肾原性的尿崩症</obo:OAE_0001849>
        <obo:OAE_0004334>10029147</obo:OAE_0004334>
        <rdfs:label>nephrogenic diabetes insipidus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007518 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is tumours, or growths, on or in the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_tumour</obo:IAO_0000119>
        <obo:OAE_0001849>肾脏肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10062104</obo:OAE_0004334>
        <rdfs:label>renal mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007519 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is damage to or disease of a kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_disease</obo:IAO_0000119>
        <obo:OAE_0001849>肾肿大</obo:OAE_0001849>
        <obo:OAE_0004334>10048469</obo:OAE_0004334>
        <rdfs:label>kidney enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007520 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a group of cancers that starts in the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_neoplasm?wprov=srpw1_1</obo:IAO_0000119>
        <obo:OAE_0001849>肾肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061482</obo:OAE_0004334>
        <rdfs:label>renal neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007521 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which refers to accumulation of fluid in an anatomic space such as perinephric.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Effusion</obo:IAO_0000119>
        <obo:OAE_0001849>肾周的积液</obo:OAE_0001849>
        <obo:OAE_0004334>10053550</obo:OAE_0004334>
        <rdfs:label>perinephric effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007522 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is determined by measuring plasma glucose levels 2 hours after glucose loading in the oral glucose tolerance test.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15799213/</obo:IAO_0000119>
        <obo:OAE_0001849>糖耐量降低</obo:OAE_0001849>
        <obo:OAE_0004334>10018429</obo:OAE_0004334>
        <rdfs:label>glucose tolerance impaired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007523 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which include problems that develop rapidly (acute) or over time (chronic) and may affect many organ systems.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complications_of_diabetes</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病的并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10061104</obo:OAE_0004334>
        <rdfs:label>diabetic complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007524 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which occurs predominantly after the age of 50 years but is not easy to distinguish from late onset insulin-dependent diabetes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9158288/</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病非胰岛素依赖</obo:OAE_0001849>
        <obo:OAE_0004334>10012613</obo:OAE_0004334>
        <rdfs:label>diabetes mellitus non-insulin-dependent AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007525 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000491"/>
        <obo:IAO_0000115>This is an AE which is a reversible form of coma found in people with diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetic_coma</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病昏迷</obo:OAE_0001849>
        <obo:OAE_0004334>10012650</obo:OAE_0004334>
        <rdfs:label>diabetic coma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007526 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a group of metabolic disorders characterized by a high blood sugar level over a prolonged period of time and it is inadequate control.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetes</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病控制不足</obo:OAE_0001849>
        <obo:OAE_0004334>10012607</obo:OAE_0004334>
        <rdfs:label>diabetes mellitus inadequate control AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007527 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000211"/>
        <obo:IAO_0000115>This is an AE which is of interest due to their remarkable resistance to heal; severe thermal burns are addressed due to critical need for effective therapies for the prevention shock and improvement in scarring.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27412677/</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10056340</obo:OAE_0004334>
        <rdfs:label>diabetic ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007528 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a group of metabolic disorders with foetopathy characterized by a high blood sugar level over a prolonged period of time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetes</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病胎儿病</obo:OAE_0001849>
        <obo:OAE_0004334>10059116</obo:OAE_0004334>
        <rdfs:label>diabetic foetopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007529 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a potentially life-threatening complication of diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetic_ketoacidosis</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病酮症</obo:OAE_0001849>
        <obo:OAE_0004334>10012673</obo:OAE_0004334>
        <rdfs:label>diabetic ketosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007530 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000491"/>
        <obo:IAO_0000115>This is an AE which is a serious and potentially life-threatening acute complication of diabetes mellitus with hyperglycaemic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30150107/</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病酮症酸中毒高血糖昏迷</obo:OAE_0001849>
        <obo:OAE_0004334>10012672</obo:OAE_0004334>
        <rdfs:label>diabetic ketoacidotic hyperglycaemic coma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007531 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which results from failure of the pancreas to produce enough insulin due to loss of beta cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetes</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病胰岛素依赖型</obo:OAE_0001849>
        <obo:OAE_0004334>10012608</obo:OAE_0004334>
        <rdfs:label>diabetes mellitus insulin-dependent AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007532 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001855"/>
        <obo:IAO_0000115>This is an AE which is a necrotising skin condition that usually occurs in patients with diabetes mellitus but can also be associated with rheumatoid arthritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrobiosis_lipoidica</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病脂质坏死病</obo:OAE_0001849>
        <obo:OAE_0004334>10056969</obo:OAE_0004334>
        <rdfs:label>necrobiosis lipoidica diabeticorum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007533 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is any pathology that results directly from peripheral arterial disease (PAD) and/or sensory neuropathy affecting the feet in diabetes mellitus; it is a long-term (or &quot;chronic&quot;) complication of diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetic_foot</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病足</obo:OAE_0001849>
        <obo:OAE_0004334>10060734</obo:OAE_0004334>
        <rdfs:label>diabetic foot AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007534 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which may involve a number of genes including HFE and TFR2.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iron_metabolism_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>铁代谢障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10022983</obo:OAE_0004334>
        <rdfs:label>iron metabolism disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007535 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare condition characterized by late onset of developmental delays—or severe and sudden reversals—in language, social function, and motor skills.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childhood_disintegrative_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>童年分解性障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10008522</obo:OAE_0004334>
        <rdfs:label>childhood disintegrative disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007536 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002331"/>
        <obo:IAO_0000115>This is an AE which is a metabolic state caused by uncontrolled production of ketone bodies that cause a metabolic acidosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ketoacidosis</obo:IAO_0000119>
        <obo:OAE_0001849>酮酸中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10023379</obo:OAE_0004334>
        <rdfs:label>ketoacidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007537 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a metabolic state characterized by elevated levels of ketone bodies in the blood or urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ketosis</obo:IAO_0000119>
        <obo:OAE_0001849>酮症</obo:OAE_0001849>
        <obo:OAE_0004334>10023391</obo:OAE_0004334>
        <rdfs:label>ketosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007538 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002331"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by the buildup of lactate (especially L-lactate) in the body, with formation of an excessively low pH in the bloodstream.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lactic_acidosis</obo:IAO_0000119>
        <obo:OAE_0001849>乳酸酸中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10023676</obo:OAE_0004334>
        <rdfs:label>lactic acidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007539 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a common condition caused by a decreased ability to digest lactose, a sugar found in dairy products.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lactose_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>乳糖不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10023981</obo:OAE_0004334>
        <rdfs:label>lactose intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007540 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is the most common type of thyroid cancer, representing 75 percent to 85 percent of all thyroid cancer cases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papillary_thyroid_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>乳头状甲状腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10033701</obo:OAE_0004334>
        <rdfs:label>papillary thyroid cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007541 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a benign epithelial tumor growing exophytically (outwardly projecting) in nipple-like and often finger-like fronds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papilloma</obo:IAO_0000119>
        <obo:OAE_0001849>乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10033713</obo:OAE_0004334>
        <rdfs:label>papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007542 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is an acquired benign squamous cell tumor that can present at any age, but most frequently in the third and fourth decades of life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31236424/</obo:IAO_0000119>
        <obo:OAE_0001849>乳头状瘤结膜</obo:OAE_0001849>
        <obo:OAE_0004334>10067127</obo:OAE_0004334>
        <rdfs:label>papilloma conjunctival AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007543 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a common condition caused by a decreased ability to digest lactose, a sugar found in dairy products.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lactose_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>乳制品不耐受性</obo:OAE_0001849>
        <obo:OAE_0004334>10011852</obo:OAE_0004334>
        <rdfs:label>dairy intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007544 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is an endocrinological disorder characterized by decreased levels of the hormone aldosterone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoaldosteronism</obo:IAO_0000119>
        <obo:OAE_0001849>醛固酮减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10020944</obo:OAE_0004334>
        <rdfs:label>hypoaldosteronism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007545 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is the main mineralocorticoid steroid hormone produced by the zona glomerulosa of the adrenal cortex in the adrenal gland on the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aldosterone</obo:IAO_0000119>
        <obo:OAE_0001849>醛固酮尿</obo:OAE_0001849>
        <obo:OAE_0004334>10001649</obo:OAE_0004334>
        <rdfs:label>aldosterone urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007546 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a lack of the trace element iodine, an essential nutrient in the diet.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iodine_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>缺碘</obo:OAE_0001849>
        <obo:OAE_0004334>10067997</obo:OAE_0004334>
        <rdfs:label>iodine deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007547 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which motivates the consumption of food.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hunger_(physiology)</obo:IAO_0000119>
        <obo:OAE_0001849>缺乏饱腹感</obo:OAE_0001849>
        <obo:OAE_0004334>10064720</obo:OAE_0004334>
        <rdfs:label>lack of satiety AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007548 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is lack of the heterodimer of two chains: IFNGR1 and IFNGR2. It binds interferon-γ, the sole member of interferon type II.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Interferon-gamma_receptor</obo:IAO_0000119>
        <obo:OAE_0001849>缺乏干扰素受体</obo:OAE_0001849>
        <obo:OAE_0004334>10057605</obo:OAE_0004334>
        <rdfs:label>interferon gamma receptor deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007549 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is the state in which a body lacks enough iron to supply its needs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iron_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>缺铁</obo:OAE_0001849>
        <obo:OAE_0004334>10022970</obo:OAE_0004334>
        <rdfs:label>iron deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007550 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is defined either as insufficient copper to meet the needs of the body, or as a serum copper level below the normal range.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Copper_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>缺铜症</obo:OAE_0001849>
        <obo:OAE_0004334>10010957</obo:OAE_0004334>
        <rdfs:label>copper deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007551 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which means a total depletion in the level of oxygen, an extreme form of hypoxia or &quot;low oxygen&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anoxia</obo:IAO_0000119>
        <obo:OAE_0001849>缺氧</obo:OAE_0001849>
        <obo:OAE_0004334>10002660</obo:OAE_0004334>
        <rdfs:label>anoxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007552 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000879"/>
        <obo:IAO_0000115>This is an AE which is a human health condition or disease that is persistent or otherwise long-lasting in its effects or a disease that comes with time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_condition</obo:IAO_0000119>
        <obo:OAE_0001849>慢性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10076311</obo:OAE_0004334>
        <rdfs:label>chronic disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007553 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000879"/>
        <obo:IAO_0000115>This is an AE which defined in the Diagnostic and Statistical Manual of Mental Disorders (DSM) based on type (motor or phonic) and duration of tics (sudden, rapid, nonrhythmic movements).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tic_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>慢性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10076661</obo:OAE_0004334>
        <rdfs:label>chronic tic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007554 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the thyroid gland and is chronic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroiditis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性甲状腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10043781</obo:OAE_0004334>
        <rdfs:label>thyroiditis chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007555 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000034"/>
        <obo:IAO_0000115>This is an AE which is a complex, fatiguing, long-term medical condition diagnosed by required primary symptoms and criteria, and often involves a broad range of symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_fatigue_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>慢性疲劳综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10008874</obo:OAE_0004334>
        <rdfs:label>chronic fatigue syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007556 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is a diverse group of hereditary diseases in which certain cells of the immune system have difficulty forming the reactive oxygen compounds (most importantly the superoxide radical due to defective phagocyte NADPH oxidase) used to kill certain ingested pathogens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_granulomatous_disease</obo:IAO_0000119>
        <obo:OAE_0001849>慢性肉芽肿性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10008906</obo:OAE_0004334>
        <rdfs:label>chronic granulomatous disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007557 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which consists of pigmented macular lesions, predominantly involving the lower extremities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/3677535/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性色素紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10072726</obo:OAE_0004334>
        <rdfs:label>chronic pigmented purpura AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007558 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome of progressive loss of renal function that results in loss of urinary concentrating ability, retention of nitrogenous and other metabolic end products, alterations in electrolyte and acid-base status, and dysfunction of several hormone systems.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18061852/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性肾功能衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10038444</obo:OAE_0004334>
        <rdfs:label>renal failure chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007559 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is defined as hives, typically occurring daily, for greater than 6 weeks duration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24305753/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10052568</obo:OAE_0004334>
        <rdfs:label>urticaria chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007561 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is an autosomal recessive metabolic disorder that disrupts the biosynthesis of cholesterol and isoprenoids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mevalonate_kinase_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>甲羟戊酸激酶缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10072221</obo:OAE_0004334>
