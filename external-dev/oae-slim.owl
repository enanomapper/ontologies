        <rdfs:label>Grade 3 uveitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10445</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003764 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001886"/>
        <obo:IAO_0000115>an uveitis AE that has blindness (20/200 or worse) in the affected eye</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 uveitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10446</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003765 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>a retinopathy AE that is symptomatic with moderate decrease in visual acuity (20/40 or better); limiting instrumental activities of daily living</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 retinopathy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10434</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003766 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>a retinopathy AE that is symptomatic with marked decrease in visual acuity (worse than 20/40); disabling; limiting self care activities of daily living</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 retinopathy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10435</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003767 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>a retinopathy AE that has blindness (20/200 or worse) in the affected eye</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 retinopathy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10436</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003768 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>a hearing loss AE for adults enrolled on a Monitoring Program (on a 1, 2, 3, 4, 6 and 8 kHz audiogram): Threshold shift of 15 - 25 dB averaged at 2 contiguous test frequencies in at least one ear. Adults not enrolled in Monitoring Program: subjective change in hearing in the absence of documented hearing loss. Pediatric (on a 1, 2, 3, 4, 6 and 8 kHz audiogram): Threshold shift greater than20 dB at 8 kHz in at least one ear.</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 hearing loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10277</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003769 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>a hearing loss AE for adults enrolled in Monitoring Program (on a 1, 2, 3, 4, 6 and 8 kHz audiogram): Threshold shift of greater than25 dB averaged at 2 contiguous test frequencies in at least one ear. Adults not enrolled in Monitoring Program: hearing loss but hearing aid or intervention not indicated; limiting instrumental activities of daily living. Pediatric (on a 1, 2, 3, 4, 6 and 8 kHz audiogram): Threshold shift greater than20 dB at 4 kHz and above in at least one ear.</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 hearing loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10278</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003770 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>a hearing loss AE for adults enrolled in Monitoring Program (on a 1, 2, 3, 4, 6 and 8 kHz audiogram): Threshold shift of greater than25 dB averaged at 3 contiguous test frequencies in at least one ear; therapeutic intervention indicated. Adults not enrolled in Monitoring Program: hearing loss with hearing aid or intervention indicated; limiting self care activities of daily living. Pediatric (on a 1, 2, 3, 4, 6 and 8 kHz audiogram): hearing loss sufficient to indicate therapeutic intervention, including hearing aids; threshold shift greater than20 dB at 3 kHz and above in at least one ear; additional speech-language related services indicated.</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 hearing loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10279</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003771 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>a hearing loss AE for adults: Decrease in hearing to profound bilateral loss (absolute threshold greater than80 dB HL at 2 kHz and above); non-servicable hearing. Pediatric: Audiologic indication for cochlear implant and additional speech-language related services indicated.</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 hearing loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10280</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003772 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002088"/>
        <obo:IAO_0000115>a international normalized ratio increased AE that is greater than 1 - 1.5 times the upper limit of normal; greater than 1 - 1.5 times above baseline if on anticoagulation</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 international normalized ratio increased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12176</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003773 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002088"/>
        <obo:IAO_0000115>a international normalized ratio increased AE that is greater than 1.5 - 2.5 times the upper limit of normal; greater than 1.5 - 2.5 times above baseline if on anticoagulation</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 international normalized ratio increased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12177</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003774 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002088"/>
        <obo:IAO_0000115>a international normalized ratio increased AE that is greater than 2.5 times the upper limit of normal; greater than 2.5 times above baseline if on anticoagulation</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 international normalized ratio increased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12178</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003775 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002095"/>
        <obo:IAO_0000115>a fecal incontinence AE that has occasional use of pads required</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 fecal incontinence AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10694</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003776 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002095"/>
        <obo:IAO_0000115>a fecal incontinence AE that has daily use of pads required</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 fecal incontinence AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10695</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003777 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002095"/>
        <obo:IAO_0000115>a fecal incontinence AE that has severe symptoms; elective operative intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 fecal incontinence AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10696</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003778 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002116"/>
        <obo:IAO_0000115>a thrombotic thrombocytopenic purpura AE that has evidence of RBC destruction (schistocytosis) without clinical consequences</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 thrombotic thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10062</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003779 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002116"/>
        <obo:IAO_0000115>a thrombotic thrombocytopenic purpura AE charaterized by laboratory findings with clinical consequences (e.g., renal insufficiency, petechiae)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 thrombotic thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10063</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003780 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002116"/>
        <obo:IAO_0000115>a thrombotic thrombocytopenic purpura AE that has life-threatening consequences, (e.g., CNS hemorrhage or thrombosis/embolism or renal failure)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 thrombotic thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10064</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003781 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>a glaucoma AE that has elevated intraocular pressure (EIOP) with single topical agent for intervention; no visual field deficit</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 glaucoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10393</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003782 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>a glaucoma AE that has elevated intraocular pressure causing early visual field deficits; multiple topical or oral agents indicated; limiting instrumental activities of daily living</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 glaucoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10394</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003783 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>a glaucoma AE that has elevated intraocular pressure causing marked visual field deficits (e.g., involving both superior and inferior visual fields); operative intervention indicated; limiting self care activities of daily living</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 glaucoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10395</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003784 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>a glaucoma AE that has blindness (20/200 or worse) in the affected eye</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 glaucoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10396</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003785 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002118"/>
        <obo:IAO_0000115>an anaphylaxis AE that has symptomatic bronchospasm, with or without urticaria; parenteral intervention indicated; allergy-related edema/angioedema; hypotension</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 anaphylaxis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11255</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003786 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>a retinal detachment AE that has exudative and visual acuity 20/40 or better</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 retinal detachment AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10422</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003787 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>a retinal detachment AE that has rhegmatogenous or exudative detachment; operative intervention indicated; decline in vision (worse than 20/40 but better than 20/200)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 retinal detachment AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10423</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003788 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>a retinal detachment AE that has blindness (20/200 or worse) in the affected eye</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 retinal detachment AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10424</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003789 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002258"/>
        <obo:IAO_0000115>a hemolysis AE that has laboratory evidence of hemolysis only (e.g., direct antiglobulin test; DAT; Coombs&apos;; schistocytes; decreased haptoglobin)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 hemolysis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10038</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003790 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002258"/>
        <obo:IAO_0000115>a hemolysis AE that has evidence of hemolysis and greater than or equal to 2 gm decrease in hemoglobin.</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 hemolysis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10039</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003791 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002258"/>
        <obo:IAO_0000115>a hemolysis AE where transfusion or medical intervention is indicated (e.g., steroids)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 hemolysis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10040</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003792 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002349"/>
        <obo:IAO_0000115>an anal fistula AE that is symptomatic; altered GI function</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 anal fistula AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10466</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003793 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002349"/>
        <obo:IAO_0000115>an anal fistula AE that has severely altered GI function; tube feeding, TPN or hospitalization indicated; elective operative intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 anal fistula AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10467</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003794 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002371"/>
        <obo:IAO_0000115>an atrial tachycardia AE where IV medication is indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 atrial tachycardia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10169</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003795 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002371"/>
        <obo:IAO_0000115>an atrial tachycardia AE that has life-threatening consequences; incompletely controlled medically; cardioversion indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 atrial tachycardia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10170</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003796 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002400"/>
        <obo:IAO_0000115>a cholecystitis AE that has severe symptoms; radiologic, endoscopic or elective operative intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 cholecystitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11186</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003797 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>an autoimmune disorder AE that is asymptomatic; serologic or other evidence of autoimmune reaction, with normal organ function; intervention not indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 autoimmune disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11259</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003798 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>an autoimmune disorder AE that has evidence of autoimmune reaction involving a non-essential organ or function (e.g., hypothyroidism)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 autoimmune disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11260</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003799 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>an autoimmune disorder AE that has autoimmune reactions involving major organ (e.g., colitis, anemia, myocarditis, kidney)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 autoimmune disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11261</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003800 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003800">
