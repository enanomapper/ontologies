    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008356 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of uterine blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>子宫血肿</obo:OAE_0001849>
