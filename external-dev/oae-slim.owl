    <!-- http://purl.obolibrary.org/obo/OAE_0008449 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the kidneys and may involve the glomeruli, tubules, or interstitial tissue surrounding the glomeruli and tubules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nephritis</obo:IAO_0000119>
