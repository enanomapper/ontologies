        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is tubes that stretch from the ovaries to the uterus, in the human female reproductive system and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fallopian_tube</obo:IAO_0000119>
        <obo:OAE_0001849>输卵管紊乱</obo:OAE_0001849>
