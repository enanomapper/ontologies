        <obo:OAE_0004334>10056675</obo:OAE_0004334>
        <rdfs:label>postoperative renal failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007248 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of blood vessels, due topost procedural and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>手术后血肿</obo:OAE_0001849>
