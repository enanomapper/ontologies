    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007121 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a disease caused by infection with Coxiella burnetii, a bacterium that affects humans and other animals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Q_fever</obo:IAO_0000119>
        <obo:OAE_0001849>发烧</obo:OAE_0001849>
        <obo:OAE_0004334>10037688</obo:OAE_0004334>
