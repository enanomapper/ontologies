    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an Ae which is thickening of the walls of a ventricle (lower chamber) of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
