    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008834 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a long flat bone located in the central part of the chest is injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sternum</obo:IAO_0000119>
        <obo:OAE_0001849>胸骨损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10056287</obo:OAE_0004334>
        <rdfs:label>sternal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008835 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001300"/>
        <obo:IAO_0000115>This is an AE which is one the most common extrapulmonary tuberculosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32501259/</obo:IAO_0000119>
        <obo:OAE_0001849>结核性胸膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10045104</obo:OAE_0004334>
        <rdfs:label>tuberculous pleurisy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008836 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a vaso-occlusive crisis of the pulmonary vasculature commonly seen in people with sickle cell anemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_chest_syndrome</obo:IAO_0000119>
