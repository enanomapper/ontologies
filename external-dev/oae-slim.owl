    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005412 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001772"/>
        <obo:IAO_0000115>This is an AE which refers blockage of a iliac vein  blood vessel.</obo:IAO_0000115>
