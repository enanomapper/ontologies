    <!-- http://purl.obolibrary.org/obo/OAE_0000379 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001673"/>
        <obo:IAO_0000115 xml:lang="en">a leukocyte cell number abnormal AE that has an outcome of greater than normal number of leukocytes, or nucleated cells of the myeloid or lymphoid lineages, found in blood or other tissue</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;leukocytosis&apos; is an adverse event that was mentioned in 1,021 VAERS reports (0.8%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>SS, YH, EB</obo:IAO_0000117>
        <obo:IAO_0000118>increased leukocyte cell number AE
</obo:IAO_0000118>
        <obo:IAO_0000118>leukocytosis AE</obo:IAO_0000118>
        <obo:IAO_0000118>white blood cell count increased AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Leukocytosis</obo:IAO_0000119>
        <obo:OAE_0004334>10024378</obo:OAE_0004334>
        <obo:OAE_0004334>10047943</obo:OAE_0004334>
        <rdfs:label>leukocyte cell number increased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10048</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0000218</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35524</rdfs:seeAlso>
    </owl:Class>
    


