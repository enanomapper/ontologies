    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004598 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001518"/>
        <obo:IAO_0000115>This is an AE which is a surgical complication in which a abdominal wound ruptures along a  surgical incision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
