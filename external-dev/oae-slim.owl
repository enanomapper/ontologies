        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001012"/>
        <obo:IAO_0000115>a hemolytic uremic syndrome AE that has laboratory findings with clinical consequences (e.g., renal insufficiency, petechiae)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 hemolytic uremic syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10045</rdfs:seeAlso>
    </owl:Class>
    


