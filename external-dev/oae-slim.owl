    <!-- http://purl.obolibrary.org/obo/OAE_0002921 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002709"/>
        <obo:IAO_0000115>a hematosalpinx AE that has minimal bleeding identified on imaging study or laparoscopy; intervention not indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hematosalpinx AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13120</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002922 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002922">
