        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is a vascular tumor that occurs on both mucosa and skin, and appears as an overgrowth of tissue due to irritation, physical trauma, or hormonal factors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
