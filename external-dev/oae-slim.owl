    <!-- http://purl.obolibrary.org/obo/OAE_0005600 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004583"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which injury to the large or small intestine occurs due to not enough blood supply.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intestinal_ischemia</obo:IAO_0000119>
