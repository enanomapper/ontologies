    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is a lack of control over defecation, leading to involuntary loss of bowel contents, both liquid stool elements and mucus, or solid feces.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fecal_incontinence</obo:IAO_0000119>
