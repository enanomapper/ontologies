    <!-- http://purl.obolibrary.org/obo/OAE_0009340 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002464"/>
        <obo:IAO_0000115>This is an AE which is characterized by excessive unsuppressible release of antidiuretic hormone (ADH) either from the posterior pituitary gland, or an abnormal non-pituitary source.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
