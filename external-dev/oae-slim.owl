        <obo:OAE_0001849>会阴损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10073329</obo:OAE_0004334>
        <rdfs:label>perineal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008628 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is defined as the elevation of end- expiratory lung volume above its predicted value, with no increase in end-expiratory alveolar pressure, which remains equal to atmospheric pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19107020/</obo:IAO_0000119>
        <obo:OAE_0001849>肺恶性通货膨胀</obo:OAE_0001849>
        <obo:OAE_0004334>10059487</obo:OAE_0004334>
        <rdfs:label>lung hyperinflation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008629 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which comprise a group of anatomical abnormalities of the respiratory tree including congenital cystic malformations, bronchopulmonary sequestrations, bronchogenic cyst, bronchial atresia, and congenital lobar emphysema.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29110827/</obo:IAO_0000119>
        <obo:OAE_0001849>肺畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10037419</obo:OAE_0004334>
        <rdfs:label>pulmonary malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008630 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which describes tumour cell microemboli with occlusive fibrointimal remodelling in small pulmonary arteries, veins and lymphatics.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27387102/</obo:IAO_0000119>
        <obo:OAE_0001849>肺微栓子</obo:OAE_0001849>
        <obo:OAE_0004334>10037421</obo:OAE_0004334>
        <rdfs:label>pulmonary microemboli AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008631 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a cartilaginous tube that connects the larynx to the bronchi of the lungs, allowing the passage of air, and so is present in almost all air-breathing animals with lungs and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trachea</obo:IAO_0000119>
        <obo:OAE_0001849>气管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10053490</obo:OAE_0004334>
        <rdfs:label>tracheal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008632 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a disease characterized by eosinophilic infiltration of the lung and bronchial mucosa, as demonstrated by examination of bronchoalveolar lavage fluid cytologic preparations or histologic examination of the bronchial mucosa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17693206/</obo:IAO_0000119>
        <obo:OAE_0001849>支气管肺病</obo:OAE_0001849>
        <obo:OAE_0004334>10053582</obo:OAE_0004334>
        <rdfs:label>bronchopneumopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008633 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a disorder at the respiratory tract  organ level that is due to problems with tissue development.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10038733</obo:OAE_0004334>
        <rdfs:label>respiratory tract malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008634 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is an important opportunistic invasive mycosis in immunocompromised patients, but it is also increasingly seen in immunocompetent patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30329097/</obo:IAO_0000119>
        <obo:OAE_0001849>肺真菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10037422</obo:OAE_0004334>
        <rdfs:label>pulmonary mycosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008635 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is common and radiological investigation of pleural effusion, thickening, masses, and pneumothorax is key in diagnosing and determining management.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28233652/</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10035595</obo:OAE_0004334>
        <rdfs:label>pleural disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008636 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is induced experimentally by adding high external resistances to breathing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/1546280/</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸疲劳</obo:OAE_0001849>
        <obo:OAE_0004334>10068733</obo:OAE_0004334>
        <rdfs:label>respiratory fatigue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008637 -->


