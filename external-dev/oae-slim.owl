        <obo:OAE_0004334>10021972</obo:OAE_0004334>
        <rdfs:label>inflammatory bowel disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005672 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which includes excessive straining, a sense of incomplete evacuation, failed or lengthy attempts to defecate, use of digital manoeuvres for evacuation of stool, abdominal bloating, and hard consistency of stools.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28185025/</obo:IAO_0000119>
        <obo:OAE_0001849>不常见的肠道运动</obo:OAE_0001849>
        <obo:OAE_0004334>10059158</obo:OAE_0004334>
        <rdfs:label>infrequent bowel movements AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005673 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005673">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a functional gastrointestinal disorder characterized by a group of symptoms accompanied together that include abdominal pain and changes in the consistency of bowel movements.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritable_bowel_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肠易激综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10023003</obo:OAE_0004334>
        <rdfs:label>irritable bowel syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005674 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000916"/>
        <obo:IAO_0000115>This is an AE which is a rare and poorly understood cause of abdominal pain in patients with systemic lupus erythematosus (SLE).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23642042/</obo:IAO_0000119>
        <obo:OAE_0001849>狼疮肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067738</obo:OAE_0004334>
        <rdfs:label>lupus enteritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005675 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001068"/>
        <obo:IAO_0000115>This is an AE which may have a congenital cause such as malrotation with volvulus or a persistent omphalomesenteric duct.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
