        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a class of functional mental disorders  of childhood involving chronic distress, but neither delusions nor hallucinations.</obo:IAO_0000115>
