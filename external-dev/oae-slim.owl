    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004611 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <obo:IAO_0000115>This is an AE which is the part of the body between the thorax (chest) and pelvis, in humans and in other vertebrates.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
