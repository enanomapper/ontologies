    <!-- http://purl.obolibrary.org/obo/OAE_0008665 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is blockage of the small airways in the lungs caused by respiratory syncytial virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchiolitis</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道合胞病毒性毛细支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10038718</obo:OAE_0004334>
        <rdfs:label>respiratory syncytial virus bronchiolitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008666 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the bronchi (large and medium-sized airways) in the lungs that causes coughing caused by respiratory syncytial virus .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道合胞病毒性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10069811</obo:OAE_0004334>
        <rdfs:label>respiratory syncytial virus bronchitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008667 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a very common, contagious virus that causes infections of the respiratory tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_syncytial_virus</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道合胞病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061603</obo:OAE_0004334>
        <rdfs:label>respiratory syncytial virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008668 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of respiratory tract  tissues to harmful stimuli and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10068956</obo:OAE_0004334>
        <rdfs:label>respiratory tract inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008669 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a respiratory tract state of  inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10038731</obo:OAE_0004334>
        <rdfs:label>respiratory tract irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008670 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the respiratory tract  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10070774</obo:OAE_0004334>
        <rdfs:label>respiratory tract edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008671 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is an acute bleeding from the lung, from the upper respiratory tract and the trachea, and the alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_hemorrhage</obo:IAO_0000119>
        <obo:OAE_0001849>肺泡出血</obo:OAE_0001849>
        <obo:OAE_0004334>10037313</obo:OAE_0004334>
        <rdfs:label>pulmonary alveolar hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008672 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is the complete absence of lung tissue, including bronchial tree, lung parenchyma, and supporting vasculatures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_agenesis</obo:IAO_0000119>
        <obo:OAE_0001849>肺发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10037322</obo:OAE_0004334>
        <rdfs:label>pulmonary aplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008673 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008673">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a common asymptomatic finding, usually discovered on routine chest X-ray or at autopsy and is caused mainly by two mechanisms: the dystrophic form and the metastatic form.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10783928/</obo:IAO_0000119>
        <obo:OAE_0001849>肺钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10051200</obo:OAE_0004334>
        <rdfs:label>pulmonary calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008674 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is an enclosed pocket of air or gas in the lung and includes blebs, bullae, pulmonary cysts, and lung cavities and has a wall thickness of more than 4 mm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Focal_lung_pneumatosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺空化</obo:OAE_0001849>
        <obo:OAE_0004334>10051738</obo:OAE_0004334>
        <rdfs:label>pulmonary cavitation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008675 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a bruise of the lung, caused by chest trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_contusion</obo:IAO_0000119>
        <obo:OAE_0001849>肺挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10037370</obo:OAE_0004334>
        <rdfs:label>pulmonary contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008676 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is an aggregation on the pulmonary of macrophages that forms in response to chronic inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>肺肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10037391</obo:OAE_0004334>
        <rdfs:label>pulmonary granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008677 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which results from recurrent bleeding into alveolar spaces and interstitial lung tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16473816/</obo:IAO_0000119>
        <obo:OAE_0001849>肺含铁血黄素沉着症</obo:OAE_0001849>
        <obo:OAE_0004334>10037396</obo:OAE_0004334>
        <rdfs:label>pulmonary haemosiderosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008678 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001164"/>
        <obo:IAO_0000115>This is an AE which is a group of structures that emerge at the hilum of each lung, just above the middle of the mediastinal surface and behind the cardiac impression of the lung and it has mass.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Root_of_the_lung</obo:IAO_0000119>
        <obo:OAE_0001849>肺门肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10058563</obo:OAE_0004334>
        <rdfs:label>pulmonary hilum mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008679 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is incomplete development of the lungs, resulting in an abnormally low number or size of bronchopulmonary segments or alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_hypoplasia</obo:IAO_0000119>
        <obo:OAE_0001849>肺发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10037407</obo:OAE_0004334>
        <rdfs:label>pulmonary hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008680 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001340"/>
        <obo:IAO_0000115>This is an AE which occurs when an artery to the lung becomes blocked and part of the lung dies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lung_infarction</obo:IAO_0000119>
        <obo:OAE_0001849>肺梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10037410</obo:OAE_0004334>
        <rdfs:label>pulmonary infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008681 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a form of pulmonary  cell injury which results in the premature death of cells in living pulmonary  tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10058824</obo:OAE_0004334>
        <rdfs:label>pulmonary necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008682 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a rare condition often diagnosed by either surgery or postmortem examination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25316886/</obo:IAO_0000119>
        <obo:OAE_0001849>肺骨化</obo:OAE_0001849>
        <obo:OAE_0004334>10070310</obo:OAE_0004334>
        <rdfs:label>pulmonary ossification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008683 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a distressing pulmonary feeling often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>肺痛</obo:OAE_0001849>
        <obo:OAE_0004334>10074693</obo:OAE_0004334>
        <rdfs:label>pulmonary pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008684 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which refers to as pseudocysts in the literature, are air-filled thin-walled cysts that are formed in lung interstitium and can be single but are more often multiple.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32310606/</obo:IAO_0000119>
        <obo:OAE_0001849>肺积气</obo:OAE_0001849>
        <obo:OAE_0004334>10063749</obo:OAE_0004334>
        <rdfs:label>pulmonary pneumatocele AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008685 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008685">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a rare medical syndrome in which respiratory failure involving bleeding in the lungs and kidney failure (glomerulonephritis) occur.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary-renal_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肺肾综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10068513</obo:OAE_0004334>
        <rdfs:label>pulmonary renal syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008686 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which can be asymptomatic or result in impairment in quality of life and end-stage, severe, and/or life-threatening disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33059834/</obo:IAO_0000119>
        <obo:OAE_0001849>肺结节病</obo:OAE_0001849>
        <obo:OAE_0004334>10037430</obo:OAE_0004334>
        <rdfs:label>pulmonary sarcoidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008687 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition that arises when the body&apos;s response to infection causes injury to its own tissues and organs such as pulmonary sepsis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>肺脓毒症</obo:OAE_0001849>
        <obo:OAE_0004334>10051739</obo:OAE_0004334>
        <rdfs:label>pulmonary sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008688 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is the medical name for side effects on the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_toxicity</obo:IAO_0000119>
        <obo:OAE_0001849>肺毒性</obo:OAE_0001849>
        <obo:OAE_0004334>10061924</obo:OAE_0004334>
        <rdfs:label>pulmonary toxicity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008689 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is defined as the spontaneously occurring presence of air in the pleural space in patients without clinically apparent underlying lung disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20956196/</obo:IAO_0000119>
        <obo:OAE_0001849>自发性气胸</obo:OAE_0001849>
        <obo:OAE_0004334>10035763</obo:OAE_0004334>
        <rdfs:label>pneumothorax spontaneous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008690 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008690">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a life threatening condition requiring emergent intervention.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30509377/</obo:IAO_0000119>
        <obo:OAE_0001849>气胸自发性张力</obo:OAE_0001849>
        <obo:OAE_0004334>10035764</obo:OAE_0004334>
        <rdfs:label>pneumothorax spontaneous tension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008691 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which result from fibrothorax, secondary to hemothorax, thoracic empyema, tuberculous pleural effusion, or even exposure to asbestos fibers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6459740/</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10035592</obo:OAE_0004334>
        <rdfs:label>pleural calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008692 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008692">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a medical procedure involving the surgical removal of the surface layer, membrane, or fibrous cover of an organ such as pleural.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Decortication</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜剥外皮</obo:OAE_0001849>
        <obo:OAE_0004334>10066322</obo:OAE_0004334>
        <rdfs:label>pleural decortication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008693 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which can result from a variety of inflammatory processes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16716812/</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10035600</obo:OAE_0004334>
        <rdfs:label>pleural fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008694 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a type of cancer that develops from the thin layer of pleural tissue that covers many of the internal organs (known as the mesothelium).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mesothelioma</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜间皮瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10035603</obo:OAE_0004334>
        <rdfs:label>pleural mesothelioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008695 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is an audible medical sign present in some patients with pleurisy and other conditions affecting the chest cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pleural_friction_rub</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜擦伤</obo:OAE_0001849>
        <obo:OAE_0004334>10035615</obo:OAE_0004334>
        <rdfs:label>pleural rub AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008696 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008696">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is an increase in the bulkiness of one or both of the pulmonary pleurae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pleural_thickening</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜增厚</obo:OAE_0001849>
        <obo:OAE_0004334>10035616</obo:OAE_0004334>
        <rdfs:label>pleural thickening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008697 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is inflammation caused by viral of the membranes that surround the lungs and line the chest cavity (pleurae).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pleurisy</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性胸膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052761</obo:OAE_0004334>
        <rdfs:label>pleurisy viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008698 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008698">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is the abnormal presence of air or other gas within tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumatosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺气肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051986</obo:OAE_0004334>
        <rdfs:label>pneumatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008699 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is the general term for a class of interstitial lung diseases where inhalation of dust has caused interstitial fibrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumoconiosis</obo:IAO_0000119>
        <obo:OAE_0001849>尘肺</obo:OAE_0001849>
        <obo:OAE_0004334>10035653</obo:OAE_0004334>
        <rdfs:label>pneumoconiosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008700 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008700">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases involving respiratory tract  abnormal cell growth with the potential to invade or spread to other parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cancer</obo:IAO_0000119>
        <obo:OAE_0001849>恶性呼吸道肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061270</obo:OAE_0004334>
        <rdfs:label>malignant respiratory tract neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008701 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by the bacterium Streptococcus pneumoniae, which is also called the pneumococcus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumococcal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061353</obo:OAE_0004334>
        <rdfs:label>pneumococcal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008702 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008702">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a yeast-like fungus of the genus Pneumocystis caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumocystis_jirovecii</obo:IAO_0000119>
        <obo:OAE_0001849>耶氏肺孢子菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10064107</obo:OAE_0004334>
        <rdfs:label>pneumocystis jiroveci infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008703 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a yeast-like fungus of the genus Pneumocystis caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumocystis_jirovecii</obo:IAO_0000119>
        <obo:OAE_0001849>卡式肺感染</obo:OAE_0001849>
        <obo:OAE_0004334>10073756</obo:OAE_0004334>
        <rdfs:label>pneumocystis jirovecii infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008704 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a form of pneumonia that is caused by the yeast-like fungus Pneumocystis jirovecii.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumocystis_pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>卡式肺孢子菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10073755</obo:OAE_0004334>
        <rdfs:label>pneumocystis jirovecii pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008705 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001164"/>
        <obo:IAO_0000115>This is an AE which is pneumatosis (abnormal presence of air or other gas) in the mediastinum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumomediastinum</obo:IAO_0000119>
        <obo:OAE_0001849>纵隔气肿</obo:OAE_0001849>
        <obo:OAE_0004334>10050184</obo:OAE_0004334>
        <rdfs:label>pneumomediastinum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008706 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a fungal infection caused by Cryptococcus neoformans predominantly in immunosuppressed individuals and rarely in the immunocompetent population.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30363287/</obo:IAO_0000119>
        <obo:OAE_0001849>隐球菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067565</obo:OAE_0004334>
        <rdfs:label>pneumonia cryptococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008707 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition caused by haemophilus of the lung primarily affecting the small air sacs known as alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>嗜血杆菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035702</obo:OAE_0004334>
        <rdfs:label>pneumonia haemophilus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008708 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000319"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition with influenzal of the lung primarily affecting the small air sacs known as alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>流感肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035714</obo:OAE_0004334>
        <rdfs:label>pneumonia influenzal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008709 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a recognised but rare cause of rhabdomyolysis and can be further complicated with renal impairment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31227570/</obo:IAO_0000119>
        <obo:OAE_0001849>军团菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035718</obo:OAE_0004334>
        <rdfs:label>pneumonia legionella AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008710 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a highly contagious infectious disease caused by measles virus and can cause pneumonia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Measles</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10035722</obo:OAE_0004334>
        <rdfs:label>pneumonia measles AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008711 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which refers to the development of necrosis, liquefication, and cavitation of the lung parenchyma from an infectious pathogen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28192581/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10055672</obo:OAE_0004334>
        <rdfs:label>pneumonia necrotising AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008712 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a type of bacterial pneumonia that is caused by Streptococcus pneumoniae (which is also called pneumococcus).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumococcal_pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎球菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035728</obo:OAE_0004334>
        <rdfs:label>pneumonia pneumococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008713 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition caused by  pseudomonal of the lung primarily affecting the small air sacs known as alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>假性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035731</obo:OAE_0004334>
        <rdfs:label>pneumonia pseudomonal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008714 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001422"/>
        <obo:IAO_0000115>This is an AE which is rare, has a high mortality and morbidity rate, and occurs commonly during influenza epidemics (airborne) or during the course of right sided bacterial endocarditis in drug addicts (blood borne).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7460648/</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035734</obo:OAE_0004334>
        <rdfs:label>pneumonia staphylococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008715 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a severe lung infection caused by the bacterium Yersinia pestis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonic_plague</obo:IAO_0000119>
        <obo:OAE_0001849>肺鼠疫</obo:OAE_0001849>
        <obo:OAE_0004334>10053026</obo:OAE_0004334>
        <rdfs:label>pneumonic plague AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008716 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a type of liquefactive necrosis of the lung tissue and formation of cavities (more than 2 cm)containing necrotic debris or fluid caused by microbial infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lung_abscess</obo:IAO_0000119>
        <obo:OAE_0001849>肺脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10025028</obo:OAE_0004334>
        <rdfs:label>lung abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008717 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001146"/>
        <obo:IAO_0000115>This is an AE which is the most common type of lung cancer, and like other forms of lung cancer, it is characterized by distinct cellular and molecular features.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenocarcinoma_of_the_lung</obo:IAO_0000119>
        <obo:OAE_0001849>肺腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10025031</obo:OAE_0004334>
        <rdfs:label>lung adenocarcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008718 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a region of normally compressible lung tissue that has filled with liquid instead of air.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_consolidation</obo:IAO_0000119>
        <obo:OAE_0001849>肺实变</obo:OAE_0001849>
        <obo:OAE_0004334>10025080</obo:OAE_0004334>
        <rdfs:label>lung consolidation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008719 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which has a wall thickness of up to 4 mm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Focal_lung_pneumatosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10068749</obo:OAE_0004334>
        <rdfs:label>lung cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008720 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is dermal thickening causing the lung cutaneous surface to feel thicker and firmer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Secondary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>肺硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10057261</obo:OAE_0004334>
        <rdfs:label>lung induration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008721 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001146"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases involving abnormal cell growth with the potential to invade or spread to other parts of the body such as lung neoplasm malignant.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cancer</obo:IAO_0000119>
        <obo:OAE_0001849>恶性肺肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10058467</obo:OAE_0004334>
        <rdfs:label>lung neoplasm malignant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008722 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000348"/>
        <obo:IAO_0000115>This is an AE which refers abnormal accumulation of fluid in the interstitium, manifesting as swelling on the lower respiratory tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congestion</obo:IAO_0000119>
        <obo:OAE_0001849>下呼吸道充血</obo:OAE_0001849>
        <obo:OAE_0004334>10075565</obo:OAE_0004334>
        <rdfs:label>lower respiratory tract congestion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008723 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a term often used as a synonym for pneumonia but can also be applied to other types of infection caused by bacterial including lung abscess and acute bronchitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lower_respiratory_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>下呼吸道细菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10063890</obo:OAE_0004334>
        <rdfs:label>lower respiratory tract infection bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008724 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008724">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a term often used as a synonym for pneumonia but can also be applied to other types of infection caused by fungal including lung abscess and acute bronchitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lower_respiratory_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>下呼吸道真菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065187</obo:OAE_0004334>
        <rdfs:label>lower respiratory tract infection fungal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008725 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a term often used as a synonym for pneumonia but can also be applied to other types of infection caused by viral including lung abscess and acute bronchitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lower_respiratory_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>下呼吸道病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065188</obo:OAE_0004334>
        <rdfs:label>lower respiratory tract infection viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008726 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of lower respiratory tract  tissues to harmful stimuli, such as pathogens, damaged cells, or irritants,and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>下呼吸道炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10057260</obo:OAE_0004334>
        <rdfs:label>lower respiratory tract inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008727 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is mostly squamous-cell carcinomas, reflecting their origin from the epithelium of the larynx.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngeal_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>喉癌</obo:OAE_0001849>
        <obo:OAE_0004334>10023825</obo:OAE_0004334>
        <rdfs:label>laryngeal cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008728 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is cysts involving the larynx or more frequently supraglottic locations, such as epiglottis and vallecula.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngeal_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>喉囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051848</obo:OAE_0004334>
        <rdfs:label>laryngeal cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008729 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which refers to the larynx and feel discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngeal</obo:IAO_0000119>
        <obo:OAE_0001849>喉不舒服</obo:OAE_0001849>
        <obo:OAE_0004334>10054115</obo:OAE_0004334>
        <rdfs:label>laryngeal discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008730 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is manifested by obstructive breathing patterns reflecting functional or mechanical upper airway obstruction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31882166/</obo:IAO_0000119>
        <obo:OAE_0001849>喉症</obo:OAE_0001849>
        <obo:OAE_0004334>10061263</obo:OAE_0004334>
        <rdfs:label>laryngeal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008731 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a feeling on the laryngeal of not being able to breathe well enough.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shortness_of_breath</obo:IAO_0000119>
        <obo:OAE_0001849>喉呼吸困难</obo:OAE_0001849>
        <obo:OAE_0004334>10052390</obo:OAE_0004334>
        <rdfs:label>laryngeal dyspnoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008732 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is redness of the laryngeal skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>喉红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10051706</obo:OAE_0004334>
        <rdfs:label>laryngeal erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008733 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008733">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of laryngeal tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>喉肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10068840</obo:OAE_0004334>
        <rdfs:label>laryngeal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008734 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which may be a cause of ABD in preterm newborns and it may arise from oesophageal reflux and/or presence of the feeding tube. It can be diagnosed by atraumatic fiberoptic fibroscopy and successfully treated with corticosteroids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15814221/</obo:IAO_0000119>
        <obo:OAE_0001849>喉水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10023845</obo:OAE_0004334>
        <rdfs:label>laryngeal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008735 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008735">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a distressing laryngeal  feeling often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>喉痛</obo:OAE_0001849>
        <obo:OAE_0004334>10023848</obo:OAE_0004334>
        <rdfs:label>laryngeal pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008736 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a rare medical condition in which benign tumors (papilloma) form along the aerodigestive tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngeal_papillomatosis</obo:IAO_0000119>
        <obo:OAE_0001849>喉乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10023849</obo:OAE_0004334>
        <rdfs:label>laryngeal papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008737 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a complex disorder of intralaryngeal and extralaryngeal movement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20798566/</obo:IAO_0000119>
        <obo:OAE_0001849>喉头颤抖</obo:OAE_0001849>
        <obo:OAE_0004334>10078751</obo:OAE_0004334>
        <rdfs:label>laryngeal tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008738 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the larynx (voice box) and is allergic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngitis</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性喉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064866</obo:OAE_0004334>
        <rdfs:label>laryngitis allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008739 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the larynx (voice box) caused by bacterial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngitis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性喉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10063070</obo:OAE_0004334>
        <rdfs:label>laryngitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008740 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the larynx (voice box) caused by viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性喉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10023880</obo:OAE_0004334>
        <rdfs:label>laryngitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008741 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002241"/>
        <obo:IAO_0000115>This is an AE which is the most common cause of chronic stridor in infancy, in which the soft, immature cartilage of the upper larynx collapses inward during inhalation, causing airway obstruction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laryngomalacia</obo:IAO_0000119>
        <obo:OAE_0001849>喉软骨软化病</obo:OAE_0001849>
        <obo:OAE_0004334>10060786</obo:OAE_0004334>
        <rdfs:label>laryngomalacia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008742 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the laryngotracheal tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>喉气管的水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10023893</obo:OAE_0004334>
        <rdfs:label>laryngotracheal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008743 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a larynx state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>喉部刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10058670</obo:OAE_0004334>
        <rdfs:label>larynx irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008744 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001343"/>
        <obo:IAO_0000115>This is an AE which is the enlargement and failure of the right ventricle of the heart as a response to increased vascular resistance (such as from pulmonic stenosis) or high blood pressure in the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_heart_disease</obo:IAO_0000119>
        <obo:OAE_0001849>肺心病</obo:OAE_0001849>
        <obo:OAE_0004334>10010968</obo:OAE_0004334>
        <rdfs:label>cor pulmonale AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008745 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001343"/>
        <obo:IAO_0000115>This is an AE which is the enlargement and failure of the right ventricle of the heart as a response to increased vascular resistance (such as from pulmonic stenosis) or high blood pressure in the lungs and is acute.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_heart_disease</obo:IAO_0000119>
        <obo:OAE_0001849>急性肺心病</obo:OAE_0001849>
        <obo:OAE_0004334>10010969</obo:OAE_0004334>
        <rdfs:label>cor pulmonale acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008746 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001343"/>
        <obo:IAO_0000115>This is an AE which results in right ventricular hypertrophy (RVH), whereas acute pulmonary heart disease usually results in dilatation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_heart_disease</obo:IAO_0000119>
        <obo:OAE_0001849>慢性肺心病</obo:OAE_0001849>
        <obo:OAE_0004334>10010970</obo:OAE_0004334>
        <rdfs:label>cor pulmonale chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008747 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is an abnormal pattern of breathing characterized by progressively deeper, and sometimes faster, breathing followed by a gradual decrease that results in a temporary stop in breathing called an apnea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cheyne%E2%80%93Stokes_respiration</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸节律异常</obo:OAE_0001849>
        <obo:OAE_0004334>10008501</obo:OAE_0004334>
        <rdfs:label>cheyne-stokes respiration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008748 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a malignant lung tumor characterized by uncontrolled cell growth in tissues of the lung.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lung_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>支气管癌</obo:OAE_0001849>
        <obo:OAE_0004334>10006417</obo:OAE_0004334>
        <rdfs:label>bronchial carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008749 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a passage or airway in the respiratory system that conducts air into the lungs and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchus</obo:IAO_0000119>
        <obo:OAE_0001849>支气管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10064913</obo:OAE_0004334>
        <rdfs:label>bronchial disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008750 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a state characterised by easily triggered bronchospasm (contraction of the bronchioles or small airways).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchial_hyperresponsiveness</obo:IAO_0000119>
        <obo:OAE_0001849>支气管高反应性</obo:OAE_0001849>
        <obo:OAE_0004334>10066091</obo:OAE_0004334>
        <rdfs:label>bronchial hyperreactivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008751 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a bronchial state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>支气管发炎</obo:OAE_0001849>
        <obo:OAE_0004334>10006438</obo:OAE_0004334>
        <rdfs:label>bronchial irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a radiologic sign which occurs when excess fluid or mucus buildup in the small airway passages of the lung causes localized patches of atelectasis (lung collapse).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peribronchial_cuffing</obo:IAO_0000119>
        <obo:OAE_0001849>支气管壁增厚</obo:OAE_0001849>
        <obo:OAE_0004334>10067182</obo:OAE_0004334>
        <rdfs:label>bronchial wall thickening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008753 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a disease in which there is permanent enlargement of parts of the airways of the lung.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchiectasis</obo:IAO_0000119>
        <obo:OAE_0001849>支气管扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10006445</obo:OAE_0004334>
        <rdfs:label>bronchiectasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008754 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the bronchi (large and medium-sized airways) in the lungs that causes coughing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10006451</obo:OAE_0004334>
        <rdfs:label>bronchitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008755 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is short-term bronchitis – inflammation of the bronchi (large and medium-sized airways) of the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10006452</obo:OAE_0004334>
        <rdfs:label>bronchitis acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008756 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is inflammation  caused by bacterial of the bronchi (large and medium-sized airways) in the lungs that causes coughing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10061736</obo:OAE_0004334>
        <rdfs:label>bronchitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008757 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a lower respiratory tract disease, defined by a productive cough that lasts for three months or more per year for at least two years.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis#Chronic_bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10006458</obo:OAE_0004334>
        <rdfs:label>bronchitis chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008758 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the bronchi (large and medium-sized airways) in the lungs that causes coughing because pneumococcal infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎球菌支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062487</obo:OAE_0004334>
        <rdfs:label>bronchitis pneumococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008759 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is short term inflammation of the bronchi of the lungs and the cause is a viral infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10053160</obo:OAE_0004334>
        <rdfs:label>bronchitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008760 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a term for weak cartilage in the walls of the bronchial tubes, often occurring in children under a day.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchomalacia</obo:IAO_0000119>
        <obo:OAE_0001849>支气管软化</obo:OAE_0001849>
        <obo:OAE_0004334>10053421</obo:OAE_0004334>
        <rdfs:label>bronchomalacia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008761 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a chronic lung disease in which premature infants, usually those who were treated with supplemental oxygen, require long-term oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchopulmonary_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>支气管肺发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10006475</obo:OAE_0004334>
        <rdfs:label>bronchopulmonary dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008762 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a known complication of endobronchial tuberculosis though most patients with endobronchial stenosis do not develop severe bronchostenosis or occlusion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33614322/</obo:IAO_0000119>
        <obo:OAE_0001849>支气管狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10006487</obo:OAE_0004334>
        <rdfs:label>bronchostenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008763 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is abnormally slow breathing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bradypnea</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸徐缓</obo:OAE_0001849>
        <obo:OAE_0004334>10006102</obo:OAE_0004334>
        <rdfs:label>bradypnoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008764 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001146"/>
        <obo:IAO_0000115>This is an AE which is a mass of cells (tumor) that lacks the ability to either invade neighboring tissue or metastasize (spread throughout the body) such as benign lung neoplasm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>良性肺肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10004280</obo:OAE_0004334>
        <rdfs:label>benign lung neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008765 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is the cessation of breathing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Apnea</obo:IAO_0000119>
        <obo:OAE_0001849>憋气</obo:OAE_0001849>
        <obo:OAE_0004334>10006322</obo:OAE_0004334>
        <rdfs:label>breath holding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008766 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a sleep disorder in which abnormalities in breathing occur during sleep that may or may not be present while awake.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sleep-related_breathing_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>与呼吸相关的睡眠障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10006344</obo:OAE_0004334>
        <rdfs:label>breathing-related sleep disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008767 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the vocal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>声带萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10050201</obo:OAE_0004334>
        <rdfs:label>vocal cord atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008768 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a pathology affecting the vocal folds (commonly referred to as the vocal cords)characterized by full or partial vocal fold closure causing difficulty and distress during respiration, especially during inhalation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vocal_cord_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>声带功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061581</obo:OAE_0004334>
        <rdfs:label>vocal cord dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008769 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of vocal cord  tissues to harmful stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>声带炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10057295</obo:OAE_0004334>
        <rdfs:label>vocal cord inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008770 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is an injury to one or both recurrent laryngeal nerves (RLNs), which control all muscles of the larynx except for the cricothyroid muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vocal_cord_paresis</obo:IAO_0000119>
        <obo:OAE_0001849>声带麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10047674</obo:OAE_0004334>
        <rdfs:label>vocal cord paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008771 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is an injury to one or both recurrent laryngeal nerves (RLNs), which control all muscles of the larynx except for the cricothyroid muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vocal_cord_paresis</obo:IAO_0000119>
        <obo:OAE_0001849>声带麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10049234</obo:OAE_0004334>
        <rdfs:label>vocal cord paresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008772 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is bilaterally symmetrical benign white masses that form at the midpoint of the vocal folds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vocal_cord_nodule</obo:IAO_0000119>
        <obo:OAE_0001849>声带息肉</obo:OAE_0001849>
        <obo:OAE_0004334>10047675</obo:OAE_0004334>
        <rdfs:label>vocal cord polyp AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008773 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is an illness caused by an acute bacterial  infection, which involves the upper respiratory tract, including the nose, sinuses, pharynx, larynx or trachea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Upper_respiratory_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>上呼吸道细菌性感染</obo:OAE_0001849>
        <obo:OAE_0004334>10057868</obo:OAE_0004334>
        <rdfs:label>upper respiratory tract infection bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008774 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of body tissues to harmful stimuli such as upper respiratory tract inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>上呼吸道炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10049590</obo:OAE_0004334>
        <rdfs:label>upper respiratory tract inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008775 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is a upper respiratory tract state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>上呼吸道刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10070841</obo:OAE_0004334>
        <rdfs:label>upper respiratory tract irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008776 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which occurs when excessive mucus is produced by the nasal mucosa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Post-nasal_drip</obo:IAO_0000119>
        <obo:OAE_0001849>上呼吸道咳嗽综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10070488</obo:OAE_0004334>
        <rdfs:label>upper-airway cough syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008777 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is an illness caused by an acute viral  infection, which involves the upper respiratory tract, including the nose, sinuses, pharynx, larynx or trachea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Upper_respiratory_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性上呼吸道感染</obo:OAE_0001849>
        <obo:OAE_0004334>10047482</obo:OAE_0004334>
        <rdfs:label>viral upper respiratory tract infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008778 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is pathological conditions affecting the organs and tissues that make gas exchange difficult in air-breathing animals and is allergic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_disease</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性呼吸道疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10063532</obo:OAE_0004334>
        <rdfs:label>allergic respiratory disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008779 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is defined as cessation of breathing with implicit pathophysiology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23714577/</obo:IAO_0000119>
