    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005972 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005972">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>This is an AE which is a hearing impairment characterized by difficulty in processing details of sound due to distortion in frequency or intensity rather than primarily a loss of the ability to perceive sound.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
