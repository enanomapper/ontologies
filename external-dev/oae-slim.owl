        <rdfs:label>urinary tract stoma complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005608 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>This is an AE which is defined as the involuntary retrograde passage of gastric contents into the esophagus with or without regurgitation or vomiting.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23322552/</obo:IAO_0000119>
        <obo:OAE_0001849>胃食管括约肌功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10062879</obo:OAE_0004334>
        <rdfs:label>gastresophageal sphincter insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005609 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>This is an AE which is the involuntary, forceful expulsion of the contents of one&apos;s stomach through the mouth and sometimes the nose and is discoloured.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vomiting</obo:IAO_0000119>
