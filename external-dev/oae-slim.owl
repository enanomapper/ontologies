    <!-- http://purl.obolibrary.org/obo/OAE_0005490 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is the space in the skull within the neurocranium, occupied by the brain and the  is imperfectly composed in newborns, to allow the large human head to pass through the birth canal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cranial_vault</obo:IAO_0000119>
        <obo:OAE_0001849>先天性颅穹窿缺失</obo:OAE_0001849>
        <obo:OAE_0004334>10010318</obo:OAE_0004334>
        <rdfs:label>congenital absence of cranial vault AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005491 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is  the organs of the reproductive system and the urinary system and the organs are congenital malformation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Genitourinary_system</obo:IAO_0000119>
        <obo:OAE_0001849>先天性生殖器畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062333</obo:OAE_0004334>
        <rdfs:label>congenital genital malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005492 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002509"/>
        <obo:IAO_0000115>This is an AE which is a spectrum of conditions which is congenital  caused by infection with the human immunodeficiency virus (HIV)  , a retrovirus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/HIV/AIDS</obo:IAO_0000119>
        <obo:OAE_0001849>先天性感染艾滋病毒</obo:OAE_0001849>
        <obo:OAE_0004334>10010504</obo:OAE_0004334>
        <rdfs:label>congenital hiv infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005493 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is syphilis present in utero and at birth, and occurs when a child is born to a mother with syphilis and osteochondritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_syphilis</obo:IAO_0000119>
        <obo:OAE_0001849>先天性梅毒的骨软骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10054002</obo:OAE_0004334>
        <rdfs:label>congenital syphilitic osteochondritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005494 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a condition thymus present at birth regardless of its cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性胸腺缺失</obo:OAE_0001849>
        <obo:OAE_0004334>10048801</obo:OAE_0004334>
        <rdfs:label>congenital thymus absence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005495 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a family of birth defects of the ureter, the bladder, and the urethra.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23408557/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性输尿管膀胱交界异常</obo:OAE_0001849>
        <obo:OAE_0004334>10068133</obo:OAE_0004334>
        <rdfs:label>congenital ureterovesical junction anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005496 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a defect in the structure of the heart or great vessels that is present at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_heart_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性心脏瓣膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10064086</obo:OAE_0004334>
        <rdfs:label>congenital heart valve disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005497 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002402"/>
        <obo:IAO_0000115>This is an AE which is a missing, extra, or irregular portion of chromosomal DNA.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chromosome_abnormality</obo:IAO_0000119>
        <obo:OAE_0001849>x连锁染色体病</obo:OAE_0001849>
        <obo:OAE_0004334>10056554</obo:OAE_0004334>
