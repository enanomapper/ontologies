        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001881"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the tonsils in the upper part of the throat caused by viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tonsillitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性扁桃体炎</obo:OAE_0001849>
