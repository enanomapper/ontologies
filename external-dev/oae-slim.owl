        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001951"/>
        <obo:IAO_0000115>This is an AE which is a rare and potentially limb- and life-threatening injury, that results from high-energy trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
