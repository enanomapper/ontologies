        <rdfs:label>drug withdrawal convulsions AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007302 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002752"/>
        <obo:IAO_0000115>This is an AE which is an abnormal condition of the mind that results in difficulties determining what is real and what is not real and it is transient.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychosis</obo:IAO_0000119>
        <obo:OAE_0001849>短暂的精神病</obo:OAE_0001849>
        <obo:OAE_0004334>10056326</obo:OAE_0004334>
        <rdfs:label>transient psychosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007303 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002752"/>
        <obo:IAO_0000115>This is an AE which is a very specific syndrome in relation to seizure activity: a clear temporal relationship exists between the psychotic state of sudden onset and a precipitating bout of complex partial or generalized seizures, with a characteristic lucid interval which lasts from two to 120h.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19683323/</obo:IAO_0000119>
        <obo:OAE_0001849>发作后精神病</obo:OAE_0001849>
        <obo:OAE_0004334>10070669</obo:OAE_0004334>
        <rdfs:label>postictal psychosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007304 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001336"/>
        <obo:IAO_0000115>This is an AE which is a behavioral disorder characterized by explosive outbursts of anger and/or violence, often to the point of rage, that are disproportionate to the situation at hand (e.g., impulsive shouting, screaming or excessive reprimanding triggered by relatively inconsequential events).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intermittent_explosive_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>间歇性暴发性精神障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10022568</obo:OAE_0004334>
        <rdfs:label>intermittent explosive disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007305 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder, specifically a disorder primarily of mood, consisting of the same cognitive and physical problems as depression, but with longer-lasting symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysthymia</obo:IAO_0000119>
        <obo:OAE_0001849>精神抑郁症</obo:OAE_0001849>
        <obo:OAE_0004334>10013982</obo:OAE_0004334>
        <rdfs:label>dysthymic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007306 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001336"/>
        <obo:IAO_0000115>This is an AE which is a form of psychosis that is attributed to substance use.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Substance-induced_psychosis</obo:IAO_0000119>
        <obo:OAE_0001849>物质诱发的精神障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10072388</obo:OAE_0004334>
        <rdfs:label>substance-induced psychotic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007307 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001336"/>
        <obo:IAO_0000115>This is an AE which is a lipid-rich (fatty) substance that surrounds nerve cell axons (the nervous system&apos;s &quot;wires&quot;) to insulate them and increase the rate at which electrical impulses (called action potentials) are passed along the axon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myelin</obo:IAO_0000119>
        <obo:OAE_0001849>髓鞘形成障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10067601</obo:OAE_0004334>
        <rdfs:label>dysmyelination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007308 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000433"/>
        <obo:IAO_0000115>This is an AE which is a personality disorder characterized by a long-term pattern of unstable interpersonal relationships, distorted sense of self, and strong emotional reactions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Borderline_personality_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>边缘型人格障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10006034</obo:OAE_0004334>
        <rdfs:label>borderline personality disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007309 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a communication disorder in which there are difficulties with verbal and written expression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Expressive_language_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>表达性语言障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10015715</obo:OAE_0004334>
        <rdfs:label>expressive language disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007310 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a class of psychiatric disorders characterized by impulsivity – failure to resist a temptation, an urge, or an impulse; or having the inability to not speak on a thought.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Impulse-control_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>冲动控制障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061215</obo:OAE_0004334>
        <rdfs:label>impulse-control disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007311 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is one of several chronic circadian rhythm sleep disorders (CRSDs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Non-24-hour_sleep%E2%80%93wake_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>非24小时睡眠-觉醒障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10078086</obo:OAE_0004334>
        <rdfs:label>non-24-hour sleep-wake disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007312 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder characterized by abnormal thought processes and an unstable mood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schizoaffective_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>分裂情感障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10039621</obo:OAE_0004334>
        <rdfs:label>schizoaffective disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007313 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000433"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioural disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schizotypal_personality_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>分裂型人格障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10039651</obo:OAE_0004334>
        <rdfs:label>schizotypal personality disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007314 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000433"/>
        <obo:IAO_0000115>This is an AE which is a personality disorder characterized by a lack of interest in social relationships, a tendency toward a solitary or sheltered lifestyle, secretiveness, emotional coldness, detachment and apathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schizoid_personality_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>精神分裂样人格障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10039624</obo:OAE_0004334>
        <rdfs:label>schizoid personality disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007315 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a condition in which multisensory input is not adequately processed in order to provide appropriate responses to the demands of the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sensory_processing_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>感觉处理障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077516</obo:OAE_0004334>
        <rdfs:label>sensory processing disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007316 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>This is an AE which is a condition in which multisensory input is not adequately processed in order to provide appropriate responses to the demands of the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sensory_processing_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>感觉统合功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10048871</obo:OAE_0004334>
        <rdfs:label>sensory integrative dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007317 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the large posterior area of the human body, rising from the top of the buttocks to the back of the neck and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_back</obo:IAO_0000119>
        <obo:OAE_0001849>背部疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10003983</obo:OAE_0004334>
        <rdfs:label>back disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007318 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a diagnostic category defining patients who have both anxiety and depressive symptoms of limited and equal intensity accompanied by at least some autonomic features.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mixed_anxiety%E2%80%93depressive_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>混合焦虑和抑郁障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10080836</obo:OAE_0004334>
        <rdfs:label>mixed anxiety and depressive disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007319 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a communication disorder in which both the receptive and expressive areas of communication may be affected in any degree, from mild to severe.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mixed_receptive-expressive_language_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>混合接受-表达语言障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10027778</obo:OAE_0004334>
        <rdfs:label>mixed receptive-expressive language disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007320 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000240"/>
        <obo:IAO_0000115>This is an AE which is a psychological response to a terrifying, traumatic, or surprising experience.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_stress_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>急性应激障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10001084</obo:OAE_0004334>
        <rdfs:label>acute stress disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007321 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a disability resulting in difficulty learning or comprehending arithmetic, such as difficulty in understanding numbers, learning how to manipulate numbers, performing mathematical calculations and learning facts in mathematics.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dyscalculia</obo:IAO_0000119>
        <obo:OAE_0001849>计算障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10049669</obo:OAE_0004334>
        <rdfs:label>dyscalculia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007322 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is any disease that has the connective tissues of the body as a target of pathology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Connective_tissue_disease</obo:IAO_0000119>
        <obo:OAE_0001849>胶原蛋白疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10009903</obo:OAE_0004334>
        <rdfs:label>collagen disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007323 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001798"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder with anxiety,  which is a maladaptive response to a psychosocial stressor that occurs when an individual has significant difficulty adjusting to or coping with a stressful psychosocial event.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adjustment_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>焦虑性适应障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10001296</obo:OAE_0004334>
        <rdfs:label>adjustment disorder with anxiety AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007324 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>This is an AE which is a cluster of mental disorders characterized by significant and uncontrollable feelings of anxiety and fear such that a person&apos;s social, occupational, and personal function are significantly impaired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anxiety_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>焦虑性障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10057666</obo:OAE_0004334>
        <rdfs:label>anxiety disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007325 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002429"/>
        <obo:IAO_0000115>This is an AE which is conditions that involve disruptions or breakdowns of memory, awareness, identity, or perception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dissociative_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>解离性障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10013462</obo:OAE_0004334>
        <rdfs:label>dissociative disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007326 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is the process by which food is crushed and ground by teeth and the process becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chewing</obo:IAO_0000119>
        <obo:OAE_0001849>咀嚼障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10026882</obo:OAE_0004334>
        <rdfs:label>mastication disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007327 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000433"/>
        <obo:IAO_0000115>This is an AE which is a cluster C personality disorder marked by an excessive need for orderliness, neatness, and perfectionism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Obsessive%E2%80%93compulsive_personality_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>强迫性人格障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10029901</obo:OAE_0004334>
        <rdfs:label>obsessive-compulsive personality disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007328 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a group of conditions of mental and behavioral disorder where a disturbance in the person&apos;s mood is the main underlying feature.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mood_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>情感障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10001443</obo:OAE_0004334>
        <rdfs:label>affective disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007329 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which refers to frequent and persistent detachment from bodily self and disengagement from the outside world.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32846163/</obo:IAO_0000119>
        <obo:OAE_0001849>人格解体/现实感丧失障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077805</obo:OAE_0004334>
        <rdfs:label>depersonalisation/derealisation disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007330 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is the decreased ability to see color or differences in color.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Color_blindness</obo:IAO_0000119>
        <obo:OAE_0001849>色觉障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10013892</obo:OAE_0004334>
        <rdfs:label>dyschromatopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007331 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000043"/>
        <obo:IAO_0000115>This is an AE which is a disorder where individuals have difficulties with verbal and nonverbal social communication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Social_(pragmatic)_communication_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>社交沟通障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10078320</obo:OAE_0004334>
        <rdfs:label>social (pragmatic) communication disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007332 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001666"/>
        <obo:IAO_0000115>This is an AE which is the most abundant type of granulocytes and make up 40% to 70% of all white blood cells in humans but it becomes function disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neutrophil</obo:IAO_0000119>
        <obo:OAE_0001849>嗜中性粒细胞功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061314</obo:OAE_0004334>
        <rdfs:label>neutrophil function disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007333 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is clinically associated with left ventricular failure in the presence of marked cardiomegaly, while diastolic dysfunction is accompanied by pulmonary congestion together with a normal or only slightly enlarged ventricle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7713107/</obo:IAO_0000119>
        <obo:OAE_0001849>收缩功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10071436</obo:OAE_0004334>
        <rdfs:label>systolic dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007334 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder characterized by the obsessive idea that some aspect of one&apos;s own body part or appearance is severely flawed and therefore warrants exceptional measures to hide or fix it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Body_dysmorphic_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>躯体变形障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10052793</obo:OAE_0004334>
        <rdfs:label>body dysmorphic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007335 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is physical pain that is caused, increased, or prolonged by mental, emotional, or behavioral factors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychogenic_pain</obo:IAO_0000119>
        <obo:OAE_0001849>心因性疼痛障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10037198</obo:OAE_0004334>
        <rdfs:label>psychogenic pain disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007336 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a condition in the brain that causes difficulties comprehending or processing information and can be caused by several different factors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Learning_disability</obo:IAO_0000119>
        <obo:OAE_0001849>学习能力障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061265</obo:OAE_0004334>
        <rdfs:label>learning disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007337 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is a condition in the brain that causes difficulties comprehending or processing information and can be caused by several different factors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Learning_disability</obo:IAO_0000119>
        <obo:OAE_0001849>学习障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10024092</obo:OAE_0004334>
        <rdfs:label>learning disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007338 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>This is an AE which is a speech disorder in which some sounds (phonemes) are not produced or used correctly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Speech_sound_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>言语声音障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077803</obo:OAE_0004334>
        <rdfs:label>speech sound disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007339 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is disorders that involve the processing of linguistic information.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Language_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>语言障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10074869</obo:OAE_0004334>
        <rdfs:label>language disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007340 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a condition in which a sufferer displays difficulty reading.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reading_disability</obo:IAO_0000119>
        <obo:OAE_0001849>阅读障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10037999</obo:OAE_0004334>
        <rdfs:label>reading disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007341 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a neurodevelopmental disorder characterized by impaired coordination of physical movements as a result of brain messages not being accurately transmitted to the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Developmental_coordination_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10013976</obo:OAE_0004334>
        <rdfs:label>dyspraxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007342 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is probably a different disease than chronic tic disorders including Gilles de la Tourette syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4850871/</obo:IAO_0000119>
        <obo:OAE_0001849>暂时性抽动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10076694</obo:OAE_0004334>
        <rdfs:label>provisional tic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007343 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder whose most notable features are pain in the mandibular, ocular and rectal areas as well as flushing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paroxysmal_extreme_pain_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>阵发性极度疼痛障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10081856</obo:OAE_0004334>
        <rdfs:label>paroxysmal extreme pain disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007344 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a disruption to the efficacy of the executive functions, which is a group of cognitive processes that regulate, control, and manage other cognitive processes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Executive_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>执行功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10070246</obo:OAE_0004334>
        <rdfs:label>executive dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007345 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a neurodevelopmental disorder affecting the way the brain processes auditory information.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Auditory_processing_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>中枢性听觉处理障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10065165</obo:OAE_0004334>
        <rdfs:label>central auditory processing disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007346 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a family of sleep disorders which affect the timing of sleep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Circadian_rhythm_sleep_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>昼夜节律睡眠障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10009191</obo:OAE_0004334>
        <rdfs:label>circadian rhythm sleep disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007347 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is a condition in which a person has difficulties sitting or is unable to do so at all; usually due to pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sitting_disability</obo:IAO_0000119>
        <obo:OAE_0001849>坐姿障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10081807</obo:OAE_0004334>
        <rdfs:label>sitting disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007348 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is the false perception of tactile sensory input that creates a hallucinatory sensation of physical contact with an imaginary object.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tactile_hallucination</obo:IAO_0000119>
        <obo:OAE_0001849>触觉幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10019074</obo:OAE_0004334>
        <rdfs:label>hallucination, tactile AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007349 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of various medical conditions which manifests as a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli such as teeth hypoesthesia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿触觉减退</obo:OAE_0001849>
        <obo:OAE_0004334>10051780</obo:OAE_0004334>
        <rdfs:label>hypoesthesia teeth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007350 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of various medical conditions which manifests as a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli such as hypoaesthesia facial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>面部触觉减退</obo:OAE_0001849>
        <obo:OAE_0004334>10065312</obo:OAE_0004334>
        <rdfs:label>hypoesthesia facial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007351 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002206"/>
        <obo:IAO_0000115>This is an AE which is a common clinical condition characterized by difficulty initiating or maintaining sleep, accompanied by symptoms such as irritability or fatigue during wakefulness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23423416/</obo:IAO_0000119>
        <obo:OAE_0001849>初始性失眠</obo:OAE_0001849>
        <obo:OAE_0004334>10022035</obo:OAE_0004334>
        <rdfs:label>initial insomnia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007352 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000184"/>
        <obo:IAO_0000115>This is an AE which is a neurodegenerative disease that usually starts slowly and progressively worsens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alzheimer%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>痴呆症阿尔茨海默氏型</obo:OAE_0001849>
        <obo:OAE_0004334>10012271</obo:OAE_0004334>
        <rdfs:label>dementia alzheimer&apos;s type AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007353 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a sleep disorder in which people have trouble sleeping.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Insomnia</obo:IAO_0000119>
        <obo:OAE_0001849>不眠症</obo:OAE_0001849>
        <obo:OAE_0004334>10067530</obo:OAE_0004334>
        <rdfs:label>hyposomnia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007354 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder in which a person has intrusive thoughts (called &quot;obsessions&quot;) and/or feels the need to perform certain routines repeatedly (called &quot;compulsions&quot;) to an extent where it induces distress or impairs one&apos;s general functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Obsessive%E2%80%93compulsive_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>强迫思维</obo:OAE_0001849>
        <obo:OAE_0004334>10029897</obo:OAE_0004334>
        <rdfs:label>obsessive thoughts AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007355 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is an umbrella name for impulse control behaviors involving compulsively damaging one&apos;s physical appearance or causing physical injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Body-focused_repetitive_behavior</obo:IAO_0000119>
        <obo:OAE_0001849>强迫性咬唇</obo:OAE_0001849>
        <obo:OAE_0004334>10066241</obo:OAE_0004334>
        <rdfs:label>compulsive lip biting AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007356 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder in which a person has intrusive thoughts (called &quot;obsessions&quot;) and/or feels the need to perform certain routines repeatedly (called &quot;compulsions&quot;) to an extent where it induces distress or impairs one&apos;s general functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Obsessive%E2%80%93compulsive_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>强迫性症状</obo:OAE_0001849>
        <obo:OAE_0004334>10077894</obo:OAE_0004334>
        <rdfs:label>obsessive-compulsive symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007357 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder in which a person has intrusive thoughts (called &quot;obsessions&quot;) and/or feels the need to perform certain routines repeatedly (called &quot;compulsions&quot;) to an extent where it induces distress or impairs one&apos;s general functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Obsessive%E2%80%93compulsive_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>强迫症</obo:OAE_0001849>
        <obo:OAE_0004334>10029898</obo:OAE_0004334>
        <rdfs:label>obsessive-compulsive disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007358 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000306"/>
        <obo:IAO_0000115>This is an AE which refers a toxic condition in which neurological symptoms arise without a definable organic cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conversion</obo:IAO_0000119>
        <obo:OAE_0001849>强直性惊厥</obo:OAE_0001849>
        <obo:OAE_0004334>10043994</obo:OAE_0004334>
        <rdfs:label>tonic convulsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007359 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the act of cleaning one&apos;s hands with soap and water to remove viruses/bacteria/microorganisms, dirt, grease, or other harmful and unwanted substances stuck to the hands and is compulsive .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hand_washing</obo:IAO_0000119>
        <obo:OAE_0001849>强制洗手</obo:OAE_0001849>
        <obo:OAE_0004334>10071263</obo:OAE_0004334>
        <rdfs:label>compulsive handwashing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007360 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a condition of reduced emotional reactivity in an individual.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reduced_affect_display</obo:IAO_0000119>
        <obo:OAE_0001849>情感迟钝</obo:OAE_0001849>
        <obo:OAE_0004334>10005885</obo:OAE_0004334>
        <rdfs:label>blunted affect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007361 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004357"/>
        <obo:IAO_0000115>This is an AE which is an extreme or rapid change in mood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mood_swing</obo:IAO_0000119>
        <obo:OAE_0001849>情绪波动</obo:OAE_0001849>
        <obo:OAE_0004334>10027951</obo:OAE_0004334>
        <rdfs:label>mood swings AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007362 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder characterized by at least two weeks of pervasive low mood, low self-esteem, and loss of interest or pleasure in normally enjoyable activities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Major_depressive_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>重度抑郁症</obo:OAE_0001849>
        <obo:OAE_0004334>10057840</obo:OAE_0004334>
        <rdfs:label>major depression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007363 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder, specifically a disorder primarily of mood, consisting of the same cognitive and physical problems as depression, but with longer-lasting symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysthymia</obo:IAO_0000119>
        <obo:OAE_0001849>持续的抑郁症</obo:OAE_0001849>
        <obo:OAE_0004334>10077804</obo:OAE_0004334>
        <rdfs:label>persistent depressive disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007364 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the repetition of a particular response (such as a word, phrase, or gesture) regardless of the absence or cessation of a stimulus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perseveration</obo:IAO_0000119>
        <obo:OAE_0001849>持续言语</obo:OAE_0001849>
        <obo:OAE_0004334>10034703</obo:OAE_0004334>
        <rdfs:label>perseveration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007365 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which is a state of low mood and aversion to activity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Depressive_symptoms?wprov=srpw1_0</obo:IAO_0000119>
        <obo:OAE_0001849>抑郁症状</obo:OAE_0001849>
        <obo:OAE_0004334>10054089</obo:OAE_0004334>
        <rdfs:label>depressive symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007366 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which is the act of intentionally causing one&apos;s own death caused by depression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Suicide</obo:IAO_0000119>
        <obo:OAE_0001849>抑郁症自杀</obo:OAE_0001849>
        <obo:OAE_0004334>10012397</obo:OAE_0004334>
        <rdfs:label>depression suicidal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007367 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which means difficulties in talking due to structural defects in speech organs, such as sigmatism (defective pronunciation of sibilant sounds, for example &quot;S&quot; pronounced as &quot;TH&quot;) and rhotacism, in which the letter &quot;R&quot; pronounced as &quot;I or Y&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dyslalia</obo:IAO_0000119>
        <obo:OAE_0001849>言语困难</obo:OAE_0001849>
        <obo:OAE_0004334>10013931</obo:OAE_0004334>
        <rdfs:label>dyslalia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007368 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which describes excessive speech at a rapid rate that involves causal association between ideas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glossary_of_psychiatry#flight_of_ideas</obo:IAO_0000119>
        <obo:OAE_0001849>意念飞跃</obo:OAE_0001849>
        <obo:OAE_0004334>10016777</obo:OAE_0004334>
        <rdfs:label>flight of ideas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007369 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001995"/>
        <obo:IAO_0000115>This is an AE which is a state which occurs when the ability to maintain an awareness of self and environment is lost.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Unconsciousness</obo:IAO_0000119>
        <obo:OAE_0001849>意识丧失</obo:OAE_0001849>
        <obo:OAE_0004334>10024855</obo:OAE_0004334>
        <rdfs:label>loss of consciousness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007370 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which refers to a lack of will or initiative and can be seen as a disorder of diminished motivation (DDM).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abulia</obo:IAO_0000119>
        <obo:OAE_0001849>意志力丧失</obo:OAE_0001849>
        <obo:OAE_0004334>10050013</obo:OAE_0004334>
        <rdfs:label>abulia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007371 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <obo:IAO_0000115>This is an AE which is human vocal communication using language and it is slow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Speech</obo:IAO_0000119>
        <obo:OAE_0001849>语速缓慢</obo:OAE_0001849>
        <obo:OAE_0004334>10071299</obo:OAE_0004334>
        <rdfs:label>slow speech AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007372 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>This is an AE which is sudden periods of intense fear and discomfort that may include palpitations, sweating, chest pain, shaking, shortness of breath, numbness, or a feeling of impending doom or of losing control.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panic_attack</obo:IAO_0000119>
        <obo:OAE_0001849>预期性焦虑</obo:OAE_0001849>
        <obo:OAE_0004334>10002758</obo:OAE_0004334>
        <rdfs:label>anticipatory anxiety AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007373 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>This is an AE which is an anxiety disorder characterized by sentiments of fear and anxiety in social situations, causing considerable distress and impaired ability to function in at least some aspects of daily life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Social_anxiety_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>社交焦虑症</obo:OAE_0001849>
        <obo:OAE_0004334>10041242</obo:OAE_0004334>
        <rdfs:label>social anxiety disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007374 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002096"/>
        <obo:IAO_0000115>This is an AE which is an intensely unpleasant emotion in response to perceiving or recognizing a danger or threat such as social communication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fear</obo:IAO_0000119>
        <obo:OAE_0001849>社交恐惧</obo:OAE_0001849>
        <obo:OAE_0004334>10041247</obo:OAE_0004334>
        <rdfs:label>social fear AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007375 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001889"/>
        <obo:IAO_0000115>This is an AE which is an anxiety disorder characterized by sentiments of fear and anxiety in social situations, causing considerable distress and impaired ability to function in at least some aspects of daily life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Social_anxiety_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>社交恐惧症</obo:OAE_0001849>
        <obo:OAE_0004334>10041250</obo:OAE_0004334>
        <rdfs:label>social phobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007376 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a category of sleep disorders that involve abnormal movements, behaviors, emotions, perceptions, and dreams that occur while falling asleep, sleeping, between sleep stages, or during arousal from sleep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parasomnia</obo:IAO_0000119>
        <obo:OAE_0001849>深眠状态</obo:OAE_0001849>
        <obo:OAE_0004334>10061910</obo:OAE_0004334>
        <rdfs:label>parasomnia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007377 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a phenomenon of combined sleep and wakefulness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sleepwalking</obo:IAO_0000119>
        <obo:OAE_0001849>梦游</obo:OAE_0001849>
        <obo:OAE_0004334>10041012</obo:OAE_0004334>
        <rdfs:label>sleep walking AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007378 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000115>This is an AE which is closely related to emotion, and usually refers to the conscious subjective experience of emotions such as jittery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Feeling</obo:IAO_0000119>
        <obo:OAE_0001849>感到紧张不安</obo:OAE_0001849>
        <obo:OAE_0004334>10016338</obo:OAE_0004334>
        <rdfs:label>feeling jittery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007379 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000947"/>
        <obo:IAO_0000115>This is an AE which is defined as an unpleasant, abnormal sense of touch.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>感觉不良</obo:OAE_0001849>
        <obo:OAE_0004334>10013886</obo:OAE_0004334>
        <rdfs:label>dysaesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007380 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which occurs when one or more of the body&apos;s senses experiences over-stimulation from the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sensory_overload</obo:IAO_0000119>
        <obo:OAE_0001849>感觉超负荷</obo:OAE_0001849>
        <obo:OAE_0004334>10079780</obo:OAE_0004334>
        <rdfs:label>sensory overload AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007381 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the  mucosal skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>感觉异常黏膜</obo:OAE_0001849>
        <obo:OAE_0004334>10033780</obo:OAE_0004334>
        <rdfs:label>paraesthesia mucosal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007382 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is numbness or pain in the outer thigh not caused by injury to the thigh, but by injury to a nerve that extends from the spinal column to the thigh.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meralgia_paraesthetica</obo:IAO_0000119>
        <obo:OAE_0001849>感应异常性股痛</obo:OAE_0001849>
        <obo:OAE_0004334>10027385</obo:OAE_0004334>
        <rdfs:label>meralgia paraesthetica AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007387 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which is a state of low mood and aversion to activity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Depression_(mood)</obo:IAO_0000119>
        <obo:OAE_0001849>情感低落</obo:OAE_0001849>
        <obo:OAE_0004334>10012374</obo:OAE_0004334>
        <rdfs:label>depressed mood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007388 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is a condition in which a person with a disability is cognitively unaware of having it due to an underlying physical condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anosognosia</obo:IAO_0000119>
        <obo:OAE_0001849>病感失认症</obo:OAE_0001849>
        <obo:OAE_0004334>10068346</obo:OAE_0004334>
        <rdfs:label>anosognosia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007389 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is an instinct or thought process that is believed to be heavily influenced by anxiety or fear, often to the point of delusion and irrationality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paranoia</obo:IAO_0000119>
        <obo:OAE_0001849>偏执狂</obo:OAE_0001849>
        <obo:OAE_0004334>10033864</obo:OAE_0004334>
        <rdfs:label>paranoia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007390 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002491"/>
        <obo:IAO_0000115>This is an AE which is a set of delusional conditions in which the affected persons believe they are being persecuted, despite a lack of evidence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Persecutory_delusion</obo:IAO_0000119>
        <obo:OAE_0001849>迫害妄想</obo:OAE_0001849>
        <obo:OAE_0004334>10034702</obo:OAE_0004334>
        <rdfs:label>persecutory delusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007391 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is transitory pain that comes on suddenly and is not alleviated by the patient&apos;s regular pain management.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain#Breakthrough_pain</obo:IAO_0000119>
        <obo:OAE_0001849>爆发性疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10064556</obo:OAE_0004334>
        <rdfs:label>breakthrough pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007392 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000479"/>
        <obo:IAO_0000115>This is an AE which is suggested to be similar to classic migraines, with cortical spreading depression leading to aura formation but without an associated headache.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30225597/</obo:IAO_0000119>
        <obo:OAE_0001849>复杂性偏头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10056236</obo:OAE_0004334>
        <rdfs:label>complicated migraine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007393 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is memory-based delusion or confabulation, or an inability to distinguish between real and fantasy memories.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paramnesia</obo:IAO_0000119>
        <obo:OAE_0001849>副失忆症</obo:OAE_0001849>
        <obo:OAE_0004334>10033848</obo:OAE_0004334>
        <rdfs:label>paramnesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007394 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a neurodevelopmental disorder characterized by significant difficulties in social interaction and nonverbal communication, along with restricted and repetitive patterns of behavior and interests.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Asperger_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>孤独症</obo:OAE_0001849>
        <obo:OAE_0004334>10003484</obo:OAE_0004334>
        <rdfs:label>asperger&apos;s disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007395 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a borrowed French word expressing the feeling that one has lived through the present situation before.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/D%C3%A9j%C3%A0_vu</obo:IAO_0000119>
        <obo:OAE_0001849>幻觉记忆</obo:OAE_0001849>
        <obo:OAE_0004334>10012177</obo:OAE_0004334>
        <rdfs:label>deja vu AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007396 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000482"/>
        <obo:IAO_0000115>This is an AE which is a memory disorder characterized by sudden retrograde episodic memory loss, said to occur for a period of time ranging from hours to years to decades.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychogenic_amnesia</obo:IAO_0000119>
        <obo:OAE_0001849>解离性失忆</obo:OAE_0001849>
        <obo:OAE_0004334>10013461</obo:OAE_0004334>
        <rdfs:label>dissociative amnesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007397 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is the most common type of primary headache.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tension_headache</obo:IAO_0000119>
        <obo:OAE_0001849>紧张性头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10043269</obo:OAE_0004334>
        <rdfs:label>tension headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007398 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002096"/>
        <obo:IAO_0000115>This is an AE which is an extreme or irrational fear or phobia of heights, especially when one is not particularly high up.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acrophobia</obo:IAO_0000119>
        <obo:OAE_0001849>恐高症</obo:OAE_0001849>
        <obo:OAE_0004334>10000605</obo:OAE_0004334>
        <rdfs:label>acrophobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007399 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder, specifically an anxiety disorder characterized by reoccurring unexpected panic attacks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panic_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>恐慌症</obo:OAE_0001849>
        <obo:OAE_0004334>10033666</obo:OAE_0004334>
        <rdfs:label>panic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is a mixed  perception in the absence of an external stimulus that has the qualities of a real perception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hallucination</obo:IAO_0000119>
        <obo:OAE_0001849>混合幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10019079</obo:OAE_0004334>
        <rdfs:label>hallucinations, mixed AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007401 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is human vocal communication using language and is disorganised.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Speech</obo:IAO_0000119>
        <obo:OAE_0001849>说话方式慌乱</obo:OAE_0001849>
        <obo:OAE_0004334>10076227</obo:OAE_0004334>
        <rdfs:label>disorganised speech AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007402 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004496"/>
        <obo:IAO_0000115>This is an AE which is a cortical development malformation that is commonly associated with refractory epilepsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31559780/</obo:IAO_0000119>
        <obo:OAE_0001849>室管膜下结节性异位</obo:OAE_0001849>
        <obo:OAE_0004334>10071150</obo:OAE_0004334>
        <rdfs:label>subependymal nodular heterotopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007403 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004496"/>
        <obo:IAO_0000115>This is an AE which is neurological disorders caused by clumps of gray matter (nodules of neurons) located in the wrong part of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gray_matter_heterotopia</obo:IAO_0000119>
        <obo:OAE_0001849>室旁结节性异位</obo:OAE_0001849>
        <obo:OAE_0004334>10066854</obo:OAE_0004334>
        <rdfs:label>periventricular nodular heterotopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007404 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which refers to an inflammation of the pituitary gland and is rare .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypophysitis</obo:IAO_0000119>
        <obo:OAE_0001849>下垂体炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062767</obo:OAE_0004334>
        <rdfs:label>hypophysitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007405 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is characterized by persistent antisocial behavior, impaired empathy and remorse, and bold, disinhibited, and egotistical traits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychopathy</obo:IAO_0000119>
        <obo:OAE_0001849>心理变态人格</obo:OAE_0001849>
        <obo:OAE_0004334>10037218</obo:OAE_0004334>
        <rdfs:label>psychopathic personality AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007406 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is damage to a person&apos;s mind as a result of one or more events that cause overwhelming amounts of stress that exceed the person&apos;s ability to cope or integrate the emotions involved, eventually leading to serious, long-term negative consequences.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychological_trauma</obo:IAO_0000119>
        <obo:OAE_0001849>心理创伤</obo:OAE_0001849>
        <obo:OAE_0004334>10071368</obo:OAE_0004334>
        <rdfs:label>psychological trauma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007407 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000482"/>
        <obo:IAO_0000115>This is an AE which is a neurological disorder whose key defining characteristic is a temporary but almost total disruption of short-term memory with a range of problems accessing older memories.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transient_global_amnesia</obo:IAO_0000119>
        <obo:OAE_0001849>暂时性全球健忘症</obo:OAE_0001849>
        <obo:OAE_0004334>10044380</obo:OAE_0004334>
        <rdfs:label>transient global amnesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007408 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002096"/>
        <obo:IAO_0000115>This is an AE which is the fear of confined spaces.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Claustrophobia</obo:IAO_0000119>
        <obo:OAE_0001849>幽闭恐怖症</obo:OAE_0001849>
        <obo:OAE_0004334>10009244</obo:OAE_0004334>
        <rdfs:label>claustrophobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007409 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002206"/>
        <obo:IAO_0000115>This is an AE which is a key component in all modern etiological models of insomnia disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30046255/</obo:IAO_0000119>
        <obo:OAE_0001849>反应过度</obo:OAE_0001849>
        <obo:OAE_0004334>10080831</obo:OAE_0004334>
        <rdfs:label>hyperarousal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007410 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which refers to the property of a vaccine of being able to produce common, &quot;expected&quot; adverse reactions, especially excessive immunological responses and associated signs and symptoms, including fever and sore arm at the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reactogenicity</obo:IAO_0000119>
        <obo:OAE_0001849>反应原性事件</obo:OAE_0001849>
        <obo:OAE_0004334>10065109</obo:OAE_0004334>
        <rdfs:label>reactogenicity event AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007411 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001889"/>
        <obo:IAO_0000115>This is an AE which is a fear of being on an airplane, or other flying vehicle, such as a helicopter, while in flight.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fear_of_flying</obo:IAO_0000119>
        <obo:OAE_0001849>飞行恐惧症</obo:OAE_0001849>
        <obo:OAE_0004334>10034914</obo:OAE_0004334>
        <rdfs:label>phobia of flying AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007412 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001889"/>
        <obo:IAO_0000115>This is an AE which is the specific phobia of isolation; a morbid fear of being egotistical, or a dread of being alone or isolated.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autophobia</obo:IAO_0000119>
        <obo:OAE_0001849>独处恐惧症</obo:OAE_0001849>
        <obo:OAE_0004334>10071070</obo:OAE_0004334>
        <rdfs:label>autophobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007413 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is the experience of the transitional state from wakefulness to sleep: the hypnagogic state of consciousness, during the onset of sleep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypnagogia</obo:IAO_0000119>
        <obo:OAE_0001849>入睡前幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10020927</obo:OAE_0004334>
        <rdfs:label>hypnagogic hallucination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007414 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a common disabling condition following brain damage to the right hemisphere.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27103056/</obo:IAO_0000119>
        <obo:OAE_0001849>半感觉性忽视</obo:OAE_0001849>
        <obo:OAE_0004334>10067022</obo:OAE_0004334>
        <rdfs:label>hemisensory neglect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007415 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a distortion of the senses, which can reveal how the human brain normally organizes and interprets sensory stimulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Illusion</obo:IAO_0000119>
        <obo:OAE_0001849>错觉</obo:OAE_0001849>
        <obo:OAE_0004334>10021403</obo:OAE_0004334>
        <rdfs:label>illusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007416 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which refers a memory is suddenly and unexpectedly revisited.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Flashback</obo:IAO_0000119>
        <obo:OAE_0001849>迷幻药效幻觉重现</obo:OAE_0001849>
        <obo:OAE_0004334>10016754</obo:OAE_0004334>
        <rdfs:label>flashback AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007417 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is a cognitive disorder of face perception in which the ability to recognize familiar faces, including one&apos;s own face (self-recognition), is impaired, while other aspects of visual processing (e.g., object discrimination) and intellectual functioning (e.g., decision-making) remain intact.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prosopagnosia</obo:IAO_0000119>
        <obo:OAE_0001849>面容失认症</obo:OAE_0001849>
        <obo:OAE_0004334>10073980</obo:OAE_0004334>
        <rdfs:label>prosopagnosia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007418 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is an alteration in the perception of the external world, causing sufferers to perceive it as unreal, distant, distorted or falsified.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Derealization</obo:IAO_0000119>
        <obo:OAE_0001849>现实感丧失</obo:OAE_0001849>
        <obo:OAE_0004334>10012422</obo:OAE_0004334>
        <rdfs:label>derealisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007419 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is an intrinsic feature of a living matter.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31756587/</obo:IAO_0000119>
        <obo:OAE_0001849>兴奋性</obo:OAE_0001849>
        <obo:OAE_0004334>10015622</obo:OAE_0004334>
        <rdfs:label>excitability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007420 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is a hypnopompic perception in the absence of an external stimulus that has the qualities of a real perception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hallucination</obo:IAO_0000119>
        <obo:OAE_0001849>醒前幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10020928</obo:OAE_0004334>
        <rdfs:label>hypnopompic hallucination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007421 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002491"/>
        <obo:IAO_0000115>This is an AE which is a fixed belief that is not amenable to change in light of conflicting evidence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Delusion</obo:IAO_0000119>
        <obo:OAE_0001849>妄想性知觉</obo:OAE_0001849>
        <obo:OAE_0004334>10012258</obo:OAE_0004334>
        <rdfs:label>delusional perception AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007422 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002429"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder classified as a Dissociative disorder and a Dissociative [conversion] disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fugue_state</obo:IAO_0000119>
        <obo:OAE_0001849>分离性神游症</obo:OAE_0001849>
        <obo:OAE_0004334>10013466</obo:OAE_0004334>
        <rdfs:label>dissociative fugue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007423 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000914"/>
        <obo:IAO_0000115>This is an AE which occurs due to a difference between actual and expected motion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Motion_sickness</obo:IAO_0000119>
        <obo:OAE_0001849>晕动病</obo:OAE_0001849>
        <obo:OAE_0004334>10027990</obo:OAE_0004334>
        <rdfs:label>motion sickness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007425 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the process of diverting the attention of an individual or group from a desired area of focus and thereby blocking or diminishing the reception of desired information.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Distraction</obo:IAO_0000119>
        <obo:OAE_0001849>注意力分散性</obo:OAE_0001849>
        <obo:OAE_0004334>10013486</obo:OAE_0004334>
        <rdfs:label>distractibility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007426 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002491"/>
        <obo:IAO_0000115>This is an AE which is a subtype of delusion that occur in patients suffering from a wide range of psychiatric diseases, including two-thirds of patients in manic state of bipolar disorder, half of those with schizophrenia, patients with the grandiose subtype of delusional disorder, and a substantial portion of those with substance abuse disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Grandiose_delusions</obo:IAO_0000119>
        <obo:OAE_0001849>夸大妄想</obo:OAE_0001849>
        <obo:OAE_0004334>10012241</obo:OAE_0004334>
        <rdfs:label>delusion of grandeur AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007427 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001889"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder,specifically an anxiety disorder characterized by symptoms of anxiety in situations where the person perceives their environment to be unsafe with no easy way to escape.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Agoraphobia</obo:IAO_0000119>
        <obo:OAE_0001849>惧旷症</obo:OAE_0001849>
        <obo:OAE_0004334>10001502</obo:OAE_0004334>
        <rdfs:label>agoraphobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007428 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is an emotional and occasionally psychological state experienced when an individual is left without anything in particular to do, is not interested in their surroundings, or feels that a day or period is dull or tedious.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Boredom</obo:IAO_0000119>
        <obo:OAE_0001849>倦怠</obo:OAE_0001849>
        <obo:OAE_0004334>10024642</obo:OAE_0004334>
        <rdfs:label>listless AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007429 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the focused attention on the symptoms of one&apos;s distress, and on its possible causes and consequences, as opposed to its solutions, according to the Response Styles Theory proposed by Nolen-Hoeksema (1998).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rumination_(psychology)</obo:IAO_0000119>
        <obo:OAE_0001849>强迫性的沉思</obo:OAE_0001849>
        <obo:OAE_0004334>10056264</obo:OAE_0004334>
        <rdfs:label>obsessive rumination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007430 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a loose connective tissue composed mostly of adipocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adipose_tissue</obo:IAO_0000119>
        <obo:OAE_0001849>身体脂肪症</obo:OAE_0001849>
        <obo:OAE_0004334>10055164</obo:OAE_0004334>
        <rdfs:label>body fat disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007431 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is sudden periods of intense fear and discomfort that may include palpitations, sweating, chest pain, shaking, shortness of breath, numbness, or a feeling of impending doom or of losing control.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panic_attack</obo:IAO_0000119>
        <obo:OAE_0001849>惊恐发作</obo:OAE_0001849>
        <obo:OAE_0004334>10033664</obo:OAE_0004334>
        <rdfs:label>panic attack AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007432 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000393"/>
        <obo:IAO_0000115>This is an AE which is the dropping of tears (or welling of tears in the eyes) in response to an emotional state, or pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Crying</obo:IAO_0000119>
        <obo:OAE_0001849>哭泣</obo:OAE_0001849>
        <obo:OAE_0004334>10011469</obo:OAE_0004334>
        <rdfs:label>crying AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007433 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001889"/>
        <obo:IAO_0000115>This is an AE which refers a psychological fear of water.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hydrophobia</obo:IAO_0000119>
        <obo:OAE_0001849>狂犬病</obo:OAE_0001849>
        <obo:OAE_0004334>10053317</obo:OAE_0004334>
        <rdfs:label>hydrophobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007434 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the unsolicited repetition of vocalizations made by another person (when repeated by the same person, it is called palilalia).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Echolalia</obo:IAO_0000119>
        <obo:OAE_0001849>模仿言语</obo:OAE_0001849>
        <obo:OAE_0004334>10014127</obo:OAE_0004334>
        <rdfs:label>echolalia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007435 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004357"/>
        <obo:IAO_0000115>This is an AE which is a state of low mood and aversion to activity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Depression_(mood)</obo:IAO_0000119>
        <obo:OAE_0001849>沮丧</obo:OAE_0001849>
        <obo:OAE_0004334>10084257</obo:OAE_0004334>
        <rdfs:label>discouragement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007436 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is a state of tiredness, weariness, fatigue, or lack of energy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lethargy</obo:IAO_0000119>
        <obo:OAE_0001849>嗜睡</obo:OAE_0001849>
        <obo:OAE_0004334>10024264</obo:OAE_0004334>
        <rdfs:label>lethargy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007437 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000482"/>
        <obo:IAO_0000115>This is an AE which is a loss of the ability to create new memories after the event that caused amnesia, leading to a partial or complete inability to recall the recent past, while long-term memories from before the event remain intact.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anterograde_amnesia</obo:IAO_0000119>
        <obo:OAE_0001849>顺行性遗忘</obo:OAE_0001849>
        <obo:OAE_0004334>10002711</obo:OAE_0004334>
        <rdfs:label>anterograde amnesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007438 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>This is an AE which is an anxiety disorder in which a person who is otherwise capable of speech becomes unable to speak when exposed to specific situations, specific places, or to specific people, one or multiple of which serving as triggers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Selective_mutism</obo:IAO_0000119>
        <obo:OAE_0001849>选择性缄默</obo:OAE_0001849>
        <obo:OAE_0004334>10039917</obo:OAE_0004334>
        <rdfs:label>selective mutism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007439 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a sleep disorder causing feelings of panic or dread and typically occurring during the first hours of stage 3 4 non-rapid eye movement (NREM) sleep and lasting for 1 to 10 minutes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Night_terror</obo:IAO_0000119>
        <obo:OAE_0001849>夜惊</obo:OAE_0001849>
        <obo:OAE_0004334>10041010</obo:OAE_0004334>
        <rdfs:label>sleep terror AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007440 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a non-associative learning process in which repeated administration of a stimulus results in the progressive amplification of a response.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sensitization</obo:IAO_0000119>
        <obo:OAE_0001849>致敏</obo:OAE_0001849>
        <obo:OAE_0004334>10070834</obo:OAE_0004334>
        <rdfs:label>sensitisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007441 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001889"/>
        <obo:IAO_0000115>This is an AE which is a common fear or phobia among children and, to a varying degree, adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fear_of_the_dark</obo:IAO_0000119>
        <obo:OAE_0001849>黑夜恐怖症</obo:OAE_0001849>
        <obo:OAE_0004334>10057946</obo:OAE_0004334>
        <rdfs:label>noctiphobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007442 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000914"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>情感贫乏</obo:OAE_0001849>
        <obo:OAE_0004334>10014557</obo:OAE_0004334>
        <rdfs:label>emotional poverty AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007443 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002172"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>梦样状态</obo:OAE_0001849>
        <obo:OAE_0004334>10013634</obo:OAE_0004334>
        <rdfs:label>dreamy state AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007444 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>感觉忽冷忽热</obo:OAE_0001849>
        <obo:OAE_0004334>10016335</obo:OAE_0004334>
        <rdfs:label>feeling hot and cold AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007445 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>感觉体温变化</obo:OAE_0001849>
        <obo:OAE_0004334>10061458</obo:OAE_0004334>
        <rdfs:label>feeling of body temperature change AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007446 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>感觉醉</obo:OAE_0001849>
        <obo:OAE_0004334>10016330</obo:OAE_0004334>
        <rdfs:label>feeling drunk AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007447 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>室管膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014965</obo:OAE_0004334>
        <rdfs:label>ependymitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007449 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000927"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>中性粒细胞中毒性颗粒</obo:OAE_0001849>
        <obo:OAE_0004334>10029378</obo:OAE_0004334>
        <rdfs:label>neutrophil toxic granulation present AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007450 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004223"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>感觉运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10062162</obo:OAE_0004334>
        <rdfs:label>sensorimotor disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007451 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is commonly described as a benign neoplasm emerging from the cells that comprise the adrenal cortex.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adrenocortical_adenoma</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺腺瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10001323</obo:OAE_0004334>
        <rdfs:label>adrenal adenoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007452 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the adrenal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10001324</obo:OAE_0004334>
        <rdfs:label>adrenal atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007453 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a form of adrenal cortex cell injury which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺皮质坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10001337</obo:OAE_0004334>
        <rdfs:label>adrenal cortex necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007454 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is conditions that interfere with the normal functioning of the adrenal glands.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adrenal_gland_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10001347</obo:OAE_0004334>
        <rdfs:label>adrenal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007455 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which describes an acute blood loss from a ruptured blood vessel connecting to adrenal glands above kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adrenal_haemorrhage</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺出血</obo:OAE_0001849>
        <obo:OAE_0004334>10001361</obo:OAE_0004334>
        <rdfs:label>adrenal hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007456 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is any benign or malignant neoplasms of the adrenal gland, several of which are notable for their tendency to overproduce endocrine hormones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adrenal_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10053235</obo:OAE_0004334>
        <rdfs:label>adrenal mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007457 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is disorders of the endocrine system such as adrenal medulla.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endocrine_disease</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺髓质机能亢进</obo:OAE_0001849>
        <obo:OAE_0004334>10001371</obo:OAE_0004334>
        <rdfs:label>adrenal medulla hyperfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007458 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000265"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of adrenal  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061588</obo:OAE_0004334>
        <rdfs:label>adrenal neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007459 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001072"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the adrenal glands do not produce adequate amounts of steroid hormones, primarily cortisol; but may also include impaired production of aldosterone (a mineralocorticoid), which regulates sodium conservation, potassium secretion, and water retention.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adrenal_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺抑制</obo:OAE_0001849>
        <obo:OAE_0004334>10001382</obo:OAE_0004334>
        <rdfs:label>adrenal suppression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007460 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003255"/>
        <obo:IAO_0000115>This is an AE which is a critical care emergency characterized by hemodynamic instability, lethargy, and cardiovascular collapse.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17456730/</obo:IAO_0000119>
        <obo:OAE_0001849>急性肾上腺皮质机能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10001389</obo:OAE_0004334>
        <rdfs:label>acute adrenocortical insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007461 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003255"/>
        <obo:IAO_0000115>This is an AE which is a rare long-term endocrine disorder characterized by inadequate production of the steroid hormones cortisol and aldosterone by the two outer layers of the cells of the adrenal glands (adrenal cortex), causing adrenal insufficiency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Addison%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>慢性肾上腺皮质机能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10001390</obo:OAE_0004334>
        <rdfs:label>chronic adrenocortical insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007462 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a group of autosomal recessive disorders characterized by impaired cortisol synthesis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_adrenal_hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>肾上腺综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10061630</obo:OAE_0004334>
        <rdfs:label>adrenogenital syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007463 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000938"/>
        <obo:IAO_0000115>This is an AE which indicates insufficient weight gain or absence of appropriate physical growth in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Failure_to_thrive</obo:IAO_0000119>
        <obo:OAE_0001849>成人发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10077257</obo:OAE_0004334>
        <rdfs:label>adult failure to thrive AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007464 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004236"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection that results in the death of parts of the body&apos;s soft tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrotizing_fasciitis</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿坏死性筋膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10028885</obo:OAE_0004334>
        <rdfs:label>necrotising fasciitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007465 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001590"/>
        <obo:IAO_0000115>This is an AE which is an abnormal amount of lipids (e.g. triglycerides, cholesterol and/or fat phospholipids) in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dyslipidemia</obo:IAO_0000119>
        <obo:OAE_0001849>脂代谢紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10058108</obo:OAE_0004334>
        <rdfs:label>dyslipidaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007466 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002402"/>
        <obo:IAO_0000115>This is an AE which is believed to be an autosomal dominant condition in which multiple lipomas are present on the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lipomatosis</obo:IAO_0000119>
        <obo:OAE_0001849>脂肪过多症</obo:OAE_0001849>
        <obo:OAE_0004334>10061228</obo:OAE_0004334>
        <rdfs:label>lipomatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007467 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor made of fat tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lipoma</obo:IAO_0000119>
        <obo:OAE_0001849>脂肪瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10024612</obo:OAE_0004334>
        <rdfs:label>lipoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007468 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000330"/>
        <obo:IAO_0000115>This is an AE which is a condition that is almost exclusively found in women and results in enlargement of both legs due to deposits of fat under the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lipedema</obo:IAO_0000119>
        <obo:OAE_0001849>脂肪水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10063955</obo:OAE_0004334>
        <rdfs:label>lipedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007469 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases whose hallmark is inflammation of subcutaneous adipose tissue (the fatty layer under the skin – panniculus adiposus).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panniculitis</obo:IAO_0000119>
        <obo:OAE_0001849>脂膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033675</obo:OAE_0004334>
        <rdfs:label>panniculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007470 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a panniculitis on the back of the calves.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panniculitis#Lobular</obo:IAO_0000119>
        <obo:OAE_0001849>脂膜炎小叶</obo:OAE_0001849>
        <obo:OAE_0004334>10033678</obo:OAE_0004334>
        <rdfs:label>panniculitis lobular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007471 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a non-cancerous (benign) skin tumour that originates from cells in the outer layer of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Seborrheic_keratosis</obo:IAO_0000119>
        <obo:OAE_0001849>脂溢性角化病</obo:OAE_0001849>
        <obo:OAE_0004334>10039796</obo:OAE_0004334>
        <rdfs:label>seborrhoeic keratosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007472 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is a long-term skin disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Seborrhoeic_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>脂溢性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10039793</obo:OAE_0004334>
        <rdfs:label>seborrhoeic dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007473 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001590"/>
        <obo:IAO_0000115>This is an AE which is  illnesses where trouble occurs in breaking down or synthesizing fats (or fat-like substances).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lipid_metabolism#Lipid_metabolism_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>脂质代谢障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061227</obo:OAE_0004334>
        <rdfs:label>lipid metabolism disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007474 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001590"/>
        <obo:IAO_0000115>This is an AE which is the term describing the localized loss of fat tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lipoatrophy</obo:IAO_0000119>
        <obo:OAE_0001849>脂质脂肪萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10024604</obo:OAE_0004334>
        <rdfs:label>lipoatrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007475 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the development of symptoms when standing upright that are relieved when reclining.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Orthostatic_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>直立性不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10063927</obo:OAE_0004334>
        <rdfs:label>orthostatic intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007476 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000853"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the mitochondria of a body&apos;s cells become damaged or decline significantly in number.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mitochondrial_toxicity</obo:IAO_0000119>
        <obo:OAE_0001849>线粒体毒性</obo:OAE_0001849>
        <obo:OAE_0004334>10053961</obo:OAE_0004334>
        <rdfs:label>mitochondrial toxicity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007477 -->


