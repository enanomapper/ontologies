        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001887"/>
        <obo:IAO_0000115>This is an AE which is a spontaneous orgasm during sleep that includes ejaculation for a male, or vaginal wetness or an orgasm (or both) for a female.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
