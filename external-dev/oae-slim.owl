        <obo:IAO_0000118>visual impairment AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Visual_impairment</obo:IAO_0000119>
        <obo:OAE_0004334>10047555</obo:OAE_0004334>
        <obo:OAE_0004334>10047571</obo:OAE_0004334>
        <rdfs:label>visual field defect AE</rdfs:label>
    </owl:Class>
    


