    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000810"/>
        <obo:IAO_0000115>This is an AE which is any inflammation with infective of the biliary tree.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholangitis_(disambiguation)</obo:IAO_0000119>
        <obo:OAE_0001849>感染性胆管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10075445</obo:OAE_0004334>
        <rdfs:label>cholangitis infective AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005809 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000810"/>
        <obo:IAO_0000115>This is an AE which is defined as a condition with progressive stenosis and destruction of the bile ducts due to diffuse inflammation and fibrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30205418/</obo:IAO_0000119>
        <obo:OAE_0001849>硬化性胆管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008609</obo:OAE_0004334>
        <rdfs:label>cholangitis sclerosing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005810 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002400"/>
        <obo:IAO_0000115>This is an AE which is defined as inflammation of the gallbladder and is usually caused by obstruction of the cystic duct.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24679431/</obo:IAO_0000119>
        <obo:OAE_0001849>急性胆囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008614</obo:OAE_0004334>
        <rdfs:label>cholecystitis acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005811 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002400"/>
        <obo:IAO_0000115>This is an AE which occurs after repeated episodes of acute cholecystitis and is almost always due to gallstones and may be asymptomatic, may present as a more severe case of acute cholecystitis, or may lead to a number of complications such as gangrene, perforation, or fistula formation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholecystitis#Chronic_cholecystitis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性胆囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008617</obo:OAE_0004334>
        <rdfs:label>cholecystitis chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005812 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002400"/>
        <obo:IAO_0000115>This is an AE which is inflammation with infective of the gallbladder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholecystitis</obo:IAO_0000119>
        <obo:OAE_0001849>感染性胆囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062631</obo:OAE_0004334>
        <rdfs:label>cholecystitis infective AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005813 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <obo:IAO_0000115>This is an AE which encompass a wide breadth of diseases that vary in severity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33478678/</obo:IAO_0000119>
        <obo:OAE_0001849>胆囊疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10017626</obo:OAE_0004334>
        <rdfs:label>gallbladder disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005814 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005814">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <obo:IAO_0000115>This is an AE which is a small hollow organ where bile is stored and concentrated before it is released into the small intestine and becomes hypofunction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gallbladder</obo:IAO_0000119>
        <obo:OAE_0001849>胆囊功能不良</obo:OAE_0001849>
        <obo:OAE_0004334>10080936</obo:OAE_0004334>
        <rdfs:label>gallbladder hypofunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005815 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <obo:IAO_0000115>This is an AE which leads to cicatricial and adhesive processes in its wall and surrounding tissues that significantly complicates cholecystectomy and increases the risk of bile ducts trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29460879/</obo:IAO_0000119>
        <obo:OAE_0001849>胆囊无功能</obo:OAE_0001849>
        <obo:OAE_0004334>10080936</obo:OAE_0004334>
        <rdfs:label>gallbladder non-functioning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005816 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the gallbladder tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>胆囊水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10017637</obo:OAE_0004334>
        <rdfs:label>gallbladder edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005817 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <obo:IAO_0000115>This is an AE which is extremely rare, majority of ruptures occur secondary to traumatic injuries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30611267/</obo:IAO_0000119>
        <obo:OAE_0001849>胆囊破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10081151</obo:OAE_0004334>
        <rdfs:label>gallbladder rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005818 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <obo:IAO_0000115>This is an AE which is defined by acute distension of the gallbladder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17402689/</obo:IAO_0000119>
        <obo:OAE_0001849>胆囊积水</obo:OAE_0001849>
        <obo:OAE_0004334>10056972</obo:OAE_0004334>
        <rdfs:label>hydrocholecystis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005819 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003386"/>
        <obo:IAO_0000115>This is an AE which is a cause of several gut-related problems, the main one being chronic diarrhea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bile_acid_malabsorption</obo:IAO_0000119>
        <obo:OAE_0001849>胆汁酸吸收不良</obo:OAE_0001849>
        <obo:OAE_0004334>10069703</obo:OAE_0004334>
        <rdfs:label>bile acid malabsorption AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005820 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease of the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_biliary_cholangitis</obo:IAO_0000119>
        <obo:OAE_0001849>原发性胆汁性肝硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10004661</obo:OAE_0004334>
        <rdfs:label>biliary cirrhosis primary AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005821 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000708"/>
        <obo:IAO_0000115>This is an AE which is rare dilatations of different parts of a biliary tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23002354/</obo:IAO_0000119>
        <obo:OAE_0001849>胆道囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10052384</obo:OAE_0004334>
        <rdfs:label>biliary cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005822 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of neoplasm tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>胆道肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10004668</obo:OAE_0004334>
        <rdfs:label>biliary neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005823 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is any of a number of long tube-like structures that carry bile, and is present in most vertebrates.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bile_duct#Clinical_significance</obo:IAO_0000119>
        <obo:OAE_0001849>胆道梗阻</obo:OAE_0001849>
        <obo:OAE_0004334>10084247</obo:OAE_0004334>
        <rdfs:label>biliary obstruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005824 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which refers to the liver, gall bladder and bile ducts, and how they work together to make, store and secrete bile and its function gets disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Biliary_tract</obo:IAO_0000119>
        <obo:OAE_0001849>胆道疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061008</obo:OAE_0004334>
        <rdfs:label>biliary tract disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005825 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000811"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which cholestasis occurs during pregnancy and typically presents with itching and can lead to complications for both mother and baby.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intrahepatic_cholestasis_of_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠胆汁淤积</obo:OAE_0001849>
        <obo:OAE_0004334>10049055</obo:OAE_0004334>
        <rdfs:label>cholestasis of pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005826 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is a destructive and expanding growth consisting of keratinizing squamous epithelium in the middle ear and/or mastoid process.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholesteatoma</obo:IAO_0000119>
        <obo:OAE_0001849>胆脂瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10008642</obo:OAE_0004334>
        <rdfs:label>cholesteatoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005827 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005827">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an over-stimulation at a neuromuscular junction due to an excess of acetylcholine (ACh), as a result of the inactivity of the AChE enzyme, which normally breaks down acetylcholine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholinergic_crisis</obo:IAO_0000119>
        <obo:OAE_0001849>胆碱能综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10008674</obo:OAE_0004334>
        <rdfs:label>cholinergic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005828 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000811"/>
        <obo:IAO_0000115>This is an AE which defines persisting conjugated hyperbilirubinemia in the newborn with conjugated bilirubin levels exceeding 15% (5.0 mg/dL) of total bilirubin level.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_cholestasis</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿胆汁淤积</obo:OAE_0001849>
        <obo:OAE_0004334>10056528</obo:OAE_0004334>
        <rdfs:label>neonatal cholestasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005829 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000811"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease of the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_biliary_cholangitis</obo:IAO_0000119>
        <obo:OAE_0001849>原发性胆汁性胆管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10080429</obo:OAE_0004334>
        <rdfs:label>primary biliary cholangitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005830 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>This is an AE which is a hollow muscular organ in humans and other vertebrates that stores urine from the kidneys before disposal by urination and the organ is haemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_bladder</obo:IAO_0000119>
        <obo:OAE_0001849>膀胱出血</obo:OAE_0001849>
        <obo:OAE_0004334>10046528</obo:OAE_0004334>
        <rdfs:label>urinary bladder hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005831 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>This is an AE which may occur if the bladder is overfilled and not emptied.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_bladder_disease</obo:IAO_0000119>
        <obo:OAE_0001849>膀胱破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10046530</obo:OAE_0004334>
        <rdfs:label>urinary bladder rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005832 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is microscopic cylindrical structures produced by the kidney and present in the urine in certain disease states.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_cast</obo:IAO_0000119>
        <obo:OAE_0001849>尿沉渣</obo:OAE_0001849>
        <obo:OAE_0004334>10080828</obo:OAE_0004334>
        <rdfs:label>urinary sediment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005833 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which includes urinary incontinence, urgency and nocturia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28937771/</obo:IAO_0000119>
        <obo:OAE_0001849>排尿困难</obo:OAE_0001849>
        <obo:OAE_0004334>10069648</obo:OAE_0004334>
        <rdfs:label>urinary straining AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005834 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000498"/>
        <obo:IAO_0000115>This is an AE which is an infection that affects part of the urinary tract and children the only symptom of a urinary tract infection (UTI) may be a fever .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿尿路感染</obo:OAE_0001849>
        <obo:OAE_0004334>10046573</obo:OAE_0004334>
        <rdfs:label>urinary tract infection neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005835 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of urinary tract tissues to harmful stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>泌尿道炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10064921</obo:OAE_0004334>
        <rdfs:label>urinary tract inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005836 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004473"/>
        <obo:IAO_0000115>This is an AE which is a condition in which urine flows retrograde, or backward, from the bladder into one or both ureters and then to the renal calyx or kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
