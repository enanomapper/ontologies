    <!-- http://purl.obolibrary.org/obo/OAE_0003020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002582"/>
        <obo:IAO_0000115>a hypokalemia AE that requires &lt;LLN - 3.0 mmol/L</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hypokalemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12328</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003021 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002582"/>
        <obo:IAO_0000115>a hypokalemia AE that requires &lt;LLN - 3.0 mmol/L; symptomatic; intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 hypokalemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12329</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003022 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002582"/>
        <obo:IAO_0000115>a hypokalemia AE that requires &lt;3.0 - 2.5 mmol/L; hospitalization indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 hypokalemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12330</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002582"/>
        <obo:IAO_0000115>a hypokalemia AE that requires &lt;2.5 mmol/L; life-threatening consequences</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 hypokalemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12331</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003024 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002120"/>
        <obo:IAO_0000115>a hyponatremia AE that requires &lt;LLN - 130 mmol/L</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hyponatremia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12340</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003025 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002120"/>
        <obo:IAO_0000115>a hyponatremia AE that requires &lt;130 - 120 mmol/L</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 hyponatremia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12341</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003026 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002120"/>
        <obo:IAO_0000115>a hyponatremia AE that requires &lt;120 mmol/L; life-threatening consequences</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 hyponatremia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12342</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003027 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002654"/>
        <obo:IAO_0000115>an obesity AE that requires BMI 25 - 29.9 kg/m2</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 obesity AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12362</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003028 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002654"/>
        <obo:IAO_0000115>an obesity AE that requires BMI 30 - 39.9 kg/m2</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 obesity AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12363</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003029 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002654"/>
        <obo:IAO_0000115>an obesity AE that requires BMI &gt;=40 kg/m2</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 obesity AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12364</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000021"/>
        <obo:IAO_0000115>a flushing AE that has symptomatic, associated with hypotension and/or tachycardia; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 flushing AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13774</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>a hematoma AE that requires minimally invasive evacuation or aspiration</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 hematoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13777</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003032 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>a hematoma AE that requires transfusion, radiologic, endoscopic, or elective operative intervention</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 hematoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13778</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003033 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>an hypertension AE that has prehypertension (systolic BP 120 - 139 mm Hg or diastolic BP 80 - 89 mm Hg)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hypertension AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13786</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003034 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>an hypertension AE that for Adult: has stage 1 hypertension (systolic BP 140 - 159 mm Hg or diastolic BP 90 - 99 mm Hg); medical intervention indicated; recurrent or persistent (&gt;=24 hrs); symptomatic increase by &gt;20 mm Hg (diastolic) or to &gt;140/90 mm Hg if previously WNL; monotherapy indicated; for Pediatric: recurrent or persistent (&gt;=24 hrs) BP &gt;ULN; monotherapy indicated.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 hypertension AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13787</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003035 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>an hypertension AE that for Adult has Stage 2 hypertension (systolic BP &gt;=160 mm Hg or diastolic BP &gt;=100 mm Hg); medical intervention indicated; more than one drug or more intensive therapy than previously used indicated; for Pediatric: Same as adult.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 hypertension AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13788</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003036 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>an hypertension AE that for Adult has life-threatening consequences (e.g., malignant hypertension, transient or permanent neurologic deficit, hypertensive crisis); urgent intervention indicated; for Pediatric: Same as adult</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 hypertension AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13789</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003037 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001285"/>
        <obo:IAO_0000115>a peripheral ischaemia AE that has brief (&lt;24 hrs) episode of ischemia managed non-surgically and without permanent deficit</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 peripheral ischemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13811</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003038 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001285"/>
        <obo:IAO_0000115>a peripheral ischaemia AE that has a recurring or prolonged (&gt;=24 hrs) and/or invasive intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 peripheral ischemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13812</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003039 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>a vasculitis AE that shows severe symptoms, medical intervention indicated (e.g., steroids)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 vasculitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13840</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>a vasculitis AE that shows threatening; evidence of peripheral or visceral ischemia; urgent intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 vasculitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13841</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003041 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>an alopecia AE that has hair loss of &lt;50% of normal for that individual that is not obvious from a distance but only on close inspection; a different hair style may be required to cover the hair loss but it does not require a wig or hair piece to camouflage</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 alopecia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13612</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003042 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>an alopecia AE that has hair loss of &gt;=50% normal for that individual that is readily apparent to others; a wig or hair piece is necessary if the patient desires to completely camouflage the hair loss; associated with psychosocial impact</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 alopecia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13613</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003043 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000894"/>
        <obo:IAO_0000115>a dry skin AE that is coverying &lt;10% BSA and no associated erythema or pruritus</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 dry skin AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13624</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003044 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000894"/>
        <obo:IAO_0000115>a dry skin AE that is coverying 10 - 30% BSA and associated with erythema or pruritus; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 dry skin AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13625</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003045 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000894"/>
        <obo:IAO_0000115>a dry skin AE that is coverying &gt;30% BSA and associated with pruritus; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 dry skin AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13626</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003046 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000449"/>
        <obo:IAO_0000115>an erythema multiforme AE that has target  lesions covering &lt;10% BSA and not associated with skin tenderness</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 erythema multiforme AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13628</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003047 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000449"/>
        <obo:IAO_0000115>an erythema multiforme AE that has target lesions covering 10 - 30% BSA and associated with skin tenderness</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 erythema multiforme AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13629</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003048 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000449"/>
        <obo:IAO_0000115>an erythema multiforme AE that has target lesions covering &gt;30% BSA and associated with oral or genital erosions</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 erythema multiforme AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13630</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003049 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000449"/>
        <obo:IAO_0000115>an erythema multiforme AE that has target lesions covering &gt;30% BSA; associated with fluid or electrolyte abnormalities; ICU care or burn unit indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 erythema multiforme AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13631</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003050 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001045"/>
        <obo:IAO_0000115>a hyperhidros AE that shows limited to one site (palms, soles, or axillae); self care interventions</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hyperhidrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13646</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003051 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001045"/>
        <obo:IAO_0000115>a hyperhidros AE that has Involving &gt;1 site; patient seeks medical intervention; associated with psychosocial impact</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 hyperhidrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13647</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003052 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001045"/>
        <obo:IAO_0000115>a hyperhidros AE that has Generalized involving sites other than palms, soles, or axillae; associated with electrolyte/hemodynamic imbalance</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 hyperhidrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13648</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003053 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001271"/>
        <obo:IAO_0000115>a palmar-plantar erythrodysesthesia syndrome AE that has minimal skin changes or dermatitis (e.g., erythema, edema, or hyperkeratosis) without pain</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 palmar-plantar erythrodysesthesia syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13673</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003054 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001271"/>
        <obo:IAO_0000115>a palmar-plantar erythrodysesthesia syndrome AE that has skin changes (e.g., peeling, blisters, bleeding, edema, or hyperkeratosis) with pain; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 palmar-plantar erythrodysesthesia syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13674</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003055 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001271"/>
        <obo:IAO_0000115>a palmar-plantar erythrodysesthesia syndrome AE that has severe skin changes (e.g., peeling, blisters, bleeding, edema, or hyperkeratosis) with pain; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 palmar-plantar erythrodysesthesia syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13675</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003056 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000681"/>
        <obo:IAO_0000115>a periorbital edema AE that has soft or non-pitting</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 periorbital edema AE</rdfs:label>
