    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001977"/>
        <obo:IAO_0000115>This is an AE which is a transient hyperthyroidism caused by inflammation associated with Hashimoto&apos;s thyroiditis disturbing the thyroid follicles, resulting in excess release of thyroid hormone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
