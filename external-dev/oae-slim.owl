    <!-- http://purl.obolibrary.org/obo/OAE_0005694 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is a break or tear in the skin of the anal canal.</obo:IAO_0000115>
