        <obo:OAE_0004334>10016563</obo:OAE_0004334>
        <rdfs:label>fever of unknown origin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001841 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001841">
