        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>Distant heart sounds AE is a cardiac disorder AE that shows distant heart sounds.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>心音遥远</obo:OAE_0001849>
        <rdfs:label>distant heart sounds AE</rdfs:label>
    </owl:Class>
    


