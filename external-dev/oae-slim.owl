    <!-- http://purl.obolibrary.org/obo/OAE_0000400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>a sensory capability AE that has an outcome of loss of consciousness, fainting</obo:IAO_0000115>
        <obo:IAO_0000117>YH, SS, MW</obo:IAO_0000117>
        <obo:IAO_0000118>Syncope is the medical term for fainting, a sudden, usually temporary, loss of consciousness.</obo:IAO_0000118>
        <obo:IAO_0000118>fainting</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Syncope_%28medicine%29</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Unconsciousness</obo:IAO_0000119>
        <obo:OAE_0004334>10024855</obo:OAE_0004334>
        <obo:OAE_0004334>10042772</obo:OAE_0004334>
        <rdfs:label>syncope AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12832</rdfs:seeAlso>
        <rdfs:seeAlso>HPO: HP_0001279</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35053</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0039070</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000401 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000401">
