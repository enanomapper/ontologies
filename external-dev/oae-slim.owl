        <obo:IAO_0000115>a hepatic failure AE that has asterixis; mild encephalopathy; limiting self care activities of daily living</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 hepatic failure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11212</rdfs:seeAlso>
    </owl:Class>
    


