        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders that destroy blood vessels by inflammation with haemorrhagic .</obo:IAO_0000115>
