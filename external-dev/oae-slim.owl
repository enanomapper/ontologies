    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005965 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002602"/>
        <obo:IAO_0000115>This is an AE which defines by the presence of normal or near-normal otoacoustic emissions (OAEs) but the absence of normal middle ear reflexes and severely abnormal or completely absent auditory brainstem response (ABRs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Auditory_neuropathy_spectrum_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>听觉神经病谱系障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10072198</obo:OAE_0004334>
        <rdfs:label>auditory neuropathy spectrum disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005966 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a mastoid collection of pus that has built up within the tissue of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
