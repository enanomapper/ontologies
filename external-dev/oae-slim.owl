    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008974 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a disease resulting from a group A streptococcus (group A strep) infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scarlet_fever</obo:IAO_0000119>
        <obo:OAE_0001849>猩红热皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10037890</obo:OAE_0004334>
        <rdfs:label>rash scarlatiniform AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008975 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008975">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the vaccination site  skin, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10069477</obo:OAE_0004334>
        <rdfs:label>vaccination site dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008976 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which is an acute, often fatal, thrombotic disorder which manifests as blood spots, bruising and discolouration of the skin resulting from coagulation in small blood vessels within the skin and rapidly leads to skin necrosis and disseminated intravascular coagulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Purpura_fulminans</obo:IAO_0000119>
        <obo:OAE_0001849>暴发性紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10037556</obo:OAE_0004334>
        <rdfs:label>purpura fulminans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008977 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which is a neonatal condition of red or purple discolored spots on the skin that do not blanch on applying pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Purpura</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10037557</obo:OAE_0004334>
        <rdfs:label>purpura neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008978 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008978">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which is a characterized of henoch-Schonlein purpura (HSP).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30428889/</obo:IAO_0000119>
        <obo:OAE_0001849>非血小板减少性紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10057739</obo:OAE_0004334>
        <rdfs:label>purpura non-thrombocytopenic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008979 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008979">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which commonly refers to flaking (or scaling) of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pityriasis</obo:IAO_0000119>
        <obo:OAE_0001849>蛇皮癣</obo:OAE_0001849>
        <obo:OAE_0004334>10035110</obo:OAE_0004334>
        <rdfs:label>pityriasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008980 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008980">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a disease of the immune system and  is the more severe version of pityriasis lichenoides chronica.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pityriasis_lichenoides_et_varioliformis_acuta</obo:IAO_0000119>
        <obo:OAE_0001849>地衣糠秕孢子虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10048895</obo:OAE_0004334>
        <rdfs:label>pityriasis lichenoides et varioliformis acuta AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008981 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a type of skin rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pityriasis_rosea</obo:IAO_0000119>
        <obo:OAE_0001849>玫瑰糠疹</obo:OAE_0001849>
        <obo:OAE_0004334>10035114</obo:OAE_0004334>
        <rdfs:label>pityriasis rosea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008982 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which refers to a group of chronic disorders characterized by reddish orange, scaling plaques and keratotic follicular papules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pityriasis_rubra_pilaris</obo:IAO_0000119>
        <obo:OAE_0001849>毛发红糠疹</obo:OAE_0001849>
        <obo:OAE_0004334>10035116</obo:OAE_0004334>
        <rdfs:label>pityriasis rubra pilaris AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008983 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a type of melanocytic tumor that contains nevus cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melanocytic_nevus</obo:IAO_0000119>
        <obo:OAE_0001849>黑素细胞痣</obo:OAE_0001849>
        <obo:OAE_0004334>10027145</obo:OAE_0004334>
        <rdfs:label>melanocytic naevus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008984 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001397"/>
        <obo:IAO_0000115>This is an AE which is a genus of two species of white rot poroid fungi in the family Polyporaceae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melanoderma</obo:IAO_0000119>
        <obo:OAE_0001849>黑皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10027146</obo:OAE_0004334>
        <rdfs:label>melanoderma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008985 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001397"/>
        <obo:IAO_0000115>This is an AE which correspond to epidermal hypermelanocytosis (an increased number of melanocytes) or epidermal hypermelanosis (an increase in the quantity of melanin in the epidermis with no modification of the number of melanocytes).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23260521/</obo:IAO_0000119>
        <obo:OAE_0001849>白斑病</obo:OAE_0001849>
        <obo:OAE_0004334>10027147</obo:OAE_0004334>
        <rdfs:label>melanodermia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008986 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001397"/>
        <obo:IAO_0000115>This is an AE which is a form of hyperpigmentation associated with increased melanin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melanosis</obo:IAO_0000119>
        <obo:OAE_0001849>黑变病</obo:OAE_0001849>
        <obo:OAE_0004334>10027157</obo:OAE_0004334>
        <rdfs:label>melanosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008987 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a skin condition caused by long-term exposure to heat (infrared radiation).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_ab_igne</obo:IAO_0000119>
        <obo:OAE_0001849>火激红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10015152</obo:OAE_0004334>
        <rdfs:label>erythema ab igne AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008988 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a descriptive term for a class of skin lesion presenting redness (erythema) in a ring form (anulare) that spreads from a center (centrifugum).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_annulare_centrifugum</obo:IAO_0000119>
        <obo:OAE_0001849>环形红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10015153</obo:OAE_0004334>
        <rdfs:label>erythema annulare AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008989 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a form of vasculitis  and has been described as a paraneoplastic syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_elevatum_diutinum</obo:IAO_0000119>
        <obo:OAE_0001849>持久性隆起性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10056968</obo:OAE_0004334>
        <rdfs:label>erythema elevatum diutinum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008990 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a panniculitis on the calves and it occurs mainly in women, but it is very rare now.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_induratum</obo:IAO_0000119>
        <obo:OAE_0001849>硬结性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10015213</obo:OAE_0004334>
        <rdfs:label>erythema induratum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008991 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is one of several possible manifestations of infection by parvovirus B19.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fifth_disease</obo:IAO_0000119>
        <obo:OAE_0001849>传染性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10015214</obo:OAE_0004334>
        <rdfs:label>erythema infectiosum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008992 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a type of erythema (redness of the skin or mucous membranes) involving pink rings on the torso and inner surfaces of the limbs which come and go for as long as several months.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_marginatum</obo:IAO_0000119>
        <obo:OAE_0001849>边缘性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10015216</obo:OAE_0004334>
        <rdfs:label>erythema marginatum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008993 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is an expanding rash often seen in the early stage of Lyme disease, and can also (but less commonly) be caused by southern tick-associated rash illness (STARI).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_migrans</obo:IAO_0000119>
        <obo:OAE_0001849>游走性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10062488</obo:OAE_0004334>
        <rdfs:label>erythema migrans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008994 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a common, non-threatening rash in newborns.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema_toxicum_neonatorum</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿中毒性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10056274</obo:OAE_0004334>
        <rdfs:label>erythema toxicum neonatorum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008995 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a superficial skin infection that causes brown, scaly skin patches.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythrasma</obo:IAO_0000119>
        <obo:OAE_0001849>红癣</obo:OAE_0001849>
        <obo:OAE_0004334>10015248</obo:OAE_0004334>
        <rdfs:label>erythrasma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008996 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by certain types of human herpes viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Roseola</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿玫瑰疹</obo:OAE_0001849>
        <obo:OAE_0004334>10015586</obo:OAE_0004334>
        <rdfs:label>exanthema subitum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008997 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a tan or dark skin discoloration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melasma</obo:IAO_0000119>
        <obo:OAE_0001849>黄褐斑</obo:OAE_0001849>
        <obo:OAE_0004334>10008570</obo:OAE_0004334>
        <rdfs:label>chloasma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008998 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which describes anatomy with the appearance and hair follicles get buried in the oedema and resemble an orange peel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peau_d%27orange</obo:IAO_0000119>
        <obo:OAE_0001849>桔皮性皮肤</obo:OAE_0001849>
        <obo:OAE_0004334>10049752</obo:OAE_0004334>
        <rdfs:label>peau d&apos;orange AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008999 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a disorder where hives (urticaria) or large red welts form on the skin after exposure to a cold stimulus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cold_urticaria</obo:IAO_0000119>
        <obo:OAE_0001849>寒冷性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10009869</obo:OAE_0004334>
        <rdfs:label>cold urticaria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009000 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is the physical urticarias where wheals are elicited via specific physical (mechanical, temperature, radiation) stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22760346/</obo:IAO_0000119>
        <obo:OAE_0001849>机械荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10068773</obo:OAE_0004334>
        <rdfs:label>mechanical urticaria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a rare condition in which exposure to ultraviolet or UV radiation, or sometimes even visible light, induces a case of urticaria or hives that can appear in both covered and uncovered areas of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Solar_urticaria</obo:IAO_0000119>
        <obo:OAE_0001849>日光性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10041307</obo:OAE_0004334>
        <rdfs:label>solar urticaria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is the most common form of cutaneous mastocytosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urticaria_pigmentosa</obo:IAO_0000119>
        <obo:OAE_0001849>色素性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10046752</obo:OAE_0004334>
        <rdfs:label>urticaria pigmentosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a rare form of physical urticaria in which hives develop on the skin after contact with water, regardless of its temperature.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aquagenic_urticaria</obo:IAO_0000119>
        <obo:OAE_0001849>水源性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10046739</obo:OAE_0004334>
        <rdfs:label>urticaria aquagenic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a kind of skin rash with red, raised, itchy bumps.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hives</obo:IAO_0000119>
        <obo:OAE_0001849>特发性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10021247</obo:OAE_0004334>
        <rdfs:label>idiopathic urticaria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009005 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a kind of skin rash with red, raised, itchy bumps.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hives</obo:IAO_0000119>
        <obo:OAE_0001849>荨麻疹热</obo:OAE_0001849>
        <obo:OAE_0004334>10061399</obo:OAE_0004334>
        <rdfs:label>urticaria thermal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009006 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a physical urticaria caused by pressure applied to the skin, and is characterized by the development of swelling and pain that usually occurs 3 to 12 hours after local pressure has been applied.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pressure_urticaria</obo:IAO_0000119>
        <obo:OAE_0001849>压力性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10052572</obo:OAE_0004334>
        <rdfs:label>urticaria pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009007 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a non-life-threatening and potentially distressing skin condition that is triggered by sunlight and artificial UV exposure in a genetically susceptible person, particularly in temperate climates during the spring and early summer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polymorphous_light_eruption</obo:IAO_0000119>
        <obo:OAE_0001849>多形日光疹</obo:OAE_0001849>
        <obo:OAE_0004334>10036087</obo:OAE_0004334>
        <rdfs:label>polymorphic light eruption AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009008 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a group of infectious diseases that include epidemic typhus, scrub typhus, and murine typhus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Typhus</obo:IAO_0000119>
        <obo:OAE_0001849>斑疹伤寒</obo:OAE_0001849>
        <obo:OAE_0004334>10061393</obo:OAE_0004334>
        <rdfs:label>typhus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009009 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a widespread rash occurring on the outside of the body and usually occurring in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exanthem</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10047476</obo:OAE_0004334>
        <rdfs:label>viral rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009010 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000359"/>
        <obo:IAO_0000115>This is an AE which is a viral disease characterized by a painful skin rash with blisters in a localized area.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shingles</obo:IAO_0000119>
        <obo:OAE_0001849>带状疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10019974</obo:OAE_0004334>
        <rdfs:label>herpes zoster AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009011 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000424"/>
        <obo:IAO_0000115>This is an AE which is a viral disease characterized by a painful skin rash with blisters in a localized area and is multi-dermatomal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shingles</obo:IAO_0000119>
        <obo:OAE_0001849>多皮节性带状疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10058428</obo:OAE_0004334>
        <rdfs:label>herpes zoster multi-dermatomal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009012 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000424"/>
        <obo:IAO_0000115>This is an AE which is defined as more than twenty skin lesions appearing outside either the primarily affected dermatome or dermatomes directly adjacent to it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shingles#Disseminated_shingles</obo:IAO_0000119>
        <obo:OAE_0001849>带状疱疹传播</obo:OAE_0001849>
        <obo:OAE_0004334>10065038</obo:OAE_0004334>
        <rdfs:label>herpes zoster disseminated AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009013 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a medical sign consisting of a characteristic form of facial rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Malar_rash</obo:IAO_0000119>
        <obo:OAE_0001849>蝶形皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10067982</obo:OAE_0004334>
        <rdfs:label>butterfly rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009014 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by the rubella virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rubella</obo:IAO_0000119>
        <obo:OAE_0001849>风疹</obo:OAE_0001849>
        <obo:OAE_0004334>10039252</obo:OAE_0004334>
        <rdfs:label>rubella AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by certain types of human herpes viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Roseola</obo:IAO_0000119>
        <obo:OAE_0001849>红疹</obo:OAE_0001849>
        <obo:OAE_0004334>10039222</obo:OAE_0004334>
        <rdfs:label>roseola AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009016 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which can refer to both beneficial medical procedures (e.g. vaccination) as well as non-beneficial or harmful natural processes (e.g. infection or disease).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoinoculation</obo:IAO_0000119>
        <obo:OAE_0001849>后接种疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10066043</obo:OAE_0004334>
        <rdfs:label>post vaccination autoinoculation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the human skin which affects its color, appearance, or texture and is septic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>化脓性皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10062657</obo:OAE_0004334>
        <rdfs:label>septic rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009018 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a skin disease marked by small and itchy rashes due to sweat trapped under the skin by clogged sweat gland ducts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Miliaria</obo:IAO_0000119>
        <obo:OAE_0001849>栗疹</obo:OAE_0001849>
        <obo:OAE_0004334>10027627</obo:OAE_0004334>
        <rdfs:label>miliaria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009019 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a bacterial disease spread by ticks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rocky_Mountain_spotted_fever</obo:IAO_0000119>
        <obo:OAE_0001849>落基山斑疹热</obo:OAE_0001849>
        <obo:OAE_0004334>10039207</obo:OAE_0004334>
        <rdfs:label>rocky mountain spotted fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a rash (small spots) on the mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enanthem</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜疹</obo:OAE_0001849>
        <obo:OAE_0004334>10014579</obo:OAE_0004334>
        <rdfs:label>enanthema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009021 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is a rare severe adverse reaction to smallpox vaccination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eczema_vaccinatum</obo:IAO_0000119>
        <obo:OAE_0001849>牛痘性湿疹</obo:OAE_0001849>
        <obo:OAE_0004334>10066042</obo:OAE_0004334>
        <rdfs:label>eczema vaccinatum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009022 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition  with herpes that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>疱疹脓毒症</obo:OAE_0001849>
        <obo:OAE_0004334>10058876</obo:OAE_0004334>
        <rdfs:label>herpes sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is a chronic autoimmune blistering skin condition, characterised by intensely itchy blisters filled with a watery fluid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis_herpetiformis</obo:IAO_0000119>
        <obo:OAE_0001849>疱疹性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062639</obo:OAE_0004334>
        <rdfs:label>herpes dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009024 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is a rare but severe disseminated infection that generally occurs at sites of skin damage produced by, for example, atopic dermatitis, burns, long-term usage of topical steroids or eczema.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eczema_herpeticum</obo:IAO_0000119>
        <obo:OAE_0001849>疱疹性湿疹</obo:OAE_0001849>
        <obo:OAE_0004334>10014197</obo:OAE_0004334>
        <rdfs:label>eczema herpeticum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009025 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the skin, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>湿疹型哭泣</obo:OAE_0001849>
        <obo:OAE_0004334>10055182</obo:OAE_0004334>
        <rdfs:label>eczema weeping AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009026 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is a common type of pruritic dermatitis and  can also be known as xerosis, which is dry skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31747214/</obo:IAO_0000119>
        <obo:OAE_0001849>湿疹性脂肪变性</obo:OAE_0001849>
        <obo:OAE_0004334>10014190</obo:OAE_0004334>
        <rdfs:label>eczema asteatotic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009027 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a form of typhus transmitted by fleas (Xenopsylla cheopis), usually on rats, in contrast to epidemic typhus which is usually transmitted by lice.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Murine_typhus</obo:IAO_0000119>
        <obo:OAE_0001849>鼠斑疹伤寒</obo:OAE_0001849>
        <obo:OAE_0004334>10028282</obo:OAE_0004334>
        <rdfs:label>murine typhus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009028 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a clog of the eccrine sweat gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Milium_(dermatology)</obo:IAO_0000119>
        <obo:OAE_0001849>粟丘疹</obo:OAE_0001849>
        <obo:OAE_0004334>10027626</obo:OAE_0004334>
        <rdfs:label>milia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009029 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an itchy eruption of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prurigo</obo:IAO_0000119>
        <obo:OAE_0001849>痒疹</obo:OAE_0001849>
        <obo:OAE_0004334>10037083</obo:OAE_0004334>
        <rdfs:label>prurigo AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which may mimic diseases that present with annular configuration and the differential diagnosis is broad.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32778043/</obo:IAO_0000119>
        <obo:OAE_0001849>圆形湿疹</obo:OAE_0001849>
        <obo:OAE_0004334>10014201</obo:OAE_0004334>
        <rdfs:label>eczema nummular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by the cowpox virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cowpox</obo:IAO_0000119>
        <obo:OAE_0001849>牛痘</obo:OAE_0001849>
        <obo:OAE_0004334>10011238</obo:OAE_0004334>
        <rdfs:label>cow pox AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009032 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a large, complex, enveloped virus belonging to the poxvirus family.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaccinia</obo:IAO_0000119>
        <obo:OAE_0001849>牛痘</obo:OAE_0001849>
        <obo:OAE_0004334>10066048</obo:OAE_0004334>
        <rdfs:label>vaccinia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009033 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <obo:IAO_0000115>This is an AE which is a slow-growing (16- to 20-hour generation time) aerobic bacterium and the causative agent of tuberculosis in cattle (known as bovine TB).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mycobacterium_bovis</obo:IAO_0000119>
        <obo:OAE_0001849>牛结核病</obo:OAE_0001849>
        <obo:OAE_0004334>10006049</obo:OAE_0004334>
        <rdfs:label>bovine tuberculosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009034 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is flat, hyperpigmented birthmarks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Caf%C3%A9_au_lait_spot</obo:IAO_0000119>
        <obo:OAE_0001849>牛奶咖啡斑</obo:OAE_0001849>
        <obo:OAE_0004334>10006926</obo:OAE_0004334>
        <rdfs:label>cafe au lait spots AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009035 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is clusters of concentrated melaninized cells which are most easily visible on people with a fair complexion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Freckle</obo:IAO_0000119>
        <obo:OAE_0001849>雀斑</obo:OAE_0001849>
        <obo:OAE_0004334>10014970</obo:OAE_0004334>
        <rdfs:label>ephelis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009036 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a small pigmented spot on the skin with a clearly defined edge, surrounded by normal-appearing skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lentigo</obo:IAO_0000119>
        <obo:OAE_0001849>雀斑</obo:OAE_0001849>
        <obo:OAE_0004334>10024217</obo:OAE_0004334>
        <rdfs:label>lentigo AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009037 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin condition characterized by excessively dry skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Xeroderma</obo:IAO_0000119>
        <obo:OAE_0001849>干皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10048218</obo:OAE_0004334>
        <rdfs:label>xeroderma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009038 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin condition characterized by excessively dry skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Xeroderma</obo:IAO_0000119>
        <obo:OAE_0001849>干燥症</obo:OAE_0001849>
        <obo:OAE_0004334>10048222</obo:OAE_0004334>
        <rdfs:label>xerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009039 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001397"/>
        <obo:IAO_0000115>This is an AE which is a discoloration of the human skin caused by a vascular anomaly (a capillary malformation in the skin).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Port-wine_stain</obo:IAO_0000119>
        <obo:OAE_0001849>鲜红斑痣</obo:OAE_0001849>
        <obo:OAE_0004334>10067193</obo:OAE_0004334>
        <rdfs:label>naevus flammeus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>This is an AE which is a condition in which hair is lost from some or all areas of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alopecia_areata</obo:IAO_0000119>
        <obo:OAE_0001849>斑秃</obo:OAE_0001849>
        <obo:OAE_0004334>10001761</obo:OAE_0004334>
        <rdfs:label>alopecia areata AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009041 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a condition characterized by a skin eruption on the trunk and proximal extremities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tinea_versicolor</obo:IAO_0000119>
        <obo:OAE_0001849>花斑癣</obo:OAE_0001849>
        <obo:OAE_0004334>10056131</obo:OAE_0004334>
        <rdfs:label>tinea versicolor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009042 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries and it is epiglottic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>会厌性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10067486</obo:OAE_0004334>
        <rdfs:label>epiglottic erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009043 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a common type of conjunctival stromal degeneration in the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pinguecula</obo:IAO_0000119>
        <obo:OAE_0001849>结膜黄斑</obo:OAE_0001849>
        <obo:OAE_0004334>10035060</obo:OAE_0004334>
        <rdfs:label>pinguecula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009044 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a medical condition which may result in blurred or no vision in the center of the visual field.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macular_degeneration</obo:IAO_0000119>
        <obo:OAE_0001849>年龄相关性黄斑变性</obo:OAE_0001849>
        <obo:OAE_0004334>10064930</obo:OAE_0004334>
        <rdfs:label>age-related macular degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009045 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a firmly attached white patch on a mucous membrane which is associated with increased risk of cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leukoplakia</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜白斑病</obo:OAE_0001849>
        <obo:OAE_0004334>10062037</obo:OAE_0004334>
        <rdfs:label>leukoplakia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009046 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a form of radiation burn that affects living tissue, such as skin, that results from an overexposure to ultraviolet (UV) radiation, usually from the Sun.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sunburn</obo:IAO_0000119>
        <obo:OAE_0001849>晒斑</obo:OAE_0001849>
        <obo:OAE_0004334>10042496</obo:OAE_0004334>
        <rdfs:label>sunburn AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009047 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is blemishes on the skin associated with aging and exposure to ultraviolet radiation from the sun.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Liver_spot</obo:IAO_0000119>
        <obo:OAE_0001849>太阳斑</obo:OAE_0001849>
        <obo:OAE_0004334>10064127</obo:OAE_0004334>
        <rdfs:label>solar lentigo AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009048 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a form of scleroderma that involves isolated patches of hardened skin on the face, hands, and feet, or anywhere else on the body, with no internal organ involvement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Morphea</obo:IAO_0000119>
        <obo:OAE_0001849>硬斑病</obo:OAE_0001849>
        <obo:OAE_0004334>10027982</obo:OAE_0004334>
        <rdfs:label>morphoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009049 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a microscopic exocrine gland in the skin that opens into a hair follicle to secrete an oily or waxy matter, called sebum, which lubricates the hair and skin of mammals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sebaceous_gland</obo:IAO_0000119>
        <obo:OAE_0001849>皮脂溢</obo:OAE_0001849>
        <obo:OAE_0004334>10039792</obo:OAE_0004334>
        <rdfs:label>seborrhoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009050 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the (uncontrolled) death of cells in the (cerebral) cortex of the brain in a band-like pattern,with a relative preservation of cells immediately adjacent to the meninges.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cortical_pseudolaminar_necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>皮质层状坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10051990</obo:OAE_0004334>
        <rdfs:label>cortical laminar necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009051 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a rare neurodegenerative disease involving the cerebral cortex and the basal ganglia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corticobasal_degeneration</obo:IAO_0000119>
        <obo:OAE_0001849>皮质基底节变性</obo:OAE_0001849>
        <obo:OAE_0004334>10078208</obo:OAE_0004334>
        <rdfs:label>corticobasal degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009052 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is one specific measure of bodily symmetry.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Facial_symmetry</obo:IAO_0000119>
        <obo:OAE_0001849>面部不对称</obo:OAE_0001849>
        <obo:OAE_0004334>10068737</obo:OAE_0004334>
        <rdfs:label>facial asymmetry AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009053 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which is feel discomfortable of a family of skin care treatments for the face, including steam, exfoliation (physical and chemical), extraction, creams, lotions, facial masks, peels, and massage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Facial</obo:IAO_0000119>
        <obo:OAE_0001849>面部不适</obo:OAE_0001849>
        <obo:OAE_0004334>10083537</obo:OAE_0004334>
        <rdfs:label>facial discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009054 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a rare neuromuscular disease characterized by irregular, involuntary muscle contractions (spasms) on one side (hemi-) of the face (-facial).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemifacial_spasm</obo:IAO_0000119>
        <obo:OAE_0001849>面部痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10063006</obo:OAE_0004334>
        <rdfs:label>facial spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009055 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is sensitivity of a powder made by grinding raw grains, roots, beans, nuts, or seeds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Flour</obo:IAO_0000119>
        <obo:OAE_0001849>面粉敏感性</obo:OAE_0001849>
        <obo:OAE_0004334>10016788</obo:OAE_0004334>
        <rdfs:label>flour sensitivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009056 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection that involves the superficial skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Impetigo</obo:IAO_0000119>
        <obo:OAE_0001849>脓疱病</obo:OAE_0001849>
        <obo:OAE_0004334>10021531</obo:OAE_0004334>
        <rdfs:label>impetigo AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009057 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000238"/>
        <obo:IAO_0000115>This is an AE which is used for a heterogeneous group of diseases that share pustular skin characteristics.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pustular_psoriasis</obo:IAO_0000119>
        <obo:OAE_0001849>脓疱型银屑病</obo:OAE_0001849>
        <obo:OAE_0004334>10037575</obo:OAE_0004334>
        <rdfs:label>pustular psoriasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009058 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a chronic inflammatory and immune-mediated disease that affects the skin, nails, hair, and mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lichen_planus</obo:IAO_0000119>
        <obo:OAE_0001849>苔藓样角化病</obo:OAE_0001849>
        <obo:OAE_0004334>10064000</obo:OAE_0004334>
        <rdfs:label>lichenoid keratosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009059 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is highly inflammatory skin condition resulting in large fluid-filled blister-like areas - pustules and it is eosinophilic .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pustulosis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性脓疱病</obo:OAE_0001849>
        <obo:OAE_0004334>10049172</obo:OAE_0004334>
        <rdfs:label>eosinophilic pustulosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009060 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000953"/>
        <obo:IAO_0000115>This is an AE which is an itchy rash with an unknown cause that is most common among individuals with HIV, though it can occur in HIV-negative individuals where it is known by the eponym Ofuji disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_folliculitis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性脓疱的毛囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052834</obo:OAE_0004334>
        <rdfs:label>eosinophilic pustular folliculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009061 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition characterized by deposits of excessive amounts of collagen which gives rise to a raised scar, but not to the degree observed with keloids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophic_scar</obo:IAO_0000119>
        <obo:OAE_0001849>肥厚性疤痕</obo:OAE_0001849>
        <obo:OAE_0004334>10020879</obo:OAE_0004334>
        <rdfs:label>hypertrophic scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009062 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which refers to one of a group of skin disorders that are characterized primarily by their resemblance to psoriasis (red, scaly lesions), rather than by their underlying cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parapsoriasis</obo:IAO_0000119>
        <obo:OAE_0001849>类银屑病</obo:OAE_0001849>
        <obo:OAE_0004334>10033898</obo:OAE_0004334>
        <rdfs:label>parapsoriasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009063 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a family of genetic skin disorders characterized by dry, thickened, scaly skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ichthyosis</obo:IAO_0000119>
        <obo:OAE_0001849>鱼鳞癣</obo:OAE_0001849>
        <obo:OAE_0004334>10021198</obo:OAE_0004334>
        <rdfs:label>ichthyosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009064 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a polymorphic, pruritic, papulovesicular dermatosis characterized histologically by acantholysis with or without dyskeratosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transient_acantholytic_dermatosis</obo:IAO_0000119>
        <obo:OAE_0001849>一过性棘层松解性皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10051446</obo:OAE_0004334>
        <rdfs:label>transient acantholytic dermatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009065 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which is a condition where purpura, which constitutes visible non-blanching hemorrhages, are raised and able to be touched or felt upon palpation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palpable_purpura</obo:IAO_0000119>
        <obo:OAE_0001849>可触及紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10056872</obo:OAE_0004334>
        <rdfs:label>palpable purpura AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009066 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which implies that this nevus exists as a distinct and defined entity of potential detriment to its host.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26037217/</obo:IAO_0000119>
        <obo:OAE_0001849>异常增生痣</obo:OAE_0001849>
        <obo:OAE_0004334>10062805</obo:OAE_0004334>
        <rdfs:label>dysplastic naevus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009067 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a type of telangiectasis (swollen blood vessels) found slightly beneath the skin surface, often containing a central red spot and deep reddish extensions (see Blood color) which radiate outwards like a spider&apos;s web or a spider&apos;s legs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spider_angioma</obo:IAO_0000119>
        <obo:OAE_0001849>蜘蛛痣</obo:OAE_0001849>
        <obo:OAE_0004334>10041519</obo:OAE_0004334>
        <rdfs:label>spider naevus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009068 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a deep folliculitis on eyelid, infection of the hair follicle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Boil</obo:IAO_0000119>
        <obo:OAE_0001849>睑疖</obo:OAE_0001849>
        <obo:OAE_0004334>10015980</obo:OAE_0004334>
        <rdfs:label>eyelid boil AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009069 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which is a common type of contagious, superficial fungal infection of the groin region, which occurs predominantly but not exclusively in men and in hot-humid climates.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tinea_cruris</obo:IAO_0000119>
        <obo:OAE_0001849>股癣</obo:OAE_0001849>
        <obo:OAE_0004334>10043868</obo:OAE_0004334>
        <rdfs:label>tinea cruris AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009070 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001422"/>
        <obo:IAO_0000115>This is an AE which is a bacterial skin infection caused by Staphylococcus aureus that results in the formation of large blisters called bullae, usually in areas with skin folds like the armpit, groin, between the fingers or toes, beneath the breast, and between the buttocks. It accounts for 30% of cases of impetigo, the other 70% being non-bullous impetigo.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bullous_impetigo</obo:IAO_0000119>
        <obo:OAE_0001849>大疱性脓疱病</obo:OAE_0001849>
        <obo:OAE_0004334>10006563</obo:OAE_0004334>
        <rdfs:label>bullous impetigo AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009071 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is a type of dermatitis that is characterized by itchy blisters on the palms of the hands and bottoms of the feet.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dyshidrosis</obo:IAO_0000119>
        <obo:OAE_0001849>汗疱</obo:OAE_0001849>
        <obo:OAE_0004334>10013913</obo:OAE_0004334>
        <rdfs:label>dyshidrotic eczema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009072 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a chronic recurrent pustular dermatosis (that is, a pustulosis or pustular psoriasis) localized on the palms and soles only, characterized histologically by intraepidermal pustules filled with neutrophils.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pustulosis_palmaris_et_plantaris</obo:IAO_0000119>
        <obo:OAE_0001849>掌跖脓疱病</obo:OAE_0001849>
        <obo:OAE_0004334>10050185</obo:OAE_0004334>
        <rdfs:label>palmoplantar pustulosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009073 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which attributed to Heinrich Köbner, is the appearance of skin lesions on lines of trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Koebner_phenomenon</obo:IAO_0000119>
        <obo:OAE_0001849>koebner现象</obo:OAE_0001849>
        <obo:OAE_0004334>10048649</obo:OAE_0004334>
        <rdfs:label>koebner phenomenon AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009074 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which involves a neuropathic component is often of mild intensity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30394066/</obo:IAO_0000119>
        <obo:OAE_0001849>疤痕痛</obo:OAE_0001849>
        <obo:OAE_0004334>10049002</obo:OAE_0004334>
        <rdfs:label>scar pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009075 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which is the formation of a type of scar which, depending on its maturity, is composed mainly of either type III (early) or type I (late) collagen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keloid</obo:IAO_0000119>
        <obo:OAE_0001849>瘢痕疙瘩</obo:OAE_0001849>
        <obo:OAE_0004334>10023330</obo:OAE_0004334>
        <rdfs:label>keloid scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009076 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition characterized by rough, yellow-brown keratotic, flat-topped papules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperkeratosis#Other</obo:IAO_0000119>
        <obo:OAE_0001849>持久性豆状角化过度病</obo:OAE_0001849>
        <obo:OAE_0004334>10071311</obo:OAE_0004334>
        <rdfs:label>hyperkeratosis lenticularis perstans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009077 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001422"/>
        <obo:IAO_0000115>This is an AE which is a deep folliculitis, infection of the hair follicle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Boil</obo:IAO_0000119>
        <obo:OAE_0001849>疔疮</obo:OAE_0001849>
        <obo:OAE_0004334>10017553</obo:OAE_0004334>
        <rdfs:label>furuncle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009078 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is largely dermatological conditions, which present clinically as cutaneous photosensitivity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2194599/</obo:IAO_0000119>
        <obo:OAE_0001849>非急性卟啉症</obo:OAE_0001849>
        <obo:OAE_0004334>10036186</obo:OAE_0004334>
        <rdfs:label>porphyria non-acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009079 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a skin disease marked by small and itchy rashes due to sweat trapped under the skin by clogged sweat gland ducts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Miliaria</obo:IAO_0000119>
        <obo:OAE_0001849>痱子</obo:OAE_0001849>
        <obo:OAE_0004334>10019343</obo:OAE_0004334>
        <rdfs:label>heat rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009080 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a specific disorder of keratinization that is characterized histologically by the presence of a cornoid lamella, a thin column of closely stacked, parakeratotic cells extending through the stratum corneum with a thin or absent granular layer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Porokeratosis</obo:IAO_0000119>
        <obo:OAE_0001849>汗孔角化病</obo:OAE_0001849>
        <obo:OAE_0004334>10036175</obo:OAE_0004334>
        <rdfs:label>porokeratosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009081 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002536"/>
        <obo:IAO_0000115>This is an AE which is a rare, inflammatory skin disease where painful pustules or nodules become ulcers that progressively grow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pyoderma_gangrenosum</obo:IAO_0000119>
        <obo:OAE_0001849>坏疽性脓皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10037635</obo:OAE_0004334>
        <rdfs:label>pyoderma gangrenosum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009082 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which is a fungal infection of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatophytosis</obo:IAO_0000119>
        <obo:OAE_0001849>脚气</obo:OAE_0001849>
        <obo:OAE_0004334>10012504</obo:OAE_0004334>
        <rdfs:label>dermatophytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009083 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a clinical dermatological sign, named after Pyotr Nikolsky.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nikolsky%27s_sign</obo:IAO_0000119>
        <obo:OAE_0001849>尼氏征</obo:OAE_0001849>
        <obo:OAE_0004334>10029415</obo:OAE_0004334>
        <rdfs:label>nikolsky&apos;s sign AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009084 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is a form of allergic contact dermatitis in which the allergen must be activated by light to sensitize the allergic response, and to cause a rash or other systemic effects on subsequent exposure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Photodermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>日光性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10041303</obo:OAE_0004334>
        <rdfs:label>solar dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009085 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a chronic discoloration of the skin found in people of all ages, usually only affecting the feet, legs or thighs or a combination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schamberg_disease</obo:IAO_0000119>
        <obo:OAE_0001849>尚伯格病</obo:OAE_0001849>
        <obo:OAE_0004334>10039593</obo:OAE_0004334>
        <rdfs:label>schamberg&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009086 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009086">
