        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is an abnormal growth of tissue projecting from a anal mucous membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyp_(medicine)</obo:IAO_0000119>
