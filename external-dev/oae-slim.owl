        <rdfs:label>peripheral vascular disorder AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005299</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085096</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000498 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004456"/>
        <obo:IAO_0000115>a urinary tract disoder AE that has an outcome of urnary tract infection AE</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:OAE_0004334>10046571</obo:OAE_0004334>
        <rdfs:label>urinary tract infection AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11614</rdfs:seeAlso>
