    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005970 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is a form of hallucination that involves perceiving sounds without auditory stimulus.</obo:IAO_0000115>
