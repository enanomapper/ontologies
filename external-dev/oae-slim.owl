        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is used to describe the condition where a child does not reach one of these stages at the expected age.</obo:IAO_0000115>
