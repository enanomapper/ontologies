    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>Increased defecation frequency AE is a abnormal stool AE that shows defecation number increased.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>大便次数增加</obo:OAE_0001849>
        <rdfs:label>increased defecation frequency AE</rdfs:label>
    </owl:Class>
    


