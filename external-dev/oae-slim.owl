        <obo:OAE_0004334>10062585</obo:OAE_0004334>
        <rdfs:label>peripheral arterial occlusive disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005414 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000237"/>
