        <obo:OAE_0004334>10051244</obo:OAE_0004334>
        <rdfs:label>dyschezia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005627 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which is voluntary or involuntary passage of feces outside of toilet trained contexts (fecal soiling) in children who are four years or older and after an organic cause has been excluded.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Encopresis</obo:IAO_0000119>
        <obo:OAE_0001849>大便失禁</obo:OAE_0001849>
        <obo:OAE_0004334>10014643</obo:OAE_0004334>
        <rdfs:label>encopresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005628 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is food or drug administration via the human gastrointestinal tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enteral_administration</obo:IAO_0000119>
        <obo:OAE_0001849>肠内营养</obo:OAE_0001849>
        <obo:OAE_0004334>10052591</obo:OAE_0004334>
        <rdfs:label>enteral nutrition AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005629 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000916"/>
        <obo:IAO_0000115>This is an AE which infectious enteritis are caused by four pathogens, Norovirus, Rotavirus, Campylobacter and Salmonella.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enteritis</obo:IAO_0000119>
        <obo:OAE_0001849>传染性肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10058839</obo:OAE_0004334>
        <rdfs:label>enteritis infectious AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005630 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000916"/>
        <obo:IAO_0000115>This is an AE which is a segmental necrotizing infection of the jejunum and ileum caused by Clostridium perfringens, Type C.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11796843/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014878</obo:OAE_0004334>
        <rdfs:label>enteritis necroticans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005631 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a infection of a genus of common Gram-negative, facultatively anaerobic, rod-shaped, non-spore-forming bacteria of the family Enterobacteriaceae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enterobacter</obo:IAO_0000119>
        <obo:OAE_0001849>肠杆菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10051910</obo:OAE_0004334>
        <rdfs:label>enterobacter infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005632 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by enterobacter that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>肠杆菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10054219</obo:OAE_0004334>
        <rdfs:label>enterobacter sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005633 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a human parasitic disease caused by the pinworm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pinworm_infection</obo:IAO_0000119>
        <obo:OAE_0001849>蛲虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10014881</obo:OAE_0004334>
        <rdfs:label>enterobiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005634 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is associated with large burdens of morbidity and mortality, particularly among fragile and immunosuppressed patients presenting complicated bacteraemia due to multidrug-resistant enterococci.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33152537/</obo:IAO_0000119>
        <obo:OAE_0001849>肠球菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10014885</obo:OAE_0004334>
        <rdfs:label>enterococcal bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005635 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a infection caused by a large genus of lactic acid bacteria of the phylum Firmicutes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enterococcus</obo:IAO_0000119>
        <obo:OAE_0001849>肠球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061124</obo:OAE_0004334>
        <rdfs:label>enterococcal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005636 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which include bacteremias when the infections are bacterial  such as enterococcal when the infections are infections present in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bloodstream_infections</obo:IAO_0000119>
        <obo:OAE_0001849>肠球菌脓毒症</obo:OAE_0001849>
        <obo:OAE_0004334>10054221</obo:OAE_0004334>
        <rdfs:label>enterococcal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005637 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000917"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the digestive tract caused by bacterial, involving enteritis of the small intestine and colitis of the colon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enterocolitis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性小肠结肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065206</obo:OAE_0004334>
        <rdfs:label>enterocolitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005638 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000917"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the digestive tract with haemorrhagic, involving enteritis of the small intestine and colitis of the colon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enterocolitis</obo:IAO_0000119>
        <obo:OAE_0001849>小肠结肠炎出血</obo:OAE_0001849>
        <obo:OAE_0004334>10014896</obo:OAE_0004334>
        <rdfs:label>enterocolitis haemorrhagic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005639 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000917"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the digestive tract caused by viral, involving enteritis of the small intestine and colitis of the colon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enterocolitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性小肠结肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10061841</obo:OAE_0004334>
        <rdfs:label>enterocolitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005640 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000212"/>
        <obo:IAO_0000115>This is an AE which is an abnormal communication between the small or large bowel and the skin that allows the contents of the stomach or intestines to leak through an opening in the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enterocutaneous_fistula</obo:IAO_0000119>
        <obo:OAE_0001849>肠皮瘘</obo:OAE_0001849>
        <obo:OAE_0004334>10051425</obo:OAE_0004334>
        <rdfs:label>enterocutaneous fistula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005641 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which refers to range from mild to severe acute infections concerning several organ systems and are also associated with chronic diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30106324/</obo:IAO_0000119>
        <obo:OAE_0001849>肠道病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10014909</obo:OAE_0004334>
        <rdfs:label>enterovirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005642 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which refers to a disorder involving the attachment of a tendon or ligament to a bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enthesopathy</obo:IAO_0000119>
