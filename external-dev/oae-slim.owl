        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is disorders of the endocrine system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endocrine_disease</obo:IAO_0000119>
        <obo:OAE_0001849>内分泌紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10014695</obo:OAE_0004334>
