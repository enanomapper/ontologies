        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>听力残疾</obo:OAE_0001849>
        <obo:OAE_0004334>10053194</obo:OAE_0004334>
