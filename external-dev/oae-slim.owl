    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008114 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged lip blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇出血</obo:OAE_0001849>
        <obo:OAE_0004334>10049297</obo:OAE_0004334>
        <rdfs:label>lip hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008115 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000894"/>
        <obo:IAO_0000115>This is an AE which refers constant licking of the lips causes drying and irritation, and eventually the mucosa splits or cracks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cheilitis#Cheilitis_simplex_(chapped_lips)</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇干裂</obo:OAE_0001849>
        <obo:OAE_0004334>10024552</obo:OAE_0004334>
        <rdfs:label>lip dry AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008116 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000691"/>
        <obo:IAO_0000115>This is an AE which is an ulcer that occurs on the mucous membrane of the oral cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mouth_ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10024572</obo:OAE_0004334>
