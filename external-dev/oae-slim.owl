        <rdfs:label>Grade 3 bullous dermatitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13620</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002830 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002667"/>
        <obo:IAO_0000115>a bullous AE that has blisters covering &gt;30% BSA; associated with fluid or electrolyte abnormalities; ICU care or burn unit indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 bullous dermatitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13621</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002831 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002673"/>
        <obo:IAO_0000115>an erythroderma AE that has erythema covering &gt;90% BSA without associated symptoms; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 erythroderma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13634</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002832 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002673"/>
        <obo:IAO_0000115>an erythroderma AE that has erythema covering &gt;90% BSA with associated symptoms (e.g., pruritus or tenderness); limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 erythroderma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13635</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002833 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002673"/>
        <obo:IAO_0000115>an erythroderma AE that has erythema covering &gt;90% BSA with associated fluid or electrolyte abnormalities; ICU care or burn unit indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 erythroderma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002834 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002702"/>
        <obo:IAO_0000115>a fat atrophy AE that is covering &lt;10% BSA and asymptomatic</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 fat atrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13639</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002835 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002702"/>
        <obo:IAO_0000115>a fat atrophy AE that is covering 10 - 30% BSA and associated with erythema or tenderness; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 fat atrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13640</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002836 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002702"/>
        <obo:IAO_0000115>a fat atrophy AE that is covering &gt;30% BSA; associated with erythema or tenderness; limiting self-care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 fat atrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13641</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002837 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002684"/>
        <obo:IAO_0000115>a hirsutism AE that is In women, increase in length, thickness or density of hair in a male distribution that the patient is able to camouflage by periodic shaving, bleaching, or removal of hair</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hirsutism AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13643</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002838 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002684"/>
        <obo:IAO_0000115>a hirsutism AE that In women, increase in length, thickness or density of hair in a male distribution that requires daily shaving or consistent destructive means of hair removal to camouflage; associated with psychosocial impact</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 hirsutism AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13644</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002839 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002788"/>
        <obo:IAO_0000115>a hypertrichosis AE that has increased in length, thickness or density of hair. The patient is either able to camouflage by periodic shaving or removal of hairs or is not concerned enough about the overgrowth to use any form of hair removal</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 hypertrichosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13650</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002840 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002840">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002788"/>
        <obo:IAO_0000115>a hypertrichosis AE that has increased in length, thickness or density of hair at least on the usual exposed areas of the body [face (not limited to beard/moustache area) plus/minus arms] that requires frequent shaving or use of destructive means of hair removal to camouflage; associated with psychosocial impact</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 hypertrichosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13651</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002841 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002662"/>
        <obo:IAO_0000115>a hypertrichosis AE that has increased in body temperature; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 hypohidrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13654</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002842 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002662"/>
        <obo:IAO_0000115>a hypertrichosis AE that has heat stroke</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 hypohidrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13655</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002843 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002722"/>
        <obo:IAO_0000115>a lipohypertrophy AE that has asymptomatic and covering &lt;10% BSA</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 lipohypertrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13658</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002844 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002722"/>
        <obo:IAO_0000115>a lipohypertrophy AE that covers 10 - 30% BSA and associated tenderness; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 lipohypertrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13659</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002845 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002722"/>
        <obo:IAO_0000115>a lipohypertrophy AE that covers &gt;30% BSA and associated tenderness and narcotics or NSAIDs indicated; lipohypertrophy; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 lipohypertrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13660</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002846 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002734"/>
        <obo:IAO_0000115>a nail loss AE that has asymptomatic separation of the nail bed from the nail plate or nail loss</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 nail loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13664</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002847 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002734"/>
        <obo:IAO_0000115>a nail loss AE that has symptomatic separation of the nail bed from the nail plate or nail loss; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 nail loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13665</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002848 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002599"/>
        <obo:IAO_0000115>a rash acneiform AE that has papules and/or pustules covering &lt;10% BSA, which may or may not be associated with symptoms of pruritus or tenderness</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 rash acneiform AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13695</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002849 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002849">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002599"/>
        <obo:IAO_0000115>a rash acneiform AE that has papules and/or pustules covering 10 - 30% BSA, which may or may not be associated with symptoms of pruritus or tenderness; associated with psychosocial impact; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 rash acneiform AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13696</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002850 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002599"/>
        <obo:IAO_0000115>a rash acneiform AE that has papules and/or pustules covering &gt;30% BSA, which may or may not be associated with symptoms of pruritus or tenderness; limiting self care ADL; associated with local superinfection with oral antibiotics indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 rash acneiform AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13697</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002851 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002599"/>
        <obo:IAO_0000115>a rash acneiform AE that has papules and/or pustules covering any % BSA, which may or may not be associated with symptoms of pruritus or tenderness and are associated with extensive superinfection with IV antibiotics indicated; life-threatening consequences</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 rash acneiform AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13698</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002852 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000384"/>
        <obo:IAO_0000115>a rash maculopapular AE that has macules/papules covering &lt;10% BSA with or without symptoms (e.g., pruritus, burning, tightness)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 rash maculo-papular AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13701</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002853 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000384"/>
        <obo:IAO_0000115>a rash maculopapular AE that has macules/papules covering 10 - 30% BSA with or without symptoms (e.g., pruritus, burning, tightness); limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 rash maculo-papular AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13702</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002854 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000384"/>
        <obo:IAO_0000115>a rash maculopapular AE that has macules/papules covering &gt;30% BSA with or without associated symptoms; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 rash maculo-papular AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13703</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002855 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002762"/>
        <obo:IAO_0000115>a skin induration AE that has mild induration, able to move skin parallel to plane (sliding) and perpendicular to skin (pinching up)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 skin induration AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13725</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002856 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002762"/>
        <obo:IAO_0000115>a skin induration AE that has moderate induration, able to slide skin, unable to pinch skin; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 skin induration AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13726</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002857 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002762"/>
        <obo:IAO_0000115>a skin induration AE that has severe induration, unable to slide or pinch skin; limiting joint movement or orifice (e.g., mouth, anus); limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 skin induration AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13727</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002858 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002762"/>
        <obo:IAO_0000115>a skin induration AE that has generalized; associated with signs or symptoms of impaired breathing or feeding</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 skin induration AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13728</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002859 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002786"/>
        <obo:IAO_0000115>a bronchial fistula AE that has symptomatic; tube thoracostomy or medical management indicated; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 bronchial fistula AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13324</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002860 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002786"/>
        <obo:IAO_0000115>a bronchial fistula AE that has severe symptoms; limiting self care ADL; endoscopic or operative intervention indicated (e.g., stent or primary closure)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 bronchial fistula AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13325</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002861 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002786"/>
        <obo:IAO_0000115>a bronchial fistula AE that has life-threatening consequences; urgent operative intervention with thoracoplasty, chronic open drainage or multiple thoracotomies indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 bronchial fistula AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13326</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002862 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002692"/>
        <obo:IAO_0000115>a bronchial obstruction AE that has symptomatic (e.g., mild wheezing); endoscopic evaluation indicated; radiographic evidence of atelectasis/lobar collapse; medical management indicated (e.g., steroids, bronchodilators)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 bronchial obstruction AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13330</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002863 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002692"/>
        <obo:IAO_0000115>a bronchial obstruction AE that has shortness of breath with stridor; endoscopic intervention indicated (e.g., laser, stent placement)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 bronchial obstruction AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13331</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002864 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002693"/>
        <obo:IAO_0000115>a bronchial stricture AE that AE symptomatic (e.g., rhonchi or wheezing) but without respiratory distress; medical intervention indicated (e.g., steroids, bronchodilators)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 bronchial stricture AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13336</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002693"/>
        <obo:IAO_0000115>a bronchial stricture AE that AE shortness of breath with stridor; endoscopic intervention indicated (e.g., laser, stent placement)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 bronchial stricture AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13337</rdfs:seeAlso>
