    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002601"/>
        <obo:IAO_0000115>This is an AE which is an injury to the spinal accessory nerve which results in diminished or absent function of the sternocleidomastoid muscle and upper portion of the trapezius muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
