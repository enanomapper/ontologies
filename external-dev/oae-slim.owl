    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005616 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002095"/>
        <obo:IAO_0000115>This is an AE which is a lack of control over defecation, leading to involuntary loss of bowel contents, both liquid stool elements and mucus, or solid feces.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fecal_incontinence</obo:IAO_0000119>
        <obo:OAE_0001849>粪便尿失禁</obo:OAE_0001849>
        <obo:OAE_0004334>10016092</obo:OAE_0004334>
        <rdfs:label>faecal incontinence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005617 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which is a more extreme form of fecal impaction, giving the accumulation an appearance of a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fecal_impaction#Fecaloma</obo:IAO_0000119>
