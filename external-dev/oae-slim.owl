    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005498 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000240"/>
        <obo:IAO_0000115>This is an Ae which is an organism&apos;s response to a stressor such as an environmental condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stress_(biology)</obo:IAO_0000119>
        <obo:OAE_0001849>家族性应激</obo:OAE_0001849>
        <obo:OAE_0004334>10016215</obo:OAE_0004334>
        <rdfs:label>family stress AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005499 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an extremely rare developmental anomaly with right and left hepatic ducts draining directly into the gallbladder (GB).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27279403/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性缺乏胆管</obo:OAE_0001849>
        <obo:OAE_0004334>10010317</obo:OAE_0004334>
        <rdfs:label>congenital absence of bile ducts AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005500 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a rare cause of primary adrenocortical failure which  involved a broad spectrum of cellular and physiologic processes, including metabolism, nuclear protein import, oxidative stress defense-mechanisms, and regulation of cell cycle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25905355/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肾上腺发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10049057</obo:OAE_0004334>
        <rdfs:label>congenital adrenal gland hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005501 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a condition present at birth regardless of its cause and may result in disabilities that may be physical, intellectual, or developmental.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10010356</obo:OAE_0004334>
        <rdfs:label>congenital anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005502 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is usually congenital and belong to the RASopathies and the genetic transmission patterns of AVMs are incomplete, but there are known genetic mutations (for instance in the epithelial line, tumor suppressor PTEN gene) which can lead to an increased occurrence throughout the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arteriovenous_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>先天性动脉畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062325</obo:OAE_0004334>
        <rdfs:label>congenital arterial malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005503 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which can have devastating clinical consequences and they can lead to oligohydramnios with subsequent lung hypoplasia and neonatal death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23832138/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性膀胱异常</obo:OAE_0001849>
        <obo:OAE_0004334>10061053</obo:OAE_0004334>
        <rdfs:label>congenital bladder anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005504 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is the destruction or degeneration of brain cells which was congenital.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Brain_damage</obo:IAO_0000119>
        <obo:OAE_0001849>先天性脑损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10010390</obo:OAE_0004334>
        <rdfs:label>congenital brain damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005505 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a rare condition in which a brain develops without the cerebellum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebellar_agenesis</obo:IAO_0000119>
        <obo:OAE_0001849>先天性小脑发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10010390</obo:OAE_0004334>
        <rdfs:label>congenital cerebellar agenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005506 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is  papillary neoplasms of neuroectodermal origin arising from the choroid plexus epithelium of the cerebral ventricles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30953158/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性脉络丛囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10048785</obo:OAE_0004334>
        <rdfs:label>congenital choroid plexus cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005507 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000845"/>
        <obo:IAO_0000115>This is an AE which can be categorized into those with a lack of origin or ostial atresia, an abnormal origin such as an anomalous origin off the pulmonary artery or off an abnormal aortic sinus, or an anomalous course (such as a single coronary coursing between the pulmonary artery and aorta) or a coronary artery fistula.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27490623/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性冠状动脉畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061060</obo:OAE_0004334>
        <rdfs:label>congenital coronary artery malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005508 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a congenital closed sac, having a distinct envelope and division compared with the nearby tissue .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>先天性囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10062328</obo:OAE_0004334>
        <rdfs:label>congenital cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005509 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000563"/>
        <obo:IAO_0000115>This is an AE which comprise a spectrum of anomalies that include pulmonary sequestrations, congenital lobar emphysema, bronchogenic cysts, and congenital cystic adenomatoid malformations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25448785/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性囊性肺</obo:OAE_0001849>
        <obo:OAE_0004334>10010429</obo:OAE_0004334>
        <rdfs:label>congenital cystic lung AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005510 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which refers to a condition where cytomegalovirus is transmitted in the prenatal period.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_cytomegalovirus_infection</obo:IAO_0000119>
        <obo:OAE_0001849>先天性巨细胞病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10010430</obo:OAE_0004334>
        <rdfs:label>congenital cytomegalovirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005511 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is rare and is a tumor that originates in the connective fibrous tissue found at the ends of long bones and then spreads to other surrounding soft tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29099410/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性纤维肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10065859</obo:OAE_0004334>
        <rdfs:label>congenital fibrosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005512 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a physical anomaly that is deleterious, i.e. foot defect  perceived as a problem.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>先天性足畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062332</obo:OAE_0004334>
        <rdfs:label>congenital foot malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005513 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is an autosomal-recessive disorder characterized by generalized lack of adipose tissue either at birth or within the first year of life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7590232/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性普遍脂肪代谢障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10053547</obo:OAE_0004334>
        <rdfs:label>congenital generalised lipodystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005514 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is frequent, usually isolated anomalies, but may exist as part of a syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22585196/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性手畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062335</obo:OAE_0004334>
        <rdfs:label>congenital hand malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005515 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by the hepatitis B virus (HBV) that affects the liver;it is a type of  congenital viral hepatitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_B</obo:IAO_0000119>
        <obo:OAE_0001849>先天性乙型肝炎感染</obo:OAE_0001849>
        <obo:OAE_0004334>10010496</obo:OAE_0004334>
        <rdfs:label>congenital hepatitis b infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005516 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001990"/>
        <obo:IAO_0000115>This is an AE which is rare, with congenital HSV infection by intrauterine infection accounting for &lt;5% of cases of HSV infection in the perinatal period.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32001045/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性单纯疱疹感染</obo:OAE_0001849>
        <obo:OAE_0004334>10019949</obo:OAE_0004334>
        <rdfs:label>congenital herpes simplex infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005517 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002508"/>
        <obo:IAO_0000115>This is an AE which is a type of hernia in which abdominal organs (typically the stomach) slip through the diaphragm into the middle compartment of the chest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hiatal_hernia</obo:IAO_0000119>
        <obo:OAE_0001849>先天性食管裂孔疝</obo:OAE_0001849>
        <obo:OAE_0004334>10010501</obo:OAE_0004334>
        <rdfs:label>congenital hiatus hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005518 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000761"/>
        <obo:IAO_0000115>This is an AE which is a condition in which an accumulation of cerebrospinal fluid (CSF) occurs within the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hydrocephalus</obo:IAO_0000119>
        <obo:OAE_0001849>先天性脑积水</obo:OAE_0001849>
        <obo:OAE_0004334>10010506</obo:OAE_0004334>
        <rdfs:label>congenital hydrocephalus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005519 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001042"/>
        <obo:IAO_0000115>This is an AE which defined as congenital dilatation of one or more components of the renal collecting system, is detected in 1-2% of all pregnancies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23052658/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肾盂积水</obo:OAE_0001849>
        <obo:OAE_0004334>10050975</obo:OAE_0004334>
        <rdfs:label>congenital hydronephrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005520 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001063"/>
        <obo:IAO_0000115>This is an AE which is thyroid hormone deficiency present at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_hypothyroidism</obo:IAO_0000119>
        <obo:OAE_0001849>先天性甲状腺功能减退</obo:OAE_0001849>
        <obo:OAE_0004334>10010510</obo:OAE_0004334>
        <rdfs:label>congenital hypothyroidism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005521 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001107"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of the structure of  jaw.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>先天性颌畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062336</obo:OAE_0004334>
        <rdfs:label>congenital jaw malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005522 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a widely used term for a congenital malformation, i.e. a congenital, physical anomaly such as joint and is recognizable at birth, and which is significant enough to be considered a problem.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>先天性关节畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062337</obo:OAE_0004334>
        <rdfs:label>congenital joint malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005523 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002719"/>
        <obo:IAO_0000115>This is an AE which is an indication for complete evaluation to establish the cause of the airway obstruction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23988376/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性喉喘鸣</obo:OAE_0001849>
        <obo:OAE_0004334>10010527</obo:OAE_0004334>
        <rdfs:label>congenital laryngeal stridor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005524 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001165"/>
        <obo:IAO_0000115>This is an AE which is a birth defect in which nerves are missing from parts of the intestine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hirschsprung%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>先天性巨结肠</obo:OAE_0001849>
        <obo:OAE_0004334>10010539</obo:OAE_0004334>
        <rdfs:label>congenital megacolon AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005525 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001188"/>
        <obo:IAO_0000115>This is an AE which is a relatively rare and highly complex cardiac disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29425524/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性二尖瓣关闭不全</obo:OAE_0001849>
        <obo:OAE_0004334>10010547</obo:OAE_0004334>
        <rdfs:label>congenital mitral valve incompetence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005526 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a complex, etiologically diverse, clinical descriptor identified in a variety of diagnoses characterized by multiple congenital joint contractures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32674167/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性多路关节弯曲</obo:OAE_0001849>
        <obo:OAE_0004334>10051643</obo:OAE_0004334>
        <rdfs:label>congenital multiplex arthrogryposis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005527 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of the structure of a body musculoskeletal part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肌肉骨骼异常</obo:OAE_0001849>
        <obo:OAE_0004334>10062344</obo:OAE_0004334>
        <rdfs:label>congenital musculoskeletal anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005528 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a type of melanocytic nevus (or mole) found in infants at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_melanocytic_nevus</obo:IAO_0000119>
        <obo:OAE_0001849>先天性痣</obo:OAE_0001849>
        <obo:OAE_0004334>10067248</obo:OAE_0004334>
        <rdfs:label>congenital naevus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005529 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which may be overt or subtle and can occasionally cause life-threatening emergencies at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17346563/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性鼻畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062347</obo:OAE_0004334>
        <rdfs:label>congenital nose malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005530 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition of the lung primarily at birth affecting the small air sacs known as alveoli .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10010594</obo:OAE_0004334>
        <rdfs:label>congenital pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005531 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which represent a diverse group of abnormalities, ranging from asymptomatic incidental findings to causes of sudden cardiac death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30102560/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肺动脉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10061074</obo:OAE_0004334>
        <rdfs:label>congenital pulmonary artery anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005532 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001343"/>
        <obo:IAO_0000115>This is an AE which is a condition of increased blood pressure within the arteries of the lungs at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肺动脉高压</obo:OAE_0001849>
        <obo:OAE_0004334>10050701</obo:OAE_0004334>
        <rdfs:label>congenital pulmonary hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005533 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003432"/>
        <obo:IAO_0000115>This is an AE which is often the result of congenital malformations and is observed in isolation or as part of a larger pathologic process, as in Tetralogy of Fallot, Noonan syndrome, and congenital rubella syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Valvular_heart_disease#Pulmonary_and_tricuspid_valve_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肺瓣膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10061075</obo:OAE_0004334>
        <rdfs:label>congenital pulmonary valve disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005534 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001349"/>
        <obo:IAO_0000115>This is an AE which is often the result of congenital malformations and is observed in isolation or as part of a larger pathologic process, as in Tetralogy of Fallot, Noonan syndrome, and congenital rubella syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Valvular_heart_disease#Pulmonary_and_tricuspid_valve_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肾盂扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10049938</obo:OAE_0004334>
        <rdfs:label>congenital pyelocaliectasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005535 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a condition present at birth regardless of its cause which occured on renal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肾疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10066875</obo:OAE_0004334>
        <rdfs:label>congenital renal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005536 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004381"/>
        <obo:IAO_0000115>This is an AE which  can occur in a developing fetus of a pregnant woman who has contracted rubella, usually in the first trimester.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_rubella_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>先天性风疹感染</obo:OAE_0001849>
        <obo:OAE_0004334>10010619</obo:OAE_0004334>
        <rdfs:label>congenital rubella infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005537 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is syphilis present in utero and at birth, and occurs when a child is born to a mother with syphilis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_syphilis</obo:IAO_0000119>
        <obo:OAE_0001849>先天性梅毒</obo:OAE_0001849>
        <obo:OAE_0004334>10010641</obo:OAE_0004334>
        <rdfs:label>congenital syphilis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005538 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a neoplasm containing tissues foreign to the site of origin or containing more than one embryonic germ cell layer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22902845/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性畸胎瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10052012</obo:OAE_0004334>
        <rdfs:label>congenital teratoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005539 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which can occurs spontaneous and excessive bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Platelet</obo:IAO_0000119>
        <obo:OAE_0001849>先天性血小板障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10058896</obo:OAE_0004334>
        <rdfs:label>congenital thrombocyte disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005540 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a genetically and clinically heterogeneous group of platelet disorders that are characterized by thrombocytopenia since birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29973458/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性血小板减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10077833</obo:OAE_0004334>
        <rdfs:label>congenital thrombocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005541 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a rare occurrence and associates with cleft palate may be considered as evidence of close interrelation of embryogenesis of the tongue and palate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24066710/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性舌头异常</obo:OAE_0001849>
        <obo:OAE_0004334>10061077</obo:OAE_0004334>
        <rdfs:label>congenital tongue anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005542 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is defined as a contracture or fibrosis of the Sternocleidomastoid muscle, on one side, leading to a homolateral inclination and contralateral rotation of the face and chin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31747185/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性斜颈</obo:OAE_0001849>
        <obo:OAE_0004334>10010650</obo:OAE_0004334>
        <rdfs:label>congenital torticollis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005543 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001471"/>
        <obo:IAO_0000115>This is an AE which is a type of congenital valvular heart disease in which the tricuspid valve of the heart, located between the right atrium and right ventricle, does not close completely when the right ventricle contracts (systole).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tricuspid_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>先天性三尖瓣不全</obo:OAE_0001849>
        <obo:OAE_0004334>10067887</obo:OAE_0004334>
        <rdfs:label>congenital tricuspid valve incompetence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005544 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a health condition where the abdominal wall behind the navel is congenital damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Umbilical_hernia</obo:IAO_0000119>
        <obo:OAE_0001849>先天性脐疝</obo:OAE_0001849>
        <obo:OAE_0004334>10010658</obo:OAE_0004334>
        <rdfs:label>congenital umbilical hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005545 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which might be associated with a detrimental effect on the probability of pregnancy achievement, spontaneous abortion and on the obstetric outcome of each pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25444500/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性子宫畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061079</obo:OAE_0004334>
        <rdfs:label>congenital uterine anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005546 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a congenital condition in which urine flows retrograde, or backward, from the bladder into one or both ureters and then to the renal calyx or kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vesicoureteral_reflux</obo:IAO_0000119>
        <obo:OAE_0001849>先天性膀胱输尿管回流</obo:OAE_0001849>
        <obo:OAE_0004334>10010672</obo:OAE_0004334>
        <rdfs:label>congenital vesicoureteric reflux AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005547 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a defect in the structure of the heart or great vessels that is present at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_heart_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性心脏病</obo:OAE_0001849>
        <obo:OAE_0004334>10019273</obo:OAE_0004334>
        <rdfs:label>heart disease congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005548 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002564"/>
        <obo:IAO_0000115>This is an AE which is small dilated blood vessels that can occur near the surface of the skin or mucous membranes, measuring between 0.5 and 1 millimeter in diameter and is  congenital.
.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Telangiectasia</obo:IAO_0000119>
        <obo:OAE_0001849>先天性毛细血管扩张症</obo:OAE_0001849>
        <obo:OAE_0004334>10061575</obo:OAE_0004334>
        <rdfs:label>telangiectasia congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005549 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is often associated with abnormal PA hemodynamics including increased pressure drop (Δp) and reduced asymmetric flow (Q), which may result in right ventricular dysfunction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30293825/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肺动脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10037339</obo:OAE_0004334>
        <rdfs:label>pulmonary artery stenosis congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005550 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001748"/>
        <obo:IAO_0000115>This is an AE which is a congenital heart valve disorder. Blood going from the heart to the lungs goes through the pulmonary valve, whose purpose is to prevent blood from flowing back to the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_valve_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>先天性肺动脉瓣狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10037451</obo:OAE_0004334>
        <rdfs:label>pulmonary valve stenosis congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005551 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is the arrangement of digits (fingers and toes) on the hands, feet, or sometimes wings of a tetrapod animal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dactyly</obo:IAO_0000119>
        <obo:OAE_0001849>先天性无指或无趾</obo:OAE_0001849>
        <obo:OAE_0004334>10049207</obo:OAE_0004334>
        <rdfs:label>adactyly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005552 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002357"/>
        <obo:IAO_0000115>This is an AE which is a congenital oral anomaly that may decrease the mobility of the tongue tip and is caused by an unusually short, thick lingual frenulum, a membrane connecting the underside of the tongue to the floor of the mouth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ankyloglossia</obo:IAO_0000119>
        <obo:OAE_0001849>先天性舌系带短缩</obo:OAE_0001849>
        <obo:OAE_0004334>10049244</obo:OAE_0004334>
        <rdfs:label>ankyloglossia congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005553 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000286"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder characterized by congenital absence of skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aplasia_cutis_congenita</obo:IAO_0000119>
        <obo:OAE_0001849>先天性表皮发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10002963</obo:OAE_0004334>
        <rdfs:label>aplasia cutis congenita AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005554 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>This is an AE which  refers to a lens opacity which is present at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_cataract</obo:IAO_0000119>
        <obo:OAE_0001849>先天性白内障</obo:OAE_0001849>
        <obo:OAE_0004334>10007747</obo:OAE_0004334>
        <rdfs:label>cataract congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005555 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which may occur both as a unilateral and as a bilateral form with a family disposition for dacryostenosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20645229/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性泪管狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10011850</obo:OAE_0004334>
        <rdfs:label>dacryostenosis congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005556 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an abnormal difference in body structure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysmorphic_feature</obo:IAO_0000119>
        <obo:OAE_0001849>先天性畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10066054</obo:OAE_0004334>
        <rdfs:label>dysmorphism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005557 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <obo:IAO_0000115>This is an AE which is a group of non-communicableepilepsy congenital disorders characterized by recurrent epileptic seizures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epilepsy</obo:IAO_0000119>
        <obo:OAE_0001849>癫痫先天性</obo:OAE_0001849>
        <obo:OAE_0004334>10015039</obo:OAE_0004334>
        <rdfs:label>epilepsy congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005558 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an abnormal difference in body structure and it can be related to a congenital disorder, genetic syndrome or birth defect.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysmorphic_feature</obo:IAO_0000119>
        <obo:OAE_0001849>面部先天性畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10016045</obo:OAE_0004334>
        <rdfs:label>facial dysmorphism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005559 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is the heart block that is diagnosed in fetus (in utero) or within the first 28 days after birth (neonatal period), some studies also include the diagnosis during early childhood to the definition of CHB.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_heart_block</obo:IAO_0000119>
        <obo:OAE_0001849>心传导阻滞先天性</obo:OAE_0001849>
        <obo:OAE_0004334>10019263</obo:OAE_0004334>
        <rdfs:label>heart block congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005560 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is the congenital abnormal exit of tissue or an organ, such as the bowel, through the wall of the cavity in which it normally resides.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hernia</obo:IAO_0000119>
        <obo:OAE_0001849>先天性疝</obo:OAE_0001849>
        <obo:OAE_0004334>10019912</obo:OAE_0004334>
        <rdfs:label>hernia congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005561 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002402"/>
        <obo:IAO_0000115>This is an AE which may refer to an eye diseases :Vitelliform macular dystrophy, an irregular autosomal dominant eye disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macular_dystrophy</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑营养不良先天性</obo:OAE_0001849>
        <obo:OAE_0004334>10025412</obo:OAE_0004334>
        <rdfs:label>macular dystrophy congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005562 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which as a pilonidal variety that is of no neurosurgical significance and a deep version with extension to the central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/1590721/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性藏毛囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10054019</obo:OAE_0004334>
        <rdfs:label>pilonidal cyst congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005563 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>This is an AE which the hair loss typically presents itself as either a receding front hairline, loss of hair on the crown (vertex) of the scalp, or a combination of both.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pattern_hair_loss</obo:IAO_0000119>
        <obo:OAE_0001849>雄性遗传脱发</obo:OAE_0001849>
        <obo:OAE_0004334>10068168</obo:OAE_0004334>
        <rdfs:label>androgenetic alopecia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005564 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <obo:IAO_0000115>This is an AE which is a disorder that results in recurrent attacks of severe swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hereditary_angioedema</obo:IAO_0000119>
        <obo:OAE_0001849>遗传性血管性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10019860</obo:OAE_0004334>
        <rdfs:label>hereditary angiedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005565 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a health problem caused by one or more abnormalities in the genome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Genetic_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>遗传性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061205</obo:OAE_0004334>
        <rdfs:label>hereditary disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005566 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder characterized by excessive intestinal absorption of dietary iron, resulting in a pathological increase in total body iron stores.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hereditary_haemochromatosis</obo:IAO_0000119>
        <obo:OAE_0001849>遗传性血色素沉着症</obo:OAE_0001849>
        <obo:OAE_0004334>10057873</obo:OAE_0004334>
        <rdfs:label>hereditary haemochromatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005567 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of red blood cells, or erythrocytes and is a chronic disease with no cure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hereditary_spherocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>遗传性球形红细胞症</obo:OAE_0001849>
        <obo:OAE_0004334>10019904</obo:OAE_0004334>
        <rdfs:label>hereditary spherocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005568 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which  is a set of rare brain disorders where the whole or parts of the surface of the brain appear smooth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lissencephaly</obo:IAO_0000119>
        <obo:OAE_0001849>无脑回</obo:OAE_0001849>
        <obo:OAE_0004334>10048911</obo:OAE_0004334>
        <rdfs:label>lissencephaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005569 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is the absence of a major portion of the brain, skull, and scalp that occurs during embryonic development.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anencephaly</obo:IAO_0000119>
        <obo:OAE_0001849>先天无脑畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10002320</obo:OAE_0004334>
        <rdfs:label>anencephaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005570 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a common feature of many of the diseases that affect the brain and is congenital.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebral_atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>先天性脑萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10052236</obo:OAE_0004334>
        <rdfs:label>cerebral atrophy congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005571 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which forms a large class of genetic diseases involving congenital disorders of enzyme activities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inborn_errors_of_metabolism</obo:IAO_0000119>
        <obo:OAE_0001849>先天代谢错误</obo:OAE_0001849>
        <obo:OAE_0004334>10062018</obo:OAE_0004334>
        <rdfs:label>inborn error of metabolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005572 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000479"/>
        <obo:IAO_0000115>This is an AE which is the most common type of migraine, has great impacts on quality of life for migraineurs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30007828/</obo:IAO_0000119>
        <obo:OAE_0001849>先兆型偏头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10052787</obo:OAE_0004334>
        <rdfs:label>migraine without aura AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005573 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a disorder of pregnancy characterized by the onset of high blood pressure and often a significant amount of protein in the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pre-eclampsia</obo:IAO_0000119>
        <obo:OAE_0001849>先兆子痫</obo:OAE_0001849>
        <obo:OAE_0004334>10036485</obo:OAE_0004334>
        <rdfs:label>pre-eclampsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005574 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder that results in the destruction of nerve cells in the brain and spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tay%E2%80%93Sachs_disease</obo:IAO_0000119>
        <obo:OAE_0001849>黑蒙性先天白痴</obo:OAE_0001849>
        <obo:OAE_0004334>10061888</obo:OAE_0004334>
        <rdfs:label>amaurotic familial idiocy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005575 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a severe, complex malformation of monozygotic twinning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22002952/</obo:IAO_0000119>
        <obo:OAE_0001849>无心畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10075721</obo:OAE_0004334>
        <rdfs:label>acardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005576 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is the slowness of thought common to many disorders of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bradyphrenia</obo:IAO_0000119>
        <obo:OAE_0001849>智力迟钝</obo:OAE_0001849>
        <obo:OAE_0004334>10050012</obo:OAE_0004334>
        <rdfs:label>bradyphrenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005577 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is a generalized neurodevelopmental disorder characterized by significantly impaired intellectual and adaptive functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intellectual_disability</obo:IAO_0000119>
        <obo:OAE_0001849>智力疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10067989</obo:OAE_0004334>
        <rdfs:label>intellectual disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005578 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which occurs when an organism is exceptionally small.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dwarfism</obo:IAO_0000119>
        <obo:OAE_0001849>侏儒症</obo:OAE_0001849>
        <obo:OAE_0004334>10013883</obo:OAE_0004334>
        <rdfs:label>dwarfism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005579 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is a neurodegenerative disease that results in the progressive loss of motor neurons that control voluntary muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amyotrophic_lateral_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>家族性肌萎缩侧索硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10077024</obo:OAE_0004334>
        <rdfs:label>familial amyotrophic lateral sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005580 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a hereditary inflammatory disorder and is an autoinflammatory disease caused by mutations in Mediterranean fever gene, which encodes a 781 amino acid protein called pyrin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Familial_Mediterranean_fever</obo:IAO_0000119>
        <obo:OAE_0001849>家族性地中海热</obo:OAE_0001849>
        <obo:OAE_0004334>10016207</obo:OAE_0004334>
        <rdfs:label>familial mediterranean fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005581 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a group of rare genetic diseases that lead to weakness or paralysis from common triggers such as cold, heat, high carbohydrate meals, not eating, stress or excitement and physical activity of any kind.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periodic_paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>家族性周期性麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10016208</obo:OAE_0004334>
        <rdfs:label>familial periodic paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005582 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by involuntary rhythmic contractions and relaxations (oscillations or twitching movements) of certain muscle groups in one or more body parts of unknown cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Essential_tremor</obo:IAO_0000119>
        <obo:OAE_0001849>家族性震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10016212</obo:OAE_0004334>
        <rdfs:label>familial tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005583 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002402"/>
        <obo:IAO_0000115>This is an AE which is an uncommon form of Alzheimer&apos;s disease that usually strikes earlier in life, defined as before the age of 65 (usually between 30 and 60 years of age) and is inherited in an autosomal dominant fashion, identified by genetics and other characteristics such as the age of onset.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Early-onset_Alzheimer%27s_disease#Familial_Alzheimer&apos;s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>早发性家族性阿尔茨海默病</obo:OAE_0001849>
        <obo:OAE_0004334>10078036</obo:OAE_0004334>
        <rdfs:label>early onset familial alzheimer&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005584 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is an alteration in the nucleotide sequence of the genome of an organism, virus, or extrachromosomal DNA.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mutation</obo:IAO_0000119>
        <obo:OAE_0001849>基因突变</obo:OAE_0001849>
        <obo:OAE_0004334>10064571</obo:OAE_0004334>
        <rdfs:label>gene mutation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005585 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is the process of determining the nucleic acid sequence – the order of nucleotides in DNA.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/DNA_sequencing</obo:IAO_0000119>
        <obo:OAE_0001849>基因测序</obo:OAE_0001849>
        <obo:OAE_0004334>10069604</obo:OAE_0004334>
        <rdfs:label>gene sequencing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005586 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is caused by errors in fatty acid metabolism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inborn_error_of_lipid_metabolism</obo:IAO_0000119>
        <obo:OAE_0001849>先天脂质代谢错误</obo:OAE_0001849>
        <obo:OAE_0004334>10072272</obo:OAE_0004334>
        <rdfs:label>inborn error of lipid metabolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005587 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is inherited blood disorders characterized by decreased hemoglobin production.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thalassemia</obo:IAO_0000119>
        <obo:OAE_0001849>地中海贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10043388</obo:OAE_0004334>
        <rdfs:label>thalassaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005588 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is the inflammation, with effusion, of different serous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29761620/</obo:IAO_0000119>
        <obo:OAE_0001849>多浆膜炎</obo:OAE_0001849>
