    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006390 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001392"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>副鼻窦分泌不足</obo:OAE_0001849>
        <obo:OAE_0004334>10080046</obo:OAE_0004334>
        <rdfs:label>paranasal sinus hyposecretion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006391 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001021"/>
        <obo:IAO_0000115>This is an AE which  comprises lightening/greying, darkening, or even a complete hair colour change, which may involve the scalp and/or all body hair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27545142/</obo:IAO_0000119>
        <obo:OAE_0001849>头发颜色变化</obo:OAE_0001849>
        <obo:OAE_0004334>10019030</obo:OAE_0004334>
        <rdfs:label>hair color changes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006392 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which is  disorders primarily associated with the follicles of the hair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hair_disease</obo:IAO_0000119>
        <obo:OAE_0001849>头发疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10019037</obo:OAE_0004334>
        <rdfs:label>hair disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006393 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which can appear as firm, dome-shaped cutaneous or subcutaneous masses with alopecia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7155888/</obo:IAO_0000119>
        <obo:OAE_0001849>良性毛囊肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10019043</obo:OAE_0004334>
        <rdfs:label>hair follicle tumor benign AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006394 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which is damage to the hair caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>头发损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10074924</obo:OAE_0004334>
        <rdfs:label>hair injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006395 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which is an uncommon hematological malignancy characterized by an accumulation of abnormal B lymphocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hairy_cell_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>毛细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10019053</obo:OAE_0004334>
        <rdfs:label>hairy cell leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006396 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001021"/>
        <obo:IAO_0000115>This is an AE which is a condition where a hair curls back or grows sideways into the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ingrown_hair</obo:IAO_0000119>
        <obo:OAE_0001849>向内生毛</obo:OAE_0001849>
        <obo:OAE_0004334>10052899</obo:OAE_0004334>
        <rdfs:label>ingrown hair AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006397 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a condition of the tongue in which the small bumps on the tongue elongate with black or brown discoloration, giving a black and hairy appearance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Black_hairy_tongue</obo:IAO_0000119>
        <obo:OAE_0001849>黑毛舌</obo:OAE_0001849>
        <obo:OAE_0004334>10043941</obo:OAE_0004334>
        <rdfs:label>tongue black hairy(black hairy tongue) AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006398 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002402"/>
        <obo:IAO_0000115>This is an AE which is a common, autosomal-dominant, genetic condition of the skin&apos;s hair follicles characterized by the appearance of possibly itchy, small, gooseflesh-like bumps, with varying degrees of reddening or inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratosis_pilaris</obo:IAO_0000119>
        <obo:OAE_0001849>毛发角化病</obo:OAE_0001849>
        <obo:OAE_0004334>10066295</obo:OAE_0004334>
        <rdfs:label>keratosis pilaris AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006399 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is an abnormal descent of the brow from its anatomical position to the point that a patient becomes uncomfortable with the brow&apos;s appearance or visual field deficits develop.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32809597/</obo:IAO_0000119>
        <obo:OAE_0001849>额头上睑下垂，眉毛下垂</obo:OAE_0001849>
        <obo:OAE_0004334>10059001</obo:OAE_0004334>
        <rdfs:label>brow ptosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is an acute headache of short duration brought on by some forms of activity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27409752/</obo:IAO_0000119>
        <obo:OAE_0001849>劳累型头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10068614</obo:OAE_0004334>
        <rdfs:label>exertional headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006401 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is a form of brief pain or headache commonly associated with consumption (particularly quick consumption) of cold beverages or foods such as ice cream, Popsicles, and snow cones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cold-stimulus_headache</obo:IAO_0000119>
        <obo:OAE_0001849>冷刺激性头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10071151</obo:OAE_0004334>
        <rdfs:label>cold-stimulus headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006402 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <obo:IAO_0000115>This is an AE which is an imprecise term that can refer to a sense of disorientation in space, vertigo, or lightheadedness .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dizziness</obo:IAO_0000119>
        <obo:OAE_0001849>体位性头晕</obo:OAE_0001849>
        <obo:OAE_0004334>10013578</obo:OAE_0004334>
        <rdfs:label>dizziness postural AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006403 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is a primary headache syndrome which can mimic chronic migraine and chronic tension-type headache.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/New_daily_persistent_headache</obo:IAO_0000119>
        <obo:OAE_0001849>新的每日持续性头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10076678</obo:OAE_0004334>
        <rdfs:label>new daily persistent headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006404 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a cluster of boils caused by bacterial infection, most commonly with Staphylococcus aureus or Streptococcus pyogenes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Carbuncle</obo:IAO_0000119>
        <obo:OAE_0001849>痈</obo:OAE_0001849>
        <obo:OAE_0004334>10007247</obo:OAE_0004334>
        <rdfs:label>carbuncle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006405 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory, primary cicatricial alopecia with several different patterns of hair loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29262050/</obo:IAO_0000119>
        <obo:OAE_0001849>毛发扁平苔癣</obo:OAE_0001849>
        <obo:OAE_0004334>10081142</obo:OAE_0004334>
        <rdfs:label>lichen planopilaris AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006406 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder characterized by a long-term urge that results in the pulling out of one&apos;s own hair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trichotillomania</obo:IAO_0000119>
        <obo:OAE_0001849>拔毛癖</obo:OAE_0001849>
        <obo:OAE_0004334>10044629</obo:OAE_0004334>
        <rdfs:label>trichotillomania AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006407 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which includes trichorrhexis invaginata and trichorrhexis nodosa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trichorrhexis</obo:IAO_0000119>
        <obo:OAE_0001849>掉毛</obo:OAE_0001849>
        <obo:OAE_0004334>10044625</obo:OAE_0004334>
        <rdfs:label>trichorrhexis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006408 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which can be an early sign of skin aging and are a significant cosmetic concern.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25647394/</obo:IAO_0000119>
        <obo:OAE_0001849>扩张毛孔</obo:OAE_0001849>
        <obo:OAE_0004334>10076249</obo:OAE_0004334>
        <rdfs:label>dilated pores AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006409 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a parasitic disease caused by Giardia duodenalis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Giardiasis</obo:IAO_0000119>
        <obo:OAE_0001849>梨形鞭毛虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10018262</obo:OAE_0004334>
        <rdfs:label>giardiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006410 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004270"/>
        <obo:IAO_0000115>This is an AE which is the bumps on a person&apos;s skin at the base of body hairs which may involuntarily develop when a person is tickled, cold or experiencing strong emotions such as fear, euphoria or sexual arousal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Goose_bumps</obo:IAO_0000119>
        <obo:OAE_0001849>立毛</obo:OAE_0001849>
        <obo:OAE_0004334>10035039</obo:OAE_0004334>
        <rdfs:label>piloerection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006411 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000953"/>
        <obo:IAO_0000115>This is an AE which is the infection and inflammation of one or more hair follicles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Folliculitis</obo:IAO_0000119>
        <obo:OAE_0001849>毛囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10016936</obo:OAE_0004334>
        <rdfs:label>folliculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006412 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>This is an AE which is a medical condition involving the loss of all body hair, including eyebrows, eyelashes, chest hair, armpit hair, and pubic hair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alopecia_universalis</obo:IAO_0000119>
        <obo:OAE_0001849>普秃</obo:OAE_0001849>
        <obo:OAE_0004334>10001767</obo:OAE_0004334>
        <rdfs:label>alopecia universalis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006413 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <obo:IAO_0000115>This is an AE which is a condition of abnormal hair patterns, predominantly loss or reduction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hair_loss#Hypotrichosis</obo:IAO_0000119>
        <obo:OAE_0001849>少毛症</obo:OAE_0001849>
        <obo:OAE_0004334>10021126</obo:OAE_0004334>
        <rdfs:label>hypotrichosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006414 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000953"/>
        <obo:IAO_0000115>This is an AE which is a persistent irritation caused by shaving.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pseudofolliculitis_barbae</obo:IAO_0000119>
        <obo:OAE_0001849>须须假毛囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037120</obo:OAE_0004334>
        <rdfs:label>pseudofolliculitis barbae AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006415 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>This is an AE which is a clinical entity with a diversified aetiology, that allows to distinguish from circumscribed or cicatricial alopecia or male baldness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/8048976/</obo:IAO_0000119>
        <obo:OAE_0001849>弥散性脱发</obo:OAE_0001849>
        <obo:OAE_0004334>10073736</obo:OAE_0004334>
        <rdfs:label>diffuse alopecia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006416 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>This is an AE which refers to a loss of hair from part of the head or body with effluvium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hair_loss</obo:IAO_0000119>
        <obo:OAE_0001849>恶臭性脱发</obo:OAE_0001849>
        <obo:OAE_0004334>10001762</obo:OAE_0004334>
        <rdfs:label>alopecia effluvium AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006417 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004528"/>
        <obo:IAO_0000115>This is an AE which has been largely considered a neurological catastrophe. With conventional treatment, only around 20% of patients achieve functional independence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21129593/</obo:IAO_0000119>
        <obo:OAE_0001849>基底动脉血栓形成</obo:OAE_0001849>
        <obo:OAE_0004334>10063093</obo:OAE_0004334>
        <rdfs:label>basilar artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006418 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>This is an AE which include neuromuscular irritability, tetany, and seizures, which are rapidly resolved with intravenous administration of calcium gluconate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30449546/</obo:IAO_0000119>
        <obo:OAE_0001849>低钙血症癫痫</obo:OAE_0001849>
        <obo:OAE_0004334>10072456</obo:OAE_0004334>
        <rdfs:label>hypocalcaemic seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006419 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a  decrease in the total amount of neurogenic red blood cells (RBCs) or hemoglobin in the blood or a lowered ability of the blood to carry oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anemia</obo:IAO_0000119>
        <obo:OAE_0001849>肾原性的贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10058116</obo:OAE_0004334>
        <rdfs:label>nephrogenic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006420 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001207"/>
        <obo:IAO_0000115>This is an AE which is a cancer of plasma cells, a type of white blood cell that normally produces antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_myeloma</obo:IAO_0000119>
        <obo:OAE_0001849>骨髓瘤复发</obo:OAE_0001849>
        <obo:OAE_0004334>10051381</obo:OAE_0004334>
        <rdfs:label>myeloma recurrence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006421 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a global health concern affecting children, women and the elderly, whilst also being a common comorbidity in multiple medical conditions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31665543/</obo:IAO_0000119>
        <obo:OAE_0001849>缺乏性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10061101</obo:OAE_0004334>
        <rdfs:label>deficiency anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006422 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a group of blood disorders typically inherited from a person&apos;s parents.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sickle_cell_disease</obo:IAO_0000119>
        <obo:OAE_0001849>镰状细胞性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10040641</obo:OAE_0004334>
        <rdfs:label>sickle cell anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006423 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a group of rare blood cancers in which excess red blood cells, white blood cells or platelets are produced in the bone marrow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myeloproliferative_neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>骨髓增生障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10028576</obo:OAE_0004334>
        <rdfs:label>myeloproliferative disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006424 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by haemophilus that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜血杆菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058875</obo:OAE_0004334>
        <rdfs:label>haemophilus sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006425 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002331"/>
        <obo:IAO_0000115>This is an AE which is a process with hyperchloraemic causing increased acidity in the blood and other body tissues .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acidosis</obo:IAO_0000119>
        <obo:OAE_0001849>酸中毒高氯血症</obo:OAE_0001849>
        <obo:OAE_0004334>10000489</obo:OAE_0004334>
        <rdfs:label>acidosis hyperchloraemic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006426 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is an acquired autoimmune disorder resulting in the production of antibodies directed against red blood cell antigens causing shortened erythrocyte survival.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28189175/</obo:IAO_0000119>
        <obo:OAE_0001849>温热型溶血性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10047822</obo:OAE_0004334>
        <rdfs:label>warm type hemolytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006427 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006427">
