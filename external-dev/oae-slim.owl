        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the body caused by an external force and occurs on iiird nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>iiird神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10021281</obo:OAE_0004334>
        <rdfs:label>iiird nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004785 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a loss of motor function in one or more muscles and occurs on IIIrd nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>iiird神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10021283</obo:OAE_0004334>
        <rdfs:label>iiird nerve paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004786 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000205"/>
        <obo:IAO_0000115>This is an AE which is a condition typified by a weakness of voluntary movement, or by partial loss of voluntary movement or by impaired movement and occurs on IIIrd nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresis</obo:IAO_0000119>
        <obo:OAE_0001849>iiird神经麻痹性痴呆</obo:OAE_0001849>
        <obo:OAE_0004334>10054202</obo:OAE_0004334>
        <rdfs:label>iiird nerve paresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004787 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002713"/>
        <obo:IAO_0000115>This is an AE which is association with other neurological deficits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16705532/</obo:IAO_0000119>
        <obo:OAE_0001849>ivth神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10023110</obo:OAE_0004334>
        <rdfs:label>ivth nerve paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004788 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a lesion which affects nerve fibers traveling from the lower motor neuron(s) in the anterior horn/anterior grey column of the spinal cord, or in the motor nuclei of the cranial nerves, to the relevant muscle(s).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lower_motor_neuron_lesion</obo:IAO_0000119>
        <obo:OAE_0001849>下运动神经元损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10024962</obo:OAE_0004334>
        <rdfs:label>lower motor neurone lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004789 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000514"/>
        <obo:IAO_0000115>This is an AE which is pain going down the leg from the lower back.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sciatica</obo:IAO_0000119>
        <obo:OAE_0001849>腰椎神经根病</obo:OAE_0001849>
        <obo:OAE_0004334>10050219</obo:OAE_0004334>
        <rdfs:label>lumbar radiculopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004790 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002639"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the network of nerves in the lumbosacral plexus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plexopathy</obo:IAO_0000119>
        <obo:OAE_0001849>腰荐神经丛病变</obo:OAE_0001849>
        <obo:OAE_0004334>10075478</obo:OAE_0004334>
        <rdfs:label>lumbosacral plexopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004791 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002387"/>
        <obo:IAO_0000115>This is an AE which refers injuries to the lumbosacral plexus are predominantly witnessed as bone injuries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lumbosacral_plexus</obo:IAO_0000119>
        <obo:OAE_0001849>腰骶神经丛损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10025015</obo:OAE_0004334>
        <rdfs:label>lumbosacral plexus injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004792 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which depends on what portion of the plexus gets involved in the disease process.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25299286/</obo:IAO_0000119>
        <obo:OAE_0001849>腰骶神经丛病变</obo:OAE_0001849>
        <obo:OAE_0004334>10025016</obo:OAE_0004334>
        <rdfs:label>lumbosacral plexus lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004793 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000514"/>
        <obo:IAO_0000115>This is an AE which is pain going down the leg from the lower back.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sciatica</obo:IAO_0000119>
        <obo:OAE_0001849>腰骶神经根病</obo:OAE_0001849>
        <obo:OAE_0004334>10076578</obo:OAE_0004334>
        <rdfs:label>lumbosacral radiculopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004794 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a nerve in humans and other animals in the upper limb and  is injuried of median nerve at different levels causes different syndromes with varying motor and sensory deficits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Median_nerve#Injury</obo:IAO_0000119>
        <obo:OAE_0001849>正中神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10027067</obo:OAE_0004334>
        <rdfs:label>median nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004795 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001214"/>
        <obo:IAO_0000115>This is an AE which is a common type of primary brain cancer in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Medulloblastoma</obo:IAO_0000119>
        <obo:OAE_0001849>成神经管细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10027107</obo:OAE_0004334>
        <rdfs:label>medulloblastoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004796 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002754"/>
        <obo:IAO_0000115>This is an AE which is a neurologic symptoms of neuroborreliosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuroborreliosis</obo:IAO_0000119>
        <obo:OAE_0001849>脑膜神经根炎</obo:OAE_0001849>
        <obo:OAE_0004334>10050169</obo:OAE_0004334>
        <rdfs:label>meningoradiculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004797 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000170"/>
        <obo:IAO_0000115>This is an AE which is a general term describing disease affecting the peripheral nerves, meaning nerves beyond the brain and spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peripheral_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>单神经病多路复用</obo:OAE_0001849>
        <obo:OAE_0004334>10027918</obo:OAE_0004334>
        <rdfs:label>mononeuropathy multiplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004798 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001214"/>
        <obo:IAO_0000115>This is an AE which is a benign neuroma of an intermetatarsal plantar nerve, most commonly of the second and third intermetatarsal spaces (between the second/third and third/fourth metatarsal heads; the first is of the big toe), which results in the entrapment of the affected nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Morton%27s_neuroma</obo:IAO_0000119>
        <obo:OAE_0001849>神经瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10049691</obo:OAE_0004334>
        <rdfs:label>morton&apos;s neuroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004799 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the ventricles in the  cns brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ventriculitis</obo:IAO_0000119>
        <obo:OAE_0001849>中枢神经系统脑室炎</obo:OAE_0001849>
        <obo:OAE_0004334>10009719</obo:OAE_0004334>
        <rdfs:label>cns ventriculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004800 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004800">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is to act in a way that is likely to elicit attention, usually to elicit validation from others.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Attention_seeking</obo:IAO_0000119>
        <obo:OAE_0001849>寻求注意行为</obo:OAE_0001849>
        <obo:OAE_0004334>10003739</obo:OAE_0004334>
        <rdfs:label>attention-seeking behaviour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004801 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which refers to a set of brief unconscious behaviors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Automatism_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>无意识行为</obo:OAE_0001849>
        <obo:OAE_0004334>10003830</obo:OAE_0004334>
        <rdfs:label>automatism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004802 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004802">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <obo:IAO_0000115>This is an AE which repetitive unconscious gestures, such as lip smacking, in certain types of epilepsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Automatism</obo:IAO_0000119>
        <obo:OAE_0001849>无意识癫痫行为</obo:OAE_0001849>
        <obo:OAE_0004334>10003831</obo:OAE_0004334>
        <rdfs:label>automatism epileptic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004803 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is romantic attraction, sexual attraction or sexual behavior between persons of the opposite sex or gender.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heterosexuality</obo:IAO_0000119>
        <obo:OAE_0001849>异性恋</obo:OAE_0001849>
        <obo:OAE_0004334>10061108</obo:OAE_0004334>
        <rdfs:label>heterosexuality AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004804 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004804">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is the description of the activity that will increase the probability that a person engaging in sexual activity with another person infected with a sexually transmitted infection will be infected or become pregnant, or make a partner pregnant.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Risky_sexual_behavior</obo:IAO_0000119>
        <obo:OAE_0001849>高危性行为</obo:OAE_0001849>
        <obo:OAE_0004334>10020082</obo:OAE_0004334>
        <rdfs:label>high risk sexual behaviour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004805 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is a tendency to act on a whim, displaying behavior characterized by little or no forethought, reflection, or consideration of the consequences.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Impulsivity</obo:IAO_0000119>
        <obo:OAE_0001849>冲动行为</obo:OAE_0001849>
        <obo:OAE_0004334>10021567</obo:OAE_0004334>
        <rdfs:label>impulsive behaviour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004806 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a sleep disorder in which people act out their dreams.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rapid_eye_movement_sleep_behavior_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>快速眼动睡眠行为障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077299</obo:OAE_0004334>
        <rdfs:label>rapid eye movement sleep behaviour disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004807 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000043"/>
        <obo:IAO_0000115>This is an AE which significantly interferes with social engagement and characterises various psychopathologies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32633192/</obo:IAO_0000119>
        <obo:OAE_0001849>社交回避行为</obo:OAE_0001849>
        <obo:OAE_0004334>10041243</obo:OAE_0004334>
        <rdfs:label>social avoidant behaviour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004808 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the myelin sheath, which is a primary actor in the central nervous system and it also has herpes zoster.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meningococcal_myelitis</obo:IAO_0000119>
        <obo:OAE_0001849>带状疱疹脊髓脊膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074251</obo:OAE_0004334>
        <rdfs:label>herpes zoster meningomyelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004809 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a generic term referring to a disorder in which a cyst or cavity forms within the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Syringomyelia</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓积水</obo:OAE_0001849>
        <obo:OAE_0004334>10020523</obo:OAE_0004334>
        <rdfs:label>hydromyelia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004810 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004374"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease occured post vaccine transmitted by fecal-oral contamination with lymphatic replication .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32644370/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓灰质炎疫苗后</obo:OAE_0001849>
        <obo:OAE_0004334>10057226</obo:OAE_0004334>
        <rdfs:label>poliomyelitis post vaccine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004811 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a group of latent symptoms of poliomyelitis (polio), occurring at about a 25–40% rate (latest data greater than 80%).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Post-polio_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓灰质炎后综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10036239</obo:OAE_0004334>
        <rdfs:label>post polio syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004812 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a common disease that most primary care doctors encounter .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29605415/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061367</obo:OAE_0004334>
        <rdfs:label>spinal cord disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004813 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels on spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓出血</obo:OAE_0001849>
        <obo:OAE_0004334>10048992</obo:OAE_0004334>
        <rdfs:label>spinal cord hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004814 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004814">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is rarely caused by vertebral artery dissection (VAD), which is an important cause of posterior circulation stroke in young and middle-aged patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31830940/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10058571</obo:OAE_0004334>
        <rdfs:label>spinal cord infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004815 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is spinal cord tissue death (necrosis) due to inadequate blood supply to the affected area.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infarction</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓感染</obo:OAE_0001849>
        <obo:OAE_0004334>10049654</obo:OAE_0004334>
        <rdfs:label>spinal cord infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004816 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the spinal cord that causes temporary or permanent changes in its function.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_cord_injury?wprov=srpw1_0</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10041552</obo:OAE_0004334>
        <rdfs:label>spinal cord injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004817 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the cervical spinal cord that causes temporary or permanent changes in its function.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_cord_injury?wprov=srpw1_0</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓损伤颈椎</obo:OAE_0001849>
        <obo:OAE_0004334>10041553</obo:OAE_0004334>
        <rdfs:label>spinal cord injury cervical AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004818 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the lumbar spinal cord that causes temporary or permanent changes in its function.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_cord_injury?wprov=srpw1_0</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓损伤腰椎</obo:OAE_0001849>
        <obo:OAE_0004334>10041555</obo:OAE_0004334>
        <rdfs:label>spinal cord injury lumbar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004819 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor made of fat tissue on the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lipoma</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓脂肪瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10064898</obo:OAE_0004334>
        <rdfs:label>spinal cord lipoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004820 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the spinal cord tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10063036</obo:OAE_0004334>
        <rdfs:label>spinal cord edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004821 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a loss of motor function in one or more spinal cord muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10057268</obo:OAE_0004334>
        <rdfs:label>spinal cord paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004822 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>This is an AE which is a non-surgical procedure intended to relieve pressure on the spinal cord or on one or more compressed nerve roots passing through or exiting the spinal column.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_decompression</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱减压</obo:OAE_0001849>
        <obo:OAE_0004334>10041563</obo:OAE_0004334>
        <rdfs:label>spinal decompression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004823 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002732"/>
        <obo:IAO_0000115>This is an AE which refers to a condition impairing the backbone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_disease</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10058907</obo:OAE_0004334>
        <rdfs:label>spinal deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004824 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which refers to a condition impairing the backbone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_disease</obo:IAO_0000119>
        <obo:OAE_0001849>脊椎病</obo:OAE_0001849>
        <obo:OAE_0004334>10061368</obo:OAE_0004334>
        <rdfs:label>spinal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004825 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a rare condition that usually presents with acute, severe pain at the location of the hemorrhage, with radiation to the extremities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20675642/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓硬膜外血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10050162</obo:OAE_0004334>
        <rdfs:label>spinal epidural hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004827 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004827">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000585"/>
        <obo:IAO_0000115>This is an AE which is a rare neuromuscular disorder that results in the loss of motor neurons and progressive muscle wasting.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_muscular_atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓性肌萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10041582</obo:OAE_0004334>
        <rdfs:label>spinal muscular atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004829 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which was first explored by Whytt in 1750 as a loss of sensation accompanied by motor paralysis with initial loss but gradual recovery of reflexes, following a spinal cord injury (SCI) – most often a complete transection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_shock</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓休克</obo:OAE_0001849>
        <obo:OAE_0004334>10049679</obo:OAE_0004334>
        <rdfs:label>spinal shock AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004830 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a generic term referring to a disorder in which a cyst or cavity forms within the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Syringomyelia</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓空洞症</obo:OAE_0001849>
        <obo:OAE_0004334>10042928</obo:OAE_0004334>
        <rdfs:label>syringomyelia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004831 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000478"/>
        <obo:IAO_0000115>This is an AE which is inflammation caused by the viral of the spinal cord which can disrupt the normal responses from the brain to the rest of the body, and from the rest of the body to the brain. Inflammation in the spinal cord, can cause the myelin and axon to be damaged resulting in symptoms such as paralysis and sensory loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myelitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性脊髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10071763</obo:OAE_0004334>
        <rdfs:label>viral myelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004832 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000478"/>
        <obo:IAO_0000115>This is an AE which is a serious condition of the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_flaccid_myelitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性弛缓性脊髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10082097</obo:OAE_0004334>
        <rdfs:label>acute flaccid myelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004833 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is a neurodegenerative disease[a] that results in the progressive loss of motor neurons that control voluntary muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amyotrophic_lateral_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>肌萎缩性脊髓侧索硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10002026</obo:OAE_0004334>
        <rdfs:label>amyotrophic lateral sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004834 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a mass of cells (tumor) that lacks the ability to either invade neighboring tissue or metastasize (spread throughout the body) such as benign tumor of spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓良性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10004406</obo:OAE_0004334>
        <rdfs:label>benign neoplasm of spinal cord AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004835 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is caused by damage to one half of the spinal cord, i.e. hemisection of the spinal cord resulting in paralysis and loss of proprioception on the same (or ipsilateral) side as the injury or lesion, and loss of pain and temperature sensation on the opposite (or contralateral) side as the lesion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Brown-S%C3%A9quard_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓半侧横断综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10006491</obo:OAE_0004334>
        <rdfs:label>brown-sequard syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004836 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the most common form of cervical spinal cord injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Central_cord_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>中枢脊髓综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10054839</obo:OAE_0004334>
        <rdfs:label>central cord syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004837 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004257"/>
        <obo:IAO_0000115>This is an AE which describes any neurologic deficit related to the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myelopathy</obo:IAO_0000119>
        <obo:OAE_0001849>颈锥脊髓病</obo:OAE_0001849>
        <obo:OAE_0004334>10008289</obo:OAE_0004334>
        <rdfs:label>cervical myelopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004838 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000444"/>
        <obo:IAO_0000115>This is an AE which is a term used to describe a constellation of early-appearing social communication deficits and repetitive sensory-motor behaviours associated with a strong genetic component as well as other causes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30078460/</obo:IAO_0000119>
        <obo:OAE_0001849>自闭症谱系障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10063844</obo:OAE_0004334>
        <rdfs:label>autism spectrum disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004839 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which is a condition which persists for more than 6 weeks in duration and occurs in the absence of an identifiable provoking factor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30984191/</obo:IAO_0000119>
        <obo:OAE_0001849>自发慢性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10072757</obo:OAE_0004334>
        <rdfs:label>chronic spontaneous urticaria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004840 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004840">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is the experience in which an individual perceives the surrounding environment from a different perspective, from a position outside of their own body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoscopy</obo:IAO_0000119>
        <obo:OAE_0001849>自窥症；自见幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10074080</obo:OAE_0004334>
        <rdfs:label>autoscopy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004841 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>This is an AE which refers loss of the ability to read due to cerebral disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alexia</obo:IAO_0000119>
        <obo:OAE_0001849>失读症</obo:OAE_0001849>
        <obo:OAE_0004334>10001663</obo:OAE_0004334>
        <rdfs:label>alexia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004842 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>This is an AE which is the inability to process sensory information.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Agnosia</obo:IAO_0000119>
        <obo:OAE_0001849>失认症</obo:OAE_0001849>
        <obo:OAE_0004334>10048663</obo:OAE_0004334>
        <rdfs:label>agnosia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004843 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>This is an AE which is an acquired neurological disorder causing a loss in the ability to communicate through writing, either due to some form of motor dysfunction or an inability to spell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Agraphia</obo:IAO_0000119>
        <obo:OAE_0001849>失写症</obo:OAE_0001849>
        <obo:OAE_0004334>10001508</obo:OAE_0004334>
        <rdfs:label>agraphia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004844 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a deficit in memory caused by brain damage or disease, but it can also be caused temporarily by the use of various sedatives and hypnotic drugs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amnesia</obo:IAO_0000119>
        <obo:OAE_0001849>失忆症</obo:OAE_0001849>
        <obo:OAE_0004334>10061423</obo:OAE_0004334>
        <rdfs:label>amnestic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004845 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mood disorder characterized by periods of depression and periods of abnormally-elevated mood that last from days to weeks each.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bipolar_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>双相情感障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10057667</obo:OAE_0004334>
        <rdfs:label>bipolar disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004846 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a bipolar spectrum disorder characterized by at least one episode of hypomania and at least one episode of major depression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bipolar_II_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>双相情感障碍ii型</obo:OAE_0001849>
        <obo:OAE_0004334>10004940</obo:OAE_0004334>
        <rdfs:label>bipolar ii disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004847 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a type of bipolar spectrum disorder characterized by the occurrence of at least one manic episode, with or without mixed or psychotic features.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bipolar_I_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>双相情感障碍i型</obo:OAE_0001849>
        <obo:OAE_0004334>10004939</obo:OAE_0004334>
        <rdfs:label>bipolar i disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004848 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a condition of abnormally deep sleep or a stupor from which it is difficult to rouse.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sopor_(sleep)</obo:IAO_0000119>
        <obo:OAE_0001849>迷睡</obo:OAE_0001849>
        <obo:OAE_0004334>10058709</obo:OAE_0004334>
        <rdfs:label>sopor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004849 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004849">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is the cumulative effect of not getting enough sleep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sleep_debt</obo:IAO_0000119>
        <obo:OAE_0001849>睡眠不足</obo:OAE_0001849>
        <obo:OAE_0004334>10080881</obo:OAE_0004334>
        <rdfs:label>sleep deficit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004850 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a rare form of circadian rhythm sleep disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irregular_sleep%E2%80%93wake_rhythm</obo:IAO_0000119>
        <obo:OAE_0001849>睡眠节律紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10080301</obo:OAE_0004334>
        <rdfs:label>irregular sleep wake rhythm disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004851 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a state, during waking up or falling asleep, in which a person is aware but unable to move or speak.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sleep_paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>睡眠麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10041002</obo:OAE_0004334>
        <rdfs:label>sleep paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004852 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is a broad classification of sleeping disorders involving difficulty getting to sleep, remaining asleep, or of excessive sleepiness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dyssomnia</obo:IAO_0000119>
        <obo:OAE_0001849>睡眠障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061827</obo:OAE_0004334>
        <rdfs:label>dyssomnia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004853 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001120"/>
        <obo:IAO_0000115>This is an AE which is characterized by reduced exercise capacity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31584302/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性左心室衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10063083</obo:OAE_0004334>
        <rdfs:label>chronic left ventricular failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004854 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which refers a chronic condition due to mental or physical impairments arising before adulthood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mental_disability</obo:IAO_0000119>
        <obo:OAE_0001849>精神残疾</obo:OAE_0001849>
        <obo:OAE_0004334>10027353</obo:OAE_0004334>
        <rdfs:label>mental disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004855 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder characterized by continuous or relapsing episodes of psychosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schizophrenia</obo:IAO_0000119>
        <obo:OAE_0001849>精神分裂症</obo:OAE_0001849>
        <obo:OAE_0004334>10039626</obo:OAE_0004334>
        <rdfs:label>schizophrenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004856 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder diagnosed when symptoms of schizophrenia are present for a significant portion of time (at least a month), but signs of disturbance are not present for the full six months required for the diagnosis of schizophrenia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schizophreniform_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>精神分裂症</obo:OAE_0001849>
        <obo:OAE_0004334>10039647</obo:OAE_0004334>
        <rdfs:label>schizophreniform disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004857 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000441"/>
        <obo:IAO_0000115>This is an AE which is classified as “partial awakenings in which the state of consciousness remains impaired for several minutes without any accompanying major behavioural disorders or severe autonomic responses”.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Confusional_arousals</obo:IAO_0000119>
        <obo:OAE_0001849>精神混乱的冲动</obo:OAE_0001849>
        <obo:OAE_0004334>10067494</obo:OAE_0004334>
        <rdfs:label>confusional arousal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004858 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000441"/>
        <obo:IAO_0000115>This is an AE which is an organically caused decline from a previous baseline mental functioning, that develops over a short period of time, typically hours to days.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Delirium</obo:IAO_0000119>
        <obo:OAE_0001849>精神混乱的状态</obo:OAE_0001849>
        <obo:OAE_0004334>10010305</obo:OAE_0004334>
        <rdfs:label>confusional state AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004859 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a behavioral or mental pattern that causes significant distress or impairment of personal functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mental_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>精神疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061284</obo:OAE_0004334>
        <rdfs:label>mental disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004860 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000034"/>
        <obo:IAO_0000115>This is an AE which is a temporary inability to maintain optimal cognitive performance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fatigue#Mental</obo:IAO_0000119>
        <obo:OAE_0001849>精神疲劳</obo:OAE_0001849>
        <obo:OAE_0004334>10076757</obo:OAE_0004334>
        <rdfs:label>mental fatigue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004861 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is characterized by backward disequilibrium in a sitting and standing position, reactional hypertonia, an alteration of postural reactions, gait modifications, and fear of falling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15152732/</obo:IAO_0000119>
        <obo:OAE_0001849>精神运动不适应综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10080662</obo:OAE_0004334>
        <rdfs:label>psychomotor disadaptation syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004862 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>This is an AE which is a chronic disorder of the nervous system characterized by recurrent, unprovoked focal seizures that originate in the temporal lobe of the brain and last about one or two minutes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Temporal_lobe_epilepsy</obo:IAO_0000119>
        <obo:OAE_0001849>精神运动性癫痫发作</obo:OAE_0001849>
        <obo:OAE_0004334>10037214</obo:OAE_0004334>
        <rdfs:label>psychomotor seizures AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004863 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a generalized neurodevelopmental disorder characterized by significantly impaired intellectual and adaptive functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intellectual_disability</obo:IAO_0000119>
        <obo:OAE_0001849>精神障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10027374</obo:OAE_0004334>
        <rdfs:label>mental impairment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004864 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001336"/>
        <obo:IAO_0000115>This is an AE which is an abnormal condition of the mind that results in difficulties determining what is real and what is not real.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychosis</obo:IAO_0000119>
        <obo:OAE_0001849>精神症状</obo:OAE_0001849>
        <obo:OAE_0004334>10079254</obo:OAE_0004334>
        <rdfs:label>psychotic symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000042"/>
        <obo:IAO_0000115>This is an AE which is the action of violently shaking one&apos;s head in rhythm with music.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Headbanging</obo:IAO_0000119>
        <obo:OAE_0001849>头部撞击</obo:OAE_0001849>
        <obo:OAE_0004334>10019191</obo:OAE_0004334>
        <rdfs:label>head banging AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004866 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an Ae which is a cutaneous fungal infection (dermatophytosis) of the scalp.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tinea_capitis</obo:IAO_0000119>
        <obo:OAE_0001849>头癣</obo:OAE_0001849>
        <obo:OAE_0004334>10043866</obo:OAE_0004334>
        <rdfs:label>tinea capitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004867 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <obo:IAO_0000115>This is an AE which may be a clinical manifestation of autonomic nervous system dysregulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/12172243/</obo:IAO_0000119>
        <obo:OAE_0001849>头晕劳累型</obo:OAE_0001849>
        <obo:OAE_0004334>10013576</obo:OAE_0004334>
        <rdfs:label>dizziness exertional AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004868 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002206"/>
        <obo:IAO_0000115>This is an AE which is characterized by having difficulty returning to sleep after waking up during the night or very early in the morning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Middle-of-the-night_insomnia</obo:IAO_0000119>
        <obo:OAE_0001849>中期失眠症</obo:OAE_0001849>
        <obo:OAE_0004334>10027590</obo:OAE_0004334>
        <rdfs:label>middle insomnia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004869 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004869">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000034"/>
        <obo:IAO_0000115>This is an AE which is a state of tiredness, weariness, fatigue, or lack of energy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lethargy</obo:IAO_0000119>
        <obo:OAE_0001849>呆滞</obo:OAE_0001849>
        <obo:OAE_0004334>10041052</obo:OAE_0004334>
        <rdfs:label>sluggishness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004870 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001974"/>
        <obo:IAO_0000115>This is an AE which is a rare neurodegenerative disorder characterized by autonomic dysfunction, tremors, slow movement, muscle rigidity, and postural instability (collectively known as parkinsonism) and ataxia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_system_atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>多系统萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10064060</obo:OAE_0004334>
        <rdfs:label>multiple system atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004871 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000184"/>
        <obo:IAO_0000115>This is an AE which encompasses several types of dementia involving the frontal and temporal lobes.[3] FTDs are broadly presented as behavioral or language disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Frontotemporal_dementia</obo:IAO_0000119>
        <obo:OAE_0001849>额颞叶痴呆</obo:OAE_0001849>
        <obo:OAE_0004334>10068968</obo:OAE_0004334>
        <rdfs:label>frontotemporal dementia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004872 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>This is an AE which is an anxiety disorder in which an individual experiences excessive anxiety regarding separation from home and/or from people to whom the individual has a strong emotional attachment (e.g., a parent, caregiver, significant other, or siblings).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Separation_anxiety_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>分离焦虑症</obo:OAE_0001849>
        <obo:OAE_0004334>10040045</obo:OAE_0004334>
        <rdfs:label>separation anxiety disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004873 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a neurological examination finding elicited by a reflex test which can help verify the presence or absence of issues arising from the corticospinal tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hoffmann%27s_reflex</obo:IAO_0000119>
        <obo:OAE_0001849>霍夫曼氏征</obo:OAE_0001849>
        <obo:OAE_0004334>10058444</obo:OAE_0004334>
        <rdfs:label>hoffmann&apos;s sign AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004874 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000184"/>
        <obo:IAO_0000115>This is an AE which is a type of dementia characterized by changes in sleep, behavior, cognition, movement, and regulation of automatic bodily functions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dementia_with_Lewy_bodies</obo:IAO_0000119>
        <obo:OAE_0001849>路易体痴呆</obo:OAE_0001849>
        <obo:OAE_0004334>10067889</obo:OAE_0004334>
        <rdfs:label>dementia with lewy bodies AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004875 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuroborreliosis</obo:IAO_0000119>
        <obo:OAE_0001849>螺旋体病</obo:OAE_0001849>
        <obo:OAE_0004334>10052057</obo:OAE_0004334>
        <rdfs:label>neuroborreliosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004876 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a common neurodevelopmental disorder that begins in childhood or adolescence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tourette_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>图雷特氏症</obo:OAE_0001849>
        <obo:OAE_0004334>10044126</obo:OAE_0004334>
        <rdfs:label>tourette&apos;s disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004877 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>感觉神经节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066196</obo:OAE_0004334>
        <rdfs:label>sensory ganglionitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004878 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002354"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>血管病性神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10079036</obo:OAE_0004334>
        <rdfs:label>angiopathic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004879 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>脊柱扁平化</obo:OAE_0001849>
        <obo:OAE_0004334>10077756</obo:OAE_0004334>
        <rdfs:label>spinal flattening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004880 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>睡眠期节律紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10041003</obo:OAE_0004334>
        <rdfs:label>sleep phase rhythm disturbance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004881 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>精神运动技能受损</obo:OAE_0001849>
        <obo:OAE_0004334>10049215</obo:OAE_0004334>
        <rdfs:label>psychomotor skills impaired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004882 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a disease characterized by a weeks-long course of thunderclap headaches, sometimes focal neurologic signs, and occasionally seizures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reversible_cerebral_vasoconstriction_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>大脑血管收缩</obo:OAE_0001849>
        <obo:OAE_0004334>10059109</obo:OAE_0004334>
        <rdfs:label>cerebral vasoconstriction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004883 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is a Gram-negative bacterium that can cause meningitis and other forms of meningococcal disease with bacteraemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neisseria_meningitidis</obo:IAO_0000119>
        <obo:OAE_0001849>脑膜炎球菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058858</obo:OAE_0004334>
        <rdfs:label>meningococcal bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004884 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000438"/>
        <obo:IAO_0000115>This is an AE which is a Gram-negative bacterium that can cause meningitis and other forms of meningococcal disease with carditis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neisseria_meningitidis</obo:IAO_0000119>
        <obo:OAE_0001849>脑膜炎球菌性心炎</obo:OAE_0001849>
        <obo:OAE_0004334>10027270</obo:OAE_0004334>
        <rdfs:label>meningococcal carditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004885 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which poor spinal  blood flow to the brain causes cell death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stroke</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱中风</obo:OAE_0001849>
        <obo:OAE_0004334>10082031</obo:OAE_0004334>
        <rdfs:label>spinal stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004886 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000800"/>
        <obo:IAO_0000115>This is an AE which is a neurological condition in which the cerebellum is smaller than usual or not completely developed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebellar_hypoplasia_(non-human)</obo:IAO_0000119>
        <obo:OAE_0001849>继发性小脑变性</obo:OAE_0001849>
        <obo:OAE_0004334>10074943</obo:OAE_0004334>
        <rdfs:label>secondary cerebellar degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004887 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <obo:IAO_0000115>This is an AE which is a perceptual disturbance experienced by some with epilepsy or migraine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aura_(symptom)</obo:IAO_0000119>
        <obo:OAE_0001849>癫痫先兆</obo:OAE_0001849>
        <obo:OAE_0004334>10015049</obo:OAE_0004334>
        <rdfs:label>epileptic aura AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004888 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>This is an AE which is a rare form of chronic, progressive brain inflammation caused by slow infection with certain defective strains of hypermutated measles virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subacute_sclerosing_panencephalitis</obo:IAO_0000119>
        <obo:OAE_0001849>全脑炎</obo:OAE_0001849>
        <obo:OAE_0004334>10056332</obo:OAE_0004334>
        <rdfs:label>panencephalitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004889 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a relatively frequent occurrence in significant head trauma, and their detection is important, as even linear nondisplaced fractures can be associated with critical complications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25086806/</obo:IAO_0000119>
        <obo:OAE_0001849>颅底骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10040960</obo:OAE_0004334>
        <rdfs:label>skull fractured base AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004890 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is achieved in this model by injecting particles like blood clots (thrombembolic MCAO) or artificial spheres into the carotid artery of animals as an animal model of ischemic stroke.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Animal_model_of_ischemic_stroke#Embolic_middle_cerebral_artery_occlusion</obo:IAO_0000119>
        <obo:OAE_0001849>脑动脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10008089</obo:OAE_0004334>
        <rdfs:label>cerebral artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004891 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000534"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a cerebrovascular  blood vessel or other tubular organ or structure such as foramina and canals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>脑血管狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10061751</obo:OAE_0004334>
        <rdfs:label>cerebrovascular stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004892 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000438"/>
        <obo:IAO_0000115>This is an AE which is an acute inflammation of the protective membranes covering the brain and spinal cord caused by staphylococcal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meningitis</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌脑膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10027255</obo:OAE_0004334>
        <rdfs:label>meningitis staphylococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004893 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>This is an AE which is an important and common complication of chimeric antigen receptor-T cell therapies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30387077/</obo:IAO_0000119>
        <obo:OAE_0001849>中毒性脑炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014607</obo:OAE_0004334>
        <rdfs:label>encephalitis toxic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004894 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>This is an AE which is associated with infectious complications, whereas emerging treatments, including anakinra and tocilizumab, may also result in increased susceptibility to certain infections.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31021956/</obo:IAO_0000119>
        <obo:OAE_0001849>免疫介导性脑炎</obo:OAE_0001849>
        <obo:OAE_0004334>10083074</obo:OAE_0004334>
        <rdfs:label>immune-mediated encephalitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004895 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000761"/>
        <obo:IAO_0000115>This is an AE which is characterized by macrocephaly and typical neuroimaging findings, is considered as a self-limiting condition and is therefore rarely treated in infants.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21647596/</obo:IAO_0000119>
        <obo:OAE_0001849>外部性脑积水</obo:OAE_0001849>
        <obo:OAE_0004334>10076670</obo:OAE_0004334>
        <rdfs:label>external hydrocephalus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004896 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004896">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is defined as inflammation of the meninges, in almost all cases identified by an abnormal number of white blood cells in the cerebrospinal fluid and specific clinical signs/symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23958365/</obo:IAO_0000119>
        <obo:OAE_0001849>脑膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10061281</obo:OAE_0004334>
        <rdfs:label>meningeal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004897 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is five main reasons for bacterial, viral, fungal, protozoal, and prionic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/List_of_infections_of_the_central_nervous_system</obo:IAO_0000119>
        <obo:OAE_0001849>颅内感染</obo:OAE_0001849>
        <obo:OAE_0004334>10082062</obo:OAE_0004334>
        <rdfs:label>intracranial infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004898 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>This is an AE which is inflammation  with haemorrhagic of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Encephalitis</obo:IAO_0000119>
        <obo:OAE_0001849>脑炎出血</obo:OAE_0001849>
        <obo:OAE_0004334>10014589</obo:OAE_0004334>
        <rdfs:label>encephalitis haemorrhagic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004899 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>This is an AE which is inflammation and allergy of the brain.</obo:IAO_0000115>
