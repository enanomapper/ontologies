        <rdfs:label>Grade 2 enterocolitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10629</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003641 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000917"/>
