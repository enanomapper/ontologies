        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30857738/</obo:IAO_0000119>
        <obo:OAE_0001849>尿道损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10046454</obo:OAE_0004334>
        <rdfs:label>urethral injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008377 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is an imprecise diagnosis, which continues to be defined by a low pressure urethra.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19444119/</obo:IAO_0000119>
        <obo:OAE_0001849>尿道内源性括约肌功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10046456</obo:OAE_0004334>
        <rdfs:label>urethral intrinsic sphincter deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008378 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a blood vessel or other tubular organ or structure such as foramina and canals such as urethral meatus stenosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>尿道口狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10058463</obo:OAE_0004334>
        <rdfs:label>urethral meatus stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008379 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is a symptom complex including dysuria, urinary urgency and frequency, nocturia and persistent or intermittent urethral and/or pelvic pain in the absence of proven infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26337167/</obo:IAO_0000119>
        <obo:OAE_0001849>尿道痛</obo:OAE_0001849>
        <obo:OAE_0004334>10046461</obo:OAE_0004334>
        <rdfs:label>urethral pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008380 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is a sudden involuntary contraction of a muscle, a group of muscles, or a hollow organ such as the bladder such as urethral spasm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0001849>尿道痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10046464</obo:OAE_0004334>
        <rdfs:label>urethral spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008381 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002567"/>
        <obo:IAO_0000115>This is an AE which is a sexually transmitted infection (STI) caused by the bacterium Neisseria gonorrhoeae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gonorrhea</obo:IAO_0000119>
        <obo:OAE_0001849>淋球菌性尿道炎</obo:OAE_0001849>
        <obo:OAE_0004334>10046483</obo:OAE_0004334>
        <rdfs:label>urethritis gonococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008382 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002567"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the urethra and is noninfective.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urethritis</obo:IAO_0000119>
        <obo:OAE_0001849>非感染性尿道炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062903</obo:OAE_0004334>
        <rdfs:label>urethritis noninfective AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008383 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which comprises a number of different types of cancer that result from squamous cells on the cervix.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Squamous_cell_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>宫颈鳞状细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10041848</obo:OAE_0004334>
        <rdfs:label>squamous cell carcinoma of the cervix AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008384 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a physiological phenomenon in which the penis becomes firm, engorged, enlarged and is spontaneous.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erection</obo:IAO_0000119>
        <obo:OAE_0001849>自发性阴茎勃起</obo:OAE_0001849>
        <obo:OAE_0004334>10049118</obo:OAE_0004334>
        <rdfs:label>spontaneous penile erection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008385 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is infections that are spread by sexual activity, especially vaginal intercourse, anal sex and oral sex.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sexually_transmitted_infection</obo:IAO_0000119>
        <obo:OAE_0001849>性抑制</obo:OAE_0001849>
        <obo:OAE_0004334>10040488</obo:OAE_0004334>
        <rdfs:label>sexual transmission of infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008386 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition characterized by calcification of the skin resulting from the deposition of calcium and phosphorus occurring on the scrotum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Idiopathic_scrotal_calcinosis</obo:IAO_0000119>
        <obo:OAE_0001849>阴囊囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10065670</obo:OAE_0004334>
        <rdfs:label>scrotal cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008387 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is not considered a separate disease entity and is usually considered a condition similar to the contact dermatitis occurring elsewhere.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24044054/</obo:IAO_0000119>
        <obo:OAE_0001849>阴囊皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10083260</obo:OAE_0004334>
        <rdfs:label>scrotal dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008388 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is reactive scrotal skin conditions in which there is blanchable redness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/List_of_skin_conditions#Erythemas</obo:IAO_0000119>
        <obo:OAE_0001849>阴囊红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10054950</obo:OAE_0004334>
        <rdfs:label>scrotal erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008389 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor of epithelial tissue with glandular origin, glandular characteristics, or both on the prostatic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenoma</obo:IAO_0000119>
        <obo:OAE_0001849>前列腺腺瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10036940</obo:OAE_0004334>
        <rdfs:label>prostatic adenoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008390 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is commonly observed while performing transrectal ultrasonography (TRUS), yet its significance is poorly understood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25530382/</obo:IAO_0000119>
        <obo:OAE_0001849>前列腺钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10066880</obo:OAE_0004334>
        <rdfs:label>prostatic calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008391 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the prostatic, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>前列腺囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10067640</obo:OAE_0004334>
        <rdfs:label>prostatic cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008392 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth or development of cells (microscopic scale) and/or organs (macroscopic scale), and/or the abnormal histology or anatomical structure presumably resulting from such growth such as prostatic dysplasia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>前列腺发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10071019</obo:OAE_0004334>
        <rdfs:label>prostatic dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008393 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the prostate gland and  is classified into acute, chronic, asymptomatic inflammatory prostatitis, and chronic pelvic pain syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prostatitis</obo:IAO_0000119>
        <obo:OAE_0001849>前列腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10036978</obo:OAE_0004334>
        <rdfs:label>prostatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008394 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is a noncancerous increase in size of the prostate gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_prostatic_hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>前列腺肿大</obo:OAE_0001849>
        <obo:OAE_0004334>10051482</obo:OAE_0004334>
        <rdfs:label>prostatomegaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008395 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is when the placenta attaches inside the uterus but in an abnormal position near or over the cervical opening.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Placenta_praevia</obo:IAO_0000119>
        <obo:OAE_0001849>前置胎盘</obo:OAE_0001849>
        <obo:OAE_0004334>10035119</obo:OAE_0004334>
        <rdfs:label>placenta praevia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008396 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the most common cause of antepartum haemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31622483/</obo:IAO_0000119>
        <obo:OAE_0001849>前置胎盘出血</obo:OAE_0001849>
        <obo:OAE_0004334>10035121</obo:OAE_0004334>
        <rdfs:label>placenta praevia hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008397 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004247"/>
        <obo:IAO_0000115>This is an AE which is a common pathologic condition in obstetrics and identified nanobacteria in placental calcification indicated that nanobacteria infection is related to placental calcification.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22559042/</obo:IAO_0000119>
        <obo:OAE_0001849>胎盘钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10082008</obo:OAE_0004334>
        <rdfs:label>placental calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008398 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004247"/>
        <obo:IAO_0000115>This is an AE which is the failure of the placenta to deliver sufficient nutrients to the fetus during pregnancy, and is often a result of insufficient blood flow to the placenta.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Placental_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>胎盘机能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10035138</obo:OAE_0004334>
        <rdfs:label>placental insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008399 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the perineal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>会阴脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10052457</obo:OAE_0004334>
        <rdfs:label>perineal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the perineal, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>会阴囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10066058</obo:OAE_0004334>
        <rdfs:label>perineal cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008401 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is an unusual condition that presents 2–3 days after a throat infection as a fine diffuse macular erythema of the perineal region.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Recurrent_toxin-mediated_perineal_erythema</obo:IAO_0000119>
        <obo:OAE_0001849>会阴红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10070707</obo:OAE_0004334>
        <rdfs:label>perineal erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008402 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which refers the region of the body between the pubic arch and the tail bone and it has infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perineal</obo:IAO_0000119>
        <obo:OAE_0001849>会阴感染</obo:OAE_0001849>
        <obo:OAE_0004334>10066876</obo:OAE_0004334>
        <rdfs:label>perineal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008403 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a laceration of the skin and other soft tissue structures which, in women, separate the vagina from the anus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perineal_tear</obo:IAO_0000119>
        <obo:OAE_0001849>会阴撕裂</obo:OAE_0001849>
        <obo:OAE_0004334>10034521</obo:OAE_0004334>
        <rdfs:label>perineal laceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008404 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in a bodily membrane that impedes normal function of the affected organ such as perineal ulceration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>会阴部溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10069679</obo:OAE_0004334>
        <rdfs:label>perineal ulceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008405 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a relatively common complication of obstetric and colorectal surgery , and can also occur in  diseases such as Crohn’s disease, diverticulitis, ischemic colitis, pelvic inflammatory disease, or endocarditis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25159523/</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10034236</obo:OAE_0004334>
        <rdfs:label>pelvic abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008406 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a long term condition in women believed to be due to enlarged veins in the lower abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pelvic_congestion_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔充血</obo:OAE_0001849>
        <obo:OAE_0004334>10034240</obo:OAE_0004334>
        <rdfs:label>pelvic congestion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008407 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a break of the bony structure of the pelvis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pelvic_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>骨盆骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10061161</obo:OAE_0004334>
        <rdfs:label>pelvic fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008408 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which can be described as a pregnancy discomfort for some women and a severe disability for others. PGP can cause pain, instability and limitation of mobility and functioning in any of the three pelvic joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pelvic_girdle_pain</obo:IAO_0000119>
        <obo:OAE_0001849>骨盆带疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10083336</obo:OAE_0004334>
        <rdfs:label>pelvic girdle pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008409 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a common finding following hysterectomy which at times may become infected causing substantial morbidity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33298036/</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10054974</obo:OAE_0004334>
        <rdfs:label>pelvic hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008410 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged pelvic blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔出血</obo:OAE_0001849>
        <obo:OAE_0004334>10063678</obo:OAE_0004334>
        <rdfs:label>pelvic hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008411 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is an infection of the upper part of the female reproductive system, namely the uterus, fallopian tubes, and ovaries, and inside of the pelvis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pelvic_inflammatory_disease</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔炎性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10034254</obo:OAE_0004334>
        <rdfs:label>pelvic inflammatory disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008412 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is damage to the pelvic organ caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔器官损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061405</obo:OAE_0004334>
        <rdfs:label>pelvic organ injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008414 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is characterized by descent of pelvic organs from their normal positions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pelvic_organ_prolapse</obo:IAO_0000119>
        <obo:OAE_0001849>盆腔脱垂</obo:OAE_0001849>
        <obo:OAE_0004334>10034268</obo:OAE_0004334>
        <rdfs:label>pelvic prolapse AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008415 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a group of rare autoimmune blistering diseases of the skin, and mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pemphigoid</obo:IAO_0000119>
        <obo:OAE_0001849>类天疱疮</obo:OAE_0001849>
        <obo:OAE_0004334>10034277</obo:OAE_0004334>
        <rdfs:label>pemphigoid AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008416 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the penile skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎泡</obo:OAE_0001849>
        <obo:OAE_0004334>10052898</obo:OAE_0004334>
        <rdfs:label>penile blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008417 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is redness of the penile skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10070655</obo:OAE_0004334>
        <rdfs:label>penile erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008418 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged penile blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎出血</obo:OAE_0001849>
        <obo:OAE_0004334>10034305</obo:OAE_0004334>
        <rdfs:label>penile hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008419 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the penile tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10066774</obo:OAE_0004334>
        <rdfs:label>penile edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008420 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a change of the penile skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10082571</obo:OAE_0004334>
        <rdfs:label>penile rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008421 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001136"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of a penile part or area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10034319</obo:OAE_0004334>
        <rdfs:label>penile swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008422 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is an open sore located on the genital area, which includes the vulva, penis, perianal region, or anus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Genital_ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10034322</obo:OAE_0004334>
        <rdfs:label>penile ulceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008423 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is typically small, rough, hard growths on the penile that are similar in color to the rest of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wart</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎疣</obo:OAE_0001849>
        <obo:OAE_0004334>10034325</obo:OAE_0004334>
        <rdfs:label>penile wart AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008424 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is the process of combining two or more distinct entities into a new whole such as penoscrotal fusion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fusion</obo:IAO_0000119>
        <obo:OAE_0001849>阴囊融合</obo:OAE_0001849>
        <obo:OAE_0004334>10064951</obo:OAE_0004334>
        <rdfs:label>penoscrotal fusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008425 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is classified as menstrual disorders and include oligoovulation and anovulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ovulation#Disorders</obo:IAO_0000119>
        <obo:OAE_0001849>排卵障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10067490</obo:OAE_0004334>
        <rdfs:label>ovulation disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008426 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a physiological phenomenon in which the penis becomes firm, engorged, and enlarged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erection</obo:IAO_0000119>
        <obo:OAE_0001849>勃起困难</obo:OAE_0001849>
        <obo:OAE_0004334>10056303</obo:OAE_0004334>
        <rdfs:label>painful erection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008427 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the ovarian.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10033119</obo:OAE_0004334>
        <rdfs:label>ovarian abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008428 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor of epithelial tissue with glandular origin, glandular characteristics, or both such as ovarian adenoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenoma</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢腺瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10048991</obo:OAE_0004334>
        <rdfs:label>ovarian adenoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008429 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the body such as ovarian atrophy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10033122</obo:OAE_0004334>
        <rdfs:label>ovarian atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008430 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004246"/>
        <obo:IAO_0000115>This is an AE which is a fluid-filled sac within the ovary and the sac is ruptured.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ovarian_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢囊肿破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10033136</obo:OAE_0004334>
        <rdfs:label>ovarian cyst ruptured AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008431 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which may refer to diseases primarily affecting, or centered on, the ovaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ovarian_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10033139</obo:OAE_0004334>
        <rdfs:label>ovarian disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008432 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth or development of cells (microscopic scale) and/or organs (macroscopic scale), and/or the abnormal histology or anatomical structure presumably resulting from such growth such as ovarian dyspasia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10080570</obo:OAE_0004334>
        <rdfs:label>ovarian dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008433 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a tumor made up of several different types of tissue, such as ovarian germ cell .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Teratoma</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢生殖细胞畸胎瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10073265</obo:OAE_0004334>
        <rdfs:label>ovarian germ cell teratoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008434 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a tumor made up of several different types of tissue, such as ovarian germ cell and is benign.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Teratoma</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢生殖细胞良性畸胎瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10033236</obo:OAE_0004334>
        <rdfs:label>ovarian germ cell teratoma benign AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008435 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a histologically diverse group of neoplasms with a common origin in the primitive germ cell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31097117/</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢生殖细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10075812</obo:OAE_0004334>
        <rdfs:label>ovarian germ cell tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008436 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is tumours that arise from ovarian granulosa cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granulosa_cell_tumour</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢颗粒细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10073260</obo:OAE_0004334>
        <rdfs:label>ovarian granulosa cell tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008437 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is damage to the ovarian  caused by an external force.</obo:IAO_0000115>
