        <obo:OAE_0004334>10052154</obo:OAE_0004334>
        <rdfs:label>tympanic membrane hyperemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005962 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which developed in consistent patterns in the postero-superior quadrant of the pars tensa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18792316/</obo:IAO_0000119>
