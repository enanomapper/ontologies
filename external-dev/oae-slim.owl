    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Pink skin AE is a skin AE that shows pink skin.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>皮肤粉红</obo:OAE_0001849>
        <rdfs:label>pink skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002212 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Acute laryngeal edema AE is an edema AE that shows acute laryngeal edema, abnormal accumulation of fluid in tissues of any part of the larynx, commonly associated with laryngeal injuries and allergic reactions.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>急性喉头水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10066705</obo:OAE_0004334>
        <rdfs:label>acute laryngeal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002213 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>Hypoplastic bone marrow AE is a bone marrow disorder AE that shows insufficient blood stem cells in the marrow.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>骨髓发育不全</obo:OAE_0001849>
        <rdfs:label>hypoplastic bone marrow AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002214 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>Bleeding and coagulation disorders AE is a hematopoietic system AE that shows bleeding and coagulation disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>出凝血功能障碍</obo:OAE_0001849>
        <rdfs:label>bleeding and coagulation disorders AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002215 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001943"/>
        <obo:IAO_0000115>Polymorphic ventricular tachycardia AE is a ventricular tachycardia AE that is an abnormally fast heart rhythm starting in the ventricles, the lower chambers of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthguideinfo.com/arrhythmias-heart-palpitations/p110132/</obo:IAO_0000119>
        <obo:OAE_0001849>多行性室性心动过速</obo:OAE_0001849>
        <obo:OAE_0004334>10036095</obo:OAE_0004334>
        <rdfs:label>polymorphic ventricular tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002216 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001943"/>
        <obo:IAO_0000115>Monomorphic ventricular tachycardia AE is a ventricular tachycardia AE that is a type of tachycardia which has  a uniform beat-to-beat QRS morphology.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>单行性室性心动过速</obo:OAE_0001849>
        <obo:OAE_0004334>10058185</obo:OAE_0004334>
        <rdfs:label>monomorphic ventricular tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002217 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>Respiratory tract symptoms AE is a respiratory system AE that is a series of discomforts which occurs in respiratory tract.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>呼吸道症状</obo:OAE_0001849>
        <rdfs:label>respiratory tract symptoms AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002218 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Clammy skin AE is a skin AE that occurs when the skin turns cooler than normal and is moist, despite a cooler surface temperature. Clammy skin is often pale.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/clammy-skin</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤湿冷</obo:OAE_0001849>
        <rdfs:label>clammy skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002219 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>Abnormal visual accommodation AE is an abnormal vision AE that shows abnormal visual accommodation. Accommodation is the process by which the vertebrate eye changes optical power to maintain a clear image or focus on an object as its distance varies.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Accommodation_%28eye%29</obo:IAO_0000119>
        <obo:OAE_0001849>视调节异常</obo:OAE_0001849>
        <rdfs:label>abnormal visual accommodation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002220 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>an allergy AE that shows swelling and irritation of the skin, caused by an allergy to a substance in the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>皮肤过敏</obo:OAE_0001849>
        <rdfs:label>skin allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002221 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000685"/>
        <obo:IAO_0000115>Heaviness of the head AE is a sensation of heaviness AE that shows a sensation feeling of heaviness in the head.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>头重感</obo:OAE_0001849>
        <obo:OAE_0004334>10049121</obo:OAE_0004334>
        <rdfs:label>heaviness of the head AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002222 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001602"/>
        <obo:IAO_0000115>Rheumatoid factor positive AE is an immunology and allergy investigation result abnormal AE that shows positive of the rheumatoid factor. Rheumatoid factor is a blood test that measures the amount of the RF antibody in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003548.htm</obo:IAO_0000119>
        <obo:OAE_0001849>类风湿因子阳性</obo:OAE_0001849>
        <obo:OAE_0004334>10039080</obo:OAE_0004334>
        <rdfs:label>rheumatoid factor positive AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002223 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Retinal detachment AE is an eye AE that  is a separation of the retina from its attachments to the underlying tissue within the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/retinal_detachment/article.htm</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜脱离</obo:OAE_0001849>
        <obo:OAE_0004334>10038848</obo:OAE_0004334>
        <rdfs:label>retinal detachment AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10420</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C26874</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C26874</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002224 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Arm pain AE is a pain AE that shows discomfort in the structures of the arm. It can be caused by a wide variety of problems, ranging from joint injuries to compressed nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/symptoms/arm-pain/basics/definition/SYM-20050870</obo:IAO_0000119>
        <obo:OAE_0001849>手臂疼痛</obo:OAE_0001849>
        <rdfs:label>arm pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002225 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>Peripheric paresthesia AE is a paresthesia AE that shows paresthesia in the peripheric area.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>外周感觉异常</obo:OAE_0001849>
        <rdfs:label>peripheric paresthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002226 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Edema of glottis AE is an edema AE that is a swelling caused by fluid accumulation in the soft tissues of the larynx. The condition, usually inflammatory, may result from an infection, injury, allergy, or inhalation of toxic substances.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>声门肿胀</obo:OAE_0001849>
        <rdfs:label>edema of glottis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002227 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000910"/>
        <obo:IAO_0000115>Prolonged qrs complex AE is a electrocardiogram qrs complex abnormal AE that shows qrs complex prolonged. The QRS complex is a name for the combination of three of the graphical deflections seen on a typical electrocardiogram.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>QRS时间延长</obo:OAE_0001849>
        <rdfs:label>prolonged qrs complex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002228 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001664"/>
        <obo:IAO_0000115>Prolonged bleeding time AE is a hematology investigation result abnormal AE that shows prolonged time for small blood vessels in the skin close to stop from bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>出血时间延长</obo:OAE_0001849>
        <rdfs:label>prolonged bleeding time AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002229 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Acute generalized exanthematous pustulosis AE is a skin AE that is a not uncommon cutaneous reaction pattern that in 90% of cases is related to medication administration, characterized by a sudden eruption that appears on average five days after the medication is started.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>pustular drug eruption AE</obo:IAO_0000118>
        <obo:IAO_0000118>toxic pustuloderma AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acute_generalized_exanthematous_pustulosis</obo:IAO_0000119>
        <obo:OAE_0001849>急性全身性浓疱病</obo:OAE_0001849>
        <obo:OAE_0004334>10062372</obo:OAE_0004334>
        <rdfs:label>acute generalized exanthematous pustulosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002230 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Upper and lower limbs flare AE is an edema AE that shows edema in the upper and lower limbs, which is an accumulation of an excessive amount of watery fluid in cells or intercellular tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>上下肢红肿</obo:OAE_0001849>
        <rdfs:label>upper and lower limbs flare AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002231 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001612"/>
        <obo:IAO_0000115>Abnormal blood sugar with empty stomach AE is a blood glucose level abnormal AE that shows abnormal blood glucose level with empty stomach.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>空腹时血糖异常</obo:OAE_0001849>
        <rdfs:label>abnormal blood sugar with empty stomach AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002232 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000733"/>
        <obo:IAO_0000115>Increased blood sugar with empty stomach AE is blood glucose level decreased AE that shows an increased glucose level in blood with empty stomach.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>空腹时血糖升高</obo:OAE_0001849>
        <rdfs:label>increased blood sugar with empty stomach AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002233 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>Hydrochloric acid in gastric juice secretion increased AE is a gastric disorder AE that shows increased gastric acid.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>胃酸分泌增多</obo:OAE_0001849>
        <rdfs:label>hydrochloric acid in gastric juice secretion increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002234 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001943"/>
        <obo:IAO_0000115>Torsades de pointes AE is a ventricular tachycardia AE that is a polymorphic ventricular tachycardia that exhibits distinct characteristics on the electrocardiogram.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Torsades_de_pointes</obo:IAO_0000119>
        <obo:OAE_0001849>扭转性室速</obo:OAE_0001849>
        <obo:OAE_0004334>10044067</obo:OAE_0004334>
        <rdfs:label>torsades de pointes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002235 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000405"/>
        <obo:IAO_0000115>Proximal myasthenia AE is a myasthenia AE that shows proximal myasthenia. Myasthenia represents myasthenia gravis, a neuromuscular disease leading to fluctuating muscle weakness and fatigability.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>近端肌无力</obo:OAE_0001849>
        <rdfs:label>proximal myasthenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002236 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000698"/>
        <obo:IAO_0000115>Dilated skin vessels AE is a vasodilatation AE that shows vasodilatation in the skin, which refers to the widening of blood vessels resulting from relaxation of smooth muscle cells within the vessel walls, particularly in the large arteries, smaller arterioles and large veins.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>皮肤血管扩张</obo:OAE_0001849>
        <rdfs:label>dilated skin vessels AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002237 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001852"/>
        <obo:IAO_0000115>Numbness of oral mucosa AE is a numbness AE that shows an abnormal feeling or loss of sensation in the oral mucosa.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>口腔黏膜发麻</obo:OAE_0001849>
        <rdfs:label>numbness of oral mucosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002238 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <obo:IAO_0000115>Orthostatic dizziness AE is a dizziness AE that shows dizziness provocation by sudden postural change.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>体位性头晕</obo:OAE_0001849>
        <obo:OAE_0004334>10031125</obo:OAE_0004334>
        <rdfs:label>orthostatic dizziness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002239 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>Acid reflux AE is a digestive system AE that shows the acid and pepsin secreted in the stomach back up in to the esophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>反酸</obo:OAE_0001849>
