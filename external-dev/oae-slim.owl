    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008968 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the mucocutaneous skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜与皮肤的皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10056671</obo:OAE_0004334>
        <rdfs:label>mucocutaneous rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008969 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory skin condition related to Sweet syndrome that responds to corticosteroids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28941785/</obo:IAO_0000119>
        <obo:OAE_0001849>中性皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10058105</obo:OAE_0004334>
        <rdfs:label>neutrophilic dermatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008970 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the nodular skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>结节性皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10075807</obo:OAE_0004334>
        <rdfs:label>nodular rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008971 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which refers a small spherical group of cells containing a cavity on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Follicle</obo:IAO_0000119>
