    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004608 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a birth defect in which the baby&apos;s intestines extend outside of the abdomen through a hole next to the belly button.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
