    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an organism&apos;s genital  tissues by disease-causing agents such as bactarial, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
