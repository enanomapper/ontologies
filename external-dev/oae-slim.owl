        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which occur when the body has too little or too much calcium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Disorders_of_calcium_metabolism</obo:IAO_0000119>
        <obo:OAE_0001849>钙代谢障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10006974</obo:OAE_0004334>
