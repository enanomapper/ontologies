        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000917"/>
        <obo:IAO_0000115>This is an AE which is a devastating intestinal disease  occured on neonatal that affects premature or very low birth weight infants.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrotizing_enterocolitis</obo:IAO_0000119>
