        <obo:IAO_0000115>a pustular rash AE where IV antibiotic, antifungal, or antiviral intervention indicated; radiologic or operative intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 pustular rash AE</rdfs:label>
