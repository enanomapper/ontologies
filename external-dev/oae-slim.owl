        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is one of two potentially fatal syndromes of zoonotic origin caused by species of hantavirus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hantavirus_pulmonary_syndrome</obo:IAO_0000119>
