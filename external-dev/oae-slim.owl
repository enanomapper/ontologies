    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <obo:IAO_0000115>This is an AE which is an imprecise term that can refer to a sense of disorientation in space, vertigo, or lightheadedness and is procedural .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dizziness</obo:IAO_0000119>
