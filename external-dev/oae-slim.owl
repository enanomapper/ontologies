        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23076892/</obo:IAO_0000119>
        <obo:OAE_0001849>雌激素缺乏</obo:OAE_0001849>
        <obo:OAE_0004334>10030247</obo:OAE_0004334>
        <rdfs:label>oestrogen deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008447 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the ovaries and is noninfective.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oophoritis</obo:IAO_0000119>
