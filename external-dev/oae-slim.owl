    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000005"/>
        <obo:IAO_0000115>This is an AE which is a change in the action or side effects of a drug caused by concomitant administration with a food, beverage, supplement, or another drug.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Drug_interaction</obo:IAO_0000119>
        <obo:OAE_0001849>药物相互作用</obo:OAE_0001849>
