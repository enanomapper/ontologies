        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002677"/>
        <obo:IAO_0000115>This is an AE which is a devastating cause of stroke and is a devastating injury for which prompt, effective treatment can impact meaningful survival.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25498578/</obo:IAO_0000119>
