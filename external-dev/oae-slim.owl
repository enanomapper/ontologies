        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <obo:IAO_0000115>This is an AE which is a visible body part at the mouth of humans and it is discolouration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lip</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇变色</obo:OAE_0001849>
        <obo:OAE_0004334>10024549</obo:OAE_0004334>
        <rdfs:label>lip discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008113 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000687"/>
        <obo:IAO_0000115>This is an AE which involves the removal of the oldest dead skin cells from the lip skin&apos;s surface.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exfoliation_(cosmetology)</obo:IAO_0000119>
