        <rdfs:label xml:lang="en">hyperphosphatemia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002905</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001843 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>a respiratory distress AE that is characterized by insufficient oxygen flow in the heart and respiratory system.</obo:IAO_0000115>
        <obo:IAO_0000117>SS, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medicalcenter.osu.edu/patientcare/healthcare_services/lung_diseases/about/signs/Pages/index.aspx, http://www.merriam-webster.com/dictionary/cardiorespiratory</obo:IAO_0000119>
        <obo:OAE_0004334>10049874</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cardio-respiratory distress AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001844 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>A joint disorder AE that has the presence of increased intra-articular fluid. It can be caused by trauma, arthritis, or gout and often affects the knee.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>PMID: 19915432</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Joint_effusion</obo:IAO_0000119>
        <obo:OAE_0004334>10023215</obo:OAE_0004334>
        <rdfs:label xml:lang="en">joint effusion AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12431</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C49052</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001845 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>a gastrointestinal disorder AE that shows a problem with the stomach, ranging from indigestion and heartburn to peptic ulcers and GERD.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000118>stomach disorder AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/stomachdisorders.html</obo:IAO_0000119>
        <obo:OAE_0004334>10056819</obo:OAE_0004334>
        <rdfs:label xml:lang="en">gastric disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001847 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115 xml:lang="en">An inflammation AE that displays an inflammation (not an infection) of the thyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.endocrineweb.com/conditions/thyroid/thyroiditis</obo:IAO_0000119>
        <dc:creator>yongqun he, liwei wang</dc:creator>
        <rdfs:label xml:lang="en">thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001848 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115 xml:lang="en">a urinary system AE that has an outcome of the excretion of glucose into the urine.</obo:IAO_0000115>
        <obo:IAO_0000119>web: http://en.wikipedia.org/wiki/glycosuria</obo:IAO_0000119>
        <rdfs:comment>LW, YH</rdfs:comment>
        <rdfs:label xml:lang="en">glucosuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001850 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>an inflammation AE that shows localized nodular inflammation found in tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, JX, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/granuloma/expert-answers/faq-20057838</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=3629</obo:IAO_0000119>
        <obo:OAE_0004334>10018691</obo:OAE_0004334>
        <rdfs:label xml:lang="en">granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001851 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000771"/>
        <obo:IAO_0000115>a burning sensation AE that occurs at the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, JX, YH</obo:IAO_0000117>
        <obo:OAE_0004334>10054786</obo:OAE_0004334>
        <rdfs:label xml:lang="en">skin burning sensation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001852 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>a sensory capability AE that has an outcome of numbness, a loss of sensation of feeling in a part of the body. </obo:IAO_0000115>
        <obo:IAO_0000117>YH, JS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/symptoms/numbness/basics/definition/sym-20050938</obo:IAO_0000119>
        <obo:OAE_0004334>10029829</obo:OAE_0004334>
        <rdfs:label xml:lang="en">numbness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001853 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>a pneumonia AE that occurs at the interstitial lung. Interstitial pneumonia is often caused by an infection of bacteria, viruses, or fungii. A bacterium called Mycoplasma pneumonia is the most common cause.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.webmd.com/lung/interstitial-lung-disease</obo:IAO_0000119>
        <obo:OAE_0004334>10022617</obo:OAE_0004334>
        <rdfs:label xml:lang="en">interstitial pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001854 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001852"/>
        <obo:IAO_0000115>a numbness AE that occurs around the mouth.</obo:IAO_0000115>
        <obo:IAO_0000116>The terms &apos;circumoral numbness AE&apos; and &apos;circumoral paresthesia AE&apos; appear to be synonyms. </obo:IAO_0000116>
        <obo:IAO_0000117>YH, JS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://link.springer.com/referenceworkentry/10.1007%2F3-540-29623-9_6515</obo:IAO_0000119>
        <obo:OAE_0004334>10049339</obo:OAE_0004334>
        <rdfs:label xml:lang="en">circumoral numbness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001855 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>Skin necrosis AE is a necrosis AE that results in the death of the skin tissue. Skin necrosis often occurs when not enough blood and oxygen are supplied to a given skin region.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>皮肤坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10040893</obo:OAE_0004334>
        <rdfs:label xml:lang="en">skin necrosis AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0151799</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001856 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000509"/>
        <obo:IAO_0000115>Systemic lupus erythematosus (SLE) syndrome AE is a lupus syndrome AE that is systemic and disseminated. SLE most often harms the heart, joints, skin, lungs, blood vessels, liver, kidneys, and nervous system. Although “lupus” actually includes a number of different diseases, SLE is the most common type of lupus, and when people say “lupus,” they are often referring to SLE.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>SLE</obo:IAO_0000118>
        <obo:IAO_0000118>systemic lupus erythematosus syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000118>系统性红斑狼疮</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Systemic_lupus_erythematosus</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.healthline.com/health/systemic-lupus-erythematosus#Overview1</obo:IAO_0000119>
        <obo:OAE_0001849>系统性红斑狼疮综合征</obo:OAE_0001849>
        <rdfs:label xml:lang="en">systemic lupus erythematosus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001857 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115 xml:lang="en">Urgent urination AE is a urinary system AE that has an outcome of a sudden, compelling urge to urinate, along with discomfort in the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>micturition urgency</obo:IAO_0000118>
        <obo:IAO_0000118>urinary urgency</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://sideeffects.embl.de/se/C0085606/</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003140.htm</obo:IAO_0000119>
        <obo:OAE_0001849>尿急</obo:OAE_0001849>
        <obo:OAE_0004334>10046593</obo:OAE_0004334>
        <rdfs:label>urgent urination AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13062</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C50792</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS CUI: C0439609</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001858 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Precordialgia AE is a pain AE that pain located in the precordial region.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.drugs.com/dict/precordialgia.html</obo:IAO_0000119>
        <obo:OAE_0001849>心前痛</obo:OAE_0001849>
        <rdfs:label>precordialgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001859 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Dyshidrosis AE is a skin AE that shows a disorder of eccrine sweat glands, characterized by small blisters on the hands or feet.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Dyshidrosis</obo:IAO_0000119>
        <obo:OAE_0001849>汗疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10013912</obo:OAE_0004334>
        <rdfs:label>dyshidrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001860 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Ankle swelling AE is an edema AE that shows abnormal buildup of fluid in the ankles. Ankle swelling is a sign of fluid buildup or inflammation of the joint and tissues of the ankle. Mild ankle swelling is a common occurrence after standing for a long period.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/ankle-swelling</obo:IAO_0000119>
        <obo:OAE_0001849>踝部水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10002554</obo:OAE_0004334>
        <rdfs:label>ankle swelling AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0235439</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001861 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>Renal dysfunction AE is a kidney AE that has an outcome of reduced capacity to excrete metabolic products which accumulate systemically and are detectable clinicopathologically by renal function tests. The early stage of uremia.</obo:IAO_0000115>
        <obo:IAO_0000116>This term appears to be a synonym to the &apos;renal failure AE&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hepatic and renal function disorder AE</obo:IAO_0000118>
        <obo:OAE_0001849>肾功能障碍</obo:OAE_0001849>
        <rdfs:label>renal dysfunction AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0859242</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001862 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Epiphora AE is a eye AE that shows an overflow of tears onto the face. In this case, there is insufficient tear film drainage from the eyes, and the tears will drain down the face rather than through the nasolacrimal system.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Epiphora_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>泪溢</obo:OAE_0001849>
        <obo:OAE_0004334>10015068</obo:OAE_0004334>
        <rdfs:label>epiphora AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0152227</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001863 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>Hemolytic anemia AE is an anemia AE associated with hemolysis, the abnormal breakdown of red blood cells (RBCs), either in the blood vessels (intravascular hemolysis) or elsewhere in the human body (extravascular). Such an AE can be relatively harmless or life-threatening.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hemolytic_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>溶血性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10019493</obo:OAE_0004334>
        <rdfs:label>hemolytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001864 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>a behavioral and neurological AE where somniloquy also is called sleep-talking, a parasomnia that refers to talking aloud while asleep. Somniloquy can be quite loud, ranging from simple mumbling sounds to loud shouts and long frequently inarticulate speeches, and can occur many times during a sleep cycle. As with sleepwalking and night terrors, sleeptalking usually occurs during the less-deep delta-wave NREM sleep stages or during temporary arousals therefrom.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Somniloquy</obo:IAO_0000119>
        <obo:OAE_0001849>梦呓</obo:OAE_0001849>
        <rdfs:label>somniloquy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>Cholelithiasis AE is a liver, biliary, and pancreatic AE that shows hard deposits forming inside the gallbladder. Gallstones may be as small as a grain of sand or as large as a golf ball.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Gallstone</obo:IAO_0000119>
        <obo:OAE_0004334>10008629</obo:OAE_0004334>
        <rdfs:label>cholelithiasis AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C1328486</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001866 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Blepharoptosis AE is an eye AE that shows droopy upper eyelid or ptosis that presents with substantial blockage upper part of field of vision, risk of amblyopia among young children, and dramatic change in the facial appearance.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://eyewiki.aao.org/Blepharoptosis</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑下垂</obo:OAE_0001849>
        <obo:OAE_0004334>10005157</obo:OAE_0004334>
        <rdfs:label>blepharoptosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001874 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <obo:IAO_0000115>an epileptic seizure AE that is characterized by tonic-clonic seizures, involving two phases -- the tonic phase in which the body becomes rigid, and clonic phase in which there is uncontrolled jerking.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=32957</obo:IAO_0000119>
        <obo:OAE_0001849>癫痫大发作</obo:OAE_0001849>
        <obo:OAE_0004334>10018658</obo:OAE_0004334>
        <rdfs:label>grand mal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001875 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>Erythema simplex AE is an erythema AE that accompany with blushing or redness of the skin caused by a toxic reaction or a neurovascular phenomenon.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/erythema+simplex</obo:IAO_0000119>
        <obo:OAE_0001849>单纯性红斑</obo:OAE_0001849>
        <rdfs:label>erythema simplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001876 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Pelvic pain AE is a pain AE that occurs in the lower abdomen area. The pain might be steady, or it might come and go. If the pain is severe, it might get in the way of people&apos;s daily activities.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/pelvicpain.html</obo:IAO_0000119>
        <obo:OAE_0001849>骨盆痛</obo:OAE_0001849>
        <obo:OAE_0004334>10034263</obo:OAE_0004334>
        <rdfs:label xml:lang="en">pelvic pain AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13167</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C40122</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001877 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>Extrasystoles AE is an arrhythmia AE that shows a premature contraction of the heart that is independent of the normal rhythm of the heart and arises in response to an impulse in some part of the heart other than the normal impulse from the sinoatrial node. The extrasystole is followed by a pause, as the heart electrical system &quot;resets&quot; itself and the contraction following the pause is usually more forceful than normal.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=32159</obo:IAO_0000119>
        <obo:OAE_0001849>早搏（额外收缩）</obo:OAE_0001849>
        <obo:OAE_0004334>10015856</obo:OAE_0004334>
        <rdfs:label>extrasystoles AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001878 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>An increased upper airway secretion AE is a respiratory system AE characterized by an increased secretion at the upper airway location.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:OAE_0004334>10062717</obo:OAE_0004334>
        <rdfs:label xml:lang="en">increased upper airway secretion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001879 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000115>Feeling of body temperature change AE is a feeling abnormal AE that a patient feels a change in body temperature.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:OAE_0004334>10061458</obo:OAE_0004334>
        <rdfs:label xml:lang="en">feeling of body temperature change AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001880 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>Heartburn AE is a gastric disorder AE that also known as pyrosis, cardialgia, or acid indigestion. It&apos;s a burning sensation in the chest, just behind the breastbone or in the epigastrium, the upper central abdomen. The pain often rises in the chest and may radiate to the neck, throat, or angle of the jaw.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Heartburn</obo:IAO_0000119>
        <obo:OAE_0001849>胃灼热（烧心）</obo:OAE_0001849>
        <obo:OAE_0004334>10019326</obo:OAE_0004334>
        <rdfs:label>heartburn AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001881 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Tonsillitis AE is an inflammation AE that is inflammation of the tonsils most commonly caused by viral or bacterial infection. Symptoms may include sore throat and fever.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tonsillitis</obo:IAO_0000119>
        <obo:OAE_0001849>扁桃体炎</obo:OAE_0001849>
        <obo:OAE_0004334>10044008</obo:OAE_0004334>
        <rdfs:label>tonsillitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001882 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>Non-insulin-dependent diabetes mellitus AE is a diabetes mellitus AE which is also called diabetes mellitus type 2, it&apos;s characterized by hyperglycemia (high blood sugar) in the context of insulin resistance and relative lack of insulin.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Diabetes_mellitus_type_2</obo:IAO_0000119>
        <obo:OAE_0001849>非胰岛素依赖型糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10029505</obo:OAE_0004334>
        <rdfs:label>non-insulin-dependent diabetes mellitus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001883 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>Insulin dependent diabetes mellitus AE is a diabetes mellitus AE which is also called diabetes mellitus type 1. It results from the autoimmune destruction of the insulin-producing beta cells in the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Diabetes_mellitus_type_1</obo:IAO_0000119>
        <obo:OAE_0001849>胰岛素依赖型糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10022497</obo:OAE_0004334>
        <rdfs:label xml:lang="en">insulin dependent diabetes mellitus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001884 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003236"/>
        <obo:IAO_0000115>a hyporeflexia AE where the patient shows no sign of reflexes.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=20423</obo:IAO_0000119>
        <obo:OAE_0001849>反射消失</obo:OAE_0001849>
        <obo:OAE_0004334>10003084</obo:OAE_0004334>
        <rdfs:label>areflexia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001885 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>Mastauxea AE is a reproductive system AE that shows enlargement of the breast.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/mastauxe</obo:IAO_0000119>
        <obo:OAE_0001849>乳房增大</obo:OAE_0001849>
        <rdfs:label>mastauxe AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001886 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001778"/>
        <obo:IAO_0000115>Uveitis AE is an inflammation AE that is inflammation of the uvea, which lines the inside of the eye behind the cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Uveitis</obo:IAO_0000119>
        <obo:OAE_0001849>色素层炎</obo:OAE_0001849>
        <obo:OAE_0004334>10046851</obo:OAE_0004334>
        <rdfs:label xml:lang="en">uveitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10442</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C26909</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001887 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>Sexual dysfunctions AE is a reproductive system AE that is difficulty experienced by an individual or a couple during any stage of a normal sexual activity, including physical pleasure, desire, preference, arousal or orgasm.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>sexual malfunction AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sexual_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>性功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10040477</obo:OAE_0004334>
        <rdfs:label>sexual dysfunctions AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001888 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Hypomnesia AE is a behavior and neurological AE that is an archaic term applied to poor memory, the impaired ability to recall information previously memorized.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://psychology.wikia.com/wiki/Hypomnesia</obo:IAO_0000119>
        <obo:OAE_0001849>记忆减退</obo:OAE_0001849>
        <obo:OAE_0004334>10021035</obo:OAE_0004334>
        <rdfs:label>hypomnesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001889 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Phobia AE is a behavior and neurological AE that is a type of anxiety disorder, usually defined as a persistent fear of an object or situation in which the sufferer commits to great lengths in avoiding, typically disproportional to the actual danger posed, often being recognized as irrational.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Phobia</obo:IAO_0000119>
        <obo:OAE_0001849>恐惧症</obo:OAE_0001849>
        <obo:OAE_0004334>10034912</obo:OAE_0004334>
        <rdfs:label>phobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001890 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Lymphadenectasis AE is an edema AE that shows enlargement of the lymph node.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/lymphadenectasis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结肿大</obo:OAE_0001849>
        <obo:OAE_0004334>10025282</obo:OAE_0004334>
        <rdfs:label>lymphadenectasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001891 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <obo:IAO_0000115>Asterixis AE is a tremor AE that also called the flapping tremor, or liver flap, which is a tremor of the hand when the wrist is extended, sometimes said to resemble a bird flapping its wings. This motor disorder is characterized by an inability to actively maintain a position, which is demonstrated by jerking movements of the outstretched hands when bent upward at the wrist. The tremor is caused by abnormal function of the diencephalic motor centers in the brain, which regulate the muscles involved in maintaining position.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Asterixis</obo:IAO_0000119>
        <obo:OAE_0001849>扑翼样震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10003547</obo:OAE_0004334>
        <rdfs:label>asterixis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001892 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115>Parageusia AE is a gustatory system AE which is the medical term for a bad taste in the mouth. One common form of parageusia is a metallic taste of food. This can be a side effect of several medications, such as acetazolamide, eszopiclone, zopiclone, metronidazole, or etoposide. Metallic taste is also a type of dysgeusia which is frequently associated with infections in the mouth or upper airways.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parageusia</obo:IAO_0000119>
        <obo:OAE_0001849>味觉颠倒</obo:OAE_0001849>
        <obo:OAE_0004334>10033793</obo:OAE_0004334>
        <rdfs:label>parageusia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001893 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>Brain damage AE is a brain AE that also called brain injury is the destruction or degeneration of brain cells. In general, brain damage refers to significant, undiscriminating trauma-induced damage.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Brain_damage</obo:IAO_0000119>
        <obo:OAE_0001849>脑损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10056389</obo:OAE_0004334>
        <rdfs:label>brain damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001894 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>Frequent bowel movements AE is a abnormal stool AE that people are having more bowel movements than is normal for them. Often, frequent bowel movements are accompanied by diarrhea, the passage of loosely formed stool.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/frequent-bowel-movements</obo:IAO_0000119>
        <obo:OAE_0001849>大便频繁</obo:OAE_0001849>
        <obo:OAE_0004334>10017367</obo:OAE_0004334>
        <rdfs:label xml:lang="en">frequent bowel movements AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001895 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001647"/>
        <obo:IAO_0000115>Hyperprolactinemia AE is an endocrine investigation result abnormal AE that is the presence of abnormally high levels of prolactin in the blood. Normal levels are less than 500 mIU/L [20 ng/mL or µg/L] for women, and less than 450 mIU/L for men.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperprolactinaemia</obo:IAO_0000119>
        <obo:OAE_0001849>高泌乳素血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020739</obo:OAE_0004334>
        <rdfs:label>hyperprolactinemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001896 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001896">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>Galactorrhea AE is a reproductive system AE that is the spontaneous flow of milk from the breast, unassociated with childbirth or nursing.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Galactorrhea</obo:IAO_0000119>
        <obo:OAE_0001849>乳溢</obo:OAE_0001849>
        <obo:OAE_0004334>10017592</obo:OAE_0004334>
        <rdfs:label>galactorrhea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001897 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Sitophobia AE is a behavior and neurological AE that shows a morbid or insane dread of eating.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wiktionary.org/wiki/sitophobia</obo:IAO_0000119>
        <obo:OAE_0001849>畏食</obo:OAE_0001849>
        <rdfs:label xml:lang="en">sitophobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001898 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>Ejection murmur AE is a cardiac disorder AE which is due to turbulent forward flow across the right and left ventricular outflow tract, aortic or pulmonary valve, or through the aorta or pulmonary artery.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.cardiologysite.com/auscultation/html/ejection_murmurs.html</obo:IAO_0000119>
        <obo:OAE_0001849>收缩期喷射性杂音</obo:OAE_0001849>
        <rdfs:label>ejection murmur AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001899 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001130"/>
        <obo:IAO_0000115>Hypoactive sexual desire disorder AE is a libido disorder AE that is considered a sexual dysfunction and is characterized as a lack or absence of sexual fantasies and desire for sexual activity, as judged by a clinician.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hyposexuality AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypoactive_sexual_desire_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>性欲减退</obo:OAE_0001849>
        <obo:OAE_0004334>10020933</obo:OAE_0004334>
        <rdfs:label>hypoactive sexual desire disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001900 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001900">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Bigotry AE is a behavior and neurological AE that is a state of mind where a person strongly and unfairly dislikes other people, ideas, etc.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bigotry</obo:IAO_0000119>
        <obo:OAE_0001849>偏执</obo:OAE_0001849>
        <rdfs:label>bigotry AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001901 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Somnambulisma AE is a behavior and neurological AE that also known as sleepwalking or noctambulism, which is a sleep disorder belonging to the parasomnia family. It arise from the slow wave sleep stage in a state of low consciousness and perform activities that are usually performed during a state of full consciousness. These activities can be as benign as sitting up in bed, walking to the bathroom, and cleaning, or as hazardous as cooking, driving, violent gestures, grabbing at hallucinated objects, or even homicide.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>noctambulism AE</obo:IAO_0000118>
        <obo:IAO_0000118>sleepwalking AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sleepwalking</obo:IAO_0000119>
        <obo:OAE_0001849>梦游症</obo:OAE_0001849>
        <obo:OAE_0004334>10041347</obo:OAE_0004334>
        <rdfs:label>somnambulism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001902 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001902">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>Hyperphagia AE is an eating disorder AE that also called polyphagia. It&apos;s a medical sign meaning excessive hunger and abnormally large intake of solids by mouth. It can be caused by disorders such as diabetes, Kleine–Levin syndrome (a malfunction in the hypothalamus), the genetic disorders Prader–Willi syndrome, and Bardet–Biedl syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>polyphagia AE</obo:IAO_0000118>
        <obo:IAO_0000118>食欲过盛</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polyphagia</obo:IAO_0000119>
        <obo:OAE_0004334>10020710</obo:OAE_0004334>
        <rdfs:label>hyperphagia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001903 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Corneal pigmentation is a eye AE shows that  the melanin is in the superficial stroma and the basal layer of the corneal epithelium.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/corneal+pigmentation</obo:IAO_0000119>
        <obo:OAE_0001849>角膜色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10011040</obo:OAE_0004334>
        <rdfs:label>corneal pigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001904 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001904">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Chromatos AE is a skin AE shows that deposit of pigment in a normally unpigmented area or excessive pigmentation in a normally pigmented site.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.merriam-webster.com/medical/chromatosis</obo:IAO_0000119>
        <obo:OAE_0001849>色素沉着</obo:OAE_0001849>
        <rdfs:label>chromatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001905 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>Subclavian steal syndrome AE is an ischaemia AE that is a constellation of signs and symptoms that arise from retrograde (reversed) flow of blood in the vertebral artery or the internal thoracic artery, due to a proximal stenosis (narrowing) and/or occlusion of the subclavian artery. The arm may be supplied by blood flowing in a retrograde direction down the vertebral artery at the expense of the vertebrobasilar circulation. This is called the subclavian steal.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>subclavian steal phenomenon AE</obo:IAO_0000118>
        <obo:IAO_0000118>subclavian steal steno-occlusive disease AE</obo:IAO_0000118>
        <obo:OAE_0001849>锁骨下动脉盗血综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10042335</obo:OAE_0004334>
        <rdfs:label>subclavian steal syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001906 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001906">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000350"/>
        <obo:IAO_0000115>Allergic rhinitis AE is a rhinitis AE that is an allergic inflammation of the nasal airways. It occurs when an allergen, such as pollen, dust, or animal dander (particles of shed skin and hair) is inhaled by an individual with a sensitized immune system.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Allergic_rhinitis</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性鼻炎</obo:OAE_0001849>
        <obo:OAE_0004334>10001723</obo:OAE_0004334>
        <rdfs:label>allergic rhinitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13303</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C79532</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001907 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001907">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>Ventricular ectopic beats AE is a cardiac ventricular disorder AE that is a disturbance of the cardiac rhythm frequently related to the electrical conduction system of the heart, in which beats arise from fiber or group of fibers outside the region in the heart muscle ordinarily responsible for impulse formation.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ectopic_beat</obo:IAO_0000119>
        <obo:OAE_0001849>心室异位搏动</obo:OAE_0001849>
        <obo:OAE_0004334>10058291</obo:OAE_0004334>
        <rdfs:label>ventricular ectopic beats AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001908 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Sjogren syndrome AE is a eye AE that  is a chronic autoimmune disease in which the body&apos;s white blood cells destroy the exocrine glands, specifically the salivary and lacrimal glands, that produce saliva and tears, respectively.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sj%C3%B6gren&apos;s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>干燥综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10040767</obo:OAE_0004334>
        <rdfs:label xml:lang="en">sjogren syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001909 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>Nocturia AE is a urine abnormality AE that is defined by the International Continence Society as “the complaint that the individual has to wake at night one or more times for voiding”.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>nycturia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nocturia</obo:IAO_0000119>
        <obo:OAE_0001849>夜尿症</obo:OAE_0001849>
        <obo:OAE_0004334>10029446</obo:OAE_0004334>
        <rdfs:label>nocturia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001910 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000401"/>
        <obo:IAO_0000115>Night sweat is a sweating AE that is the occurrence of excessive sweating (hyperhidrosis and focal hyperhidrosis) during sleep. The sufferer may or may not also suffer from excessive perspiration while awake.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>sleep hyperhidrosis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Night_sweats</obo:IAO_0000119>
        <obo:OAE_0001849>夜汗</obo:OAE_0001849>
        <obo:OAE_0004334>10029409</obo:OAE_0004334>
        <rdfs:label>night sweat AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001911 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115>Increased appetite AE is a gustatory system AE that is when people want to eat much more often or in larger quantities than their body requires.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthline.com/symptom/increased-appetite</obo:IAO_0000119>
        <obo:OAE_0001849>食欲增加</obo:OAE_0001849>
        <obo:OAE_0004334>10021654</obo:OAE_0004334>
        <rdfs:label>increased appetite AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001912 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>Vascular dilatation headache AE is a headache AE that shows headache which caused by vascular dilatation.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.headaches.org/education/Headache_Topic_Sheets/Vascular_Headaches</obo:IAO_0000119>
        <obo:OAE_0001849>血管扩张性头痛</obo:OAE_0001849>
        <rdfs:label>vascular dilatation headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001913 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>Bundle-branch block AE is a conduction system disorder AE that refers to a defect of the heart&apos;s electrical conduction system.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bundle_branch_block</obo:IAO_0000119>
        <obo:OAE_0001849>束支传导阻滞</obo:OAE_0001849>
        <obo:OAE_0004334>10006578</obo:OAE_0004334>
        <rdfs:label>bundle-branch block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001914 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001914">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>Unstable diabetes AE is a diabetes mellitus AE that is a type of diabetes when a person&apos;s blood glucose level often swings quickly from high to low and from low to high.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>brittle diabetes AE</obo:IAO_0000118>
        <obo:IAO_0000118>labile diabetes AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=7271</obo:IAO_0000119>
        <obo:OAE_0001849>不稳定型糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10006372</obo:OAE_0004334>
        <rdfs:label>unstable diabetes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001915 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>Tendon rupture AE is a tendon disorder AE shows a tearing of the tendon that occurs when the forces placed upon the tendon exceed its tensile strength.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Tendon+rupture</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱断裂</obo:OAE_0001849>
        <obo:OAE_0004334>10043248</obo:OAE_0004334>
        <rdfs:label>tendon rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001916 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Tendovaginitis AE is an inflammation AE that is an acute or chronic inflammation of the tendon sheath, occurring in the region of the hand, the wrist joint, the forearm (radial and ulnar tenobursitis), the foot, the ankle joint, and the Achilles tendon (achillobursitis).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>tenovaginitis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://encyclopedia2.thefreedictionary.com/Tendovaginitis</obo:IAO_0000119>
        <obo:OAE_0001849>腱鞘炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067216</obo:OAE_0004334>
        <rdfs:label>tendovaginitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001917 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>Loose stools AE is a abnormal stool AE that is usually a form of diarrhea and many conditions causing loose stool will be listed under diarrhea. It may also be related to watery stool (also within the spectrum of diarrhea).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/loose_stool.htm</obo:IAO_0000119>
        <obo:OAE_0001849>稀便</obo:OAE_0001849>
        <obo:OAE_0004334>10024840</obo:OAE_0004334>
        <rdfs:label>loose stools AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001918 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001918">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Cystitis AE is an inflammation AE that is the medical term for inflammation of the bladder. Most of the time, the inflammation is caused by a bacterial infection, and it&apos;s called a urinary tract infection.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/cystitis/basics/definition/con-20024076</obo:IAO_0000119>
        <obo:OAE_0001849>膀胱炎</obo:OAE_0001849>
        <obo:OAE_0004334>10011781</obo:OAE_0004334>
        <rdfs:label>cystitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001919 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001919">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>Eructation AE is a digestive system AE that is the release of gas from the digestive tract (mainly esophagus and stomach) through the mouth. It is usually accompanied with a typical sound and, at times, an odor.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>belching AE</obo:IAO_0000118>
        <obo:IAO_0000118>burping AE</obo:IAO_0000118>
        <obo:IAO_0000118>ructus AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Burping</obo:IAO_0000119>
        <obo:OAE_0001849>嗳气</obo:OAE_0001849>
        <obo:OAE_0004334>10015137</obo:OAE_0004334>
        <rdfs:label>eructation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001920 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <obo:IAO_0000115>Glossolalia AE is a speech disorder AE that is the fluid vocalizing of speech-like syllables that lack any readily comprehended meaning.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Glossolalia</obo:IAO_0000119>
        <obo:OAE_0001849>语言不清</obo:OAE_0001849>
        <rdfs:label>glossolalia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001921 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Leg pain AE is a pain AE that  is a common problem in leg, it can be due to a cramp, injury, or other cause.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003182.htm</obo:IAO_0000119>
        <obo:OAE_0001849>腿痛</obo:OAE_0001849>
        <obo:OAE_0004334>10024130</obo:OAE_0004334>
        <rdfs:label>leg pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001922 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000402"/>
        <obo:IAO_0000115>Stomachache AE is a pain AE that  the pain in or near your stomach. It is a common symptom associated with transient disorders or serious disease.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>abdominal pain AE</obo:IAO_0000118>
        <obo:IAO_0000118>stomach pain AE</obo:IAO_0000118>
        <obo:IAO_0000118>stomachache AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abdominal_pain
http://www.nhs.uk/conditions/stomach-ache-abdominal-pain/Pages/Introduction.aspx</obo:IAO_0000119>
        <obo:OAE_0001849>胃痛</obo:OAE_0001849>
        <obo:OAE_0004334>10042126</obo:OAE_0004334>
        <rdfs:label>stomach ache AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10460</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C26682</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001923 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>Conduction block AE is a conduction system disorder AE that shows failure of impulse transmission at some point along a nerve fiber, although conduction along the segments proximal and distal to it are unaffected.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=10757</obo:IAO_0000119>
        <obo:OAE_0001849>传导阻滞</obo:OAE_0001849>
        <rdfs:label>conduction block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001924 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>Photodermatitis AE is a dermatitis AE that referred to as sun poisoning or photoallergy, is a form of allergic contact dermatitis in which the allergen must be activated by light to sensitize the allergic response, and to cause a rash or other systemic effects on subsequent exposure.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Photodermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>光敏性皮炎</obo:OAE_0001849>
        <rdfs:label>photodermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001925 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Pygalgia AE is a pain AE that  is a rarely used term meaning pain in the buttocks.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=74312</obo:IAO_0000119>
        <obo:OAE_0001849>臀痛</obo:OAE_0001849>
        <rdfs:label>pygalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001926 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>Throat irritation AE is a discomfort AE that refers to a dry cough, a scratchy feeling at the back of the throat, or a sensation of a lumpy feeling or something stuck at the back of the throat.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>throat discomfort AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Throat_irritation</obo:IAO_0000119>
        <obo:OAE_0001849>咽喉不适</obo:OAE_0001849>
        <obo:OAE_0004334>10043521</obo:OAE_0004334>
        <rdfs:label>throat irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001927 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Interstitial nephritis AE is an inflammation AE that is a form of nephritis affecting the interstitium of the kidneys surrounding the tubules. This disease can be either acute, meaning it occurs suddenly, or chronic, meaning it is ongoing and eventually ends in kidney failure.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>tubulointerstitial nephritis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Interstitial_nephritis</obo:IAO_0000119>
        <obo:OAE_0001849>间质肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048302</obo:OAE_0004334>
        <rdfs:label>interstitial nephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001928 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000484"/>
        <obo:IAO_0000115>Hoarseness AE is a hoarseness AE that refers to a difficulty making sounds when trying to speak. Vocal sounds may be weak, breathy, scratchy, or husky, and the pitch or quality of the voice may change.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003054.htm</obo:IAO_0000119>
        <obo:OAE_0001849>声音嘶哑</obo:OAE_0001849>
        <obo:OAE_0004334>10020201</obo:OAE_0004334>
        <rdfs:label>hoarseness AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13384</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C47813</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001929 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <obo:IAO_0000115>Photosensitization AE is a hypersensitivity AE that refers to  development of abnormally heightened reactivity of the skin or eyes to sunlight.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/photosensitization</obo:IAO_0000119>
        <obo:OAE_0001849>光敏</obo:OAE_0001849>
        <rdfs:label>photosensitization AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001930 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>Fanconi syndrome AE is a kidney AE that is a disease of the proximal renal tubules of the kidney in which glucose, amino acids, uric acid, phosphate and bicarbonate are passed into the urine, instead of being reabsorbed.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Fanconi_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>范可尼综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10016219</obo:OAE_0004334>
        <rdfs:label>fanconi syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001931 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Keratoconjunctivitis AE is an inflammation AE that is inflammation of the cornea and conjunctiva. When only the cornea is inflamed, it is called keratitis; when only the conjunctiva is inflamed, it is called conjunctivitis.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Keratoconjunctivitis</obo:IAO_0000119>
        <obo:OAE_0001849>角膜结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10023348</obo:OAE_0004334>
        <rdfs:label>keratoconjunctivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001932 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>Hepatic insufficiency AE is a liver disorder AE that shows a failure or partial failure of normal liver function.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hepatic+insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>肝功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10056542</obo:OAE_0004334>
        <rdfs:label>hepatic insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001933 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001623"/>
        <obo:IAO_0000115>Hypoxemia AE is a blood gas investigation result abnormal AE that is an abnormally low level of oxygen in the blood. More specifically, it is oxygen deficiency in arterial blood.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypoxemia</obo:IAO_0000119>
        <obo:OAE_0001849>低血氧症</obo:OAE_0001849>
        <obo:OAE_0004334>10021142</obo:OAE_0004334>
        <rdfs:label>hypoxemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001934 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>Irritant contact dermatitis AE is a dermatitis AE that is a form of contact dermatitis that can be divided into forms caused by chemical irritants and those caused by physical irritants.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Irritant_contact_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>刺激性接触性皮炎</obo:OAE_0001849>
        <rdfs:label>irritant contact dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001935 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Pitting edema AE is an edema AE that shows observable swelling of body tissues due to fluid accumulation that may be demonstrated by applying pressure to the swollen area (such as by depressing the skin with a finger).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=88528</obo:IAO_0000119>
        <obo:OAE_0001849>指压性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10054547</obo:OAE_0004334>
        <rdfs:label>pitting edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001936 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000462"/>
        <obo:IAO_0000115>Acute bronchitis AE is a bronchitis AE that is an inflammation of the large bronchi (medium-size airways) in the lungs that is usually caused by viruses or bacteria and may last several days or weeks. Characteristic symptoms include cough, sputum (phlegm) production, and shortness of breath and wheezing related to the obstruction of the inflamed airways.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acute_bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10000687</obo:OAE_0004334>
        <rdfs:label>acute bronchitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001937 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>Renal calculus AE is a kidney AE that is a solid concretion or crystal aggregation formed in the kidneys from minerals in the urine. Kidney stones typically leave the body by passage in the urine stream, and many stones are formed and passed without causing symptoms. If stones grow to sufficient size (usually at least 3 millimeters (0.12 in)) they can cause blockage of the ureter. This leads to pain, most commonly beginning in the flank or lower back and often radiating to the groin or genitals.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>CTCAE: E13018</obo:IAO_0000118>
        <obo:IAO_0000118>NCIt: C26807</obo:IAO_0000118>
        <obo:IAO_0000118>kidney stone AE</obo:IAO_0000118>
        <obo:IAO_0000118>nephrolithiasis AE</obo:IAO_0000118>
        <obo:IAO_0000118>renal calculi AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Kidney_stone</obo:IAO_0000119>
        <obo:OAE_0001849>肾结石</obo:OAE_0001849>
        <obo:OAE_0004334>10038385</obo:OAE_0004334>
        <obo:OAE_0004334>10038386</obo:OAE_0004334>
        <rdfs:label>renal calculus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001938 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>Clouding of consciousness AE is a sensory capability AE that is a term used in conventional medicine denoting an abnormality in the &quot;regulation&quot; of the &quot;overall level&quot; of consciousness that is mild and less severe than a delirium. The sufferer experiences a subjective sensation of mental clouding described as feeling &quot;foggy&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>brain fog AE</obo:IAO_0000118>
        <obo:IAO_0000118>mental fog AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Clouding_of_consciousness</obo:IAO_0000119>
        <obo:OAE_0001849>意识模糊</obo:OAE_0001849>
        <rdfs:label>clouding of consciousness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001939 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <obo:IAO_0000115>Reflex tachycardia AE is a tachycardia AE that shows increased heart rate in response to some stimulus conveyed through the cardiac nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=89526</obo:IAO_0000119>
        <obo:OAE_0001849>反射性心动过速</obo:OAE_0001849>
        <obo:OAE_0004334>10063096</obo:OAE_0004334>
        <rdfs:label>reflex tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001940 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>Joint sprain AE is a joint disorder AE that is damage to one or more ligaments in a joint, often caused by trauma or the joint being taken beyond its functional range of motion.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sprain</obo:IAO_0000119>
        <obo:OAE_0001849>关节扭伤</obo:OAE_0001849>
        <obo:OAE_0004334>10023229</obo:OAE_0004334>
        <rdfs:label>joint sprain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001941 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Epicondylitis AE is an inflammation AE that is a type of musculoskeletal disorder that refers to an inflammation of an epicondyle.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Epicondylitis</obo:IAO_0000119>
        <obo:OAE_0001849>上髁炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014971</obo:OAE_0004334>
        <rdfs:label>epicondylitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001942 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>Melanoglosia AE is a tongue AE that shows tongue turn black. Any blackening of the tongue associated with certain disorders and diseases in animals and humans.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://encyclopedia2.thefreedictionary.com/melanoglosia</obo:IAO_0000119>
        <obo:OAE_0001849>舌黑</obo:OAE_0001849>
        <obo:OAE_0004334>10014971</obo:OAE_0004334>
        <rdfs:label>melanoglosia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001943 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <obo:IAO_0000115>Ventricular tachycardia AE is a tachycardia AE that is a type of tachycardia, or a rapid heart beat that arises from improper electrical activity of the heart presenting as a rapid heart rhythm, that starts in the bottom chambers of the heart, called the ventricles.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ventricular_tachycardia</obo:IAO_0000119>
        <obo:OAE_0001849>心室性心搏过速</obo:OAE_0001849>
        <obo:OAE_0004334>10047302</obo:OAE_0004334>
        <rdfs:label>ventricular tachycardia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10239</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C50802</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001944 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000210"/>
        <obo:IAO_0000115>Granulomatous hepatitis AE is a hepatitis AE that refers to an inflammatory liver disease associated with granuloma formation in the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://radiopaedia.org/articles/granulomatous-hepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>肉芽肿性肝炎</obo:OAE_0001849>
        <rdfs:label>granulomatous hepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001945 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115>Hypogeusia AE is a gustatory system AE that is a reduced ability to taste things (to taste sweet, sour, bitter, or salty substances).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypogeusia</obo:IAO_0000119>
        <obo:OAE_0001849>味觉减弱</obo:OAE_0001849>
        <obo:OAE_0004334>10020989</obo:OAE_0004334>
        <rdfs:label>hypogeusia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001946 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Dysphoria AE is a behavior and neurological AE that is a profound state of unease or dissatisfaction. In a psychiatric context, dysphoria may accompany depression, anxiety, or agitation. Common reactions to dysphoria include emotional distress or indifference.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Dysphoria</obo:IAO_0000119>
        <obo:OAE_0001849>烦躁不安</obo:OAE_0001849>
        <obo:OAE_0004334>10013954</obo:OAE_0004334>
        <rdfs:label>dysphoria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001947 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Oneirism AE is a behavior and neurological AE that is a state of abnormal consciousness in which dream-like experiences and hallucinations happen while awake.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wiktionary.org/wiki/oneirism</obo:IAO_0000119>
        <obo:OAE_0001849>梦幻症</obo:OAE_0001849>
        <obo:OAE_0004334>10030332</obo:OAE_0004334>
        <rdfs:label>oneirism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001948 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Podalgia AE is a pain AE that  shows pain in the foot.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wiktionary.org/wiki/podalgia</obo:IAO_0000119>
        <obo:OAE_0001849>足痛</obo:OAE_0001849>
        <rdfs:label>podalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001949 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Brachialgia AE is a pain AE that  shows pain in the arm.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wiktionary.org/wiki/brachialgia</obo:IAO_0000119>
        <obo:OAE_0001849>臂痛</obo:OAE_0001849>
        <obo:OAE_0004334>10068901</obo:OAE_0004334>
        <rdfs:label>brachialgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001950 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Coxalgia AE is a pain AE that  shows pain in the hip.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wiktionary.org/wiki/coxalgia</obo:IAO_0000119>
        <obo:OAE_0001849>髋痛</obo:OAE_0001849>
        <obo:OAE_0004334>10011249</obo:OAE_0004334>
        <rdfs:label>coxalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001951 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>Limb injury AE is an injury AE which involve damage to bones, joints, ligament, musles, the major blood vessels and nerves of the limb.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>肢体伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061225</obo:OAE_0004334>
        <rdfs:label>limb injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001952 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <obo:IAO_0000115>Polymyalgia rheumatica AE is a muscle pain AE that is a syndrome with pain or stiffness, usually in the neck, shoulders, and hips. The pain can be very sudden, or can occur gradually over a period. It may be caused by an inflammatory condition of blood vessels such as temporal arteritis.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polymyalgia_rheumatica</obo:IAO_0000119>
        <obo:OAE_0001849>风湿性多发性肌痛</obo:OAE_0001849>
        <obo:OAE_0004334>10036099</obo:OAE_0004334>
        <rdfs:label>polymyalgia rheumatica AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001953 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <obo:IAO_0000115>Fibromyalgia AE is a muscle pain AE that is characterised by chronic widespread pain and allodynia (a heightened and painful response to pressure). Fibromyalgia symptoms are not restricted to pain, leading to the use of the alternative term fibromyalgia syndrome for the condition. Other symptoms include debilitating fatigue, sleep disturbance, and joint stiffness.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Fibromyalgia</obo:IAO_0000119>
        <obo:OAE_0001849>纤维肌痛</obo:OAE_0001849>
        <obo:OAE_0004334>10048439</obo:OAE_0004334>
        <rdfs:label>fibromyalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001954 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000494"/>
        <obo:IAO_0000115>Hepatic encephalopathy AE is an encephalopathy AE that  is the occurrence of confusion, altered level of consciousness, and coma as a result of liver failure. In the advanced stages it is called hepatic coma or coma hepaticum.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>portosystemic encephalopathy AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hepatic_encephalopathy</obo:IAO_0000119>
        <obo:OAE_0004334>10019660</obo:OAE_0004334>
        <rdfs:label>hepatic encephalopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001955 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>a behavior and neurological AE AE that is an abnormal involuntary movement disorder, one of a group of neurological disorders called dyskinesias.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>choreia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Chorea</obo:IAO_0000119>
        <obo:OAE_0001849>舞蹈症</obo:OAE_0001849>
        <obo:OAE_0004334>10008748</obo:OAE_0004334>
        <rdfs:label>chorea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001956 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>Nightmare AE is a sleep disorder AE that is an unpleasant dream that can cause a strong emotional response from the mind, typically fear or horror but also despair, anxiety and great sadness.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nightmare</obo:IAO_0000119>
        <obo:OAE_0001849>梦魇</obo:OAE_0001849>
        <obo:OAE_0004334>10029412</obo:OAE_0004334>
        <rdfs:label>nightmare AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001957 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that is an anomaly of self-awareness. It consists of a feeling of watching oneself act, while having no control over a situation. Subjects feel they have changed, and the world has become vague, dreamlike, less real, or lacking in significance. It can be a disturbing experience, since many feel that, indeed, they are living in a &quot;dream&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>depersonalisation AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Depersonalization</obo:IAO_0000119>
        <obo:OAE_0001849>人格解体</obo:OAE_0001849>
        <obo:OAE_0004334>10012359</obo:OAE_0004334>
        <rdfs:label>depersonalization AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001958 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that refers to a state of mind where one is not disturbed by the passions.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>apathia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Apatheia</obo:IAO_0000119>
        <obo:OAE_0001849>情感冷漠</obo:OAE_0001849>
        <rdfs:label>apatheia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001959 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>Parosmia AE is a sensory capability AE that is an olfactory dysfunction which is characterized by the inability of the brain to properly identify an odor’s “natural” smell.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>cacosmia AE</obo:IAO_0000118>
        <obo:IAO_0000118>troposmia AE</obo:IAO_0000118>
        <obo:IAO_0000118>味觉倒错</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parosmia</obo:IAO_0000119>
        <obo:OAE_0004334>10034018</obo:OAE_0004334>
        <rdfs:label>parosmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001960 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Xerophthalmia AE is an eye AE that is a medical condition in which the eye fails to produce tears.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>xerophthalmus AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Xerophthalmia</obo:IAO_0000119>
        <obo:OAE_0001849>干眼病</obo:OAE_0001849>
        <obo:OAE_0004334>10048221</obo:OAE_0004334>
        <rdfs:label>xerophthalmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001961 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>Chondropathy AE is a bone disorder AE that refers to a disease of the cartilage. It is frequently divided into 5 grades, with 0-2 defined as normal, and 3-4 defined as diseased.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Chondropathy</obo:IAO_0000119>
        <obo:OAE_0001849>软骨病</obo:OAE_0001849>
        <obo:OAE_0004334>10061762</obo:OAE_0004334>
        <rdfs:label>chondropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001962 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>Teratogenesis AE is a female reproductive system AE that is a prenatal toxicity characterized by structural or functional defects in the developing embryo or fetus. It also includes intrauterine growth retardation, death of the embryo or fetus, and transplacental carcinogenesis.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.britannica.com/EBchecked/topic/587782/teratogenesis</obo:IAO_0000119>
        <obo:OAE_0001849>畸胎</obo:OAE_0001849>
        <rdfs:label>teratogenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001963 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>Premature atrial contraction AE is an arrhythmia AE that is a common cardiac dysrhythmia characterized by premature heartbeats originating in the atria.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>atrial premature beats AE</obo:IAO_0000118>
        <obo:IAO_0000118>atrial premature complexes AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Premature_atrial_contraction</obo:IAO_0000119>
        <obo:OAE_0001849>早搏</obo:OAE_0001849>
        <obo:OAE_0004334>10056964</obo:OAE_0004334>
        <rdfs:label>premature atrial contraction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001964 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>An inflammation AE that courrs in one or both parotid glands, the major salivary glands located on either side of the face, in humans. The parotid gland is the salivary gland most commonly affected by inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parotitis</obo:IAO_0000119>
        <obo:OAE_0001849>腮腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034038</obo:OAE_0004334>
        <rdfs:label>parotitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001965 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Glossitis AE is an inflammation AE that can mean soreness of the tongue, or more usually inflammation with depapillation of the dorsal surface of the tongue, leaving a smooth and erythematous surface.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Glossitis</obo:IAO_0000119>
        <obo:OAE_0001849>舌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10018386</obo:OAE_0004334>
        <rdfs:label>glossitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001966 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Genital edema AE is an edema AE that can be the result of interruption to the lymphatic drainage of this area caused by tumor, surgical removal of lymph nodes, radiotherapy or infection. Congenital disorders causing inadequate lymphatics can sometimes lead to the development of this condition.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.lymphoedemanz.org.nz/About+Lymphoedema/Genital+Oedema.html</obo:IAO_0000119>
        <obo:OAE_0001849>生殖器水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10018146</obo:OAE_0004334>
        <rdfs:label>genital edema AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13111</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C78324</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001967 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001967">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>Orgasm incapacity AE is a reproductive system AE that the disorder characterized by an inability to achieve orgasm.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>缺乏性高潮</obo:OAE_0001849>
        <rdfs:label>orgasm incapacity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001968 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Sedation AE is a behavior and neurological AE that is the reduction of irritability or agitation by administration of sedative drugs, generally to facilitate a medical procedure or diagnostic procedure.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sedation</obo:IAO_0000119>
        <obo:OAE_0001849>镇静</obo:OAE_0001849>
        <obo:OAE_0004334>10039897</obo:OAE_0004334>
        <rdfs:label>sedation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001969 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000218"/>
        <obo:IAO_0000115>Sinus bradycardia AE is a bradycardia AE that is a heart rhythm that originates from the sinus node and has a rate that is lower than normal. In humans, bradycardia is generally defined to be a rate of under 60 beats per minute.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinus_bradycardia</obo:IAO_0000119>
        <obo:OAE_0001849>窦性心动过缓</obo:OAE_0001849>
        <obo:OAE_0004334>10040741</obo:OAE_0004334>
        <rdfs:label>sinus bradycardia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10208</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C26923</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001970 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>Cardiac output decreased AE is a cardiac disorder AE that shows a state in which the blood pumped by an individual&apos;s heart is sufficiently reduced that it is inadequate to meet the needs of the body&apos;s tissues. Cardiac output is the volume of blood being pumped by the heart, in particular by a left or right ventricle in the time interval of one minute.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www1.us.elsevierhealth.com/MERLIN/Gulanick/archive/Constructor/gulanick10.html
http://en.wikipedia.org/wiki/Cardiac_output</obo:IAO_0000119>
        <obo:OAE_0001849>心输出量减少</obo:OAE_0001849>
        <obo:OAE_0004334>10007595</obo:OAE_0004334>
        <rdfs:label>cardiac output decreased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001971 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>Steatorrhea AE is a digestive system AE that is the presence of excess fat in feces. Stools may also float due to excess lipid, have an oily appearance and can be especially foul-smelling.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>steatorrhoea AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Steatorrhea</obo:IAO_0000119>
        <obo:OAE_0001849>脂溢</obo:OAE_0001849>
        <obo:OAE_0004334>10041968</obo:OAE_0004334>
        <rdfs:label>steatorrhea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001972 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001972">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>Malabsorption syndrome AE is a digestive system AE that refers to a number of disorders in which the intestine’s ability to absorb certain nutrients, such as vitamin B12 and iron, into the bloodstream is negatively affected.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthline.com/health/malabsorption#Overview1</obo:IAO_0000119>
        <obo:OAE_0001849>吸收不良综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10025479</obo:OAE_0004334>
        <rdfs:label>malabsorption syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001973 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Sialadenitis AE is an inflammation AE that is inflammation of a salivary gland. It may be subdivided temporally into acute, chronic and recurrent forms.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sialadenitis</obo:IAO_0000119>
        <obo:OAE_0001849>唾液腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10040627</obo:OAE_0004334>
        <rdfs:label>sialadenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001974 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>a nervous system AE that shows a degenerative disorder of the central nervous system. The motor symptoms of Parkinson&apos;s disease result from the death of dopamine-generating cells in the substantia nigra, a region of the midbrain, the cause of this cell death is unknown.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>choreia AE</obo:IAO_0000118>
        <obo:IAO_0000118>hypokinetic rigid syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000118>idiopathic/primary parkinsonism AE</obo:IAO_0000118>
        <obo:IAO_0000118>paralysis agitans AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parkinson&apos;s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>帕金森综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10061536</obo:OAE_0004334>
        <rdfs:label>parkinson&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001975 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001975">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>Urinary calculus AE a urinary system AE that is solid particles in the urinary system. They may cause pain, nausea, vomiting, hematuria, and, possibly, chills and fever due to secondary infection.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>urinary calculi AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.merckmanuals.com/professional/genitourinary_disorders/urinary_calculi/urinary_calculi.html</obo:IAO_0000119>
        <obo:OAE_0001849>尿结石</obo:OAE_0001849>
        <obo:OAE_0004334>10046531</obo:OAE_0004334>
        <rdfs:label>urinary calculus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001976 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>Sinoatrial block AE is a conduction system disorder AE that shows the electrical impulse is delayed or blocked on the way to the atria, thus delaying atrial depolarization.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinoatrial_block</obo:IAO_0000119>
        <obo:OAE_0001849>窦房阻滞</obo:OAE_0001849>
        <obo:OAE_0004334>10040736</obo:OAE_0004334>
        <rdfs:label>sinoatrial block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001977 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>Hyperthyroidism AE is an endocrine system AE that is a condition in which the thyroid gland produces and secretes excessive amounts of the free (not protein bound circulating in the blood) thyroid hormones -triiodothyronine (T3) and/or thyroxine (T4).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperthyroidism</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺机能亢进</obo:OAE_0001849>
        <obo:OAE_0004334>10020850</obo:OAE_0004334>
        <rdfs:label>hyperthyroidism AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10322</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C3123</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001978 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001978">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Akathisia AE is a behavior and neurological AE that is a movement disorder characterized by a feeling of inner restlessness and a compelling need to be in constant motion, as well as by actions such as rocking while standing or sitting, lifting the feet as if marching on the spot, and crossing and uncrossing the legs while sitting. People with akathisia are unable to sit or keep still, complain of restlessness, fidget, rock from foot to foot, and pace.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>acathisia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Akathisia</obo:IAO_0000119>
        <obo:OAE_0001849>静坐困难</obo:OAE_0001849>
        <obo:OAE_0004334>10001540</obo:OAE_0004334>
        <rdfs:label>akathisia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12581</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C78163</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001979 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001979">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Retinopathy AE is an eye AE that is due to persistent or acute damage to the retina of the eye. Ongoing inflammation and vascular remodeling may occur over periods of time where the patient is not fully aware of the extent of the disease. Frequently, retinopathy is an ocular manifestation of systemic disease as seen in diabetes or hypertension.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Retinopathy</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10038923</obo:OAE_0004334>
        <rdfs:label>retinopathy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10432</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C62601</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001980 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001980">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>Sinus arrest AE is an arrhythmia AE that is a medical condition wherein the sinoatrial node of the heart transiently ceases to generate the electrical impulses that normally stimulate the myocardial tissues to contract and thus the heart to beat. It is defined as lasting from 2.0 seconds to several minutes.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>sinoatrial arrest AE</obo:IAO_0000118>
        <obo:IAO_0000118>sinus pause AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinoatrial_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>窦性停搏</obo:OAE_0001849>
        <obo:OAE_0004334>10040738</obo:OAE_0004334>
        <rdfs:label>sinus arrest AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001981 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000909"/>
        <obo:IAO_0000115>ST segment depression AE is an electrocardiogram result abnormal AE that refers to a finding on an electrocardiogram. It may be determined by measuring the vertical distance between the patient&apos;s trace and the isoelectric line at a location 2-3 millimeters from the QRS complex. It is significant if it is more than 1 mm in V5-V6, or 1.5 mm in AVF or III.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/ST_depression</obo:IAO_0000119>
        <obo:OAE_0001849>ST段下降</obo:OAE_0001849>
        <obo:OAE_0004334>10041892</obo:OAE_0004334>
        <rdfs:label>ST segment depression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001982 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000909"/>
        <obo:IAO_0000115>T-wave inversion AE is an electrocardiogram result abnormal AE that can be a sign of coronary ischemia, Wellens&apos; syndrome, left ventricular hypertrophy, or CNS disorder. In electrocardiography, the T wave represents the repolarization (or recovery) of the ventricles.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/T_wave</obo:IAO_0000119>
        <obo:OAE_0001849>T波倒置</obo:OAE_0001849>
        <obo:OAE_0004334>10042966</obo:OAE_0004334>
        <rdfs:label>T-wave inversion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001983 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000624"/>
        <obo:IAO_0000115>Hyperthermia AE is an abnormal body temperature AE that is elevated body temperature due to failed thermoregulation that occurs when a body produces or absorbs more heat than it dissipates. Extreme temperature elevation then becomes a medical emergency requiring immediate treatment to prevent disability or death.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, SJ</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperthermia</obo:IAO_0000119>
        <obo:OAE_0001849>体温过高</obo:OAE_0001849>
        <obo:OAE_0004334>10020843</obo:OAE_0004334>
        <rdfs:label>hyperthermia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001984 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>Priapism AE a male reproductive system AE that is a potentially painful medical condition in which the erect penis does not return to its flaccid state, despite the absence of both physical and psychological stimulation, within four hours.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Priapism</obo:IAO_0000119>
        <obo:OAE_0001849>阴茎持续勃起</obo:OAE_0001849>
        <obo:OAE_0004334>10036661</obo:OAE_0004334>
        <rdfs:label>priapism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001985 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>Gingival bleeding AE is a hemorrhage AE that is a term used by dentists and dental hygienists when referring to bleeding that is induced by gentle manipulation of the tissue at the depth of the gingival sulcus, or interface between the gingiva and a tooth. Bleeding on probing, often abbreviated BOP, is a sign of inflammation and indicates some sort of destruction and erosion to the lining of the sulcus or the ulceration of sulcular epithelium. The blood comes from lamina propria after the ulceration of the lining.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>bleeding gums AE</obo:IAO_0000118>
        <obo:IAO_0000118>bleeding on probing AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bleeding_on_probing</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈出血</obo:OAE_0001849>
        <obo:OAE_0004334>10018276</obo:OAE_0004334>
        <rdfs:label>gingival bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001986 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>a hearing disorder AE that is a partial or total inability to hear. In children it may affect the development of language and can cause work related difficulties for adults.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>anacusis AE</obo:IAO_0000118>
        <obo:IAO_0000118>deafness AE</obo:IAO_0000118>
        <obo:IAO_0000118>hard of hearing AE</obo:IAO_0000118>
        <obo:IAO_0000118>hearing impaired AE</obo:IAO_0000118>
        <obo:IAO_0000118>hearing impairment AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>听力下降</obo:OAE_0001849>
        <obo:OAE_0004334>10019245</obo:OAE_0004334>
        <obo:OAE_0004334>10019246</obo:OAE_0004334>
        <rdfs:label>hearing loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10276</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C50576</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001987 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>Muscle fatigue AE is a muscle adverse event that is the decline in ability of a muscle to generate force. It can be a result of vigorous exercise but abnormal fatigue may be caused by barriers to or interference with the different stages of muscle contraction.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>physical fatigue AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Muscle_fatigue</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉疲劳</obo:OAE_0001849>
        <obo:OAE_0004334>10049565</obo:OAE_0004334>
        <rdfs:label>muscle fatigue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001988 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>Regurgitation AE is a digestive system AE that is the expulsion of material from the pharynx, or esophagus, usually characterized by the presence of undigested food or blood.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.wikipedia.org/wiki/Regurgitation_%28digestion%29</obo:IAO_0000119>
        <obo:OAE_0001849>反胃</obo:OAE_0001849>
        <obo:OAE_0004334>10067171</obo:OAE_0004334>
        <rdfs:label>regurgitation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001989 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Skin irritation AE is a skin AE that is a mild inflammatory dermal tissue reaction, it can be caused by physical contact with an irritant or can be a local response to a systemic trigger.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>皮肤刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10040880</obo:OAE_0004334>
        <rdfs:label>skin irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001990 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>a herpes viral infection AE tha is caused by both Herpes simplex virus type 1 (HSV-1) and type 2 (HSV-2).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>herpes catarrhalis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Herpes_simplex</obo:IAO_0000119>
        <obo:OAE_0001849>单纯疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10019948</obo:OAE_0004334>
        <rdfs:label>herpes simplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001991 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>Measles AE is a viral infection AE is an infection of the respiratory system, immune system and skin caused by a virus, specifically a paramyxovirus of the genus Morbillivirus.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>English measles AE</obo:IAO_0000118>
        <obo:IAO_0000118>morbilli AE</obo:IAO_0000118>
        <obo:IAO_0000118>rubeola AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Measles</obo:IAO_0000119>
        <obo:OAE_0001849>麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10027011</obo:OAE_0004334>
        <rdfs:label>measles AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001992 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001591"/>
        <obo:IAO_0000115>Hypercholesteremia AE is a blood cholesterol abnormal AE that is the presence of high levels of cholesterol in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>cholesterol high AE</obo:IAO_0000118>
        <obo:IAO_0000118>dyslipidemia</obo:IAO_0000118>
        <obo:IAO_0000118>hypercholesterolemia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypercholesterolemia</obo:IAO_0000119>
        <obo:OAE_0001849>高胆固醇血症</obo:OAE_0001849>
        <obo:OAE_0004334>10005425</obo:OAE_0004334>
        <obo:OAE_0004334>10008661</obo:OAE_0004334>
        <obo:OAE_0004334>10020604</obo:OAE_0004334>
        <rdfs:label>hypercholesteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001993 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Toxic epidermal necrolysis AE is a skin AE that is a rare, life-threatening skin condition which is usually caused by a reaction to drugs.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>Lyell&apos;s syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Toxic_epidermal_necrolysis</obo:IAO_0000119>
        <obo:OAE_0001849>中毒性表皮坏死溶解症</obo:OAE_0001849>
        <obo:OAE_0004334>10044223</obo:OAE_0004334>
        <rdfs:label>toxic epidermal necrolysis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13743</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C79777</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001994 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>Atrioventricular junctional rhythm AE is an arrhythmia AE that is an electrocardiographic finding in which the pacer of the heart is located in the AV junction, presenting with a narrow QRS complex and a rate of 40-60 beats per minute.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>房室交界性心律</obo:OAE_0001849>
        <rdfs:label>atrioventricular junctional rhythm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001995 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>Unconsciousness AE is a sensory capability AE that is a state which occurs when the ability to maintain a awareness of self and environment is lost, it involves a complete or near-complete lack of responsiveness to people and other environmental stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>loss of consciousness AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Unconsciousness</obo:IAO_0000119>
        <obo:OAE_0001849>意识丧失</obo:OAE_0001849>
        <obo:OAE_0004334>10045481</obo:OAE_0004334>
        <rdfs:label>unconsciousness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001996 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Pemphigus AE is a skin AE that is a rare group of blistering autoimmune diseases that affect the skin and mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pemphigus</obo:IAO_0000119>
        <obo:OAE_0001849>天疱疮</obo:OAE_0001849>
        <obo:OAE_0004334>10034280</obo:OAE_0004334>
        <rdfs:label>pemphigus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001997 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001203"/>
        <obo:IAO_0000115>Onychomycosis AE is a nail infection AE that is a fungal infection of the nail. It is the most common disease of the nails and constitutes about half of all nail abnormalities.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>dermatophytic onychomycosis AE</obo:IAO_0000118>
        <obo:IAO_0000118>tinea unguium AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Onychomycosis</obo:IAO_0000119>
        <obo:OAE_0001849>甲癣</obo:OAE_0001849>
        <rdfs:label>onychomycosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001998 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Miosis AE is an eye AE that is a term with various definitions, which generally include constriction of the pupil.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>myosis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Miosis</obo:IAO_0000119>
        <obo:OAE_0001849>瞳孔缩小</obo:OAE_0001849>
        <obo:OAE_0004334>10027646</obo:OAE_0004334>
        <rdfs:label>miosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001999 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002553"/>
        <obo:IAO_0000115>an optic neuropathy AE that shows the loss of some or most of the nerve fibers in the optic nerve.  The effects range from visual change to severe visual loss.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.kellogg.umich.edu/patientcare/conditions/optic.atrophy.html</obo:IAO_0000119>
        <obo:OAE_0001849>视神经萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10030910</obo:OAE_0004334>
        <rdfs:label>optic atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002000 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>Albuminuria AE  is a urine abnormality AE that is a pathological condition wherein albumin is present in the urine. It is a type of proteinuria.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Albuminuria</obo:IAO_0000119>
        <obo:OAE_0001849>蛋白尿</obo:OAE_0001849>
        <obo:OAE_0004334>10001580</obo:OAE_0004334>
        <rdfs:label>albuminuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>Enuresis AE  is a urine abnormality AE that refers to a repeated inability to control urination. Use of the term is usually limited to describing individuals old enough to be expected to exercise such control.</obo:IAO_0000115>
        <obo:IAO_0000116>This term appears to be a synonym to the &apos;urinary incontinence AE&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Enuresis</obo:IAO_0000119>
        <obo:OAE_0001849>遗尿</obo:OAE_0001849>
        <obo:OAE_0004334>10014928</obo:OAE_0004334>
        <rdfs:label>enuresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>Gum hypertrophy AE is a digestive system AE that is an increase in the size of the gingiva (gums). It is a common feature of gingival disease. Gingival enlargement can be caused by a number of factors, including inflammatory conditions and the side effects of certain medications.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>gingival enlargement AE</obo:IAO_0000118>
        <obo:IAO_0000118>gingival hyperplasia AE</obo:IAO_0000118>
        <obo:IAO_0000118>gingival hypertrophy AE</obo:IAO_0000118>
        <obo:IAO_0000118>gingival over-growth AE</obo:IAO_0000118>
        <obo:IAO_0000118>hypertrophic gingivitis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Gingival_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈增生</obo:OAE_0001849>
        <obo:OAE_0004334>10018781</obo:OAE_0004334>
        <rdfs:label>gum hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>Contact dermatitis AE is a dermatitis AE that is a type of skin inflammation.It results from exposure to allergens (allergic contact dermatitis) or irritants (irritant contact dermatitis). Phototoxic dermatitis occurs when the allergen or irritant is activated by sunlight.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Contact_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>接触性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10010790</obo:OAE_0004334>
        <rdfs:label>contact dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>Necrotizing vasculitis AE is a vasculitis AE that is a rare condition which involves inflammation of the blood vessel walls.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000432.htm</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10028892</obo:OAE_0004334>
        <rdfs:label>necrotizing vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002005 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>Carpal tunnel syndrome AE is a peripheral neuropathy AE that is a median entrapment neuropathy that causes paresthesia, pain, numbness, and other symptoms in the distribution of the median nerve due to its compression at the wrist in the carpal tunnel.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>median nerve neuropathy AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/1141168-clinical#showall</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Carpal_tunnel_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>腕管综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10007697</obo:OAE_0004334>
        <rdfs:label>carpal tunnel syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002006 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000237"/>
        <obo:IAO_0000115>Erythromelalgia AE is a peripheral arterial disease AE that is a rare neurovascular peripheral pain disorder in which blood vessels, usually in the lower extremities or hands, are episodically blocked (frequently on and off daily), then become hyperemic and inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Mitchell&apos;s disease AE</obo:IAO_0000118>
        <obo:IAO_0000118>acromelalgia AE</obo:IAO_0000118>
        <obo:IAO_0000118>erythermalgia AE</obo:IAO_0000118>
        <obo:IAO_0000118>red neuralgia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythromelalgia</obo:IAO_0000119>
        <obo:OAE_0001849>红斑性肢痛症</obo:OAE_0001849>
        <obo:OAE_0004334>10015284</obo:OAE_0004334>
        <rdfs:label>erythromelalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002007 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>a syndrome AE which results in the Raynaud&apos;s syndrome, a rare disease causes some areas of your body — such as your fingers and toes — to feel numb and cold in response to cold temperatures or stress. In Raynaud&apos;s disease, smaller arteries that supply blood to your skin narrow, limiting blood circulation to affected areas (vasospasm).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Raynaud&apos;s disease AE</obo:IAO_0000118>
        <obo:IAO_0000118>Raynaud&apos;s phenomenon AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/raynauds-disease/basics/definition/con-20022916</obo:IAO_0000119>
        <obo:OAE_0001849>雷诺综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10037914</obo:OAE_0004334>
        <rdfs:label>Raynaud&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002008 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>Extrapyramidal syndrome AE is a nervous system AE that is drug induced movement disorders which include acute and tardive symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>extrapyramidal side effects AE</obo:IAO_0000118>
        <obo:IAO_0000118>vertebral body outside the beam syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Extrapyramidal_symptoms</obo:IAO_0000119>
        <obo:OAE_0001849>椎体外系综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10015836</obo:OAE_0004334>
        <rdfs:label>extrapyramidal syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002009 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001573"/>
        <obo:IAO_0000115>an electrolyte lab test abnormal AE that  is when the kidneys hold on to more sodium and do not excrete it with the kidneys. This tends to expand the blood volume, which can elevate the blood pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: https://answers.yahoo.com/question/index?qid=20100823074826AAcg7WV</obo:IAO_0000119>
        <obo:OAE_0001849>钠潴留</obo:OAE_0001849>
        <obo:OAE_0004334>10041277</obo:OAE_0004334>
        <rdfs:label>sodium retention AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002011 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Sciatica AE is a pain AE that  is a set of symptoms including pain caused by general compression or irritation of one of five spinal nerve roots of each sciatic nerve or by compression or irritation of the left or right or both sciatic nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>lumbar radiculopathy AE</obo:IAO_0000118>
        <obo:IAO_0000118>sciatic neuralgia AE</obo:IAO_0000118>
        <obo:IAO_0000118>sciatic neuritis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sciatica</obo:IAO_0000119>
        <obo:OAE_0001849>坐骨神经痛</obo:OAE_0001849>
        <obo:OAE_0004334>10039674</obo:OAE_0004334>
        <rdfs:label>sciatica AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002012 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>Joint stiffness AE is a joint disorder AE that may be either the symptom of pain on moving a joint, the symptom of loss of range of motion or the physical sign of reduced range of motion.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Joint_stiffness</obo:IAO_0000119>
        <obo:OAE_0001849>关节僵硬</obo:OAE_0001849>
        <obo:OAE_0004334>10023230</obo:OAE_0004334>
        <rdfs:label>joint stiffness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002013 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>Breast engorgement AE is a reproductive system AE that occurs in the mammary glands due to expansion and pressure exerted by the synthesis and storage of breast milk.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Breast_engorgement</obo:IAO_0000119>
        <obo:OAE_0001849>乳房充盈</obo:OAE_0001849>
        <obo:OAE_0004334>10006240</obo:OAE_0004334>
        <rdfs:label>breast engorgement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002014 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Nervous tension AE is a behavior and neurological AE that might be said to be a physical expression of how people deal with negatively experienced emotion.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://helpmetosleep.org/featured-articles/how-to-relieve-nervous-tension/</obo:IAO_0000119>
        <obo:OAE_0001849>神经紧张</obo:OAE_0001849>
        <obo:OAE_0004334>10029214</obo:OAE_0004334>
        <rdfs:label>nervous tension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Nervousness AE is a behavior and neurological AE that shows an uneasy psychological state which including anxiety, neurosis, neuroticism, and worry, etc.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nervousness</obo:IAO_0000119>
        <obo:OAE_0001849>神经过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10029216</obo:OAE_0004334>
        <rdfs:label>nervousness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002016 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>Osteoarthritis AE is an arthritis AE that is a group of mechanical abnormalities involving degradation of joints, including articular cartilage and subchondral bone. Osteoarthritis is not an inflammatory disease even-though the name suggest one. Symptoms may include joint pain, tenderness, stiffness, locking, and sometimes an effusion.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>degenerative arthritis AE</obo:IAO_0000118>
        <obo:IAO_0000118>degenerative joint disease AE</obo:IAO_0000118>
        <obo:IAO_0000118>osteoarthrosis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Osteoarthritis</obo:IAO_0000119>
        <obo:OAE_0001849>骨关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10031161</obo:OAE_0004334>
        <rdfs:label>osteoarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001665"/>
        <obo:IAO_0000115>Methemoglobinemia AE is a red blood cell profile abnormal AE that is a disorder characterized by the presence of a higher than normal level of methemoglobin (metHb, i.e., ferric [Fe3+] rather than ferrous [Fe2+] haemoglobin) in the blood. It&apos;s a form of hemoglobin that contains ferric [Fe3+] iron and has a decreased ability to bind oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>methaemoglobinaemia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Methemoglobinemia</obo:IAO_0000119>
        <obo:OAE_0001849>高铁血红蛋白症</obo:OAE_0001849>
        <obo:OAE_0004334>10027506</obo:OAE_0004334>
        <rdfs:label>methemoglobinemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002018 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000297"/>
        <obo:IAO_0000115>Hemiageusia AE is a ageusia AE that shows loss of taste from one side of the tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hemiageustia AE</obo:IAO_0000118>
        <obo:IAO_0000118>hemigeusia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=39885</obo:IAO_0000119>
        <obo:OAE_0001849>偏侧味觉缺失</obo:OAE_0001849>
        <rdfs:label>hemiageusia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002019 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>Skin swelling AE is an edema AE that has an outcome of the occurrence of swelling which is located on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/skin_swelling.htm</obo:IAO_0000119>
        <obo:OAE_0001849>胕肿</obo:OAE_0001849>
        <obo:OAE_0004334>10053262</obo:OAE_0004334>
        <rdfs:label>skin swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000563"/>
        <obo:IAO_0000115>Fibrosing alveolitis AE is a lung  inflammation AE that is a disease of unknown cause mainly involving the gas-exchanging portions of the lungs. It may occur in isolation and be called cryptogenic or idiopathic, in which case the clinical manifestations are mainly respiratory, or it may be associated with other disorders, such as rheumatoid arthritis.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1818528/</obo:IAO_0000119>
        <obo:OAE_0001849>纤维化肺泡炎</obo:OAE_0001849>
        <obo:OAE_0004334>10016640</obo:OAE_0004334>
        <rdfs:label>fibrosing alveolitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002021 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001573"/>
        <obo:IAO_0000115>an electrolyte chloride abnormal AE where the patient&apos;s body has abnormally low levels of chloride. This condition usually results from an extremely high loss of chloride, rather than a low intake of it.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.wisegeek.com/what-is-hypochloremic-alkalosis.htm</obo:IAO_0000119>
        <obo:OAE_0001849>低氯性碱中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10020958</obo:OAE_0004334>
        <rdfs:label>hypochloremic alkalosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002022 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>Erythema annulare centrifugum AE is an erythema AE that is a descriptive term for a skin lesion. The lesions form consists of redness (erythema) in a ring form (anulare) that spreads from the center (centrifugum).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>MedDRA: 10015154</obo:IAO_0000118>
        <obo:IAO_0000118>deep gyrate erythema AE</obo:IAO_0000118>
        <obo:IAO_0000118>erythema perstans AE</obo:IAO_0000118>
        <obo:IAO_0000118>palpable migrating erythema AE</obo:IAO_0000118>
        <obo:IAO_0000118>superficial gyrate erythema AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythema_annulare_centrifugum</obo:IAO_0000119>
        <obo:OAE_0001849>离心性环形红斑</obo:OAE_0001849>
        <rdfs:label>erythema annulare centrifugum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Irritation is a behavior and neurological AE that is a state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10029216</obo:OAE_0004334>
        <rdfs:label>irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002024 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that is a fundamental personality trait in the study of psychology characterized by anxiety, fear, moodiness, worry, envy, frustration, jealousy, and loneliness.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Neuroticism</obo:IAO_0000119>
        <obo:OAE_0001849>神经质</obo:OAE_0001849>
        <rdfs:label>neuroticism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002025 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Hyperirritability AE is a behavior and neurological AE that shows abnormally great or uninhibited response to stimuli.</obo:IAO_0000115>
        <obo:IAO_0000116>This term appears to be a synonym to the &apos;irritability AE&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.merriam-webster.com/medical/hyperirritability; http://en.wikipedia.org/wiki/Irritability</obo:IAO_0000119>
        <obo:OAE_0001849>过激</obo:OAE_0001849>
        <rdfs:label>hyperirritability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002026 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>Rhinostenosis AE is a respiratory system AE that shows narrowing or obliteration of the nasal airway by scar formation</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.drugs.com/dict/rhinostenosis.html</obo:IAO_0000119>
        <rdfs:comment>鼻道狭窄</rdfs:comment>
        <rdfs:label>rhinostenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002027 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>Sino-auricular heart-block AE is a conduction system disorder AE that refers to a rare heart condition caused by abnormalities in the heart&apos;s electrical system rather than arterial disease.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/s/sino_auricular_heart_block/intro.htm</obo:IAO_0000119>
        <obo:OAE_0001849>窦房传导阻滞</obo:OAE_0001849>
        <rdfs:label>sino-auricular heart-block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002028 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <obo:IAO_0000115>Anisosphygmia AE is a cardiovascular disorder AE that shows difference in volume, force, or time of the pulse in the corresponding arteries on two sides of the body, the two radials, or femorals.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=4352</obo:IAO_0000119>
        <obo:OAE_0001849>脉搏不规则</obo:OAE_0001849>
        <rdfs:label>anisosphygmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002029 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Rubefaction AE is a skin AE that refers to erythema of the skin caused by local application of a counterirritant.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=79112</obo:IAO_0000119>
        <obo:OAE_0001849>发红</obo:OAE_0001849>
        <rdfs:label>rubefaction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <obo:IAO_0000115>Myodystony AE is an abnormal muscle tone AE that refers to a condition of slow relaxation, interrupted by a succession of slight contractions, following electrical stimulation of a muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.drugs.com/dict/myodystony.html</obo:IAO_0000119>
        <obo:OAE_0001849>肌张力不全</obo:OAE_0001849>
        <rdfs:label>myodystony AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Allotriosmia is a behavior and neurological AE that shows incorrect recognition of odors.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>heterosmia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=2401</obo:IAO_0000119>
        <obo:OAE_0001849>嗅觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10029216</obo:OAE_0004334>
        <rdfs:label>allotriosmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002032 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Pharyngotonsillitis is an inflammation AE that is a medical condition characterized by an inflammation of both the tonsils and the pharynx (located at the back of the throat). It occurs due to viral or bacterial infections.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.persify.com/en/perspectives/medical-conditions-diseases/pharyngotonsillitis-_-951000101807</obo:IAO_0000119>
        <obo:OAE_0001849>咽扁桃体炎</obo:OAE_0001849>
        <obo:OAE_0004334>10049140</obo:OAE_0004334>
        <rdfs:label>pharyngotonsillitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002033 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>Hypersensitivity pneumonitis AE is a pneumonia AE that is an inflammation of the alveoli within the lung caused by hypersensitivity to inhaled organic dusts. Sufferers are commonly exposed to the dust by their occupation or hobbies.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>extrinsic allergic alveolitis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypersensitivity_pneumonitis</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10015887</obo:OAE_0004334>
        <rdfs:label>hypersensitivity pneumonitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002034 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>Stagger AE is a movement disorder AE that shows an unsteady movement of the body in walking or standing, as if one were about to fall.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wiktionary.org/wiki/stagger</obo:IAO_0000119>
        <obo:OAE_0001849>蹒跚</obo:OAE_0001849>
        <rdfs:label>stagger AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002035 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000617"/>
        <obo:IAO_0000115>Myocardial anoxia AE is a hypoxia AE that shows a reduced concentration of O2 in the myocardium.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>心肌缺氧</obo:OAE_0001849>
        <rdfs:label>myocardial anoxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002036 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>Biliary colic AE is a pain AE that is the term used to describe a type of pain related to the gallbladder that occurs when a gallstone transiently obstructs the cystic duct and the gallbladder contracts.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>cholecystalgia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Biliary_colic</obo:IAO_0000119>
        <obo:OAE_0001849>胆绞痛</obo:OAE_0001849>
        <obo:OAE_0004334>10004663</obo:OAE_0004334>
        <rdfs:label>biliary colic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002037 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <obo:IAO_0000115>Hyperemia AE is a cardiovascular disorder AE that is the increase of blood flow to different tissues in the body. It can have medical implications, but is also a regulatory response, allowing change in blood supply to different tissues through vasodilation.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hyperaemia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperaemia</obo:IAO_0000119>
        <obo:OAE_0001849>充血</obo:OAE_0001849>
        <rdfs:label>hyperemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002038 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <obo:IAO_0000115>a sensory capability AE that has an outcome increased sensitivity to pain in a patient</obo:IAO_0000115>
        <obo:IAO_0000117>RR</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.oxforddictionaries.com/us/definition/american_english/tenderness</obo:IAO_0000119>
        <obo:OAE_0004334>10043224</obo:OAE_0004334>
        <rdfs:label xml:lang="en">tenderness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002039 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>a skin AE with the outcome of induration, which is an increase in the fibrous elements in tissue commonly associated with inflammation and marked by loss of elasticity and pliability or a hardened mass or formation</obo:IAO_0000115>
        <obo:IAO_0000117>RR</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.merriam-webster.com/medical/induration</obo:IAO_0000119>
        <obo:OAE_0004334>10060708</obo:OAE_0004334>
        <rdfs:label xml:lang="en">induration AE</rdfs:label>
    </owl:Class>
    


