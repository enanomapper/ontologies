        <obo:IAO_0000115>a gastritis AE that has severely altered eating or gastric function; TPN or hospitalization indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 gastritis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10736</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003659 -->


