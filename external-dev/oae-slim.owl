    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006603 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>This is an AE which occurs when transplanted tissue is rejected by the recipient&apos;s immune system, which destroys the transplanted tissue such as liver transplant rejection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transplant_rejection</obo:IAO_0000119>
        <obo:OAE_0001849>肝移植排斥反应</obo:OAE_0001849>
        <obo:OAE_0004334>10024715</obo:OAE_0004334>
        <rdfs:label>liver transplant rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006604 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is the most common reason for abdominal surgery in the elderly population.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/8165472/</obo:IAO_0000119>
        <obo:OAE_0001849>肝胆管的疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10062000</obo:OAE_0004334>
        <rdfs:label>hepatobiliary disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006605 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is a malignant liver cancer occurring in infants and children and composed of tissue resembling fetal liver cells, mature liver cells, or bile duct cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatoblastoma</obo:IAO_0000119>
        <obo:OAE_0001849>肝母细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10062001</obo:OAE_0004334>
        <rdfs:label>hepatoblastoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006606 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is the most common type of primary liver cancer in adults and is currently the most common cause of death in people with cirrhosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatocellular_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>肝细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10073071</obo:OAE_0004334>
        <rdfs:label>hepatocellular carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006607 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the hepatocellular caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>肝细胞损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10019837</obo:OAE_0004334>
        <rdfs:label>hepatocellular injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006608 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome of shortness of breath and hypoxemia (low oxygen levels in the blood of the arteries) caused by vasodilation (broadening of the blood vessels) in the lungs of patients with liver disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatopulmonary_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肝肺综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10052274</obo:OAE_0004334>
        <rdfs:label>hepatopulmonary syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006609 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a rare form of lymphoma that is generally incurable, except in the case of an allogeneic stem cell transplant.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatosplenic_T-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>肝脾t细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10066957</obo:OAE_0004334>
        <rdfs:label>hepatosplenic t-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006610 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is the abnormal exit of tissue or an organ, such as the bowel, through the wall of the cavity in which it normally resides.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hernia</obo:IAO_0000119>
        <obo:OAE_0001849>疝</obo:OAE_0001849>
        <obo:OAE_0004334>10019909</obo:OAE_0004334>
        <rdfs:label>hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006611 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is the abnormal exit of tissue or an organ, such as the bowel, through the wall of the cavity in which it normally resides and feel it pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hernia</obo:IAO_0000119>
        <obo:OAE_0001849>疝痛</obo:OAE_0001849>
        <obo:OAE_0004334>10049077</obo:OAE_0004334>
        <rdfs:label>hernia pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006612 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001029"/>
        <obo:IAO_0000115>This is an AE which is a rare, benign liver tumor and  most commonly occurs in people with elevated systemic levels of estrogen, classically in women taking estrogen-containing oral contraceptive medication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatocellular_adenoma</obo:IAO_0000119>
        <obo:OAE_0001849>肝腺瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10019629</obo:OAE_0004334>
        <rdfs:label>hepatic adenoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006613 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is the most common type of primary liver cancer in adults and is currently the most common cause of death in people with cirrhosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatocellular_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>肝癌症</obo:OAE_0001849>
        <obo:OAE_0004334>10073069</obo:OAE_0004334>
        <rdfs:label>hepatic cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006614 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001185"/>
        <obo:IAO_0000115>This is an AE which is the most common type of primary liver cancer in adults and is currently the most common cause of death in people with cirrhosis and is metastatic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatocellular_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>肝癌转移</obo:OAE_0001849>
        <obo:OAE_0004334>10055110</obo:OAE_0004334>
        <rdfs:label>hepatic cancer metastatic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006615 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which refers abnormal accumulation of fluid in the hepatic interstitium, manifesting as swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congestion</obo:IAO_0000119>
        <obo:OAE_0001849>肝充血</obo:OAE_0001849>
        <obo:OAE_0004334>10019645</obo:OAE_0004334>
        <rdfs:label>hepatic congestion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006616 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is common benign liver lesions that usually have no malignant capability and is generally asymptomatic and are often found incidentally by abdominal imaging procedures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30145861/</obo:IAO_0000119>
        <obo:OAE_0001849>肝囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10019646</obo:OAE_0004334>
        <rdfs:label>hepatic cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006617 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which refers to the passage and lodging of an embolus within the bloodstream on the hepatic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolization</obo:IAO_0000119>
        <obo:OAE_0001849>肝栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10056203</obo:OAE_0004334>
        <rdfs:label>hepatic embolisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006618 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is the impaired liver function caused by the formation of scar tissue known as fibrosis due to damage caused by liver disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cirrhosis</obo:IAO_0000119>
        <obo:OAE_0001849>肝纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10019668</obo:OAE_0004334>
        <rdfs:label>hepatic fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006619 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001029"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of hepatic tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>肝肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10076254</obo:OAE_0004334>
        <rdfs:label>hepatic hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006620 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an organism&apos;s body tissues by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce such as hepatic infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>肝病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10056522</obo:OAE_0004334>
        <rdfs:label>hepatic infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006621 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is disease caused by fungi on the hepatic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fungal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>肝真菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065217</obo:OAE_0004334>
        <rdfs:label>hepatic infection fungal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006622 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which occurs in the setting of chronic liver inflammation, and is most closely linked to chronic viral hepatitis infection (hepatitis B or C) or exposure to toxins such as alcohol, aflatoxin, or pyrrolizidine alkaloids and is malignant.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatocellular_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>恶性肝肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10019697</obo:OAE_0004334>
        <rdfs:label>hepatic neoplasm malignant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006623 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is a species of virus in the order Picornavirales, family Picornaviridae, genus Hepatovirus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_A#Virology</obo:IAO_0000119>
        <obo:OAE_0001849>甲肝病毒</obo:OAE_0001849>
        <obo:OAE_0004334>10052551</obo:OAE_0004334>
        <rdfs:label>hepatitis a virus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006624 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which can resolve on its own, progress to chronic hepatitis, or (rarely) result in acute liver failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019727</obo:OAE_0004334>
        <rdfs:label>hepatitis acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006625 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is a partially double-stranded DNA virus, a species of the genus Orthohepadnavirus and a member of the Hepadnaviridae family of viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_B_virus</obo:IAO_0000119>
        <obo:OAE_0001849>乙型病毒性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052552</obo:OAE_0004334>
        <rdfs:label>hepatitis b virus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006626 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is a small (55–65 nm in size), enveloped, positive-sense single-stranded RNA virus of the family Flaviviridae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_C_virus</obo:IAO_0000119>
        <obo:OAE_0001849>丙型病毒性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019751</obo:OAE_0004334>
        <rdfs:label>hepatitis c virus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006627 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is a condition where bile cannot flow from the liver to the duodenum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholestasis</obo:IAO_0000119>
        <obo:OAE_0001849>淤胆型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019754</obo:OAE_0004334>
        <rdfs:label>hepatitis cholestatic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006628 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is often asymptomatic early in its course and is detected only by liver laboratory studies for screening purposes or to evaluate non-specific symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis#Chronic_hepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性活动型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019755</obo:OAE_0004334>
        <rdfs:label>hepatitis chronic active AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006629 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is a type of viral hepatitis caused by the hepatitis delta virus (HDV).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_D</obo:IAO_0000119>
        <obo:OAE_0001849>d型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019762</obo:OAE_0004334>
        <rdfs:label>hepatitis d AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006630 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the liver caused by infection with the hepatitis E virus (HEV);it is a type of viral hepatitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_E</obo:IAO_0000119>
        <obo:OAE_0001849>e型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019768</obo:OAE_0004334>
        <rdfs:label>hepatitis e AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006631 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is a rare and life-threatening complication of acute hepatitis that can occur in cases of hepatitis B, D, and E, in addition to drug-induced and autoimmune hepatitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis#Fulminant_hepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>暴发性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019772</obo:OAE_0004334>
        <rdfs:label>hepatitis fulminant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006632 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the liver tissue and is infective.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>传染性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019780</obo:OAE_0004334>
        <rdfs:label>hepatitis infectious AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006633 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is an infection usually caused by the Epstein Barr virus (EBV) on the hepatitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infectious_mononucleosis</obo:IAO_0000119>
        <obo:OAE_0001849>肝炎传染性单核细胞增多</obo:OAE_0001849>
        <obo:OAE_0004334>10019781</obo:OAE_0004334>
        <rdfs:label>hepatitis infectious mononucleosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006634 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which develops in approximately 7% of blood recipients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/6987932/</obo:IAO_0000119>
        <obo:OAE_0001849>输血后肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019791</obo:OAE_0004334>
        <rdfs:label>hepatitis post transfusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006635 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which implies chemical-driven liver damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>毒性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019795</obo:OAE_0004334>
        <rdfs:label>hepatitis toxic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006636 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001026"/>
        <obo:IAO_0000115>This is an AE which is the appearance of severe complications rapidly after the first signs (such as jaundice) of liver disease, and indicates that the liver has sustained severe damage (loss of function of 80–90% of liver cells).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_liver_failure</obo:IAO_0000119>
        <obo:OAE_0001849>急性肝衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10000804</obo:OAE_0004334>
        <rdfs:label>acute hepatic failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006637 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE whichis defined as the discrete onset of symptoms, the presence of jaundice or elevated serum alanine transaminase levels, and test results showing hepatitis B surface antigen and hepatitis B core antigen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30811163/</obo:IAO_0000119>
        <obo:OAE_0001849>急性乙型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10059193</obo:OAE_0004334>
        <rdfs:label>acute hepatitis b AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006638 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which refers infection is typically defined as the initial 6 months following exposure to the virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24477864/</obo:IAO_0000119>
        <obo:OAE_0001849>急性丙型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065051</obo:OAE_0004334>
        <rdfs:label>acute hepatitis c AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006639 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000376"/>
        <obo:IAO_0000115>This is an AE which presents with tiny very itchy wheals and small bumps on a reddish background.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholinergic_urticaria</obo:IAO_0000119>
        <obo:OAE_0001849>荨麻疹胆碱能</obo:OAE_0001849>
        <obo:OAE_0004334>10046740</obo:OAE_0004334>
        <rdfs:label>urticaria cholinergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006640 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002335"/>
        <obo:IAO_0000115>This is an AE which is a group of substances that blocks the action of the neurotransmitter called acetylcholine (ACh) at synapses in the central and peripheral nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anticholinergic#Effects</obo:IAO_0000119>
        <obo:OAE_0001849>抗胆碱能综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10002757</obo:OAE_0004334>
        <rdfs:label>anticholinergic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006641 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is a yellowish or greenish pigmentation of the skin and whites of the eyes due to high bilirubin levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Jaundice</obo:IAO_0000119>
        <obo:OAE_0001849>高胆红素血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020578</obo:OAE_0004334>
        <rdfs:label>hyperbilirubinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006642 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is the presence of high levels of cholesterol in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypercholesterolemia</obo:IAO_0000119>
        <obo:OAE_0001849>血胆固醇过多</obo:OAE_0001849>
        <obo:OAE_0004334>10020603</obo:OAE_0004334>
        <rdfs:label>hypercholesterolaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006643 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000468"/>
        <obo:IAO_0000115>This is an AE which is due to significant damage to liver function → hepatic cell death and necrosis occur → impaired bilirubin transport across hepatocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Jaundice</obo:IAO_0000119>
        <obo:OAE_0001849>黄疸肝细胞</obo:OAE_0001849>
        <obo:OAE_0004334>10023136</obo:OAE_0004334>
        <rdfs:label>jaundice hepatocellular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006644 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which can then lead to complications such as cirrhosis and hepatocellular carcinoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Non-alcoholic_fatty_liver_disease</obo:IAO_0000119>
        <obo:OAE_0001849>非酒精性脂肪性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10053219</obo:OAE_0004334>
        <rdfs:label>non-alcoholic steatohepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006645 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is an uncommon vascular condition characterised by multiple, randomly distributed, blood-filled cavities throughout the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peliosis_hepatis</obo:IAO_0000119>
        <obo:OAE_0001849>肝紫癜症</obo:OAE_0001849>
        <obo:OAE_0004334>10034229</obo:OAE_0004334>
        <rdfs:label>peliosis hepatis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006646 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is a type of fatty liver disease, characterized by inflammation of the liver with concurrent fat accumulation in liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Steatohepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>脂肪性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10076331</obo:OAE_0004334>
        <rdfs:label>steatohepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006647 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is some form of trauma sustained to the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Liver_injury</obo:IAO_0000119>
        <obo:OAE_0001849>外伤性肝损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10067979</obo:OAE_0004334>
        <rdfs:label>traumatic liver injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006648 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which may progress to scarring of the liver (cirrhosis), liver failure, and liver cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis#Chronic</obo:IAO_0000119>
        <obo:OAE_0001849>慢性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008909</obo:OAE_0004334>
        <rdfs:label>chronic hepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006649 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006649">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which is one of the leading causes of liver cirrhosis and hepatocellular carcinoma and has become a curable disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27788732/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性丙型肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008912</obo:OAE_0004334>
        <rdfs:label>chronic hepatitis c AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006650 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006650">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001446"/>
        <obo:IAO_0000115>This is an AE which is induced by immunocompetent alloreactive T lymphocytes in the donor graft responding to polymorphic and non-polymorphic host antigens and causing inflammation in primarily the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33054103/</obo:IAO_0000119>
        <obo:OAE_0001849>急性肝移植抗宿主病</obo:OAE_0001849>
        <obo:OAE_0004334>10066263</obo:OAE_0004334>
        <rdfs:label>acute graft versus host disease in liver AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006651 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001024"/>
        <obo:IAO_0000115>This is an AE which represents the terminal stage of alcoholic liver disease (ALD) and one of the main causes of death among alcohol abusers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19389182/</obo:IAO_0000119>
        <obo:OAE_0001849>酒精性肝硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10009208</obo:OAE_0004334>
        <rdfs:label>cirrhosis alcoholic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006652 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000491"/>
        <obo:IAO_0000115>This is an AE which is an altered level of consciousness as a result of liver failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatic_encephalopathy</obo:IAO_0000119>
        <obo:OAE_0001849>肝昏迷</obo:OAE_0001849>
        <obo:OAE_0004334>10010075</obo:OAE_0004334>
        <rdfs:label>coma hepatic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006653 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is a cause of acute and chronic liver disease caused specifically by medications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatotoxicity</obo:IAO_0000119>
        <obo:OAE_0001849>药物性肝损害</obo:OAE_0001849>
        <obo:OAE_0004334>10072268</obo:OAE_0004334>
        <rdfs:label>drug-induced liver injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006654 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000562"/>
        <obo:IAO_0000115>This is an AE which is an aggregation on the liver of macrophages that forms in response to chronic inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>肉芽肿性肝病</obo:OAE_0001849>
        <obo:OAE_0004334>10018704</obo:OAE_0004334>
        <rdfs:label>granulomatous liver disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006655 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000857"/>
        <obo:IAO_0000115>This is an AE which is generally asymptomatic or rarely can lead to severe complications in immunocompetent hosts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28081328/</obo:IAO_0000119>
        <obo:OAE_0001849>巨细胞病毒肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10011830</obo:OAE_0004334>
        <rdfs:label>cytomegalovirus hepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006656 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is the most common primary malignancy of the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29038855/</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺导管腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10073364</obo:OAE_0004334>
        <rdfs:label>ductal adenocarcinoma of pancreas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006657 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000195"/>
        <obo:IAO_0000115>This is an AE which is a condition with oedematous characterized by inflammation of the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatitis</obo:IAO_0000119>
        <obo:OAE_0001849>水肿性胰腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052400</obo:OAE_0004334>
        <rdfs:label>edematous pancreatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006658 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006658">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder that affects mostly the lungs, but also the pancreas, liver, kidneys, and pancreatic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cystic_fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>囊性纤维化胰腺</obo:OAE_0001849>
        <obo:OAE_0004334>10011766</obo:OAE_0004334>
        <rdfs:label>cystic fibrosis pancreatic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006659 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of cancerous tumor that can occur in several parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenocarcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10001141</obo:OAE_0004334>
        <rdfs:label>adenocarcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006660 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which manifests with several symptoms such as bilateral nasal obstruction, rhinorrhea, cough, snoring, hyponasal speech, hypopnea, and sleep apnea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20199384/</obo:IAO_0000119>
        <obo:OAE_0001849>腺样体肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10001229</obo:OAE_0004334>
        <rdfs:label>adenoidal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006661 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the adenoid tissue usually caused by an infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenoiditis</obo:IAO_0000119>
        <obo:OAE_0001849>增殖腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10051223</obo:OAE_0004334>
        <rdfs:label>adenoiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006662 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor of epithelial tissue with glandular origin, glandular characteristics, or both.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenoma</obo:IAO_0000119>
        <obo:OAE_0001849>腺瘤良性</obo:OAE_0001849>
        <obo:OAE_0004334>10001233</obo:OAE_0004334>
        <rdfs:label>adenoma benign AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006663 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001653"/>
        <obo:IAO_0000115>This is an AE which is a protein that in humans is encoded by the APC gene.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenomatous_polyposis_coli</obo:IAO_0000119>
        <obo:OAE_0001849>腺瘤息肉病杆菌</obo:OAE_0001849>
        <obo:OAE_0004334>10056981</obo:OAE_0004334>
        <rdfs:label>adenomatous polyposis coli AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006664 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001653"/>
        <obo:IAO_0000115>This is an AE which is a metabolic disorder that causes immunodeficiency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenosine_deaminase_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>腺苷脱氨酶缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10066367</obo:OAE_0004334>
        <rdfs:label>adenosine deaminase deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006665 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is a group of liver disorders in which substances called porphyrins build up in the body, negatively affecting the skin or nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Porphyria</obo:IAO_0000119>
