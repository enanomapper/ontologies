        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is an organ in vertebrates through which food passes, aided by peristaltic contractions, from the pharynx to the stomach and the organ is haemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
