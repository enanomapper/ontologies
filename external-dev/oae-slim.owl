    <!-- http://purl.obolibrary.org/obo/OAE_0005416 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
