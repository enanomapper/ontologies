    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008311 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which refers irregular tear-like wounds caused by some blunt trauma on the vaginal .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound#Open</obo:IAO_0000119>
        <obo:OAE_0001849>阴道撕裂伤</obo:OAE_0001849>
        <obo:OAE_0004334>10046919</obo:OAE_0004334>
        <rdfs:label>vaginal laceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008312 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of vaginal , usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>阴道病变</obo:OAE_0001849>
        <obo:OAE_0004334>10048937</obo:OAE_0004334>
        <rdfs:label>vaginal lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008313 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a cancer of the vulva, the outer portion of the female genitals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vulvar_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>阴道肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10062165</obo:OAE_0004334>
        <rdfs:label>vaginal neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008314 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is caused by one or more volatilized chemical compounds on the vaginal  that are generally found in low concentrations .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Odor</obo:IAO_0000119>
        <obo:OAE_0001849>阴道异味</obo:OAE_0001849>
        <obo:OAE_0004334>10046935</obo:OAE_0004334>
        <rdfs:label>vaginal odour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008315 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the vaginal  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>阴道水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10063818</obo:OAE_0004334>
        <rdfs:label>vaginal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008316 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of a vaginal  part or area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>阴道肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10055049</obo:OAE_0004334>
        <rdfs:label>vaginal swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008317 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which occurs when the normal lactobacilli of the vagina are replaced by mostly anaerobic bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21524046/</obo:IAO_0000119>
        <obo:OAE_0001849>阴道溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10046943</obo:OAE_0004334>
        <rdfs:label>vaginal ulceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008318 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the vagina and vulva caused by bacterial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginitis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性阴道炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062167</obo:OAE_0004334>
        <rdfs:label>vaginitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008319 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a facultatively anaerobic Gram-variable rod that is involved, together with many other bacteria, mostly anaerobic, in bacterial vaginosis in some women as a result of a disruption in the normal vaginal microflora.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gardnerella_vaginalis</obo:IAO_0000119>
        <obo:OAE_0001849>阴道炎加德纳菌</obo:OAE_0001849>
        <obo:OAE_0004334>10046957</obo:OAE_0004334>
        <rdfs:label>vaginitis gardnerella AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008320 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the vulva, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>外阴囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10050475</obo:OAE_0004334>
        <rdfs:label>vulva cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008321 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a cancer of the vulva, the outer portion of the female genitals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vulvar_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>外阴癌</obo:OAE_0001849>
        <obo:OAE_0004334>10047741</obo:OAE_0004334>
        <rdfs:label>vulval cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008322 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the vulva, having a distinct envelope and division compared with the nearby tissue and it become disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vulva</obo:IAO_0000119>
        <obo:OAE_0001849>外阴疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10047754</obo:OAE_0004334>
        <rdfs:label>vulval disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008323 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged vulval blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>外阴出血</obo:OAE_0001849>
        <obo:OAE_0004334>10063816</obo:OAE_0004334>
        <rdfs:label>vulval hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008324 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which refers irregular tear-like wounds caused by some blunt trauma. Lacerations and incisions may appear linear (regular) or stellate (irregular) such as vulval  lacerations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound#Open</obo:IAO_0000119>
        <obo:OAE_0001849>外阴撕裂伤</obo:OAE_0001849>
        <obo:OAE_0004334>10047759</obo:OAE_0004334>
        <rdfs:label>vulval laceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008325 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is an open sore located on the genital area, which includes the vulva, penis, perianal region, or anus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Genital_ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>外阴溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10047768</obo:OAE_0004334>
        <rdfs:label>vulval ulceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008326 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth or development of cells (microscopic scale) and/or organs (macroscopic scale), and/or the abnormal histology or anatomical structure presumably resulting from such growth such as vulvar dysplasia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>外阴发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10054932</obo:OAE_0004334>
        <rdfs:label>vulvar dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008327 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the vulva, the external female mammalian genitalia that include the labia majora, labia minora, clitoris, and introitus (the entrance to the vagina).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vulvitis</obo:IAO_0000119>
        <obo:OAE_0001849>外阴炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047780</obo:OAE_0004334>
        <rdfs:label>vulvitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008328 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is  related to neuropathic pain and associated to various degrees of vulvar mucosal hypersensitivity (mostly in the vestibular area), pelvic floor muscles dysfunction, a disorder of general perception of pain and/or various complex regional pain syndromes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23972919/</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道灼热感</obo:OAE_0001849>
        <obo:OAE_0004334>10067641</obo:OAE_0004334>
        <rdfs:label>vulvovaginal burning sensation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008329 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is excessive growth of yeast in the vagina that results in irritation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginal_yeast_infection</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道念珠菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10047784</obo:OAE_0004334>
        <rdfs:label>vulvovaginal candidiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008330 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which refers frequently or always decreased interest in sex or ability to have sex .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31108226/</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道不适</obo:OAE_0001849>
        <obo:OAE_0004334>10047786</obo:OAE_0004334>
        <rdfs:label>vulvovaginal discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008331 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which includes yeast infection, vaginitis, sexually transmitted infections (STIs) and cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vagina#Clinical_significance</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10047787</obo:OAE_0004334>
        <rdfs:label>vulvovaginal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008332 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a common condition that is particularly prevalent during and after the menopause, and is one of the symptoms of vulvovaginal atrophy/genitourinary syndrome of menopause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26707589/</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10047791</obo:OAE_0004334>
        <rdfs:label>vulvovaginal dryness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008333 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is redness of the vulvovaginal skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10070437</obo:OAE_0004334>
        <rdfs:label>vulvovaginal erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008334 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is an vulvovaginal  infection caused by human papillomavirus (HPV), a DNA virus from the Papillomaviridae family.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_papillomavirus_infection</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道人乳头瘤病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10066416</obo:OAE_0004334>
        <rdfs:label>vulvovaginal human papilloma virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008335 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of body tissues to harmful stimuli, such as pathogens, damaged cells, or irritants, and is a protective response involving immune cells, blood vessels, and molecular mediators such as vulvovaginal inflammmation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10079372</obo:OAE_0004334>
        <rdfs:label>vulvovaginal inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008336 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is vulvovaginal disease caused by fungi .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fungal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道真菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10064899</obo:OAE_0004334>
        <rdfs:label>vulvovaginal mycotic infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008337 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is major health concerns in women of childbearing age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25104563/</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道痛</obo:OAE_0001849>
        <obo:OAE_0004334>10069055</obo:OAE_0004334>
        <rdfs:label>vulvovaginal pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008338 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which thought to be attributable to autoimmune progesterone dermatitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16891434/</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10056530</obo:OAE_0004334>
        <rdfs:label>vulvovaginal pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008339 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a change of the vulvovaginal skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10071588</obo:OAE_0004334>
        <rdfs:label>vulvovaginal rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008340 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of a vulvovaginal  part or area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10071211</obo:OAE_0004334>
        <rdfs:label>vulvovaginal swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008341 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in a bodily membrane that impedes normal function of the affected organ such as vulvovaginal .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10050181</obo:OAE_0004334>
        <rdfs:label>vulvovaginal ulceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008342 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the most common mucosal human papillomavirus (HPV) infection encountered by the dermatologists.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33817597/</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道疣</obo:OAE_0001849>
        <obo:OAE_0004334>10047793</obo:OAE_0004334>
        <rdfs:label>vulvovaginal warts AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008343 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the vagina and vulva.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginitis</obo:IAO_0000119>
        <obo:OAE_0001849>外阴阴道炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047794</obo:OAE_0004334>
        <rdfs:label>vulvovaginitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008344 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is inflammation  caused by trichomonal of the vagina and vulva.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginitis</obo:IAO_0000119>
        <obo:OAE_0001849>外阴滴虫性阴道炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047799</obo:OAE_0004334>
        <rdfs:label>vulvovaginitis trichomonal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008345 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the uterine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>子宫脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10063012</obo:OAE_0004334>
        <rdfs:label>uterine abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008346 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is the failure of the uterus to contract adequately following delivery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uterine_atony</obo:IAO_0000119>
        <obo:OAE_0001849>子宫收缩乏力</obo:OAE_0001849>
        <obo:OAE_0004334>10046763</obo:OAE_0004334>
        <rdfs:label>uterine atony AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008347 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which includes two types of cancer that develop from the tissues of the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uterine_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>子宫癌</obo:OAE_0001849>
        <obo:OAE_0004334>10046766</obo:OAE_0004334>
        <rdfs:label>uterine cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008348 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the cells from the &apos;inside&apos; of the cervical canal, known as glandular cells (or columnar epithelium), are present on the &apos;outside&apos; of the vaginal portion of the cervix.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cervical_ectropion</obo:IAO_0000119>
        <obo:OAE_0001849>子宫颈糜烂</obo:OAE_0001849>
        <obo:OAE_0004334>10008264</obo:OAE_0004334>
        <rdfs:label>uterine cervical erosion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008349 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling  on the uterine cervical often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>子宫颈痛</obo:OAE_0001849>
        <obo:OAE_0004334>10058704</obo:OAE_0004334>
        <rdfs:label>uterine cervical pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008350 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a benign non-cancerous change (metaplasia) of surfacing lining cells (epithelium) to a squamous morphology on the uterine cervical .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Squamous_metaplasia</obo:IAO_0000119>
        <obo:OAE_0001849>子宫颈鳞状上皮化生</obo:OAE_0001849>
        <obo:OAE_0004334>10062663</obo:OAE_0004334>
        <rdfs:label>uterine cervical squamous metaplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008351 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in a uterine cervix membrane that impedes normal function of the affected organ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>子宫颈溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10051960</obo:OAE_0004334>
        <rdfs:label>uterine cervix ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008352 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a closed uterine sac, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>子宫囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10048931</obo:OAE_0004334>
        <rdfs:label>uterine cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008353 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a less severe condition in which there is only incomplete separation of the old scar.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uterine_rupture</obo:IAO_0000119>
