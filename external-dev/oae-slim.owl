    <!-- http://purl.obolibrary.org/obo/OAE_0005928 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which including outer ear injury, middle ear injury, inner ear injury and tinnitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ear#Injury</obo:IAO_0000119>
        <obo:OAE_0001849>耳朵受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10057446</obo:OAE_0004334>
        <rdfs:label>ear injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005929 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an organism&apos;s ear lobe by disease-causing agents, their multiplication, and the reaction of ear tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>耳垂感染</obo:OAE_0001849>
        <obo:OAE_0004334>10014014</obo:OAE_0004334>
        <rdfs:label>ear lobe infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005930 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which are seen with the shape of a ear part and functional disorders in which problems exist with how a ear part works.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>耳畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10014016</obo:OAE_0004334>
        <rdfs:label>ear malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005931 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch on ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>耳朵瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10052138</obo:OAE_0004334>
        <rdfs:label>ear pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005932 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001136"/>
        <obo:IAO_0000115>This is an AE which is a transient abnormal enlargement of ear part or area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>耳肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10014025</obo:OAE_0004334>
        <rdfs:label>ear swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005933 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003440"/>
        <obo:IAO_0000115>This is an AE which is a superficial infection of the ear that may be precipitated by trauma, an insect bite, or ear piercing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ear_pain#External_ear</obo:IAO_0000119>
        <obo:OAE_0001849>外耳蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10015729</obo:OAE_0004334>
        <rdfs:label>external ear cellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005934 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which occur fairly frequently and can leave minor to major deformity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ear#Outer_ear_2</obo:IAO_0000119>
        <obo:OAE_0001849>外耳疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061456</obo:OAE_0004334>
        <rdfs:label>external ear disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005935 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which can cause hearing loss, tinnitus, vertigo and imbalance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23648600/</obo:IAO_0000119>
        <obo:OAE_0001849>内耳疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061524</obo:OAE_0004334>
        <rdfs:label>inner ear disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005936 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of inner ear to harmful stimuli, such as pathogens, damaged cells, or irritants</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>内耳炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066966</obo:OAE_0004334>
        <rdfs:label>inner ear inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005937 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>This is an AE which is suddenly a partial or total inability to hear and may occur in one or both ears.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>突发性听力损失</obo:OAE_0001849>
        <obo:OAE_0004334>10061373</obo:OAE_0004334>
        <rdfs:label>sudden hearing loss AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005938 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is a group of inflammatory diseases of the middle ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Otitis_media</obo:IAO_0000119>
        <obo:OAE_0001849>中耳疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061290</obo:OAE_0004334>
        <rdfs:label>middle ear disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005939 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is fluid accumulation that can occur in the middle ear and mastoid air cells due to negative pressure produced by dysfunction of the Eustachian tube.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Otitis_media#Otitis_media_with_effusion</obo:IAO_0000119>
        <obo:OAE_0001849>中耳积液</obo:OAE_0001849>
        <obo:OAE_0004334>10062545</obo:OAE_0004334>
        <rdfs:label>middle ear effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005940 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the  ear skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>耳朵感觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10052433</obo:OAE_0004334>
        <rdfs:label>paraesthesia ear AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005941 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of the structure of external ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性外耳异常</obo:OAE_0001849>
        <obo:OAE_0004334>10062339</obo:OAE_0004334>
        <rdfs:label>anomaly of external ear congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005942 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which describes a rare congenital deformity that involves the complete absence of the pinna, the outer projected portion of the ear, and narrowing or absence of the ear canal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anotia</obo:IAO_0000119>
        <obo:OAE_0001849>无耳</obo:OAE_0001849>
        <obo:OAE_0004334>10002654</obo:OAE_0004334>
        <rdfs:label>anotia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005943 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000340"/>
        <obo:IAO_0000115>This is an AE which is physical damage to body tissues caused by a difference in pressure between a gas space inside, or in contact with, the body, and the surrounding gas or fluid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Barotrauma</obo:IAO_0000119>
        <obo:OAE_0001849>气压性中耳炎</obo:OAE_0001849>
        <obo:OAE_0004334>10004129</obo:OAE_0004334>
        <rdfs:label>barotitis media AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005944 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder characterized by recurrent inflammation of the front of the eye (the cornea) and often fever, fatigue, and weight loss, episodes of vertigo (dizziness), tinnitus (ringing in the ears) and hearing loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cogan_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>耳蜗前庭综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10056667</obo:OAE_0004334>
        <rdfs:label>cogan&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005945 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000573"/>
        <obo:IAO_0000115>This is an AE which occurs when there is a problem transferring sound waves anywhere along the pathway through the outer ear, tympanic membrane (eardrum), or middle ear (ossicles).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conductive_hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>传导性耳聋</obo:OAE_0001849>
        <obo:OAE_0004334>10010280</obo:OAE_0004334>
        <rdfs:label>conductive deafness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005946 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000212"/>
        <obo:IAO_0000115>This is an AE which it develops on the face anterior to the ascending limb of the helix, followed by the inferior portion of the ascending limb itself.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33829886/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性耳瘘</obo:OAE_0001849>
        <obo:OAE_0004334>10054215</obo:OAE_0004334>
        <rdfs:label>congenital aural fistula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005947 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000573"/>
        <obo:IAO_0000115>This is an AE which is total inability to hear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>双侧耳聋</obo:OAE_0001849>
        <obo:OAE_0004334>10052556</obo:OAE_0004334>
        <rdfs:label>deafness bilateral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005948 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000573"/>
        <obo:IAO_0000115>This is an AE which is defined as the hearing loss which is present at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22538062/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性耳聋</obo:OAE_0001849>
        <obo:OAE_0004334>10011882</obo:OAE_0004334>
        <rdfs:label>deafness congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005949 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000573"/>
        <obo:IAO_0000115>This is an AE which is a partial  inability to hear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>单侧耳聋</obo:OAE_0001849>
        <obo:OAE_0004334>10048812</obo:OAE_0004334>
        <rdfs:label>deafness unilateral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005950 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the inner ear that is characterized by episodes of vertigo, tinnitus, hearing loss, and a fullness in the ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/M%C3%A9ni%C3%A8re%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>内耳眩晕病</obo:OAE_0001849>
        <obo:OAE_0004334>10027183</obo:OAE_0004334>
        <rdfs:label>meniere&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005951 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital deformity where the pinna (external ear) is underdeveloped.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Microtia</obo:IAO_0000119>
        <obo:OAE_0001849>小耳症</obo:OAE_0001849>
        <obo:OAE_0004334>10027555</obo:OAE_0004334>
        <rdfs:label>microtia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005952 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000340"/>
        <obo:IAO_0000115>This is an AE which isolated from the middle ear in AOM are Streptococcus pneumoniae, Haemophilus influenzae, Moraxella catarrhalis,and Staphylococcus aureus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Otitis_media#Acute_otitis_media</obo:IAO_0000119>
        <obo:OAE_0001849>急性中耳炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033079</obo:OAE_0004334>
        <rdfs:label>otitis media acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005953 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000340"/>
        <obo:IAO_0000115>This is an AE which is  predominantly, nontypeable Haemophilus influenzae, Streptococcus pneumoniae and Moraxella catarrhalis caused middle ear infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15755616/</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性中耳炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065176</obo:OAE_0004334>
        <rdfs:label>otitis media bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005954 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000340"/>
        <obo:IAO_0000115>This is an AE which is a chronic inflammation of the middle ear and mastoid cavity that is characterised by discharge from the middle ear through a perforated tympanic membrane for at least 6 weeks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Otitis_media#Chronic_suppurative_otitis_media</obo:IAO_0000119>
        <obo:OAE_0001849>慢性中耳炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033081</obo:OAE_0004334>
        <rdfs:label>otitis media chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005955 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which starts when the tympanic membrane perforates.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21602234/</obo:IAO_0000119>
        <obo:OAE_0001849>耳漏</obo:OAE_0001849>
        <obo:OAE_0004334>10033101</obo:OAE_0004334>
        <rdfs:label>otorrhoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005956 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005956">
