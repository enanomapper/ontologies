        <obo:IAO_0000115>a cardiac ventricular disorder AE that is a condition in nwhich the right ventricle of the heart was functionally impaired. This condition usually leads to heart failure or myocardial infarction, and other cardiovascular complicationns.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/mesh/?term=right%20ventricular%20dysfunction</obo:IAO_0000119>
        <obo:OAE_0004334>10058597</obo:OAE_0004334>
        <rdfs:label>right ventricular dysfunction AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10196</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C50733</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001742 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001877"/>
        <obo:IAO_0000115>an arrhythmia AE that is characterized by a premature contraction of the ventricle</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>infranodal extrasystoles AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://dictionary.reference.com/browse/ventricular+extrasystole</obo:IAO_0000119>
        <obo:OAE_0004334>10047289</obo:OAE_0004334>
        <rdfs:label>ventricular extrasystoles AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0006696</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001743 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>an embolism disorder AE that is a result of an obstruction in a cardiac vessel due to a blood clot or other foreign matters</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>heart embolism AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Heart+embolism</obo:IAO_0000119>
        <rdfs:label>cardiac embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001744 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>a vascular disorder AE that is characterized by an obstruction in a blood vessel due to a blood clot or other foreign matter that gets stuck while traveling through the bloodstream.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/embolism</obo:IAO_0000119>
        <obo:OAE_0001849>栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10014523</obo:OAE_0004334>
        <rdfs:label>embolism AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001907</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0013922</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001746 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001742"/>
        <obo:IAO_0000115>an arrhythmia AE that results in extra, abnormal heartbeats that begin in one of the heart&apos;s two lower pumping chambers (ventricles). These extra beats disrupt the regular heart rhythm, sometimes causing the patient to feel a flip-flop or skipped beat in the chest.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>PVCs</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.com/health/premature-ventricular-contractions/DS00949</obo:IAO_0000119>
        <obo:OAE_0004334>10036614</obo:OAE_0004334>
        <rdfs:label>premature ventricular contractions AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001747 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>a cardiac valve disease AE that is charaterized by the backflow of blood from the pulmonary artery into the right ventricle, owing to imperfect functioning of the pulmonary valve</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>pulmonic incompetence AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/medical/pulmonary_valve_incompetence.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10037448</obo:OAE_0004334>
        <rdfs:label>pulmonary valve incompetence AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010444</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0034088</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001748 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>a cardiac vavle disease AE that is characterized by a congenital heart defect in which blood flow from the heart to the pulmonary artery is blocked</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>pulmonic stenosis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Pulmonary+Valve+Stenosis</obo:IAO_0000119>
        <obo:OAE_0004334>10037450</obo:OAE_0004334>
        <rdfs:label>pulmonary valve stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001749 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>a vasculitis AE that is an inflammation specific to an artery or arteries</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/arteritis</obo:IAO_0000119>
        <obo:OAE_0004334>10003230</obo:OAE_0004334>
        <rdfs:label>arteritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005291</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003860</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001751 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>a vascular disorder AE that results in an abnormal widening or ballooning of a portion of an artery due to weakness in the wall of the blood vessel</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001122.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10002329</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aneurysm AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002617</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002940</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>a vascular disorder that affects the veins or blood circulation of the veins</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <rdfs:label xml:lang="en">venous disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001753 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>an aneurysm AE that results in the weakening of the balloon-like bulge that the blood pressure causes the artery wall to leak or burst</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>SAH</obo:IAO_0000118>
        <obo:IAO_0000118>ruptured aneurysm AE</obo:IAO_0000118>
        <obo:IAO_0000118>subarachnoid hemorrhage AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.mayfieldclinic.com/PE-AneurRupt.htm#.Uor4tI3QHh0</obo:IAO_0000119>
        <obo:OAE_0004334>10048380</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aneurysm ruptured AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002617</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0162869</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001754 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>an aneurysm AE that refers to an aneurysm involving cardiac tissue. This most often occurs as a ventricular aneurysm following a myocardial infarction</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>aneurysm of heart AE</obo:IAO_0000118>
        <obo:IAO_0000118>heart aneurysm AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/19239694</obo:IAO_0000119>
        <obo:OAE_0004334>10007513</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cardiac aneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001755 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>an aneurysm AE that occurs in the aorta</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.webmd.com/heart-disease/tc/aortic-aneurysm-overview</obo:IAO_0000119>
        <obo:OAE_0004334>10002882</obo:OAE_0004334>
