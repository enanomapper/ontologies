        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000498"/>
        <obo:IAO_0000115>This is an AE which is the most common bacterial infection in children and can be the early clinical manifestation of congenital anomalies of the kidney and urinary tract (CAKUT) or be related to bladder dysfunctions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31783012/</obo:IAO_0000119>
