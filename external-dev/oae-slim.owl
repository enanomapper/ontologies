        <obo:OAE_0004334>10008910</obo:OAE_0004334>
        <rdfs:label>chronic hepatitis b AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006583 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002402"/>
        <obo:IAO_0000115>This is an AE which is believed to be an autosomal dominant condition in which multiple lipomas are present on the body such as pancreas lipomatosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/?term=pancreas+lipomatosis</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺脂肪瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10050831</obo:OAE_0004334>
        <rdfs:label>pancreas lipomatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006585 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which arises when cells in the pancreas, a glandular organ behind the stomach, begin to multiply out of control and form a mass.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatic_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>胰脏癌</obo:OAE_0001849>
        <obo:OAE_0004334>10033609</obo:OAE_0004334>
        <rdfs:label>pancreatic carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006586 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a fluid filled sac within the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatic_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10033615</obo:OAE_0004334>
        <rdfs:label>pancreatic cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006587 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which occurs in patients of every age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11977935/</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10033616</obo:OAE_0004334>
        <rdfs:label>pancreatic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006588 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is reported to induce pancreatic fibrosis  and this type of pancreatic change was classified as a special type of CP, obstructive CP.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/13678692/</obo:IAO_0000119>
        <obo:OAE_0001849>胰管梗阻</obo:OAE_0001849>
        <obo:OAE_0004334>10052765</obo:OAE_0004334>
        <rdfs:label>pancreatic duct obstruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is some form of trauma sustained by the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatic_injury</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10033627</obo:OAE_0004334>
        <rdfs:label>pancreatic injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006590 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is the inability to properly digest food due to a lack of digestive enzymes made by the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exocrine_pancreatic_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10033628</obo:OAE_0004334>
        <rdfs:label>pancreatic insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006591 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of pancreatic tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061902</obo:OAE_0004334>
        <rdfs:label>pancreatic neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006592 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a circumscribed collection of fluid rich in pancreatic enzymes, blood, and necrotic tissue, typically located in the lesser sac of the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatic_pseudocyst</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺假性囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10033635</obo:OAE_0004334>
        <rdfs:label>pancreatic pseudocyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006593 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which describes a disease ranging from infiltration of fat in the pancreas to pancreatic inflammation, and development of pancreatic fibrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32490903/</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺脂肪变性</obo:OAE_0001849>
        <obo:OAE_0004334>10072787</obo:OAE_0004334>
        <rdfs:label>pancreatic steatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006594 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000195"/>
        <obo:IAO_0000115>This is an AE which is a long-standing inflammation of the pancreas that alters the organ&apos;s normal structure and functions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_pancreatitis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性胰腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033649</obo:OAE_0004334>
        <rdfs:label>pancreatitis chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006595 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000195"/>
        <obo:IAO_0000115>This is an AE which is a condition with mumps characterized by inflammation of the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatitis</obo:IAO_0000119>
        <obo:OAE_0001849>胰腺炎腮腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033653</obo:OAE_0004334>
