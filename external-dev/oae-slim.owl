        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is uncommon and may occur in cases of generalized porokeratosis with genital involvement or be localized to the genital area.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
