        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003441"/>
        <obo:IAO_0000115>This is an AE which is a condition of the middle ear where one or more foci of irregularly laid spongy bone replace part of normally dense enchondral layer of bony otic capsule in the bony labyrinth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Otosclerosis</obo:IAO_0000119>
