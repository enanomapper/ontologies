    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Nystagmus AE is an eye AE that is a condition of involuntary eye movement, acquired in infancy or later in life, that may result in reduced or limited vision. Due to the involuntary movement of the eye, it is often called &quot;dancing eyes&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nystagmus</obo:IAO_0000119>
        <obo:OAE_0004334>10029864</obo:OAE_0004334>
        <rdfs:label>nystagmus AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12748</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C3282</rdfs:seeAlso>
        <rdfs:seeAlso>眼球震颤</rdfs:seeAlso>
    </owl:Class>
    


