        <obo:OAE_0004334>10037649</obo:OAE_0004334>
        <rdfs:label>pyogenic granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009287 -->


