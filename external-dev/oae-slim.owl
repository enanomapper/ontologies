    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004731 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002601"/>
        <obo:IAO_0000115>This is an AE which is the tenth cranial nerve or CN X, and interfaces with the parasympathetic control of the heart, lungs, and digestive tract and its function gets disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
