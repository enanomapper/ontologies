    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <obo:IAO_0000115>This is an AE which is a post procedural medical condition in which poor blood flow to the brain causes cell death.</obo:IAO_0000115>
