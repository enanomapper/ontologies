        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is the most common hereditary blood-clotting disorder in humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Von_Willebrand_disease</obo:IAO_0000119>
        <obo:OAE_0001849>冯维勒布兰德病</obo:OAE_0001849>
        <obo:OAE_0004334>10047715</obo:OAE_0004334>
        <rdfs:label>von willebrand&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005592 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000542"/>
        <obo:IAO_0000115>This is an AE which is an autosomal-recessive genetic disease that causes difficulty walking, a loss of sensation in the arms and legs, and impaired speech that worsens over time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Friedreich%27s_ataxia</obo:IAO_0000119>
        <obo:OAE_0001849>弗里德希氏共济失调</obo:OAE_0001849>
        <obo:OAE_0004334>10017374</obo:OAE_0004334>
        <rdfs:label>friedreich&apos;s ataxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005593 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder in which glucocerebroside (a sphingolipid, also known as glucosylceramide) accumulates in cells and certain organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gaucher%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>高歇氏病</obo:OAE_0001849>
        <obo:OAE_0004334>10018048</obo:OAE_0004334>
        <rdfs:label>gaucher&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005594 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic disorder in which large sugar molecules called glycosaminoglycans (or GAGs or mucopolysaccharides) build up in body tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hunter_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>黏多糖病二期</obo:OAE_0001849>
        <obo:OAE_0004334>10056889</obo:OAE_0004334>
        <rdfs:label>mucopolysaccharidosis ii AE</rdfs:label>
    </owl:Class>
    


