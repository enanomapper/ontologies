        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus in the pleural cavity caused by microorganisms, usually bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
