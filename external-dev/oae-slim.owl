    <!-- http://purl.obolibrary.org/obo/OAE_0008472 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is defined as complete or partial fusion of the labia minora in the midline through flimsy or dense adhesions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
