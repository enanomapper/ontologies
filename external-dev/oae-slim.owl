    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005618 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>This is an AE which is the solid or semisolid remains of food that could not be digested or absorbed in the small intestine of humans, but has been further broken down by bacteria in the large intestine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_feces</obo:IAO_0000119>
        <obo:OAE_0001849>粪便硬</obo:OAE_0001849>
        <obo:OAE_0004334>10016101</obo:OAE_0004334>
        <rdfs:label>faeces hard AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005619 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>This is an AE which is the passage of fresh blood through the anus, usually in or with stools (contrast with melena).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematochezia</obo:IAO_0000119>
        <obo:OAE_0001849>便血</obo:OAE_0001849>
        <obo:OAE_0004334>10018836</obo:OAE_0004334>
        <rdfs:label>haematochezia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005620 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which determined by self-report, was defined as difficulty in passing stool, hard stool, straining for more than 15 min, or incomplete evacuation, occurring at least weekly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18340532/</obo:IAO_0000119>
        <obo:OAE_0001849>阻塞性排便</obo:OAE_0001849>
        <obo:OAE_0004334>10076953</obo:OAE_0004334>
        <rdfs:label>obstructive defecation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005621 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which is defined as the infrequent passage of stools or difficulty with evacuation of stools.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30228729/</obo:IAO_0000119>
        <obo:OAE_0001849>排便困难</obo:OAE_0001849>
        <obo:OAE_0004334>10055664</obo:OAE_0004334>
        <rdfs:label>painful defecation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005622 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000602"/>
        <obo:IAO_0000115>This is an AE which is defined as the infrequent passage of stools or difficulty with evacuation of stools after post procedural.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30228729/</obo:IAO_0000119>
        <obo:OAE_0001849>术后便秘</obo:OAE_0001849>
        <obo:OAE_0004334>10068620</obo:OAE_0004334>
        <rdfs:label>post procedural constipation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005623 -->


