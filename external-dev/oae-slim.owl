        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000212"/>
        <obo:IAO_0000115>This is an AE which is an abnormal connection between two hollow spaces (technically, two epithelialized surfaces) on post procedural, such as blood vessels, intestines, or other hollow organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fistula</obo:IAO_0000119>
        <obo:OAE_0001849>术后瘘管</obo:OAE_0001849>
        <obo:OAE_0004334>10061489</obo:OAE_0004334>
        <rdfs:label>post procedural fistula AE</rdfs:label>
    </owl:Class>
    


