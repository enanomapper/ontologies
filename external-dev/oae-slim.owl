    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005209 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003437"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the anus and the lining of the rectum with haemorrhagic, affecting only the last 6 inches of the rectum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Proctitis</obo:IAO_0000119>
        <obo:OAE_0001849>出血性直肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10036778</obo:OAE_0004334>
        <rdfs:label>proctitis haemorrhagic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005210 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is all the tissue  in the body that is not hardened by the processes of ossification or calcification with haemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Soft_tissue</obo:IAO_0000119>
        <obo:OAE_0001849>软组织出血</obo:OAE_0001849>
        <obo:OAE_0004334>10051297</obo:OAE_0004334>
        <rdfs:label>soft tissue hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005211 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels occured on splenic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>脾出血</obo:OAE_0001849>
        <obo:OAE_0004334>10041647</obo:OAE_0004334>
        <rdfs:label>splenic hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005212 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is a recognized characteristic physical sign of endocarditis and  other systemic conditions associated with splinter haemorrhages include systemic lupus erythematosus, rheumatoid arthritis, antiphospholipid syndrome, peptic ulcer disease, malignancies, use of the oral contraceptive pill, pregnancy and psoriasis .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24273777/</obo:IAO_0000119>
        <obo:OAE_0001849>碎片出血</obo:OAE_0001849>
        <obo:OAE_0004334>10041663</obo:OAE_0004334>
        <rdfs:label>splinter hemorrhages AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005213 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001428"/>
        <obo:IAO_0000115>This is an AE which is bleeding into the subarachnoid space the neonatal area between the arachnoid membrane and the pia mater surrounding the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subarachnoid_hemorrhage</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿蛛网膜下腔出血</obo:OAE_0001849>
        <obo:OAE_0004334>10042317</obo:OAE_0004334>
        <rdfs:label>subarachnoid hemorrhage neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005214 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000232"/>
        <obo:IAO_0000115>This is an AE which is bleeding beneath the chorion membranes that enclose the embryo in the uterus and appears to occur due to partial detachment of the chorion membranes from the wall of the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32644443/</obo:IAO_0000119>
        <obo:OAE_0001849>绒毛膜下血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10072596</obo:OAE_0004334>
        <rdfs:label>subchorionic hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005215 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000232"/>
        <obo:IAO_0000115>This is an AE which is bleeding beneath the chorion membranes that enclose the embryo in the uterus and appears to occur due to partial detachment of the chorion membranes from the wall of the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32644443/</obo:IAO_0000119>
        <obo:OAE_0001849>绒毛膜下出血</obo:OAE_0001849>
        <obo:OAE_0004334>10071010</obo:OAE_0004334>
        <rdfs:label>subchorionic hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005216 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a type of bleeding in which a collection of blood—usually associated with a traumatic brain injury—gathers between the inner layer of the dura mater and the arachnoid mater of the meninges surrounding the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subdural_hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜下出血</obo:OAE_0001849>
        <obo:OAE_0004334>10042364</obo:OAE_0004334>
        <rdfs:label>subdural hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005217 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is usually considered a single entity although the thalamus is composed of anatomically as well as functionally discrete subregions receiving blood from different arteries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9009994/</obo:IAO_0000119>
        <obo:OAE_0001849>丘脑出血</obo:OAE_0001849>
        <obo:OAE_0004334>10058939</obo:OAE_0004334>
        <rdfs:label>thalamus hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005218 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000530"/>
        <obo:IAO_0000115>This is an AE which is a condition characterized by increased intracranial pressure (pressure around the brain) without a detectable cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Idiopathic_intracranial_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>良性颅内高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10004277</obo:OAE_0004334>
        <rdfs:label>benign intracranial hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005219 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002078"/>
        <obo:IAO_0000115>This is an AE which is the pressure of circulating blood against the walls of blood vessels and the data is fluctuation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blood_pressure</obo:IAO_0000119>
        <obo:OAE_0001849>血压波动</obo:OAE_0001849>
        <obo:OAE_0004334>10005746</obo:OAE_0004334>
        <rdfs:label>blood pressure fluctuation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005220 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is the form of hypertension that by definition has no identifiable secondary cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Essential_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>原发性高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10015488</obo:OAE_0004334>
        <rdfs:label>essential hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005221 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is the development of new hypertension in a pregnant woman after 20 weeks&apos; gestation without the presence of protein in the urine or other signs of pre-eclampsia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gestational_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠期高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10070538</obo:OAE_0004334>
        <rdfs:label>gestational hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005222 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000530"/>
        <obo:IAO_0000115>This is an AE which is a condition characterized by increased intracranial pressure (pressure around the brain) without a detectable cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Idiopathic_intracranial_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>特发性颅内高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10078904</obo:OAE_0004334>
        <rdfs:label>idiopathic intracranial hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005223 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is very high blood pressure with potentially life-threatening symptoms and signs of acute damage to one or more organ systems (especially brain, eyes, heart, aorta, or kidneys).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertensive_emergency</obo:IAO_0000119>
        <obo:OAE_0001849>恶性高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10025600</obo:OAE_0004334>
        <rdfs:label>malignant hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005224 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is defined as systolic and/or diastolic BPs persistently equal to or greater than the 95th percentile  for age, gender, and height.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29808264/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿低血压</obo:OAE_0001849>
        <obo:OAE_0004334>10049223</obo:OAE_0004334>
        <rdfs:label>neonatal hypotension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005225 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is a medical condition consisting of a sudden and abrupt increase in blood pressure (BP) when a person stands up.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Orthostatic_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>直立性高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10065508</obo:OAE_0004334>
        <rdfs:label>orthostatic hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005226 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is defined by the coexistence of portal and pulmonary hypertension and is a serious complication of liver disease, present in 0.25 to 4% of all patients suffering from cirrhosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Portopulmonary_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>肺移植性高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10067281</obo:OAE_0004334>
        <rdfs:label>portopulmonary hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005227 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the development of new hypertension in a pregnant woman after 20 weeks&apos; gestation without the presence of protein in the urine or other signs of pre-eclampsia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gestational_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10036563</obo:OAE_0004334>
        <rdfs:label>pregnancy induced hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005228 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is a condition in which high blood pressure is caused by the kidneys&apos; hormonal response to narrowing of the arteries supplying the kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Renovascular_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>肾性高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10038464</obo:OAE_0004334>
        <rdfs:label>renal hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005229 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is defined as an elevated systolic blood pressure (SBP).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Systolic_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>收缩期高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10042957</obo:OAE_0004334>
        <rdfs:label>systolic hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005230 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is a form of labile hypertension in which people exhibit a blood pressure level above the normal range, in a clinical setting, although they do not exhibit it in other settings.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/White_coat_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>白大衣高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10051581</obo:OAE_0004334>
        <rdfs:label>white coat hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005231 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002577"/>
        <obo:IAO_0000115>This is an AE which is a usually benign vascular tumor occurs on intracranialderived from blood vessel cell types .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemangioma</obo:IAO_0000119>
        <obo:OAE_0001849>颅内血管瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10022759</obo:OAE_0004334>
        <rdfs:label>intracranial haemangioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005232 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002078"/>
        <obo:IAO_0000115>This is an AE which occurs when there are unexpected changes in blood pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Labile_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>血压不稳定</obo:OAE_0001849>
        <obo:OAE_0004334>10023533</obo:OAE_0004334>
        <rdfs:label>labile blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005233 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>This is an AE which occurs when there are unexpected changes in blood pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Labile_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>高血压不稳定</obo:OAE_0001849>
        <obo:OAE_0004334>10049079</obo:OAE_0004334>
        <rdfs:label>labile hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005234 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002464"/>
        <obo:IAO_0000115>This is an AE which is an ultrasound (US) visible lesion of the brain, which appears as echogenic streaks or spots in the arteries of thalamus and basal ganglia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21648326/</obo:IAO_0000119>
        <obo:OAE_0001849>连状纹状体血管病变</obo:OAE_0001849>
        <obo:OAE_0004334>10073774</obo:OAE_0004334>
        <rdfs:label>lenticulostriatal vasculopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005235 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001126"/>
        <obo:IAO_0000115>This is an AE which is inflammation of small blood vessels (usually post-capillary venules in the dermis), characterized by palpable purpura and it is the most common vasculitis seen in clinical practice.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cutaneous_small-vessel_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>白细胞性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10024377</obo:OAE_0004334>
        <rdfs:label>leukocytoclastic vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005236 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which injury to the large or small intestine occurs due to not enough blood supply.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intestinal_ischemia</obo:IAO_0000119>
        <obo:OAE_0001849>肠系膜血管机能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10027401</obo:OAE_0004334>
        <rdfs:label>mesenteric vascular insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005237 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002483"/>
        <obo:IAO_0000115>This is an AE which refers to the subset of disorders affecting the structure and function of the coronary microcirculation, is prevalent in patients across a broad spectrum of cardiovascular risk factors, and is associated with an increased risk of adverse events.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30466521/</obo:IAO_0000119>
        <obo:OAE_0001849>微血管冠状动脉疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10072685</obo:OAE_0004334>
        <rdfs:label>microvascular coronary artery disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005238 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition that presents as slowly growing, multiple, discrete but grouped, red to violaceous papules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multinucleate_cell_angiohistiocytoma</obo:IAO_0000119>
        <obo:OAE_0001849>多核细胞血管组织细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10077003</obo:OAE_0004334>
        <rdfs:label>multinucleate cell angiohistiocytoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005239 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001155"/>
        <obo:IAO_0000115>This is an AE which constitutes a prevalent, chronic, and progressive retinal degenerative disease of the macula that affects elderly people and cause central vision impairment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33153227/</obo:IAO_0000119>
        <obo:OAE_0001849>新生血管老年性黄斑变性</obo:OAE_0001849>
        <obo:OAE_0004334>10071129</obo:OAE_0004334>
        <rdfs:label>neovascular age-related macular degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005240 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is the natural formation of new blood vessels (neo- + vascular + -ization), usually in the form of functional microvascular networks, capable of perfusion by red blood cells, that form to serve as collateral circulation in response to local poor perfusion or ischemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neovascularization</obo:IAO_0000119>
        <obo:OAE_0001849>新血管化</obo:OAE_0001849>
        <obo:OAE_0004334>10029113</obo:OAE_0004334>
        <rdfs:label>neovascularisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005241 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a skin condition characterized by crops of small, tender, erythematous nodules on the legs, mostly on the calves and shins.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nodular_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>结节性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10029491</obo:OAE_0004334>
        <rdfs:label>nodular vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005242 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003432"/>
        <obo:IAO_0000115>This is an AE which encompass a large and diverse group of underlying pathologies ranging from venous thromboembolism to congenital malformations to inflammatory vasculitides.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26024602/</obo:IAO_0000119>
        <obo:OAE_0001849>肺血管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061474</obo:OAE_0004334>
        <rdfs:label>pulmonary vascular disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005243 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003432"/>
        <obo:IAO_0000115>This is an AE which encompasses inflammation in the pulmonary vasculature with involved vessels varying in caliber from large elastic arteries to capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25836645/</obo:IAO_0000119>
        <obo:OAE_0001849>肺血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037457</obo:OAE_0004334>
        <rdfs:label>pulmonary vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005244 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a disease characterized by a weeks-long course of thunderclap headaches, sometimes focal neurologic signs, and occasionally seizures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reversible_cerebral_vasoconstriction_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>可逆性脑血管收缩综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10073240</obo:OAE_0004334>
        <rdfs:label>reversible cerebral vasoconstriction syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005245 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is skin condition that is a typical feature of rheumatoid arthritis, presenting as peripheral vascular lesions that are localized purpura, cutaneous ulceration, and gangrene of the distal parts of the extremities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rheumatoid_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>类风湿性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048628</obo:OAE_0004334>
        <rdfs:label>rheumatoid vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005246 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <obo:IAO_0000115>This is an AE which is an area of swelling (edema) of the lower layer of small bowel tissue just under the skin or mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angioedema</obo:IAO_0000119>
        <obo:OAE_0001849>小肠血管性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051401</obo:OAE_0004334>
        <rdfs:label>small bowel angiedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005247 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which are rare and constitute only 1% to 2% of all vascular neurologic pathologies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17493539/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓血管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061369</obo:OAE_0004334>
        <rdfs:label>spinal vascular disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005248 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000400"/>
        <obo:IAO_0000115>This is an AE which is a form of dysautonomia characterized by an inappropriate drop in blood pressure while in the upright position.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypotension#Vasovagal_syncope</obo:IAO_0000119>
        <obo:OAE_0001849>迷走性晕厥血管</obo:OAE_0001849>
        <obo:OAE_0004334>10042777</obo:OAE_0004334>
        <rdfs:label>syncope vasovagal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005249 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers to a recognized group of birth defects which tend to co-occur (see below).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/VACTERL_association</obo:IAO_0000119>
        <obo:OAE_0001849>血管综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10066022</obo:OAE_0004334>
        <rdfs:label>vacterl syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005250 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a skin condition characterized by fixed urticarial lesions that appear histologically as a vasculitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urticarial_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>荨麻疹性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048820</obo:OAE_0004334>
        <rdfs:label>urticarial vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005251 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is any of a range of lesions from a simple birthmark to a large tumor that may be disfiguring.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vascular_anomaly</obo:IAO_0000119>
        <obo:OAE_0001849>血管异常</obo:OAE_0001849>
        <obo:OAE_0004334>10047050</obo:OAE_0004334>
        <rdfs:label>vascular anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005252 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a complex and highly regulated process that involves activation of cellular signaling pathways, circulating inhibitors of calcification, genetic factors, and hormones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25435520/</obo:IAO_0000119>
        <obo:OAE_0001849>血管钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10051753</obo:OAE_0004334>
        <rdfs:label>vascular calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005253 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000494"/>
        <obo:IAO_0000115>This is an AE which means any disorder or disease of the brain vascular , especially chronic degenerative conditions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Encephalopathy</obo:IAO_0000119>
        <obo:OAE_0001849>血管性脑病</obo:OAE_0001849>
        <obo:OAE_0004334>10063661</obo:OAE_0004334>
        <rdfs:label>vascular encephalopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005255 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is the use of transplanted or prosthetic blood vessels in surgical procedures and after surgical appears complication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Graft_(surgery)</obo:IAO_0000119>
        <obo:OAE_0001849>血管移植并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10064252</obo:OAE_0004334>
        <rdfs:label>vascular graft complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005256 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is an outdated term to describe certain types of headache which were thought to be related to blood vessel swelling and hyperemia as cause of pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vascular_headache</obo:IAO_0000119>
        <obo:OAE_0001849>血管性头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10047077</obo:OAE_0004334>
        <rdfs:label>vascular headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005257 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a devastating complication of acute knee dislocation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24554457/</obo:IAO_0000119>
        <obo:OAE_0001849>血管损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10047080</obo:OAE_0004334>
        <rdfs:label>vascular injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005258 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a blood vessel or lymph vessel abnormality. Vascular malformations are one of the classifications of vascular anomalies, the other grouping is vascular tumors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vascular_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>血管畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10074979</obo:OAE_0004334>
        <rdfs:label>vascular malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a tumor of vascular origin; a soft tissue growth that can be either benign or malignant, formed from blood vessels or lymph vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vascular_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>血管肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10055031</obo:OAE_0004334>
        <rdfs:label>vascular neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005260 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is when there is a local hematoma being contained by the surrounding tissue around an vascular artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pseudoaneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>血管假性动脉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10048975</obo:OAE_0004334>
        <rdfs:label>vascular pseudoaneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005261 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which is a condition of red or purple discolored spots on the skin that do not blanch on applying pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Purpura</obo:IAO_0000119>
        <obo:OAE_0001849>血管性紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10047097</obo:OAE_0004334>
        <rdfs:label>vascular purpura AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005262 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the human skin which affects its color, appearance, or texture and causes by vascular disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>血管炎性皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10047111</obo:OAE_0004334>
        <rdfs:label>vasculitic rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005263 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is vasculitis (inflammation of the blood vessel wall) involving the brain and occasionally the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebral_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>脑血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047119</obo:OAE_0004334>
        <rdfs:label>vasculitis cerebral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005264 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is the narrowing of the blood vessels resulting from contraction of the muscular wall of the vessels, in particular the large arteries and small arterioles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasoconstriction</obo:IAO_0000119>
        <obo:OAE_0001849>血管收缩</obo:OAE_0001849>
        <obo:OAE_0004334>10047139</obo:OAE_0004334>
        <rdfs:label>vasoconstriction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005265 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000761"/>
        <obo:IAO_0000115>This is an AE which is excess accumulation of fluid (edema) in the intracellular or extracellular spaces of the vasogenic brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebral_edema</obo:IAO_0000119>
        <obo:OAE_0001849>血管源性脑水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10067275</obo:OAE_0004334>
        <rdfs:label>vasogenic cerebral edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005266 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000350"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the inner part of the nose that is not caused by an allergy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nonallergic_rhinitis</obo:IAO_0000119>
        <obo:OAE_0001849>血管运动性鼻炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047145</obo:OAE_0004334>
        <rdfs:label>vasomotor rhinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005267 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a postperfusion syndrome characterized by low systemic vascular resistance and a high cardiac output.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasoplegic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>血管麻痹综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10067080</obo:OAE_0004334>
        <rdfs:label>vasoplegia syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005268 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which  refers to a condition in which an arterial spasm leads to vasoconstriction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasospasm</obo:IAO_0000119>
        <obo:OAE_0001849>血管痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10047163</obo:OAE_0004334>
        <rdfs:label>vasospasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005269 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002580"/>
        <obo:IAO_0000115>This is an AE which is a type of arrhythmia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arrhythmia#Ventricular_arrhythmia</obo:IAO_0000119>
        <obo:OAE_0001849>室性心律失常</obo:OAE_0001849>
        <obo:OAE_0004334>10047281</obo:OAE_0004334>
        <rdfs:label>ventricular arrhythmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005271 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>This is an AE which refers to a condition where the left atrium or right atrium of the heart is larger than would be expected. It can also affect both atria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrial_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>心室扩大</obo:OAE_0001849>
        <obo:OAE_0004334>10079339</obo:OAE_0004334>
        <rdfs:label>ventricular enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005272 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>This is an AE which is a set of manifestations caused by the failure of the heart&apos;s function as a pump supporting the blood flow through the body; its signs and symptoms result from a structural and/or functional abnormality of the heart, that disrupts its filling with blood or its ejecting of it during each heart beat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heart_failure</obo:IAO_0000119>
        <obo:OAE_0001849>心室衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10060953</obo:OAE_0004334>
        <rdfs:label>ventricular failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005273 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000301"/>
        <obo:IAO_0000115>This is an AE which is an arrhythmia, more specifically a tachycardia affecting the ventricles with a rate over 250-350 beats/min, and one of the most indiscernible.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ventricular_flutter</obo:IAO_0000119>
        <obo:OAE_0001849>心室扑动</obo:OAE_0001849>
        <obo:OAE_0004334>10047294</obo:OAE_0004334>
        <rdfs:label>ventricular flutter AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005274 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>This is an AE which is thickening of the walls of a ventricle (lower chamber) of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ventricular_hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>心室肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10047295</obo:OAE_0004334>
        <rdfs:label>ventricular hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005275 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000421"/>
        <obo:IAO_0000115>This is an AE which is one of the classifications of movement disorders causes by ventricular disease, and refers to decreased bodily movement .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypokinesia</obo:IAO_0000119>
        <obo:OAE_0001849>心室运动减退</obo:OAE_0001849>
        <obo:OAE_0004334>10050510</obo:OAE_0004334>
        <rdfs:label>ventricular hypokinesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005276 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>This is an AE which is a defect in the ventricular septum, the wall dividing the left and right ventricles of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ventricular_septal_defect</obo:IAO_0000119>
        <obo:OAE_0001849>室间隔缺损</obo:OAE_0001849>
        <obo:OAE_0004334>10047298</obo:OAE_0004334>
        <rdfs:label>ventricular septal defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005277 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which consists of multiple, radially oriented dilated medullary veins that drain into a transparenchymal venous stem.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/1442406/</obo:IAO_0000119>
        <obo:OAE_0001849>脑静脉血管瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10053485</obo:OAE_0004334>
        <rdfs:label>venous angioma of brain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005278 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders that destroy blood vessels by inflammation caused by viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10056281</obo:OAE_0004334>
        <rdfs:label>viral vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005279 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is a rare hemorrhagic diathesis, with clinical symptoms similar to those associated with the inherited form von Willebrand disease and  syndrome is characterized by a lack of previous bleeding symptoms, negative familial history, and occurrence in a relatively older age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28028990/</obo:IAO_0000119>
        <obo:OAE_0001849>获得性血管性血友病</obo:OAE_0001849>
        <obo:OAE_0004334>10069495</obo:OAE_0004334>
        <rdfs:label>acquired von willebrand&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005280 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is small, reddish brown or even flesh-colored, smooth, shiny, 0.1 to 0.3 cm papules present over the sides of the nose and the medial portions of the cheeks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angiofibroma</obo:IAO_0000119>
        <obo:OAE_0001849>血管纤维瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10002429</obo:OAE_0004334>
        <rdfs:label>angiofibroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005281 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a mature T-cell lymphoma of blood or lymph vessel immunoblasts characterized by a polymorphous lymph node infiltrate showing a marked increase in follicular dendritic cells (FDCs) and high endothelial venules (HEVs) and systemic involvement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angioimmunoblastic_T-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>血管免疫母细胞性t细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10002449</obo:OAE_0004334>
        <rdfs:label>angioimmunoblastic t-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005282 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is the most common benign tumour of the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angiomyolipoma</obo:IAO_0000119>
        <obo:OAE_0001849>血管肌脂肪瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10051810</obo:OAE_0004334>
        <rdfs:label>angiomyolipoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005283 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a rare and aggressive cancer that starts in the endothelial cells that line the walls of blood vessels or lymphatic vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angiosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>恶性血管皮内细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10002476</obo:OAE_0004334>
        <rdfs:label>angiosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005284 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002078"/>
        <obo:IAO_0000115>This is an AE which is a central component of the renin–angiotensin system (RAS), which controls blood pressure by regulating the volume of fluids in the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angiotensin-converting_enzyme</obo:IAO_0000119>
        <obo:OAE_0001849>血管紧张素转换酶</obo:OAE_0001849>
        <obo:OAE_0004334>10050289</obo:OAE_0004334>
        <rdfs:label>angiotensin converting enzyme AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005285 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is the creation of new blood vessels in the choroid layer of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Choroidal_neovascularization</obo:IAO_0000119>
        <obo:OAE_0001849>脉络膜新生血管形成</obo:OAE_0001849>
        <obo:OAE_0004334>10060823</obo:OAE_0004334>
        <rdfs:label>choroidal neovascularisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005286 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is any disease that has the connective tissues of the body as a target of pathology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Connective_tissue_disease</obo:IAO_0000119>
        <obo:OAE_0001849>胶原血管病</obo:OAE_0001849>
        <obo:OAE_0004334>10009905</obo:OAE_0004334>
        <rdfs:label>collagen-vascular disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005287 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which can be arbitrarily divided into micro- and macrovascular complications, the major microvascular complications being nephropathy, retinopathy and neuropathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9315387/</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病性血管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061815</obo:OAE_0004334>
        <rdfs:label>diabetic vascular disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005288 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is an extremely rare autoimmune condition that causes inflammation of small and medium-sized blood vessels (vasculitis) in persons with a history of airway allergic hypersensitivity (atopy).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_granulomatosis_with_polyangiitis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性肉芽肿伴多血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10078117</obo:OAE_0004334>
        <rdfs:label>eosinophilic granulomatosis with polyangiitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005289 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>This is an AE which is the rupturing (lysis) of intravascular red blood cells (erythrocytes) and the release of their contents (cytoplasm) into surrounding fluid (e.g. blood plasma) .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemolysis</obo:IAO_0000119>
        <obo:OAE_0001849>血管内溶血</obo:OAE_0001849>
        <obo:OAE_0004334>10022822</obo:OAE_0004334>
        <rdfs:label>intravascular haemolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005290 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000207"/>
        <obo:IAO_0000115>This is an AE which is a rare, benign tumor. It may mimic an angiosarcoma, with lesions that are red or purplish 5-mm to 5-cm papules and deep nodules on the head, neck, or upper extremities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intravascular_papillary_endothelial_hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>血管内乳头状内皮增生</obo:OAE_0001849>
        <obo:OAE_0004334>10060711</obo:OAE_0004334>
        <rdfs:label>intravascular papillary endothelial hyperplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005291 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000935"/>
        <obo:IAO_0000115>This is an AE which is the natural formation of new iris blood vessels (neo- + vascular + -ization), usually in the form of functional microvascular networks, capable of perfusion by red blood cells, that form to serve as collateral circulation in response to local poor perfusion or ischemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neovascularization</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜新生血管化</obo:OAE_0001849>
        <obo:OAE_0004334>10065630</obo:OAE_0004334>
        <rdfs:label>iris neovascularisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005292 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which is a rare anatomical variant in which the aortic arch is on the right side rather than on the left. During normal embryonic development, the aortic arch is formed by the left fourth aortic arch and the left dorsal aorta.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Right-sided_aortic_arch</obo:IAO_0000119>
        <obo:OAE_0001849>右主动脉弓</obo:OAE_0001849>
        <obo:OAE_0004334>10067407</obo:OAE_0004334>
        <rdfs:label>right aortic arch AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005293 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001173"/>
        <obo:IAO_0000115>This is an AE which occurs late after the modified Fontan procedure is frequently associated with low output states, supraventricular arrhythmias, and atrial thrombus formation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9240287/</obo:IAO_0000119>
        <obo:OAE_0001849>右心房扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10067282</obo:OAE_0004334>
        <rdfs:label>right atrial dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005294 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>This is an AE which is a form of cardiomegaly, or heart enlargement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Right_atrial_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>右心房扩大</obo:OAE_0001849>
        <obo:OAE_0004334>10058227</obo:OAE_0004334>
        <rdfs:label>right atrial enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005295 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which may can result in a lack of emotional prosody or intonation when speaking. Right hemisphere damage also has grave effects on understanding discourse and  have a reduced ability to generate inferences, comprehend and produce main concepts, and a reduced ability to manage alternative meanings.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lateralization_of_brain_function#Hemisphere_damage</obo:IAO_0000119>
        <obo:OAE_0001849>右半球缺陷综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10075037</obo:OAE_0004334>
        <rdfs:label>right hemisphere deficit syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005297 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000878"/>
        <obo:IAO_0000115>This is an AE which is an accepted indication of ASD closure  and several studies have reported that transcatheter ASD closure results in RV remodeling and exercise capacity improvement .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32410917/</obo:IAO_0000119>
        <obo:OAE_0001849>右心室扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10074222</obo:OAE_0004334>
        <rdfs:label>right ventricular dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005298 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001741"/>
        <obo:IAO_0000115>This is an AE which is a form of cardiomegaly, or heart enlargement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Right_atrial_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>右心室增大</obo:OAE_0001849>
        <obo:OAE_0004334>10050582</obo:OAE_0004334>
        <rdfs:label>right ventricular enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005299 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001741"/>
        <obo:IAO_0000115>This is an AE which is a condition defined by an abnormal enlargement of the cardiac muscle surrounding the right ventricle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Right_ventricular_hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>右心室肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10050326</obo:OAE_0004334>
        <rdfs:label>right ventricular hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005300 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which is an abnormal, congenital heart murmur caused by subaortic stenosis (SAS).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subvalvular_aortic_stenosis_(canine)</obo:IAO_0000119>
        <obo:OAE_0001849>瓣下主动脉瓣狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10042431</obo:OAE_0004334>
        <rdfs:label>subvalvular aortic stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005301 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which is a congenital obstructive narrowing of the aorta just above the aortic valve and is the least common type of aortic stenosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Supravalvular_aortic_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>瓣上主动脉瓣狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10042598</obo:OAE_0004334>
        <rdfs:label>supravalvular aortic stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005302 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which has been defined by Abbot as a condition in which the arterial vessels in the greater circulation remain abnormally small.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/13617202/</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10049209</obo:OAE_0004334>
        <rdfs:label>aorta hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005303 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002369"/>
        <obo:IAO_0000115>This is an AE which is the thickening, hardening, and loss of elasticity of the walls of arteries on aortic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arteriosclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10065558</obo:OAE_0004334>
        <rdfs:label>aortic arteriosclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005304 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which is the abnormal sound generated by turbulent flow of blood in an aortic artery due to either an area of partial obstruction or a localized high rate of blood flow through an unobstructed aortic bruit artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruit</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉杂音</obo:OAE_0001849>
        <obo:OAE_0004334>10051832</obo:OAE_0004334>
        <rdfs:label>aortic bruit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005305 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which refers to the widening of luminal diameter in aortic blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dilation</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10057453</obo:OAE_0004334>
        <rdfs:label>aortic dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005306 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which could interfere with the classification of TEVAR complications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32069982/</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉延长</obo:OAE_0001849>
        <obo:OAE_0004334>10065510</obo:OAE_0004334>
        <rdfs:label>aortic elongation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005307 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which clotted blood which lines most aortic aneurysms can break off and result in an embolus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortic_aneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10002897</obo:OAE_0004334>
        <rdfs:label>aortic embolus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005308 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002578"/>
        <obo:IAO_0000115>This is an AE which due to aortic thrombosis is a rare condition which is often life-threatening. and occurs most commonly in individuals who are predisposed to cardiovascular diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31079271/</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10058178</obo:OAE_0004334>
        <rdfs:label>aortic occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005309 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is the rupture or breakage of the aorta, the largest artery in the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortic_rupture</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10060874</obo:OAE_0004334>
        <rdfs:label>aortic rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005310 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which is the narrowing of the exit of the left ventricle of the heart (where the aorta begins), such that problems result.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortic_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉瓣狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10002906</obo:OAE_0004334>
        <rdfs:label>aortic stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005311 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003433"/>
        <obo:IAO_0000115>This is an AE which refers to the calcification in and around the aortic valve can progress and extend to involve the electrical conduction system of the heart in calcific aortic stenosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortic_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉瓣钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10002918</obo:OAE_0004334>
        <rdfs:label>aortic valve calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005312 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of anaortic wall due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉壁肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10066243</obo:OAE_0004334>
        <rdfs:label>aortic wall hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005313 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the aortic walland the disorder is potentially life-threatening and rare.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortitis</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10002921</obo:OAE_0004334>
        <rdfs:label>aortitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005314 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>This is an AE which is a congenital condition whereby the aorta is narrow, usually in the area where the ductus arteriosus (ligamentum arteriosum after regression) inserts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coarctation_of_the_aorta</obo:IAO_0000119>
        <obo:OAE_0001849>主动脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10009807</obo:OAE_0004334>
        <rdfs:label>coarctation of the aorta AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005315 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is where the capillaries, usually of the legs or lungs, are inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Capillaritis</obo:IAO_0000119>
        <obo:OAE_0001849>毛细管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10068406</obo:OAE_0004334>
        <rdfs:label>capillaritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005316 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a small blood vessel from 5 to 10 micrometres (μm) in diameter, and having a wall one endothelial cell thick and its may become disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Capillary</obo:IAO_0000119>
        <obo:OAE_0001849>毛细管障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10007189</obo:OAE_0004334>
        <rdfs:label>capillary disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005317 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which might be a useful clinical sign for screening Zika virus infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28532852/</obo:IAO_0000119>
        <obo:OAE_0001849>毛细血管变脆</obo:OAE_0001849>
        <obo:OAE_0004334>10007191</obo:OAE_0004334>
        <rdfs:label>capillary fragility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005318 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001201"/>
        <obo:IAO_0000115>This is an AE which is a combination of both myocarditis and pericarditis appearing in a single individual, namely inflammation of both the pericardium and the heart muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myopericarditis</obo:IAO_0000119>
        <obo:OAE_0001849>心肌心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10028650</obo:OAE_0004334>
        <rdfs:label>myopericarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005319 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002585"/>
        <obo:IAO_0000115>This is an AE which is an abnormal dilatation of pericardium of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pericardial_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>心包囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051730</obo:OAE_0004334>
        <rdfs:label>pericardial cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005320 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002705"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing on the pericardial in which connective tissue replaces normal parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>心包纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10048724</obo:OAE_0004334>
        <rdfs:label>pericardial fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005321 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by a thickened, fibrotic pericardium, limiting the heart&apos;s ability to function normally.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Constrictive_pericarditis</obo:IAO_0000119>
        <obo:OAE_0001849>紧缩性心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034487</obo:OAE_0004334>
        <rdfs:label>pericarditis constrictive AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005322 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the pericardium (the fibrous sac surrounding the heart)and may be caused by viral, bacterial, or fungal infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pericarditis#Infectious</obo:IAO_0000119>
        <obo:OAE_0001849>感染性心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062491</obo:OAE_0004334>
        <rdfs:label>pericarditis infective AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005323 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the pericardium (the fibrous sac surrounding the heart)caused by meningococcal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pericarditis</obo:IAO_0000119>
        <obo:OAE_0001849>脑膜炎球菌心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034492</obo:OAE_0004334>
        <rdfs:label>pericarditis meningococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005324 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which is a form of pericarditis and caused by tuberculosis is difficult to diagnose, because definitive diagnosis requires culturing Mycobacterium tuberculosis from aspirated pericardial fluid or pericardial biopsy, which requires high technical skill and is often not diagnostic (the yield from culture is low even with optimum specimens).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tuberculous_pericarditis</obo:IAO_0000119>
        <obo:OAE_0001849>结核性心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10055069</obo:OAE_0004334>
        <rdfs:label>pericarditis tuberculous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005325 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which is a localised infection of the pericardial space associated with purulent pericardial fluid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18214575/</obo:IAO_0000119>
        <obo:OAE_0001849>化脓性心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10051071</obo:OAE_0004334>
        <rdfs:label>purulent pericarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005326 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the pericardium (the fibrous sac surrounding the heart).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pericarditis#Infectuous</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047472</obo:OAE_0004334>
        <rdfs:label>viral pericarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005327 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000341"/>
        <obo:IAO_0000115>This is an AE which occurs by direct infection during trauma, thoracic surgery, or catheter drainage, by spread from an intrathoracic, myocardial, or subdiaphragmatic focus, and by hematogenous dissemination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15725041/</obo:IAO_0000119>
        <obo:OAE_0001849>细菌心包炎</obo:OAE_0001849>
        <obo:OAE_0004334>10004050</obo:OAE_0004334>
        <rdfs:label>bacterial pericarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005328 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>This is an AE which is a restriction in blood supply to brain stem  tissues, causing a shortage of oxygen that is needed for cellular metabolism (to keep tissue alive).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ischemia</obo:IAO_0000119>
        <obo:OAE_0001849>脑干缺血</obo:OAE_0001849>
        <obo:OAE_0004334>10006148</obo:OAE_0004334>
        <rdfs:label>brain stem ischaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005329 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which inflammation and injury of the large intestine result from inadequate blood supply.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ischemic_colitis</obo:IAO_0000119>
        <obo:OAE_0001849>缺血性结肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10009895</obo:OAE_0004334>
        <rdfs:label>colitis ischemic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005330 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>This is an AE which is a form of hypoxia (reduced supply of oxygen), specifically involving the brain; when the brain is completely deprived of oxygen, it is called cerebral anoxia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebral_hypoxia</obo:IAO_0000119>
        <obo:OAE_0001849>缺氧缺血性脑病</obo:OAE_0001849>
        <obo:OAE_0004334>10070511</obo:OAE_0004334>
        <rdfs:label>hypoxic-ischemic encephalopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005331 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002467"/>
        <obo:IAO_0000115>This is an AE which is the pathologic process that results in an area of necrotic tissue in the ischaemic brain (cerebral infarct).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebral_infarction</obo:IAO_0000119>
        <obo:OAE_0001849>缺血性脑梗死</obo:OAE_0001849>
        <obo:OAE_0004334>10060840</obo:OAE_0004334>
        <rdfs:label>ischemic cerebral infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005332 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>This is an AE which is a recognized complication of prolonged periods of interruption of the coronary circulation during open-heart surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/1186287/</obo:IAO_0000119>
        <obo:OAE_0001849>左心室缺血挛缩</obo:OAE_0001849>
        <obo:OAE_0004334>10070589</obo:OAE_0004334>
        <rdfs:label>ischemic contracture of the left ventricle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005333 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000210"/>
        <obo:IAO_0000115>This is an AE which is a clinical syndrome frequently encountered in critically ill patients that represents a complication of underlying cardiac, circulatory, or respiratory failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28346236/</obo:IAO_0000119>
        <obo:OAE_0001849>缺血性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10023025</obo:OAE_0004334>
        <rdfs:label>ischemic hepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005334 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a dangerous condition, most often caused by diminished tissue perfusion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29742040/</obo:IAO_0000119>
        <obo:OAE_0001849>缺血性四肢疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10062610</obo:OAE_0004334>
        <rdfs:label>ischemic limb pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005335 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>This is an AE which is a devastating complication after open or endovascular aortic repair for thoracoabdominal aortic disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30507678/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓缺血</obo:OAE_0001849>
        <obo:OAE_0004334>10050209</obo:OAE_0004334>
        <rdfs:label>spinal cord ischaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005336 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital heart defect in which the septal and posterior leaflets of the tricuspid valve are displaced towards the apex of the right ventricle of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ebstein%27s_anomaly</obo:IAO_0000119>
        <obo:OAE_0001849>三尖瓣下移畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10014075</obo:OAE_0004334>
        <rdfs:label>ebstein&apos;s anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005337 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital malformation of the pulmonary artery valve in which the valve orifice fails to develop .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_atresia</obo:IAO_0000119>
        <obo:OAE_0001849>肺动脉闭锁</obo:OAE_0001849>
        <obo:OAE_0004334>10037337</obo:OAE_0004334>
        <rdfs:label>pulmonary artery atresia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005338 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001173"/>
        <obo:IAO_0000115>This is an AE which can occur from many causes, including abnormal pulmonary hemodynamics, hypoxemia, trauma, and vasculitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32022665/</obo:IAO_0000119>
        <obo:OAE_0001849>肺动脉扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10058491</obo:OAE_0004334>
        <rdfs:label>pulmonary artery dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005339 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002656"/>
        <obo:IAO_0000115>This is an AE which is not a rare condition, is mostly asymptomatic in the absence of a peripheral VA, is strongly associated with diabetes and is promoted by long TCC carriage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29893920/</obo:IAO_0000119>
        <obo:OAE_0001849>上腔静脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10064771</obo:OAE_0004334>
        <rdfs:label>superior vena cava stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005340 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002656"/>
        <obo:IAO_0000115>This is an AE which is the most common variation of the thoracic venous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Persistent_left_superior_vena_cava</obo:IAO_0000119>
        <obo:OAE_0001849>持续性左上腔静脉</obo:OAE_0001849>
        <obo:OAE_0004334>10064193</obo:OAE_0004334>
        <rdfs:label>persistent left superior vena cava AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005341 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001173"/>
        <obo:IAO_0000115>This is an AE which refers to enlargement of the left atrium (LA) of the heart, and is a form of cardiomegaly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Left_atrial_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>左心室增大</obo:OAE_0001849>
        <obo:OAE_0004334>10051860</obo:OAE_0004334>
        <rdfs:label>left atrial enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005342 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001121"/>
        <obo:IAO_0000115>This is an AE which is thickening of the heart muscle of the left ventricle of the heart, that is, left-sided ventricular hypertrophy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Left_ventricular_hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>左心室扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10050043</obo:OAE_0004334>
        <rdfs:label>left ventricular dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005343 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the most common and the most serious complication and is associated with increased morbidity, short- and long-term mortality, and healthcare resource utilization.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27671216/</obo:IAO_0000119>
        <obo:OAE_0001849>心输出量低综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10024899</obo:OAE_0004334>
        <rdfs:label>low cardiac output syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005344 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which commonly refers to the excess deposition of extracellular matrix in the cardiac muscle, but the term may also refer to an abnormal thickening of the heart valves due to inappropriate proliferation of cardiac fibroblasts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>心肌纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10028594</obo:OAE_0004334>
        <rdfs:label>myocardial fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005345 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is defined as a myocardial:skeletal signal intensity ratio &gt;1.9.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30143429/</obo:IAO_0000119>
        <obo:OAE_0001849>心肌水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10064966</obo:OAE_0004334>
        <rdfs:label>myocardial edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005346 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is the tissue damage caused when blood supply returns to tissue (re- + perfusion) after a period of ischemia or lack of oxygen (anoxia or hypoxia).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reperfusion_injury</obo:IAO_0000119>
        <obo:OAE_0001849>心肌再灌注损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10051624</obo:OAE_0004334>
        <rdfs:label>myocardial reperfusion injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005347 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001201"/>
        <obo:IAO_0000115>This is an AE which is an uncommon cause of infectious myocarditis and is usually seen in the context of overwhelming sepsis or as part of a specific bacterial syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17613408/</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性心肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065218</obo:OAE_0004334>
        <rdfs:label>myocarditis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005348 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001201"/>
        <obo:IAO_0000115>This is an AE which is the result of an immune response to a microbial infection of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29536322/</obo:IAO_0000119>
        <obo:OAE_0001849>心肌炎传染性</obo:OAE_0001849>
        <obo:OAE_0004334>10066857</obo:OAE_0004334>
        <rdfs:label>myocarditis infectious AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005349 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001201"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the heart muscle with septic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myocarditis</obo:IAO_0000119>
        <obo:OAE_0001849>脓毒性心肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10028615</obo:OAE_0004334>
        <rdfs:label>myocarditis septic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005350 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000632"/>
        <obo:IAO_0000115>This is an AE which is a sudden loss of blood flow resulting from the failure of the heart to pump effectively.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>心源性猝死</obo:OAE_0001849>
        <obo:OAE_0004334>10049418</obo:OAE_0004334>
        <rdfs:label>sudden cardiac death AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005351 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <obo:IAO_0000115>This is an AE which is a heart rate that exceeds the normal resting rate occurs on foetal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tachycardia</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿心动过速</obo:OAE_0001849>
        <obo:OAE_0004334>10043074</obo:OAE_0004334>
        <rdfs:label>tachycardia foetal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005352 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001441"/>
        <obo:IAO_0000115>This is an AE which is a heart rate that exceeds the normal resting rate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tachycardia</obo:IAO_0000119>
        <obo:OAE_0001849>心动过速</obo:OAE_0001849>
        <obo:OAE_0004334>10064805</obo:OAE_0004334>
        <rdfs:label>tachyphrenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005353 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001201"/>
        <obo:IAO_0000115>This is an AE which can range from nonspecific symptoms of fatigue and shortness of breath to more aggressive symptoms that mimic acute coronary syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32127272/</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性心肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10047470</obo:OAE_0004334>
        <rdfs:label>viral myocarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005354 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is the most severe form of hypertension, defined clinically by very high blood pressure (diastolic above 130 mm Hg) accompanied by bilateral retinal hemorrhages and/or exudates, with or without papilledema.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28200072/</obo:IAO_0000119>
        <obo:OAE_0001849>急进性高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10000358</obo:OAE_0004334>
        <rdfs:label>accelerated hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005355 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002127"/>
        <obo:IAO_0000115>This is an AE which is a ventricular rhythm with a rate of between 40 and 120 beats per minute.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Accelerated_idioventricular_rhythm</obo:IAO_0000119>
        <obo:OAE_0001849>加速的心室节律</obo:OAE_0001849>
        <obo:OAE_0004334>10049003</obo:OAE_0004334>
        <rdfs:label>accelerated idioventricular rhythm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005356 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>This is an AE which is defined as abnormal heart rates in the neonatal period and they may occur as a result of various cardiovascular, systemic and metabolic problems.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26037725/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿心律不齐</obo:OAE_0001849>
        <obo:OAE_0004334>10003124</obo:OAE_0004334>
        <rdfs:label>arrhythmia neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005357 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>This is an AE which is one of the main causes of medical consultation and they may also be the clinical presentation of various cardiovascular diseases and a marker of sudden death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28055994/</obo:IAO_0000119>
        <obo:OAE_0001849>室上性心律失常</obo:OAE_0001849>
        <obo:OAE_0004334>10003130</obo:OAE_0004334>
        <rdfs:label>arrhythmia supraventricular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005358 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001173"/>
        <obo:IAO_0000115>This is an AE which refers to a condition where the left atrium or right atrium of the heart is larger than would be expected. It can also affect both atria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrial_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>心房扩大</obo:OAE_0001849>
        <obo:OAE_0004334>10079340</obo:OAE_0004334>
        <rdfs:label>atrial enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005359 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital heart defect in which blood flows between the atria (upper chambers) of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrial_septal_defect</obo:IAO_0000119>
        <obo:OAE_0001849>心房中隔缺损</obo:OAE_0001849>
        <obo:OAE_0004334>10003664</obo:OAE_0004334>
        <rdfs:label>atrial septal defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005360 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001297"/>
        <obo:IAO_0000115>This is an AE which a relatively uncommon arrhythmia that is nonetheless increasingly seen in elderly people of developed countries, due to the increase in life expectancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22897386/</obo:IAO_0000119>
        <obo:OAE_0001849>完全房室传导阻滞</obo:OAE_0001849>
        <obo:OAE_0004334>10003673</obo:OAE_0004334>
        <rdfs:label>atrioventricular block complete AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005361 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which is characterized by a deficiency of the atrioventricular septum of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrioventricular_septal_defect</obo:IAO_0000119>
        <obo:OAE_0001849>房室中隔缺损</obo:OAE_0001849>
        <obo:OAE_0004334>10063836</obo:OAE_0004334>
        <rdfs:label>atrioventricular septal defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005362 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which comprise a group of abnormalities seen on the electrocardiogram (ECG) that often confuse clinicians and may conceal potentially lethal disease entities, such as acute myocardial infarction (MI). Cardiac impulses normally originate in the sinoatrial (SA) node and then are conducted through atrial tissue to the atrioventricular (AV) node and into the bundle of His.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16308112/</obo:IAO_0000119>
        <obo:OAE_0001849>心室传导缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10012118</obo:OAE_0004334>
        <rdfs:label>defect conduction intraventricular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005363 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>This is an AE which is thickening of the walls of a ventricle (lower chamber) of the heart and shows up on the ECG .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ventricular_hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>心室肥大迹象</obo:OAE_0001849>
        <obo:OAE_0004334>10050998</obo:OAE_0004334>
        <rdfs:label>ecg signs of ventricular hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005364 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a rare heart disorder usually occurring in children two years old and younger.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endocardial_fibroelastosis</obo:IAO_0000119>
        <obo:OAE_0001849>心内膜弹力纤维增生症</obo:OAE_0001849>
        <obo:OAE_0004334>10014663</obo:OAE_0004334>
        <rdfs:label>endocardial fibroelastosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005365 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which refers to the excess deposition of extracellular matrix in the cardiac muscle, but the term may also refer to an abnormal thickening of the heart valves due to inappropriate proliferation of cardiac fibroblasts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>心内膜心肌纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10014664</obo:OAE_0004334>
        <rdfs:label>endocardial fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005366 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000915"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the inner layer of the heart, the endocardium caused by viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endocarditis</obo:IAO_0000119>
        <obo:OAE_0001849>心内膜炎病毒</obo:OAE_0001849>
        <obo:OAE_0004334>10061837</obo:OAE_0004334>
        <rdfs:label>endocarditis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005367 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001201"/>
        <obo:IAO_0000115>This is an AE which is inflammation in the heart muscle that is caused by the infiltration and destructive activity of a type of white blood cell, the eosinophil.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_myocarditis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性心肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014961</obo:OAE_0004334>
        <rdfs:label>eosinophilic myocarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005368 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002578"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing of arteries other than those that supply the heart or brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peripheral_artery_disease</obo:IAO_0000119>
        <obo:OAE_0001849>动脉闭塞性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10062599</obo:OAE_0004334>
        <rdfs:label>arterial occlusive disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005369 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which refers to a condition in which an arterial spasm leads to vasoconstriction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasospasm</obo:IAO_0000119>
        <obo:OAE_0001849>动脉痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10003175</obo:OAE_0004334>
        <rdfs:label>arterial spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005370 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a arterial blood vessel or other tubular organ or structure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>动脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10060965</obo:OAE_0004334>
        <rdfs:label>arterial stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005371 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of an arterial wall due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>动脉壁肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10072809</obo:OAE_0004334>
        <rdfs:label>arterial wall hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005372 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002483"/>
        <obo:IAO_0000115>This is an AE which defined by a severe reversible diffuse or focal vasoconstriction is the most common diagnosis among INOCA (ischemia with no obstructive coronary artery disease) patients irrespective to racial, genetic, and geographic variations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32508542/</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10003225</obo:OAE_0004334>
        <rdfs:label>arterio spasm coronary AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005373 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is an abnormal connection between arteries and veins, bypassing the capillary system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arteriovenous_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>动静脉畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10003193</obo:OAE_0004334>
        <rdfs:label>arteriovenous malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005374 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002483"/>
        <obo:IAO_0000115>This is an AE which is responsible for stenosis, occlusion or aneurysms, and  occur in the coronary artery, causing myocardial infarction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28691733/</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10003232</obo:OAE_0004334>
        <rdfs:label>arteritis coronary AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005375 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is an abnormal enlargement of the pampiniform venous plexus in the scrotum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Varicocele</obo:IAO_0000119>
        <obo:OAE_0001849>精索静脉曲张</obo:OAE_0001849>
        <obo:OAE_0004334>10046986</obo:OAE_0004334>
        <rdfs:label>varicocele AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005376 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a common disease in the medical practice of dermatologists and phlebologists.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21057915/</obo:IAO_0000119>
        <obo:OAE_0001849>曲张静脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10056717</obo:OAE_0004334>
        <rdfs:label>varicophlebitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005377 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which superficial veins become enlarged and twisted.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Varicose_veins</obo:IAO_0000119>
        <obo:OAE_0001849>静脉曲张</obo:OAE_0001849>
        <obo:OAE_0004334>10046986</obo:OAE_0004334>
        <rdfs:label>varicose vein AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005378 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a common injury that results from repeated use of intravenous injections.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Collapsed_vein</obo:IAO_0000119>
        <obo:OAE_0001849>静脉塌陷</obo:OAE_0001849>
        <obo:OAE_0004334>10074621</obo:OAE_0004334>
        <rdfs:label>vein collapse AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005379 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a class of disease involving veins of the circulatory system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vein_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>静脉疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10047184</obo:OAE_0004334>
        <rdfs:label>vein disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005380 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002151"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling on vein often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>静脉痛</obo:OAE_0001849>
        <obo:OAE_0004334>10047187</obo:OAE_0004334>
        <rdfs:label>vein pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005381 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is all in the cylindric axis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2321136/</obo:IAO_0000119>
        <obo:OAE_0001849>静脉破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10077110</obo:OAE_0004334>
        <rdfs:label>vein rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005382 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001772"/>
        <obo:IAO_0000115>This is an AE which is the lodging of an embolus, a blockage-causing piece of material, inside a vena cava blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolism</obo:IAO_0000119>
        <obo:OAE_0001849>腔静脉栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10047193</obo:OAE_0004334>
        <rdfs:label>vena cava embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005383 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the vena cava  caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>下腔静脉损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10047194</obo:OAE_0004334>
        <rdfs:label>vena cava injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005385 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is the rare congenital disorders but the parotid gland VLMs are the rarest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32584007/</obo:IAO_0000119>
        <obo:OAE_0001849>静脉淋巴管畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10079880</obo:OAE_0004334>
        <rdfs:label>venolymphatic malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005386 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001772"/>
        <obo:IAO_0000115>This is an AE which is a potentially life-threatening condition in which some of the small veins in the liver are obstructed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatic_veno-occlusive_disease</obo:IAO_0000119>
        <obo:OAE_0001849>静脉闭塞性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10062173</obo:OAE_0004334>
        <rdfs:label>venoocclusive disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005387 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a benign phenomenon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Venous_hum</obo:IAO_0000119>
        <obo:OAE_0001849>静脉杂音</obo:OAE_0001849>
        <obo:OAE_0004334>10065565</obo:OAE_0004334>
        <rdfs:label>venous bruit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005388 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged venous  blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>静脉出血</obo:OAE_0001849>
        <obo:OAE_0004334>10065441</obo:OAE_0004334>
        <rdfs:label>venous hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005389 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which can refer to varicose veins ,chronic venous insufficiency and venous stasis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Venous_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>静脉功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10057320</obo:OAE_0004334>
        <rdfs:label>venous insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005390 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002528"/>
        <obo:IAO_0000115>This is an AE which is a generally solitary, soft, compressible, dark blue to violaceous, 0.2- to 1-cm papule commonly found on sun-exposed surfaces of the vermilion border of the lip, face and ears.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Venous_lake</obo:IAO_0000119>
        <obo:OAE_0001849>静脉湖</obo:OAE_0001849>
        <obo:OAE_0004334>10051510</obo:OAE_0004334>
        <rdfs:label>venous lake AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005391 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001772"/>
        <obo:IAO_0000115>This is an AE which is the formation of a blood clot inside a blood vessel, obstructing the flow of blood through the circulatory system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombosis</obo:IAO_0000119>
        <obo:OAE_0001849>静脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10058990</obo:OAE_0004334>
        <rdfs:label>venous occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005392 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a condition of slow blood flow in the veins, usually of the legs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Venous_stasis</obo:IAO_0000119>
        <obo:OAE_0001849>静脉淤滞</obo:OAE_0001849>
        <obo:OAE_0004334>10047245</obo:OAE_0004334>
        <rdfs:label>venous stasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005393 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is observed within 20 mm of the junction to the adjacent draining sinus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31323417/</obo:IAO_0000119>
        <obo:OAE_0001849>静脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10048671</obo:OAE_0004334>
        <rdfs:label>venous stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005395 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which may contribute to posterior circulation ischemic events, especially when other risk factors coexist.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23816871/</obo:IAO_0000119>
        <obo:OAE_0001849>椎动脉发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10066907</obo:OAE_0004334>
        <rdfs:label>vertebral artery hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005396 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which describes a temporary set of symptoms due to decreased blood flow (ischemia) in the posterior circulation of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vertebrobasilar_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>椎基底动脉供血不足</obo:OAE_0001849>
        <obo:OAE_0004334>10047334</obo:OAE_0004334>
        <rdfs:label>vertebrobasilar insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005397 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is syndrome caused by ischemia of the anterior spinal artery, resulting in loss of function of the anterior two-thirds of the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anterior_spinal_artery_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓前动脉综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10002703</obo:OAE_0004334>
        <rdfs:label>anterior spinal artery syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005398 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <obo:IAO_0000115>This is an AE which is associated with a high risk of disability and mortality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32568658/</obo:IAO_0000119>
        <obo:OAE_0001849>基底动脉阻塞</obo:OAE_0001849>
        <obo:OAE_0004334>10048963</obo:OAE_0004334>
        <rdfs:label>basilar artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005399 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is an outward bulging, likened to a bubble or balloon, caused by a localized, abnormal, weak spot on a carotid blood vessel wall but it is ruptured.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>颈动脉动脉瘤破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10051328</obo:OAE_0004334>
        <rdfs:label>carotid aneurysm rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>This is an AE which is an outward bulging, likened to a bubble or balloon, caused by a localized, abnormal, weak spot on a carotid artery blood vessel wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>颈动脉动脉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10007686</obo:OAE_0004334>
        <rdfs:label>carotid artery aneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005401 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001161"/>
        <obo:IAO_0000115>This is an AE which is often implicated in primary ischemic stroke secondary to thrombosis or embolism and may indicate concurrent cardiovascular disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7919691/</obo:IAO_0000119>
        <obo:OAE_0001849>颈动脉疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061744</obo:OAE_0004334>
        <rdfs:label>carotid artery disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005402 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <obo:IAO_0000115>This is an AE which refers blockage of a carotid artery  blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Occlusion</obo:IAO_0000119>
        <obo:OAE_0001849>颈动脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10048964</obo:OAE_0004334>
        <rdfs:label>carotid artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005403 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002369"/>
        <obo:IAO_0000115>This is an AE which is a long lasting and continuously evolving disease with multiple clinical manifestations ranging from asymptomatic to stable angina, acute coronary syndrome (ACS), heart failure (HF) and sudden cardiac death (SCD).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27091673/</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉动脉粥样硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10011076</obo:OAE_0004334>
        <rdfs:label>coronary artery atherosclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005404 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001161"/>
        <obo:IAO_0000115>This is an AE which is a surgical procedure to restore normal blood flow to an obstructed coronary artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coronary_artery_bypass_surgery</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉搭桥</obo:OAE_0001849>
        <obo:OAE_0004334>10011077</obo:OAE_0004334>
        <rdfs:label>coronary artery bypass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005405 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001173"/>
        <obo:IAO_0000115>This is an AE which is an abnormal dilatation of part of the coronary artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coronary_artery_aneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10065420</obo:OAE_0004334>
        <rdfs:label>coronary artery dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005406 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000844"/>
        <obo:IAO_0000115>This is an AE which occurs when blood flow decreases or stops to the coronary artery of the heart, causing damage to the heart muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myocardial_infarction</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10011086</obo:OAE_0004334>
        <rdfs:label>coronary artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005407 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002483"/>
        <obo:IAO_0000115>This is an AE which involves the reduction of blood flow to the heart muscle due to build-up of plaque (atherosclerosis) in the arteries of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coronary_artery_disease</obo:IAO_0000119>
        <obo:OAE_0001849>冠状动脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10011089</obo:OAE_0004334>
        <rdfs:label>coronary artery stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005408 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002406"/>
        <obo:IAO_0000115>This is an AE which occurs when an injury to the innermost layer of the  coronary aorta allows blood to flow between the layers of the aortic wall, forcing the layers apart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortic_dissection</obo:IAO_0000119>
        <obo:OAE_0001849>解剖冠状动脉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10013428</obo:OAE_0004334>
        <rdfs:label>dissecting coronary artery aneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005409 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <obo:IAO_0000115>This is an AE which is the lodging of an embolus, a blockage-causing piece of material, inside a femoral artery blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolism</obo:IAO_0000119>
        <obo:OAE_0001849>股动脉栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10068365</obo:OAE_0004334>
        <rdfs:label>femoral artery embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005410 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <obo:IAO_0000115>This is an AE which refers blockage of a femoral artery  blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Occlusion</obo:IAO_0000119>
        <obo:OAE_0001849>股动脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10052019</obo:OAE_0004334>
        <rdfs:label>femoral artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005411 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001749"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory autoimmune disease of large blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Giant_cell_arteritis</obo:IAO_0000119>
