    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a condition which presents with both papules and scales, or both scaly papules and plaques.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papulosquamous_disorder</obo:IAO_0000119>
