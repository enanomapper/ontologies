    <!-- http://purl.obolibrary.org/obo/OAE_0004614 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a disease featuring the proliferation of fibrous tissue in the retroperitoneum, the compartment of the body containing the kidneys, aorta, renal tract, and various other structures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
