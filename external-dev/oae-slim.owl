        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 leukoencephalopathy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12714</rdfs:seeAlso>
