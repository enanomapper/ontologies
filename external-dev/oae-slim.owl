    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>an injection-site AE that displays erythema at the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>Liwei Wang, Oliver He</obo:IAO_0000117>
        <rdfs:label xml:lang="en">injection site erythema AE</rdfs:label>
    </owl:Class>
    


