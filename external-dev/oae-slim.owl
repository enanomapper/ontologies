    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>Proarrhythmic effect AE is an arrhythmia AE that is a new or more frequent occurrence of pre-existing arrhythmias, paradoxically precipitated by antiarrhythmic therapy, which means it is a side effect associated with the administration of some existing antiarrhythmic drugs, as well as drugs for other indications. In other words, it is a tendency of antiarrhythmic drugs to facilitate emergence of new arrhythmias.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>arhythmia auxo-action AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Proarrhythmia</obo:IAO_0000119>
        <obo:OAE_0001849>致心律失常</obo:OAE_0001849>
        <obo:OAE_0004334>10036766</obo:OAE_0004334>
        <rdfs:label>proarrhythmic effect AE</rdfs:label>
    </owl:Class>
    


