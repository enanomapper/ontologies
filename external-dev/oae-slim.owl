        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000053"/>
        <obo:IAO_0000115>a wheezing AE that has severe respiratory symptoms limiting self care ADL; oxygen therapy or hospitalization indicated</obo:IAO_0000115>
