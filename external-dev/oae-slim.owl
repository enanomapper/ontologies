    <!-- http://purl.obolibrary.org/obo/OAE_0002570 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>a hematopoietic system AE which has a decreased erythrocyte sedimentation rate (ESR). EST is the rate at which red blood cells sediment in a period of one hour.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
