    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007980 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007980">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which can be classified according to the involved bone into: femoral fracture (in the upper leg)  and crus fracture (in the lower leg).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_leg#Fracture</obo:IAO_0000119>
        <obo:OAE_0001849>胫骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10043827</obo:OAE_0004334>
        <rdfs:label>tibia fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007981 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a break in the ulna bone, one of the two bones in the forearm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulna_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>尺骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10045357</obo:OAE_0004334>
