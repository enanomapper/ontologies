        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000885"/>
        <obo:IAO_0000115>This is an AE which is a slight bulge in the small intestine present at birth and a vestigial remnant of the omphalomesenteric duct (also called the vitelline duct or yolk stalk).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meckel%27s_diverticulum</obo:IAO_0000119>
