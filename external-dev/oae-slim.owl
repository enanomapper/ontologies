        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is the most common type of congenital vascular malformation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29784122/</obo:IAO_0000119>
        <obo:OAE_0001849>畸形静脉</obo:OAE_0001849>
        <obo:OAE_0004334>10025532</obo:OAE_0004334>
        <rdfs:label>malformation venous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005428 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000194"/>
        <obo:IAO_0000115>This is an AE which may be an ocular complication of Buerger&apos;s disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29398225/</obo:IAO_0000119>
        <obo:OAE_0001849>乳头状静脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065373</obo:OAE_0004334>
        <rdfs:label>papillophlebitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005429 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000194"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of a vein and is deep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phlebitis</obo:IAO_0000119>
        <obo:OAE_0001849>深静脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034897</obo:OAE_0004334>
        <rdfs:label>phlebitis deep AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005430 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is a small local, usually rounded, calcification within a vein.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phlebolith</obo:IAO_0000119>
        <obo:OAE_0001849>静脉结石</obo:OAE_0001849>
        <obo:OAE_0004334>10051474</obo:OAE_0004334>
        <rdfs:label>phlebolith AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005431 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of portal tract tissues to harmful stimuli, such as pathogens, damaged cells, or irritants, and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>门静脉呼吸道炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10075331</obo:OAE_0004334>
        <rdfs:label>portal tract inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005432 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001312"/>
        <obo:IAO_0000115>This is an AE which is a rare finding on radiological exams.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Portal_vein#Clinical_significance</obo:IAO_0000119>
        <obo:OAE_0001849>门静脉积气</obo:OAE_0001849>
        <obo:OAE_0004334>10064711</obo:OAE_0004334>
        <rdfs:label>portal venous gas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005433 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which results in venous hypertension with the formation of intra- and extrarenal collaterals and/or the development of gonadal vein reflux.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16374539/</obo:IAO_0000119>
        <obo:OAE_0001849>肾静脉压迫</obo:OAE_0001849>
        <obo:OAE_0004334>10074386</obo:OAE_0004334>
        <rdfs:label>renal vein compression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005434 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which is the lodging of an renal vein embolus, a blockage-causing piece of material, inside a blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolism</obo:IAO_0000119>
        <obo:OAE_0001849>肾静脉栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10038547</obo:OAE_0004334>
        <rdfs:label>renal vein embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005435 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001772"/>
        <obo:IAO_0000115>This is an AE which has been often reported to be associated with acute decompensated heart failure and, to our knowledge.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33038002/</obo:IAO_0000119>
        <obo:OAE_0001849>肾静脉充血</obo:OAE_0001849>
        <obo:OAE_0004334>10072109</obo:OAE_0004334>
        <rdfs:label>renal venous congestion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005436 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000194"/>
        <obo:IAO_0000115>This is an AE which is characterized clinically by a local syndrome in an arm, the chest or a leg, by an irregular temperature (toothsaw curve), by blood cultures that are simultaneously or successively positive for one or several pathogenic microorganisms, by repeated, multiple infected embolism and by the possibility of endocarditis as a complication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/866444/</obo:IAO_0000119>
        <obo:OAE_0001849>化脓性静脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10056518</obo:OAE_0004334>
        <rdfs:label>septic phlebitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005437 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000194"/>
        <obo:IAO_0000115>This is an AE which is a vein that is close to the surface of the body and is prominent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Superficial_vein</obo:IAO_0000119>
        <obo:OAE_0001849>浅静脉突出</obo:OAE_0001849>
        <obo:OAE_0004334>10068717</obo:OAE_0004334>
        <rdfs:label>superficial vein prominence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005438 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000800"/>
        <obo:IAO_0000115>This is an AE which is important features of advanced heart failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33018978/</obo:IAO_0000119>
        <obo:OAE_0001849>内脏充血</obo:OAE_0001849>
        <obo:OAE_0004334>10066397</obo:OAE_0004334>
        <rdfs:label>visceral congestion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005439 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the visceral  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>内脏水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10065768</obo:OAE_0004334>
        <rdfs:label>visceral edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005440 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is pain that results from the activation of nociceptors of the thoracic, pelvic, or abdominal viscera (organs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visceral_pain</obo:IAO_0000119>
        <obo:OAE_0001849>内脏痛</obo:OAE_0001849>
        <obo:OAE_0004334>10065385</obo:OAE_0004334>
        <rdfs:label>visceral pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005441 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is a prolapse or a sinking of the abdominal viscera (internal organs) below their natural position.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visceroptosis</obo:IAO_0000119>
        <obo:OAE_0001849>内脏下垂</obo:OAE_0001849>
        <obo:OAE_0004334>10063840</obo:OAE_0004334>
        <rdfs:label>visceroptosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005442 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001725"/>
        <obo:IAO_0000115>This is an AE which is a group of abnormal heart rhythms (arrhythmias) usually caused by a malfunction of the sinus node, the heart&apos;s primary pacemaker.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sinus_node_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>窦房结功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10075889</obo:OAE_0004334>
        <rdfs:label>sinus node dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005443 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal growth of sinus tissue projecting from a mucous membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyp_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>窦性息肉</obo:OAE_0001849>
        <obo:OAE_0004334>10040749</obo:OAE_0004334>
        <rdfs:label>sinus polyp AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005444 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001392"/>
        <obo:IAO_0000115>This is an AE which is any cardiac rhythm in which depolarisation of the cardiac muscle begins at the sinus node.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sinus_rhythm</obo:IAO_0000119>
        <obo:OAE_0001849>窦性心律</obo:OAE_0001849>
        <obo:OAE_0004334>10048815</obo:OAE_0004334>
        <rdfs:label>sinus rhythm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005445 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>This is an AE which is a commonly encountered variation of normal sinus rhythm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sinus_arrhythmia</obo:IAO_0000119>
        <obo:OAE_0001849>窦性心律不齐</obo:OAE_0001849>
        <obo:OAE_0004334>10040739</obo:OAE_0004334>
        <rdfs:label>sinus arrhythmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005446 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000617"/>
        <obo:IAO_0000115>This is an AE which is a form of iron overload disorder resulting in the accumulation of hemosiderin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemosiderosis</obo:IAO_0000119>
        <obo:OAE_0001849>含铁血黄素沉着病</obo:OAE_0001849>
        <obo:OAE_0004334>10019024</obo:OAE_0004334>
        <rdfs:label>haemosiderosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005447 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002711"/>
        <obo:IAO_0000115>This is an AE which indicates accumulation of iron in the body from any cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iron_overload</obo:IAO_0000119>
        <obo:OAE_0001849>血色病</obo:OAE_0001849>
        <obo:OAE_0004334>10018872</obo:OAE_0004334>
        <rdfs:label>haemochromatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005448 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which maternal IgG antibodies with specificity for the ABO blood group system pass through the placenta to the fetal circulation where they can cause hemolysis of fetal red blood cells which can lead to fetal anemia and HDN.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemolytic_disease_of_the_newborn_(ABO)</obo:IAO_0000119>
        <obo:OAE_0001849>ABO血型不相容</obo:OAE_0001849>
        <obo:OAE_0004334>10000206</obo:OAE_0004334>
        <rdfs:label>abo incompatibility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005449 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002122"/>
        <obo:IAO_0000115>This is an AE which is a condition of the mucous membranes characterized by the sudden appearance of one or more blood blisters within the oral cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angina_bullosa_haemorrhagica</obo:IAO_0000119>
        <obo:OAE_0001849>大疱性心绞痛出血</obo:OAE_0001849>
        <obo:OAE_0004334>10064223</obo:OAE_0004334>
        <rdfs:label>angina bullosa haemorrhagica AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005450 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000491"/>
        <obo:IAO_0000115>This is an AE which frequently results in death, prompt treatment may result in full recovery .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/3071324/</obo:IAO_0000119>
        <obo:OAE_0001849>低血糖昏迷</obo:OAE_0001849>
        <obo:OAE_0004334>10021000</obo:OAE_0004334>
        <rdfs:label>hypoglycaemic coma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005451 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which can damage the internal capsule and lead to high rates of disability and mortality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31449206/</obo:IAO_0000119>
        <obo:OAE_0001849>基底节出血</obo:OAE_0001849>
        <obo:OAE_0004334>10067057</obo:OAE_0004334>
        <rdfs:label>basal ganglia hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005452 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000583"/>
        <obo:IAO_0000115>This is an AE which is a type of prediabetes, in which a person&apos;s blood sugar levels during fasting are consistently above the normal range, but below the diagnostic cut-off for a formal diagnosis of diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Impaired_fasting_glucose</obo:IAO_0000119>
        <obo:OAE_0001849>空腹血糖受损</obo:OAE_0001849>
        <obo:OAE_0004334>10056997</obo:OAE_0004334>
        <rdfs:label>impaired fasting glucose AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005453 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>This is an AE which is the vomiting of blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematemesis</obo:IAO_0000119>
        <obo:OAE_0001849>吐血</obo:OAE_0001849>
        <obo:OAE_0004334>10018830</obo:OAE_0004334>
        <rdfs:label>haematemesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005454 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels and is traumatic .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>外伤性出血</obo:OAE_0001849>
        <obo:OAE_0004334>10053476</obo:OAE_0004334>
        <rdfs:label>traumatic hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005455 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is the leakage of a fluid out of its container into the surrounding area, especially blood or blood cells from vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Extravasation</obo:IAO_0000119>
        <obo:OAE_0001849>外渗血</obo:OAE_0001849>
        <obo:OAE_0004334>10015867</obo:OAE_0004334>
        <rdfs:label>extravasation blood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005456 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which refers a generic term for the presence of toxins in the blood caused by bacterial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Toxemia</obo:IAO_0000119>
        <obo:OAE_0001849>细菌血毒症</obo:OAE_0001849>
        <obo:OAE_0004334>10004053</obo:OAE_0004334>
        <rdfs:label>bacterial toxaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005457 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001057"/>
        <obo:IAO_0000115>This is an AE which is a fall in blood sugar to levels below normal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoglycemia</obo:IAO_0000119>
        <obo:OAE_0001849>休克性低血糖</obo:OAE_0001849>
        <obo:OAE_0004334>10040576</obo:OAE_0004334>
        <rdfs:label>shock hypoglycaemic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005458 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the perivascular skin, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>血管周的皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064986</obo:OAE_0004334>
        <rdfs:label>perivascular dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005459 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which related to renal replacement therapy (HIRRT) is a frequent complication of all renal replacement therapy (RRT) modalities commonly used in the intensive care unit.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31407042/</obo:IAO_0000119>
        <obo:OAE_0001849>血流动力不稳定</obo:OAE_0001849>
        <obo:OAE_0004334>10052076</obo:OAE_0004334>
        <rdfs:label>haemodynamic instability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005460 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a type of blister that forms when subdermal tissues and blood vessels are damaged without piercing the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blood_blister</obo:IAO_0000119>
        <obo:OAE_0001849>血疱</obo:OAE_0001849>
        <obo:OAE_0004334>10005372</obo:OAE_0004334>
        <rdfs:label>blood blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005461 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a common manifestation of plasma cell disease, and it is sometimes caused by autoimmune diseases (AIDs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31550956/</obo:IAO_0000119>
        <obo:OAE_0001849>血球蛋白过多</obo:OAE_0001849>
        <obo:OAE_0004334>10020633</obo:OAE_0004334>
        <rdfs:label>hyperglobulinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005462 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a disease caused by parasitic flatworms called schistosomes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schistosomiasis</obo:IAO_0000119>
        <obo:OAE_0001849>血吸虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10039603</obo:OAE_0004334>
        <rdfs:label>schistosomiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005465 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a rare congenital defect in which the major visceral organs are distributed abnormally within the chest and abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Situs_ambiguus</obo:IAO_0000119>
        <obo:OAE_0001849>内脏异位</obo:OAE_0001849>
        <obo:OAE_0004334>10067265</obo:OAE_0004334>
        <rdfs:label>heterotaxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005466 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a variant of asystole and is usually ventricular in origin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Agonal_heart_rhythm</obo:IAO_0000119>
        <obo:OAE_0001849>垂死心室律</obo:OAE_0001849>
        <obo:OAE_0004334>10054015</obo:OAE_0004334>
        <rdfs:label>agonal rhythm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005467 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which resulting from dysfunction of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shock</obo:IAO_0000119>
        <obo:OAE_0001849>休克症状</obo:OAE_0001849>
        <obo:OAE_0004334>10040560</obo:OAE_0004334>
        <rdfs:label>shock symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005468 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>This is an AE which is the lodging of an embolus, a blockage-causing piece of material, inside a blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolism</obo:IAO_0000119>
        <obo:OAE_0001849>小栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10073734</obo:OAE_0004334>
        <rdfs:label>microembolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005469 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which abnormal distribution of blood flow in the smallest blood vessels results in inadequate supply of blood to the body&apos;s tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Distributive_shock</obo:IAO_0000119>
        <obo:OAE_0001849>分布性休克</obo:OAE_0001849>
        <obo:OAE_0004334>10070559</obo:OAE_0004334>
        <rdfs:label>distributive shock AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005470 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002342"/>
        <obo:IAO_0000115>This is an AE which is a type of tissue death caused by a lack of blood supply.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gangrene</obo:IAO_0000119>
        <obo:OAE_0001849>坏疽</obo:OAE_0001849>
        <obo:OAE_0004334>10017711</obo:OAE_0004334>
        <rdfs:label>gangrene AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005471 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the spasm of small arteries causes episodes of reduced blood flow to end arterioles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Raynaud_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>雷诺现象</obo:OAE_0001849>
        <obo:OAE_0004334>10037912</obo:OAE_0004334>
        <rdfs:label>raynaud&apos;s phenomenon AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005472 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002467"/>
        <obo:IAO_0000115>This is an AE which is the most common type of ischemic stroke, resulting from the occlusion of small penetrating arteries that provide blood to the brain&apos;s deep structures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lacunar_stroke</obo:IAO_0000119>
        <obo:OAE_0001849>腔隙性梗死</obo:OAE_0001849>
        <obo:OAE_0004334>10051078</obo:OAE_0004334>
        <rdfs:label>lacunar infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005473 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital heart defect where the left atrium (cor triatriatum sinistrum) or right atrium (cor triatriatum dextrum) is subdivided by a thin membrane, resulting in three atrial chambers (hence the name).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cor_triatriatum</obo:IAO_0000119>
        <obo:OAE_0001849>三房心</obo:OAE_0001849>
        <obo:OAE_0004334>10010972</obo:OAE_0004334>
        <rdfs:label>cor triatriatum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005474 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a defect of the bundle branches or fascicles in the electrical conduction system of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bundle_branch_block</obo:IAO_0000119>
        <obo:OAE_0001849>束支传导阻滞</obo:OAE_0001849>
        <obo:OAE_0004334>10006578</obo:OAE_0004334>
        <rdfs:label>bundle branch block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005476 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which refers to cardiac arrest in which the electrocardiogram shows a heart rhythm that should produce a pulse, but does not. Pulseless electrical activity is found initially in about 55% of people in cardiac arrest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulseless_electrical_activity</obo:IAO_0000119>
        <obo:OAE_0001849>无脉电活动</obo:OAE_0001849>
        <obo:OAE_0004334>10058151</obo:OAE_0004334>
        <rdfs:label>pulseless electrical activity AE</rdfs:label>
    </owl:Class>
    


