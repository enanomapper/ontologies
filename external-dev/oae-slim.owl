        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which refers the mastoiditis that is the result of an infection that extends to the air cells of the skull behind the ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mastoiditis</obo:IAO_0000119>
        <obo:OAE_0001849>乳突障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061277</obo:OAE_0004334>
        <rdfs:label>mastoid disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005968 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which increases the risks for bacterial otitis and mastoiditis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33115615/</obo:IAO_0000119>
        <obo:OAE_0001849>乳突积液</obo:OAE_0001849>
        <obo:OAE_0004334>10069008</obo:OAE_0004334>
        <rdfs:label>mastoid effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005969 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
