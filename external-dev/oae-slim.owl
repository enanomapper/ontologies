        <obo:OAE_0001849>生殖器细菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061179</obo:OAE_0004334>
        <rdfs:label>genital infection bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008470 -->


