    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a mostly inherited genetic disorder that impairs the body&apos;s ability to make blood clots, a process needed to stop bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
