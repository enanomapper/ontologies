    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008554 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a common cause of a benign breast lump in premenopausal women.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11270760/</obo:IAO_0000119>
        <obo:OAE_0001849>纤维腺瘤的乳房</obo:OAE_0001849>
        <obo:OAE_0004334>10016613</obo:OAE_0004334>
        <rdfs:label>fibroadenoma of breast AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008555 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a condition of the breasts where there may be pain, breast cysts, and breast masses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrocystic_breast_changes</obo:IAO_0000119>
        <obo:OAE_0001849>乳腺纤维囊性乳腺病</obo:OAE_0001849>
