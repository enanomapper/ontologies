        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is an umbrella term for a variety of disorders that affect the way the brain processes auditory information.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Auditory_processing_disorder</obo:IAO_0000119>
