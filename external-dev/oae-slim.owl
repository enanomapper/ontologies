        <obo:IAO_0000119>http://en.volupedia.org/wiki/Libido</obo:IAO_0000119>
        <obo:OAE_0001849>性欲障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061221</obo:OAE_0004334>
