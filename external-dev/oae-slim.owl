        <obo:OAE_0004334>10053198</obo:OAE_0004334>
        <rdfs:label>inappropriate antidiuretic hormone secretion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009341 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is diabetes specifically caused by cystic fibrosis, a genetic condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cystic_fibrosis%E2%80%93related_diabetes</obo:IAO_0000119>
