    <!-- http://purl.obolibrary.org/obo/OAE_0006676 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is a kidney-shaped organ of the lymphatic system, and the adaptive immune system and it is palpable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymph_node</obo:IAO_0000119>
