        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling on incision site  often caused by intense or damaging stimuli.</obo:IAO_0000115>
