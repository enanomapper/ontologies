        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <obo:IAO_0000115>Tongue angioedema AE is a angioedema AE that shows tongue angioedema, which is the rapid swelling (edema) of the dermis, subcutaneous tissue, mucosa and submucosal tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>舌血管神经性水肿</obo:OAE_0001849>
