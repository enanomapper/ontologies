        <rdfs:seeAlso>NCIt: C3117</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020538</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000404 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>a cardiac valve disease AE that is characterized by a condition of the heart in which the aortic valve, located between the aorta and left ventricle of the heart, is norrower than normal size</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aortic+valve+stenosis</obo:IAO_0000119>
