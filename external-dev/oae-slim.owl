        <rdfs:label>deformity of orbit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006302 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE whcih is a condition of the nasal septum in which there is a collection of pus between the mucoperichondrium and septal cartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nasal_septal_abscess</obo:IAO_0000119>
        <obo:OAE_0001849>鼻脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10028720</obo:OAE_0004334>
        <rdfs:label>nasal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006303 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a neurological disorder of excessive time spent sleeping or excessive sleepiness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypersomnia</obo:IAO_0000119>
        <obo:OAE_0001849>睡眠过度-食欲过盛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10053712</obo:OAE_0004334>
        <rdfs:label>hypersomnia-bulimia syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006304 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a large, air-filled space above and behind the nose in the middle of the face and there is a mass.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nasal_cavity</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10062771</obo:OAE_0004334>
        <rdfs:label>nasal cavity mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006305 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004361"/>
        <obo:IAO_0000115>This is an AE which is a rare sinonasal tumor that mainly occurs in adults during the 5th decade.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27053431/</obo:IAO_0000119>
        <obo:OAE_0001849>鼻窦乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10071665</obo:OAE_0004334>
        <rdfs:label>sinonasal papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006306 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000567"/>
        <obo:IAO_0000115>This is an AE which is a subtype of eosinophilic chronic rhinosinusitis (CRS) characterized by type I hypersensitivity, nasal polyposis, characteristic computed tomography scan findings, eosinophilic mucus, and the presence of fungus on surgical specimens without evidence of tissue invasion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22588040/</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性鼻窦炎</obo:OAE_0001849>
        <obo:OAE_0004334>10049153</obo:OAE_0004334>
        <rdfs:label>allergic sinusitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006307 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is caused by one or more volatilized chemical compounds that are generally found in low concentrations that humans and animals can perceive by their sense of smell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Odor</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔气味</obo:OAE_0001849>
        <obo:OAE_0004334>10051181</obo:OAE_0004334>
        <rdfs:label>nasal odour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006308 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is contents found in the human nose. It is a result of drying of the normally viscous colloidal mucus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dried_nasal_mucus</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10028740</obo:OAE_0004334>
        <rdfs:label>nasal dryness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006309 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001392"/>
        <obo:IAO_0000115>This is an AE which is the movement of material from one point to another, such as a secreted chemical substance from a paranasal sinus cell .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Secretion</obo:IAO_0000119>
        <obo:OAE_0001849>副鼻窦分泌过多</obo:OAE_0001849>
        <obo:OAE_0004334>10057392</obo:OAE_0004334>
        <rdfs:label>paranasal sinus hypersecretion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006310 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which might be beneficial in the management of sprue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/13133068/</obo:IAO_0000119>
        <obo:OAE_0001849>无麦饮食</obo:OAE_0001849>
        <obo:OAE_0004334>10047919</obo:OAE_0004334>
        <rdfs:label>wheat-free diet AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006311 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is disabling, deadly, and costly mental disorders that considerably impair physical health and disrupt psychosocial functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32171414/</obo:IAO_0000119>
        <obo:OAE_0001849>食欲障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10060961</obo:OAE_0004334>
        <rdfs:label>appetite disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006312 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is a mental disorder defined by abnormal eating behaviors that negatively affect a person&apos;s physical or mental health.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eating_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>饮食失调症状</obo:OAE_0001849>
        <obo:OAE_0004334>10061832</obo:OAE_0004334>
        <rdfs:label>eating disorder symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006313 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is a child&apos;s refusal to eat certain food groups, textures, solids or liquids for a period of at least one month, which causes the child to not gain enough weight, grow naturally or cause any developmental delays.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Feeding_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>进食障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061148</obo:OAE_0004334>
        <rdfs:label>feeding disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006314 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which in infancy or early childhood, is a child&apos;s refusal to eat certain food groups, textures, solids or liquids for a period of at least one month, which causes the child to not gain enough weight, grow naturally or cause any developmental delays.[1] Feeding disorders resemble failure to thrive, except that at times in feeding disorder there is no medical or physiological condition that can explain the very small amount of food the children consume or their lack of growth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Feeding_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>进食障碍新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10016316</obo:OAE_0004334>
        <rdfs:label>feeding disorder neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006315 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is an abnormal immune response to food.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Food_allergy</obo:IAO_0000119>
        <obo:OAE_0001849>食物过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10016946</obo:OAE_0004334>
        <rdfs:label>food allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006316 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000396"/>
        <obo:IAO_0000115>This is an AE which is acquired as a result of unpleasant experiences with foods represent a potent defense mechanism against poisoning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10336144/</obo:IAO_0000119>
        <obo:OAE_0001849>食物的厌恶</obo:OAE_0001849>
        <obo:OAE_0004334>10049238</obo:OAE_0004334>
        <rdfs:label>food aversion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006317 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is an intense desire to consume a specific food, and is different from normal hunger.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Food_craving</obo:IAO_0000119>
        <obo:OAE_0001849>饮食冲动</obo:OAE_0001849>
        <obo:OAE_0004334>10056465</obo:OAE_0004334>
        <rdfs:label>food craving AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006318 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is a behavior where people or animals accumulate food.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hoarding</obo:IAO_0000119>
        <obo:OAE_0001849>食物中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10016947</obo:OAE_0004334>
        <rdfs:label>food hoarding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006319 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is defined as alterations of pharmacokinetics or pharmacodynamics of a drug or nutritional element or a compromise in nutritional status as a result of the addition of a drug.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18382075/</obo:IAO_0000119>
        <obo:OAE_0001849>食物囤积</obo:OAE_0001849>
        <obo:OAE_0004334>10016948</obo:OAE_0004334>
        <rdfs:label>food interaction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006320 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a detrimental reaction, often delayed, to a food, beverage, food additive, or compound found in foods that produces symptoms in one or more body organs and systems, but generally refers to reactions other than food allergy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Food_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>食物不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10061958</obo:OAE_0004334>
        <rdfs:label>food intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006321 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is any illness resulting from the spoilage of contaminated food, pathogenic bacteria, viruses, or parasites that contaminate food, as well as prions (the agents of mad cow disease), and toxins such as aflatoxins in peanuts, poisonous mushrooms, and various species of beans that have not been boiled for at least 10 minutes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Foodborne_illness</obo:IAO_0000119>
        <obo:OAE_0001849>食物中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10016952</obo:OAE_0004334>
        <rdfs:label>food poisoning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006322 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002077"/>
        <obo:IAO_0000115>This is an AE which is primarily associated with physical and ethical aspects and with end-of-life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32271841/</obo:IAO_0000119>
        <obo:OAE_0001849>拒食</obo:OAE_0001849>
        <obo:OAE_0004334>10080283</obo:OAE_0004334>
        <rdfs:label>food refusal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006323 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is a high-fat, adequate-protein, low-carbohydrate diet that in medicine is used mainly to treat hard-to-control (refractory) epilepsy in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ketogenic_diet</obo:IAO_0000119>
        <obo:OAE_0001849>生酮膳食</obo:OAE_0001849>
        <obo:OAE_0004334>10073855</obo:OAE_0004334>
        <rdfs:label>ketogenic diet AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006324 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which refers an abnormal appetite for earth and other non-foods.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pica</obo:IAO_0000119>
        <obo:OAE_0001849>异食癖</obo:OAE_0001849>
        <obo:OAE_0004334>10035001</obo:OAE_0004334>
        <rdfs:label>pica AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006325 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is a type of eating disorder in which people eat only within an extremely narrow repertoire of foods.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Avoidant/restrictive_food_intake_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>选择性进食障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10078069</obo:OAE_0004334>
        <rdfs:label>selective eating disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006326 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the oral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>口腔脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10000311</obo:OAE_0004334>
        <rdfs:label>abscess oral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006327 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of various medical conditions which manifests as a reduced sense of oral touch or sensation, or a partial loss of sensitivity to sensory stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>口腔触觉减退</obo:OAE_0001849>
        <obo:OAE_0004334>10057371</obo:OAE_0004334>
        <rdfs:label>hypoesthesia oral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006328 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which refers an unfavorable evolution of a disease, health condition or medical treatment  such as oral administration drug.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complication</obo:IAO_0000119>
        <obo:OAE_0001849>口腔并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10062611</obo:OAE_0004334>
        <rdfs:label>oral administration complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006329 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a type of food allergy classified by a cluster of allergic reactions in the mouth and throat in response to eating certain (usually fresh) fruits, nuts, and vegetables that typically develops in adults with hay fever.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oral_allergy_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>口腔过敏综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10068355</obo:OAE_0004334>
        <rdfs:label>oral allergy syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006330 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a type of blister that forms when oral subdermal tissues and blood vessels are damaged without piercing the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blood_blister</obo:IAO_0000119>
        <obo:OAE_0001849>口腔血疱</obo:OAE_0001849>
        <obo:OAE_0004334>10076590</obo:OAE_0004334>
        <rdfs:label>oral blood blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006331 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000019"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of tissue, the most common cause being capillaries damaged by trauma, causing oral localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>口腔挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10078170</obo:OAE_0004334>
        <rdfs:label>oral contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006332 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004245"/>
        <obo:IAO_0000115>This is an AE which is any medical condition that affects the oral integumentary system .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition</obo:IAO_0000119>
        <obo:OAE_0001849>口腔脓疱</obo:OAE_0001849>
        <obo:OAE_0004334>10056674</obo:OAE_0004334>
        <rdfs:label>oral pustule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006333 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which occurs when an organism&apos;s body oral  is invaded by pathogenic viruses,not verified in body] and infectious virus particles (virions) attach to and enter susceptible cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Viral_disease</obo:IAO_0000119>
        <obo:OAE_0001849>口腔病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065234</obo:OAE_0004334>
        <rdfs:label>oral viral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006334 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a condition of abnormally high storage levels of vitamins, which can lead to various symptoms as over excitement, irritability, or even toxicity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypervitaminosis</obo:IAO_0000119>
        <obo:OAE_0001849>维生素过多症</obo:OAE_0001849>
        <obo:OAE_0004334>10020915</obo:OAE_0004334>
        <rdfs:label>hypervitaminosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006335 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which causing extensive neurological, ophthalmological, and hematological deficits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10586628/</obo:IAO_0000119>
        <obo:OAE_0001849>多种维生素缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10028155</obo:OAE_0004334>
        <rdfs:label>multi-vitamin deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006336 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a distortion of the sense of taste. Dysgeusia is also often associated with ageusia, which is the complete lack of taste, and hypogeusia, which is a decrease in taste sensitivity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysgeusia</obo:IAO_0000119>
        <obo:OAE_0001849>味觉障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10082490</obo:OAE_0004334>
        <rdfs:label>taste disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006337 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000350"/>
        <obo:IAO_0000115>This is an AE which is a common, morbid, and costly malady, often complicated by otitis media, sinusitis, and asthma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11892040/</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性鼻炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064948</obo:OAE_0004334>
        <rdfs:label>viral rhinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006338 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000567"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the mucous membranes caused by viral  that line the sinuses resulting in symptoms that may include thick nasal mucus, a plugged nose, and facial pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sinusitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性鼻窦炎</obo:OAE_0001849>
        <obo:OAE_0004334>10051513</obo:OAE_0004334>
        <rdfs:label>viral sinusitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006339 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000567"/>
        <obo:IAO_0000115>This is an AE which is usually precipitated by an earlier upper respiratory tract infection, generally of viral origin, mostly caused by rhinoviruses (with RVA and RVC giving more severe infection than RVB), coronaviruses, and influenza viruses, others caused by adenoviruses, human parainfluenza viruses, human respiratory syncytial virus, enteroviruses other than rhinoviruses, and metapneumovirus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sinusitis#Acute</obo:IAO_0000119>
        <obo:OAE_0001849>急性鼻窦炎</obo:OAE_0001849>
        <obo:OAE_0004334>10001076</obo:OAE_0004334>
        <rdfs:label>acute sinusitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006340 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a medical practice or technique of burning a part of a body  such as nose to remove or close off a part of it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cauterization</obo:IAO_0000119>
        <obo:OAE_0001849>鼻子烧伤</obo:OAE_0001849>
        <obo:OAE_0004334>10007829</obo:OAE_0004334>
        <rdfs:label>cautery to nose AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006341 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000508"/>
        <obo:IAO_0000115>This is an AE which is bleeding from the nose.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nosebleed</obo:IAO_0000119>
        <obo:OAE_0001849>鼻出血</obo:OAE_0001849>
        <obo:OAE_0004334>10015090</obo:OAE_0004334>
        <rdfs:label>epistaxis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006342 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of various medical conditions which manifests as a reduced sense of intranasal touch or sensation, or a partial loss of sensitivity to sensory stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>鼻内触觉减退</obo:OAE_0001849>
        <obo:OAE_0004334>10067068</obo:OAE_0004334>
        <rdfs:label>intranasal hypoesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006343 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is frequently used after septoplasty and some complications caused by nasal packing are unavoidable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31076882/</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔填充</obo:OAE_0001849>
        <obo:OAE_0004334>10028733</obo:OAE_0004334>
        <rdfs:label>nasal cavity packing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006344 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which often manifests as nasal discharge with or without other nasal signs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24268334/</obo:IAO_0000119>
        <obo:OAE_0001849>鼻部疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10062209</obo:OAE_0004334>
        <rdfs:label>nasal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006345 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is determined by the nasal bones and the nasal cartilages, including the nasal septum which separates the nostrils and divides the nasal cavity into two.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_nose#Related_medical_conditions</obo:IAO_0000119>
        <obo:OAE_0001849>鼻翼张开</obo:OAE_0001849>
        <obo:OAE_0004334>10052319</obo:OAE_0004334>
        <rdfs:label>nasal flaring AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006346 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which is a viral nasal infection caused by the herpes virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Herpes_simplex</obo:IAO_0000119>
        <obo:OAE_0001849>鼻翼疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10074936</obo:OAE_0004334>
        <rdfs:label>nasal herpes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006347 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which causes a loss of olfactory sensory neurons (OSNs) and atrophy of the olfactory bulb (OB), which recovers when inflammation subsides.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32220858/</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10028741</obo:OAE_0004334>
        <rdfs:label>nasal inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006348 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which caused by various traumas including blunt, and penetrating trauma and trauma caused by blast injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rhinoplasty#Nasal_reconstruction</obo:IAO_0000119>
        <obo:OAE_0001849>鼻部损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10078651</obo:OAE_0004334>
        <rdfs:label>nasal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006349 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a personal hygiene practice in which the nasal cavity is washed to flush out mucus and debris from the nose and sinuses, in order to enhance nasal breathing or can also refer to the use of saline nasal spray or nebulizers to moisten the mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nasal_irrigation</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔冲洗</obo:OAE_0001849>
        <obo:OAE_0004334>10069202</obo:OAE_0004334>
        <rdfs:label>nasal irrigation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006350 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which can be measured objectively with RGB analysis to aid the diagnosis of allergic rhinitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32238199/</obo:IAO_0000119>
        <obo:OAE_0001849>鼻黏膜变色</obo:OAE_0001849>
        <obo:OAE_0004334>10057537</obo:OAE_0004334>
        <rdfs:label>nasal mucosal discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006351 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of nasal mucosal  due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>鼻黏膜肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10057358</obo:OAE_0004334>
        <rdfs:label>nasal mucosal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006352 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000211"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in a bodily membrane such as nasal mucosal  that impedes normal function of the affected organ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>鼻粘膜溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10065546</obo:OAE_0004334>
        <rdfs:label>nasal mucosal ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006353 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000335"/>
        <obo:IAO_0000115>This is an AE which is the blockage of nasal breathing usually due to membranes lining the nose becoming swollen from inflamed blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nasal_congestion</obo:IAO_0000119>
        <obo:OAE_0001849>鼻塞</obo:OAE_0001849>
        <obo:OAE_0004334>10028748</obo:OAE_0004334>
        <rdfs:label>nasal obstruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006354 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the body&apos;s tissue such as nasal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>鼻腔水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10028750</obo:OAE_0004334>
