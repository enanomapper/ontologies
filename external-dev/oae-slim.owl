    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006677 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000932"/>
        <obo:IAO_0000115>This is an AE whcih is an uncommon disease with a relatively high rate of associated morbidity and mortality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20060254/</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜外脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10061846</obo:OAE_0004334>
        <rdfs:label>extradural abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006678 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a clinical diagnosis made in patients with adverse reactions to two or more structurally unrelated drugs with an underlying immune-mediated mechanism causing the reaction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24801461/</obo:IAO_0000119>
        <obo:OAE_0001849>多重过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10028164</obo:OAE_0004334>
        <rdfs:label>multiple allergies AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006679 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of lymphomas that derive from the malignant transformation of marginal zone B-cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Marginal_zone_B-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>结外边缘区b细胞麦芽型淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061850</obo:OAE_0004334>
        <rdfs:label>extranodal marginal zone b-cell malt type lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006680 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare condition, but is associated with high mortality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18186551/</obo:IAO_0000119>
        <obo:OAE_0001849>脾切除术后综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10075117</obo:OAE_0004334>
        <rdfs:label>postsplenectomy syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006681 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of  lymph node tissue and is benign.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>良性淋巴结肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10060997</obo:OAE_0004334>
        <rdfs:label>benign lymph node neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006682 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is an extremely rare infection of the central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33246901/</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10076050</obo:OAE_0004334>
        <rdfs:label>spinal cord abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006683 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an infection usually caused by the Epstein–Barr virus (EBV).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infectious_mononucleosis</obo:IAO_0000119>
        <obo:OAE_0001849>单核细胞增多综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10027924</obo:OAE_0004334>
        <rdfs:label>mononucleosis syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006684 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is classified as a lymphoproliferative disorder characterised by the relentless accumulation of mature B-lymphocytes showing a peculiar immunophenotype in the peripheral blood, bone marrow, lymph nodes and spleen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27370174/</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴细胞性淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10052178</obo:OAE_0004334>
        <rdfs:label>lymphocytic lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006685 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006685">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is now a rare condition, the causes of which in child are more or less different from adult.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28395496/</obo:IAO_0000119>
        <obo:OAE_0001849>扁桃体出血</obo:OAE_0001849>
        <obo:OAE_0004334>10057450</obo:OAE_0004334>
        <rdfs:label>tonsillar hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006686 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004447"/>
        <obo:IAO_0000115>This is an AE which is often associated with an acute decline in renal function and may be associated with permanent renal insufficiency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29493948/</obo:IAO_0000119>
        <obo:OAE_0001849>肾炎过敏性</obo:OAE_0001849>
        <obo:OAE_0004334>10029120</obo:OAE_0004334>
        <rdfs:label>nephritis allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006687 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which is the process of using one&apos;s hands to check the spleen, especially while perceiving/diagnosing a disease or illness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palpation</obo:IAO_0000119>
        <obo:OAE_0001849>脾可触及</obo:OAE_0001849>
        <obo:OAE_0004334>10057471</obo:OAE_0004334>
        <rdfs:label>spleen palpable AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006688 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which represent a group of diseases, that develop in susceptible individuals after repeated exposure to usually organic inhalation antigen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29303282/</obo:IAO_0000119>
        <obo:OAE_0001849>牙槽炎过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10001890</obo:OAE_0004334>
        <rdfs:label>alveolitis allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006689 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a spectrum of progressively more severe monoclonal gammopathies in which a clone or multiple clones of pre-malignant or malignant plasma cells (sometimes in association with lymphoplasmacytoid cells or B lymphocytes) over-produce and secrete into the blood stream a myeloma protein, i.e. an abnormal monoclonal antibody or portion thereof.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plasma_cell_dyscrasias</obo:IAO_0000119>
        <obo:OAE_0001849>浆细胞疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10062081</obo:OAE_0004334>
        <rdfs:label>plasma cell disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006690 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006690">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000765"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory disease of the breast parenchyma, rare in males.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27815454/</obo:IAO_0000119>
        <obo:OAE_0001849>浆细胞乳腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066170</obo:OAE_0004334>
        <rdfs:label>plasma cell mastitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006691 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a disorder that negatively alters the body&apos;s processing and distribution of macronutrients such as proteins(such as plasma protein), fats, and carbohydrates .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metabolic_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>血浆蛋白代谢紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10061350</obo:OAE_0004334>
        <rdfs:label>plasma protein metabolism disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006692 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006692">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a plasma cell dyscrasia in which a plasma cell tumour grows within soft tissue or within the axial skeleton.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plasmacytoma</obo:IAO_0000119>
        <obo:OAE_0001849>浆细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10035484</obo:OAE_0004334>
        <rdfs:label>plasmacytoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006693 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a condition in which there is an unusually large proportion of plasma cells in tissues, exudates, or blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plasmacytosis</obo:IAO_0000119>
        <obo:OAE_0001849>浆细胞增多</obo:OAE_0001849>
        <obo:OAE_0004334>10035485</obo:OAE_0004334>
        <rdfs:label>plasmacytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006694 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the lymph node .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10050167</obo:OAE_0004334>
        <rdfs:label>lymph node abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006695 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which refers to result from prior granulomatous infections, especially tuberculosis and histoplasmosis. Other, less common, causes are sarcoidosis, silicosis, amyloidosis, and calcifications secondary to the treatment of lymphomas (radiation therapy or chemotherapy).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6044648/</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10056284</obo:OAE_0004334>
        <rdfs:label>lymph node calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006696 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006696">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing in which connective tissue replaces normal lymph node parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10025180</obo:OAE_0004334>
        <rdfs:label>lymph node fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006697 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a kidney-shaped organ of the lymphatic system, and the adaptive immune system and some of it is rupture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymph_node</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10082725</obo:OAE_0004334>
        <rdfs:label>lymph node rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006698 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006698">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease on the lymph node usually caused by Mycobacterium tuberculosis (MTB) bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tuberculosis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结结核病</obo:OAE_0001849>
        <obo:OAE_0004334>10025183</obo:OAE_0004334>
        <rdfs:label>lymph node tuberculosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006699 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a disease caused by bacterial of the lymph nodes, in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphadenopathy</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性淋巴腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065224</obo:OAE_0004334>
        <rdfs:label>lymphadenitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006700 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006700">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a disease caused by viral of the lymph nodes, in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphadenopathy</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性淋巴腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065209</obo:OAE_0004334>
        <rdfs:label>lymphadenitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006701 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is an enlargement of the mediastinal lymph nodes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mediastinal_lymphadenopathy</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结病纵隔</obo:OAE_0001849>
        <obo:OAE_0004334>10025205</obo:OAE_0004334>
        <rdfs:label>lymphadenopathy mediastinal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006702 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006702">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is malformations of the lymphatic system characterized by lesions that are thin-walled cysts; these cysts can be macroscopic, as in a cystic hygroma, or microscopic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphangioma</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴管瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10025219</obo:OAE_0004334>
        <rdfs:label>lymphangioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006703 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which can occur in any age group, in symptomatic or asymptomatic patients, and in a single site or at multiple sites.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10907389/</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴管病</obo:OAE_0001849>
        <obo:OAE_0004334>10061231</obo:OAE_0004334>
        <rdfs:label>lymphangiopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006704 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a class of disorders which directly affect the components of the lymphatic system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphatic_disease</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10052314</obo:OAE_0004334>
        <rdfs:label>lymphatic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006705 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of lymphatic system tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴系统肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10062044</obo:OAE_0004334>
        <rdfs:label>lymphatic system neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006706 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is defined as inflammation of the pituitary gland due to autoimmunity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_hypophysitis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴细胞下垂体炎</obo:OAE_0001849>
        <obo:OAE_0004334>10063685</obo:OAE_0004334>
        <rdfs:label>lymphocytic hypophysitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006707 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is an excessive number of lymphohistiocytes(tissue macrophages), and the term is also often used to refer to a group of rare diseases which share this sign as a characteristic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Histiocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴组织细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10049646</obo:OAE_0004334>
        <rdfs:label>lymphohistiocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006708 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000207"/>
        <obo:IAO_0000115>This is an AE which is the rapid proliferation of normal appendix lymphocytic cells that resemble lymph tissue which may occur with bacterial or viral infections.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphoid_hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>阑尾淋巴样增生</obo:OAE_0001849>
        <obo:OAE_0004334>10025298</obo:OAE_0004334>
        <rdfs:label>lymphoid hyperplasia of appendix AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006709 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000207"/>
        <obo:IAO_0000115>This is an AE which is the rapid proliferation of normal lymphocytic cells that resemble lymph tissue which may occur with bacterial or viral infections.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphoid_hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴组织增生</obo:OAE_0001849>
        <obo:OAE_0004334>10051808</obo:OAE_0004334>
        <rdfs:label>lymphoid tissue hyperplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006710 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002528"/>
        <obo:IAO_0000115>This is an AE which is a rare skin disorder and can appear very similar to anaplastic large cell lymphoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphomatoid_papulosis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴瘤样丘疹病</obo:OAE_0001849>
        <obo:OAE_0004334>10056670</obo:OAE_0004334>
        <rdfs:label>lymphomatoid papulosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006711 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a condition seen in some cases of AIDS or immunosuppression, in which the immune system begins to recover, but then responds to a previously acquired opportunistic infection with an overwhelming inflammatory response that paradoxically makes the symptoms of infection worse.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immune_reconstitution_inflammatory_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>免疫重建综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10054014</obo:OAE_0004334>
        <rdfs:label>immune reconstitution syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006712 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a condition arising from an abnormal immune response to a functioning body part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_disease</obo:IAO_0000119>
        <obo:OAE_0001849>免疫系统紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10021425</obo:OAE_0004334>
        <rdfs:label>immune system disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006713 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a state of unresponsiveness of the immune system to substances or tissue that have the capacity to elicit an immune response in a given organism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immune_tolerance</obo:IAO_0000119>
        <obo:OAE_0001849>免疫耐受诱导</obo:OAE_0001849>
        <obo:OAE_0004334>10070581</obo:OAE_0004334>
        <rdfs:label>immune tolerance induction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006714 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000613"/>
        <obo:IAO_0000115>This is an AE which is immune-mediated inflammation or swelling of the muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myositis</obo:IAO_0000119>
        <obo:OAE_0001849>免疫介导性肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10083073</obo:OAE_0004334>
        <rdfs:label>immune-mediated myositis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006715 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000525"/>
        <obo:IAO_0000115>This is an AE which is a type of autoimmune myopathy characterized by relatively severe proximal weakness, myofiber necrosis with minimal inflammatory cell infiltrate on muscle biopsy, and infrequent extra-muscular involvement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29582188/</obo:IAO_0000119>
        <obo:OAE_0001849>免疫介导性坏死性肌病</obo:OAE_0001849>
        <obo:OAE_0004334>10072155</obo:OAE_0004334>
        <rdfs:label>immune-mediated necrotising myopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006716 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001307"/>
        <obo:IAO_0000115>This is an AE which describes general immune-mediated inflammation of lung tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonitis</obo:IAO_0000119>
        <obo:OAE_0001849>免疫介导性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10082452</obo:OAE_0004334>
        <rdfs:label>immune-mediated pneumonitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006717 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is an immune disorder characterized by recurrent infections and low antibody levels, specifically in immunoglobulin (Ig) types IgG, IgM and IgA.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Common_variable_immunodeficiency</obo:IAO_0000119>
        <obo:OAE_0001849>普通变化型免疫缺陷病</obo:OAE_0001849>
        <obo:OAE_0004334>10021449</obo:OAE_0004334>
        <rdfs:label>immunodeficiency common variable AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006718 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000331"/>
        <obo:IAO_0000115>This is an AE which is a rare, benign and self-limited disease, affecting mainly young women and presenting with localised lymphadenopathy, fever and leucopenia in the majority of the reported cases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6011493/</obo:IAO_0000119>
        <obo:OAE_0001849>组织细胞的坏死性淋巴结炎</obo:OAE_0001849>
        <obo:OAE_0004334>10069070</obo:OAE_0004334>
        <rdfs:label>histiocytic necrotising lymphadenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006719 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is types of lymphoma affecting B cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/B-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>b细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10003899</obo:OAE_0004334>
        <rdfs:label>b-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006720 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is types of lymphoma affecting B cells and it is recurrent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/B-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>b细胞淋巴瘤复发</obo:OAE_0001849>
        <obo:OAE_0004334>10003902</obo:OAE_0004334>
        <rdfs:label>b-cell lymphoma recurrent AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006721 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is a long-term autoimmune disorder that primarily affects joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rheumatoid_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10071155</obo:OAE_0004334>
        <rdfs:label>autoimmune arthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006722 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which may present with a clinical pattern of vesicles indistinguishable from dermatitis herpetiformis, or with vesicles and bullae in a bullous pemphigoid-like appearance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Linear_IgA_bullous_dermatosis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性水泡性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10083961</obo:OAE_0004334>
        <rdfs:label>autoimmune blistering disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006723 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is autoimmune diseases which primarily affect the body system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/CNS_demyelinating_autoimmune_diseases</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性脱髓鞘疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10075688</obo:OAE_0004334>
        <rdfs:label>autoimmune demyelinating disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006724 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006724">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a condition arising from an abnormal immune response to a functioning endocrine part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_disease</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫内分泌紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10078953</obo:OAE_0004334>
        <rdfs:label>autoimmune endocrine disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006725 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a chronic disease in which the body interprets the thyroid glands and its hormone products T3, T4 and TSH as threats, therefore producing special antibodies that target the thyroid&apos;s cells, thereby destroying it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_thyroiditis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性甲状腺功能减退</obo:OAE_0001849>
        <obo:OAE_0004334>10076644</obo:OAE_0004334>
        <rdfs:label>autoimmune hypothyroidism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006726 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is autoimmune inflammation of the kidneys and may involve the glomeruli, tubules, or interstitial tissue surrounding the glomeruli and tubules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nephritis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10077087</obo:OAE_0004334>
        <rdfs:label>autoimmune nephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006727 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an increasingly recognized type of chronic pancreatitis that can be difficult to distinguish from pancreatic carcinoma but which responds to treatment with corticosteroids, particularly prednisone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_pancreatitis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性胰腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10069002</obo:OAE_0004334>
        <rdfs:label>autoimmune pancreatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006728 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is the most frequent cause of acquired thyroid dysfunction, most commonly presenting either as Hashimoto&apos;s thyroiditis or Graves&apos; Disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32973676/</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性甲状腺疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10079165</obo:OAE_0004334>
        <rdfs:label>autoimmune thyroid disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006729 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers not produce autoantibodies or antigen-specific T or B cells and can be characterized by errors in the innate immune system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periodic_fever_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>自身炎症性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10072220</obo:OAE_0004334>
        <rdfs:label>autoinflammatory disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006730 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a rare form of cancerous lymphoma affecting T-cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/T-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>T细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10042971</obo:OAE_0004334>
        <rdfs:label>t-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006731 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a disease of the lymph nodes on the vaccination site , in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphadenopathy</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位淋巴结肿大</obo:OAE_0001849>
        <obo:OAE_0004334>10069480</obo:OAE_0004334>
        <rdfs:label>vaccination site lymphadenopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006732 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which refers to a group of non-Hodgkin lymphomas in which aberrant T cells proliferate uncontrollably.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anaplastic_large-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>间变性大细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10073478</obo:OAE_0004334>
        <rdfs:label>anaplastic large-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006733 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006733">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a cancer of the lymphatic system, particularly B lymphocytes found in the germinal center.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Burkitt_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>伯基特淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10006595</obo:OAE_0004334>
        <rdfs:label>burkitt&apos;s lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006734 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is malformations of the lymphatic system characterized by lesions that are thin-walled cysts; these cysts can be macroscopic, as in a cystic hygroma, or microscopic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphangioma</obo:IAO_0000119>
        <obo:OAE_0001849>囊性淋巴管瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10058949</obo:OAE_0004334>
        <rdfs:label>cystic lymphangioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006735 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006735">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a cancer of B cells, a type of lymphocyte that is responsible for producing antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diffuse_large_B-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>弥漫大b细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10012818</obo:OAE_0004334>
        <rdfs:label>diffuse large b-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006736 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which may arise as a consequence of the transformation of the underlying indolent lymphoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28600333/</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10080202</obo:OAE_0004334>
        <rdfs:label>double hit lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006737 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000331"/>
        <obo:IAO_0000115>This is an AE which can be classified as noninfectious GLA and infectious GLA, noninfectious GLA includes sarcoidosis and sarcoid-like reaction and  infectious GLA can be classified as suppurative lymphadenitis (LA) and nonsuppurative LA.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22706525/</obo:IAO_0000119>
        <obo:OAE_0001849>肉芽肿性淋巴腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10078494</obo:OAE_0004334>
        <rdfs:label>granulomatous lymphadenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006738 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a disease of the lymph nodes on the injection site, in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphadenopathy</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位淋巴结病</obo:OAE_0001849>
        <obo:OAE_0004334>10057665</obo:OAE_0004334>
        <rdfs:label>injection site lymphadenopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006739 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of lymphomas that derive from the malignant transformation of marginal zone B-cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Marginal_zone_B-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>边缘带淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10076596</obo:OAE_0004334>
        <rdfs:label>marginal zone lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006740 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000331"/>
        <obo:IAO_0000115>This is an AE which represents a group of diseases characterized by non-granulomatous inflammation and necrosis of the lymph node, caused by a variety of infective and inflammatory diseases, most common being Kikuchi-Fujimoto disease, acute Epstein Barr viral infection and systemic lupus erythematosis .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32031124/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性肉芽肿性淋巴腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10058540</obo:OAE_0004334>
        <rdfs:label>necrotising granulomatous lymphadenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006741 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>This is an AE which is irregularities in the heartbeat, including when it is too fast or too slow and is nodal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arrhythmia</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴性心律失常</obo:OAE_0001849>
        <obo:OAE_0004334>10029458</obo:OAE_0004334>
        <rdfs:label>nodal arrhythmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006742 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a group of clinically indolent B-cell lymphomas postulated to derive from memory B lymphocytes in the &apos;marginal zone&apos; of secondary lymphoid tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31757436/</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结边缘区b细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029460</obo:OAE_0004334>
        <rdfs:label>nodal marginal zone b-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006743 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002016"/>
        <obo:IAO_0000115>This is an AE which is a type of nodal osteoarthritis degenerative joint disease that results from breakdown of joint cartilage and underlying bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteoarthritis</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴结骨关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10029469</obo:OAE_0004334>
        <rdfs:label>nodal osteoarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006744 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a group of blood cancers that includes all types of lymphomas except Hodgkin lymphomas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Non-Hodgkin_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>非霍奇金淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029547</obo:OAE_0004334>
        <rdfs:label>non-hodgkin&apos;s lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006745 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of clinically aggressive diseases associated with poor outcome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29674443/</obo:IAO_0000119>
        <obo:OAE_0001849>未指明外周t细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10034623</obo:OAE_0004334>
        <rdfs:label>peripheral t-cell lymphoma unspecified AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006746 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a reactive lymphadenitis affecting HIV-positive patients; furthermore, PGL is often a prodrome of AIDS-related complex and AIDS.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2192430/</obo:IAO_0000119>
        <obo:OAE_0001849>持续性全身淋巴结肿大</obo:OAE_0001849>
        <obo:OAE_0004334>10049025</obo:OAE_0004334>
        <rdfs:label>persistent generalised lymphadenopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006747 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a high-grade neoplasm arising from precursor lymphocytes of B-cell lineage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23840980/</obo:IAO_0000119>
        <obo:OAE_0001849>前体 B 淋巴母细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10036523</obo:OAE_0004334>
        <rdfs:label>precursor b-lymphoblastic lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006748 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is inherited defects of the innate or adaptive arms of the immune system that lead to an increase in the incidence, frequency, or severity of infections and/or immune dysregulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31690396/</obo:IAO_0000119>
        <obo:OAE_0001849>原发性免疫缺陷综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10064859</obo:OAE_0004334>
        <rdfs:label>primary immunodeficiency syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006749 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a rare type of lymphoma that forms in the mediastinum (the space in between the lungs) and predominantly affects young adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_mediastinal_B-cell_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>原发性纵隔大 B 细胞淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10036710</obo:OAE_0004334>
        <rdfs:label>primary mediastinal large b-cell lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006750 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a benign lymphocytic infiltrate that resembles cutaneous lymphoma histologically, clinically, or both.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pseudolymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>假性淋巴瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10037127</obo:OAE_0004334>
        <rdfs:label>pseudolymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006751 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is a genetic immunodeficiency, a type of hypogammaglobulinemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Selective_immunoglobulin_A_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>选择性iga免疫缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10039915</obo:OAE_0004334>
        <rdfs:label>selective iga immunodeficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is frequent, both as an apparently isolated defect (about one fourth of patients suffering otherwise unexplained repeated infections) and in association with a number of primary and required immunodeficiency states.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2223061/</obo:IAO_0000119>
        <obo:OAE_0001849>选择性igg亚类缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10057863</obo:OAE_0004334>
        <rdfs:label>selective igg subclass deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006753 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is a poorly defined dysgammaglobulinemia characterized by decreased levels of IgM while levels of other immunoglobulins are normal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Isolated_primary_immunoglobulin_M_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>选择性igm免疫缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10039916</obo:OAE_0004334>
        <rdfs:label>selective igm immunodeficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006754 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is one that affects a number of organs and tissues, or affects the body as a whole.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Systemic_disease</obo:IAO_0000119>
        <obo:OAE_0001849>全身感染</obo:OAE_0001849>
        <obo:OAE_0004334>10077116</obo:OAE_0004334>
        <rdfs:label>systemic infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006755 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory state affecting the whole body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Systemic_inflammatory_response_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>全身炎症反应综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10051379</obo:OAE_0004334>
        <rdfs:label>systemic inflammatory response syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006756 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000509"/>
        <obo:IAO_0000115>This is an AE which is a highly heterogeneous disorder, characterized by differences in autoantibody profile, serum cytokines, and a multi-system involvement commonly affecting the skin, renal, musculoskeletal, and hematopoetic systems clinical manifestations involving.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29775752/</obo:IAO_0000119>
        <obo:OAE_0001849>系统性红斑狼疮皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10042946</obo:OAE_0004334>
        <rdfs:label>systemic lupus erythematosus rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006757 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is a type of mast cell disease, is a rare disorder affecting both children and adults caused by the accumulation of functionally defective mast cells (also called mastocytes) and CD34+ mast cell precursors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mastocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>系统性肥大细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10042949</obo:OAE_0004334>
        <rdfs:label>systemic mastocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006758 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a rare but potentially life-threatening bleeding disorder characterized by autoantibodies directed against coagulation factor VIII.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acquired_haemophilia</obo:IAO_0000119>
        <obo:OAE_0001849>获得性血友病</obo:OAE_0001849>
        <obo:OAE_0004334>10053745</obo:OAE_0004334>
        <rdfs:label>acquired haemophilia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006759 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is a spectrum of conditions caused by infection with the human immunodeficiency virus (HIV), a retrovirus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/HIV/AIDS</obo:IAO_0000119>
        <obo:OAE_0001849>获得性免疫缺陷综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10000565</obo:OAE_0004334>
        <rdfs:label>acquired immunodeficiency syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006760 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a generic term referring to a disorder in which a cyst or cavity forms within the spinal cord .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Syringomyelia</obo:IAO_0000119>
        <obo:OAE_0001849>获得性脊髓空洞症</obo:OAE_0001849>
        <obo:OAE_0004334>10072631</obo:OAE_0004334>
        <rdfs:label>acquired syringomyelia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006761 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is an established treatment modality for a variety of hematologic malignancies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15253164/</obo:IAO_0000119>
        <obo:OAE_0001849>同种异体造血干细胞移植</obo:OAE_0001849>
        <obo:OAE_0004334>10067859</obo:OAE_0004334>
        <rdfs:label>allogenic stem cell transplantation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006762 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is an immune response to nonself antigens from members of the same species, which are called alloantigens or isoantigens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alloimmunity</obo:IAO_0000119>
        <obo:OAE_0001849>同种免疫</obo:OAE_0001849>
        <obo:OAE_0004334>100060935</obo:OAE_0004334>
        <rdfs:label>alloimmunisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006763 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is the lack of those reactions which may be transferred by lymphoid cells but not by serum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/5539788/</obo:IAO_0000119>
        <obo:OAE_0001849>细胞介导免疫缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10007877</obo:OAE_0004334>
        <rdfs:label>cell-mediated immune deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006764 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is conditions which cause impairment of humoral immunity, which can lead to immunodeficiency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Humoral_immune_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>体液免疫缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10020464</obo:OAE_0004334>
        <rdfs:label>humoral immune defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006765 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a state with infecion in which the immune system&apos;s ability to fight infectious diseases and cancer is compromised or entirely absent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immunodeficiency</obo:IAO_0000119>
        <obo:OAE_0001849>免疫缺陷宿主的感染</obo:OAE_0001849>
        <obo:OAE_0004334>10021818</obo:OAE_0004334>
        <rdfs:label>infection in an immunocompromised host AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006766 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a form of diabetes that exhibits clinical features similar to both type 1 diabetes (T1D) and type 2 diabetes (T2D).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Latent_autoimmune_diabetes_in_adults</obo:IAO_0000119>
        <obo:OAE_0001849>成人潜伏性自身免疫性糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10066389</obo:OAE_0004334>
        <rdfs:label>latent autoimmune diabetes in adults AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006767 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001129"/>
        <obo:IAO_0000115>This is an AE which is a form of leukopenia associated with a deficiency of monocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Monocytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>单核细胞减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10027905</obo:OAE_0004334>
        <rdfs:label>monocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006768 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which is a state in which the immune system&apos;s ability to fight infectious diseases and cancer is compromised or entirely absent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immunodeficiency</obo:IAO_0000119>
        <obo:OAE_0001849>继发性免疫缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10054979</obo:OAE_0004334>
        <rdfs:label>secondary immunodeficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006769 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is an acute condition involving a severe and dangerous lowered white blood cell count (leukopenia, most commonly of neutrophils) and thus causing a neutropenia in the circulating blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Agranulocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>粒细胞减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10001507</obo:OAE_0004334>
        <rdfs:label>agranulocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006770 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000672"/>
        <obo:IAO_0000115>This is an AE which is a rare WHO grade III type of astrocytoma, which is a type of cancer of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anaplastic_astrocytoma</obo:IAO_0000119>
        <obo:OAE_0001849>间变型星形细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10002224</obo:OAE_0004334>
        <rdfs:label>anaplastic astrocytoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006771 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is integral to the treatment of various malignant haematological conditions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29933906/</obo:IAO_0000119>
        <obo:OAE_0001849>自体造血干细胞移植</obo:OAE_0001849>
        <obo:OAE_0004334>10081347</obo:OAE_0004334>
        <rdfs:label>autologous haematopoietic stem cell transplant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006772 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
        <obo:IAO_0000115>This is an AE which is the condition of having greater than 200 basophils/μL in the venous blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Basophilia</obo:IAO_0000119>
        <obo:OAE_0001849>嗜碱细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10004173</obo:OAE_0004334>
        <rdfs:label>basophilia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006773 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a relatively uncommon tumor of the bone. It is characterized by the presence of multinucleated giant cells (osteoclast-like cells).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Giant-cell_tumor_of_bone</obo:IAO_0000119>
        <obo:OAE_0001849>骨巨细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10005969</obo:OAE_0004334>
        <rdfs:label>bone giant cell tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006774 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the tapered, lower end of the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conus_medullaris</obo:IAO_0000119>
        <obo:OAE_0001849>髓母细胞综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10053778</obo:OAE_0004334>
        <rdfs:label>conus medullaris syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006775 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>This is an AE which occurs predominantly in immunocompromised hosts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2554845/</obo:IAO_0000119>
        <obo:OAE_0001849>播散性巨细胞病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10049075</obo:OAE_0004334>
        <rdfs:label>disseminated cytomegaloviral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006776 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is the enlargement of red blood cells with near-constant hemoglobin concentration, and is defined by a mean corpuscular volume (MCV) of greater than 100 femtolitres (the precise criterion varies between laboratories).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macrocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>巨细胞增生症</obo:OAE_0001849>
        <obo:OAE_0004334>10025382</obo:OAE_0004334>
        <rdfs:label>macrocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006777 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is the medical term for an unusually large tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macroglossia</obo:IAO_0000119>
        <obo:OAE_0001849>巨舌</obo:OAE_0001849>
        <obo:OAE_0004334>10025391</obo:OAE_0004334>
        <rdfs:label>macroglossia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006778 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is a type of white blood cell of the immune system that engulfs and digests anything that does not have, on its surface, proteins that are specific to healthy body cells and is active.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macrophage#Types</obo:IAO_0000119>
        <obo:OAE_0001849>巨噬细胞活化</obo:OAE_0001849>
        <obo:OAE_0004334>10050206</obo:OAE_0004334>
        <rdfs:label>macrophage activation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006779 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is one type of mast cell activation disorder (MCAD), and is an immunological condition in which mast cells inappropriately and excessively release chemical mediators, resulting in a range of chronic symptoms, sometimes including anaphylaxis or near-anaphylaxis attacks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mast_cell_activation_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肥大细胞激活综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10075217</obo:OAE_0004334>
        <rdfs:label>mast cell activation syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006780 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of round-cell tumor consisting of mast cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mastocytoma</obo:IAO_0000119>
        <obo:OAE_0001849>肥大细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10026890</obo:OAE_0004334>
        <rdfs:label>mastocytoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006781 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which refers a type of mast cell disease, is a rare disorder affecting both children and adults caused by the accumulation of functionally defective mast cells (also called mastocytes) and CD34+ mast cell precursors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mastocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>肥大细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10026891</obo:OAE_0004334>
        <rdfs:label>mastocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006782 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is a large bone marrow cell with a lobated nucleus responsible for the production of blood thrombocytes (platelets), which are necessary for normal blood clotting.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Megakaryocyte</obo:IAO_0000119>
        <obo:OAE_0001849>巨核细胞</obo:OAE_0001849>
        <obo:OAE_0004334>10050922</obo:OAE_0004334>
        <rdfs:label>megakaryocytes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006783 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is the most common demyelinating disease,in which the insulating covers of nerve cells in the brain and spinal cord are damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_sclerosis#Types_and_variants</obo:IAO_0000119>
        <obo:OAE_0001849>原发性进行性多发性硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10063401</obo:OAE_0004334>
        <rdfs:label>primary progressive multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006784 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is a major cause of neurological disability, which accrues predominantly during progressive forms of the disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27889191/</obo:IAO_0000119>
        <obo:OAE_0001849>进行性多发性硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10053395</obo:OAE_0004334>
        <rdfs:label>progressive multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006785 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is the most common demyelinating disease and is progressive relapsing, in which the insulating covers of nerve cells in the brain and spinal cord are damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>进行性复发性多发性硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10067063</obo:OAE_0004334>
        <rdfs:label>progressive relapsing multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006786 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is the most common demyelinating disease and can relapsing, in which the insulating covers of nerve cells in the brain and spinal cord are damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>复发性多发性硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10080700</obo:OAE_0004334>
        <rdfs:label>relapsing multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006787 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which begins with a clinically isolated syndrome (CIS).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_sclerosis#Types_and_variants</obo:IAO_0000119>
        <obo:OAE_0001849>复发缓解型多发性硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10063399</obo:OAE_0004334>
        <rdfs:label>relapsing-remitting multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006788 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which occurs in around 65% of those with initial relapsing-remitting MS, who eventually have progressive neurologic decline between acute attacks without any definite periods of remission.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_sclerosis#Types_and_variants</obo:IAO_0000119>
        <obo:OAE_0001849>继发性进行性多发性硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10063400</obo:OAE_0004334>
        <rdfs:label>secondary progressive multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006789 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is considered one of the multiple sclerosis borderline diseases, which is a collection of diseases classified by some as MS variants and by others as different diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Marburg_acute_multiple_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>马尔堡型多发性硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10067067</obo:OAE_0004334>
        <rdfs:label>marburg&apos;s variant multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006790 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection involving the inner layers of the skin on the infusion site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>输注部位蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065455</obo:OAE_0004334>
        <rdfs:label>infusion site cellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006791 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels on the infusion site .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>输液部位出血</obo:OAE_0001849>
        <obo:OAE_0004334>10065464</obo:OAE_0004334>
        <rdfs:label>infusion site hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006792 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling often caused by intense or damaging stimuli on the infusion site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>输液部位疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10053483</obo:OAE_0004334>
        <rdfs:label>infusion site pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006793 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001083"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of infusion site not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>输液部位肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10053505</obo:OAE_0004334>
        <rdfs:label>infusion site swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006794 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001083"/>
        <obo:IAO_0000115>This is an AE which refers a somewhat high temperature on the infusion site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Warm</obo:IAO_0000119>
        <obo:OAE_0001849>输液部位发热</obo:OAE_0001849>
        <obo:OAE_0004334>10053484</obo:OAE_0004334>
        <rdfs:label>infusion site warmth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006795 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004276"/>
        <obo:IAO_0000115>This is an AE which is an iatrogenic infection occurring as an isolated case or as cluster outbreak.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17643000/</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位无菌脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10022045</obo:OAE_0004334>
        <rdfs:label>injection site abscess sterile AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006796 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of injection site tissue, the most common cause being capillaries damaged by trauma, causing localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位瘀伤</obo:OAE_0001849>
        <obo:OAE_0004334>10022052</obo:OAE_0004334>
        <rdfs:label>injection site bruising AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006797 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is the accumulation of calcium salts in injection site  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Calcification</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10054812</obo:OAE_0004334>
        <rdfs:label>injection site calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006798 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the injection site, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10022055</obo:OAE_0004334>
        <rdfs:label>injection site cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006799 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a harmful mutation or other deformation in injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformation</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位变形</obo:OAE_0001849>
        <obo:OAE_0004334>10079275</obo:OAE_0004334>
        <rdfs:label>injection site deformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006800 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006800">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the skin on the injection site, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位皮肤炎</obo:OAE_0001849>
        <obo:OAE_0004334>10022056</obo:OAE_0004334>
        <rdfs:label>injection site dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006801 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is the shedding of the outermost membrane or layer of a tissue, such as injection site skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Desquamation</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位脱屑</obo:OAE_0001849>
        <obo:OAE_0004334>10059007</obo:OAE_0004334>
        <rdfs:label>injection site desquamation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006802 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006802">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which there is local or more generalized decrease in normal lubrication of the skin or mucous membranes such in the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dryness_(medical)</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10067252</obo:OAE_0004334>
        <rdfs:label>injection site dryness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006803 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which means &quot;abnormal sensation&quot; on the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位感觉不良</obo:OAE_0001849>
        <obo:OAE_0004334>10069124</obo:OAE_0004334>
        <rdfs:label>injection site dysaesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006804 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006804">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is a chronic, relapsing, and remitting disease  on the injection site that can affect patients from infancy through adulthood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31563186/</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位湿疹</obo:OAE_0001849>
        <obo:OAE_0004334>10066221</obo:OAE_0004334>
        <rdfs:label>injection site eczema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006805 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000687"/>
        <obo:IAO_0000115>This is an AE which removes dead injection site skin from the body and face.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exfoliation</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位表皮脱落</obo:OAE_0001849>
        <obo:OAE_0004334>10068689</obo:OAE_0004334>
        <rdfs:label>injection site exfoliation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006807 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing on the injection site in which connective tissue replaces normal parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10022064</obo:OAE_0004334>
        <rdfs:label>injection site fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006808 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is an aggregation of macrophages that forms in response to chronic inflammation on the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10022065</obo:OAE_0004334>
        <rdfs:label>injection site granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006809 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002050"/>
        <obo:IAO_0000115>This is an AE which is a condition on the injection site that involves an abnormal increase in sensitivity to stimuli of the sense.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位感觉过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10073418</obo:OAE_0004334>
        <rdfs:label>injection site hyperesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006810 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002788"/>
        <obo:IAO_0000115>This is an AE which is an abnormal amount of hair growth over the injection site tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrichosis</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位多毛症</obo:OAE_0001849>
        <obo:OAE_0004334>10075313</obo:OAE_0004334>
        <rdfs:label>injection site hypertrichosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006811 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of injection site tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10022072</obo:OAE_0004334>
        <rdfs:label>injection site hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006812 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect on the injection site of various medical conditions which manifests as a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位触觉减退</obo:OAE_0001849>
        <obo:OAE_0004334>10074586</obo:OAE_0004334>
        <rdfs:label>injection site hypoesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006813 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the injection site caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10066083</obo:OAE_0004334>
        <rdfs:label>injection site injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006814 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006814">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a injection site state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10022079</obo:OAE_0004334>
        <rdfs:label>injection site irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006815 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which refers to accumulation of fluid in an anatomic injection site joint space, usually without loculation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Effusion</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节积液</obo:OAE_0001849>
        <obo:OAE_0004334>10064494</obo:OAE_0004334>
        <rdfs:label>injection site joint effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006816 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the injection site joint skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10076327</obo:OAE_0004334>
        <rdfs:label>injection site joint erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006817 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a procedure used in the treatment of inflammatory joint conditions, such as rheumatoid arthritis, psoriatic arthritis, gout, tendinitis, bursitis, Carpal Tunnel Syndrome, and occasionally osteoarthritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Joint_injection</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节感染</obo:OAE_0001849>
        <obo:OAE_0004334>10074703</obo:OAE_0004334>
        <rdfs:label>injection site joint infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006818 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of injection site joint tissues to harmful stimuli, such as pathogens, damaged cells, or irritants,and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10064111</obo:OAE_0004334>
        <rdfs:label>injection site joint inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006819 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling on the injection site joint often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节痛</obo:OAE_0001849>
        <obo:OAE_0004334>10049261</obo:OAE_0004334>
        <rdfs:label>injection site joint pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006820 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000327"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of injection site joint area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10049260</obo:OAE_0004334>
        <rdfs:label>injection site joint swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006821 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000326"/>
        <obo:IAO_0000115>This is an AE which refers a somewhat high temperature on the injection site joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Warm</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位关节发热</obo:OAE_0001849>
        <obo:OAE_0004334>10049262</obo:OAE_0004334>
        <rdfs:label>injection site joint warmth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006822 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which is a type of injury which happens relatively quickly such as in the injection site in which skin is torn, cut, or punctured (an open wound), or where blunt force trauma causes a contusion (a closed wound).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位撕裂</obo:OAE_0001849>
        <obo:OAE_0004334>10067253</obo:OAE_0004334>
        <rdfs:label>injection site laceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006823 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a lack of muscle strength in the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Muscle_weakness</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位肌无力</obo:OAE_0001849>
        <obo:OAE_0004334>10084588</obo:OAE_0004334>
        <rdfs:label>injection site muscle weakness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006824 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a form of cell injury in the injection site which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10022082</obo:OAE_0004334>
        <rdfs:label>injection site necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006825 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is injury to nervous tissue in the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nerve_injury</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10022083</obo:OAE_0004334>
        <rdfs:label>injection site nerve damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006826 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000419"/>
        <obo:IAO_0000115>This is an AE which refers a small aggregation of cells in the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nodule</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位结节</obo:OAE_0001849>
        <obo:OAE_0004334>10057880</obo:OAE_0004334>
        <rdfs:label>injection site nodule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006827 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006827">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000368"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the injection site tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10022085</obo:OAE_0004334>
        <rdfs:label>injection site edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006828 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000606"/>
        <obo:IAO_0000115>This is an AE which is a pale color of the injection site skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pallor</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位苍白</obo:OAE_0001849>
        <obo:OAE_0004334>10066041</obo:OAE_0004334>
        <rdfs:label>injection site pallor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006829 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002528"/>
        <obo:IAO_0000115>This is an AE which is a small, well-defined bump in the injection site skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papule</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位丘疹</obo:OAE_0001849>
        <obo:OAE_0004334>10066044</obo:OAE_0004334>
        <rdfs:label>injection site papule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006830 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the injection site skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位感觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10022088</obo:OAE_0004334>
        <rdfs:label>injection site paraesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006831 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which refers a type of cutaneous condition in the injection site .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plaque</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位斑块</obo:OAE_0001849>
        <obo:OAE_0004334>10073174</obo:OAE_0004334>
        <rdfs:label>injection site plaque AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006832 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is any medical condition that affects the integumentary system in the injection site .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位脓疱</obo:OAE_0001849>
        <obo:OAE_0004334>10054994</obo:OAE_0004334>
        <rdfs:label>injection site pustule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006833 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001090"/>
        <obo:IAO_0000115>This is an AE which is an area of fibrous tissue that replaces normal skin after an injury in the injection site tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scar</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位的疤痕</obo:OAE_0001849>
        <obo:OAE_0004334>10059009</obo:OAE_0004334>
        <rdfs:label>injection site scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006834 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002564"/>
        <obo:IAO_0000115>This is an AE which is small dilated blood vessels that can occur near the surface of the injection site skin or mucous membranes, measuring between 0.5 and 1 millimeter in diameter.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Telangiectasia</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位毛细管扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10079124</obo:OAE_0004334>
        <rdfs:label>injection site telangiectasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006835 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders that destroy blood vessels by inflammation on the injection site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>注射部位血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067995</obo:OAE_0004334>
        <rdfs:label>injection site vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006836 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the instillation site skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>滴注部位红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10063762</obo:OAE_0004334>
        <rdfs:label>instillation site erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006837 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the instillation site skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>滴注部位感觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10073558</obo:OAE_0004334>
        <rdfs:label>instillation site paraesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006838 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000226"/>
        <obo:IAO_0000115>This is an AE which refers a liquid-filled cavity under the instillation site epidermis, commonly called a blister.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vesicle</obo:IAO_0000119>
        <obo:OAE_0001849>滴注部位囊泡</obo:OAE_0001849>
        <obo:OAE_0004334>10073628</obo:OAE_0004334>
        <rdfs:label>instillation site vesicles AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006839 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>关节脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10058981</obo:OAE_0004334>
        <rdfs:label>joint abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006840 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006840">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>肌脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10049206</obo:OAE_0004334>
        <rdfs:label>muscle abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006841 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a rare complication of acute parotitis in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26527073/</obo:IAO_0000119>
        <obo:OAE_0001849>腮腺脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10034019</obo:OAE_0004334>
        <rdfs:label>parotid abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006842 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which refers an abscess in the psoas muscle of the abdomen may be caused by lumbar tuberculosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psoas_muscle_abscess</obo:IAO_0000119>
        <obo:OAE_0001849>腰大肌脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10056517</obo:OAE_0004334>
        <rdfs:label>psoas abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006843 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is the most common symptom is fever, followed by abdominal pain and a tender mass on palpation of the left upper quadrant of the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spleen_pain#Splenic_abscess</obo:IAO_0000119>
        <obo:OAE_0001849>脾脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10041643</obo:OAE_0004334>
        <rdfs:label>splenic abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006844 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is an abscess located in the subcutaneous tissue (also hypodermis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subcutaneous_abscess</obo:IAO_0000119>
        <obo:OAE_0001849>皮下脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10042343</obo:OAE_0004334>
        <rdfs:label>subcutaneous abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006845 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the body caused  by streptococcal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>链球菌脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10042176</obo:OAE_0004334>
        <rdfs:label>streptococcal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006846 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the subdural.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜下脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10083083</obo:OAE_0004334>
        <rdfs:label>subdural abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006847 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a condition that typically presents as collection of pus in the space between the periorbital and the lamina papyracea as a result of the migration and spread of an infection, such as sinusitis and ethmoiditis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30871969/</obo:IAO_0000119>
        <obo:OAE_0001849>骨膜下脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10075118</obo:OAE_0004334>
        <rdfs:label>subperiosteal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006848 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001451"/>
        <obo:IAO_0000115>This is an AE which is a neoplasm or tumor of the thyroid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10043744</obo:OAE_0004334>
        <rdfs:label>thyroid neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006849 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006849">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is an unfavorable result of a disease, health condition, or treatment such after vaccination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complication_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>接种并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10046861</obo:OAE_0004334>
        <rdfs:label>vaccination complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006850 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10069556</obo:OAE_0004334>
        <rdfs:label>vaccination site abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006851 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is a vaccination site state of controlled, temporary loss of sensation or awareness that is induced for medical purposes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位麻醉</obo:OAE_0001849>
        <obo:OAE_0004334>10076192</obo:OAE_0004334>
        <rdfs:label>vaccination site anaesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006852 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10076155</obo:OAE_0004334>
        <rdfs:label>vaccination site atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006853 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of vaccination site, the most common cause being capillaries damaged by trauma, causing localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位淤青</obo:OAE_0001849>
        <obo:OAE_0004334>10069484</obo:OAE_0004334>
        <rdfs:label>vaccination site bruising AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006854 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection involving the inner layers of the vaccination site skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10069559</obo:OAE_0004334>
        <rdfs:label>vaccination site cellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006855 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the vaccination site, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10076158</obo:OAE_0004334>
        <rdfs:label>vaccination site cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006856 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which there is local or more generalized decrease in normal lubrication of the vaccination site skin or mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dryness_(medical)</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10076159</obo:OAE_0004334>
        <rdfs:label>vaccination site dryness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006857 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which defines as an unpleasant, abnormal sense of touch on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位感觉迟钝</obo:OAE_0001849>
        <obo:OAE_0004334>10076160</obo:OAE_0004334>
        <rdfs:label>vaccination site dysaesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006858 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which refers to a broad range of conditions that begin as spongiotic dermatitis and may progress to a lichenified stage on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/List_of_skin_conditions#Eczema</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位湿疹</obo:OAE_0001849>
        <obo:OAE_0004334>10076161</obo:OAE_0004334>
        <rdfs:label>vaccination site eczema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006859 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the vaccination site skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10059079</obo:OAE_0004334>
        <rdfs:label>vaccination site erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006860 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which is a slough or piece of dead tissue that is cast off from the surface of the vaccination site  skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eschar</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位焦痂</obo:OAE_0001849>
        <obo:OAE_0004334>10069561</obo:OAE_0004334>
        <rdfs:label>vaccination site eschar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006861 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000687"/>
        <obo:IAO_0000115>This is an AE which aims to remove dead skin from the vaccination site tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exfoliation</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位去角质</obo:OAE_0001849>
        <obo:OAE_0004334>10069489</obo:OAE_0004334>
        <rdfs:label>vaccination site exfoliation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006863 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is an aggregation of macrophages that forms in response to chronic inflammation on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10069562</obo:OAE_0004334>
        <rdfs:label>vaccination site granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006864 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a vaccination site bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10069472</obo:OAE_0004334>
        <rdfs:label>vaccination site hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels on the vaccination site .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位出血</obo:OAE_0001849>
        <obo:OAE_0004334>10069475</obo:OAE_0004334>
        <rdfs:label>vaccination site hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006866 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <obo:IAO_0000115>This is an AE which refers to undesirable reactions on the vaccination site produced by the normal immune system, including allergies and autoimmunity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypersensitivity</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10068880</obo:OAE_0004334>
        <rdfs:label>vaccination site hypersensitivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006867 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002788"/>
        <obo:IAO_0000115>This is an AE which is an abnormal amount of hair growth over the vaccination site tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrichosis</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位多毛症</obo:OAE_0001849>
        <obo:OAE_0004334>10076166</obo:OAE_0004334>
        <rdfs:label>vaccination site hypertrichosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006868 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of vaccination site  tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10076167</obo:OAE_0004334>
        <rdfs:label>vaccination site hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006869 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006869">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of vaccination site which manifests as a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位感觉减退</obo:OAE_0001849>
        <obo:OAE_0004334>10076168</obo:OAE_0004334>
        <rdfs:label>vaccination site hypoesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006870 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002039"/>
        <obo:IAO_0000115>This is an AE which is dermal thickening causing the cutaneous vaccination site surface to feel thicker and firmer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Secondary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位硬结</obo:OAE_0001849>
        <obo:OAE_0004334>10065117</obo:OAE_0004334>
        <rdfs:label>vaccination site induration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006871 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the invasion of vaccination site tissues by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位感染</obo:OAE_0001849>
        <obo:OAE_0004334>10068877</obo:OAE_0004334>
        <rdfs:label>vaccination site infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006872 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of vaccination site  tissues to harmful stimuli, such as pathogens, damaged cells, or irritants, and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10068878</obo:OAE_0004334>
        <rdfs:label>vaccination site inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006873 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the vaccination site caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10076169</obo:OAE_0004334>
        <rdfs:label>vaccination site injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006874 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is a vaccination site state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10069479</obo:OAE_0004334>
        <rdfs:label>vaccination site irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006875 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which is the presence of increased intra-articular fluid on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Joint_effusion</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位关节积液</obo:OAE_0001849>
        <obo:OAE_0004334>10076172</obo:OAE_0004334>
        <rdfs:label>vaccination site joint effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006876 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the vaccination site joint skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位关节红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10076177</obo:OAE_0004334>
        <rdfs:label>vaccination site joint erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006877 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003301"/>
        <obo:IAO_0000115>This is an AE which is the invasion of a joint by an infectious agent resulting in joint inflammation on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Septic_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位关节感染</obo:OAE_0001849>
        <obo:OAE_0004334>10076173</obo:OAE_0004334>
        <rdfs:label>vaccination site joint infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006878 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001559"/>
        <obo:IAO_0000115>This is an AE which is a vaccination site symptom of injury, infection, illness (in particular arthritis), or an allergic reaction to medication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arthralgia</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位关节痛</obo:OAE_0001849>
        <obo:OAE_0004334>10076176</obo:OAE_0004334>
        <rdfs:label>vaccination site joint pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006879 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000327"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of vaccination site joint not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位关节肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10076178</obo:OAE_0004334>
        <rdfs:label>vaccination site joint swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006880 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which refers irregular tear-like wounds caused by some blunt trauma on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound#Open</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位裂伤</obo:OAE_0001849>
        <obo:OAE_0004334>10076180</obo:OAE_0004334>
        <rdfs:label>vaccination site laceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006881 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is a change in vaccination site surface color, without elevation or depression, so nonpalpable, well or ill-defined, variously sized, but generally considered less than either 5 or 10 mm in diameter at the widest point.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Primary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位黄斑</obo:OAE_0001849>
        <obo:OAE_0004334>10076181</obo:OAE_0004334>
        <rdfs:label>vaccination site macule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006882 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a form of cell injury on the vaccination site which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10069625</obo:OAE_0004334>
        <rdfs:label>vaccination site necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006883 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is injury to vaccination site nervous tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nerve_injury</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10076184</obo:OAE_0004334>
        <rdfs:label>vaccination site nerve damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006884 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000419"/>
        <obo:IAO_0000115>This is an AE which refers a small aggregation of cells on the vaccination site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nodule</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位结节</obo:OAE_0001849>
        <obo:OAE_0004334>10069616</obo:OAE_0004334>
        <rdfs:label>vaccination site nodule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006885 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in thevaccination site tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10069617</obo:OAE_0004334>
        <rdfs:label>vaccination site edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006886 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling on the vaccination site often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10068879</obo:OAE_0004334>
        <rdfs:label>vaccination site pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006887 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000606"/>
        <obo:IAO_0000115>This is an AE which is a pale color of the vaccination site skin that can be caused by illness, emotional shock or stress, stimulant use, or anemia, and is the result of a reduced amount of oxyhaemoglobin and may also be visible as pallor of the conjunctivae of the eyes on physical examination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pallor</obo:IAO_0000119>
        <obo:OAE_0001849>疫苗接种部位发白</obo:OAE_0001849>
        <obo:OAE_0004334>10066045</obo:OAE_0004334>
        <rdfs:label>vaccination site pallor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006888 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002528"/>
        <obo:IAO_0000115>This is an AE which is a small, well-defined bump in the vaccination site skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papule</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位丘疹</obo:OAE_0001849>
        <obo:OAE_0004334>10066046</obo:OAE_0004334>
        <rdfs:label>vaccination site papule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006889 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the vaccination site skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位感觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10069481</obo:OAE_0004334>
        <rdfs:label>vaccination site paraesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006890 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which refers a type of cutaneous vaccination site condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plaque</obo:IAO_0000119>
        <obo:OAE_0001849>接种点斑点</obo:OAE_0001849>
        <obo:OAE_0004334>10076187</obo:OAE_0004334>
        <rdfs:label>vaccination site plaque AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006891 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is a vaccination site sensation that causes the desire or reflex to scratch.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>接种部位瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10068881</obo:OAE_0004334>
