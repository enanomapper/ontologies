        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000053"/>
        <obo:IAO_0000115>a wheezing AE that has detectable airway noise with minimal symptoms</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 wheezing AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13606</rdfs:seeAlso>
    </owl:Class>
    


