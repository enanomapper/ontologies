        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 anemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10012</rdfs:seeAlso>
    </owl:Class>
    


