    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007984 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of vertebral , usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>椎骨病变</obo:OAE_0001849>
        <obo:OAE_0004334>10048877</obo:OAE_0004334>
        <rdfs:label>vertebral lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007985 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is related to anatomical structures adjacent to the spinal column.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20383671/</obo:IAO_0000119>
        <obo:OAE_0001849>椎骨骨赘</obo:OAE_0001849>
        <obo:OAE_0004334>10055042</obo:OAE_0004334>
        <rdfs:label>vertebral osteophyte AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007986 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is characterized by presence of a very rigid foot deformity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rocker_bottom_foot</obo:IAO_0000119>
        <obo:OAE_0001849>垂直距骨</obo:OAE_0001849>
        <obo:OAE_0004334>10066242</obo:OAE_0004334>
        <rdfs:label>vertical talus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007987 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a skeletal medical condition in which the shoulder blade protrudes from a person&apos;s back in an abnormal position.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Winged_scapula</obo:IAO_0000119>
        <obo:OAE_0001849>翼状肩胛骨</obo:OAE_0001849>
        <obo:OAE_0004334>10067628</obo:OAE_0004334>
        <rdfs:label>winged scapula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007988 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is pain that results from touching the region inside of the costovertebral angle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Costovertebral_angle_tenderness</obo:IAO_0000119>
        <obo:OAE_0001849>肋椎角压痛</obo:OAE_0001849>
        <obo:OAE_0004334>10051704</obo:OAE_0004334>
        <rdfs:label>costovertebral angle tenderness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007989 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is characterised by focal thickening of the skin of the hands and feet and is associated with a very high lifetime risk of developing squamous cell carcinoma of the oesophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26419362/</obo:IAO_0000119>
        <obo:OAE_0001849>掌跖角化过度</obo:OAE_0001849>
        <obo:OAE_0004334>10052573</obo:OAE_0004334>
        <rdfs:label>hyperkeratosis palmaris and plantaris AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007990 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which occurs when an organism is exceptionally small.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dwarfism</obo:IAO_0000119>
        <obo:OAE_0001849>矮小体型</obo:OAE_0001849>
        <obo:OAE_0004334>10071034</obo:OAE_0004334>
        <rdfs:label>microsomia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007991 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is any condition that makes it more difficult for a person to do certain activities or effectively interact with the world around them (socially or materially).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Disability</obo:IAO_0000119>
        <obo:OAE_0001849>残疾</obo:OAE_0001849>
        <obo:OAE_0004334>10013050</obo:OAE_0004334>
        <rdfs:label>disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007992 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which refers slowness of initiation of voluntary movement with a progressive reduction in speed and range of repetitive actions, such as voluntary finger-tapping.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypokinesia#Bradykinesia</obo:IAO_0000119>
        <obo:OAE_0001849>动作迟缓</obo:OAE_0001849>
        <obo:OAE_0004334>10006100</obo:OAE_0004334>
        <rdfs:label>bradykinesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007993 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000306"/>
        <obo:IAO_0000115>This is an AE which is a seizure associated with a high body temperature but without any serious underlying health issue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Febrile_seizure</obo:IAO_0000119>
        <obo:OAE_0001849>高热惊厥</obo:OAE_0001849>
        <obo:OAE_0004334>10016284</obo:OAE_0004334>
        <rdfs:label>febrile convulsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007994 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a bony growth originating inside a ligament, commonly seen in the ligaments of the spine, specifically the ligaments in the intervertebral joints leading to fusion of vertebrae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Syndesmophyte</obo:IAO_0000119>
        <obo:OAE_0001849>合生体</obo:OAE_0001849>
        <obo:OAE_0004334>10057603</obo:OAE_0004334>
        <rdfs:label>syndesmophyte AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007995 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a symptom that describes muscle pain on mild exertion (ache, cramp, numbness or sense of fatigue), classically in the calf muscle, which occurs during exercise, such as walking, and is relieved by a short period of rest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intermittent_claudication</obo:IAO_0000119>
        <obo:OAE_0001849>间歇性跛行</obo:OAE_0001849>
        <obo:OAE_0004334>10022562</obo:OAE_0004334>
        <rdfs:label>intermittent claudication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007996 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000419"/>
        <obo:IAO_0000115>This is an AE which refers a small aggregation of cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nodule</obo:IAO_0000119>
        <obo:OAE_0001849>结节</obo:OAE_0001849>
        <obo:OAE_0004334>10054107</obo:OAE_0004334>
        <rdfs:label>nodule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007997 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a lump of tissue, or an area of swelling, that appear on the exterior of the skin usually around the olecranon (tip of the elbow) or the interphalangeal joints (finger knuckles), but can appear in other areas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rheumatoid_nodule</obo:IAO_0000119>
        <obo:OAE_0001849>类风湿结节</obo:OAE_0001849>
        <obo:OAE_0004334>10048694</obo:OAE_0004334>
        <rdfs:label>rheumatoid nodule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007998 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a deformity of the joint connecting the big toe to the foot.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bunion</obo:IAO_0000119>
        <obo:OAE_0001849>姆囊炎</obo:OAE_0001849>
        <obo:OAE_0004334>10006585</obo:OAE_0004334>
        <rdfs:label>bunion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007999 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a childhood hip disorder initiated by a disruption of blood flow to the head of the femur.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Legg%E2%80%93Calv%C3%A9%E2%80%93Perthes_disease</obo:IAO_0000119>
        <obo:OAE_0001849>佩尔特斯疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10034735</obo:OAE_0004334>
        <rdfs:label>perthes disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008000 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a condition in which one side of the body or a part of one side of the body is larger than the other to an extent considered greater than the normal variation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemihypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>偏侧肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10019463</obo:OAE_0004334>
        <rdfs:label>hemihypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002049"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth or development of cells (microscopic scale) or organs (macroscopic scale), and the abnormal histology or anatomical structure resulting from such growth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>起立困难</obo:OAE_0001849>
        <obo:OAE_0004334>10050256</obo:OAE_0004334>
        <rdfs:label>dysstasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a radially symmetrical contraction and relaxation of muscles that propagates in a wave down a tube, in an anterograde direction and is visible.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peristalsis</obo:IAO_0000119>
        <obo:OAE_0001849>蠕动可见</obo:OAE_0001849>
        <obo:OAE_0004334>10034647</obo:OAE_0004334>
        <rdfs:label>peristalsis visible AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a dystonic condition defined by an abnormal, asymmetrical head or neck position, which may be due to a variety of causes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Torticollis</obo:IAO_0000119>
        <obo:OAE_0001849>斜颈</obo:OAE_0001849>
        <obo:OAE_0004334>10044074</obo:OAE_0004334>
        <rdfs:label>torticollis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is the placement of the body in a reverentially or submissively prone position as a gesture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prostration</obo:IAO_0000119>
        <obo:OAE_0001849>虚脱</obo:OAE_0001849>
        <obo:OAE_0004334>10036985</obo:OAE_0004334>
        <rdfs:label>prostration AE</rdfs:label>
    </owl:Class>
    


