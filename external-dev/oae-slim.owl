    <!-- http://purl.obolibrary.org/obo/OAE_0007610 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115>This is an AE which is an increasingly recognized cause of transient thyrotoxicosis.</obo:IAO_0000115>
