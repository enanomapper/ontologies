    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005426 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002240"/>
        <obo:IAO_0000115>This is an AE which is the indirectly observed pressure over the venous system via visualization of the internal jugular vein.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Jugular_venous_pressure</obo:IAO_0000119>
