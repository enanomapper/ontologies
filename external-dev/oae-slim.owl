    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008357 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which associated with fundal placenta causing depression of the uterine fundus in case of inappropriate maneuvers (pulling on the umbilical cord, uterine expression).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29875980/</obo:IAO_0000119>
        <obo:OAE_0001849>子宫低渗</obo:OAE_0001849>
