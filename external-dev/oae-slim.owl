    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008575 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is non-cyclic uterine bleeding characterized by irregular, prolonged, and often heavy menstruation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31747180/</obo:IAO_0000119>
        <obo:OAE_0001849>无排卵性出血</obo:OAE_0001849>
        <obo:OAE_0004334>10005104</obo:OAE_0004334>
        <rdfs:label>bleeding anovulatory AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008576 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000232"/>
        <obo:IAO_0000115>This is an AE which is the ending of pregnancy where one or more babies leaves the uterus by passing through the vagina or by Caesarean section with bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childbirth</obo:IAO_0000119>
        <obo:OAE_0001849>围产期出血</obo:OAE_0001849>
        <obo:OAE_0004334>10048607</obo:OAE_0004334>
        <rdfs:label>bleeding peripartum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008577 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection involving the inner layers of the skin  of male external genital organ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>男性外生殖器蜂窝组织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064929</obo:OAE_0004334>
        <rdfs:label>cellulitis of male external genital organ AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008578 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is a sexual activity typically involving the insertion and thrusting of the penis into the vagina for sexual pleasure, reproduction, or both and can bleeding sometimes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sexual_intercourse</obo:IAO_0000119>
        <obo:OAE_0001849>性交出血</obo:OAE_0001849>
        <obo:OAE_0004334>10065019</obo:OAE_0004334>
        <rdfs:label>coital bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008579 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which means diminished functional activity of the gonads—the testes or the ovaries—that may result in diminished production of sex hormones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypogonadism</obo:IAO_0000119>
        <obo:OAE_0001849>性腺机能减退</obo:OAE_0001849>
        <obo:OAE_0004334>10058359</obo:OAE_0004334>
        <rdfs:label>hypogonadism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008580 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which means diminished functional activity of the gonads the testes or the ovaries that may result in diminished production of sex hormones occurs on male.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypogonadism#Men</obo:IAO_0000119>
        <obo:OAE_0001849>男性性腺机能减退</obo:OAE_0001849>
        <obo:OAE_0004334>10021011</obo:OAE_0004334>
        <rdfs:label>hypogonadism male AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008581 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is extremely heavy menstrual blood flow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypomenorrhea</obo:IAO_0000119>
        <obo:OAE_0001849>月经过多</obo:OAE_0001849>
        <obo:OAE_0004334>10021033</obo:OAE_0004334>
        <rdfs:label>hypomenorrhoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008582 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a common disorder that appears to be a consequence of a wide range of physical and psychological conditions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27681645/</obo:IAO_0000119>
        <obo:OAE_0001849>男性性功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10057672</obo:OAE_0004334>
        <rdfs:label>male sexual dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008583 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of malignant nipple tissue on the female.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>女性恶性乳头肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10053129</obo:OAE_0004334>
        <rdfs:label>malignant nipple neoplasm female AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008584 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000921"/>
        <obo:IAO_0000115>This is an AE which occurs when semen which would be ejaculated via the urethra is redirected to the urinary bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retrograde_ejaculation</obo:IAO_0000119>
        <obo:OAE_0001849>逆行性射精</obo:OAE_0001849>
        <obo:OAE_0004334>10038967</obo:OAE_0004334>
        <rdfs:label>retrograde ejaculation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008585 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of retroplacental blood vessels, due to either disease or trauma including injury or surgery[1] and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>胎盘后血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10054798</obo:OAE_0004334>
        <rdfs:label>retroplacental hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008586 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000921"/>
        <obo:IAO_0000115>This is an AE which can be seen on the oocyte retrieval day which might cause the cancelation of oocyte retrieval procedure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31350169/</obo:IAO_0000119>
        <obo:OAE_0001849>射精失败</obo:OAE_0001849>
        <obo:OAE_0004334>10014328</obo:OAE_0004334>
        <rdfs:label>ejaculation failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008587 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is pain during menstruation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysmenorrhea</obo:IAO_0000119>
        <obo:OAE_0001849>痛经</obo:OAE_0001849>
        <obo:OAE_0004334>10013935</obo:OAE_0004334>
        <rdfs:label>dysmenorrhoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008588 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is an infection and inflammation in the Fallopian tubes (salpinges).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Salpingitis</obo:IAO_0000119>
        <obo:OAE_0001849>输卵管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10039453</obo:OAE_0004334>
        <rdfs:label>salpingitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the ovaries with salpingo.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oophoritis</obo:IAO_0000119>
        <obo:OAE_0001849>输卵管卵巢炎</obo:OAE_0001849>
        <obo:OAE_0004334>10049677</obo:OAE_0004334>
        <rdfs:label>salpingo-oophoritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008590 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is still common cause of maternal morbidity and mortality, and is still a major challenge in gynaecological practice.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28718242/</obo:IAO_0000119>
        <obo:OAE_0001849>输卵管破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10067553</obo:OAE_0004334>
        <rdfs:label>tubal rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008591 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the most common endocrine disorder in women of reproductive age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polycystic_ovary_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>多囊卵巢</obo:OAE_0001849>
        <obo:OAE_0004334>10036049</obo:OAE_0004334>
        <rdfs:label>polycystic ovaries AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008592 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is defined as having serologic proof of infection without symptoms of disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Syphilis#Latent</obo:IAO_0000119>
        <obo:OAE_0001849>潜伏梅毒</obo:OAE_0001849>
        <obo:OAE_0004334>10070738</obo:OAE_0004334>
        <rdfs:label>latent syphilis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008593 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is due to problems with either the hypothalamus or pituitary gland affecting the hypothalamic-pituitary-gonadal axis (HPG axis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypogonadotropic_hypogonadism</obo:IAO_0000119>
        <obo:OAE_0001849>继发性性腺机能减退</obo:OAE_0001849>
        <obo:OAE_0004334>10059594</obo:OAE_0004334>
        <rdfs:label>secondary hypogonadism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008594 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a sexually transmitted infection caused by the bacterium Treponema pallidum subspecies pallidum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Syphilis</obo:IAO_0000119>
        <obo:OAE_0001849>梅毒</obo:OAE_0001849>
        <obo:OAE_0004334>10062120</obo:OAE_0004334>
        <rdfs:label>syphilis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008595 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000485"/>
        <obo:IAO_0000115>This is an AE which is a pregnancy in which the embryo never develops or develops and is reabsorbed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blighted_ovum</obo:IAO_0000119>
        <obo:OAE_0001849>萎亡孕卵</obo:OAE_0001849>
        <obo:OAE_0004334>10005160</obo:OAE_0004334>
        <rdfs:label>blighted ovum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008596 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is the type of sexual dysfunction in which the penis fails to become or stay erect during sexual activity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erectile_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>器质性勃起功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10052004</obo:OAE_0004334>
        <rdfs:label>organic erectile dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008597 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002653"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels on postmenopausal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>绝经后出血</obo:OAE_0001849>
        <obo:OAE_0004334>10055870</obo:OAE_0004334>
        <rdfs:label>postmenopausal hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008598 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is a severe and disabling form of premenstrual syndrome affecting 1.8–5.8% of menstruating women.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Premenstrual_dysphoric_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>经前综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10051537</obo:OAE_0004334>
        <rdfs:label>premenstrual dysphoric disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is the symptom of pain in the face, head, or neck on the premenstrual .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Headache</obo:IAO_0000119>
        <obo:OAE_0001849>经前头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10049122</obo:OAE_0004334>
        <rdfs:label>premenstrual headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008600 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which refers to emotional and physical symptoms that regularly occur in the one to two weeks before the start of each menstrual period.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Premenstrual_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>经前综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10036618</obo:OAE_0004334>
        <rdfs:label>premenstrual syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008601 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001887"/>
        <obo:IAO_0000115>This is an AE which occurs when a man expels semen (and most likely experiences orgasm) soon after beginning sexual activity, and with minimal penile stimulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Premature_ejaculation</obo:IAO_0000119>
        <obo:OAE_0001849>早泄</obo:OAE_0001849>
        <obo:OAE_0004334>10036596</obo:OAE_0004334>
        <rdfs:label>premature ejaculation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008602 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which occurs when a man expels semen (and most likely experiences orgasm) soon after beginning sexual activity, and with minimal penile stimulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Premature_ejaculation</obo:IAO_0000119>
        <obo:OAE_0001849>包含结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10021629</obo:OAE_0004334>
        <rdfs:label>inclusion conjunctivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008603 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the ridged band of the akroposthion of the foreskin of the penis cannot stretch to allow it to be pulled back past the glans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phimosis</obo:IAO_0000119>
        <obo:OAE_0001849>包皮过长</obo:OAE_0001849>
        <obo:OAE_0004334>10034878</obo:OAE_0004334>
        <rdfs:label>phimosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008604 -->


