    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008838 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of a body part or organ compared to the normal shape of that part such as thorax part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>畸形胸</obo:OAE_0001849>
        <obo:OAE_0004334>10061810</obo:OAE_0004334>
        <rdfs:label>deformity thorax AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008839 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening medical condition that occurs when a segment of the rib cage breaks due to trauma and becomes detached from the rest of the chest wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Flail_chest</obo:IAO_0000119>
        <obo:OAE_0001849>连枷胸</obo:OAE_0001849>
        <obo:OAE_0004334>10016747</obo:OAE_0004334>
        <rdfs:label>flail chest AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008840 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008840">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is an accumulation of blood within the pleural cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemothorax</obo:IAO_0000119>
        <obo:OAE_0001849>血胸</obo:OAE_0001849>
        <obo:OAE_0004334>10019027</obo:OAE_0004334>
        <rdfs:label>haemothorax AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008841 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is accumulation of excessive fluid in the pleural space, the potential space that surrounds each lung.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pleural_effusion#Transudative</obo:IAO_0000119>
        <obo:OAE_0001849>胸膜积水</obo:OAE_0001849>
        <obo:OAE_0004334>10048612</obo:OAE_0004334>
        <rdfs:label>hydrothorax AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008842 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is accumulation of excessive fluid in the pleural space, the potential space that surrounds each lung and is infectious.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pleural_effusion</obo:IAO_0000119>
        <obo:OAE_0001849>传染性胸膜积液</obo:OAE_0001849>
        <obo:OAE_0004334>10071699</obo:OAE_0004334>
