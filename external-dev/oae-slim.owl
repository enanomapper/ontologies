    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008060 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which is a group of conditions that includes cleft lip, cleft palate, and both together.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cleft_lip_and_cleft_palate</obo:IAO_0000119>
