    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002586 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>a tumor AE that shows a benign or malignant neoplasm that affects the peritoneal cavity.</obo:IAO_0000115>
