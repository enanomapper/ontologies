        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a quarterly peer-reviewed medical journal that covers research in the field of respiratory disease, including chronic obstructive pulmonary disease, respiratory failure, and obstructive sleep apnea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_Respiratory_Disease</obo:IAO_0000119>
