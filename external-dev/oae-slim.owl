        <obo:OAE_0004334>10018046</obo:OAE_0004334>
        <rdfs:label>gastroschisis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004609 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000616"/>
        <obo:IAO_0000115>This is an AE which is the condition of having at least three loose, liquid, or watery bowel movements each day and causes by  the viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diarrhea</obo:IAO_0000119>
