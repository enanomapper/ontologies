    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007262 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000883"/>
        <obo:IAO_0000115>This is an AE which is the stream of consciousness that detaches from current, external tasks when attention drifts to a more personal and internal direction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Daydream</obo:IAO_0000119>
