    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007254 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is an acute vigorous local inflammatory reaction following vaccination.</obo:IAO_0000115>
