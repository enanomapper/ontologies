        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10037871</obo:OAE_0004334>
