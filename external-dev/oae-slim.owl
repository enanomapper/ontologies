    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004901 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the brain caused by meningococcal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
