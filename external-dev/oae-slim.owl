    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115 xml:lang="en">a respiratory system AE which has an outcome of abnormal respiration, an anomaly in the movement of gases into and out of the lung</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;respiratory disorder&apos; is an adverse event that was mentioned in 556 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000116>Not sure if it is same as respiratory system disorder or abnormal respiration. --Oliver He</obo:IAO_0000116>
        <rdfs:label>abnormal respiration AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001943</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000572 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal respiration AE which has an outcome of apnea, temporary cessation of breathing; sometimes episodic</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;apnea&apos; is an adverse event that was mentioned in 1,618 VAERS reports (1.3%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>JX, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>MedDRA: 10002974 is for &quot;apnoea&quot;; MedDRA: 10002972  is for &quot;apnea&quot;.</obo:IAO_0000118>
        <obo:IAO_0000118>apnoea AE</obo:IAO_0000118>
        <obo:IAO_0000118>respiratory arrest AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/apnea</obo:IAO_0000119>
        <rdfs:label>apnea AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13306</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001957</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C26698</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS CUI: C0003578</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000573 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115 xml:lang="en">an ear disorder AE which has an outcome of deafness, which is an inability to hear</obo:IAO_0000115>
        <obo:OAE_0004334>10011878</obo:OAE_0004334>
        <rdfs:label>deafness AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000365</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001967</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011053</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000574 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <obo:IAO_0000115 xml:lang="en">an adverse event that occurs in a gustatory system</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
        <rdfs:label>gustatory system AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001985</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000575 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115 xml:lang="en">a gustatory system AE which has an outcome of taste sensitivity, or changes in the ability to perceive a particular flavor or suggestion of something imparting a flavor by the chemoreceptors of the gustatory system</obo:IAO_0000115>
        <rdfs:label>taste sensitivity AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001986</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000576 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115 xml:lang="en">a urinary system AE that has an outcome of excessive or abnormally large production or passage of urine.</obo:IAO_0000115>
        <obo:IAO_0000117>LW, ML, JX, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polyuria</obo:IAO_0000119>
        <obo:OAE_0001849>多尿</obo:OAE_0001849>
        <obo:OAE_0004334>10036142</obo:OAE_0004334>
        <rdfs:label xml:lang="en">polyuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000577 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal vision AE which has an outcome of blindness, which is loss of the sense of sight</obo:IAO_0000115>
        <obo:OAE_0004334>10005169</obo:OAE_0004334>
        <rdfs:label>blindness AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000618</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002001</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0456909</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000578 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115 xml:lang="en">an eye disorder AE which has an outcome of abnormal vision, which is an inability or decreased ability to see</obo:IAO_0000115>
        <rdfs:label>abnormal vision AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002090</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000579 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115 xml:lang="en">a behavior and neurological AE that shows a sudden surge of electrical activity in the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthline.com/symptom/seizures</obo:IAO_0000119>
        <obo:OAE_0001849>突然发作</obo:OAE_0001849>
        <obo:OAE_0004334>10039906</obo:OAE_0004334>
        <obo:OAE_0004334>10039910</obo:OAE_0004334>
        <rdfs:label>seizure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12804</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002064</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C2962</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000580 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <obo:IAO_0000115>an adverse event that has an outcome of an abnormal behavior and neurological phenotype.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
        <obo:IAO_0000118>behavior AE</obo:IAO_0000118>
        <obo:IAO_0000118>behavioral AE</obo:IAO_0000118>
        <obo:IAO_0000118>behavioral disorder AE</obo:IAO_0000118>
        <obo:IAO_0000118>disruptive behavioral disorder AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.psychguides.com/guides/behavioral-disorder-symptoms-causes-and-effects/</obo:IAO_0000119>
        <rdfs:comment xml:lang="en">any anomaly in the actions, reactions, or performance of an organism in response to external or internal stimuli compared to controls</rdfs:comment>
        <rdfs:label>behavioral and neurological AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0004924</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000581 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115 xml:lang="en">a behavior and neurological AE that has an outcome of altered ability to coordinate voluntary movement or repetitive, compulsive movements</obo:IAO_0000115>
        <obo:OAE_0004334>10028035</obo:OAE_0004334>
        <rdfs:label>movement disorder AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100022</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002066</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026650</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000582 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <rdfs:comment xml:lang="en">a behavior and neurological AE that has an outcome of inability or altered ability to respond to a sensory stimulus</rdfs:comment>
        <rdfs:label>sensory capability AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002067</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000583 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <obo:IAO_0000115 xml:lang="en">a homeostasis AE which has an outcome of glucose homeostasis, which is an anomaly in the processes involved in the maintenance of an internal equilibrium of glucose in the fluids and tissues</obo:IAO_0000115>
        <rdfs:label>glucose homeostasis AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002078</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000584 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>Hypersensitivity AE is a immune system AE that is a set of undesirable reactions produced by the normal immune system, including allergies and autoimmunity. These reactions may be damaging, uncomfortable, or occasionally fatal.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hypersensitivity reaction AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypersensitivity</obo:IAO_0000119>
        <obo:OAE_0001849>超敏反应</obo:OAE_0001849>
        <obo:OAE_0004334>10020751</obo:OAE_0004334>
        <rdfs:label>hypersensitivity AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100326</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002148</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020517</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000585 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">a muscle adverse event AE which has an outcome of muscular atrophy. </rdfs:comment>
        <rdfs:comment>Muscle atrophy is a wasting of muscle tissue resulting in a derangement of the muscle fibers; occurs with age, immobilization, weightlessness, malnutrition or denervation.</rdfs:comment>
        <rdfs:label>muscular atrophy AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002269</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000586 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal respiration AE which has an outcome of hyperventilation, i.e., increased alveolar ventilation relative to metabolic carbon dioxide production; results in carbon dioxide pressure decreasing below normal</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;Petechiae&apos; was mentioned in 510 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:OAE_0004334>10020910</obo:OAE_0004334>
        <rdfs:label>hyperventilation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002883</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002320</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020578</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000587 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal respiration AE which has an outcome of hypoventilation, i.e., reduced alveolar ventilation relative to metabolic carbon dioxide production; results in alveolar carbon dioxide pressure increasing above normal</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;hypoventilation&apos; is an adverse event that was mentioned in 321 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>QL, YH</obo:IAO_0000117>
        <obo:IAO_0000118>respiratory depression AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: https://en.wikipedia.org/wiki/Hypoventilation</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸抑制</obo:OAE_0001849>
        <obo:OAE_0004334>10021133</obo:OAE_0004334>
        <obo:OAE_0004334>10038678</obo:OAE_0004334>
        <rdfs:label>hypoventilation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0007110</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002321</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0398353</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000588 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <obo:IAO_0000115 xml:lang="en">an adverse event which occurs in a hematopoietic system, which is any structural or developmental anomaly of the blood cells or the organs associated with the development and formation of blood cells</obo:IAO_0000115>
        <rdfs:label>hematopoietic system AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002396</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115 xml:lang="en">an eye disorder AE which has an outcome of mydriasis, which is dilation of one or both pupils regardless of light conditions</obo:IAO_0000115>
        <obo:OAE_0004334>10028521</obo:OAE_0004334>
        <rdfs:label>mydriasis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011499</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002546</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026961</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000590 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115 xml:lang="en">an arrhythmia AE that has an outcome of greater than average resting heart beats per minute, usually measured by the number of times the heart ventricles contract per unit of time, usually per minute</obo:IAO_0000115>
        <obo:IAO_0000118>tachycardia</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tachycardia</obo:IAO_0000119>
        <obo:OAE_0004334>10019303</obo:OAE_0004334>
        <rdfs:label>increased heart rate AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002626</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000591 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115 xml:lang="en">a behavior and neurological AE that has an outcome of exaggerated reflex action</obo:IAO_0000115>
        <rdfs:label>hyperresponsive to tactile stimuli AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002738</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000592 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>a muscle spasm AE that has an outcome of opisthotonus</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:OAE_0004334>10030899</obo:OAE_0004334>
        <rdfs:comment xml:lang="en">opisthotonus is a form of tetanic spasm in which the head, neck and spine are bent backward and the body is bowed forward</rdfs:comment>
        <rdfs:label>opisthotonus AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002179</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002880</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151818</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000593 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115 xml:lang="en">An joint disorder AE that has an outcome of joint inflammation, which is local accumulation of fluid, plasma proteins, and leukocytes in the joints</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label>joint inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002933</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000594 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000620"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal enzyme level AE which has an outcome of incraesed lactate dehydrogenase level, which is greater than the normal concentration of this enzyme, which catalyzes the interconversion of lactate and pyruvate</obo:IAO_0000115>
        <rdfs:label>increased lactate dehydrogenase level AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002944</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000595 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000620"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal enzyme level AE which has an outcome of increased circulating alkaline phophatase level, which is an elevated activity of this enzyme, which hydrolyzes orthophosphoric monoesters, found in the blood</obo:IAO_0000115>
        <rdfs:label>increased circulating alkaline phosphatase level AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002968</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000596 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000593"/>
        <obo:IAO_0000115 xml:lang="en">A joint inflammation AE that has an outcome of arthritis, marked by changes in the synovial membranes and thickening of articular structures, widespread degeneration of the collagen fibers in connective tissues, and by atrophy and rarefaction of bony structures</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <obo:OAE_0001849>关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10003246</obo:OAE_0004334>
        <rdfs:label>arthritis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12378</rdfs:seeAlso>
        <rdfs:seeAlso>HPO: HP_0001369</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002993</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C2883</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003864</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000597 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115 xml:lang="en">a digestive system AE which has an outcome of dysphagia, which is a behavior and neurological AE that has an outcome of difficulty in swallowing food or liquid</obo:IAO_0000115>
        <obo:OAE_0004334>10013950</obo:OAE_0004334>
        <rdfs:label>dysphagia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10621</rdfs:seeAlso>
        <rdfs:seeAlso>HPO: HP_0002015</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003158</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C2980</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011168</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000598 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115 xml:lang="en">an ear disorder AE which has an outcome of decreased lateral semicircular canal size, which is small size of the lateral long bony tube of the labyrinth that is involved in the sense of balance</obo:IAO_0000115>
        <rdfs:label>decreased lateral semicircular canal size AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0003162</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001731"/>
        <obo:IAO_0000115 xml:lang="en">a hematopoietic system AE which has an outcome of decreased platelet count, which is fewer than the normal numbers of the non-nucleated cells found in the blood and involved in blood coagulation</obo:IAO_0000115>
        <obo:IAO_0000117>SS, YH</obo:IAO_0000117>
        <obo:IAO_0000118>decreased platelet cell number AE</obo:IAO_0000118>
