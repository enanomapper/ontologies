        <rdfs:label>gastroduodenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005598 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000593"/>
        <obo:IAO_0000115>This is an AE which is a disease of a joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arthropathy</obo:IAO_0000119>
        <obo:OAE_0001849>肠病发性脊柱炎</obo:OAE_0001849>
