        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 gamma-glutamyltransferase level increased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12165</rdfs:seeAlso>
