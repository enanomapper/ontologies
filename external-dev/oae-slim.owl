    <!-- http://purl.obolibrary.org/obo/OAE_0007604 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003415"/>
        <obo:IAO_0000115>This is an AE which is the leading cause of evaporative dry eye disease and is one of the most common conditions encountered by eye care providers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
