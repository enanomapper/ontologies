    <!-- http://purl.obolibrary.org/obo/OAE_0003552 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000544"/>
        <obo:IAO_0000115>an abnormal gait AE that has mild change in gait (e.g., wide-based, limping or hobbling)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 abnormal gait AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11113</rdfs:seeAlso>
    </owl:Class>
    


