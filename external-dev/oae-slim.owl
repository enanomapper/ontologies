    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007120 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by the parasite Trichomonas vaginalis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trichomoniasis</obo:IAO_0000119>
