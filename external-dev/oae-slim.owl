        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>听力受损</obo:OAE_0001849>
        <obo:OAE_0004334>10019245</obo:OAE_0004334>
        <rdfs:label>hearing impaired AE</rdfs:label>
    </owl:Class>
    


