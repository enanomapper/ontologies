    <!-- http://purl.obolibrary.org/obo/OAE_0006960 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004447"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the kidneys caused by systemic lupus erythematosus (SLE), an autoimmune disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lupus_nephritis</obo:IAO_0000119>
