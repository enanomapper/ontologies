        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is pathological conditions with allergic affecting the organs and tissues that make gas exchange difficult in air-breathing animals.</obo:IAO_0000115>
