    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002439"/>
        <obo:IAO_0000115>an irregular menstruation AE that has intermittent menses with skipped menses for more than 4 to 6 months</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 irregular menstruation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13127</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002924 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002439"/>
        <obo:IAO_0000115>an irregular menstruation AE that has persistent amenorrhea for more than 6 months</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 irregular menstruation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13128</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002925 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002789"/>
        <obo:IAO_0000115>a lactation disorder AE that has mild changes in lactation, not significantly affecting production or expression of breast milk</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 lactation disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13130</rdfs:seeAlso>
    </owl:Class>
    


