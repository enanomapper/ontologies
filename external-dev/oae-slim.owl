        <obo:OAE_0004334>10047370</obo:OAE_0004334>
        <rdfs:label>vesicoureteric reflux AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005837 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>This is an AE which includes urinary bladder inflammation such as cystitis, bladder rupture and bladder obstruction (tamponade).</obo:IAO_0000115>
