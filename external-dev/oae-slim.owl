    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000616"/>
        <obo:IAO_0000115>This is an AE which is the condition of having at least three loose, liquid, or watery bowel movements each day and occurs on the neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diarrhea</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿腹泻</obo:OAE_0001849>
