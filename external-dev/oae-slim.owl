    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008553 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the head of the penis curves downward or upward, at the junction of the head and shaft of the penis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
