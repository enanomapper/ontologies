    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008570 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the adnexa uteri, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>附件子宫囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10050203</obo:OAE_0004334>
        <rdfs:label>adnexa uteri cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008571 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is the structures most closely related structurally and functionally to the uterus and it has  mass.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uterine_appendages</obo:IAO_0000119>
        <obo:OAE_0001849>附件子宫肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10058897</obo:OAE_0004334>
        <rdfs:label>adnexa uteri mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008572 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is the structures most closely related structurally and functionally to the uterus and it feel pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uterine_appendages</obo:IAO_0000119>
        <obo:OAE_0001849>附件子宫痛</obo:OAE_0001849>
        <obo:OAE_0004334>10058841</obo:OAE_0004334>
