    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004602 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000402"/>
        <obo:IAO_0000115>This is an AE which is a rare condition characterized by abdominal pain attributed to compression of the celiac artery and the celiac ganglia by the median arcuate ligament.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Median_arcuate_ligament_syndrome</obo:IAO_0000119>
