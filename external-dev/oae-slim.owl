    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <obo:IAO_0000115>Persistent nausea AE is a nausea AE that shows constant nausea. Nausea is considered &quot;persistent&quot; if it continues for more than 2 days, or keeps recurring even after treatment.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
