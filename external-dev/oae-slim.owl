        <rdfs:seeAlso>HPO: HP_0007239</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C26920</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085584</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000495 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>a urinary system AE that has an outcome of urine abnormality AE</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label>urine abnormality AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011036</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0235639</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000496 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>a gastrointestinal disorder AE which has an outcome of gastroenteritis, an inflammation occuring in the gastrointestinal tract that involves both the stomach and the small intestine, often results in diarrhea, vomiting and abdominal pain and cramping</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;gastroenteritis&apos; was mentioned in 218 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/gastroenteritis</obo:IAO_0000119>
        <obo:OAE_0004334>10017888</obo:OAE_0004334>
        <rdfs:label>gastroenteritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004386</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0017160</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000497 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
