    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>肌肉不适</obo:OAE_0001849>
        <obo:OAE_0004334>10028299</obo:OAE_0004334>
