        <obo:OAE_0004334>10079330</obo:OAE_0004334>
        <rdfs:label>ovarian injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008438 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a form of cell injury which results in the premature death of cells in living tissue by autolysis such as ovarian necrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10033270</obo:OAE_0004334>
        <rdfs:label>ovarian necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008439 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of ovarian tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061535</obo:OAE_0004334>
        <rdfs:label>ovarian neoplasm AE</rdfs:label>
    </owl:Class>
    


