        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is an uncommon but distinctive acquired ichthyosiform dermatosis characterized by persistent dark, scaly, papules and plaques that tend to be localized predominantly on the central trunk.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
