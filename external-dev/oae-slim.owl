    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008972 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008972">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the neonatal skin which affects its color, appearance, or texture.</obo:IAO_0000115>
