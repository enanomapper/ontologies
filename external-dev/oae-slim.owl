    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008780 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
