    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004593 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <obo:IAO_0000115>This is an AE which a functional abnormality or disturbance occurs on the abdominal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Disorder</obo:IAO_0000119>
