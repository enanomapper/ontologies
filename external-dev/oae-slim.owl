    <!-- http://purl.obolibrary.org/obo/OAE_0001571 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001297"/>
        <obo:IAO_0000115>an atrioventricular block AE that some but not all atrial impulses fail to reach the ventricles, thus some ventricular beats are dropped. Electrical signals between the atria and ventricles are slowed to a large degree. Some signals don&apos;t reach the ventricles. On an EKG, the pattern of QRS waves doesn&apos;t follow each P wave as it normally would.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>atrioventricular block second degree</obo:IAO_0000118>
        <obo:IAO_0000118>second degree heart block</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=10751
WEB: http://www.nhlbi.nih.gov/health//dci/Diseases/hb/hb_types.html</obo:IAO_0000119>
        <obo:OAE_0004334>10003677</obo:OAE_0004334>
        <rdfs:label>second degree atrioventricular block AE</rdfs:label>
    </owl:Class>
    


