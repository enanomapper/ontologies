    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002061"/>
        <obo:IAO_0000115>This is an AE which can be measured locoregionally to produce a map of systolic activity that reproduces the complex way in which the ventricle contracts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31005299/</obo:IAO_0000119>
        <obo:OAE_0001849>心肌劳损</obo:OAE_0001849>
        <obo:OAE_0004334>10066954</obo:OAE_0004334>
        <rdfs:label>myocardial strain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005111 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002656"/>
        <obo:IAO_0000115>This is an AE which during thoracic surgery can have profound hemodynamic consequences and lead to devastating neurologic injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27871599/</obo:IAO_0000119>
        <obo:OAE_0001849>上腔静脉阻塞</obo:OAE_0001849>
        <obo:OAE_0004334>10058988</obo:OAE_0004334>
        <rdfs:label>superior vena caval occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005112 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a devastating neurological disease for which there is no effective therapy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/1434509/</obo:IAO_0000119>
        <obo:OAE_0001849>高血糖症</obo:OAE_0001849>
        <obo:OAE_0004334>10080883</obo:OAE_0004334>
        <rdfs:label>hyperglycinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005113 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a fluid-filled space surrounding certain blood vessels in several organs, including the brain,potentially having an immunological function, but more broadly a dispersive role for neural and blood-derived messengers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perivascular_space</obo:IAO_0000119>
        <obo:OAE_0001849>大脑血管周围间隙扩大</obo:OAE_0001849>
        <obo:OAE_0004334>10068734</obo:OAE_0004334>
        <rdfs:label>enlarged cerebral perivascular spaces AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005114 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders that destroy blood vessels by inflammation and it is diffuse.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>弥散性血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10012978</obo:OAE_0004334>
        <rdfs:label>diffuse vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005115 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders with with necrotising that destroy blood vessels by inflammation .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>血管炎坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10047124</obo:OAE_0004334>
        <rdfs:label>vasculitis necrotising AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005116 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <obo:IAO_0000115>This is an AE which is a mechanical occlusion of the extracranial vertebral artery(VA)due to physiological movement of the head and neck.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33353881/</obo:IAO_0000119>
        <obo:OAE_0001849>椎动脉闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10048965</obo:OAE_0004334>
        <rdfs:label>vertebral artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005117 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which injury to the large or small intestine occurs due to not enough blood supply.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intestinal_ischemia</obo:IAO_0000119>
        <obo:OAE_0001849>血管功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10054880</obo:OAE_0004334>
        <rdfs:label>vascular insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005118 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which is a muscular organ in most animals, which pumps blood through the blood vessels of the circulatory system and  heart is feel discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heart</obo:IAO_0000119>
        <obo:OAE_0001849>心脏不舒服</obo:OAE_0001849>
        <obo:OAE_0004334>10054211</obo:OAE_0004334>
        <rdfs:label>cardiac discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005119 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing in which connective tissue replaces normal arterial parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>动脉纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10054793</obo:OAE_0004334>
        <rdfs:label>arterial fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005120 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a rare complication in angiosarcoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23542097/</obo:IAO_0000119>
        <obo:OAE_0001849>心房破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10048761</obo:OAE_0004334>
        <rdfs:label>atrial rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005121 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001120"/>
        <obo:IAO_0000115>This is an AE which is a syndrome defined as the new onset (de novo heart failure (HF)) or worsening (acutely decompensated heart failure (ADHF)) of symptoms and signs of HF, mostly related to systemic congestion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32139695/</obo:IAO_0000119>
        <obo:OAE_0001849>急性左心室衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10063081</obo:OAE_0004334>
        <rdfs:label>acute left ventricular failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005122 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is a type of respiratory failure characterized.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_respiratory_distress_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸窘迫</obo:OAE_0001849>
        <obo:OAE_0004334>10049874</obo:OAE_0004334>
        <rdfs:label>cardio-respiratory distress AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005123 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002577"/>
        <obo:IAO_0000115>This is an AE which is a usually benign vascular tumor derived from blood liver vessel cell types.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
