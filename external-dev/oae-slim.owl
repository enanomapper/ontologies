        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000882"/>
        <obo:IAO_0000115>a disseminated intravascular coagulation AE that has laboratory findings with no bleeding</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 disseminated intravascular coagulation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10029</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003632 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000882"/>
        <obo:IAO_0000115>a disseminated intravascular coagulation AE that has laboratory findings and bleeding</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 disseminated intravascular coagulation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10030</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003633 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000908"/>
        <obo:IAO_0000115>an ejection fraction decreased AE where the resting ejection fraction (EF) 50 - 40%; 10 - 19% drop from baseline</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 ejection fraction decreased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12143</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003634 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000908"/>
        <obo:IAO_0000115>an ejection fraction decreased AE where the resting ejection fraction (EF) 39 - 20%; greater than 20% drop from baseline</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 ejection fraction decreased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12144</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003635 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000908"/>
        <obo:IAO_0000115>an ejection fraction decreased AE where the resting ejection fraction (EF) less than 20%</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 ejection fraction decreased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12145</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003636 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000911"/>
        <obo:IAO_0000115>an electrocardiogram qt prolonged AE where the QTc 450 - 480 ms</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 electrocardiogram qt prolonged AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12147</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003637 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000911"/>
        <obo:IAO_0000115>an electrocardiogram qt prolonged AE where the QTc 481 - 500 ms</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 electrocardiogram qt prolonged AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12148</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003638 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000911"/>
        <obo:IAO_0000115>an electrocardiogram qt prolonged AE where the QTc is greater than or equal to 501 ms on at least two separate ECGs</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 electrocardiogram qt prolonged AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12149</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003639 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000911"/>
        <obo:IAO_0000115>an electrocardiogram qt prolonged AE where the QTc is greater than or equal to 501 or greater than 60 ms change from baseline and Torsade de pointes or polymorphic ventricular tachycardia or signs/symptoms of serious arrhythmia</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 electrocardiogram qt prolonged AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12150</rdfs:seeAlso>
    </owl:Class>
    


