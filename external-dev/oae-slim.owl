        <rdfs:seeAlso>MP: MP_0004143</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026826</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000612 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal muscle tone AE which has an outcome of hypotonia, which is decreased muscle tension resulting in limpness of the muscles in the resting state, not to be confused with weakness</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
