    <!-- http://purl.obolibrary.org/obo/OAE_0002589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002577"/>
