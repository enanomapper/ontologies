        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 anemia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10011</rdfs:seeAlso>
    </owl:Class>
    


