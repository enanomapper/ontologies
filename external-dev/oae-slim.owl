        <rdfs:seeAlso>CTCAE: E10572</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0005036</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000617 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <obo:IAO_0000115 xml:lang="en">a homeostasis AE which has an outcome of hypoxia, which is a reduced concentration of O2 in the blood, alveoli or other tissues resulting in the decreased pressure of this component of body gases</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hypoxia</obo:IAO_0000119>
        <obo:OAE_0004334>10021143</obo:OAE_0004334>
        <rdfs:label>hypoxia AE</rdfs:label>
