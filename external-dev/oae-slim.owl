        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004226"/>
        <obo:IAO_0000115>This is an AE which is the low output of urine specifically more than 80 ml/day but less than 100ml/day.</obo:IAO_0000115>
