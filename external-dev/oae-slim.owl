        <obo:OAE_0004334>10077605</obo:OAE_0004334>
        <rdfs:label>anal incontinence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005715 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is the invasion of anal by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>肛门感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061628</obo:OAE_0004334>
        <rdfs:label>anal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005716 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of anal to harmful stimuli, such as pathogens, damaged cells, or irritants,and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
