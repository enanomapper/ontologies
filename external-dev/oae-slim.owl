        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is the process by which gases move passively by diffusion across a surface on respiratory process occured problem .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gas_exchange</obo:IAO_0000119>
