        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which  is a connective tissue disorder involving the growth of fibrous plaques in the soft tissue of the penis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peyronie%27s_disease</obo:IAO_0000119>
