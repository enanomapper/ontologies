        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a rare, fluid-filled neuroglial cavity within the spinal cord (syringomyelia), in the brain stem (syringobulbia), or in the nerves of the elbow, usually in a young age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
