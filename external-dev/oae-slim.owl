    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115 xml:lang="en">a digestive system AE which has an outcome of stomatitis, which is an inflammation of the mucous lining of the mouth</obo:IAO_0000115>
