        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Symptomatic hypotension AE is a hypotension AE that shows blood pressure that less than 90/60 mm Hg with dizziness, vertigo etc.</obo:IAO_0000115>
