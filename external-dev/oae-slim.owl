        <obo:IAO_0000115>an irregular menstruation AE that has intermittent menses with skipped menses for no more than 1 to 3 months</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 irregular menstruation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13126</rdfs:seeAlso>
    </owl:Class>
    


