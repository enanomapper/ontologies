    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008298 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000762"/>
        <obo:IAO_0000115>This is an AE which is cancer that develops from breast tissue and occurs invasive ductal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Breast_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>浸润性导管乳腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10073095</obo:OAE_0004334>
        <rdfs:label>invasive ductal breast carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008299 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000762"/>
        <obo:IAO_0000115>This is an AE which is cancer that develops from breast tissuec and is hormone refractory .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Breast_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>激素难治性乳腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10076935</obo:OAE_0004334>
        <rdfs:label>hormone refractory breast cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008300 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is defined as an endometrium of &gt; 5 mm discovered on ultrasound in a postmenopausal woman who is not bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29731210/</obo:IAO_0000119>
        <obo:OAE_0001849>子宫内膜增厚</obo:OAE_0001849>
        <obo:OAE_0004334>10056432</obo:OAE_0004334>
        <rdfs:label>endometrial thickening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008301 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>This is an AE which is the medical use of probes called sounds to increase the inner diameter of the urethra and to locate obstructions in it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urethral_sounding</obo:IAO_0000119>
        <obo:OAE_0001849>尿道扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10046442</obo:OAE_0004334>
        <rdfs:label>urethral dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008302 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the partial or total loss of reproductive and hormonal function of the ovaries before age 40 because of folliclular (egg producing area) dysfunction or early loss of eggs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_ovarian_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10033165</obo:OAE_0004334>
        <rdfs:label>ovarian failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008303 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004247"/>
        <obo:IAO_0000115>This is an AE which refers a band of coagulative necrosis at the choriodecidual interphase, is a histologic lesion of unclear pathogenesis that has been reported in placentas from preeclampsia, preterm premature rupture of membranes, and preterm abruption.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15702362/</obo:IAO_0000119>
        <obo:OAE_0001849>胎盘坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10035139</obo:OAE_0004334>
        <rdfs:label>placental necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008304 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the vaginal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>阴道脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10049573</obo:OAE_0004334>
        <rdfs:label>vaginal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008305 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which might accurately reflect an acidotic state in the vaginal synapses and perineural space.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>阴道灼热感</obo:OAE_0001849>
        <obo:OAE_0004334>10050023</obo:OAE_0004334>
        <rdfs:label>vaginal burning sensation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008306 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is an extraordinarily rare form of cancer that develops in the tissue of the vagina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginal_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>阴道癌</obo:OAE_0001849>
        <obo:OAE_0004334>10046885</obo:OAE_0004334>
        <rdfs:label>vaginal cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008307 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is excessive growth of yeast in the vagina that results in irritation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginal_yeast_infection</obo:IAO_0000119>
        <obo:OAE_0001849>阴道念珠菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10046898</obo:OAE_0004334>
        <rdfs:label>vaginal candidiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008308 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a pathological condition that affects part or all of the vagina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginal_disease</obo:IAO_0000119>
        <obo:OAE_0001849>阴道紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10061402</obo:OAE_0004334>
        <rdfs:label>vaginal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008309 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth or development of cells (microscopic scale) and/or organs (macroscopic scale), and/or the abnormal histology or anatomical structure presumably resulting from such growth such as vaginal dysplasia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>阴道发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10046905</obo:OAE_0004334>
        <rdfs:label>vaginal dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008310 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is an emission or expulsion of air from the vagina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaginal_flatulence</obo:IAO_0000119>
        <obo:OAE_0001849>阴道胀气</obo:OAE_0001849>
        <obo:OAE_0004334>10064227</obo:OAE_0004334>
