    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004740 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000168"/>
        <obo:IAO_0000115>This is an AE which is a variant of Guillain–Barré syndrome. It is characterized by acute paralysis and loss of reflexes without sensory loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_motor_axonal_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>急性运动轴突神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10076658</obo:OAE_0004334>
        <rdfs:label>acute motor axonal neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004741 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000168"/>
        <obo:IAO_0000115>This is an AE which is a variant of Guillain–Barré syndrome. It is characterized by acute paralysis and loss of reflexes without sensory loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_motor_axonal_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>急性运动感觉轴突神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10076657</obo:OAE_0004334>
        <rdfs:label>acute motor-sensory axonal neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004742 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000169"/>
        <obo:IAO_0000115>This is an AE which is acute  damage or disease affecting peripheral nerves (peripheral neuropathy) in roughly the same areas on both sides of the body, featuring weakness, numbness, and burning pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyneuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>急性多神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10066699</obo:OAE_0004334>
        <rdfs:label>acute polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004743 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is an area of swelling (edema) of the lower layer of skin and tissue just under the skin or mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angioedema</obo:IAO_0000119>
        <obo:OAE_0001849>血管神经性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10002473</obo:OAE_0004334>
        <rdfs:label>angioneurotic edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004744 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000396"/>
        <obo:IAO_0000115>This is an AE which is an eating disorder characterized by low weight, food restriction, body image disturbance, fear of gaining weight, and an overpowering desire to be thin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anorexia_nervosa</obo:IAO_0000119>
        <obo:OAE_0001849>神经性厌食症</obo:OAE_0001849>
        <obo:OAE_0004334>10002649</obo:OAE_0004334>
        <rdfs:label>anorexia nervosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004745 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>This is an AE which sometimes called autoimmune  neuritis, may be a forme fruste of systemic lupus erythematosus (SLE) associated  neuropathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_optic_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10070439</obo:OAE_0004334>
        <rdfs:label>autoimmune neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004746 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>This is an AE which is a single autonomic seizure lasting between 2+ to 5+ minutes or two or more seizures within a five-minute period without the person returning to normal between them.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Status_epilepticus</obo:IAO_0000119>
        <obo:OAE_0001849>自主神经发作</obo:OAE_0001849>
        <obo:OAE_0004334>10049612</obo:OAE_0004334>
        <rdfs:label>autonomic seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004747 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a nerve of the human body, that originates from the brachial plexus (upper trunk, posterior division, posterior cord) at the level of the axilla (armpit) and carries nerve fibers from C5 and C6 which it maybe  get injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Axillary_nerve</obo:IAO_0000119>
        <obo:OAE_0001849>腋神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10003879</obo:OAE_0004334>
        <rdfs:label>axillary nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004748 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000169"/>
        <obo:IAO_0000115>This is an AE which is damage or disease affecting peripheral nerves (peripheral neuropathy) in roughly the same areas on both sides of the axonal and demyelinating body, featuring weakness, numbness, and burning pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyneuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>轴突和脱髓鞘性多发性神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10084153</obo:OAE_0004334>
        <rdfs:label>axonal and demyelinating polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004749 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>This is an AE which is a rare, autosomal recessive[1] neurological disorder that causes disorganization of neurofilaments.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Giant_axonal_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>轴突神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10003882</obo:OAE_0004334>
        <rdfs:label>axonal neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004750 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000797"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the  central nervous system caused by bacterial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>中枢神经系统细菌性脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10004015</obo:OAE_0004334>
        <rdfs:label>bacterial abscess central nervous system AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004751 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a group of physical problems that occur when the group of nuclei in the brain known as the basal ganglia fail to properly suppress unwanted movements or to properly prime upper motor neuron circuits to initiate motor function and a type of symptom is haematoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Basal_ganglia_disease</obo:IAO_0000119>
        <obo:OAE_0001849>基底神经节血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10077031</obo:OAE_0004334>
        <rdfs:label>basal ganglia hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <obo:IAO_0000115>This is an AE which is a group of physical problems that occur when the group of nuclei in the brain known as the basal ganglia fail to properly suppress unwanted movements or to properly prime upper motor neuron circuits to initiate motor function and a type of symptom is stroke.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Basal_ganglia_disease</obo:IAO_0000119>
        <obo:OAE_0001849>基底神经节中风</obo:OAE_0001849>
        <obo:OAE_0004334>10071043</obo:OAE_0004334>
        <rdfs:label>basal ganglia stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004753 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a group of subcortical nuclei, of varied origin, in the brains of vertebrates and it is  begin  degeneration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Basal_ganglia</obo:IAO_0000119>
        <obo:OAE_0001849>基底神经节变性</obo:OAE_0001849>
        <obo:OAE_0004334>10004153</obo:OAE_0004334>
        <rdfs:label>basal ganglion degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004754 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is an outmoded term for a condition now designated as a form of conversion disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hysterical_Blindness</obo:IAO_0000119>
        <obo:OAE_0001849>神经性失明</obo:OAE_0001849>
        <obo:OAE_0004334>10005179</obo:OAE_0004334>
        <rdfs:label>blindness hysterical AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004755 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a cancerous glioma tumor in the brainstem.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Brainstem_glioma</obo:IAO_0000119>
        <obo:OAE_0001849>脑干神经胶质瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10006143</obo:OAE_0004334>
        <rdfs:label>brain stem glioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004756 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <obo:IAO_0000115>This is an AE which is an eating disorder characterized by binge eating followed by purging; and excessive concern with body shape and weight.</obo:IAO_0000115>
