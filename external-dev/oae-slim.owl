        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004378"/>
        <obo:IAO_0000115>This is an AE which is a specialized primary lymphoid organ of the immune system and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thymus</obo:IAO_0000119>
