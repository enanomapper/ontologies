        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=6853</obo:IAO_0000119>
        <obo:OAE_0004334>10054805</obo:OAE_0004334>
        <rdfs:label xml:lang="en">macroangiopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002357 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002357">
