        <obo:OAE_0004334>10061768</obo:OAE_0004334>
        <rdfs:label>chronic respiratory disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008782 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000310"/>
        <obo:IAO_0000115>This is an AE which is a feeling of not being able to breathe well enough at rest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shortness_of_breath</obo:IAO_0000119>
        <obo:OAE_0001849>休息时呼吸困难</obo:OAE_0001849>
        <obo:OAE_0004334>10013969</obo:OAE_0004334>
        <rdfs:label>dyspnoea at rest AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008783 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000310"/>
        <obo:IAO_0000115>This is an AE which is an attack of severe shortness of breath and coughing that generally occurs at night.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paroxysmal_nocturnal_dyspnoea</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸困难阵发性夜间</obo:OAE_0001849>
        <obo:OAE_0004334>10013974</obo:OAE_0004334>
        <rdfs:label>dyspnoea paroxysmal nocturnal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008784 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is overly shallow breathing or an abnormally low respiratory rate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypopnea</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10021079</obo:OAE_0004334>
        <rdfs:label>hypopnoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008785 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is the cessation of breathing on infantile.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Apnea</obo:IAO_0000119>
        <obo:OAE_0001849>小儿呼吸暂停</obo:OAE_0001849>
        <obo:OAE_0004334>10077321</obo:OAE_0004334>
        <rdfs:label>infantile apnoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008786 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a disease in which there is permanent enlargement of parts of the airways of the lung and is infective exacerbation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchiectasis</obo:IAO_0000119>
        <obo:OAE_0001849>支气管扩张的感染性加重</obo:OAE_0001849>
        <obo:OAE_0004334>10070295</obo:OAE_0004334>
        <rdfs:label>infective exacerbation of bronchiectasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008787 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is the medical condition resulting from deprivation of oxygen to a newborn infant that lasts long enough during the birth process to cause physical harm, usually to the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perinatal_asphyxia</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿窒息</obo:OAE_0001849>
        <obo:OAE_0004334>10028923</obo:OAE_0004334>
        <rdfs:label>neonatal asphyxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008788 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which associates neonatal case fatality, and morbidity prevalence are high.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21949140/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿呼吸衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10028970</obo:OAE_0004334>
        <rdfs:label>neonatal respiratory depression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008789 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is a syndrome in premature infants caused by developmental insufficiency of pulmonary surfactant production and structural immaturity in the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infant_respiratory_distress_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿呼吸窘迫综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10028974</obo:OAE_0004334>
        <rdfs:label>neonatal respiratory distress syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008790 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001443"/>
        <obo:IAO_0000115>This is an AE which is a respiratory rate greater than normal at neonatal, resulting in abnormally rapid breathing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tachypnea</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿呼吸急促</obo:OAE_0001849>
        <obo:OAE_0004334>10057183</obo:OAE_0004334>
        <rdfs:label>neonatal tachypnoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008791 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is a feeling of not being able to breathe well enough on postoperative.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shortness_of_breath</obo:IAO_0000119>
        <obo:OAE_0001849>术后呼吸窘迫</obo:OAE_0001849>
        <obo:OAE_0004334>10054809</obo:OAE_0004334>
        <rdfs:label>postoperative respiratory distress AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008792 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a viral respiratory disease of zoonotic origin caused by severe acute respiratory syndrome coronavirus (SARS-CoV or SARS-CoV-1), the first identified strain of the SARS coronavirus species severe acute respiratory syndrome–related coronavirus (SARSr-CoV).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Severe_acute_respiratory_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>严重急性呼吸综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10061982</obo:OAE_0004334>
        <rdfs:label>severe acute respiratory syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008793 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a sleep disorder in which pauses in breathing or periods of shallow breathing during sleep occur more often than normal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sleep_apnea</obo:IAO_0000119>
        <obo:OAE_0001849>睡眠呼吸暂停综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10040979</obo:OAE_0004334>
        <rdfs:label>sleep apnoea syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008794 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is an accumulation of air in the chest causing the lung to separate from the chest wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Collapsed_lung_(disambiguation)</obo:IAO_0000119>
        <obo:OAE_0001849>肺萎陷</obo:OAE_0001849>
        <obo:OAE_0004334>10009913</obo:OAE_0004334>
        <rdfs:label>collapse of lung AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008795 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the bronchi fibrinous (large and medium-sized airways) in the lungs that causes coughing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>纤维素性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10051011</obo:OAE_0004334>
        <rdfs:label>fibrinous bronchitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008796 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the bronchi (large and medium-sized airways) in the lungs that causes coughing and is allergic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchitis</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052613</obo:OAE_0004334>
        <rdfs:label>allergic bronchitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008797 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000398"/>
        <obo:IAO_0000115>This is an AE which is a sudden expulsion of air through the large breathing passages that can help clear them of fluids, irritants, foreign particles and microbes and is allergic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cough</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性咳嗽</obo:OAE_0001849>
        <obo:OAE_0004334>10053779</obo:OAE_0004334>
        <rdfs:label>allergic cough AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008798 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection of the trachea and is capable of producing airway obstruction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tracheitis#Bacterial_tracheitis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066798</obo:OAE_0004334>
        <rdfs:label>bacterial tracheitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008799 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a disease that results in obstruction of the smallest airways of the lungs (bronchioles) due to inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bronchiolitis_obliterans</obo:IAO_0000119>
        <obo:OAE_0001849>闭塞性细支气管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10029888</obo:OAE_0004334>
        <rdfs:label>obliterative bronchiolitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008800 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008800">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001164"/>
        <obo:IAO_0000115>This is an AE which is a disease of the lymph nodes at paratracheal, in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphadenopathy</obo:IAO_0000119>
        <obo:OAE_0001849>气管旁淋巴结病</obo:OAE_0001849>
        <obo:OAE_0004334>10033969</obo:OAE_0004334>
        <rdfs:label>paratracheal lymphadenopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008801 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is significant both because of the clinical problems that it can create and because its pathogenesis can be defined.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2916958/</obo:IAO_0000119>
        <obo:OAE_0001849>心因性呼吸窘迫</obo:OAE_0001849>
        <obo:OAE_0004334>10072630</obo:OAE_0004334>
        <rdfs:label>psychogenic respiratory distress AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008802 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008802">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115>This is an AE which occurs also during sleep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23816600/</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸不规则</obo:OAE_0001849>
        <obo:OAE_0004334>10076213</obo:OAE_0004334>
        <rdfs:label>irregular breathing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008803 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a deep and labored breathing pattern often associated with severe metabolic acidosis, particularly diabetic ketoacidosis (DKA) but also kidney failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kussmaul_breathing</obo:IAO_0000119>
        <obo:OAE_0001849>库斯莫尔呼吸</obo:OAE_0001849>
        <obo:OAE_0004334>10023499</obo:OAE_0004334>
        <rdfs:label>kussmaul respiration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008804 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008804">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is believed to be caused by retrograde flow of gastric contents (particularly acid and pepsin) that affect pharyngeal and laryngeal mucosa by direct contact or by a secondary mechanism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23769008/</obo:IAO_0000119>
        <obo:OAE_0001849>反流性喉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067869</obo:OAE_0004334>
        <rdfs:label>reflux laryngitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008805 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is potentially a life-threatening condition with sudden onset and dramatic clinical presentation demanding prompt management and airway preservation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25921270/</obo:IAO_0000119>
        <obo:OAE_0001849>声门下喉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10076988</obo:OAE_0004334>
        <rdfs:label>subglottic laryngitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008806 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001373"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by the bacterium Corynebacterium diphtheriae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diphtheria</obo:IAO_0000119>
        <obo:OAE_0001849>白喉</obo:OAE_0001849>
        <obo:OAE_0004334>10013023</obo:OAE_0004334>
        <rdfs:label>diphtheria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008807 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is closely related to sighing, and the inhalation characterizing a gasp induced by shock or surprise may be released as a sigh if the event causing the initial emotional reaction is determined to be less shocking or surprising than the observer first believed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paralanguage#Gasps</obo:IAO_0000119>
        <obo:OAE_0001849>喘息综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10069162</obo:OAE_0004334>
        <rdfs:label>gasping syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008808 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001164"/>
        <obo:IAO_0000115>This is an AE which is a disease of the hilar lymph nodes, in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32771058/</obo:IAO_0000119>
        <obo:OAE_0001849>肺门淋巴结病</obo:OAE_0001849>
        <obo:OAE_0004334>10020094</obo:OAE_0004334>
        <rdfs:label>hilar lymphadenopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008809 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a rare, progressive illness of the respiratory system, characterized by the thickening and stiffening of lung tissue, associated with the formation of scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Idiopathic_pulmonary_fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>特发性肺纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10021240</obo:OAE_0004334>
        <rdfs:label>idiopathic pulmonary fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008810 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of undifferentiated malignant neoplasms that lack the cytologic and architectural features of small cell carcinoma and glandular or squamous differentiation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Large-cell_lung_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>大细胞肺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10023774</obo:OAE_0004334>
        <rdfs:label>large cell lung cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008811 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>This is an AE which is mainly caused by bacteria, group B streptococcus, Escherichia coli and listeria being the most frequently involved; Herpes simplex is the main viral agent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10223164/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10053584</obo:OAE_0004334>
        <rdfs:label>neonatal pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008812 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a category of extrapulmonary, pleural, or parenchymal respiratory diseases that restrict lung expansion, resulting in a decreased lung volume, an increased work of breathing, and inadequate ventilation and/or oxygenation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Restrictive_lung_disease</obo:IAO_0000119>
        <obo:OAE_0001849>限制性肺病</obo:OAE_0001849>
        <obo:OAE_0004334>10048667</obo:OAE_0004334>
        <rdfs:label>restrictive pulmonary disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008813 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition caused by varicella zoster of the lung primarily affecting the small air sacs known as alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>水痘带状疱疹肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074254</obo:OAE_0004334>
        <rdfs:label>varicella zoster pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008814 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008814">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a rare, severe lung disease that usually affects otherwise healthy individuals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_interstitial_pneumonitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性间质性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066728</obo:OAE_0004334>
        <rdfs:label>acute interstitial pneumonitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008815 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a type of respiratory failure characterized by rapid onset of widespread inflammation in the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_respiratory_distress_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>急性肺损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10069351</obo:OAE_0004334>
        <rdfs:label>acute lung injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008816 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases that mainly affect the alveoli of the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alveolar_lung_disease</obo:IAO_0000119>
        <obo:OAE_0001849>肺泡肺部疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10073344</obo:OAE_0004334>
        <rdfs:label>alveolar lung disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008817 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a rare lung disorder characterized by an abnormal accumulation of surfactant-derived lipoprotein compounds within the alveoli of the lung.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulmonary_alveolar_proteinosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺泡蛋白质沉积症</obo:OAE_0001849>
        <obo:OAE_0004334>10001881</obo:OAE_0004334>
        <rdfs:label>alveolar proteinosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008818 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a rare immune system disorder that affects the lungs and is fibrosing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypersensitivity_pneumonitis</obo:IAO_0000119>
        <obo:OAE_0001849>纤维性肺泡炎</obo:OAE_0001849>
        <obo:OAE_0004334>10001892</obo:OAE_0004334>
        <rdfs:label>alveolitis fibrosing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008819 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is the collapse or closure of a lung resulting in reduced or absent gas exchange at  neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atelectasis</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿肺不张</obo:OAE_0001849>
        <obo:OAE_0004334>10003599</obo:OAE_0004334>
        <rdfs:label>atelectasis neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008820 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001142"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition caused by candida of the lung primarily affecting the small air sacs known as alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>念珠菌肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10053158</obo:OAE_0004334>
        <rdfs:label>candida pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008821 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a surgical procedure in which one or both lungs are replaced by lungs from a donor and after the surgical procedure occurs complications .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lung_transplantation#Transplant_requirements</obo:IAO_0000119>
        <obo:OAE_0001849>肺移植并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10010187</obo:OAE_0004334>
        <rdfs:label>complications of transplanted lung AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008822 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory condition caused by covid-19 of the lung primarily affecting the small air sacs known as alveoli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>covid-19肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10084380</obo:OAE_0004334>
        <rdfs:label>covid-19 pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008823 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder that affects mostly the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cystic_fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺囊性纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10011763</obo:OAE_0004334>
        <rdfs:label>cystic fibrosis lung AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008824 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002217"/>
        <obo:IAO_0000115>This is an AE which is a histologic term used to describe specific changes that occur to the structure of the lungs during injury or disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diffuse_alveolar_damage</obo:IAO_0000119>
        <obo:OAE_0001849>弥漫性肺泡损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10060902</obo:OAE_0004334>
        <rdfs:label>diffuse alveolar damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008825 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is a lower respiratory tract disease, characterised by air-filled spaces (pneumatoses) in the lung, that can vary in size and may be very large.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Emphysema</obo:IAO_0000119>
        <obo:OAE_0001849>肺气肿</obo:OAE_0001849>
        <obo:OAE_0004334>10014561</obo:OAE_0004334>
        <rdfs:label>emphysema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008826 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>This is an AE which is a disease in which an eosinophil, a type of white blood cell, accumulates in the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014962</obo:OAE_0004334>
        <rdfs:label>eosinophilic pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008827 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008827">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>This is an AE which is a chronic disease in which an eosinophil, a type of white blood cell, accumulates in the lungs .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>慢性嗜酸性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052833</obo:OAE_0004334>
        <rdfs:label>eosinophilic pneumonia chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008828 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is tuberculosis (TB) within a location in the body other than the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Extrapulmonary_tuberculosis</obo:IAO_0000119>
        <obo:OAE_0001849>肺外结核</obo:OAE_0001849>
        <obo:OAE_0004334>10064445</obo:OAE_0004334>
        <rdfs:label>extrapulmonary tuberculosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008829 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which causes viral pneumonia which can become life-threatening if the virus spreads to the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32423043/</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10066226</obo:OAE_0004334>
        <rdfs:label>metapneumovirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008830 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a disease of the lung associated with RA, rheumatoid arthritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rheumatoid_lung_disease</obo:IAO_0000119>
        <obo:OAE_0001849>类风湿肺</obo:OAE_0001849>
        <obo:OAE_0004334>10039081</obo:OAE_0004334>
        <rdfs:label>rheumatoid lung AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008831 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <obo:IAO_0000115>This is an AE which is more common in men than in women and it is closely correlated with a history of tobacco smoking, more so than most other types of lung cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Non-small-cell_lung_carcinoma#Squamous-cell_lung_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>肺鳞状细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10041826</obo:OAE_0004334>
        <rdfs:label>squamous cell carcinoma of lung AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008832 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <obo:IAO_0000115>This is an AE which is any type of pneumonia not caused by one of the pathogens most commonly associated with the disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atypical_pneumonia</obo:IAO_0000119>
        <obo:OAE_0001849>非典型性肺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10003757</obo:OAE_0004334>
        <rdfs:label>atypical pneumonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008833 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the spinal cord that causes temporary or permanent changes in its function.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_cord_injury</obo:IAO_0000119>
        <obo:OAE_0001849>脊髓损伤胸</obo:OAE_0001849>
        <obo:OAE_0004334>10041558</obo:OAE_0004334>
