    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009339 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is a liquid by-product of metabolism in humans and in many other animals and is crystal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urine</obo:IAO_0000119>
        <obo:OAE_0001849>晶体尿</obo:OAE_0001849>
