        <obo:OAE_0004334>10067873</obo:OAE_0004334>
        <rdfs:label>hashitoxicosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007260 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007260">
