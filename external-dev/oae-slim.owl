        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a collection of signs and symptoms due to prolonged exposure to glucocorticoids such as cortisol.</obo:IAO_0000115>
