        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001964"/>
        <obo:IAO_0000115>This is an AE which is an inflammation caused by bacterial of one or both parotid glands, the major salivary glands located on either side of the face, in humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
