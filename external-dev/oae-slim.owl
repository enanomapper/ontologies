    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115 xml:lang="en">a digestive system AE which has an outcome of mouth mucosal ulceration, which is lesions through the mucous membrane of the mouth, usually associated with loss of tissue</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;mouth ulceration&apos; was mentioned in 246 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <rdfs:label>mouth mucosal ulceration AE</rdfs:label>
