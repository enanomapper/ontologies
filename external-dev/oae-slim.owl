    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008482 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a condition in which a woman without diabetes develops high blood sugar levels during pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gestational_diabetes</obo:IAO_0000119>
