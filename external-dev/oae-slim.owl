        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002670"/>
        <obo:IAO_0000115>This is an AE which is a metabolic condition in which the pH of tissue is elevated beyond the normal range (7.35–7.45).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metabolic_alkalosis</obo:IAO_0000119>
        <obo:OAE_0001849>代谢性碱中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10027423</obo:OAE_0004334>
        <rdfs:label>metabolic alkalosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007614 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is the sugar formed when two monosaccharides are joined by glycosidic linkage and its metabolism becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Disaccharide</obo:IAO_0000119>
        <obo:OAE_0001849>二糖代谢障碍</obo:OAE_0001849>
