        <obo:IAO_0000115>a fall AE that is minor with no resultant injuries; intervention not indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 fall AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11688</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003643 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000939"/>
        <obo:IAO_0000115>a fall AE where hospitalization indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 fall AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11690</rdfs:seeAlso>
    </owl:Class>
    


