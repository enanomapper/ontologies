        <obo:OAE_0004334>10005913</obo:OAE_0004334>
        <rdfs:label>body tinea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009101 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a complication of pregnancy; the acronym stands for Hemolysis, Elevated Liver enzymes, and Low Platelet count.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/HELLP_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>HELLP综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10049058</obo:OAE_0004334>
        <rdfs:label>hellp syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009102 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a state of adaptation or dysregulation of thyrotropic feedback control wherein the levels of T3 and/or T4 are abnormal, but the thyroid gland does not appear to be dysfunctional.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Euthyroid_sick_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺机能正常的病态综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10015549</obo:OAE_0004334>
        <rdfs:label>euthyroid sick syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009103 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a vascular occlusion in humans in the region of the ulna.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypothenar_hammer_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>下丘脑锤打综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10063518</obo:OAE_0004334>
        <rdfs:label>hypothenar hammer syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009104 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a rare congenital brain malformation in which the part joining the two hemispheres of the cerebellum (the cerebellar vermis) does not fully form, and the fourth ventricle and space behind the cerebellum (the posterior fossa) are enlarged with cerebrospinal fluid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dandy%E2%80%93Walker_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>dandy-walker综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10048411</obo:OAE_0004334>
        <rdfs:label>dandy-walker syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009105 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a reaction of the skin to a viral infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gianotti%E2%80%93Crosti_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>gianotti-crosti综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10053842</obo:OAE_0004334>
        <rdfs:label>gianotti-crosti syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009106 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004456"/>
        <obo:IAO_0000115>This is an AE which is an autosomal recessive kidney tubule disorder characterized by low blood levels of potassium and magnesium, decreased excretion of calcium in the urine, and elevated blood pH.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gitelman_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>gitelman综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10062906</obo:OAE_0004334>
        <rdfs:label>gitelman&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009107 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a postulated disorder of vision or image-processing in the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irlen_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>irlen综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10074972</obo:OAE_0004334>
        <rdfs:label>irlen syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009108 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a rare congenital medical condition in which blood vessels and/or lymph vessels fail to form properly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Klippel%E2%80%93Tr%C3%A9naunay_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>klippel-trenaunay综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10051452</obo:OAE_0004334>
        <rdfs:label>klippel-trenaunay syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009109 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is defined as acute coronary syndrome (symptoms such as chest pain relating to reduced blood flow to the heart) caused by an allergic reaction or a strong immune reaction to a drug or other substance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kounis_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>kounis综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10069167</obo:OAE_0004334>
        <rdfs:label>kounis syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which represents the asymmetric variant of chronic inflammatory demyelinating polyneuropathy (CIDP).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19145651/</obo:IAO_0000119>
        <obo:OAE_0001849>lewis-sumner综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10065580</obo:OAE_0004334>
        <rdfs:label>lewis-sumner syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009111 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a condition in which compression of the common venous outflow tract of the left lower extremity may cause discomfort, swelling, pain or clots (deep venous thrombosis) in the iliofemoral veins.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/May%E2%80%93Thurner_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>may-thurner综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10069727</obo:OAE_0004334>
        <rdfs:label>may-thurner syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009112 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a type of dystonia and is actually a combination of two forms of dystonia, blepharospasm and oromandibular dystonia (OMD).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meige%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>meige综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10027138</obo:OAE_0004334>
        <rdfs:label>meige&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009113 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a medical condition, typically starting in young children, in which high fever occurs periodically at intervals of about 3-5 weeks, frequently accompanied by aphthous-like ulcers, pharyngitis and/or cervical adenitis (cervical lymphadenopathy).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periodic_fever,_aphthous_stomatitis,_pharyngitis_and_adenitis</obo:IAO_0000119>
        <obo:OAE_0001849>pfapa综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10070594</obo:OAE_0004334>
        <rdfs:label>pfapa syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009114 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is a severe endocrine disease caused by a corticotroph pituitary tumor and associated with increased morbidity and mortality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26067718/</obo:IAO_0000119>
        <obo:OAE_0001849>pituitary-dependent库兴氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10035109</obo:OAE_0004334>
        <rdfs:label>pituitary-dependent cushing&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009115 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder of unknown cause that is characterized by abundant histiocytes in the lymph nodes or other locations throughout the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rosai%E2%80%93Dorfman_disease</obo:IAO_0000119>
        <obo:OAE_0001849>rosai-dorfman综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10063397</obo:OAE_0004334>
        <rdfs:label>rosai-dorfman syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009116 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder characterized by severe and unilateral headaches with orbital pain, along with weakness and paralysis (ophthalmoplegia) of certain eye muscles (extraocular palsies).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tolosa%E2%80%93Hunt_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>tolosa-hunt综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10051526</obo:OAE_0004334>
        <rdfs:label>tolosa-hunt syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009117 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a multisystem disease of presumed autoimmune cause that affects pigmented tissues, which have melanin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vogt%E2%80%93Koyanagi%E2%80%93Harada_disease</obo:IAO_0000119>
        <obo:OAE_0001849>vogt-小柳-原田综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10047680</obo:OAE_0004334>
        <rdfs:label>vogt-koyanagi-harada syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009118 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a chromosomal deletion syndrome resulting from a partial deletion on the short arm of chromosome 4 (del(4p16.3)).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wolf%E2%80%93Hirschhorn_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>wolf-hirschhorn综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10050365</obo:OAE_0004334>
        <rdfs:label>wolf-hirschhorn syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009119 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic malformation syndrome characterized by the partial or complete absence of a key structure in the brain called the corpus callosum, the presence of retinal abnormalities, and seizures in the form of infantile spasms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aicardi_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>阿卡迪综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10054935</obo:OAE_0004334>
        <rdfs:label>aicardi&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009120 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a group of thirteen genetic connective-tissue disorders that are in the current classification, with a fourteenth type discovered in 2018.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ehlers%E2%80%93Danlos_syndromes</obo:IAO_0000119>
        <obo:OAE_0001849>埃勒斯－当洛二氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10014316</obo:OAE_0004334>
        <rdfs:label>ehlers-danlos syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009121 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease in which an individual&apos;s immune system attacks their own red blood cells and platelets, the syndrome can include immune neutropenia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Evans_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>埃文斯综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10053873</obo:OAE_0004334>
        <rdfs:label>evans syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009122 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a neuropsychological condition that causes a distortion of perception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alice_in_Wonderland_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>爱丽丝梦游仙境综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10001666</obo:OAE_0004334>
        <rdfs:label>alice in wonderland syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009123 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004239"/>
        <obo:IAO_0000115>This is an AE which is a type of psychophysical visual disturbance in which a person with partial or severe blindness experiences visual hallucinations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_release_hallucinations</obo:IAO_0000119>
        <obo:OAE_0001849>邦纳症候群</obo:OAE_0001849>
        <obo:OAE_0004334>10063354</obo:OAE_0004334>
        <rdfs:label>charles bonnet syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009124 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensory perception during sleep in which a person experiences unreal noises that are loud and of short duration when falling asleep or waking up.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exploding_head_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>爆炸头综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10080684</obo:OAE_0004334>
        <rdfs:label>exploding head syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009125 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a type of inflammatory disorder which affects multiple parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Beh%C3%A7et%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>贝赫切特综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10004213</obo:OAE_0004334>
        <rdfs:label>behcet&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009126 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is possible to argue that motor competence can be understood as the person s ability to carry out different motor skills and is become disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16355603/</obo:IAO_0000119>
        <obo:OAE_0001849>笨挫儿童综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10009697</obo:OAE_0004334>
        <rdfs:label>clumsy child syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009127 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a condition in which a patient is aware but cannot move or communicate verbally due to complete paralysis of nearly all voluntary muscles in the body except for vertical eye movements and blinking.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Locked-in_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>闭锁综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10024792</obo:OAE_0004334>
        <rdfs:label>locked-in syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009128 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is knee pain as a result of problems between the kneecap and the femur.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Patellofemoral_pain_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>髌股疼痛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10049143</obo:OAE_0004334>
        <rdfs:label>patellofemoral pain syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009129 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a complex, fatiguing, long-term medical condition diagnosed by required primary symptoms and criteria, and often involves a broad range of symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_fatigue_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>病毒后疲劳综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10057244</obo:OAE_0004334>
        <rdfs:label>post viral fatigue syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009130 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a condition in which people in a building suffer from symptoms of illness or become infected with chronic disease from the building in which they work or reside.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sick_building_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>病态建筑综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10040634</obo:OAE_0004334>
        <rdfs:label>sick building syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009131 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is generally a long-term disorder that causes a strong urge to move one&apos;s legs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Restless_legs_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>不安腿综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10058920</obo:OAE_0004334>
        <rdfs:label>restless legs syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009132 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a rare X-linked dominant genetic disorder that affects the skin, hair, teeth, nails and central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Incontinentia_pigmenti</obo:IAO_0000119>
        <obo:OAE_0001849>布洛克，色素失调症</obo:OAE_0001849>
        <obo:OAE_0004334>10077624</obo:OAE_0004334>
        <rdfs:label>bloch-sulzberger syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009133 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a neurological disorder causing a range of symptoms due to ischemia in the lateral part of the medulla oblongata in the brainstem.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lateral_medullary_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>侧髓综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10024033</obo:OAE_0004334>
        <rdfs:label>lateral medullary syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009134 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a hereditary autoinflammatory syndrome caused by mutations in the mevalonate kinase gene.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25990874/</obo:IAO_0000119>
        <obo:OAE_0001849>超级igd综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10072010</obo:OAE_0004334>
        <rdfs:label>hyper igd syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009135 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of immune disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperimmunoglobulin_E_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>超级ige综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10051040</obo:OAE_0004334>
        <rdfs:label>hyper ige syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009136 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder characterized by mild-to-moderate intellectual disability.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fragile_X_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>脆性x综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10017324</obo:OAE_0004334>
        <rdfs:label>fragile x syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009137 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a clustering of at least three of the following five medical conditions: abdominal obesity, high blood pressure, high blood sugar, high serum triglycerides, and low serum high-density lipoprotein (HDL).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metabolic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>代谢综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10052066</obo:OAE_0004334>
        <rdfs:label>metabolic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009138 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by a snapping sensation felt when the hip is flexed and extended.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Snapping_hip_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>弹响髋综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10080832</obo:OAE_0004334>
        <rdfs:label>snapping hip syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009139 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome caused by a microdeletion on the long arm of chromosome 22.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/DiGeorge_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>迪格奥尔格综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10012979</obo:OAE_0004334>
        <rdfs:label>digeorge&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009140 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a congenital rare type of strabismus most commonly characterized by the inability of the eye to move outward.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Duane_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>杜安综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10013799</obo:OAE_0004334>
        <rdfs:label>duane&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009141 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is part of a group called Ras/MAPK pathway syndromes, is a rare autosomal dominant,multisystem disease caused by a mutation in the protein tyrosine phosphatase, non-receptor type 11 gene (PTPN11).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Noonan_syndrome_with_multiple_lentigines</obo:IAO_0000119>
        <obo:OAE_0001849>多发性雀斑综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10062901</obo:OAE_0004334>
        <rdfs:label>multiple lentigines syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009142 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is altered organ function in an acutely ill patient requiring medical intervention to achieve homeostasis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_organ_dysfunction_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>多器官功能障碍综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10077361</obo:OAE_0004334>
        <rdfs:label>multiple organ dysfunction syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009143 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001369"/>
        <obo:IAO_0000115>This is an AE which is an informal label that physicians apply to patients with symptoms similar to those of asthma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reactive_airway_disease</obo:IAO_0000119>
        <obo:OAE_0001849>反应性气道功能障碍综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10070832</obo:OAE_0004334>
        <rdfs:label>reactive airways dysfunction syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009144 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>This is an AE which is a compression neuropathy and painful foot condition in which the tibial nerve is compressed as it travels through the tarsal tunnel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tarsal_tunnel_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>跗管综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10043121</obo:OAE_0004334>
        <rdfs:label>tarsal tunnel syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009145 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare syndrome caused by a genetic disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/CHARGE_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>联合畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10064043</obo:OAE_0004334>
        <rdfs:label>charge syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009146 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a long-term autoimmune disease that affects the body&apos;s moisture-producing (lacrimal and salivary) glands, and often seriously affects other organ systems, such as the lungs, kidneys, and nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sj%C3%B6gren_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>干燥综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10040633</obo:OAE_0004334>
        <rdfs:label>sicca syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009147 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <obo:IAO_0000115>This is an AE which is a complication of otitis media and mastoiditis involving the apex of the petrous temporal bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gradenigo%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>格拉代尼果氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10063095</obo:OAE_0004334>
        <rdfs:label>gradenigo&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009148 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a chronic and multi-symptomatic disorder affecting returning military veterans of the 1990–1991 Persian Gulf War.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gulf_War_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>海湾战争综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10056557</obo:OAE_0004334>
        <rdfs:label>gulf war syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009149 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the sensation that an amputated or missing limb is still attached.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phantom_limb</obo:IAO_0000119>
        <obo:OAE_0001849>幻肢综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10082544</obo:OAE_0004334>
        <rdfs:label>phantom limb syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009150 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a combination of symptoms that arises when a group of nerves known as the sympathetic trunk is damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Horner%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>霍纳氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10020392</obo:OAE_0004334>
        <rdfs:label>horner&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009151 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a medical condition of decreased mobility due to disorders of the locomotor system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Locomotive_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>机车综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10077495</obo:OAE_0004334>
        <rdfs:label>locomotive syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009152 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is a mild liver disorder in which the liver does not properly process bilirubin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gilbert%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>吉尔伯特的综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10018267</obo:OAE_0004334>
        <rdfs:label>gilbert&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009153 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a syndrome involving tendonitis (inflammation of tendons) of the rotator cuff muscles as they pass through the subacromial space, the passage beneath the acromion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shoulder_impingement_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肩撞击综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10063932</obo:OAE_0004334>
        <rdfs:label>impingement syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009154 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the group of symptoms that occur upon the abrupt discontinuation or decrease in the intake of medicational or recreational drugs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Drug_withdrawal</obo:IAO_0000119>
        <obo:OAE_0001849>戒断综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10048010</obo:OAE_0004334>
        <rdfs:label>withdrawal syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009155 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease associated with interstitial lung disease, dermatomyositis, and polymyositis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Antisynthetase_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>抗合成酶综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10068801</obo:OAE_0004334>
        <rdfs:label>antisynthetase syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009156 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune, hypercoagulable state caused by antiphospholipid antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Antiphospholipid_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>抗磷脂综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10002817</obo:OAE_0004334>
        <rdfs:label>antiphospholipid syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009157 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a collection of signs and symptoms due to prolonged exposure to glucocorticoids such as cortisol.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cushing%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>库兴氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10011652</obo:OAE_0004334>
        <rdfs:label>cushing&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009158 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000494"/>
        <obo:IAO_0000115>This is an AE which is a rapidly worsening brain disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reye_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>雷氏综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10039012</obo:OAE_0004334>
        <rdfs:label>reye&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009159 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a group of rare, heterogeneous autoinflammatory disease characterized by interleukin 1β-mediated systemic inflammation and clinical symptoms involving skin, joints, central nervous system, and eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cryopyrin-associated_periodic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>冷卟啉相关周期性综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10068850</obo:OAE_0004334>
        <rdfs:label>cryopyrin associated periodic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009160 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare progressive disorder of presumed autoimmune cause, characterized by painful muscle spasms, alopecia, diarrhea, endocrinopathy with amenorrhoea and secondary skeletal abnormalities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Satoyoshi_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>里吉综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10070579</obo:OAE_0004334>
        <rdfs:label>satoyoshi syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009161 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a clinical situation of an individual&apos;s first neurological episode, caused by inflammation or demyelination of nerve tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Clinically_isolated_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>临床孤立综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10071068</obo:OAE_0004334>
        <rdfs:label>clinically isolated syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009162 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which mostly occurs in congenital ptosis patients, is characterized by jaw movement evoking ptotic eyelid retraction, followed by collapse. Inverted, bilateral and acquired MGS were also reported.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33254517/</obo:IAO_0000119>
        <obo:OAE_0001849>马库斯·甘恩综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10064583</obo:OAE_0004334>
        <rdfs:label>marcus gunn syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009163 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the triad of ascites, pleural effusion, and benign ovarian tumor (ovarian fibroma, fibrothecoma, Brenner tumour, and occasionally granulosa cell tumour).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meigs%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>梅格斯氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10027139</obo:OAE_0004334>
        <rdfs:label>meigs&apos; syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009164 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a form of chemical pneumonitis or aspiration pneumonitis caused by aspiration of stomach contents (principally gastric acid) during anaesthesia in childbirth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mendelson%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>门德尔松综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10049783</obo:OAE_0004334>
        <rdfs:label>mendelson&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009165 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is one of the family of mitochondrial diseases, which also include MERRF syndrome, and Leber&apos;s hereditary optic neuropathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/MELAS_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>米拉斯综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10053872</obo:OAE_0004334>
        <rdfs:label>melas syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009166 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a rare variant of Guillain-Barré&apos;s syndrome characterized by the acute development of ataxia, ophthalmoparesis, and areflexia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23677659/</obo:IAO_0000119>
        <obo:OAE_0001849>米勒费雪症候群</obo:OAE_0001849>
        <obo:OAE_0004334>10049567</obo:OAE_0004334>
        <rdfs:label>miller fisher syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009167 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is an umbrella term covering pain and dysfunction of the muscles of mastication (the muscles that move the jaw) and the temporomandibular joints (the joints which connect the mandible to the skull).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Temporomandibular_joint_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>颞下颌关节综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10043220</obo:OAE_0004334>
        <rdfs:label>temporomandibular joint syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009168 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder that may present with mildly unusual facial features, short height, congenital heart disease, bleeding problems, and skeletal malformations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Noonan_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>努南综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10029748</obo:OAE_0004334>
        <rdfs:label>noonan syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009169 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a congenital defect observed in humans which is characterized by facial abnormalities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pierre_Robin_sequence</obo:IAO_0000119>
        <obo:OAE_0001849>皮埃尔·罗宾综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10035009</obo:OAE_0004334>
        <rdfs:label>pierre robin syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009170 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a common and important problem among health professionals that also has adverse effects on people&apos;s daily life, especially increasing the incidence of infection and trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31800896/</obo:IAO_0000119>
        <obo:OAE_0001849>疲劳综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10065369</obo:OAE_0004334>
        <rdfs:label>burnout syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009171 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder caused by a loss of function of specific genes on chromosome 15.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prader%E2%80%93Willi_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>普拉德-威利综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10036476</obo:OAE_0004334>
        <rdfs:label>prader-willi syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009172 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare condition that encompasses a combination of syndromes such as bronchiectasis, rhinosinusitis and reduced male fertility.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Young%27s_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>青年综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10063689</obo:OAE_0004334>
        <rdfs:label>young&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009173 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which occurs when food, especially sugar, moves too quickly from the stomach to the duodenum—the first part of the small intestine—in the upper gastrointestinal (GI) tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dumping_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>倾倒综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10013810</obo:OAE_0004334>
        <rdfs:label>dumping syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009174 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers to as calcium-alkali syndrome, is the third most common cause of hypercalcemia and is characterized by elevated blood calcium levels, metabolic alkalosis, and acute kidney injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Milk-alkali_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>乳碱综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10027635</obo:OAE_0004334>
        <rdfs:label>milk-alkali syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009175 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000593"/>
        <obo:IAO_0000115>This is an AE which is a form of inflammatory arthritis that develops in response to an infection in another part of the body (cross-reactivity).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reactive_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>瑞特综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10038294</obo:OAE_0004334>
        <rdfs:label>reiter&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009176 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is an eponymous paediatric medical disorder, characterised by gastrointestinal symptoms and associated neurological features.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sandifer_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>桑迪夫综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10066142</obo:OAE_0004334>
        <rdfs:label>sandifer&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009177 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is a rare headache disorder that belongs to the group of headaches called trigeminal autonomic cephalalgia (TACs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/SUNCT_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>桑克综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10061981</obo:OAE_0004334>
        <rdfs:label>sunct syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009178 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the term used for both central pontine myelinolysis and extrapontine myelinolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Central_pontine_myelinolysis</obo:IAO_0000119>
        <obo:OAE_0001849>渗透性脱髓鞘综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10069350</obo:OAE_0004334>
        <rdfs:label>osmotic demyelination syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009179 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which refers to a group of neurological disorders that relate to malformations of the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tethered_spinal_cord_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>绳索综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10066334</obo:OAE_0004334>
        <rdfs:label>tethered cord syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009180 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a type of severe skin reaction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stevens%E2%80%93Johnson_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>史蒂文斯-约翰逊综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10042033</obo:OAE_0004334>
        <rdfs:label>stevens-johnson syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009181 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a disease characterized by a persistently elevated eosinophil count (≥ 1500 eosinophils/mm³) in the blood for at least six months without any recognizable cause, with involvement of either the heart, nervous system, or bone marrow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypereosinophilic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸细胞增多综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10048643</obo:OAE_0004334>
        <rdfs:label>hypereosinophilic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009182 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a syndrome resulting from bilateral lesions of the medial temporal lobe (including amygdaloid nucleus).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kl%C3%BCver%E2%80%93Bucy_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>双侧颞叶切除综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10066431</obo:OAE_0004334>
        <rdfs:label>kluver-bucy syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009183 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is seen exclusively in women; men with a mutation of the related gene (called XLIS or DCX) usually die in utero or have a much more severe brain anomaly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gray_matter_heterotopia</obo:IAO_0000119>
        <obo:OAE_0001849>双皮质综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10073490</obo:OAE_0004334>
        <rdfs:label>double cortex syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009184 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a genetic condition in which a female is partially or completely missing an X chromosome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Turner_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>特纳综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10045181</obo:OAE_0004334>
        <rdfs:label>turner&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009185 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a condition in which a change from lying to standing causes an abnormally large (or higher than normal) increase in heart beat rate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Postural_orthostatic_tachycardia_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>体位性直立性心动过速综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10063080</obo:OAE_0004334>
        <rdfs:label>postural orthostatic tachycardia syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009186 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder that mainly affects the nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angelman_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>天使综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10049004</obo:OAE_0004334>
        <rdfs:label>angelman&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009187 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders with diverse etiologies involving different anatomical components of the neck, ultimately resulting in a debilitating, flexible, anterior curvature of the cervical spine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32105239/</obo:IAO_0000119>
        <obo:OAE_0001849>头部综合征下降</obo:OAE_0001849>
        <obo:OAE_0004334>10072442</obo:OAE_0004334>
        <rdfs:label>dropped head syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009188 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a category of conditions in which a person experiences their limbs acting seemingly on their own, without conscious control over the actions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alien_hand_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>异手综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10070883</obo:OAE_0004334>
        <rdfs:label>alien limb syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009189 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder that affects many parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Williams_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>威廉姆斯综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10049644</obo:OAE_0004334>
        <rdfs:label>williams syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009190 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the combined presence of Wernicke encephalopathy (WE) and Korsakoff syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wernicke%E2%80%93Korsakoff_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>韦尼克-科萨科夫综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10047913</obo:OAE_0004334>
        <rdfs:label>wernicke-korsakoff syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009191 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is defined as adrenal gland failure due to bleeding into the adrenal glands, commonly caused by severe bacterial infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Waterhouse%E2%80%93Friderichsen_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>沃特豪斯-弗里德里希森综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10047847</obo:OAE_0004334>
        <rdfs:label>waterhouse-friderichsen syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009192 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a fetus in a multigestation pregnancy that dies in utero and is then partially or completely reabsorbed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vanishing_twin</obo:IAO_0000119>
        <obo:OAE_0001849>消失双胞胎综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10071398</obo:OAE_0004334>
        <rdfs:label>vanishing twin syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009193 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a group of symptoms that may occur with the use of certain serotonergic medications or drugs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Serotonin_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>血清素综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10040108</obo:OAE_0004334>
        <rdfs:label>serotonin syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009194 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a rare congenital growth disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Silver%E2%80%93Russell_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>银罗素综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10062282</obo:OAE_0004334>
        <rdfs:label>silver-russell syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009195 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a condition caused by bacterial toxins.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Toxic_shock_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>中毒性休克综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10044248</obo:OAE_0004334>
        <rdfs:label>toxic shock syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009196 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a neurological condition consisting of constant, moderate to severe pain due to damage to the central nervous system (CNS) which causes a sensitization of the pain system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Central_pain_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>中央疼痛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10064012</obo:OAE_0004334>
        <rdfs:label>central pain syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009197 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a medical condition which shares features of at least two more widely recognised disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Overlap_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>重叠综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10068786</obo:OAE_0004334>
        <rdfs:label>overlap syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009198 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>This is an AE which is the second most common peripheral nerve compression syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21547883/</obo:IAO_0000119>
        <obo:OAE_0001849>肘管综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10056473</obo:OAE_0004334>
        <rdfs:label>cubital tunnel syndrome AE</rdfs:label>
    </owl:Class>
    


