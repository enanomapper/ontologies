        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000439.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10046480</obo:OAE_0004334>
        <rdfs:label xml:lang="en">urethritis AE</rdfs:label>
