        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <obo:IAO_0000115>This is an AE which is the excitatory ability that living organisms have to respond postvaccinal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritability</obo:IAO_0000119>
