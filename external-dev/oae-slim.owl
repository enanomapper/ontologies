    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004734 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a loss of motor function in one or more muscles occured viith nerve .</obo:IAO_0000115>
