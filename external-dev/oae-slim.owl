    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008117 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the    lip skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇起泡</obo:OAE_0001849>
        <obo:OAE_0004334>10049307</obo:OAE_0004334>
        <rdfs:label>lip blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008118 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is the process by which an infant&apos;s first teeth (the deciduous teeth, often called &quot;baby teeth&quot; or &quot;milk teeth&quot;) sequentially appear by emerging through the gums, typically arriving in pairs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Teething</obo:IAO_0000119>
        <obo:OAE_0001849>出牙</obo:OAE_0001849>
        <obo:OAE_0004334>10043183</obo:OAE_0004334>
        <rdfs:label>teething AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008119 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the    lip skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stuttering</obo:IAO_0000119>
        <obo:OAE_0001849>口吃</obo:OAE_0001849>
        <obo:OAE_0004334>10054964</obo:OAE_0004334>
        <rdfs:label>dysphemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008120 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000608"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the mouth and lips and is  allergic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stomatitis</obo:IAO_0000119>
        <obo:OAE_0001849>变应性口炎</obo:OAE_0001849>
        <obo:OAE_0004334>10079554</obo:OAE_0004334>
        <rdfs:label>allergic stomatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008121 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is a common type of skin rash. Symptoms include multiple small (1–2 mm) bumps and blisters sometimes with background redness and scale, localized to the skin around the mouth and nostrils.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perioral_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>口周的皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034541</obo:OAE_0004334>
        <rdfs:label>perioral dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008122 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is the flow of saliva outside the mouth. Drooling can be caused by excess production of saliva, inability to retain saliva within the mouth (incontinence of saliva), or problems with swallowing (dysphagia or odynophagia).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Drooling</obo:IAO_0000119>
        <obo:OAE_0001849>流口水</obo:OAE_0001849>
        <obo:OAE_0004334>10013642</obo:OAE_0004334>
        <rdfs:label>drooling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008123 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is glossitis which manifests with hyperplastic (enlarged) fungiform papillae, giving the appearance of a strawberry.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glossitis#Strawberry_tongue</obo:IAO_0000119>
        <obo:OAE_0001849>草莓舌</obo:OAE_0001849>
        <obo:OAE_0004334>10051495</obo:OAE_0004334>
        <rdfs:label>strawberry tongue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008124 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is considered as a possible clinical finding of obstructive sleep apnoea (OSA).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28548303/</obo:IAO_0000119>
        <obo:OAE_0001849>扇贝舌</obo:OAE_0001849>
        <obo:OAE_0004334>10074686</obo:OAE_0004334>
        <rdfs:label>scalloped tongue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008125 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a common zoological behavior involving the active, rapid closing of the jaw around an object.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Biting</obo:IAO_0000119>
        <obo:OAE_0001849>咬</obo:OAE_0001849>
        <obo:OAE_0004334>10004966</obo:OAE_0004334>
        <rdfs:label>bite AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008126 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is also an age appropriate behavior and reaction for human children 30 months and younger.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Biting#In_humans</obo:IAO_0000119>
        <obo:OAE_0001849>咬人</obo:OAE_0001849>
        <obo:OAE_0004334>10020428</obo:OAE_0004334>
        <rdfs:label>human bite AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008127 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which may occur both in seizures and in psychogenic non-epileptic events (PNEEs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23041172/</obo:IAO_0000119>
        <obo:OAE_0001849>咬舌头</obo:OAE_0001849>
        <obo:OAE_0004334>10050467</obo:OAE_0004334>
        <rdfs:label>tongue biting AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008128 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of mucosal  tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>粘膜肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10079674</obo:OAE_0004334>
        <rdfs:label>mucosal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008129 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which is a membrane that lines various cavities in the body and covers the surface of internal organs and it is dryness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mucous_membrane</obo:IAO_0000119>
        <obo:OAE_0001849>粘膜干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10028111</obo:OAE_0004334>
        <rdfs:label>mucosal dryness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008130 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001296"/>
        <obo:IAO_0000115>This is an AE which is a colored material on the mucosal that is completely or nearly insoluble in water.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pigment</obo:IAO_0000119>
        <obo:OAE_0001849>粘膜色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10067724</obo:OAE_0004334>
        <rdfs:label>mucosal pigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008131 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is an exudate of inflamed mucous membranes in one of the airways or cavities of the body,usually with reference to the throat and paranasal sinuses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Catarrh</obo:IAO_0000119>
        <obo:OAE_0001849>粘膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10007774</obo:OAE_0004334>
        <rdfs:label>catarrh AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008132 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000771"/>
        <obo:IAO_0000115>This is an AE which is a burning sensation in the mouth with no underlying known dental or medical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Burning_mouth_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>灼烧感黏膜</obo:OAE_0001849>
        <obo:OAE_0004334>10006789</obo:OAE_0004334>
        <rdfs:label>burning sensation mucosal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008133 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000805"/>
        <obo:IAO_0000115>This is an AE which is inflammation of one or both corners of the mouth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angular_cheilitis</obo:IAO_0000119>
        <obo:OAE_0001849>角唇炎</obo:OAE_0001849>
        <obo:OAE_0004334>10002509</obo:OAE_0004334>
        <rdfs:label>angular cheilitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008134 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a mode of keratinization characterized by the retention of nuclei in the stratum corneum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parakeratosis</obo:IAO_0000119>
        <obo:OAE_0001849>角化不全</obo:OAE_0001849>
        <obo:OAE_0004334>10058318</obo:OAE_0004334>
        <rdfs:label>parakeratosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008135 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is excessive teeth grinding or jaw clenching.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruxism</obo:IAO_0000119>
        <obo:OAE_0001849>磨牙症</obo:OAE_0001849>
        <obo:OAE_0004334>10006514</obo:OAE_0004334>
        <rdfs:label>bruxism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008136 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which is a membrane that lines various cavities in the body and covers the surface of internal organs and it is discolouration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mucous_membrane</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜变色</obo:OAE_0001849>
        <obo:OAE_0004334>10054877</obo:OAE_0004334>
        <rdfs:label>mucosal discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008137 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which refers a supramolecular assembly of lipid molecules, like a cell membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vesicle</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜囊泡</obo:OAE_0001849>
        <obo:OAE_0004334>10028103</obo:OAE_0004334>
        <rdfs:label>mucosa vesicle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008138 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which is a misalignment or incorrect relation between the teeth of the upper and lower dental arches when they approach each other as the jaws close.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Malocclusion</obo:IAO_0000119>
        <obo:OAE_0001849>错位咬合</obo:OAE_0001849>
        <obo:OAE_0004334>10061274</obo:OAE_0004334>
        <rdfs:label>malocclusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008139 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is one of the criteria for the diagnosis of idiopathic Parkinson disease and is often an early sign of the disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15883274/</obo:IAO_0000119>
        <obo:OAE_0001849>齿轮刚性</obo:OAE_0001849>
        <obo:OAE_0004334>10009848</obo:OAE_0004334>
        <rdfs:label>cogwheel rigidity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008140 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002525"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the alveolar bone (i.e., the alveolar process of the maxilla or mandible).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alveolar_osteitis</obo:IAO_0000119>
        <obo:OAE_0001849>牙槽骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066995</obo:OAE_0004334>
        <rdfs:label>alveolar osteitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008141 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is a cellular aggregation seen in a developing tooth and it lies above the dental papilla.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enamel_organ</obo:IAO_0000119>
        <obo:OAE_0001849>牙釉质异常</obo:OAE_0001849>
        <obo:OAE_0004334>10014576</obo:OAE_0004334>
        <rdfs:label>enamel anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008142 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which is a hard, calcified structure found in the jaws (or mouths) of many vertebrates and used to break down food and feel it discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿不舒服</obo:OAE_0001849>
        <obo:OAE_0004334>10054217</obo:OAE_0004334>
        <rdfs:label>dental discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008143 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is a hard, calcified structure found in the jaws (or mouths) of many vertebrates and used to break down food and it becomes brittle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿变脆</obo:OAE_0001849>
        <obo:OAE_0004334>10043173</obo:OAE_0004334>
        <rdfs:label>teeth brittle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008144 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which is a muscular organ in the mouth of a typical vertebrate and is feel discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tongue</obo:IAO_0000119>
        <obo:OAE_0001849>舌头不适</obo:OAE_0001849>
        <obo:OAE_0004334>10077855</obo:OAE_0004334>
        <rdfs:label>tongue discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008145 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is any condition of the teeth that can be congenital or acquired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth_pathology</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿状况差</obo:OAE_0001849>
        <obo:OAE_0004334>10059184</obo:OAE_0004334>
        <rdfs:label>poor dental condition AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008146 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is the horizontal or vertical displacement of a tooth beyond its normal physiological boundariesaround the gingival area, i.e. the medical term for a loose tooth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth_mobility</obo:IAO_0000119>
        <obo:OAE_0001849>外伤性牙齿移位</obo:OAE_0001849>
        <obo:OAE_0004334>10071180</obo:OAE_0004334>
        <rdfs:label>traumatic tooth displacement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008147 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which is the painful inflammation and ulceration of the mucous membranes lining the digestive tract, usually as an adverse effect of chemotherapy and radiotherapy treatment for cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mucositis</obo:IAO_0000119>
        <obo:OAE_0001849>粘膜紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10082268</obo:OAE_0004334>
        <rdfs:label>mucosal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008148 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is a periodontal disorder diagnosed based on distinct clinical characteristics.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Linear_gingival_erythema</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10067419</obo:OAE_0004334>
        <rdfs:label>gingival erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008149 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>This is an AE which defined as a type of groove along the free edge of the vocal fold, disrupts the normal, pliable vocal fold cover, causing alterations in the intrinsic mucosal wave.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31088694/</obo:IAO_0000119>
        <obo:OAE_0001849>声带沟</obo:OAE_0001849>
        <obo:OAE_0004334>10077497</obo:OAE_0004334>
        <rdfs:label>sulcus vocalis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008150 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001250"/>
        <obo:IAO_0000115>This is an AE which is defined as a white oral lesion not related to another disease process.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28916027/</obo:IAO_0000119>
        <obo:OAE_0001849>口腔白斑</obo:OAE_0001849>
        <obo:OAE_0004334>10024396</obo:OAE_0004334>
        <rdfs:label>leukoplakia oral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008151 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is cancer of the lining of the lips, mouth, or upper throat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oral_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>唇癌或口腔癌</obo:OAE_0001849>
        <obo:OAE_0004334>10061523</obo:OAE_0004334>
        <rdfs:label>lip and/or oral cavity cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008152 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the mouth, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>口囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10028020</obo:OAE_0004334>
        <rdfs:label>mouth cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008153 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is a biofilm of microorganisms (mostly bacteria, but also fungi) that grows on surfaces within the mouth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dental_plaque</obo:IAO_0000119>
        <obo:OAE_0001849>口腔菌斑</obo:OAE_0001849>
        <obo:OAE_0004334>10028032</obo:OAE_0004334>
        <rdfs:label>mouth plaque AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008154 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which refres to the most frequent causes are lithiathesis and neoplasm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9487738/</obo:IAO_0000119>
        <obo:OAE_0001849>嘴巴肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10075203</obo:OAE_0004334>
        <rdfs:label>mouth swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008155 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a group of infections that occur around the oral cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mouth_infection</obo:IAO_0000119>
        <obo:OAE_0001849>口腔感染</obo:OAE_0001849>
        <obo:OAE_0004334>10048685</obo:OAE_0004334>
        <rdfs:label>oral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008156 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001131"/>
        <obo:IAO_0000115>This is an AE which is a chronic inflammatory and immune-mediated disease that affects the skin, nails, hair, and mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lichen_planus</obo:IAO_0000119>
        <obo:OAE_0001849>口腔扁平苔癣</obo:OAE_0001849>
        <obo:OAE_0004334>10030983</obo:OAE_0004334>
        <rdfs:label>oral lichen planus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008157 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is the mucous membrane lining the inside of the mouth and the membrane has haematoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oral_mucosa</obo:IAO_0000119>
        <obo:OAE_0001849>口腔黏膜血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10074779</obo:OAE_0004334>
        <rdfs:label>oral mucosa hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008158 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is the mucous membrane with blistering lining the inside of the mouth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oral_mucosa</obo:IAO_0000119>
        <obo:OAE_0001849>口腔粘膜引起水泡</obo:OAE_0001849>
        <obo:OAE_0004334>10030995</obo:OAE_0004334>
        <rdfs:label>oral mucosal blistering AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008159 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001250"/>
        <obo:IAO_0000115>This is an AE which  can occur due to a multitude of non-neoplastic causes because black and brown pigmentation . Endogenous or exogenous pigments may be responsible for oral discoloration which can range from innocuous to life-threatening in nature.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30671761/</obo:IAO_0000119>
        <obo:OAE_0001849>口腔黏膜变色</obo:OAE_0001849>
        <obo:OAE_0004334>10030996</obo:OAE_0004334>
        <rdfs:label>oral mucosal discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008160 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001250"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of oral mucosal due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>口腔粘膜肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10062956</obo:OAE_0004334>
        <rdfs:label>oral mucosal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008161 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001250"/>
        <obo:IAO_0000115>This is an AE which is a small (1- 2 mm) red or purple spot on the oral mucosal, caused by a minor bleed from broken capillary blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Petechia</obo:IAO_0000119>
        <obo:OAE_0001849>口腔粘膜瘀点</obo:OAE_0001849>
        <obo:OAE_0004334>10030998</obo:OAE_0004334>
        <rdfs:label>oral mucosal petechiae AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008162 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001250"/>
        <obo:IAO_0000115>This is an AE which is a hard coating on the skin formed during the wound healing reconstruction phase on the oral mucosal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scab</obo:IAO_0000119>
        <obo:OAE_0001849>口腔粘膜痂</obo:OAE_0001849>
        <obo:OAE_0004334>10082769</obo:OAE_0004334>
        <rdfs:label>oral mucosal scab AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008163 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001250"/>
        <obo:IAO_0000115>This is an AE which is a benign epithelial oral  tumor growing exophytically (outwardly projecting) in nipple-like and often finger-like fronds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papilloma</obo:IAO_0000119>
        <obo:OAE_0001849>口腔乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10068322</obo:OAE_0004334>
        <rdfs:label>oral papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008164 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002528"/>
        <obo:IAO_0000115>This is an AE which is a small, well-defined bump in the oral skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papule</obo:IAO_0000119>
        <obo:OAE_0001849>口腔丘疹</obo:OAE_0001849>
        <obo:OAE_0004334>10031010</obo:OAE_0004334>
        <rdfs:label>oral papule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008165 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch on the oral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>口腔瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10052894</obo:OAE_0004334>
        <rdfs:label>oral pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008166 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an organism&apos;s oral tissues by disease-causing agents such as bacterial, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection#Bacterial_or_viral</obo:IAO_0000119>
        <obo:OAE_0001849>口腔细菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065233</obo:OAE_0004334>
        <rdfs:label>oral bacterial infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008167 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is oral disease caused by fungi .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fungal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>口腔真菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061324</obo:OAE_0004334>
        <rdfs:label>oral fungal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008168 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the oral skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>感觉异常口腔</obo:OAE_0001849>
        <obo:OAE_0004334>10057372</obo:OAE_0004334>
        <rdfs:label>paraesthesia oral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008169 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which refers to comprise a number of different types of oral cancer that result from squamous cells .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Squamous_cell_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>口腔鳞状细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10041857</obo:OAE_0004334>
        <rdfs:label>squamous cell carcinoma of the oral cavity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008170 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000608"/>
        <obo:IAO_0000115>This is an AE which is inflammation with haemorrhagic of the mouth and lips.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stomatitis</obo:IAO_0000119>
        <obo:OAE_0001849>出血性口炎</obo:OAE_0001849>
        <obo:OAE_0004334>10042132</obo:OAE_0004334>
        <rdfs:label>stomatitis haemorrhagic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008171 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000608"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the mouth and lips and sometimes can lead with necrotising.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/?term=stomatitis+necrotising</obo:IAO_0000119>
        <obo:OAE_0001849>口炎坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10042135</obo:OAE_0004334>
        <rdfs:label>stomatitis necrotising AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008172 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000608"/>
        <obo:IAO_0000115>This is an AE which is a common condition characterized by the repeated formation of benign and non-contagious mouth ulcers (aphthae) in otherwise healthy individuals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aphthous_stomatitis</obo:IAO_0000119>
        <obo:OAE_0001849>口腔炎</obo:OAE_0001849>
        <obo:OAE_0004334>10002958</obo:OAE_0004334>
        <rdfs:label>aphthous stomatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008174 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a burning sensation in the mouth with no underlying known dental or medical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Burning_mouth_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>灼烧口腔综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10068065</obo:OAE_0004334>
        <rdfs:label>burning mouth syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008175 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the circumoral tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>口腔周围水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10052250</obo:OAE_0004334>
        <rdfs:label>circumoral edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008176 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which refers to a transient abnormal enlargement of circumoral tissue not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>口腔周围肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10081703</obo:OAE_0004334>
        <rdfs:label>circumoral swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008177 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which is a disorder that is caused by the reactivation of varicella zoster virus in the geniculate ganglion, a nerve cell bundle of the facial nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ramsay_Hunt_syndrome_type_2</obo:IAO_0000119>
        <obo:OAE_0001849>口腔带状疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10063491</obo:OAE_0004334>
        <rdfs:label>herpes zoster oticus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008178 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>舌头变色</obo:OAE_0001849>
        <obo:OAE_0004334>10043949</obo:OAE_0004334>
        <rdfs:label>tongue discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008179 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>吐舌</obo:OAE_0001849>
        <obo:OAE_0004334>10052002</obo:OAE_0004334>
        <rdfs:label>tongue eruption AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008180 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>牙龈侵蚀</obo:OAE_0001849>
        <obo:OAE_0004334>10018282</obo:OAE_0004334>
        <rdfs:label>gingival erosion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008181 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>毛舌症</obo:OAE_0001849>
        <obo:OAE_0004334>10080276</obo:OAE_0004334>
        <rdfs:label>trichoglossia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008182 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001247"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>粘膜糜烂</obo:OAE_0001849>
        <obo:OAE_0004334>10061297</obo:OAE_0004334>
        <rdfs:label>mucosal erosion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008183 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>舌头运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10043963</obo:OAE_0004334>
        <rdfs:label>tongue movement disturbance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008184 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a seizure in a baby younger than 4 weeks old. Seizures are abnormally excessive or synchronous neuronal activity in the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_seizure</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿癫痫发作</obo:OAE_0001849>
        <obo:OAE_0004334>10082067</obo:OAE_0004334>
        <rdfs:label>neonatal seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008185 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is defined as having a temperature above the normal range due to an increase in the body&apos;s temperature set point occured on the neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fever</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿发烧</obo:OAE_0001849>
        <obo:OAE_0004334>10016562</obo:OAE_0004334>
        <rdfs:label>fever neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008186 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a rare but serious, even fatal, side effect that occurs in newborn infants (especially premature babies) following the accumulation of antibiotic chloramphenicol.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gray_baby_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>灰婴综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10018723</obo:OAE_0004334>
        <rdfs:label>grey syndrome neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008187 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is different from the disorder affecting older children and adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29345589/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10028934</obo:OAE_0004334>
        <rdfs:label>neonatal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008188 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a medical condition where neonatal  body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Convulsion</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿惊厥</obo:OAE_0001849>
        <obo:OAE_0004334>10010911</obo:OAE_0004334>
        <rdfs:label>convulsion neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008189 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a bacterial tetanus neonatorum infection characterized by muscle spasms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tetanus</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿破伤风</obo:OAE_0001849>
        <obo:OAE_0004334>10043378</obo:OAE_0004334>
        <rdfs:label>tetanus neonatorum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008190 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the neonatal body or a region of the body is deprived of adequate oxygen supply at the tissue level.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoxia_(medical)</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿缺氧</obo:OAE_0001849>
        <obo:OAE_0004334>10050081</obo:OAE_0004334>
        <rdfs:label>neonatal hypoxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008191 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a neonatal state of strong desire for sleep, or sleeping for unusually long periods (compare hypersomnia).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Somnolence</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿嗜睡</obo:OAE_0001849>
        <obo:OAE_0004334>10041350</obo:OAE_0004334>
        <rdfs:label>somnolence neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008192 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which due to renal tubular dysgenesis, secondary to the use of angiotensin converting enzyme inhibitor (ACEI) during pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/12657763/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿无尿症</obo:OAE_0001849>
        <obo:OAE_0004334>10049778</obo:OAE_0004334>
        <rdfs:label>neonatal anuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008193 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is the group of  neonatal symptoms that occur upon the abrupt discontinuation or decrease in the intake of medicational or recreational drugs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Drug_withdrawal</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿药物戒断综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10013756</obo:OAE_0004334>
        <rdfs:label>drug withdrawal syndrome neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008194 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a complex task, as in newborns hypotonia can be the presenting sign of different underlying causes, including peripheral and central nervous system involvement and genetic and metabolic diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31324324/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿张力减退</obo:OAE_0001849>
        <obo:OAE_0004334>10021119</obo:OAE_0004334>
        <rdfs:label>hypotonia neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008195 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is an involuntary, somewhat rhythmic, muscle contraction and relaxation involving oscillations or twitching movements of one or more neonatal body parts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tremor</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10044575</obo:OAE_0004334>
        <rdfs:label>tremor neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008196 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000431"/>
        <obo:IAO_0000115>This is an AE which is the sudden unexplained death of a child of less than one year of age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sudden_infant_death_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿猝死综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10042440</obo:OAE_0004334>
        <rdfs:label>sudden infant death syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008197 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is characterized by the rapid onset of annular purpuric lesions associated with initially localized edemas affecting the extremities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31692802/</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿急性出血性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10070599</obo:OAE_0004334>
        <rdfs:label>acute haemorrhagic edema of infancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008198 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>This is an AE which is an uncommon-to-rare epileptic disorder in infants, children and adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epileptic_spasms</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿痉挛症</obo:OAE_0001849>
        <obo:OAE_0004334>10021750</obo:OAE_0004334>
        <rdfs:label>infantile spasms AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008199 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is described in clinical literature as a severe and relatively uncommon disorder that can affect children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reactive_attachment_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿期或幼儿期的反应性依恋障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10037996</obo:OAE_0004334>
        <rdfs:label>reactive attachment disorder of infancy or early childhood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008200 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000974"/>
        <obo:IAO_0000115>This is an AE which is a infantile condition in which stomach contents rise up into the esophagus, resulting in either symptoms or complications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastroesophageal_reflux_disease</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿吐奶</obo:OAE_0001849>
        <obo:OAE_0004334>10063338</obo:OAE_0004334>
        <rdfs:label>infantile spitting up AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008201 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002577"/>
        <obo:IAO_0000115>This is an AE which due to appearance, is a type of benign vascular tumor or anomaly that affects babies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infantile_hemangioma</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿血管瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10075378</obo:OAE_0004334>
        <rdfs:label>infantile haemangioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008202 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001105"/>
        <obo:IAO_0000115>This is an AE which is the excitatory ability that  infants have to respond to changes in their environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritability</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿易怒</obo:OAE_0001849>
        <obo:OAE_0004334>10082189</obo:OAE_0004334>
        <rdfs:label>infant irritability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008203 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000393"/>
        <obo:IAO_0000115>This is an AE which is defined as episodes of crying for more than three hours a day, for more than three days a week, for three weeks in an otherwise healthy child.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Baby_colic</obo:IAO_0000119>
        <obo:OAE_0001849>小儿疝气</obo:OAE_0001849>
        <obo:OAE_0004334>10021746</obo:OAE_0004334>
        <rdfs:label>infantile colic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008204 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000411"/>
        <obo:IAO_0000115>This is an AE which is a long-term inflammatory infantile disease of the airways of the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Asthma</obo:IAO_0000119>
        <obo:OAE_0001849>小儿哮喘</obo:OAE_0001849>
        <obo:OAE_0004334>10049585</obo:OAE_0004334>
        <rdfs:label>infantile asthma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008205 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is an foetal abnormality of the structure of a body part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10060919</obo:OAE_0004334>
        <rdfs:label>foetal malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008206 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is a condition during pregnancy or labor in which the fetus shows signs of inadequate oxygenation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fetal_distress</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿窘迫综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10016855</obo:OAE_0004334>
        <rdfs:label>foetal distress syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008207 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is defined as birth weight &gt;4000 g and is associated with several maternal and fetal complications such as maternal birth canal trauma, shoulder dystocia, and perinatal asphyxia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27727018/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿巨大胎儿</obo:OAE_0001849>
        <obo:OAE_0004334>10053700</obo:OAE_0004334>
        <rdfs:label>foetal macrosomia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008208 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>This is an AE which is a rare disease that is identified by an abnormally large or distended bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Megacystis_(fetal)</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿巨囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10073660</obo:OAE_0004334>
        <rdfs:label>foetal megacystis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008209 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is the loss of fetal blood cells into the maternal circulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fetal-maternal_haemorrhage</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿-母体出血</obo:OAE_0001849>
        <obo:OAE_0004334>10016871</obo:OAE_0004334>
        <rdfs:label>foetal-maternal hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008210 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002724"/>
        <obo:IAO_0000115>This is an AE which is an abnormal growth that usually appears on a baby&apos;s neck or head.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cystic_hygroma</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿囊性水囊瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10052011</obo:OAE_0004334>
        <rdfs:label>foetal cystic hygroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008211 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is a common complication of pregnancy that has been associated with a variety of adverse perinatal outcomes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30681542/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿生长受限</obo:OAE_0001849>
        <obo:OAE_0004334>10070531</obo:OAE_0004334>
        <rdfs:label>foetal growth restriction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008212 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is damage to the foetal body caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10016852</obo:OAE_0004334>
        <rdfs:label>foetal damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008213 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which leads to greater risk of cesarean delivery, prolonged labor, and increased perinatal morbidity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25851845/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿胎位不正</obo:OAE_0001849>
        <obo:OAE_0004334>10016863</obo:OAE_0004334>
        <rdfs:label>foetal malposition AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008214 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is irregular positions of the crown of the fetal head in relation to the mother&apos;s pelvis (the fetus is in an abnormal position).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prolonged_labor#Fetal_malpresentations_%5B9%5D</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿先露异常</obo:OAE_0001849>
        <obo:OAE_0004334>10058013</obo:OAE_0004334>
        <rdfs:label>foetal malpresentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008215 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001453"/>
        <obo:IAO_0000115>This is an AE which is defined as a heart rate less than 100 BPM (normal is around 120–160 BPM).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bradycardia#Infantile</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿心动过缓</obo:OAE_0001849>
        <obo:OAE_0004334>10006094</obo:OAE_0004334>
        <rdfs:label>bradycardia foetal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008216 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001453"/>
        <obo:IAO_0000115>This is an AE which is non-reassuring fetal heart rate characteristics, which do not uniformly predict poor fetal outcome but can prompt obstetricians to proceed with cesarean delivery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32839938/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿心率减慢</obo:OAE_0001849>
        <obo:OAE_0004334>10058322</obo:OAE_0004334>
        <rdfs:label>foetal heart rate deceleration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008217 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000421"/>
        <obo:IAO_0000115>This is an AE which encompasses a broad spectrum of disorders, united by impaired movement in utero.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29959180/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿运动功能减退</obo:OAE_0001849>
        <obo:OAE_0004334>10068461</obo:OAE_0004334>
        <rdfs:label>foetal hypokinesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008218 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which refers to any clinical foetal syndrome with either an excess of movement or a paucity of voluntary and involuntary movements, unrelated to weakness or spasticity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Movement_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077576</obo:OAE_0004334>
        <rdfs:label>foetal movement disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008219 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the earliest stool of a mammalian infant resulting from defecation and is stain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meconium</obo:IAO_0000119>
        <obo:OAE_0001849>胎粪染色</obo:OAE_0001849>
        <obo:OAE_0004334>10057028</obo:OAE_0004334>
        <rdfs:label>meconium stain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008220 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is breakage of the amniotic sac before the onset of labor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prelabor_rupture_of_membranes</obo:IAO_0000119>
        <obo:OAE_0001849>胎膜早破</obo:OAE_0001849>
        <obo:OAE_0004334>10036603</obo:OAE_0004334>
        <rdfs:label>premature rupture of membranes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008221 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which defined as rupture of fetal membranes prior to 28 weeks of gestation, complicates approximately 0.4%-0.7% of all pregnancies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28710882/</obo:IAO_0000119>
        <obo:OAE_0001849>胎膜早破</obo:OAE_0001849>
        <obo:OAE_0004334>10073024</obo:OAE_0004334>
        <rdfs:label>preterm premature rupture of membranes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008222 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is when the placenta separates early from the uterus, in other words separates before childbirth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Placental_abruption</obo:IAO_0000119>
        <obo:OAE_0001849>胎盘过早分离</obo:OAE_0001849>
        <obo:OAE_0004334>10036608</obo:OAE_0004334>
        <rdfs:label>premature separation of placenta AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008223 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is often defined as the loss of more than 500 ml or 1,000 ml of blood within the first 24 hours following childbirth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Postpartum_bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>产后出血</obo:OAE_0001849>
        <obo:OAE_0004334>10036417</obo:OAE_0004334>
        <rdfs:label>postpartum hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008224 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is among the leading causes of preventable maternal morbidity and mortality not only in developing countries but in developed countries as well.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17511893/</obo:IAO_0000119>
        <obo:OAE_0001849>产后发热</obo:OAE_0001849>
        <obo:OAE_0004334>10037294</obo:OAE_0004334>
        <rdfs:label>puerperal pyrexia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008225 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which is a type of mood disorder associated with childbirth, which can affect both sexes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Postpartum_depression</obo:IAO_0000119>
        <obo:OAE_0001849>产后抑郁症</obo:OAE_0001849>
        <obo:OAE_0004334>10056393</obo:OAE_0004334>
        <rdfs:label>postpartum depression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008226 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which refers psychological trauma to the mother following childbirth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_trauma</obo:IAO_0000119>
        <obo:OAE_0001849>产伤</obo:OAE_0001849>
        <obo:OAE_0004334>10004954</obo:OAE_0004334>
        <rdfs:label>birth trauma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008227 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the culmination of one multiple pregnancy, wherein the mother gives birth to two or more offspring.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_birth</obo:IAO_0000119>
        <obo:OAE_0001849>多胎妊娠</obo:OAE_0001849>
        <obo:OAE_0004334>10028243</obo:OAE_0004334>
        <rdfs:label>multiple pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008228 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000306"/>
        <obo:IAO_0000115>This is an AE which is a medical condition where children body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Convulsion</obo:IAO_0000119>
        <obo:OAE_0001849>小儿抽搐</obo:OAE_0001849>
        <obo:OAE_0004334>10052391</obo:OAE_0004334>
        <rdfs:label>convulsion in childhood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008229 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002752"/>
        <obo:IAO_0000115>This is an AE which is an abnormal condition of the children mind that results in difficulties determining what is real and what is not real.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychosis</obo:IAO_0000119>
        <obo:OAE_0001849>儿童精神病</obo:OAE_0001849>
        <obo:OAE_0004334>10061040</obo:OAE_0004334>
        <rdfs:label>childhood psychosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008230 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000433"/>
        <obo:IAO_0000115>This is an AE which is a class of mental children disorders characterized by enduring maladaptive patterns of behavior, cognition, and inner experience, exhibited across many contexts and deviating from those accepted by the individual&apos;s culture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Personality_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>儿童人格障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10034723</obo:OAE_0004334>
        <rdfs:label>personality disorder of childhood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008231 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000411"/>
        <obo:IAO_0000115>This is an AE which is a children long-term inflammatory disease of the airways of the lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Asthma</obo:IAO_0000119>
        <obo:OAE_0001849>儿童哮喘</obo:OAE_0001849>
        <obo:OAE_0004334>10081274</obo:OAE_0004334>
        <rdfs:label>childhood asthma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008232 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the ending of pregnancy where one or more babies leaves the uterus by passing through the vagina or by Caesarean section.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childbirth</obo:IAO_0000119>
        <obo:OAE_0001849>分娩</obo:OAE_0001849>
        <obo:OAE_0004334>10067647</obo:OAE_0004334>
        <rdfs:label>delivery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008233 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which includes obstructed labour,eclampsia and so on.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childbirth#Labour_and_delivery_complications</obo:IAO_0000119>
        <obo:OAE_0001849>分娩并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10061781</obo:OAE_0004334>
        <rdfs:label>complication of delivery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008234 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which includes obstructed labour,eclampsia and so on.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childbirth#Labour_and_delivery_complications</obo:IAO_0000119>
        <obo:OAE_0001849>分娩合并症</obo:OAE_0001849>
        <obo:OAE_0004334>10061050</obo:OAE_0004334>
        <rdfs:label>labour complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008235 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is normally the most painful event in a woman&apos;s lifetime.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28648158/</obo:IAO_0000119>
        <obo:OAE_0001849>分娩疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10059204</obo:OAE_0004334>
        <rdfs:label>labour pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008236 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004381"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by the rubella virus  in pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rubella</obo:IAO_0000119>
        <obo:OAE_0001849>怀孕期间风疹</obo:OAE_0001849>
        <obo:OAE_0004334>10039264</obo:OAE_0004334>
        <rdfs:label>rubella in pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008237 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is a term used to describe infants that are born with an abnormally high weight, specifically in the 90th percentile or above, compared to other babies of the same developmental age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Large_for_gestational_age</obo:IAO_0000119>
        <obo:OAE_0001849>巨大胎儿</obo:OAE_0001849>
        <obo:OAE_0004334>10025394</obo:OAE_0004334>
        <rdfs:label>macrosomia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008238 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is a condition characterized by excessive growth and height significantly above average.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gigantism</obo:IAO_0000119>
        <obo:OAE_0001849>巨人症</obo:OAE_0001849>
        <obo:OAE_0004334>10018265</obo:OAE_0004334>
        <rdfs:label>gigantism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008239 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is associated with adverse pregnancy outcomes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29746025/</obo:IAO_0000119>
        <obo:OAE_0001849>脐带短</obo:OAE_0001849>
        <obo:OAE_0004334>10045453</obo:OAE_0004334>
        <rdfs:label>umbilical cord short AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008240 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is when the umbilical cord becomes wrapped around the fetus&apos;s neck.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nuchal_cord</obo:IAO_0000119>
        <obo:OAE_0001849>脐带绕脖</obo:OAE_0001849>
        <obo:OAE_0004334>10045447</obo:OAE_0004334>
        <rdfs:label>umbilical cord around neck AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008241 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is when the umbilical cord comes out of the uterus with or before the presenting part of the baby.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Umbilical_cord_prolapse</obo:IAO_0000119>
        <obo:OAE_0001849>脐带脱垂</obo:OAE_0001849>
        <obo:OAE_0004334>10045452</obo:OAE_0004334>
        <rdfs:label>umbilical cord prolapse AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008242 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is the obstruction of blood flow through the umbilical cord secondary to pressure from an external object or misalignment of the cord itself.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Umbilical_cord_compression</obo:IAO_0000119>
        <obo:OAE_0001849>压缩性脐带</obo:OAE_0001849>
        <obo:OAE_0004334>10045451</obo:OAE_0004334>
        <rdfs:label>umbilical cord compression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008243 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the connective tissue of the umbilical cord that occurs with chorioamnionitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Funisitis</obo:IAO_0000119>
        <obo:OAE_0001849>脐带炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064502</obo:OAE_0004334>
        <rdfs:label>funisitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008244 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is the most common umbilical abnormality in neonates, causing inflammation and drainage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Umbilical_granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>脐肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10067731</obo:OAE_0004334>
        <rdfs:label>umbilical granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008245 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is a health condition where the abdominal wall behind the navel is damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Umbilical_hernia</obo:IAO_0000119>
        <obo:OAE_0001849>脐疝</obo:OAE_0001849>
        <obo:OAE_0004334>10045458</obo:OAE_0004334>
        <rdfs:label>umbilical hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008246 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is a rare abdominal wall defect.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Omphalocele</obo:IAO_0000119>
        <obo:OAE_0001849>脐突出</obo:OAE_0001849>
        <obo:OAE_0004334>10015677</obo:OAE_0004334>
        <rdfs:label>exomphalos AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008247 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the medical term for inflammation of the umbilical cord stump in the neonatal newborn period, most commonly attributed to a bacterial infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Omphalitis_of_newborn</obo:IAO_0000119>
        <obo:OAE_0001849>脐炎</obo:OAE_0001849>
        <obo:OAE_0004334>10030306</obo:OAE_0004334>
        <rdfs:label>omphalitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008248 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is health problems that are related to pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complications_of_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10061452</obo:OAE_0004334>
        <rdfs:label>complication of pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008249 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a chronic hives-like rash that strikes some women during pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pruritic_urticarial_papules_and_plaques_of_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠多形性爆发</obo:OAE_0001849>
        <obo:OAE_0004334>10066100</obo:OAE_0004334>
        <rdfs:label>polymorphic eruption of pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008250 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a pregnancy complication that is characterized by severe nausea, vomiting, weight loss, and possibly dehydration.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperemesis_gravidarum</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠剧吐</obo:OAE_0001849>
        <obo:OAE_0004334>10020614</obo:OAE_0004334>
        <rdfs:label>hyperemesis gravidarum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008251 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is when a woman has not yet delivered her baby after 42 weeks of gestation, two weeks beyond the typical 40-week duration of pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Postterm_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠期延长</obo:OAE_0001849>
        <obo:OAE_0004334>10036877</obo:OAE_0004334>
        <rdfs:label>prolonged pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008252 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the fetal membranes (amnion and chorion), usually due to bacterial infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chorioamnionitis</obo:IAO_0000119>
        <obo:OAE_0001849>绒毛膜羊膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008755</obo:OAE_0004334>
        <rdfs:label>chorioamnionitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008253 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is two offspring produced by the same pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Twin</obo:IAO_0000119>
        <obo:OAE_0001849>双胎妊娠</obo:OAE_0001849>
        <obo:OAE_0004334>10045188</obo:OAE_0004334>
        <rdfs:label>twin pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008254 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is when a baby is born bottom first instead of head first, as is normal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Breech_birth</obo:IAO_0000119>
        <obo:OAE_0001849>臀位分娩</obo:OAE_0001849>
        <obo:OAE_0004334>10006346</obo:OAE_0004334>
        <rdfs:label>breech delivery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008255 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is when a baby is born bottom first instead of head first, as is normal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Breech_birth</obo:IAO_0000119>
        <obo:OAE_0001849>后肢先产</obo:OAE_0001849>
        <obo:OAE_0004334>10006356</obo:OAE_0004334>
        <rdfs:label>breech presentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008256 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000697"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood vessels on the peripartum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>围产期出血</obo:OAE_0001849>
        <obo:OAE_0004334>10072693</obo:OAE_0004334>
        <rdfs:label>peripartum hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008257 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000500"/>
        <obo:IAO_0000115>This is an AE which includes major and minor depressive episodes that occur during pregnancy or in the first 12 months after delivery, is one of the most common medical complications during pregnancy and the postpartum period, affecting one in seven women.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30629567/</obo:IAO_0000119>
        <obo:OAE_0001849>围产期抑郁症</obo:OAE_0001849>
        <obo:OAE_0004334>10078366</obo:OAE_0004334>
        <rdfs:label>perinatal depression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008258 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a congenital disorder with unknown cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Constriction_ring_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>羊膜带综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10064100</obo:OAE_0004334>
        <rdfs:label>amniotic band syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which containing the amniotic fluid and the embryo and its becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amniotic_sac</obo:IAO_0000119>
        <obo:OAE_0001849>羊膜腔疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10060936</obo:OAE_0004334>
        <rdfs:label>amniotic cavity disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008260 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a medical condition describing an excess of amniotic fluid in the amniotic sac.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyhydramnios</obo:IAO_0000119>
        <obo:OAE_0001849>羊水过多</obo:OAE_0001849>
        <obo:OAE_0004334>10036079</obo:OAE_0004334>
        <rdfs:label>polyhydramnios AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008261 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in pregnancy characterized by a deficiency of amniotic fluid, the fluid that surrounds the fetus in the abdomen, in the amniotic sac.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oligohydramnios</obo:IAO_0000119>
        <obo:OAE_0001849>羊水过少</obo:OAE_0001849>
        <obo:OAE_0004334>10030289</obo:OAE_0004334>
        <rdfs:label>oligohydramnios AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008262 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is a complication of pregnancy in which the embryo attaches outside the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ectopic_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>异位妊娠</obo:OAE_0001849>
        <obo:OAE_0004334>10014166</obo:OAE_0004334>
        <rdfs:label>ectopic pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008263 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the birth of a baby at fewer than 37 weeks gestational age, as opposed to full-term delivery at approximately 40 weeks but the baby is dead.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Preterm_birth</obo:IAO_0000119>
        <obo:OAE_0001849>早产儿死亡</obo:OAE_0001849>
        <obo:OAE_0004334>10076700</obo:OAE_0004334>
        <rdfs:label>premature baby death AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008264 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000485"/>
        <obo:IAO_0000115>This is an AE which is the termination of a pregnancy by removal or expulsion of an embryo or fetus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abortion</obo:IAO_0000119>
        <obo:OAE_0001849>早期流产</obo:OAE_0001849>
        <obo:OAE_0004334>10052846</obo:OAE_0004334>
        <rdfs:label>abortion early AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008265 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000485"/>
        <obo:IAO_0000115>This is an AE which is the natural loss of an embryo or fetus before it is able to survive independently.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Miscarriage</obo:IAO_0000119>
        <obo:OAE_0001849>终止妊娠</obo:OAE_0001849>
        <obo:OAE_0004334>10000209</obo:OAE_0004334>
        <rdfs:label>aborted pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008266 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is typically defined as fetal death at or after 20 or 28 weeks of pregnancy, depending on the source.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stillbirth</obo:IAO_0000119>
        <obo:OAE_0001849>死胎</obo:OAE_0001849>
        <obo:OAE_0004334>10042062</obo:OAE_0004334>
        <rdfs:label>stillbirth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008267 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <obo:IAO_0000115>This is an AE which is used for describing children presenting with muscle hypotonia at or shortly after birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26573950/</obo:IAO_0000119>
        <obo:OAE_0001849>松软婴儿</obo:OAE_0001849>
        <obo:OAE_0004334>10051004</obo:OAE_0004334>
        <rdfs:label>floppy infant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008268 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is considered an important contributor to neonatal morbidity and mortality in low-resource settings.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21094417/</obo:IAO_0000119>
        <obo:OAE_0001849>低体温新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10050080</obo:OAE_0004334>
        <rdfs:label>hypothermia neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008269 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is the inmature liver storage of glucose seen in preterms or children born intrauterine growth retarded.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32741157/</obo:IAO_0000119>
        <obo:OAE_0001849>低血糖新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10020994</obo:OAE_0004334>
        <rdfs:label>hypoglycaemia neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008270 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is a yellowish discoloration of the white part of the eyes and skin in a newborn baby due to high bilirubin levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_jaundice</obo:IAO_0000119>
        <obo:OAE_0001849>黄疸新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10023138</obo:OAE_0004334>
        <rdfs:label>jaundice neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008271 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is a long-term type of inflammation of the skin (dermatitis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atopic_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>湿疹婴儿</obo:OAE_0001849>
        <obo:OAE_0004334>10014198</obo:OAE_0004334>
        <rdfs:label>eczema infantile AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008272 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which can be part of a mental illness or a side effect of anti-psychotic medication on neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Agitation</obo:IAO_0000119>
        <obo:OAE_0001849>躁动新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10001500</obo:OAE_0004334>
        <rdfs:label>agitation neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008273 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is pregnancies that are mistimed, unplanned or unwanted at the time of conception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Unintended_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>意外怀孕</obo:OAE_0001849>
        <obo:OAE_0004334>10046267</obo:OAE_0004334>
        <rdfs:label>unwanted pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008274 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which occurs when a fetus, whatever its gestational age, exits the maternal body and subsequently shows any sign of life, such as voluntary movement, heartbeat, or pulsation of the umbilical cord, for however brief a time and regardless of whether the umbilical cord or placenta are intact.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Live_birth_(human)</obo:IAO_0000119>
        <obo:OAE_0001849>活产</obo:OAE_0001849>
        <obo:OAE_0004334>10049550</obo:OAE_0004334>
        <rdfs:label>live birth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008275 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is related to the appearance of postpartum haemorrhage due to posterior uterine atony.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28765661/</obo:IAO_0000119>
        <obo:OAE_0001849>急产</obo:OAE_0001849>
        <obo:OAE_0004334>10036519</obo:OAE_0004334>
        <rdfs:label>precipitate labour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008276 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is when, after vaginal delivery of the head, the baby&apos;s anterior shoulder gets caught above the mother&apos;s pubic bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shoulder_dystocia</obo:IAO_0000119>
        <obo:OAE_0001849>肩难产</obo:OAE_0001849>
        <obo:OAE_0004334>10040613</obo:OAE_0004334>
        <rdfs:label>shoulder dystocia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008277 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is when the baby does not exit the pelvis during childbirth due to being physically blocked, despite the uterus contracting normally.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Obstructed_labour</obo:IAO_0000119>
        <obo:OAE_0001849>难产</obo:OAE_0001849>
        <obo:OAE_0004334>10029934</obo:OAE_0004334>
        <rdfs:label>obstructed labour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008278 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is a situation at childbirth where the fetus is in a longitudinal lie and the head enters the pelvis first; the most common form of cephalic presentation is the vertex presentation, where the occiput is the leading part (the part that first enters the birth canal).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cephalic_presentation</obo:IAO_0000119>
        <obo:OAE_0001849>额先露</obo:OAE_0001849>
        <obo:OAE_0004334>10052848</obo:OAE_0004334>
        <rdfs:label>brow presentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008279 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is one where the mother or the fetus has an increased risk of adverse outcomes compared to uncomplicated pregnancies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/High-risk_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>高危妊娠</obo:OAE_0001849>
        <obo:OAE_0004334>10052744</obo:OAE_0004334>
        <rdfs:label>high risk pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008280 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is a health condition where the abdominal wall behind the navel is damaged and is also incarcerated.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/?term=incarcerated+umbilical+hernia</obo:IAO_0000119>
        <obo:OAE_0001849>嵌顿性脐疝</obo:OAE_0001849>
        <obo:OAE_0004334>10064492</obo:OAE_0004334>
        <rdfs:label>incarcerated umbilical hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008281 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic disorder of the small intestine that is inherited in an autosomal recessive pattern.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Microvillous_inclusion_disease</obo:IAO_0000119>
        <obo:OAE_0001849>微绒毛包涵体疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10068494</obo:OAE_0004334>
        <rdfs:label>microvillous inclusion disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008282 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003235"/>
        <obo:IAO_0000115>This is an AE which make it difficult to initiate breastfeeding for these high-risk infants.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22301537/</obo:IAO_0000119>
        <obo:OAE_0001849>吸吮反射差</obo:OAE_0001849>
        <obo:OAE_0004334>10058605</obo:OAE_0004334>
        <rdfs:label>poor sucking reflex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008283 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the ending of pregnancy where one or more babies leaves the uterus by passing through the vagina or by Caesarean section and is traumatic .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childbirth</obo:IAO_0000119>
        <obo:OAE_0001849>创伤性分娩</obo:OAE_0001849>
        <obo:OAE_0004334>10044520</obo:OAE_0004334>
        <rdfs:label>traumatic delivery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008284 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is designed to allow the remaining fetus(es) to develop after premature expulsion of the first twin in the second trimester of pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33235650/</obo:IAO_0000119>
        <obo:OAE_0001849>延迟分娩</obo:OAE_0001849>
        <obo:OAE_0004334>10012186</obo:OAE_0004334>
        <rdfs:label>delayed delivery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008285 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000115>This is an AE which is a common complication of pregnancy that has been associated with a variety of adverse perinatal outcomes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30681542/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿生长迟缓</obo:OAE_0001849>
        <obo:OAE_0004334>10016857</obo:OAE_0004334>
        <rdfs:label>foetal growth retardation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008286 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000914"/>
        <obo:IAO_0000115>This is an AE which refer to a disability classification used in educational settings that allows educational institutions to provide special education and related services to students who have displayed poor social and/or academic progress.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Emotional_and_behavioral_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>儿童情绪障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10014552</obo:OAE_0004334>
        <rdfs:label>emotional disorder of childhood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008287 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000393"/>
        <obo:IAO_0000115>This is an AE which is an effect of kernicterus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_jaundice</obo:IAO_0000119>
        <obo:OAE_0001849>哭泣的声音尖锐</obo:OAE_0001849>
        <obo:OAE_0004334>10052286</obo:OAE_0004334>
        <rdfs:label>high-pitched crying AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008288 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>婴儿背拱起</obo:OAE_0001849>
        <obo:OAE_0004334>10077276</obo:OAE_0004334>
        <rdfs:label>infantile back arching AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008289 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>胎儿不下</obo:OAE_0001849>
        <obo:OAE_0004334>10059107</obo:OAE_0004334>
        <rdfs:label>missed labour AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008290 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000519"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>胎儿心率紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10061158</obo:OAE_0004334>
        <rdfs:label>foetal heart rate disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008291 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008291">
