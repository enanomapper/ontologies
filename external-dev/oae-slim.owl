    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002806"/>
        <obo:IAO_0000115>A breast atrophy AE that has asymmetry &gt;1/3 of breast volume; severe atrophy</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 breast atrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13072</rdfs:seeAlso>
