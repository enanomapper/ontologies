    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004610 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000115>This is an AE which is the formation of a blood clot inside a truncus coeliacus blood vessel, obstructing the flow of blood through the circulatory system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
