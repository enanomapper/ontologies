    <!-- http://purl.obolibrary.org/obo/OAE_0004606 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <obo:IAO_0000115>This is an AE which is defined as a gap of about 2.7 cm or greater between the two sides of the rectus abdominis muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
