    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is the irritation of the skin at the exit of the rectum, known as the anus, causing the desire to scratch.</obo:IAO_0000115>
