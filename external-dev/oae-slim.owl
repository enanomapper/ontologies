    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009344 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001975"/>
        <obo:IAO_0000115>This is an AE which is when a solid piece of material (kidney stone) develops in the urinary tract.</obo:IAO_0000115>
