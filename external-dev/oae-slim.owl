    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007264 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000005"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>给予额外剂量</obo:OAE_0001849>
