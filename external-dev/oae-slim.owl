        <obo:OAE_0004334>10012493</obo:OAE_0004334>
        <rdfs:label>dermatochalasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008951 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a rare locally aggressive malignant cutaneous soft-tissue sarcoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
