        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is any part of an animal or plant that is involved in sexual reproduction and is  enlarged.</obo:IAO_0000115>
