        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is the most common benign tumor of the uterus found in women of reproductive age.</obo:IAO_0000115>
