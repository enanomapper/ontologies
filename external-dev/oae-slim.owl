        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002771"/>
        <obo:IAO_0000115>This is an AE which is known as tracheitis, usually due to an infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trachea#Inflammation_and_infection</obo:IAO_0000119>
