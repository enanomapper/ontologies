    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005143 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a sudden loss of blood flow resulting from the failure of the heart to pump effectively occured on neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿心脏骤停</obo:OAE_0001849>
        <obo:OAE_0004334>10007516</obo:OAE_0004334>
        <rdfs:label>cardiac arrest neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005144 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000411"/>
        <obo:IAO_0000115>This is an AE which is a medical diagnosis of wheezing, coughing, dyspnea, bloody sputum, or shortness of breath due to congestive heart failure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_asthma</obo:IAO_0000119>
