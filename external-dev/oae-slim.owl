        <obo:OAE_0004334>10067383</obo:OAE_0004334>
        <rdfs:label>abdominal wall hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004595 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000241"/>
        <obo:IAO_0000115>This is an AE which was unencapsulated and had no distinct borders and  was infiltrative and composed of bundles and sheets of densely packed fusiform cells on the abdominal wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24442574/</obo:IAO_0000119>
        <obo:OAE_0001849>腹壁肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10063005</obo:OAE_0004334>
        <rdfs:label>abdominal wall mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004596 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases involving abnormal cell growth with the potential to invade or spread to other parts of abdominal wall .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cancer</obo:IAO_0000119>
        <obo:OAE_0001849>恶性腹壁肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10071023</obo:OAE_0004334>
        <rdfs:label>abdominal wall neoplasm malignant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004597 -->


