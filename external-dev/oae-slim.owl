        <obo:IAO_0000119>http://en.volupedia.org/wiki/Liver_injury</obo:IAO_0000119>
        <obo:OAE_0001849>肝损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10067125</obo:OAE_0004334>
