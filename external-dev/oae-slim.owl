        <rdfs:seeAlso>NCIt: C35145</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003242 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000911"/>
