        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <obo:IAO_0000115>Persistent vomiting AE is a vomiting AE that occurs frequently throughout the day and is often triggered by even small meals.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthhype.com/persistent-and-recurrent-vomiting-emesis-in-adults-and-children.html</obo:IAO_0000119>
