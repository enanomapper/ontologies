    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005778 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002431"/>
        <obo:IAO_0000115>This is an AE which is diverse and can include developmental, traumatic, immune-mediated, infectious, metabolic, endocrine, neurologic, neoplastic, and inflammatory etiologies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7817488/</obo:IAO_0000119>
        <obo:OAE_0001849>咽疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10067353</obo:OAE_0004334>
        <rdfs:label>pharyngeal disorder AE</rdfs:label>
    </owl:Class>
    


