    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009322 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001283"/>
        <obo:IAO_0000115>This is an AE which is a non-destructive disease that causes inflammation with ulcerative of the gums.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingivitis</obo:IAO_0000119>
        <obo:OAE_0001849>齿龈炎溃疡性</obo:OAE_0001849>
        <obo:OAE_0004334>10010296</obo:OAE_0004334>
        <rdfs:label>gingivitis ulcerative AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009323 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003434"/>
        <obo:IAO_0000115>This is an AE which is extensive, yet the rare nature of this disease means that there is a lack of good quality research available.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28761942/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性溃疡性龈口炎</obo:OAE_0001849>
        <obo:OAE_0004334>10055670</obo:OAE_0004334>
        <rdfs:label>necrotising ulcerative gingivostomatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009324 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in a bodily membrane  with haemorrhage that impedes normal function of the affected organ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>溃疡出血</obo:OAE_0001849>
        <obo:OAE_0004334>10061577</obo:OAE_0004334>
        <rdfs:label>ulcer hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009328 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is an autosomal recessive metabolic disorder affecting amino acid transport.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lysinuric_protein_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>赖氨酸尿性蛋白耐受不良</obo:OAE_0001849>
        <obo:OAE_0004334>10058300</obo:OAE_0004334>
        <rdfs:label>lysinuric protein intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009329 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is a component of MHC class I molecules, MHC class I molecules have α1, α2, and α3 proteins which are present on all nucleated cells (excludes red blood cells).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Beta-2_microglobulin</obo:IAO_0000119>
        <obo:OAE_0001849>β2微球蛋白尿</obo:OAE_0001849>
        <obo:OAE_0004334>10073223</obo:OAE_0004334>
        <rdfs:label>beta 2 microglobulin urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009330 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which characterized by rapid and almost complete destruction of pancreatic β-cells, is a newly identified subtype of type 1 diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30203124/</obo:IAO_0000119>
        <obo:OAE_0001849>暴发性1型糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10072628</obo:OAE_0004334>
        <rdfs:label>fulminant type 1 diabetes mellitus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009331 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is an inborn error of metabolism that results in decreased metabolism of the amino acid phenylalanine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phenylketonuria</obo:IAO_0000119>
        <obo:OAE_0001849>苯丙酮酸尿</obo:OAE_0001849>
        <obo:OAE_0004334>10034872</obo:OAE_0004334>
        <rdfs:label>phenylketonuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009332 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is abnormal, characterization of the chromatogram is facilitated by calculation of uroporphyrin-to-heptacarboxylate porphyrin (uro/hepta) and uroporphyrin-to-isocoproporphyrin (uro/iso) ratios.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11508829/</obo:IAO_0000119>
        <obo:OAE_0001849>卟啉尿</obo:OAE_0001849>
        <obo:OAE_0004334>10059910</obo:OAE_0004334>
        <rdfs:label>porphyrins urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009333 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is an inability to completely empty the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_retention</obo:IAO_0000119>
        <obo:OAE_0001849>残尿</obo:OAE_0001849>
        <obo:OAE_0004334>10060695</obo:OAE_0004334>
        <rdfs:label>residual urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009334 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002494"/>
        <obo:IAO_0000115>This is an AE which is a possible adverse effect of selective sodium-glucose cotransporter inhibitors 2 (isGLT2) in patients with diabetes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31734176/</obo:IAO_0000119>
        <obo:OAE_0001849>常血糖性糖尿病酮症酸中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10080061</obo:OAE_0004334>
        <rdfs:label>euglycaemic diabetic ketoacidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009335 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is a monoamine neurotransmitter, an organic compound that has a catechol (benzene with two hydroxyl side groups next to each other) and a side-chain amine and it appears on urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Catecholamine</obo:IAO_0000119>
        <obo:OAE_0001849>儿茶酚胺尿</obo:OAE_0001849>
        <obo:OAE_0004334>10062277</obo:OAE_0004334>
        <rdfs:label>catecholamines urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009336 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is a highly polar chiral carboxylic acid on the urine that is usually not detected during routine organic acid analysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11920944/</obo:IAO_0000119>
        <obo:OAE_0001849>甘油酸尿</obo:OAE_0001849>
        <obo:OAE_0004334>10060757</obo:OAE_0004334>
        <rdfs:label>glyceric acid urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009337 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a reversible form of coma found in people with diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetic_coma</obo:IAO_0000119>
        <obo:OAE_0001849>高渗透压性糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10012631</obo:OAE_0004334>
        <rdfs:label>diabetes with hyperosmolarity AE</rdfs:label>
    </owl:Class>
    


