    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008450 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is a condition in which prolonged or excessive uterine bleeding occurs irregularly and more frequently than normal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Menometrorrhagia</obo:IAO_0000119>
        <obo:OAE_0001849>月经过多</obo:OAE_0001849>
        <obo:OAE_0004334>10027295</obo:OAE_0004334>
        <rdfs:label>menometrorrhagia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008451 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the time in women&apos;s lives when menstrual periods stop permanently, and they are no longer able to bear children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Menopause#Signs_and_symptoms</obo:IAO_0000119>
        <obo:OAE_0001849>更年期症状</obo:OAE_0001849>
        <obo:OAE_0004334>10027304</obo:OAE_0004334>
        <rdfs:label>menopausal symptoms AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008452 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is the regular discharge of blood and mucosal tissue from the inner lining of the uterus through the vagina feel discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Menstruation#Cramps</obo:IAO_0000119>
        <obo:OAE_0001849>经期不适</obo:OAE_0001849>
        <obo:OAE_0004334>10056344</obo:OAE_0004334>
        <rdfs:label>menstrual discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008453 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <obo:IAO_0000115>This is an AE which is the regular discharge of blood and mucosal tissue from the inner lining of the uterus through the vagina and it is delayed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Menstruation</obo:IAO_0000119>
        <obo:OAE_0001849>月经推迟</obo:OAE_0001849>
        <obo:OAE_0004334>10027336</obo:OAE_0004334>
        <rdfs:label>menstruation delayed AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008454 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which the lower end of the uterus, the cervix, opens into the vagina, while the upper end, the fundus, is connected to the fallopian tubes and is infected.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uterus</obo:IAO_0000119>
        <obo:OAE_0001849>宫内感染</obo:OAE_0001849>
        <obo:OAE_0004334>10056254</obo:OAE_0004334>
        <rdfs:label>intrauterine infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008455 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by high levels of androgens in women and, less commonly, in men.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperandrogenism</obo:IAO_0000119>
        <obo:OAE_0001849>雄激素过多症</obo:OAE_0001849>
        <obo:OAE_0004334>10065597</obo:OAE_0004334>
        <rdfs:label>hyperandrogenism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008456 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the genital.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>生殖器脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10062316</obo:OAE_0004334>
        <rdfs:label>genital abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008457 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of genital fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>生殖器疱</obo:OAE_0001849>
        <obo:OAE_0004334>10074995</obo:OAE_0004334>
        <rdfs:label>genital blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008458 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000771"/>
        <obo:IAO_0000115>This is an AE which is defined as an unpleasant, abnormal sense of touch on the genital.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>外阴烧灼感</obo:OAE_0001849>
        <obo:OAE_0004334>10054815</obo:OAE_0004334>
        <rdfs:label>genital burning sensation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008459 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the genital, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>生殖器囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10053178</obo:OAE_0004334>
        <rdfs:label>genital cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008460 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a condition that affects the female reproductive system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Female_genital_disease</obo:IAO_0000119>
        <obo:OAE_0001849>女性生殖障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061176</obo:OAE_0004334>
        <rdfs:label>genital disorder female AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008461 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is a condition that affects the male reproductive system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Male_genital_disease</obo:IAO_0000119>
        <obo:OAE_0001849>男性生殖障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061177</obo:OAE_0004334>
        <rdfs:label>genital disorder male AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008462 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the genital skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
