    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007567 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is cancer that develops from the tissues of the thyroid gland.</obo:IAO_0000115>
