        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001364"/>
        <obo:IAO_0000115>This is an AE which is a postoperative medical condition in which the kidneys are functioning at less than 15% of normal levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_failure</obo:IAO_0000119>
