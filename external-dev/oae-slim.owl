        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 infusion site extravasation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11134</rdfs:seeAlso>
    </owl:Class>
    


