    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006601 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is the process of using one&apos;s hands to check theliver palpable subcostal, especially while perceiving/diagnosing a disease or illness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palpation</obo:IAO_0000119>
        <obo:OAE_0001849>肝脏可触及的肋下</obo:OAE_0001849>
        <obo:OAE_0004334>10024704</obo:OAE_0004334>
        <rdfs:label>liver palpable subcostal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006602 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002038"/>
        <obo:IAO_0000115>This is an AE which refers pain or discomfort when an affected liver is touched.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tenderness</obo:IAO_0000119>
        <obo:OAE_0001849>肝压痛</obo:OAE_0001849>
        <obo:OAE_0004334>10024712</obo:OAE_0004334>
