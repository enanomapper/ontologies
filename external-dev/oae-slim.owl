    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000553"/>
        <obo:IAO_0000115>an electrolyte blood lab test abnormal AE that results in an abnormal level of sodium in the blood</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
