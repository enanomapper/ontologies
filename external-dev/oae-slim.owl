        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is a type of gastroenteritis that results in bloody diarrhea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
