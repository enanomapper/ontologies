    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000169"/>
        <obo:IAO_0000115>This is an AE which is a term describing neuropathies with both sensory and motor involvement in a length dependant distribution where neurophysiology reveals axonal damage.</obo:IAO_0000115>
