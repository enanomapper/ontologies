        <obo:OAE_0001849>指甲不舒服</obo:OAE_0001849>
        <obo:OAE_0004334>10028693</obo:OAE_0004334>
        <rdfs:label>nail discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008049 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a visible body part at the mouth of humans and it has desease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lip</obo:IAO_0000119>
        <obo:OAE_0001849>唇部疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10048470</obo:OAE_0004334>
        <rdfs:label>lip disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008050 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which is a group of conditions that includes cleft lip, cleft palate, and both together.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cleft_lip_and_cleft_palate</obo:IAO_0000119>
