    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>a skin AE that shows the symptom of rash, i.e., an abnormal change in skin color, appearance, or texture. A rash may cause the skin to change color, itch, become warm, bumpy, dry, cracked or blistered, swell and may be painful.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119>URL: http://en.wikipedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:IAO_0000119>URL: http://www.webmd.com/skin-problems-and-treatments/guide/common-rashes</obo:IAO_0000119>
        <obo:IAO_0000119>Wick JY. Drug-induced rash: nuisance or threat? Consult Pharm. 2013 Mar;28(3):160-6. PMID: 23462025.</obo:IAO_0000119>
        <obo:OAE_0004334>10037844</obo:OAE_0004334>
        <rdfs:comment>Drug-induced rash is the most commonly reported drug reaction.</rdfs:comment>
        <rdfs:label>rash AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000988</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015230</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000363 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <obo:IAO_0000115>an adverse event that has an outcome of a pathogen infection, i.e., an infection caused by a pathogen such as a virus, bacterium, or parasite.</obo:IAO_0000115>
        <obo:IAO_0000116>change of name from &apos;infection adverse event&apos; to &apos;infectious adverse event&apos; on 09/23/13 for a better clinical relevance, move &apos;infection adverse event&apos; as an alternative term - SS</obo:IAO_0000116>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
        <obo:IAO_0000118>infectious adverse event</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/infection</obo:IAO_0000119>
        <obo:OAE_0003232>infection</obo:OAE_0003232>
        <obo:OAE_0004334>10021789</obo:OAE_0004334>
        <rdfs:label>infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000364 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <obo:IAO_0000115>An AE that has an outcome of syndrome. Syndrome is the association of several clinically recognizable features, signs (observed by a physician), symptoms (reported by the patient), phenomena or characteristics that often occur together, so that the presence of one feature alerts the physician to the presence of the others.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label>syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000365 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that has an outcome of emotional state of excitement or restlessness</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <obo:OAE_0004334>10001497</obo:OAE_0004334>
        <rdfs:label>agitation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12874</rdfs:seeAlso>
