        <rdfs:label>mesenteric occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005601 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a medical disorder consisting of weak muscular contractions (peristalsis) of the stomach, resulting in food and liquid remaining in the stomach for a prolonged period of time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastroparesis</obo:IAO_0000119>
        <obo:OAE_0001849>胃排空减少</obo:OAE_0001849>
        <obo:OAE_0004334>10021518</obo:OAE_0004334>
        <rdfs:label>impaired gastric emptying AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005602 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a rare non-neoplastic disorder characterized by fat necrosis, chronic inflammation, and fibrosis typically of the small bowel mesentery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30829677/</obo:IAO_0000119>
        <obo:OAE_0001849>肠系膜炎</obo:OAE_0001849>
