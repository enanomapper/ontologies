    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008654 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which refers to an enlargement (&quot;hyperplasia&quot;) of the thymus and is not always a disease state.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thymus_hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>胸腺增大</obo:OAE_0001849>
        <obo:OAE_0004334>10065588</obo:OAE_0004334>
        <rdfs:label>thymus enlargement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008655 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of thymus tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>胸腺肥大</obo:OAE_0001849>
