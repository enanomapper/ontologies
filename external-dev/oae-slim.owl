    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006389 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001392"/>
