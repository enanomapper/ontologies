        <obo:OAE_0001849>机械性肠梗阻</obo:OAE_0001849>
        <obo:OAE_0004334>10051399</obo:OAE_0004334>
        <rdfs:label>mechanical ileus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005676 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a disorder of pigmentation of the wall of the colon, often identified at the time of colonoscopy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melanosis_coli</obo:IAO_0000119>
        <obo:OAE_0001849>结肠黑变病</obo:OAE_0001849>
        <obo:OAE_0004334>10027158</obo:OAE_0004334>
        <rdfs:label>melanosis coli AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005677 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004538"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneic group of clinically significant illnesses  because of the more common imaging of the intestinal circulation when studying both vascular and nonvascular diseases of the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
