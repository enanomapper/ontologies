    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115 xml:lang="en">a muscle adverse event which has an outcome of myopathy AE, an abnormal condition or disease of the skeletal muscle</obo:IAO_0000115>
        <obo:OAE_0004334>10028641</obo:OAE_0004334>
        <rdfs:label>myopathy AE</rdfs:label>
