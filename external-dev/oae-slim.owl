        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is defined as an elevated resting energy expenditure (REE) &gt; 110% of predicted REE.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypermetabolism</obo:IAO_0000119>
        <obo:OAE_0001849>高代谢反应</obo:OAE_0001849>
        <obo:OAE_0004334>10020674</obo:OAE_0004334>
        <rdfs:label>hypermetabolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007617 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic disorder caused by pathogenic variants in the gene CDKL5.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/CDKL5_deficiency_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>cdkl5缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10083005</obo:OAE_0004334>
        <rdfs:label>cdkl5 deficiency disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007618 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is an immunodeficiency of absent or suboptimal functioning of one of the complement system proteins.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complement_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>补体缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10075551</obo:OAE_0004334>
        <rdfs:label>complement deficiency disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007619 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>This is an AE which is not epileptic seizures or epilepsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reflex_asystolic_syncope</obo:IAO_0000119>
        <obo:OAE_0001849>癫痫发作缺氧</obo:OAE_0001849>
        <obo:OAE_0004334>10039907</obo:OAE_0004334>
        <rdfs:label>seizure anoxic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007620 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which appears to predispose to severe respiratory tract infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20375630/</obo:IAO_0000119>
        <obo:OAE_0001849>甘露糖结合凝集素缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10083190</obo:OAE_0004334>
        <rdfs:label>mannose-binding lectin deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007621 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of a body part or organ compared to the normal shape of that part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061619</obo:OAE_0004334>
        <rdfs:label>deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007622 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which risk factors were found to be low birth weight (2500 g or less) and threatened abortion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/8474950/</obo:IAO_0000119>
        <obo:OAE_0001849>减少肢体缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10024503</obo:OAE_0004334>
        <rdfs:label>limb reduction defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007623 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001887"/>
        <obo:IAO_0000115>This is an AE which is a diverse array of deficits in hedonic function, including reduced motivation or ability to experience pleasure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anhedonia</obo:IAO_0000119>
        <obo:OAE_0001849>快感缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10002511</obo:OAE_0004334>
        <rdfs:label>anhedonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007624 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is a lack of the dietary minerals, the micronutrients that are needed for an organism&apos;s proper health.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mineral_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>矿物质缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10061291</obo:OAE_0004334>
        <rdfs:label>mineral deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007625 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is an electrolyte disturbance in which there is a low level of magnesium in the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Magnesium_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>镁缺乏</obo:OAE_0001849>
        <obo:OAE_0004334>10025433</obo:OAE_0004334>
        <rdfs:label>magnesium deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007626 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000914"/>
        <obo:IAO_0000115>This is an AE which is a condition of reduced emotional reactivity in an individual.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reduced_affect_display</obo:IAO_0000119>
        <obo:OAE_0001849>情感缺乏</obo:OAE_0001849>
        <obo:OAE_0004334>10016759</obo:OAE_0004334>
        <rdfs:label>flat affect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007627 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which occurs when an organism lacks the required levels of selenium, a critical nutrient in many species.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Selenium_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>硒缺乏</obo:OAE_0001849>
        <obo:OAE_0004334>10039921</obo:OAE_0004334>
        <rdfs:label>selenium deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007628 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is defined either as insufficient zinc to meet the needs of the body, or as a serum zinc level below the normal range.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Zinc_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>锌缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10048259</obo:OAE_0004334>
        <rdfs:label>zinc deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007629 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is a low level of folate and derivatives in the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Folate_deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>叶酸缺乏</obo:OAE_0001849>
        <obo:OAE_0004334>10016880</obo:OAE_0004334>
        <rdfs:label>folate deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007630 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000883"/>
        <obo:IAO_0000115>This is an AE which is a behavioral and neurodevelopmental disorder characterized by inattention, hyperactivity, and impulsivity, which are pervasive, impairing, and otherwise age inappropriate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Attention_deficit_hyperactivity_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>注意力缺陷/多动症</obo:OAE_0001849>
        <obo:OAE_0004334>10003736</obo:OAE_0004334>
        <rdfs:label>attention deficit/hyperactivity disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007631 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002670"/>
        <obo:IAO_0000115>This is an AE which is the result of a process reducing hydrogen ion concentration of arterial blood plasma (alkalemia).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alkalosis</obo:IAO_0000119>
        <obo:OAE_0001849>碱毒症</obo:OAE_0001849>
        <obo:OAE_0004334>10001680</obo:OAE_0004334>
        <rdfs:label>alkalosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007632 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002789"/>
        <obo:IAO_0000115>This is an AE which refers to the act of suppressing lactation by medication or other non pharmaceutical means.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lactation_suppression</obo:IAO_0000119>
        <obo:OAE_0001849>抑制泌乳</obo:OAE_0001849>
        <obo:OAE_0004334>10042576</obo:OAE_0004334>
        <rdfs:label>suppressed lactation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007633 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000517"/>
        <obo:IAO_0000115>This is an AE which is also lost from the plasma in hypovolemia, the body&apos;s need for salt proportionately increases in addition to thirst in such cases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thirst#Salt_craving</obo:IAO_0000119>
        <obo:OAE_0001849>盐的渴望</obo:OAE_0001849>
        <obo:OAE_0004334>10067951</obo:OAE_0004334>
        <rdfs:label>salt craving AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007634 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which may be prone to a combined cow&apos;s milk and soy protein allergy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Milk_allergy</obo:IAO_0000119>
        <obo:OAE_0001849>奶大豆蛋白不耐症</obo:OAE_0001849>
        <obo:OAE_0004334>10071754</obo:OAE_0004334>
        <rdfs:label>milk soy protein intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007635 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is an excessive number of histiocytes (tissue macrophages), and the term is also often used to refer to a group of rare diseases which share this sign as a characteristic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Histiocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>组织细胞增生症</obo:OAE_0001849>
        <obo:OAE_0004334>10020117</obo:OAE_0004334>
        <rdfs:label>histiocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007636 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which there is a reduction in the number of red and white blood cells, as well as platelets.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>双细胞减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10058956</obo:OAE_0004334>
        <rdfs:label>bicytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007637 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is an abnormal clonal proliferation of Langerhans cells, abnormal cells deriving from bone marrow and capable of migrating from skin to lymph nodes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Langerhans_cell_histiocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>朗格汉斯细胞组织细胞增生症</obo:OAE_0001849>
        <obo:OAE_0004334>10069698</obo:OAE_0004334>
        <rdfs:label>langerhans&apos; cell histiocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007638 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115>This is an AE which is &quot;a clinical entity induced by the ingestion of gluten leading to intestinal and/or extraintestinal symptoms that improve once the gluten-containing foodstuff is removed from the diet, and celiac disease and wheat allergy have been excluded&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Non-celiac_gluten_sensitivity</obo:IAO_0000119>
        <obo:OAE_0001849>谷蛋白敏感性</obo:OAE_0001849>
        <obo:OAE_0004334>10076493</obo:OAE_0004334>
        <rdfs:label>gluten sensitivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007639 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001330"/>
        <obo:IAO_0000115>This is an AE which contribute to function and stability of surfactant film.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33839914/</obo:IAO_0000119>
        <obo:OAE_0001849>表面活性蛋白</obo:OAE_0001849>
        <obo:OAE_0004334>10073028</obo:OAE_0004334>
        <rdfs:label>surfactant protein AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007640 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001330"/>
        <obo:IAO_0000115>This is an AE which is a class of globulins, identified by their position after serum protein electrophoresis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gamma_globulin</obo:IAO_0000119>
        <obo:OAE_0001849>丙种球蛋白病</obo:OAE_0001849>
        <obo:OAE_0004334>10061964</obo:OAE_0004334>
        <rdfs:label>gammopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007641 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001654"/>
        <obo:IAO_0000115>This is an AE which is a collective term for blood tests used to check the function of the thyroid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_function_tests</obo:IAO_0000119>
        <obo:OAE_0001849>不含甲状腺素</obo:OAE_0001849>
        <obo:OAE_0004334>10055157</obo:OAE_0004334>
        <rdfs:label>thyroxine free AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007642 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is the functional deterioration of a structure or system that had been previously working with the help of allostatic compensation such as diabetic metabolic decompensation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Decompensation</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病代谢代谢失调</obo:OAE_0001849>
        <obo:OAE_0004334>10074309</obo:OAE_0004334>
        <rdfs:label>diabetic metabolic decompensation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007643 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a lysosomal storage disorder characterized by the excess accumulation of phospholipids in tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phospholipidosis</obo:IAO_0000119>
        <obo:OAE_0001849>磷脂质病</obo:OAE_0001849>
        <obo:OAE_0004334>10074564</obo:OAE_0004334>
        <rdfs:label>phospholipidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007644 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <obo:IAO_0000115>This is an AE which is a rare long-term endocrine disorder characterized by inadequate production of the steroid hormones cortisol and aldosterone by the two outer layers of the cells of the adrenal glands (adrenal cortex), causing adrenal insufficiency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Addison%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>阿狄森氏病</obo:OAE_0001849>
        <obo:OAE_0004334>10001130</obo:OAE_0004334>
        <rdfs:label>addison&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007645 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a rare and often fatal lysosomal storage disease that results in progressive damage to the nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Krabbe_disease</obo:IAO_0000119>
        <obo:OAE_0001849>克腊伯氏病</obo:OAE_0001849>
        <obo:OAE_0004334>10023492</obo:OAE_0004334>
        <rdfs:label>krabbe&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007646 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <obo:IAO_0000115>This is an AE which is characterized as a disruption to the microbiota homeostasis caused by an imbalance in the microflora, changes in their functional composition and metabolic activities, or a shift in their local distribution.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysbiosis</obo:IAO_0000119>
        <obo:OAE_0001849>菌群失调</obo:OAE_0001849>
        <obo:OAE_0004334>10082129</obo:OAE_0004334>
        <rdfs:label>dysbiosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007647 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of the human body&apos;s normal balance of acids and bases that causes the plasma pH to deviate out of the normal range (7.35 to 7.45).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acid%E2%80%93base_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>酸碱平衡失调混合</obo:OAE_0001849>
        <obo:OAE_0004334>10000483</obo:OAE_0004334>
        <rdfs:label>acid-base balance disorder mixed AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007648 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
