    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003233 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>a viral infection AE that is caused by a herpes virus. Note that there are 8 herpesvirus types.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: https://en.wikipedia.org/wiki/Herpesviridae</obo:IAO_0000119>
        <obo:OAE_0004334>10019972</obo:OAE_0004334>
        <rdfs:label xml:lang="en">herpes viral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003234 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000359"/>
        <obo:IAO_0000115>a herpez zoster AE that occurs in children.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
