        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>This is an AE which occurs because of involuntary contractions of the bladder smooth muscle after urinary catheterization.</obo:IAO_0000115>
