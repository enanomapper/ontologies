    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002254 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>Hypoacusis AE is a hearing disorder AE that shows partial or complete loss of the ability to detect or understand sounds resulting from damage to the outer, middle, or inner ear structures. Causes include exposure to loud noise, ear infections, injuries to the ear, genetic, and congenital disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hypoacusis</obo:IAO_0000119>
        <obo:OAE_0001849>突发听力减退</obo:OAE_0001849>
        <obo:OAE_0004334>10048865</obo:OAE_0004334>
        <rdfs:label>hypoacusis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002255 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000549"/>
        <obo:IAO_0000115>Lip cyanosis AE is a cyanosis AE that is a condition in which the lips have a bluish discoloration due to a lack of oxygen in the tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/lip_cyanosis.htm</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇发紫</obo:OAE_0001849>
        <rdfs:label>lip cyanosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002256 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000549"/>
        <obo:IAO_0000115>Nail cyanosis AE is a cyanosis AE that shows a dark bluish or purple nail resulting from deficient oxygenation of the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>指甲青紫</obo:OAE_0001849>
        <rdfs:label>nail cyanosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002257 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>Renal dysfunction AE is a kidney AE that has an outcome of reduced capacity to excrete metabolic products which accumulate systemically and are detectable clinicopathologically by renal function tests. The early stage of uremia.</obo:IAO_0000115>
        <obo:IAO_0000116>This term appears to be a synonym to the &apos;renal failure AE&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hepatic and renal function disorder AE</obo:IAO_0000118>
        <obo:OAE_0001849>肾功能障碍</obo:OAE_0001849>
        <rdfs:label>renal insufficiency AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0859242</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002258 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Hemolysis AE is a hematopoietic system AE that is the rupturing of erythrocytes (red blood cells) and the release of their contents (cytoplasm) into surrounding fluid.</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hemolysis</obo:IAO_0000119>
        <obo:OAE_0001849>溶血</obo:OAE_0001849>
        <obo:OAE_0004334>10019491</obo:OAE_0004334>
        <rdfs:label>hemolysis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10037</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C37965</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <obo:IAO_0000115>Lip angioedema AE is a angioedema AE that shows lip angioedema, which is the rapid swelling (edema) of the dermis, subcutaneous tissue, mucosa and submucosal tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>唇血管神经性水肿</obo:OAE_0001849>
