        <rdfs:label>abdominal wound dehiscence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a intra-abdominal  bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
