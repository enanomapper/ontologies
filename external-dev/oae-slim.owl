    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005772 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is the part of the throat behind the mouth and nasal cavity, and above the oesophagus and trachea (the tubes going down to the stomach and the lungs) and it has blistering.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pharynx</obo:IAO_0000119>
        <obo:OAE_0001849>口咽部水疱</obo:OAE_0001849>
        <obo:OAE_0004334>10067950</obo:OAE_0004334>
