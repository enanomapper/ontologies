        <obo:OAE_0004334>10052269</obo:OAE_0004334>
        <rdfs:label>catheter site phlebitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005424 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003466"/>
        <obo:IAO_0000115>This is an AE which is a frequent finding in patients with cirrhosis and portal hypertension, and may be produced by various mechanisms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9421656/</obo:IAO_0000119>
        <obo:OAE_0001849>下腔静脉扩张</obo:OAE_0001849>
