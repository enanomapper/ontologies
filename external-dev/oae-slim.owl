        <rdfs:label>inferior vena cava dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005425 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003466"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a blood vessel or other tubular organ such as inferior vena cava or structure such as foramina and canals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>下腔静脉狭窄</obo:OAE_0001849>
