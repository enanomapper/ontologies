    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>This is an AE which is the symptom of pain in the face, head, or neck and is procedural .</obo:IAO_0000115>
