    <!-- http://purl.obolibrary.org/obo/OAE_0005417 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which presents in the umbilical cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
