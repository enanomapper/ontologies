    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004600 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <obo:IAO_0000115>This is an AE which refers to a sudden, severe abdominal pain and it is in many cases a medical emergency, requiring urgent and specific diagnosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
