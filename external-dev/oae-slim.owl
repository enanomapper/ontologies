        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 hemolytic uremic syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10046</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003662 -->


