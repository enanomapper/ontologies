    <!-- http://purl.obolibrary.org/obo/OAE_0000752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>a bone marrow disorder AE that has an outcome of an abnormal condition in which the bone marrow is unable to produce normal amounts of red blood cells, white blood cells and platelets</obo:IAO_0000115>
        <obo:IAO_0000117>DJ, SS, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>bone marrrow hypocellular</obo:IAO_0000118>
        <obo:IAO_0000118>hypocellular bone marrow</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.diagnosispro.com/differential_diagnosis-for/bx-bone-marrow-biopsy-hypocellular/29777-154.html</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.drugs.com/condition/bone-marrow-depression-low-blood-counts.html</obo:IAO_0000119>
        <obo:OAE_0004334>10005986</obo:OAE_0004334>
        <obo:OAE_0004334>10048580</obo:OAE_0004334>
        <rdfs:comment>Bone marrow produces three types of blood cells; red blood cells, white blood cells and platelets. Bone marrow depression is characterized by an inability or reduced ability of the bone marrow to produce these cells. A low blood count can involve just one or all three types of blood cells.</rdfs:comment>
        <rdfs:label>bone marrow depression AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10022</rdfs:seeAlso>
        <rdfs:seeAlso>HPO: HP_0012145</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35167</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151773</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS: C0151773</rdfs:seeAlso>
    </owl:Class>
    


