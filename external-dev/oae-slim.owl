    <!-- http://purl.obolibrary.org/obo/OAE_0005589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic disease that can affect many parts of the body, including the kidneys, heart, and skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fabry_disease</obo:IAO_0000119>
        <obo:OAE_0001849>法布瑞氏症</obo:OAE_0001849>
        <obo:OAE_0004334>10016016</obo:OAE_0004334>
        <rdfs:label>fabry&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005590 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital heart defect characterized by four specific cardiac defects.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tetralogy_of_Fallot</obo:IAO_0000119>
        <obo:OAE_0001849>法乐氏四联症</obo:OAE_0001849>
        <obo:OAE_0004334>10016193</obo:OAE_0004334>
        <rdfs:label>fallot&apos;s tetralogy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005591 -->


