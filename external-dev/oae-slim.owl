    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>Skin redness AE is an erythema AE that is abnormal redness of the skin, often signaling a pathological condition, such as inflammation, infection, or sunburn.</obo:IAO_0000115>
