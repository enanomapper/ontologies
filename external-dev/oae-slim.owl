    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004379"/>
        <obo:IAO_0000115>This is an AE which is a rash (small spots) on the pharyngeal mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enanthem</obo:IAO_0000119>
        <obo:OAE_0001849>咽黏膜疹</obo:OAE_0001849>
        <obo:OAE_0004334>10073741</obo:OAE_0004334>
        <rdfs:label>pharyngeal enanthema AE</rdfs:label>
