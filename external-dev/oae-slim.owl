    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007612 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which characterized by decreased brain glucose consumption, is a common feature of many neurodegenerative diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28463438/</obo:IAO_0000119>
