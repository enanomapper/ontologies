    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is redness of the skin or mucous membranes such as anal, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
