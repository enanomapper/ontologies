        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002789"/>
        <obo:IAO_0000115>a lactation disorder AE that has changes in lactation, significantly affecting breast production or expression of breast milk</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 lactation disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13131</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002927 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002737"/>
        <obo:IAO_0000115>a nipple deformity AE that has asymptomatic; asymmetry with slight retraction and/or thickening of the nipple areolar complex</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 nipple deformity AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13139</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002928 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002737"/>
        <obo:IAO_0000115>a nipple deformity AE that has symptomatic; asymmetry of nipple areolar complex with moderate retraction and/or thickening of the nipple areolar complex</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 nipple deformity AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13140</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002929 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002665"/>
        <obo:IAO_0000115>an oligospermia AE requires sperm concentration &gt;48 million/mL or motility &gt;68%</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 oligospermia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13142</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002930 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002665"/>
        <obo:IAO_0000115>an oligospermia AE requires sperm concentration 13 - 48 million/mL or motility 32 - 68%</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 oligospermia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13143</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002931 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002665"/>
        <obo:IAO_0000115>an oligospermia AE requires sperm concentration &lt;13 million/mL or motility &lt;32%</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 oligospermia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13144</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002932 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002632"/>
        <obo:IAO_0000115>a testicular disorder AE that has symptomatic but not interfering with urination or sexual activities; intervention not indicated; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 testicular disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13217</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002933 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002632"/>
        <obo:IAO_0000115>a testicular disorder AE that has severe symptoms; interfering with urination or sexual function; limiting self care ADL; intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 testicular disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13218</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002934 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002680"/>
        <obo:IAO_0000115>a vaginal discharge AE that has mild vaginal discharge (greater than baseline for patient)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 vaginal discharge AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13252</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002935 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002680"/>
        <obo:IAO_0000115>a vaginal discharge AE that has moderate to heavy vaginal discharge; use of perineal pad or tampon indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 vaginal discharge AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13253</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002936 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002690"/>
        <obo:IAO_0000115>a bladder spasm AE that has antispasmodics indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 bladder spasm AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12986</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002937 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002690"/>
        <obo:IAO_0000115>a bladder spasm AE that has hospitalization indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 bladder spasm AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12987</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002938 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002799"/>
        <obo:IAO_0000115>a chronic kidney disease AE that requires eGFR (estimated Glomerular Filtration Rate) or CrCl (creatinine clearance) &lt;LLN - 60 ml/min/1.73 m2 or proteinuria 2+ present; urine protein/creatinine &gt;0.5</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 chronic kidney disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12989</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002939 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002799"/>
        <obo:IAO_0000115>a chronic kidney disease AE that requires eGFR or CrCl 59 - 30 ml/min/1.73 m2</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 chronic kidney disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12990</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002940 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002799"/>
        <obo:IAO_0000115>a chronic kidney disease AE that requires eGFR or CrCl 29 - 15 ml/min/1.73 m2</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 chronic kidney disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12991</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002941 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002799"/>
        <obo:IAO_0000115>a chronic kidney disease AE that requires eGFR or CrCl &lt;15 ml/min/1.73 m2; dialysis or renal transplant indicated</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 chronic kidney disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12992</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002942 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002696"/>
        <obo:IAO_0000115>a cystitis noninfective AE that has microscopic hematuria; minimal increase in frequency, urgency, dysuria, or nocturia; new onset of incontinence</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 cystitis noninfective AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12995</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002943 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002696"/>
        <obo:IAO_0000115>a cystitis noninfective AE that has moderate hematuria; moderate increase in frequency, urgency, dysuria, nocturia or incontinence; urinary catheter placement or bladder irrigation indicated; limiting instrumental ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 cystitis noninfective AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12996</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002944 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002696"/>
        <obo:IAO_0000115>a cystitis noninfective AE that has gross hematuria; transfusion, IV medications or hospitalization indicated; elective endoscopic, radiologic or operative intervention indicated</obo:IAO_0000115>
