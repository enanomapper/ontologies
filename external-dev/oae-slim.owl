    <!-- http://purl.obolibrary.org/obo/OAE_0000669 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
