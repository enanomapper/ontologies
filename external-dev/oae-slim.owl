        <rdfs:label>white blood cells stool AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005625 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which refers to the presence of white blood cells within or upon casts strongly suggests pyelonephritis, a direct infection of the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_cast</obo:IAO_0000119>
        <obo:OAE_0001849>白细胞尿</obo:OAE_0001849>
        <obo:OAE_0004334>10050663</obo:OAE_0004334>
        <rdfs:label>white blood cells urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005626 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which refers to bowel movements that are infrequent or hard to pass.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Constipation</obo:IAO_0000119>
