        <obo:OAE_0004334>10014910</obo:OAE_0004334>
        <rdfs:label>enthesopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005643 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is a repeated inability to control urination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enuresis</obo:IAO_0000119>
        <obo:OAE_0001849>遗尿症</obo:OAE_0001849>
        <obo:OAE_0004334>10014928</obo:OAE_0004334>
        <rdfs:label>enuresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005644 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000825"/>
        <obo:IAO_0000115>This is an AE which is a rare entity characterized by the presence of a high eosinophilic infiltrate into the colonic wall in symptomatic patients, more often presenting with abdominal pain or diarrhea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31122823/</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性结肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10057271</obo:OAE_0004334>
        <rdfs:label>eosinophilic colitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005645 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001234"/>
        <obo:IAO_0000115>This is an AE which presents either with a chronic feeling of difficulty swallowing, with food moving slowly through the oesophagus, or as an acute food bolus obstruction requiring emergency attention.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30860925/</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性食管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064212</obo:OAE_0004334>
        <rdfs:label>eosinophilic esophagitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005646 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000924"/>
        <obo:IAO_0000115>This is an AE which refers to  the infections are bacterial such as escherichia when the infections are infections present in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bloodstream_infections</obo:IAO_0000119>
        <obo:OAE_0001849>大肠杆菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10054258</obo:OAE_0004334>
        <rdfs:label>escherichia bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005647 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000924"/>
        <obo:IAO_0000115>This is an AE whcih is inflammation of the kidney, typically due to a bacterial  such as escherichia infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pyelonephritis</obo:IAO_0000119>
        <obo:OAE_0001849>大肠肾盂肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074409</obo:OAE_0004334>
        <rdfs:label>escherichia pyelonephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005648 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000924"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition  caused by escherichia that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>大肠杆菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10015296</obo:OAE_0004334>
        <rdfs:label>escherichia sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005649 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005649">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000554"/>
        <obo:IAO_0000115>This is an AE which is defined in the medical literature as &quot;flatus expelled through the anus&quot; or the &quot;quality or state of being flatulent&quot;, which is defined in turn as &quot;marked by or affected with gases generated in the intestine or stomach; likely to cause digestive flatulence&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Flatulence</obo:IAO_0000119>
        <obo:OAE_0001849>肠胃气胀</obo:OAE_0001849>
        <obo:OAE_0004334>10016766</obo:OAE_0004334>
        <rdfs:label>flatulence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005650 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005650">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which refers absence of stomach muscle tone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glossary_of_medicine</obo:IAO_0000119>
        <obo:OAE_0001849>胃弛缓</obo:OAE_0001849>
        <obo:OAE_0004334>10017753</obo:OAE_0004334>
        <rdfs:label>gastric atony AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005651 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a medical condition that affects dogs in which the stomach becomes overstretched and rotated by excessive gas content.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastric_dilatation_volvulus</obo:IAO_0000119>
        <obo:OAE_0001849>胃扩张</obo:OAE_0001849>
        <obo:OAE_0004334>10017779</obo:OAE_0004334>
        <rdfs:label>gastric dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005652 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which as been positively associated with the development of gastric ulceration in nonequine species, and reduction of hypermotility may be protective against their development.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31864457/</obo:IAO_0000119>
        <obo:OAE_0001849>胃运动过强</obo:OAE_0001849>
        <obo:OAE_0004334>10052406</obo:OAE_0004334>
        <rdfs:label>gastric hypermotility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005653 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which characterized by delayed gastric emptying in the absence of an obstructing structural lesion in the stomach manifested as abdominal bloating.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28434448/</obo:IAO_0000119>
        <obo:OAE_0001849>胃运动减弱</obo:OAE_0001849>
        <obo:OAE_0004334>10052405</obo:OAE_0004334>
        <rdfs:label>gastric hypomotility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005654 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a muscular, hollow organ in the gastrointestinal tract of humans and many other animals, including several invertebrates and it has infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stomach</obo:IAO_0000119>
        <obo:OAE_0001849>胃感染</obo:OAE_0001849>
        <obo:OAE_0004334>10056663</obo:OAE_0004334>
        <rdfs:label>gastric infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005655 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is the mucous membrane layer of the stomach and it has  erythema, which contains the glands and the gastric pits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastric_mucosa</obo:IAO_0000119>
        <obo:OAE_0001849>胃粘膜红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10070994</obo:OAE_0004334>
        <rdfs:label>gastric mucosa erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005656 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which will lead Ménétrier disease that  is a very rare chronic gastric disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26825202/</obo:IAO_0000119>
        <obo:OAE_0001849>胃粘膜肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10017807</obo:OAE_0004334>
        <rdfs:label>gastric mucosal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005657 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is hyperplastic polyps (HPs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22414211/</obo:IAO_0000119>
        <obo:OAE_0001849>胃息肉</obo:OAE_0001849>
        <obo:OAE_0004334>10017817</obo:OAE_0004334>
        <rdfs:label>gastric polyps AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005658 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005658">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000967"/>
        <obo:IAO_0000115>This is an AE which is a break in the inner lining  with haemorrhage of the stomach, the first part of the small intestine, or sometimes the lower esophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peptic_ulcer_disease</obo:IAO_0000119>
        <obo:OAE_0001849>胃溃疡出血</obo:OAE_0001849>
        <obo:OAE_0004334>10017826</obo:OAE_0004334>
        <rdfs:label>gastric ulcer hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005660 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is a twisting of all or part of the stomach by more than 180 degrees with obstruction of the flow of material through the stomach, variable loss of blood supply and possible tissue death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastric_volvulus</obo:IAO_0000119>
        <obo:OAE_0001849>胃肠扭结</obo:OAE_0001849>
        <obo:OAE_0004334>10052541</obo:OAE_0004334>
        <rdfs:label>gastric volvulus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005661 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000968"/>
        <obo:IAO_0000115>This is an AE which is an important cause of upper gastrointestinal bleeding, accounting for approximately one fourth of UGI bleeding in endoscopic studies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7905865/</obo:IAO_0000119>
        <obo:OAE_0001849>胃炎出血</obo:OAE_0001849>
        <obo:OAE_0004334>10017866</obo:OAE_0004334>
        <rdfs:label>gastritis haemorrhagic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005662 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000968"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the lining of the stomach caused by viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastritis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性胃炎</obo:OAE_0001849>
        <obo:OAE_0004334>10051791</obo:OAE_0004334>
        <rdfs:label>gastritis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005663 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which was a medical syndrome first coined by Ludwig von Roemheld (1871–1938) describing a cluster of cardiovascular symptoms stimulated by gastrointestinal changes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Roemheld_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>胃心综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10059360</obo:OAE_0004334>
        <rdfs:label>gastrocardiac syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005664 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the gastrointestinal tract caused by astroviral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastroenteritis</obo:IAO_0000119>
        <obo:OAE_0001849>胃肠炎星形病毒</obo:OAE_0001849>
        <obo:OAE_0004334>10017893</obo:OAE_0004334>
        <rdfs:label>gastroenteritis astroviral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005665 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is self-limiting, identification of an etiological agent by bacterial stool culture is required for the management of patients with severe or prolonged diarrhea, symptoms consistent with invasive disease, or a history that may predict a complicated course of disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25567220/</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性胃肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10061166</obo:OAE_0004334>
        <rdfs:label>gastroenteritis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005666 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the gastrointestinal tract caused by  clostridial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastroenteritis</obo:IAO_0000119>
        <obo:OAE_0001849>梭状肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10017898</obo:OAE_0004334>
        <rdfs:label>gastroenteritis clostridial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005667 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is a protozoan parasite of medical and veterinary importance that causes gastroenteritis in a variety of vertebrate hosts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23297262/</obo:IAO_0000119>
        <obo:OAE_0001849>隐孢子虫胃肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10017899</obo:OAE_0004334>
        <rdfs:label>gastroenteritis cryptosporidial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005668 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is an eosinophilic gastrointestinal disease (EGID) a chronic inflammatory condition characterized by gastrointestinal symptoms and infiltration of the esophageal and/or GI mucosa by eosinophils and mast cells .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_gastroenteritis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性胃肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10017902</obo:OAE_0004334>
        <rdfs:label>gastroenteritis eosinophilic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005669 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is a leading cause of foodborne disease worldwide and may cause to gastroenteritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29208344/</obo:IAO_0000119>
        <obo:OAE_0001849>轮状病毒肠胃炎</obo:OAE_0001849>
        <obo:OAE_0004334>10017914</obo:OAE_0004334>
        <rdfs:label>gastroenteritis salmonella AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005670 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001068"/>
        <obo:IAO_0000115>This is an AE which is a disruption of the normal propulsive ability of the intestine with spastic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ileus</obo:IAO_0000119>
        <obo:OAE_0001849>回肠痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10021335</obo:OAE_0004334>
        <rdfs:label>ileus spastic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005671 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a group of inflammatory conditions of the colon and small intestine, Crohn&apos;s disease and ulcerative colitis being the principal types.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammatory_bowel_disease</obo:IAO_0000119>
