    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001026"/>
        <obo:IAO_0000115>a hepatic failure AE that has moderate to severe encephalopathy; coma; life-threatening consequences</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 hepatic failure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11213</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003665 -->


