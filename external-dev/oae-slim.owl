    <!-- http://purl.obolibrary.org/obo/OAE_0004601 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000616"/>
        <obo:IAO_0000115>This is an AE which is the condition of having at least three loose, liquid, or watery bowel movements each day and causes by  bacterial.</obo:IAO_0000115>
