        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002771"/>
        <obo:IAO_0000115>a tracheal mucositis AE that has endoscopic findings only; minimal hemoptysis, pain, or respiratory symptoms</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 1 tracheal mucositis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13590</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002908 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002771"/>
        <obo:IAO_0000115>a tracheal mucositis AE that has severe pain; hemorrhage or respiratory symptoms; limiting self care ADL</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 tracheal mucositis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13592</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002909 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002772"/>
        <obo:IAO_0000115>a tracheal stenosis AE that has symptomatic (e.g., noisy airway breathing), but causing no respiratory distress; medical management indicated (e.g., steroids)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 tracheal stenosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13597</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002910 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002772"/>
        <obo:IAO_0000115>a tracheal stenosis AE that has stridor or respiratory distress limiting self care ADL; endoscopic intervention indicated (e.g., stent, laser)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 tracheal stenosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13598</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002911 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002772"/>
        <obo:IAO_0000115>a tracheal stenosis AE that has life-threatening airway compromise; urgent intervention indicated (e.g., tracheotomy or intubation)</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 4 tracheal stenosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13599</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002912 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002798"/>
        <obo:IAO_0000115>an azoospermia AE that has absence of sperm in ejaculate</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 3 azoospermia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13068</rdfs:seeAlso>
    </owl:Class>
    


