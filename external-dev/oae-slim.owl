        <obo:IAO_0000119>http://en.volupedia.org/wiki/Encephalitis</obo:IAO_0000119>
        <obo:OAE_0001849>脑炎过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10056387</obo:OAE_0004334>
        <rdfs:label>encephalitis allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004900 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004900">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
