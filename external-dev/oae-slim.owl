    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005777 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the pharyngeal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>咽脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10067781</obo:OAE_0004334>
