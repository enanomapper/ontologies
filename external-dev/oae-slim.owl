    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007982 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is caused by entrapment of the ulnar nerve in the Guyon canal as it passes through the wrist.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulnar_tunnel_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>尺骨隧道症候群</obo:OAE_0001849>
        <obo:OAE_0004334>10058942</obo:OAE_0004334>
        <rdfs:label>ulnar tunnel syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007983 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a break of the humerus bone in the upper arm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Humerus_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>上肢骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10061394</obo:OAE_0004334>
