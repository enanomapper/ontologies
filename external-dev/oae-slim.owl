    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005152 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which refers to an abnormal intrathoracic position of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21861958/</obo:IAO_0000119>
        <obo:OAE_0001849>心脏错位</obo:OAE_0001849>
        <obo:OAE_0004334>10007585</obo:OAE_0004334>
        <rdfs:label>cardiac malposition AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005153 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002459"/>
        <obo:IAO_0000115>This is an AE which is a heart murmur that is primarily due to physiologic conditions outside the heart, as opposed to structural defects in the heart itself.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Functional_murmur</obo:IAO_0000119>
        <obo:OAE_0001849>心脏有杂音</obo:OAE_0001849>
        <obo:OAE_0004334>10007587</obo:OAE_0004334>
        <rdfs:label>cardiac murmur functional AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005154 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a term used in cardiac physiology that describes the volume of blood being pumped by the heart, by the left and right ventricle, per unit time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_output</obo:IAO_0000119>
        <obo:OAE_0001849>心输出量</obo:OAE_0001849>
        <obo:OAE_0004334>10007594</obo:OAE_0004334>
        <rdfs:label>cardiac output AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005155 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a defect in the structure of the heart or great vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_heart_defect</obo:IAO_0000119>
        <obo:OAE_0001849>心脏间隔缺损</obo:OAE_0001849>
        <obo:OAE_0004334>10064021</obo:OAE_0004334>
        <rdfs:label>cardiac septal defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005156 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the heart becomes thickened without an obvious cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophic_cardiomyopathy</obo:IAO_0000119>
        <obo:OAE_0001849>心脏中隔肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10057576</obo:OAE_0004334>
        <rdfs:label>cardiac septal hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005157 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is the narrowing of the exit of the left ventricle of the heart (where the aorta begins), such that problems result.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aortic_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>心脏瓣膜硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10061082</obo:OAE_0004334>
        <rdfs:label>cardiac valve sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005158 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000784"/>
        <obo:IAO_0000115>This is an AE which is a medical emergency resulting from inadequate blood flow due to the dysfunction of the ventricles of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiogenic_shock</obo:IAO_0000119>
        <obo:OAE_0001849>心原性休克</obo:OAE_0001849>
        <obo:OAE_0004334>10007625</obo:OAE_0004334>
        <rdfs:label>cardiogenic shock AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005159 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers to a cluster of related risk factors for cardiovascular disease that includes abdominal obesity, diabetes, hypertension, and elevated cholesterol.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epidemiology_of_metabolic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>心血管代谢疾病综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10082306</obo:OAE_0004334>
        <rdfs:label>cardio metabolic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005161 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is a sudden loss of blood flow resulting from the failure of the heart to pump effectively.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>心肺骤停</obo:OAE_0001849>
        <obo:OAE_0004334>10007617</obo:OAE_0004334>
        <rdfs:label>cardio-respiratory arrest AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005162 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>This is an AE which is a sudden loss of blood flow resulting from the failure of the heart to pump effectively at neonatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cardiac_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿心肺骤停</obo:OAE_0001849>
        <obo:OAE_0004334>10007618</obo:OAE_0004334>
        <rdfs:label>cardio-respiratory arrest neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005163 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002142"/>
        <obo:IAO_0000115>This is an AE which is a failure of smooth muscle fibers to relax, which can cause the lower esophageal sphincter to remain closed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Esophageal_achalasia</obo:IAO_0000119>
        <obo:OAE_0001849>贲门痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10007645</obo:OAE_0004334>
        <rdfs:label>cardiospasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005164 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which has been a useful index of cardiac dilatation, and a value of 50% is generally considered to indicate the upper limit of normal cardiac size.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7666345/</obo:IAO_0000119>
        <obo:OAE_0001849>心胸比率</obo:OAE_0001849>
        <obo:OAE_0004334>10068336</obo:OAE_0004334>
        <rdfs:label>cardiothoracic ratio AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005165 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a congenital malformation in which the heart is abnormally located either partially or totally outside of the thorax.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ectopia_cordis</obo:IAO_0000119>
        <obo:OAE_0001849>心脏异位</obo:OAE_0001849>
        <obo:OAE_0004334>10014144</obo:OAE_0004334>
        <rdfs:label>ectopia cordis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005166 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is some of the commonest congenital disorders seen in prenatal life and they can be anatomical or functional and can develop de novo or as a consequence of either maternal or fetal disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29716424/</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿心脏疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10052088</obo:OAE_0004334>
        <rdfs:label>foetal cardiac disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005167 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>This is an AE which occurs when transplanted heart is rejected by the recipient&apos;s immune system, which destroys the transplanted heart .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transplant_rejection</obo:IAO_0000119>
        <obo:OAE_0001849>心脏移植排斥反应</obo:OAE_0001849>
        <obo:OAE_0004334>10019315</obo:OAE_0004334>
        <rdfs:label>heart transplant rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005168 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which is a one-way valve that normally allows blood to flow in only one direction through the heart and its functions are incompleted.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heart_valve</obo:IAO_0000119>
        <obo:OAE_0001849>心脏瓣膜功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10067660</obo:OAE_0004334>
        <rdfs:label>heart valve incompetence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005169 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is a type of complications of high blood pressure that affect the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertensive_heart_disease</obo:IAO_0000119>
        <obo:OAE_0001849>高血压心脏肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10020801</obo:OAE_0004334>
        <rdfs:label>hypertensive cardiomegaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005170 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which includes a variety of medical conditions that affect the blood vessels of the brain and the cerebral circulation caused by hypertensive.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cerebrovascular_disease</obo:IAO_0000119>
        <obo:OAE_0001849>高血压脑血管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10077000</obo:OAE_0004334>
        <rdfs:label>hypertensive cerebrovascular disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005171 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001736"/>
        <obo:IAO_0000115>This is an AE which is very high blood pressure with potentially life-threatening symptoms and signs of acute damage to one or more organ systems (especially brain, eyes, heart, aorta, or kidneys).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertensive_emergency</obo:IAO_0000119>
        <obo:OAE_0001849>高血压急症</obo:OAE_0001849>
        <obo:OAE_0004334>10058179</obo:OAE_0004334>
        <rdfs:label>hypertensive emergency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005172 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is general brain dysfunction due to significantly high blood pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertensive_encephalopathy</obo:IAO_0000119>
        <obo:OAE_0001849>高血压脑病</obo:OAE_0001849>
        <obo:OAE_0004334>10020803</obo:OAE_0004334>
        <rdfs:label>hypertensive encephalopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005173 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which includes a number of complications of high blood pressure that affect the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertensive_heart_disease</obo:IAO_0000119>
        <obo:OAE_0001849>高血压心脏病</obo:OAE_0001849>
        <obo:OAE_0004334>10020823</obo:OAE_0004334>
        <rdfs:label>hypertensive heart disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005174 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001736"/>
        <obo:IAO_0000115>This is an AE which is a clinical situation in which blood pressure is very high (e.g., 220/125 mmHg) with minimal or no symptoms, and no signs or symptoms indicating acute organ damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertensive_urgency</obo:IAO_0000119>
        <obo:OAE_0001849>高血压急症</obo:OAE_0001849>
        <obo:OAE_0004334>10058181</obo:OAE_0004334>
        <rdfs:label>hypertensive urgency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005175 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which refers to valvular heart disease resulting from rheumatic fever.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Valvular_heart_disease#Inflammatory_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>风湿性心脏病</obo:OAE_0001849>
        <obo:OAE_0004334>10062110</obo:OAE_0004334>
        <rdfs:label>rheumatic heart disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005176 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001506"/>
        <obo:IAO_0000115>This is an AE which moved from hearts with only one ventricle connected with atria [double inlet ventricle or absent atrioventricular (AV) connection] to hearts not amenable to biventricular repair, namely hearts with two ventricles unable to sustain separately pulmonary and systemic circulations in sequence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25072035/</obo:IAO_0000119>
        <obo:OAE_0001849>单心室心脏</obo:OAE_0001849>
        <obo:OAE_0004334>10045545</obo:OAE_0004334>
        <rdfs:label>univentricular heart AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005177 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>This is an AE which is a surgical transplant procedure performed on patients with end-stage heart failure or severe coronary artery disease when other medical or surgical treatments have failed and the surgical appear complications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heart_transplantation</obo:IAO_0000119>
        <obo:OAE_0001849>移植心脏并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10010184</obo:OAE_0004334>
        <rdfs:label>complications of transplanted heart AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005178 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is when bleeding occurs between the tough outer membrane covering the brain (dura mater) and the skull.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epidural_hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜外血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10015769</obo:OAE_0004334>
        <rdfs:label>extradural hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005179 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is an abnormal connection between arteries and veins, bypassing the capillary system with haemorrhagic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arteriovenous_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>出血热动静脉畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10064595</obo:OAE_0004334>
        <rdfs:label>haemorrhagic arteriovenous malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005180 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002677"/>
        <obo:IAO_0000115>This is an AE which is bleeding within the skull.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intracranial_hemorrhage</obo:IAO_0000119>
        <obo:OAE_0001849>颅内出血</obo:OAE_0001849>
        <obo:OAE_0004334>10018985</obo:OAE_0004334>
        <rdfs:label>hemorrhage intracranial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005181 -->


