        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <obo:IAO_0000115>This is an AE which is a delayed adverse reaction to a blood transfusion or platelet transfusion that occurs when the body has produced alloantibodies to the allogeneic transfused platelets&apos; antigens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
