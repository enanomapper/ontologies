    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000688"/>
        <obo:IAO_0000115>This is an AE which is a condition of excessive air swallowing, which goes to the stomach.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aerophagia</obo:IAO_0000119>
