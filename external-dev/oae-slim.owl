    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>Aplastic anaemia AE is an anemia AE that occurs when the bone marrow, and the blood stem cells that reside there are damaged. This causes a deficiency of all three blood cell types (pancytopenia): red blood cells (anemia), white blood cells (leukopenia), and platelets (thrombocytopenia).</obo:IAO_0000115>
        <obo:IAO_0000117>DJ, SS, JX, YH</obo:IAO_0000117>
        <obo:IAO_0000118>aplastic anemia</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/23292240</obo:IAO_0000119>
        <obo:OAE_0001849>再生障碍性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10002967</obo:OAE_0004334>
        <rdfs:label>aplastic anaemia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001915</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002874</rdfs:seeAlso>
    </owl:Class>
    


