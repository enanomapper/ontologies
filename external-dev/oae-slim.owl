    <!-- http://purl.obolibrary.org/obo/OAE_0009229 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002545"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune rheumatic disease characterised by excessive production and accumulation of collagen, called fibrosis, in the skin and internal organs and by injuries to small arteries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Systemic_scleroderma</obo:IAO_0000119>
        <obo:OAE_0001849>系统性硬皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10078638</obo:OAE_0004334>
        <rdfs:label>systemic scleroderma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009230 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is disease caused by fungi.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fungal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>系统性真菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10052366</obo:OAE_0004334>
        <rdfs:label>systemic mycosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009231 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000482"/>
        <obo:IAO_0000115>This is an AE which is a neurological disorder whose key defining characteristic is a temporary but almost total disruption of short-term memory with a range of problems accessing older memories.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transient_global_amnesia</obo:IAO_0000119>
        <obo:OAE_0001849>全局性失忆</obo:OAE_0001849>
        <obo:OAE_0004334>10058669</obo:OAE_0004334>
        <rdfs:label>global amnesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009232 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is a medically induced coma with loss of protective reflexes, resulting from the administration of one or more general anaesthetic agents.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/General_anaesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>全身麻醉</obo:OAE_0001849>
        <obo:OAE_0004334>10018060</obo:OAE_0004334>
        <rdfs:label>general anaesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009233 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is defined as a seizure that has a tonic phase followed by clonic muscle contractions and is non-motor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32119383/</obo:IAO_0000119>
        <obo:OAE_0001849>非运动性全身性发作</obo:OAE_0001849>
        <obo:OAE_0004334>10083376</obo:OAE_0004334>
        <rdfs:label>generalised onset non-motor seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009234 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries and is generalised .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>全身性红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10051576</obo:OAE_0004334>
        <rdfs:label>generalised erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009235 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder, specifically an anxiety disorder characterized by excessive, uncontrollable and often irrational worry about events or activities.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Generalized_anxiety_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>全身性焦虑障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10018075</obo:OAE_0004334>
        <rdfs:label>generalised anxiety disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009236 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is a large, complex, enveloped virus belonging to the poxvirus family and is generalised desease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaccinia</obo:IAO_0000119>
        <obo:OAE_0001849>全身性牛痘</obo:OAE_0001849>
        <obo:OAE_0004334>10069540</obo:OAE_0004334>
        <rdfs:label>generalised vaccinia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009237 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is associated with poorer sleep quality, with Pittsburgh Sleep Quality Index score above 6.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32580764/</obo:IAO_0000119>
        <obo:OAE_0001849>全身性瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10052576</obo:OAE_0004334>
        <rdfs:label>pruritus generalised AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009238 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is described as pruritic erythematous, raised, circumscribed lesions with central pallor that blanch with pressure and is generalised desease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31690389/</obo:IAO_0000119>
        <obo:OAE_0001849>全身性荨麻疹</obo:OAE_0001849>
        <obo:OAE_0004334>10052569</obo:OAE_0004334>
        <rdfs:label>urticaria generalised AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009239 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000415"/>
        <obo:IAO_0000115>This is an AE which is the loss of all skull and facial hair and its causes are unclear, but believed to be autoimmune.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alopecia_totalis</obo:IAO_0000119>
        <obo:OAE_0001849>全秃</obo:OAE_0001849>
        <obo:OAE_0004334>10001766</obo:OAE_0004334>
        <rdfs:label>alopecia totalis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009240 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>全身症状</obo:OAE_0001849>
        <obo:OAE_0004334>10060891</obo:OAE_0004334>
        <rdfs:label>general symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009241 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which can be spread over a large area it does not obstruct venous return.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/5085940/</obo:IAO_0000119>
        <obo:OAE_0001849>重力性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10018713</obo:OAE_0004334>
        <rdfs:label>gravitational edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009242 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002393"/>
        <obo:IAO_0000115>This is an AE which is a benign growth on the pituitary gland in the brain, specifically a mucin-filled cyst in the posterior portion of the anterior pituitary gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rathke%27s_cleft_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>Rathke裂囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10058969</obo:OAE_0004334>
        <rdfs:label>rathke&apos;s cleft cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009243 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004270"/>
        <obo:IAO_0000115>This is an AE which is a closed sac, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10011732</obo:OAE_0004334>
        <rdfs:label>cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009244 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a collection of cerebrospinal fluid (CSF), without blood, located under the dural membrane of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subdural_hygroma</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜下水瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10048626</obo:OAE_0004334>
        <rdfs:label>subdural hygroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009245 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is a common, sometimes chronic skin condition which presents as reddish bumps on the skin arranged in a circle or ring.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma_annulare</obo:IAO_0000119>
        <obo:OAE_0001849>环状肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10018692</obo:OAE_0004334>
        <rdfs:label>granuloma annulare AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009246 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a condition in the fetus characterized by an accumulation of fluid, or edema, in at least two fetal compartments.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hydrops_fetalis</obo:IAO_0000119>
        <obo:OAE_0001849>胎儿水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10020529</obo:OAE_0004334>
        <rdfs:label>hydrops foetalis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009247 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the central nervous system of a person has multiple demyelinating lesions with atypical characteristics for those of standard multiple sclerosis (MS).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tumefactive_multiple_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>肿瘤性多发性硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10078556</obo:OAE_0004334>
        <rdfs:label>tumefactive multiple sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009248 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a condition or lesion involving abnormal cells which are associated with an increased risk of developing into cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Precancerous_condition</obo:IAO_0000119>
        <obo:OAE_0001849>癌前病变</obo:OAE_0001849>
        <obo:OAE_0004334>10083553</obo:OAE_0004334>
        <rdfs:label>precancerous condition AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009249 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition characterized by dependent edema from vasodilatory pooling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heat_edema</obo:IAO_0000119>
        <obo:OAE_0001849>热水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10019340</obo:OAE_0004334>
        <rdfs:label>heat edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009250 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition that develop in patients with an acute exacerbation of chronic edema, particularly of the lower extremities, and in the setting of anasarca.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema_blister</obo:IAO_0000119>
        <obo:OAE_0001849>水肿泡</obo:OAE_0001849>
        <obo:OAE_0004334>10080039</obo:OAE_0004334>
        <rdfs:label>edema blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009251 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004270"/>
        <obo:IAO_0000115>This is an AE which is a cyst in the eyelid usually due to a blocked meibomian gland,typically in the middle of the eyelid, red, and not painful.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chalazion</obo:IAO_0000119>
        <obo:OAE_0001849>睑板腺囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10008388</obo:OAE_0004334>
        <rdfs:label>chalazion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009252 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a deposition of yellowish cholesterol-rich material that can appear anywhere in the body in various disease states.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Xanthoma</obo:IAO_0000119>
        <obo:OAE_0001849>黄瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10048214</obo:OAE_0004334>
        <rdfs:label>xanthoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009253 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is a fluid-filled bump associated with a joint or tendon sheath.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ganglion_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>滑膜囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10042858</obo:OAE_0004334>
        <rdfs:label>synovial cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009254 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a group of abnormal cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Carcinoma_in_situ</obo:IAO_0000119>
        <obo:OAE_0001849>原位癌</obo:OAE_0001849>
        <obo:OAE_0004334>10061450</obo:OAE_0004334>
        <rdfs:label>carcinoma in situ AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009255 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of subcutaneous blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>皮下血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10042345</obo:OAE_0004334>
        <rdfs:label>subcutaneous hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009256 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a malignant and aggressive neoplasm with unclear molecular etiology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32166375/</obo:IAO_0000119>
        <obo:OAE_0001849>基底鳞状癌</obo:OAE_0001849>
        <obo:OAE_0004334>10004178</obo:OAE_0004334>
        <rdfs:label>basosquamous carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009257 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a malignant tumor in the mediastinum, the cavity that separates the lungs from the rest of the chest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mediastinal_tumors</obo:IAO_0000119>
        <obo:OAE_0001849>恶性纵隔肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061241</obo:OAE_0004334>
        <rdfs:label>malignant mediastinal neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009258 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a malignant tumor, a type of cancer that arises from transformed cells of mesenchymal (connective tissue) origin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10039491</obo:OAE_0004334>
        <rdfs:label>sarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a mass of cells (tumor) that lacks the ability to either invade neighboring tissue or metastasize (spread throughout the body).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>良性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10060999</obo:OAE_0004334>
        <rdfs:label>benign neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009260 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a pre-cancerous area of thick, scaly, or crusty skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Actinic_keratosis</obo:IAO_0000119>
        <obo:OAE_0001849>光线性角化病</obo:OAE_0001849>
        <obo:OAE_0004334>10000614</obo:OAE_0004334>
        <rdfs:label>actinic keratosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009261 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is a primary cause of reduced vision following both cataract and successful vitreoretinal surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28351047/</obo:IAO_0000119>
        <obo:OAE_0001849>囊状的黄斑水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10058202</obo:OAE_0004334>
        <rdfs:label>cystoid macular edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009262 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a rare clinical condition characterised by diffuse woody induration of skin commonly associated with diabetes mellitus,infections and monoclonal gammopathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32539033/</obo:IAO_0000119>
        <obo:OAE_0001849>硬化病</obo:OAE_0001849>
        <obo:OAE_0004334>10055953</obo:OAE_0004334>
        <rdfs:label>scleredema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009263 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a rare condition. Desmoid tumors arise from cells called fibroblasts, which are found throughout the body and provide structural support, protection to the vital organs, and play a critical role in wound healing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aggressive_fibromatosis</obo:IAO_0000119>
        <obo:OAE_0001849>硬纤维瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10059352</obo:OAE_0004334>
        <rdfs:label>desmoid tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009264 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder defined as a pathological overgrowth of normal epidural fat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10745936/</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜外脂肪瘤病</obo:OAE_0001849>
        <obo:OAE_0004334>10067599</obo:OAE_0004334>
        <rdfs:label>epidural lipomatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009265 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is a rare skin disorder that primarily affects children under one year of age but can also be found in older children and adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Juvenile_xanthogranuloma</obo:IAO_0000119>
        <obo:OAE_0001849>黄色肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051251</obo:OAE_0004334>
        <rdfs:label>xanthogranuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009266 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a rare tumor of the adrenal medulla composed of chromaffin cells, also known as pheochromocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pheochromocytoma</obo:IAO_0000119>
        <obo:OAE_0001849>嗜铬细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10034800</obo:OAE_0004334>
        <rdfs:label>phaeochromocytoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009267 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a serious long-term complication in cancer survivors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28373478/</obo:IAO_0000119>
        <obo:OAE_0001849>第二原发恶性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10039801</obo:OAE_0004334>
        <rdfs:label>second primary malignancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009268 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a sharply demarcated yellowish deposit of cholesterol underneath the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Xanthelasma</obo:IAO_0000119>
        <obo:OAE_0001849>黄瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10048211</obo:OAE_0004334>
        <rdfs:label>xanthelasma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009269 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is a skin condition that most commonly presents with symmetrical round-to-oval red or violet plaques on the flanks, armpits, inner thighs, and lower abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Interstitial_granulomatous_dermatitis_with_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>间质性肉芽肿性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067972</obo:OAE_0004334>
        <rdfs:label>interstitial granulomatous dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009270 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome (a set of signs and symptoms) that is the consequence of cancer in the body, specifically due to the production of chemical signaling molecules (such as hormones or cytokines) by tumor cells or by an immune response against the tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paraneoplastic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>副肿瘤综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10059420</obo:OAE_0004334>
        <rdfs:label>paraneoplastic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009271 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is a term used synonymously with severe hypothyroidism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myxedema</obo:IAO_0000119>
        <obo:OAE_0001849>粘液性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10028665</obo:OAE_0004334>
        <rdfs:label>myxedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009272 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a tumor in the mediastinum, the cavity that separates the lungs from the rest of the chest.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mediastinal_tumors</obo:IAO_0000119>
        <obo:OAE_0001849>纵隔肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10027076</obo:OAE_0004334>
        <rdfs:label>mediastinal mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009273 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a tumor in the mediastinum, the cavity that separates the lungs from the rest of the chest. It contains the heart, esophagus, trachea, thymus, and aorta.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mediastinal_tumors</obo:IAO_0000119>
        <obo:OAE_0001849>纵隔肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10027086</obo:OAE_0004334>
        <rdfs:label>mediastinum neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009274 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a tumor made up of several different types of tissue, such as hair, muscle, teeth, or bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Teratoma</obo:IAO_0000119>
        <obo:OAE_0001849>畸胎瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10043276</obo:OAE_0004334>
        <rdfs:label>teratoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009275 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which is a tumor that arises from the ependyma, a tissue of the central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ependymoma</obo:IAO_0000119>
        <obo:OAE_0001849>室管膜瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10014967</obo:OAE_0004334>
        <rdfs:label>ependymoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009276 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a tumor that can develop on any skin or mucosal surface, but occurs on the tongue 40% of the time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granular_cell_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>颗粒细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10060980</obo:OAE_0004334>
        <rdfs:label>granular cell tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009277 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10028980</obo:OAE_0004334>
        <rdfs:label>neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009278 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of cancer that can form masses in the skin, in lymph nodes, in the mouth, or in other organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kaposi%27s_sarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>卡波济氏肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10023284</obo:OAE_0004334>
        <rdfs:label>kaposi&apos;s sarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009279 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of cancer that may be a bone sarcoma or a soft-tissue sarcoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ewing%27s_sarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>尤文氏肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10015560</obo:OAE_0004334>
        <rdfs:label>ewing&apos;s sarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009280 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of connective tissue cancer in which the cells are spindle-shaped when examined under a microscope.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spindle_cell_sarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>梭形细胞肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10049067</obo:OAE_0004334>
        <rdfs:label>spindle cell sarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009281 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of highly malignant cancer that most commonly arises within the lung, although it can occasionally arise in other body sites, such as the cervix, prostate, and gastrointestinal tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Small-cell_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>小细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10041056</obo:OAE_0004334>
        <rdfs:label>small cell carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009282 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of skin cancer that develops from the pigment-producing cells known as melanocytes in situ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melanoma</obo:IAO_0000119>
        <obo:OAE_0001849>原位恶性黑色素瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10025652</obo:OAE_0004334>
        <rdfs:label>malignant melanoma in situ AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009283 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of skin cancer that develops from the pigment-producing cells known as melanocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Melanoma</obo:IAO_0000119>
        <obo:OAE_0001849>恶性黑色素瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10025650</obo:OAE_0004334>
        <rdfs:label>malignant melanoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009284 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which is a type of skin infection which typically occurs as a cyst between the cheeks of the buttocks and often at the upper end.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pilonidal_disease</obo:IAO_0000119>
        <obo:OAE_0001849>藏毛囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10035043</obo:OAE_0004334>
        <rdfs:label>pilonidal cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009285 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002464"/>
        <obo:IAO_0000115>This is an AE which is a usually benign (non-malignant) cyst in the pineal gland, a small endocrine gland in the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
