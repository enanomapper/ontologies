        <obo:IAO_0000118>HCM</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001243/</obo:IAO_0000119>
        <obo:OAE_0004334>10020871</obo:OAE_0004334>
        <rdfs:label>hypertrophic cardiomyopathy AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001639</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007194</rdfs:seeAlso>
    </owl:Class>
    


