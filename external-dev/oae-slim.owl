        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000967"/>
        <obo:IAO_0000115>a gastric ulcer AE that has severely altered GI function; TPN indicated; elective operative or endoscopic intervention indicated; limiting self care activities of daily living; disabling</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 gastric ulcer AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10730</rdfs:seeAlso>
