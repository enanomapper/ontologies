        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a clinical sign that results from unequal intrathoracic pressure within the chest cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
