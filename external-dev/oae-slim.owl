        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is inflammation of small blood vessels (usually post-capillary venules in the dermis), characterized by palpable purpura.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cutaneous_small-vessel_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>高敏感性脉管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10020764</obo:OAE_0004334>
        <rdfs:label>hypersensitivity vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006921 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is not well-known in clinical practice and it might be combined with the adverse reactions of intravascular contrast media which contain iodine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16573176/</obo:IAO_0000119>
        <obo:OAE_0001849>碘过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10052098</obo:OAE_0004334>
        <rdfs:label>iodine allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006922 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a medical term encompassing a range of allergic reactions to the proteins present in natural rubber latex.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Latex_allergy</obo:IAO_0000119>
        <obo:OAE_0001849>乳胶过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10056435</obo:OAE_0004334>
        <rdfs:label>latex allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006923 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is an adverse immune reaction to one or more proteins in cow&apos;s milk.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Milk_allergy</obo:IAO_0000119>
        <obo:OAE_0001849>牛奶过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10027633</obo:OAE_0004334>
        <rdfs:label>milk allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006924 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a number of conditions caused by hypersensitivity of the immune system to typically substances such as mite in the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Allergy</obo:IAO_0000119>
        <obo:OAE_0001849>螨过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10077290</obo:OAE_0004334>
        <rdfs:label>mite allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006925 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the application site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>用药部位脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10057881</obo:OAE_0004334>
        <rdfs:label>application site abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006926 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a number of conditions caused by hypersensitivity of the immune system to typically substances such as mycotic in the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Allergy</obo:IAO_0000119>
        <obo:OAE_0001849>对霉菌过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10052758</obo:OAE_0004334>
        <rdfs:label>mycotic allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006927 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch caused by allergic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>瘙痒过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10063438</obo:OAE_0004334>
        <rdfs:label>pruritus allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006928 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001653"/>
        <obo:IAO_0000115>This is an AE which is a glycoprotein enzyme encoded in humans by the KLK3 gene and is free .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prostate-specific_antigen</obo:IAO_0000119>
        <obo:OAE_0001849>游离前列腺特异性抗原</obo:OAE_0001849>
        <obo:OAE_0004334>10053837</obo:OAE_0004334>
        <rdfs:label>free prostate-specific antigen AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006929 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004375"/>
        <obo:IAO_0000115>This is an AE which occurs when transplanted kidney tissue is rejected by the recipient&apos;s immune system, which destroys the transplanted tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transplant_rejection</obo:IAO_0000119>
        <obo:OAE_0001849>肾移植排斥反应</obo:OAE_0001849>
        <obo:OAE_0004334>10023439</obo:OAE_0004334>
        <rdfs:label>kidney transplant rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006930 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004375"/>
        <obo:IAO_0000115>This is an AE which occurs when transplanted tissue is rejected by the recipient&apos;s immune system, which destroys the transplanted tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transplant_rejection</obo:IAO_0000119>
        <obo:OAE_0001849>移植排斥</obo:OAE_0001849>
        <obo:OAE_0004334>10044439</obo:OAE_0004334>
        <rdfs:label>transplant rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006931 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which refers an unfavorable evolution of a disease, health condition or medical treatment after transplantation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complication</obo:IAO_0000119>
        <obo:OAE_0001849>移植并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10074555</obo:OAE_0004334>
        <rdfs:label>transplantation complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006932 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004443"/>
        <obo:IAO_0000115>This is an AE which is a kidney disorder which is the leading cause of kidney transplant failure, occurring months to years after the transplant.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_allograft_nephropathy</obo:IAO_0000119>
        <obo:OAE_0001849>慢性同种异体移植物肾病</obo:OAE_0001849>
        <obo:OAE_0004334>10063209</obo:OAE_0004334>
        <rdfs:label>chronic allograft nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006933 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is the organ transplant of a kidney into a patient with end-stage kidney disease (ESRD) and occurs complications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_transplantation</obo:IAO_0000119>
        <obo:OAE_0001849>移植肾并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10010185</obo:OAE_0004334>
        <rdfs:label>complications of transplanted kidney AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006934 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>This is an AE which  is characterized by a significant reduction in one or more of the cellular elements of the blood in the presence of normocellular or hypercellular bone marrow and splenomegaly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23454561/</obo:IAO_0000119>
        <obo:OAE_0001849>脾功能亢进</obo:OAE_0001849>
        <obo:OAE_0004334>10020769</obo:OAE_0004334>
        <rdfs:label>hypersplenism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006935 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is associated with autoimmune diseases, inflammatory bowel disease, severe celiac disease, autoimmune thyroiditis, untreated HIV infection and chronic graft-versus-host disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32563569/</obo:IAO_0000119>
        <obo:OAE_0001849>脾功能减退症</obo:OAE_0001849>
        <obo:OAE_0004334>10079831</obo:OAE_0004334>
        <rdfs:label>hyposplenism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006936 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003326"/>
        <obo:IAO_0000115>This is an AE which is a non-surgical procedure developed to treat hypersplenism as a result of hepatic disease and thus avoid the disadvantages of splenectomy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18034810/</obo:IAO_0000119>
        <obo:OAE_0001849>部分脾栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10081995</obo:OAE_0004334>
        <rdfs:label>partial splenic embolisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006937 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which refers abnormal accumulation of fluid in the interstitium on the spleen, manifesting as swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congestion</obo:IAO_0000119>
        <obo:OAE_0001849>脾淤血</obo:OAE_0001849>
        <obo:OAE_0004334>10050294</obo:OAE_0004334>
        <rdfs:label>spleen congestion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006938 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which is the accumulation of calcium salts in a splenic tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Calcification</obo:IAO_0000119>
        <obo:OAE_0001849>脾钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10068608</obo:OAE_0004334>
        <rdfs:label>splenic calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006939 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which is most commonly due to endemic parasites or congenital (epithelial) cysts  in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27403673/</obo:IAO_0000119>
        <obo:OAE_0001849>脾囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051169</obo:OAE_0004334>
        <rdfs:label>splenic cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006940 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is an aggregation of macrophages that forms in response to chronic inflammation on the splenic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>脾肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10064249</obo:OAE_0004334>
        <rdfs:label>splenic granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006941 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a splenic localized bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>脾血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10041646</obo:OAE_0004334>
        <rdfs:label>splenic hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006942 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which is a condition in which blood flow supply to the spleen is compromised,leading to partial or complete infarction (tissue death due to oxygen shortage) in the organ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Splenic_infarction</obo:IAO_0000119>
        <obo:OAE_0001849>脾梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10041648</obo:OAE_0004334>
        <rdfs:label>splenic infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006943 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which includes a ruptured spleen, is any injury to the spleen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Splenic_injury</obo:IAO_0000119>
        <obo:OAE_0001849>脾脏损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10041649</obo:OAE_0004334>
        <rdfs:label>splenic injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006944 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of splenic, usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>脾脏病变</obo:OAE_0001849>
        <obo:OAE_0004334>10054829</obo:OAE_0004334>
        <rdfs:label>splenic lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006945 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is any injury to the spleen and the rupture of a normal spleen can be caused by trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Splenic_injury</obo:IAO_0000119>
        <obo:OAE_0001849>脾破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10041658</obo:OAE_0004334>
        <rdfs:label>splenic rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006946 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002550"/>
        <obo:IAO_0000115>This is an AE which is an enlargement of the spleen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Splenomegaly</obo:IAO_0000119>
        <obo:OAE_0001849>脾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10058339</obo:OAE_0004334>
        <rdfs:label>splenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006947 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002617"/>
        <obo:IAO_0000115>This is an AE which is the result of spleen tissue breaking off the main organ and implanting at another site inside the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Splenosis</obo:IAO_0000119>
        <obo:OAE_0001849>脾组织移植</obo:OAE_0001849>
        <obo:OAE_0004334>10050357</obo:OAE_0004334>
        <rdfs:label>splenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006948 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which refers to the absence of normal spleen function and is associated with some serious infection risks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Asplenia</obo:IAO_0000119>
        <obo:OAE_0001849>无脾</obo:OAE_0001849>
        <obo:OAE_0004334>10053622</obo:OAE_0004334>
        <rdfs:label>asplenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006949 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001881"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the tonsils in the upper part of the throat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tonsillitis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性扁桃体炎</obo:OAE_0001849>
        <obo:OAE_0004334>10009152</obo:OAE_0004334>
