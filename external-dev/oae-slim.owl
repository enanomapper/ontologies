        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002467"/>
        <obo:IAO_0000115>This is an AE which is the pathologic process that results in an area of necrotic tissue in the brain (cerebral infarct) with haemorrhagic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
