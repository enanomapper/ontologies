    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008556 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is defined by the Diagnostic and Statistical Manual of Mental Disorders, 4th Edition, Text Revision, as a persistent or recurrent delay in, or absence of, orgasm following a &apos;normal&apos; sexual excitement phase.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22005203/</obo:IAO_0000119>
        <obo:OAE_0001849>女性性高潮障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10016405</obo:OAE_0004334>
        <rdfs:label>female orgasmic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008557 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a rare medical condition of the breast connective tissues in which the breasts become excessively large.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Breast_hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>肥大的乳房</obo:OAE_0001849>
        <obo:OAE_0004334>10020881</obo:OAE_0004334>
        <rdfs:label>hypertrophy breast AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008558 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is one of the most aggressive forms of breast cancer and can occur at any age (and, extremely rarely, in men).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammatory_breast_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>乳腺炎性癌</obo:OAE_0001849>
        <obo:OAE_0004334>10021980</obo:OAE_0004334>
        <rdfs:label>inflammatory carcinoma of the breast AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008559 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004284"/>
        <obo:IAO_0000115>This is an AE which refers to infertility in women.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Female_infertility</obo:IAO_0000119>
        <obo:OAE_0001849>不孕女性</obo:OAE_0001849>
        <obo:OAE_0004334>10021928</obo:OAE_0004334>
        <rdfs:label>infertility female AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008560 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004284"/>
        <obo:IAO_0000115>This is an AE which refers to a sexually mature male&apos;s inability to impregnate a fertile female.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Male_infertility</obo:IAO_0000119>
        <obo:OAE_0001849>男性不育</obo:OAE_0001849>
        <obo:OAE_0004334>10021929</obo:OAE_0004334>
        <rdfs:label>infertility male AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008561 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of tumor that can occur within the cells of the pancreatic duct.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intraductal_papillary_mucinous_neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>导管内乳头状黏液性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10070999</obo:OAE_0004334>
        <rdfs:label>intraductal papillary mucinous neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008562 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which including usual ductal hyperplasia (UDH), atypical ductal hyperplasia (ADH) and ductal carcinoma in situ (DCIS) are associated with increased risk, albeit of greatly different magnitudes, for the subsequent development of invasive carcinoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27498697/</obo:IAO_0000119>
        <obo:OAE_0001849>乳腺导管内增生性病变</obo:OAE_0001849>
        <obo:OAE_0004334>10073094</obo:OAE_0004334>
        <rdfs:label>intraductal proliferative breast lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008563 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is the most common &apos;special&apos; morphological subtype of breast cancer, comprising up to 15% of all cases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25849106/</obo:IAO_0000119>
        <obo:OAE_0001849>浸润性小叶乳腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10073096</obo:OAE_0004334>
        <rdfs:label>invasive lobular breast carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008564 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a risk factor and a nonobligate precursor of breast carcinoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29413653/</obo:IAO_0000119>
        <obo:OAE_0001849>原位小叶性乳腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10073099</obo:OAE_0004334>
        <rdfs:label>lobular breast carcinoma in situ AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008565 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004306"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the breast or udder, usually associated with breastfeeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mastitis</obo:IAO_0000119>
        <obo:OAE_0001849>乳腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10026883</obo:OAE_0004334>
        <rdfs:label>mastitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008566 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is a raised region of tissue on the surface of the breast from which , in females, milk leaves the breast through the lactiferous ducts to feed an infant; meantime,its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nipple</obo:IAO_0000119>
        <obo:OAE_0001849>乳头紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10029417</obo:OAE_0004334>
        <rdfs:label>nipple disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008567 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is one of the most common reasons given by mothers for ceasing exclusive breastfeeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26426034/</obo:IAO_0000119>
        <obo:OAE_0001849>乳头疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10029421</obo:OAE_0004334>
        <rdfs:label>nipple pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008568 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of a nipple  part or area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>乳头肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10058680</obo:OAE_0004334>
        <rdfs:label>nipple swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008569 -->


