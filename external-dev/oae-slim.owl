    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <obo:IAO_0000115>Persistent tachycardia AE is a tachycardia AE that is an increased heart rate that exceeds the normal range for a resting heartrate (heartrate in an inactive or sleeping individual). It&apos;s a constant process.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>持续心动过速</obo:OAE_0001849>
