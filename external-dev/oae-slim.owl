    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>Mild headache AE is a headache AE that shows mild headache.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>轻度头痛</obo:OAE_0001849>
        <rdfs:label>mild headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002273 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000617"/>
        <obo:IAO_0000115>Transient hypoxemia AE is a hypoxia AE that is a reduced concentration of O2 in the blood, alveoli or other tissues resulting in the decreased pressure of this component of body gases.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>瞬态低氧血症</obo:OAE_0001849>
        <rdfs:label>transient hypoxemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002274 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002024"/>
        <obo:IAO_0000115>Transient neuroticism AE is a neuroticism AE that is a type of personality trait that contrasts adjustment or emotional stability with maladjustment. Experience of anxiety, anger, disgust, sadness, embarrassment, and a variety of other negative emotions.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>瞬态神经质</obo:OAE_0001849>
        <rdfs:label>transient neuroticism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002275 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001105"/>
        <obo:IAO_0000115>Constant irritability AE is a irritability AE that shows in the patient being easily annoyed/irritated constantly.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>持续烦躁</obo:OAE_0001849>
        <rdfs:label>constant irritability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002276 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000382"/>
        <obo:IAO_0000115>Abnormal atony AE is a asthenia AE that is a medical term denoting symptoms of physical weakness and loss of strength.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>异常无力</obo:OAE_0001849>
        <rdfs:label>abnormal atony AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002277 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Secondary hypotension AE is a hypotension AE that is a type of hypertension which by definition is caused by an identifiable underlying secondary cause.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Secondary_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>继发性高血压</obo:OAE_0001849>
        <rdfs:label>secondary hypotension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002278 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001467"/>
        <obo:IAO_0000115>Transient elevated serum transaminase AE is a transaminase level increased AE that shows elevated levels of alanine transaminase and aspartate transaminase transiently.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>瞬时血清转氨酶升高</obo:OAE_0001849>
        <rdfs:label>transient elevated serum transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002279 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000747"/>
        <obo:IAO_0000115>Transient elevated blood urea nitrogen AE is a blood urea level increased AE that shows a transient increase in amount of urea in blood.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>瞬时血尿素氮升高</obo:OAE_0001849>
        <rdfs:label>transient elevated blood urea nitrogen AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002280 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000529"/>
        <obo:IAO_0000115>Apparent increased blood creatine phosphokinase AE is a blood creatine phosphokinase level increased AE that is characterized by an apparent increased level of creatine phosphokinase or phosphocreatine kinase.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>明显的血肌酸磷酸激酶增高</obo:OAE_0001849>
        <rdfs:label>apparent increased blood creatine phosphokinase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002281 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001378"/>
        <obo:IAO_0000115>Severe rhabdomyolysis AE is a rhabdomyolysis AE that shows in severe damaged skeletal muscle tissue breaks down rapidly.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>严重的横纹肌溶解症</obo:OAE_0001849>
        <rdfs:label>severe rhabdomyolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002282 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000416"/>
        <obo:IAO_0000115>Mild gastrointestinal bleeding AE is a gastrointestinal hemorrhage AE that shows mild gastrointestinal hemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>胃肠道轻微出血</obo:OAE_0001849>
        <rdfs:label>mild gastrointestinal bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002283 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000416"/>
        <obo:IAO_0000115>Occult gastrointestinal tract bleeding AE is a gastrointestinal hemorrhage AE that shows occult gastrointestinal hemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>胃肠道隐匿性出血</obo:OAE_0001849>
        <rdfs:label>occult gastrointestinal tract bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002284 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <obo:IAO_0000115>Nitrate headache AE is a headache AE that that is a special headache induced by nitrate.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>硝酸盐性头痛</obo:OAE_0001849>
        <rdfs:label>nitrate headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002285 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Pantomorphia erythema exudativum AE is a skin AE that  is a skin condition of unknown cause, possibly mediated by deposition of immune complex (mostly IgM) in the superficial microvasculature of the skin and oral mucous membrane that usually follows an infection or drug exposure. It is an uncommon disorder, with peak incidence in the second and third decades of life.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythema_multiforme</obo:IAO_0000119>
        <obo:OAE_0001849>多形性渗出性红斑</obo:OAE_0001849>
        <rdfs:label>pantomorphia erythema exudativum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002286 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000034"/>
        <obo:IAO_0000115>High hypodynamia AE is a fatigue AE that is a state of awareness describing a range of afflictions, usually associated with physical and/or mental weakness, though varying from a general state of lethargy to a specific work-induced burning sensation within one&apos;s muscles. Physical fatigue is the inability to continue functioning at the level of one&apos;s normal abilities.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>高度乏力</obo:OAE_0001849>
        <rdfs:label>high hypodynamia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002287 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <obo:IAO_0000115>Short-time nausea AE is a nausea AE that shows a gastric discomfort associated with the inclination to vomit.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>短暂的恶心</obo:OAE_0001849>
        <rdfs:label>short-time nausea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002288 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000656"/>
        <obo:IAO_0000115>Slightly increased aspartic transaminase AE is a aspartate aminotransferase level increased AE that shows a slightly increased amount of AST which is an enzyme normally present in body tissues especially of the heart and liver,</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>门冬氨酸氨基转移酶轻度升高</obo:OAE_0001849>
        <rdfs:label>slightly increased aspartic transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002289 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000272"/>
        <obo:IAO_0000115>Slightly increased alanine aminotransferase AE is a alanine aminotransferase level increased AE that shows elevated levels of alanine transaminase slightly.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>丙氨酸氨基转移酶轻度升高</obo:OAE_0001849>
        <rdfs:label>slightly increased alanine aminotransferase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002290 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000737"/>
        <obo:IAO_0000115>Slightly increased lactic dehydrogenase AE is a blood lactate dehydrogenase level increased AE that shows a slightly increased amount of LDH which is an enzyme that could indicate tissue damage.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>乳酸脱氢酶轻度升高</obo:OAE_0001849>
        <rdfs:label>slightly increased lactic dehydrogenase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002291 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000720"/>
        <obo:IAO_0000115>Slightly increased alkaline phosphatase AE is a blood alkaline phosphatase increased AE that shows elevated levels of alkaline phosphatase slightly.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>碱性磷酸酶轻度升高</obo:OAE_0001849>
        <rdfs:label>slightly increased alkaline phosphatase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002292 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000656"/>
        <obo:IAO_0000115>Slightly increased glutamic-oxalacetic transaminase AE is a aspartate aminotransferase level increased AE that shows a slightly increased amount of glutamic-oxalacetic transaminase in the heart and liver.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>谷草转氨酶轻度升高</obo:OAE_0001849>
        <rdfs:label>slightly increased glutamic-oxalacetic transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002293 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000272"/>
        <obo:IAO_0000115>Slightly increased glutamic pyruvic transaminase AE is a alanine aminotransferase level increased AE that shows eelevated levels of glutamic pyruvic transaminase in the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>谷丙转氨酶轻度升高</obo:OAE_0001849>
        <rdfs:label>slightly increased glutamic pyruvic transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002294 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <obo:IAO_0000115>Transient ischemic stroke AE is a ischemic stroke AE that occurs when a blood vessel that supplies the brain becomes blocked or &quot;clogged&quot; and impairs blood flow to part of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>暂时性缺血性中风</obo:OAE_0001849>
        <rdfs:label>transient ischemic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002295 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001025"/>
        <obo:IAO_0000115>Evidently increased hepatic lipase AE is a hepatic enzyme increased AE that shows an evidently increase in amount of hepatic enzyme in body, commonly includes ALT and AST. It may indicate inflammation or damage to liver cells.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>肝酶显著增加</obo:OAE_0001849>
        <rdfs:label>evidently increased hepatic lipase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002296 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002296">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Mild decline in blood pressure AE is a hypotension AE that shows mild sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>血压轻度下降</obo:OAE_0001849>
        <rdfs:label>mild decline in blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002297 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000802"/>
        <obo:IAO_0000115>Transient cerebral ischemic attacks AE is a cerebral ischemia AE that shows the sudden death of brain cells in a localized area due to inadequate blood flow.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>短暂脑缺血发作</obo:OAE_0001849>
        <rdfs:label>transient cerebral ischemic attacks AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002298 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Transient hypotension AE is a hypotension AE that shows transient sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>瞬时低血压</obo:OAE_0001849>
        <rdfs:label>transient hypotension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002299 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Obviously decreased blood pressure AE is a hypotension AE that shows obviously sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>significantly decreased blood pressure AE</obo:IAO_0000118>
        <obo:OAE_0001849>血压明显下降</obo:OAE_0001849>
        <rdfs:label>obviously decreased blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002300 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <obo:IAO_0000115>Transient dizzy AE is a dizziness AE that shows transient dizziness.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>瞬时头晕</obo:OAE_0001849>
        <rdfs:label>transient dizzy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002301 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001463"/>
        <obo:IAO_0000115>Short-time hepatic function disorder AE is a hepatic function abnormal AE that shows a short-time abnormal functionality of the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>短暂肝功能异常</obo:OAE_0001849>
        <rdfs:label>short-time hepatic function disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002302 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000729"/>
        <obo:IAO_0000115>A slightly elevated plasma creatinine level AE is a blood creatinine level increased AE that shows an slightly increased level of creatinine in the blood (due to lack of kidney activity).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>血浆肌酐水平的轻微升高</obo:OAE_0001849>
        <rdfs:label>a slightly elevated plasma creatinine level AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002303 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Sudden fall of blood pressure AE is a hypotension AE that shows sudden sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>血压突然降低</obo:OAE_0001849>
        <rdfs:label>sudden fall of blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002304 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Severe hypertension AE is a hypotension AE that shows severe sustained high blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>严重高血压</obo:OAE_0001849>
        <rdfs:label>severe hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002305 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>Severe arrhythmia AE is an arrhythmia AE that shows severe abnormal heart rhythm.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>严重心律失常</obo:OAE_0001849>
