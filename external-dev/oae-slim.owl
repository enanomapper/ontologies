    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002596 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002595"/>
        <obo:IAO_0000115>a blood carbon dioxide abnormal AE in which the levels of carbon dioxide in the blood is abnormally high</obo:IAO_0000115>
        <obo:IAO_0000117>DJ, SS, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>CO2 retention AE</obo:IAO_0000118>
        <obo:IAO_0000118>hypercapnea AE</obo:IAO_0000118>
        <obo:IAO_0000118>hypercarbia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: https://en.wikipedia.org/wiki/Hypercapnia</obo:IAO_0000119>
        <obo:OAE_0004334>10020591</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypercapnia AE</rdfs:label>
        <rdfs:seeAlso>UMLS CUI: C0020440</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>a rash AE that shows follicular eruptions characterized by papules and pustules resembling acne.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>acneiform eruption AE</obo:IAO_0000118>
        <obo:IAO_0000118>rash acneiform AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acne_vulgaris</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acneiform_eruption</obo:IAO_0000119>
        <obo:OAE_0004334>10037847</obo:OAE_0004334>
        <rdfs:comment>The term &quot;acneiform&quot;, literally, refers to an appearance similar to acne. Acne vulgaris (or simply acne) is a long-term skin condition characterized by areas of blackheads, whiteheads, pimples, greasy skin, and possibly scarring.</rdfs:comment>
        <rdfs:label xml:lang="en">acneiform rash AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13694</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35277</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002600 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>A rash AE that is characterized by an eruption consisting of papules (a small, raised pimple) and pustules (a small pus filled blister), typically appearing in face, scalp, and upper chest and back.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medaphile.com/medical-dictionary/papulopustular-rash</obo:IAO_0000119>
        <obo:OAE_0004334>10069138</obo:OAE_0004334>
        <rdfs:comment>Unlike acne, papulopustular rash does not present with whiteheads or blackheads, and can be symptomatic, with itchy or tender lesions.</rdfs:comment>
        <rdfs:label xml:lang="en">papulopustular rash AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11491</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C80119</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002601 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>an neuropathy AE that occurs when any of the twelve cranial nerves (nerves that exit from the brain directly) are damaged.</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.emedicinehealth.com/neuropathy/article_em.htm#types_of_neuropathy</obo:IAO_0000119>
        <obo:OAE_0004334>10061096</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cranial neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002602 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002602">
