    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004733 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004733">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of  viiith nerve , usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
