        <obo:IAO_0000115>This is an AE which is an acquired autoimmune disorder resulting in the production of antibodies directed against red blood cell antigens causing shortened erythrocyte survival.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28189175/</obo:IAO_0000119>
        <obo:OAE_0001849>冷型溶血性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10009868</obo:OAE_0004334>
        <rdfs:label>cold type hemolytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006428 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is infections present in the blood caused by bacillus.</obo:IAO_0000115>
