    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004615 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is an accumulation of blood in the retroperitoneal space.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
