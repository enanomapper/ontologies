        <obo:OAE_0001849>鼻涕变色</obo:OAE_0001849>
        <obo:OAE_0004334>10071553</obo:OAE_0004334>
        <rdfs:label>nasal discharge discoloration AE</rdfs:label>
    </owl:Class>
    


