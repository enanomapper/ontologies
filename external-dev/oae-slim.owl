    <!-- http://purl.obolibrary.org/obo/OAE_0009351 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which analysis by HPLC gave a positive predictive value of 81% for Cushing&apos;s syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17022883/</obo:IAO_0000119>
        <obo:OAE_0001849>无皮质醇尿液</obo:OAE_0001849>
        <obo:OAE_0004334>10011199</obo:OAE_0004334>
        <rdfs:label>cortisol free urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009352 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004481"/>
        <obo:IAO_0000115>This is an AE which is bacteriuria without accompanying symptoms of a urinary tract infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bacteriuria</obo:IAO_0000119>
        <obo:OAE_0001849>无症状菌尿</obo:OAE_0001849>
        <obo:OAE_0004334>10056396</obo:OAE_0004334>
        <rdfs:label>asymptomatic bacteriuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009353 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is a chemical intermediate in the synthesis of artificial vanilla flavorings and is an end-stage metabolite  of the catecholamines (dopamine, epinephrine, and norepinephrine) and it appears on the  urine .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vanillylmandelic_acid</obo:IAO_0000119>
        <obo:OAE_0001849>香草扁桃酸尿</obo:OAE_0001849>
        <obo:OAE_0004334>10050833</obo:OAE_0004334>
        <rdfs:label>vanillyl mandelic acid urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009354 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002661"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the oxygen transport protein hemoglobin is found in abnormally high concentrations in the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemoglobinuria</obo:IAO_0000119>
        <obo:OAE_0001849>血红素尿</obo:OAE_0001849>
        <obo:OAE_0004334>10018906</obo:OAE_0004334>
        <rdfs:label>hemoglobinuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009355 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000619"/>
        <obo:IAO_0000115>This is an AE which is defined as the presence of blood or red blood cells in the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematuria</obo:IAO_0000119>
        <obo:OAE_0001849>血尿症</obo:OAE_0001849>
        <obo:OAE_0004334>10018867</obo:OAE_0004334>
        <rdfs:label>haematuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009356 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000604"/>
        <obo:IAO_0000115>This is an AE which is a form of urinary incontinence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stress_incontinence</obo:IAO_0000119>
        <obo:OAE_0001849>压力性尿失禁</obo:OAE_0001849>
        <obo:OAE_0004334>10066218</obo:OAE_0004334>
        <rdfs:label>stress urinary incontinence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009357 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>This is an AE which is associated urinary tract infections (UTIs).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32430571/</obo:IAO_0000119>
        <obo:OAE_0001849>亚硝酸盐尿</obo:OAE_0001849>
        <obo:OAE_0004334>10059220</obo:OAE_0004334>
        <rdfs:label>nitrite urine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009358 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>This is an AE which consists 10% of the total renal biopsy of glomerulonephritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18723953/</obo:IAO_0000119>
        <obo:OAE_0001849>膜增生性肾小球肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066453</obo:OAE_0004334>
        <rdfs:label>mesangioproliferative glomerulonephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009359 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which occurs with unilateral renal agenesis (URA) in 1/2000 live births - or after uninephrectomy for tumor, trauma, uncontrolled infections or hypertension and post-kidney donation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29374876/</obo:IAO_0000119>
        <obo:OAE_0001849>单功能肾</obo:OAE_0001849>
        <obo:OAE_0004334>10063530</obo:OAE_0004334>
        <rdfs:label>single functional kidney AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009360 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004443"/>
        <obo:IAO_0000115>This is an AE which is a major complication of kidney transplantation. Many centers respond to PVAN by reducing immunosuppression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16734632/</obo:IAO_0000119>
        <obo:OAE_0001849>多瘤病毒相关性肾病</obo:OAE_0001849>
        <obo:OAE_0004334>10065381</obo:OAE_0004334>
        <rdfs:label>polyomavirus-associated nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009361 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004443"/>
        <obo:IAO_0000115>This is an AE which is kidney damage (nephropathy) due to urine flowing backward (reflux) from the bladder toward the kidneys; the latter is called vesicoureteral reflux (VUR).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reflux_nephropathy</obo:IAO_0000119>
        <obo:OAE_0001849>反流性肾病</obo:OAE_0001849>
        <obo:OAE_0004334>10065427</obo:OAE_0004334>
        <rdfs:label>reflux nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009362 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is a secondary condition in which the adrenal glands do not produce adequate amounts of steroid hormones, primarily cortisol; but may also include impaired production of aldosterone (a mineralocorticoid), which regulates sodium conservation, potassium secretion, and water retention.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adrenal_insufficiency</obo:IAO_0000119>
        <obo:OAE_0001849>继发性肾上腺皮质功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10039807</obo:OAE_0004334>
        <rdfs:label>secondary adrenocortical insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009363 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the small blood vessels of the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_proliferative_glomerulonephritis</obo:IAO_0000119>
        <obo:OAE_0001849>链球菌后肾小球肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10036303</obo:OAE_0004334>
        <rdfs:label>post streptococcal glomerulonephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009364 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004443"/>
        <obo:IAO_0000115>This is an AE which is a group of clinically similar illnesses caused by the Puumala virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hantavirus_hemorrhagic_fever_with_renal_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>流行性肾病</obo:OAE_0001849>
        <obo:OAE_0004334>10062522</obo:OAE_0004334>
        <rdfs:label>epidemic nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009365 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the  kidney tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>肾脏水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10073381</obo:OAE_0004334>
        <rdfs:label>edematous kidney AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009366 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001861"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the kidneys are functioning at less than 15% of normal levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_failure</obo:IAO_0000119>
        <obo:OAE_0001849>终末期肾病</obo:OAE_0001849>
        <obo:OAE_0004334>10077512</obo:OAE_0004334>
        <rdfs:label>end stage renal disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0009367 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0009367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002799"/>
        <obo:IAO_0000115>This is an AE which is hallmarks of the uremic phenotype and contribute to impaired health status, reduced quality of life, and premature mortality in chronic kidney disease (CKD).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32260373/</obo:IAO_0000119>
        <obo:OAE_0001849>过早衰老</obo:OAE_0001849>
        <obo:OAE_0004334>10063493</obo:OAE_0004334>
        <rdfs:label>premature ageing AE</rdfs:label>
    </owl:Class>
    


