    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006961 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a type of lymphoma, in which cancer originates from a specific type of white blood cells called lymphocytes, where multinucleated Reed–Sternberg cells (RS cells) are present in the patient&apos;s lymph nodes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hodgkin_lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>霍奇金氏病</obo:OAE_0001849>
        <obo:OAE_0004334>10020206</obo:OAE_0004334>
        <rdfs:label>hodgkin&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006962 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is the presence of an increased number of granulocytes in the peripheral blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granulocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>粒细胞增多</obo:OAE_0001849>
        <obo:OAE_0004334>10018690</obo:OAE_0004334>
        <rdfs:label>granulocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006963 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>This is an AE which is the presence of excessive amounts of myeloma protein or monoclonal gamma globulin in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Monoclonal_gammopathy</obo:IAO_0000119>
        <obo:OAE_0001849>单克隆丙种球蛋白病</obo:OAE_0001849>
        <obo:OAE_0004334>10060880</obo:OAE_0004334>
        <rdfs:label>monoclonal gammopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006964 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a multisystem disease of presumed autoimmune cause that affects pigmented tissues, which have melanin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vogt%E2%80%93Koyanagi%E2%80%93Harada_disease</obo:IAO_0000119>
        <obo:OAE_0001849>vogt-小柳-原田病</obo:OAE_0001849>
        <obo:OAE_0004334>10082001</obo:OAE_0004334>
        <rdfs:label>vogt-koyanagi-harada disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006965 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>This is an AE which is an extremely rare disease characterized by the abnormal multiplication of a specific type of white blood cells called histiocytes, or tissue macrophages (technically, this disease is termed a non-Langerhans-cell histiocytosis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erdheim%E2%80%93Chester_disease</obo:IAO_0000119>
        <obo:OAE_0001849>埃尔德海姆-切斯特病</obo:OAE_0001849>
        <obo:OAE_0004334>10060801</obo:OAE_0004334>
        <rdfs:label>erdheim-chester disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006966 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>This is an AE which is antibodies, typically immunoglobulin M (IgM), that are acquainted with and then binding the antigens on red blood cells, typically antigens &quot;I&quot; or &quot;i&quot; on the RBC surface.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
