    <!-- http://purl.obolibrary.org/obo/OAE_0004613 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which refers to accumulation of fluid in an  retroperitoneal  space, usually without loculation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Effusion</obo:IAO_0000119>
