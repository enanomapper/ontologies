    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008103 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001190"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in gingival membrane that impedes normal function of the affected organ.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10049398</obo:OAE_0004334>
        <rdfs:label>gingival ulceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008104 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000986"/>
        <obo:IAO_0000115>This is an AE which is a type of cysts of the jaws that originates from the dental lamina and is found in the mouth parts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingival_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10055018</obo:OAE_0004334>
        <rdfs:label>gingival cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008105 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the gingival  skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈泡</obo:OAE_0001849>
        <obo:OAE_0004334>10049304</obo:OAE_0004334>
        <rdfs:label>gingival blister AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008106 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is a gingival sensation that causes the desire or reflex to scratch.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10049306</obo:OAE_0004334>
        <rdfs:label>gingival pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008107 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the gingival tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10049305</obo:OAE_0004334>
        <rdfs:label>gingival edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008108 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is the exposure in the roots of the teeth caused by a loss of gum tissue and/or retraction of the gingival margin from the crown of the teeth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingival_recession</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10018290</obo:OAE_0004334>
        <rdfs:label>gingival recession AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008109 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a non-destructive disease that causes inflammation of the gums.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingivitis</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈炎</obo:OAE_0001849>
        <obo:OAE_0004334>10018292</obo:OAE_0004334>
        <rdfs:label>gingivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000207"/>
        <obo:IAO_0000115>This is an AE which is a typical adverse reaction of certain drugs (phenytoin, calcium antagonists and cyclosporine).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20131672/</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈增生</obo:OAE_0001849>
        <obo:OAE_0004334>10018283</obo:OAE_0004334>
        <rdfs:label>gingival hyperplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008111 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a viral disease that causes inflammation of the brain in humans and other mammals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rabies</obo:IAO_0000119>
        <obo:OAE_0001849>嘴部发泡</obo:OAE_0001849>
        <obo:OAE_0004334>10062654</obo:OAE_0004334>
