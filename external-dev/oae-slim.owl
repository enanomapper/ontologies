    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005413 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000237"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing of arteries other than those that supply the heart or brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peripheral_artery_disease</obo:IAO_0000119>
