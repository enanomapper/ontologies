        <obo:OAE_0004334>10009269</obo:OAE_0004334>
        <rdfs:label>cleft palate AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008061 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is a medical term which refers to various types of paralysis, often accompanied by weakness and the loss of feeling and uncontrolled body movements such as palatal palsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palsy</obo:IAO_0000119>
        <obo:OAE_0001849>腭麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10072012</obo:OAE_0004334>
        <rdfs:label>palatal palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008062 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the palatal tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>腭水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10056998</obo:OAE_0004334>
        <rdfs:label>palatal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008063 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which the most frequent known interstitial deletion identified in man, is associated with chromosomal microdeletions in the q11 band of chromosome 22.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15877762/</obo:IAO_0000119>
        <obo:OAE_0001849>腭心面综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10066430</obo:OAE_0004334>
        <rdfs:label>velo-cardio-facial syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008064 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000638"/>
        <obo:IAO_0000115>This is an AE which is a malfunction of a velopharyngeal mechanism which is responsible for directing the transmission of sound energy and air pressure in both the oral cavity and the nasal cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Velopharyngeal_inadequacy</obo:IAO_0000119>
        <obo:OAE_0001849>腭咽功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10066790</obo:OAE_0004334>
        <rdfs:label>velopharyngeal incompetence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008065 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of palatal part or area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>腭肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10074403</obo:OAE_0004334>
        <rdfs:label>palatal swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008066 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001296"/>
        <obo:IAO_0000115>This is an AE which is a colored material that is completely or nearly insoluble in water adhere the lip.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pigment</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10035025</obo:OAE_0004334>
        <rdfs:label>pigmentation lip AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008067 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a pseudo-pathological name of what is either considered a normal adaptive lip seal mechanism, whereby normal nasal breathing or normal swallowing can occur.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tongue_thrust</obo:IAO_0000119>
        <obo:OAE_0001849>舌刺</obo:OAE_0001849>
        <obo:OAE_0004334>10082545</obo:OAE_0004334>
        <rdfs:label>tongue thrust AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008068 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a medical condition and abnormality which involves the downward displacement or retraction of the tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glossoptosis</obo:IAO_0000119>
        <obo:OAE_0001849>舌下垂</obo:OAE_0001849>
        <obo:OAE_0004334>10059138</obo:OAE_0004334>
        <rdfs:label>glossoptosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008069 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a loss of motor function in one or more tongue muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>舌麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10043972</obo:OAE_0004334>
        <rdfs:label>tongue paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008070 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a closed sac on the tongue, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>舌囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051879</obo:OAE_0004334>
        <rdfs:label>tongue cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008071 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is the increase in the volume of of tongue papillae tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>舌乳头肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10020893</obo:OAE_0004334>
        <rdfs:label>hypertrophy of tongue papillae AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008072 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part  of tongue papillae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>舌乳头萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10003712</obo:OAE_0004334>
        <rdfs:label>atrophy of tongue papillae AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008073 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000472"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the tongue tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>舌水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10043967</obo:OAE_0004334>
        <rdfs:label>tongue edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008074 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which refers a grayish-white deposit on the tongue, is the main cause of intra-oral halitosis (IOH), a socially unacceptable condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29269592/</obo:IAO_0000119>
        <obo:OAE_0001849>舌苔</obo:OAE_0001849>
        <obo:OAE_0004334>10043945</obo:OAE_0004334>
        <rdfs:label>tongue coated AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008075 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged tongue blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>舌头出血</obo:OAE_0001849>
        <obo:OAE_0004334>10049870</obo:OAE_0004334>
        <rdfs:label>tongue hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008076 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a condition of the mucous membrane of the tongue, usually on the dorsal surface.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Geographic_tongue</obo:IAO_0000119>
        <obo:OAE_0001849>地图舌</obo:OAE_0001849>
        <obo:OAE_0004334>10043957</obo:OAE_0004334>
        <rdfs:label>tongue geographic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008077 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000505"/>
        <obo:IAO_0000115>This is an AE which is a muscular organ in the mouth of a typical vertebrate and is feel dry.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tongue</obo:IAO_0000119>
        <obo:OAE_0001849>舌头干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10049713</obo:OAE_0004334>
        <rdfs:label>tongue dry AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008078 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the tongue skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>舌头红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10079075</obo:OAE_0004334>
        <rdfs:label>tongue erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008079 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is a sudden involuntary contraction of a muscle, a group of muscles, or a hollow organ such as the tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0001849>舌头痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10043981</obo:OAE_0004334>
        <rdfs:label>tongue spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008080 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the tongue skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>舌头起泡</obo:OAE_0001849>
        <obo:OAE_0004334>10043942</obo:OAE_0004334>
        <rdfs:label>tongue blistering AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008081 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which refers a cosmetic technique that aims to remove dead skin from the tongue .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exfoliation</obo:IAO_0000119>
        <obo:OAE_0001849>舌头去角质</obo:OAE_0001849>
        <obo:OAE_0004334>10064488</obo:OAE_0004334>
        <rdfs:label>tongue exfoliation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008082 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>舌头瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10070072</obo:OAE_0004334>
        <rdfs:label>tongue pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008083 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001296"/>
        <obo:IAO_0000115>This is an AE which is a colored material that is completely or nearly insoluble in water adhere the tongue .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pigment</obo:IAO_0000119>
        <obo:OAE_0001849>舌头色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10069164</obo:OAE_0004334>
        <rdfs:label>tongue pigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008084 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>舌头萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10055028</obo:OAE_0004334>
        <rdfs:label>tongue atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008085 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is regularly investigated for the death caused by strangulation or hanging, whilst seems to be overlooked in case of charred remains as the significance of this sign is still discussed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31187740/</obo:IAO_0000119>
        <obo:OAE_0001849>舌突出</obo:OAE_0001849>
        <obo:OAE_0004334>10037076</obo:OAE_0004334>
        <rdfs:label>protrusion tongue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008086 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged tooth socket blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>牙槽出血</obo:OAE_0001849>
        <obo:OAE_0004334>10064946</obo:OAE_0004334>
        <rdfs:label>tooth socket hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008087 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the airspaces (alveoli).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypersensitivity_pneumonitis</obo:IAO_0000119>
        <obo:OAE_0001849>牙槽炎</obo:OAE_0001849>
        <obo:OAE_0004334>10001889</obo:OAE_0004334>
        <rdfs:label>alveolitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008088 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is a hard, calcified structure found in the jaws (or mouths) of many vertebrates and used to break down food and it has deposit.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿沉积</obo:OAE_0001849>
        <obo:OAE_0004334>10044029</obo:OAE_0004334>
        <rdfs:label>tooth deposit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008089 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is underdevelopment or incomplete development of tooth .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoplasia</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10044041</obo:OAE_0004334>
        <rdfs:label>tooth hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008090 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the skin or tooth (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿感觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10078276</obo:OAE_0004334>
        <rdfs:label>dental paraesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008091 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is a physical anomaly that is deleterious on tooth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10044046</obo:OAE_0004334>
        <rdfs:label>tooth malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008092 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is dental pain which is sharp in character and of short duration, arising from exposed dentin surfaces in response to stimuli, typically thermal, evaporative, tactile, osmotic, chemical or electrical; and which cannot be ascribed to any other dental disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dentin_hypersensitivity</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿敏感</obo:OAE_0001849>
        <obo:OAE_0004334>10040012</obo:OAE_0004334>
        <rdfs:label>sensitivity of teeth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008093 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is the complete displacement of a tooth from its socket in alveolar bone owing to trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dental_avulsion</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿撕脱</obo:OAE_0001849>
        <obo:OAE_0004334>10065953</obo:OAE_0004334>
        <rdfs:label>tooth avulsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008094 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is the horizontal or vertical displacement of a tooth beyond its normal physiological boundaries around the gingival area, i.e. the medical term for a loose tooth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth_mobility</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿松动</obo:OAE_0001849>
        <obo:OAE_0004334>10065612</obo:OAE_0004334>
        <rdfs:label>loose tooth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008095 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is one that fails to erupt into the dental arch within the expected developmental window.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth_impaction</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿阻生</obo:OAE_0001849>
        <obo:OAE_0004334>10044042</obo:OAE_0004334>
        <rdfs:label>tooth impacted AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008096 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is a type of tissue death caused by a lack of blood supply occured on dental.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gangrene</obo:IAO_0000119>
        <obo:OAE_0001849>牙科坏疽</obo:OAE_0001849>
        <obo:OAE_0004334>10063066</obo:OAE_0004334>
        <rdfs:label>dental gangrene AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008097 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is inflammation of dental pulp tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pulpitis</obo:IAO_0000119>
        <obo:OAE_0001849>牙髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037464</obo:OAE_0004334>
        <rdfs:label>pulpitis dental AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008098 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003434"/>
        <obo:IAO_0000115>This is an AE which is the process of lightening the color of human teeth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tooth_whitening</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈变色</obo:OAE_0001849>
        <obo:OAE_0004334>10018278</obo:OAE_0004334>
        <rdfs:label>gingival discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008099 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which consist of the mucosal tissue that lies over the mandible and maxilla inside the mouth and feel it discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gums</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈不适</obo:OAE_0001849>
        <obo:OAE_0004334>10077854</obo:OAE_0004334>
        <rdfs:label>gingival discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008100 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a non-destructive disease that causes inflammation of the gums.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingivitis</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈发炎</obo:OAE_0001849>
        <obo:OAE_0004334>10072575</obo:OAE_0004334>
        <rdfs:label>gingival inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008101 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is an increase in the size of the gingiva (gums).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingival_enlargement</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10018284</obo:OAE_0004334>
        <rdfs:label>gingival hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008102 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is the term given to any disorder primarily affecting the gingiva.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingival_disease</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10018280</obo:OAE_0004334>
