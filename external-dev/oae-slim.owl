        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 allergy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11251</rdfs:seeAlso>
    </owl:Class>
    


