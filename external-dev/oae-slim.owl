        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001012"/>
        <obo:IAO_0000115>a hemolytic uremic syndrome AE that has evidence of RBC destruction (schistocytosis) without clinical consequences</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 hemolytic uremic syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10044</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003660 -->


