    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005607 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004456"/>
        <obo:IAO_0000115>This is an AE which is an unfavorable result of a disease, health condition, or treatment on the urinary tract stoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complication_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>泌尿道造口并发症</obo:OAE_0001849>
