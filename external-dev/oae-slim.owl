    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006952 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which can recurre  after marsupialization via microlaryngeal approach and finally it was resected successfully through a lateral cervical approach with concomitant tracheotomy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17129695/</obo:IAO_0000119>
        <obo:OAE_0001849>扁桃体囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10057451</obo:OAE_0004334>
        <rdfs:label>tonsillar cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006953 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the tonsillar skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>扁桃体红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10078256</obo:OAE_0004334>
        <rdfs:label>tonsillar erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006954 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a fluid emitted by an organism through tonsillar pores or a wound.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exudate</obo:IAO_0000119>
        <obo:OAE_0001849>扁桃体渗出液</obo:OAE_0001849>
        <obo:OAE_0004334>10078257</obo:OAE_0004334>
