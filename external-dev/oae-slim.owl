        <obo:OAE_0004334>10013542</obo:OAE_0004334>
        <rdfs:label>diverticulitis meckel&apos;s AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005882 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001644"/>
        <obo:IAO_0000115>This is an AE which is a person whose body weight is considered too low to be healthy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Underweight</obo:IAO_0000119>
        <obo:OAE_0001849>体重过轻</obo:OAE_0001849>
        <obo:OAE_0004334>10048828</obo:OAE_0004334>
