        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 forced expiratory volume decreased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12157</rdfs:seeAlso>
    </owl:Class>
    


