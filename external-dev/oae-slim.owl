    <!-- http://purl.obolibrary.org/obo/OAE_0001641 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001571"/>
        <obo:IAO_0000115>a second degree atrioventricular block AE that some of the electrical signals don&apos;t reach the ventricles. However, the pattern is less regular than it is in Mobitz type I. Some signals move between the atria and ventricles normally, while others are blocked.

On an EKG, the QRS wave follows the P wave at a normal speed. Sometimes, though, the QRS wave is missing (when a signal is blocked).</obo:IAO_0000115>
        <obo:IAO_0000117>SS, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>Mobitz (type) II atrioventricular block AE</obo:IAO_0000118>
        <obo:IAO_0000118>Mobitz type 2 block</obo:IAO_0000118>
        <obo:IAO_0000118>type 2 second degree atrioventricular block</obo:IAO_0000118>
        <obo:IAO_0000118>type II second degree atrioventricular block</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health//dci/Diseases/hb/hb_types.html</obo:IAO_0000119>
        <obo:OAE_0004334>10027786</obo:OAE_0004334>
        <obo:OAE_0004334>10050798</obo:OAE_0004334>
        <rdfs:label>Mobitz type II block AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10140</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C62018</rdfs:seeAlso>
    </owl:Class>
    


