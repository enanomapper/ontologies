    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000443 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <obo:IAO_0000115>an AE that occurs in eye.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000118>eye disorder AE</obo:IAO_0000118>
        <obo:OAE_0004334>10015916</obo:OAE_0004334>
