        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a long-term autoimmune disorder, primarily affecting the small intestine, where individuals develop intolerance to gluten, present in foods such as wheat, rye and barley.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
