    <!-- http://purl.obolibrary.org/obo/OAE_0005597 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000825"/>
        <obo:IAO_0000115>This is an AE which associated with ulcerative colitis (GDUC) is rare.</obo:IAO_0000115>
