        <obo:IAO_0000115>an allergy AE that has transient flushing or rash, drug fever &lt;38 degrees C (&lt;100.4 degrees F); intervention not indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 allergy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11249</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003560 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>an allergy AE where intervention or infusion interruption indicated; responds promptly to symptomatic treatment (e.g., antihistamines, NSAIDS, narcotics); prophylactic medications indicated for less than or equal to 24 hrs</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 allergy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11250</rdfs:seeAlso>
    </owl:Class>
    


