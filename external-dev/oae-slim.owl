        <obo:IAO_0000115>an ejaculation disorder AE that has anejaculation or retrograde ejaculation</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <rdfs:label>Grade 2 ejaculation disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13087</rdfs:seeAlso>
    </owl:Class>
    


