    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008652 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001164"/>
        <obo:IAO_0000115>This is an AE which is rare indolent tumours of the anterior superior mediastinum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10772969/</obo:IAO_0000119>
        <obo:OAE_0001849>胸腺瘤恶性</obo:OAE_0001849>
        <obo:OAE_0004334>10061031</obo:OAE_0004334>
