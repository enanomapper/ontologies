    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000917"/>
        <obo:IAO_0000115>an enterocolitis AE that has abdominal pain; mucus or blood in stool</obo:IAO_0000115>
