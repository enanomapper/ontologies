    <!-- http://purl.obolibrary.org/obo/OAE_0002356 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002354"/>
        <obo:IAO_0000115>a cardiovascualr AE that results in the build up of fat and blood clots in the large blood vessels, stick to the vessel walls, and block the flow of blood</obo:IAO_0000115>
