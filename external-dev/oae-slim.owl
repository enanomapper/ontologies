        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a condition characterized by large amounts of dilute urine and increased thirst.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetes_insipidus</obo:IAO_0000119>
