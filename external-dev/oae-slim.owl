    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005195 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001029"/>
        <obo:IAO_0000115>This is an AE which is a condition of unrecognized origin which can become extremely serious and whose diagnosis is often made during perinatal autopsy and is often characterised by nonspecific clinical manifestations and a long delay before biological presentation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
