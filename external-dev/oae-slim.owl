    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is a condition where the thymus is underdeveloped or involuted.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thymic_hypoplasia</obo:IAO_0000119>
        <obo:OAE_0001849>胸腺发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10052645</obo:OAE_0004334>
        <rdfs:label>thymus hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008657 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which increased respiration elevates the blood pH beyond the normal range (7.35–7.45) with a concurrent reduction in arterial levels of carbon dioxide.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_alkalosis</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸性碱中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10038664</obo:OAE_0004334>
        <rdfs:label>respiratory alkalosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008658 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008658">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115>This is an AE which is caused by apnea (cessation of breathing) or respiratory dysfunction severe enough it will not sustain the body (such as agonal breathing).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸骤停</obo:OAE_0001849>
        <obo:OAE_0004334>10038669</obo:OAE_0004334>
        <rdfs:label>respiratory arrest AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008659 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115>This is an AE which occurs when ventilation is inadequate to perform needed respiratory gas exchange.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoventilation</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸抑制</obo:OAE_0001849>
        <obo:OAE_0004334>10038678</obo:OAE_0004334>
        <rdfs:label>respiratory depression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008660 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is pathological conditions affecting the organs and tissues that make gas exchange difficult in neonatal .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_disease</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸系统疾病新生儿</obo:OAE_0001849>
        <obo:OAE_0004334>10061484</obo:OAE_0004334>
        <rdfs:label>respiratory disorder neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008661 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115>This is an AE which results from inadequate gas exchange by the respiratory system, meaning that the arterial oxygen, carbon dioxide, or both cannot be kept at normal levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_failure</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10038695</obo:OAE_0004334>
        <rdfs:label>respiratory failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008662 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which refers the two reasons is neuromuscular disorders and respiratory muscle fatigue may lead to respiratory muscle weakness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_arrest</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸肌无力</obo:OAE_0001849>
        <obo:OAE_0004334>10070833</obo:OAE_0004334>
        <rdfs:label>respiratory muscle weakness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008663 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a benign epithelial tumor on the respiratory growing exophytically (outwardly projecting) in nipple-like and often finger-like fronds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papilloma</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸道乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10038707</obo:OAE_0004334>
        <rdfs:label>respiratory papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008664 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <obo:IAO_0000115>This is an AE which results from inadequate gas exchange by the respiratory system, meaning that the arterial oxygen, carbon dioxide, or both cannot be kept at normal levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Respiratory_failure</obo:IAO_0000119>
        <obo:OAE_0001849>呼吸麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10038708</obo:OAE_0004334>
