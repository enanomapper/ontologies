    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002629"/>
        <obo:IAO_0000115>a brain inflammation AE which results in an inflammation of the protective membranes covering the brain and spinal cord, known collectively as the meninges. The inflammation is caused by infection with viruses, bacteria, or other microorganisms, and less commonly by certain drugs or diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.cdc.gov/meningitis/index.html</obo:IAO_0000119>
        <obo:OAE_0001849>脑膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10027199</obo:OAE_0004334>
        <rdfs:label>meningitis AE</rdfs:label>
