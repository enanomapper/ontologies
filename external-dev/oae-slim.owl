    <!-- http://purl.obolibrary.org/obo/OAE_0008953 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which refers to the making of naturally occurring ridges on certain body parts, namely palms, fingers, soles, and toes and it is anomal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
