    <!-- http://purl.obolibrary.org/obo/OAE_0004366 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <obo:IAO_0000115>An epileptic seizure AE that is a complex autosomal dominant disorder usually caused by mutations in SCN1A (a voltage-gated sodium channel). One third of patients have febrile seizures only; two thirds have a variety of epilepsy syndromes, both focal and generalized.</obo:IAO_0000115>
        <obo:IAO_0000118>GEFS+ AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/25917466</obo:IAO_0000119>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">genetic epilepsy with febrile seizures plus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004367 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">MW, EO</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">a nausea AE that has Loss of appetite without alteration in eating habits</rdfs:comment>
        <rdfs:label xml:lang="en">Grade 1 nausea AE</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">CTCAE: E10879</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004368 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">MW, EO</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">a nausea AE that has oral intake decreased without significant weight loss, dehydration or malnutrition</rdfs:comment>
        <rdfs:label xml:lang="en">Grade 2 nausea AE</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">CTCAE: E10880</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004369 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">MW, EO</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">a nausea AE that has inadequate oral caloric or fluid intake; tube feeding, TPN, or hospitalization indicated</rdfs:comment>
        <rdfs:label xml:lang="en">Grade 3 nausea AE</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">CTCAE: E10881</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004370 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>A bacterial infection AE that is induced by the bacterium Bordetella pertussis, which causes an acute respiratory infection marked by severe, spasmodic coughing episodes during the paroxysmal phase.</obo:IAO_0000115>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK7813/</obo:IAO_0000119>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">Bordetella pertussis infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004371 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115 xml:lang="en">A thyroiditis AE that is caused by an infection with a pathogen (e.g., bacterium or virus).</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thyroiditis</obo:IAO_0000119>
        <obo:OAE_0004334>10071250</obo:OAE_0004334>
        <rdfs:label xml:lang="en">infectious thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004373 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001215"/>
        <obo:IAO_0000115>A neurotoxicity that occurs at the central nervous system. This type of neurotoxity  manifests as altered thought content resulting in psychosis or confusion.</obo:IAO_0000115>
        <obo:IAO_0000117>BY, YH</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/24275175</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10071215</obo:OAE_0004334>
        <rdfs:label xml:lang="en">central nervous system toxicity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004374 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>A paralysis AE that results from infection with any one of the three related poliovirus types (referred to as types P1, P2, and P3) and that attacks the body&apos;s nervous system.</obo:IAO_0000115>
        <obo:IAO_0000118>infantile paralysis AE</obo:IAO_0000118>
        <obo:IAO_0000118>polio AE</obo:IAO_0000118>
        <obo:IAO_0000119>http://www.who.int/biologicals/areas/vaccines/polio/en/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10036012</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">poliomyelitis  AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004375 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>An immune system AE where a transplant recipient&apos;s immune system attacks the transplanted organ or tissue.</obo:IAO_0000115>
        <obo:IAO_0000118>transplant rejection AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://medlineplus.gov/ency/article/000815.htm</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018650</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">graft rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004376 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>A vasculitis AE that affects medium-sized and small muscular arteries, resulting in microaneurysm formation, aneurysmal rupture with hemorrhage, thrombosis, and, consequently, organ ischemia or infarction.</obo:IAO_0000115>
        <obo:IAO_0000118>panarteritis nodosa AE</obo:IAO_0000118>
        <obo:IAO_0000118>polyarteritis nodosa AE</obo:IAO_0000118>
        <obo:IAO_0000119>http://emedicine.medscape.com/article/330717-overview</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10034462</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">periarteritis nodosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004377 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003235"/>
        <obo:IAO_0000115>An abnormal reflex AE characterized by episodes of shaking or exaggerated shivering which can occur with a high fever.</obo:IAO_0000115>
        <obo:IAO_0000119>http://patient.info/doctor/rigors</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10039177</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">rigors AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004378 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001602"/>
        <obo:IAO_0000115>An immunology AE in which cells of the lymphatic system grow excessively. It is a AE of the  lymphoid cells and of cells from the reticuloendothelial system that usually occur in people with compromised immune systems.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.medicinenet.com/script/main/art.asp?articlekey=7859</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10061232</obo:OAE_0004334>
        <dc:creator>BY. YH</dc:creator>
        <rdfs:label xml:lang="en">lymphoproliferative disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004379 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>A rash AE where the rash is present on only one area of the body, which is usually caused by cellulitis, contat dermatitis, and poison ivy.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.everydayhealth.com/symptom-checker/localized-rash</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10062705</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">localized rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004380 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>A neuropathy AE that is characterized by recurrent episodes of numbness, tingling, and loss of muscle function in the region associated with the affected nerve, usually an arm, hand, leg, or foot.</obo:IAO_0000115>
        <obo:IAO_0000118>HNPP AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://ghr.nlm.nih.gov/condition/hereditary-neuropathy-with-liability-to-pressure-palsies</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10069382</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">hereditary neuropathy with liability to pressure palsies AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004381 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>A viral infection AE that is caused by a Rubella virus. This contagious AE leads to symptoms that can include a low-grade fever, sore throat, and a red rash that starts on the face and spreads to the rest of the body.</obo:IAO_0000115>
        <obo:IAO_0000118>german measles AE</obo:IAO_0000118>
        <obo:IAO_0000118>three-day measles AE</obo:IAO_0000118>
        <obo:IAO_0000119>http://bodyandhealth.canada.com/channel/childhood-vaccinations/related-conditions/rubella</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018206</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">Rubella infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004382 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004374"/>
        <obo:IAO_0000115>A poliomyelitis AE that is associated with oral poliovirus vaccine (OPV) that occurs among healthy OPV recipients and their contacts. It is clinically indistinguishable from poliomyelitis caused by wild-type polio virus, which causes temporary or permanent paralysis.</obo:IAO_0000115>
        <obo:IAO_0000118>VAPP AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3321898/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10076716</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">vaccine-associated paralytic poliomyelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004383 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>A seizure AE that is a rare, catastrophic, lifelong form of epilepsy that begins in the first year of life with frequent and/or prolonged seizures.</obo:IAO_0000115>
        <obo:IAO_0000118>SMEI AE</obo:IAO_0000118>
        <obo:IAO_0000118>dravet syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.dravetfoundation.org/what-is-dravet-syndrome/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10073677</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">severe myoclonic epilepsy of infancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004384 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>A bacterial infection AE that is caused by exposure to environmental sources of nontuberculous mycobacteria (NTM), which leads to NTM entering the lungs, causing inflammation in the respiratory system. This AE can lead to progressive lung infection characterized by cough, shortness of breath, fatigue, and weight loss.</obo:IAO_0000115>
        <obo:IAO_0000118>NTM infection AE</obo:IAO_0000118>
        <obo:IAO_0000119>http://www.lung.org/lung-health-and-diseases/lung-disease-lookup/nontuberculosis-mycobacteria/learn-about-ntm.html</obo:IAO_0000119>
        <dc:creator>BY. YH</dc:creator>
        <rdfs:label xml:lang="en">nontuberculous mycobacteria infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004385 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002591"/>
        <obo:IAO_0000115>An immunodeficiency AE that affects the immune system and results in the lack of the ability for the body to generate mature B cells, which manifests as a complete or near-complete lack of proteins called gamma globulins, including antibodies, in their bloodstream. This AE occurs almost exclusively in males. This AE also increases susceptibility to infections.</obo:IAO_0000115>
        <obo:IAO_0000118>Bruton’s Agammaglobulinemia AE</obo:IAO_0000118>
        <obo:IAO_0000118>Congenital Agammaglobulinemia AE</obo:IAO_0000118>
        <obo:IAO_0000118>XLA AE</obo:IAO_0000118>
        <obo:IAO_0000119>http://primaryimmune.org/about-primary-immunodeficiencies/specific-disease-types/agammaglobulinemia-x-linked-autosomal-recessive/</obo:IAO_0000119>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/X-linked_agammaglobulinemia</obo:IAO_0000119>
        <obo:IAO_0000119>https://ghr.nlm.nih.gov/condition/x-linked-agammaglobulinemia</obo:IAO_0000119>
        <dc:creator>BY. YH</dc:creator>
        <rdfs:label xml:lang="en">X-linked agammaglobulinemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004386 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001527"/>
        <obo:IAO_0000115>A multi-organ failure AE that is associated with administration of a Yellow Fever vaccine. This happens when vaccine virus proliferates in multiple organs, causing multiple organ dysfunction syndrome or multiorgan failure and death.</obo:IAO_0000115>
        <obo:IAO_0000119>https://www.cdc.gov/travel-training/local/HistoryEpidemiologyandVaccination/page27412.html</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10069197</obo:OAE_0004334>
        <dc:creator>BY, YH</dc:creator>
        <rdfs:label xml:lang="en">Yellow Fever vaccine-associated viscerotropic disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004387 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000895"/>
        <obo:IAO_0000115>A duodenal ulcer AE that alters GI function and requiresTPN indicated; elective operative or endoscopic intervention indicated; limiting self care ADL.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 duodenal ulcer AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10614</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004388 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>An anus AE that bleed from the anal region.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10055226</obo:OAE_0004334>
        <rdfs:label xml:lang="en">anal hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10470</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78168</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004389 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004388"/>
        <obo:IAO_0000115>An anal hemorrhage AE that has moderate symptoms; medical intervention or minor cauterization indicated.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 anal hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10472</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004390 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115 xml:lang="en">A thyroiditis AE where the thyroiditis inflammation has an acute process.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thyroiditis</obo:IAO_0000119>
        <obo:OAE_0004334>10043780</obo:OAE_0004334>
        <rdfs:label xml:lang="en">acute thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004391 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004388"/>
        <obo:IAO_0000115>An anal hemorrhage AE that has transfusion, radiologic, endoscopic, or elective operative intervention indicated.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 anal hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10473</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004392 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>A gastrointestinal disorder AE that has a narrowing of the lumen of the colon.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10010004</obo:OAE_0004334>
        <rdfs:label xml:lang="en">colonic stenosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10550</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78243</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004393 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004392"/>
        <obo:IAO_0000115>A colonic stenosis AE that altered GI function.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 colonic stenosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10552</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004394 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004392"/>
        <obo:IAO_0000115>A colonic stenosis AE that alters GI function and requires tube feeding or hospitalization.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 colonic stenosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10553</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004395 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>An esophagus AE that has a rupture in the wall of the esophagus.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10055472</obo:OAE_0004334>
        <rdfs:label xml:lang="en">esophageal perforation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10665</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C50693</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004396 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>A mucosal inflammation AE that has moderate pain which is not interfering with oral intake but modified diet indicated.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 mucosal inflammation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10874</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004397 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001526"/>
        <obo:IAO_0000115>A mucosal inflammation AE that is interfering with oral intake.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 mucosal inflammation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10875</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004398 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002647"/>
        <obo:IAO_0000115>A dysesthesia AE that has burning or tingling sensation on the lips, tongue or entire mouth.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10054520</obo:OAE_0004334>
        <rdfs:label xml:lang="en">oral dysesthesia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10894</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C62545</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004399 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004398"/>
        <obo:IAO_0000115>An oral dysesthesia AE that has disabling pain, requires tube feeding and TPN.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 Oral dysesthesia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10897</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004398"/>
        <obo:IAO_0000115>An oral dysesthesia AE that has m oderate pain and is interfering with oral intake.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 Oral dysesthesia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10896</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004401 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004398"/>
        <obo:IAO_0000115>An oral dysesthesia AE that has mild discomfort but is not interfering with oral intake.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 1 Oral dysesthesia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10895</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004402 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001283"/>
        <obo:IAO_0000115>A periodontal disease AE that has spontaneous bleeding, severe bone loss with or without tooth loss and osteonecrosis of maxilla or mandible.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 periodontal disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10938</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004403 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001283"/>
        <obo:IAO_0000115>A periodontal disease AE that has moderate gingival recession or gingivitis, multiple sites of bleeding on probing and moderate bone loss.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 periodontal disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10937</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004404 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001283"/>
        <obo:IAO_0000115>A periodontal disease AE that has gingival recession or gingivitis, limited bleeding on probing and mild local bone loss.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 1 periodontal disease AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10936</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004405 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>A necrosis AE that there the ecrotic process occurring in the rectal wall.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10065709</obo:OAE_0004334>
        <rdfs:label xml:lang="en">rectal necrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10967</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78585</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004406 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004405"/>
        <obo:IAO_0000115>A rectal necrosis AE that requires tube feeding or TPN indicated; radiologic, endoscopic, or operative intervention indicated.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 rectal necrosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10968</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004407 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>An inflammation AE that has inflammation of the salivary duct.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10056681</obo:OAE_0004334>
        <rdfs:label xml:lang="en">salivary duct inflammation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10470</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78600</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004408 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004407"/>
        <obo:IAO_0000115>A salivary duct inflammation AE that has acute salivary gland necrosis; severe secretion-induced symptoms (e.g., thick saliva/oral secretions or gagging); tube feeding or TPN indicated; limiting self care ADL; disabling</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 salivary duct inflammation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11006</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004409 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004407"/>
        <obo:IAO_0000115>A salivary duct inflammation AE that has thick, ropy, sticky saliva; markedly altered taste; alteration in diet indicated; secretion-induced symptoms; limiting instrumental ADL</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 salivary duct inflammation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11005</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004410 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004407"/>
        <obo:IAO_0000115>A salivary duct inflammation AE that has slightly thickened saliva; slightly altered taste (e.g., metallic)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 1 salivary duct inflammation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11004</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004411 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>An inflammation AE that has  inflammation of the mucous membrane of the small intestine.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10065710</obo:OAE_0004334>
        <rdfs:label xml:lang="en">small intestinal mucositis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11015</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78613</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004412 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004411"/>
        <obo:IAO_0000115>A small intestinal mucositis AE that has severe pain and is interfering with oral intake; tube feeding, TPN or hospitalization indicated.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 small intestinal mucositis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11018</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004413 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001409"/>
        <obo:IAO_0000115>A small intestine ulcer AE that has altered GI function, requires TPN indicated. Elective operative or endoscopic intervention indicated; limiting self care ADL; disablingoperative intervention</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 small intestine ulcer AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11041</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004414 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001409"/>
        <obo:IAO_0000115>A small intestine ulcer AE that has altered GI function.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 small intestine ulcer AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11040</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004415 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>A tooth disorder AE that has a pathological process of the teeth occurring during tooth development.</obo:IAO_0000115>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10044030</obo:OAE_0004334>
        <rdfs:label xml:lang="en">tooth development disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11048</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35596</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004416 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004415"/>
        <obo:IAO_0000115>A tooth development disorder AE that has maldevelopment with impairment not surgically correctable.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 tooth development disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11051</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004417 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004415"/>
        <obo:IAO_0000115>A tooth development disorder AE that has impairment correctable with oral surgery</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 2 tooth development disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11050</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004418 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004415"/>
        <obo:IAO_0000115>A tooth development disorder AE that has hypoplasia of tooth or enamel.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 1 tooth development disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11049</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004419 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000773"/>
        <obo:IAO_0000115>A digestive system AE that has abdominal pain, fever, change in bowel habits with ileus and peritoneal signs.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Grade 3 cecitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11059</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004420 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115 xml:lang="en">A thyroiditis AE where the thyroiditis inflammation has a chronic process.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thyroiditis</obo:IAO_0000119>
        <obo:OAE_0004334>10043781</obo:OAE_0004334>
        <rdfs:label xml:lang="en">chronic thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004421 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004420"/>
        <obo:IAO_0000115 xml:lang="en">A chronic thyroiditis AE that shows a lot of dense fibrous tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000118>Riedel goiter AE</obo:IAO_0000118>
        <obo:IAO_0000118>Riedel&apos;s thyroiditis AE</obo:IAO_0000118>
        <obo:IAO_0000118>chronic sclerosing thyroiditis AE</obo:IAO_0000118>
        <obo:IAO_0000118>chronic thyroiditis wood AE</obo:IAO_0000118>
        <obo:IAO_0000118>fibrous chronic thyroiditis AE</obo:IAO_0000118>
        <obo:IAO_0000118>invasive fibrous thyroiditis AE</obo:IAO_0000118>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.healthfrom.com/Disease/view-3435.html</obo:IAO_0000119>
        <obo:OAE_0004334>10043782</obo:OAE_0004334>
        <rdfs:label xml:lang="en">chronic fibrous thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004424 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004390"/>
        <obo:IAO_0000115 xml:lang="en">An acute thyroiditis AE that shows a form of painful, acute thyroiditis resulting from radioactive therapy to treat hyperthyroidism or from radiation to treat head and neck cancer or lymphoma.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Radiation-induced_thyroiditis</obo:IAO_0000119>
        <obo:OAE_0004334>10063885</obo:OAE_0004334>
        <rdfs:label xml:lang="en">radition thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004425 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004260"/>
        <obo:IAO_0000115 xml:lang="en">An autoimmune thyroiditis AE where the thyroid gland is gradually destroyed.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Hashimoto&apos;s disease AE</obo:IAO_0000118>
        <obo:IAO_0000118>chronic lymphocytic thyroiditis AE</obo:IAO_0000118>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Autoimmune_thyroiditis</obo:IAO_0000119>
        <obo:OAE_0004334>10069432</obo:OAE_0004334>
        <rdfs:label xml:lang="en">Hashimoto&apos;s thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004426 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004260"/>
        <obo:IAO_0000115 xml:lang="en">An autoimmune thyroiditis AE that shows an organ-specific autoimmune disease characterized by thyroid autoantibodies, functional hypothyroidism, and absence of goiter.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://link.springer.com/chapter/10.1007%2F978-1-60327-285-8_42</obo:IAO_0000119>
        <obo:OAE_0004334>10077172</obo:OAE_0004334>
        <rdfs:label xml:lang="en">atrophic thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004427 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115 xml:lang="en">A thyroiditis AE that occurs after pregnancy and may involve hyperthyroidism, hypothyroidism or the two sequentially.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Postpartum_thyroiditis</obo:IAO_0000119>
        <rdfs:label xml:lang="en">postpartum thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004428 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>An adverse event of hematoma in the subcapsular space of the kidney. This event occurs after a medical intervention, and may be caused by a tumor, trauma, vasculitis, renal infarction, or other disease process.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, EO</obo:IAO_0000117>
        <obo:IAO_0000119>https://medical-dictionary.thefreedictionary.com/subcapsular+hematoma</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym>subcapsular hematoma</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">subcapsular hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004429 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>An adverse event of hematoma occurring around the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, EO</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>perinephric hematoma</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">perinephric hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004430 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000212"/>
        <obo:IAO_0000117>YH, EO</obo:IAO_0000117>
        <oboInOwl:hasBroadSynonym>arteriovenous fistulae</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>arteriovenous fistula</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">arteriovenous fistula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004431 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>An adverse event of surgery that leads to the puncturing of an adjacent organ. For example, a needle to the kidney may puncture the adjacent organs.</obo:IAO_0000115>
        <obo:IAO_0000117>Jennifer Schaub, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>puncturing of adjacent organs</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK493205/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">puncturing of adjacent organ AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004432 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001364"/>
        <obo:IAO_0000115>A renal failure AE that is characterized by abnormally high levels of nitrogen-containing compounds (such as urea, creatinine, various body waste compounds, and other nitrogen-rich compounds) in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Azotemia</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10003885</obo:OAE_0004334>
        <rdfs:label xml:lang="en">azotaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004433 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>An adverse event with the IgA nephropathy, a form of glomerulonephritis (an inflammation of the glomeruli of the kidney), primarily characterized by deposition of the IgA antibody in the glomerulus.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000118>Berger&apos;s disease</obo:IAO_0000118>
        <obo:IAO_0000118>IgA nephritis</obo:IAO_0000118>
        <obo:IAO_0000118>IgAN</obo:IAO_0000118>
        <obo:IAO_0000118>synpharyngitic glomerulonephritis</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/IgA_nephropathy</obo:IAO_0000119>
        <rdfs:label xml:lang="en">IgA nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004434 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>An adverse event with the IgM nephropathy, a form of glomerulonephritis (an inflammation of the glomeruli of the kidney), primarily characterized by deposition of the IgM antibody in the glomerulus.</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000119>https://nephcure.org/livingwithkidneydisease/understanding-glomerular-disease/other-glomerular-diseases/igm-nephropathy/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">IgM nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004435 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115 xml:lang="en">A urine abnormality AE that is characterized by dark colored urine resulting from abormally high blood levels of conjugated bilirubin.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://meded.ucsd.edu/clinicalimg/genital_urine_bili.htm</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10004710</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bilirubinuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004436 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000711"/>
        <obo:IAO_0000115 xml:lang="en">A bladder cancer AE that is characterized by a benign or malignant, primary or metastatic neoplasm of the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.ncbi.nlm.nih.gov/medgen/594</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005056</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004437 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115 xml:lang="en">A urine abnormality AE that is characterized by the presence of bile in urine.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://en.wikipedia.org/wiki/Choluria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10008684</obo:OAE_0004334>
        <rdfs:label xml:lang="en">choluria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004438 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115 xml:lang="en">A urine abnormality AE that is characterized by when one passes blood sugar (blood glucose) into urine.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.healthline.com/healthy/glycosuria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018473</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glycosuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004439 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115 xml:lang="en">A urine abnormality AE that is characterized by an abnormally low urinary specific gravity, i.e., reduced concentration of solutes in the urine.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.ncbi.nlm.nih.gov/publications/dictionaries/cancer-terms/def/hydroureter</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10021096</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hyposthenuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004440 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115 xml:lang="en">A urine abnormality AE that is characterized by a medical condition in which ketone bodies are present in the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Ketonuria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10023388</obo:OAE_0004334>
        <rdfs:label xml:lang="en">ketonuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004441 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>A urine abnormality AE that is characterized by an abnormal pathologic state in which an excessive amount of myoglobin is found in the urine, imparting a cola-like hue, usually in association with myonecrosis and a clinical picture of weakness, myalgias, edema.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/10658177</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10028629</obo:OAE_0004334>
        <rdfs:label>myoglobinuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004443 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115 xml:lang="en">A kidney AE that is characterized by disease or damage of the kidney, which can eventually result in kidney failure</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.news-medical.net/health/What-is-Nephropathy.aspx</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10029151</obo:OAE_0004334>
        <rdfs:label xml:lang="en">nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004444 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004443"/>
        <obo:IAO_0000115 xml:lang="en">A nephropathy AE that is characterized by any adverse functional or structural changes in the kidney due to the effect of a chemical or biological product that is inhaled, ingested, injected, or otherwise absorbed, or that yields toxic metabolites with an identifiable adverse effect on the kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://jamanetwork.com/journals/jama/fullarticle/655056</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10029155</obo:OAE_0004334>
        <rdfs:label xml:lang="en">nephropathy toxic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004445 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115 xml:lang="en">A congenital AE that is characterized by a birth defect and inherited condition that affects the urinary tract (kidneys, ureters, and bladder) or the genital tract (reproductive organs).</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://umiamihealth.org/treatments-and-services/nephrology/congenital-urogenital-abnormalities</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10062334</obo:OAE_0004334>
        <rdfs:label xml:lang="en">congenital genitourinary abnormality AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004446 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115 xml:lang="en">A urinary system AE that is characterized by the abnormal enlargement of the ureter caused by any blockage that prevents urine from draining into the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.cancer.gov/publications/dictionaries/cancer-terms/def/hydroureter</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10020533</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hydroureter AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004447 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115 xml:lang="en">A urinary system AE that is characterized by a condition in which the nephrons, the functional units of the kidneys, become inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.medicalnewstoday.com/articles/312579.php</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10029117</obo:OAE_0004334>
        <rdfs:label xml:lang="en">nephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004448 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115 xml:lang="en">A kidney AE that is characterized by a progressive disease of the kidneys that results from sclerosis (hardening) of the small blood vessels in the kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.medicinenet.com/script/main/art.asp?articlekey=4533</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10029159</obo:OAE_0004334>
        <rdfs:label xml:lang="en">nephrosclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004451 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>A pain AE that is characterized by pain from disease or injury to a kidney</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>kidney pain AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.mayoclinic.org/symptoms/kidney-pain/basics/definition/sym-20050902</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10039490</obo:OAE_0004334>
        <rdfs:label>renal pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004452 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a very heterogeneous group of hereditary and acquired diseases that involve singular or complex dysfunctions of transporters and channels in the renal tubular system</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.amboss.com/us/knowledge/Renal_tubular_disorders</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10038537</obo:OAE_0004334>
        <rdfs:label>renal tubular disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004453 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004452"/>
        <obo:IAO_0000115>A renal tubular disorder AE that is characterized by acute kidney injury in the renal category involving damage to the tubule cells of the kidneys, which can lead to acute kidney failure</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://medlineplus.gov/ency/article/000512.htm</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10038540</obo:OAE_0004334>
        <rdfs:label>renal tubular necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004454 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>A kidney AE that is characterized by vessel wall leukocyte infiltration, often with necrosis affecting the kidney</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/19891303</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10038546</obo:OAE_0004334>
        <rdfs:label>renal vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004455 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by when a person has trouble starting or maintaining a urine stream</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.medicalnewstoday.com/articles/321087.php</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10046542</obo:OAE_0004334>
        <rdfs:label>urinary hesitation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004456 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by any disorder that affects your urinary tract, which is the body&apos;s drainage system for removing urine</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.niddk.nih.gov/health-information/urologic-diseases</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10046566</obo:OAE_0004334>
        <rdfs:label>urinary tract disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004457 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A uninary system AE that occurs in bladder</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>bladder disorder AE</obo:IAO_0000118>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005037</obo:OAE_0004334>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10056655</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004458 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>A urine abnormality AE that is characterized by the presence of porphyrins in the urine</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wiktionary.org/wiki/porphyrinuria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10036193</obo:OAE_0004334>
        <rdfs:label>porphyrinuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004459 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>An abscess AE that is characterized by an infection that has gotten into the kidneys caused by bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.urologyhealth.org/urologic-conditions/kidney-(renal)-abscess</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10038351</obo:OAE_0004334>
        <rdfs:label>renal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004460 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a kidney disorder where the kidneys are relatively small in comparison to the gender, age, and body weight of the patient.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.novusbio.com/diseases/congenital-renal-atrophy</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10038381</obo:OAE_0004334>
        <rdfs:label>renal atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004461 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a sac of fluid that forms in the kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.radiologyinfo.org/en/info.cfm?pg=renal-cyst</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10038423</obo:OAE_0004334>
        <rdfs:label>renal cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004462 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by complete absence, or agenesis, of the urinary bladder</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://jamanetwork.com/journals/jama/fullarticle/325825</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10056655</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder agenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004463 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by a pouch in the bladder wall that a person may either be born with or get later.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.urologyhealth.org/urologic-conditions/bladder-diverticulum</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005038</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder diverticulum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004464 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by scarring and hardening of the tissue in the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.oncolink.org/support/side-effects/genitourinary-side-effects/bladder-fibrosis</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005042</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004465 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by tumor-like formations, projecting above the level of the mucous membrane of the efferent urinary passages, and consisting of granulation tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1464-410X.1937.tb06608.x</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005043</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder granuloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004466 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by an enlarged bladder where the bladder walls become thicker and then grow because they are overstretched.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>enlarged bladder AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.healthline.com/health/enlarged-bladder</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10063408</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004467 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by external bladder injuries that are caused by either blunt or penetrating trauma to the lower abdomen, pelvis, or perineum.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.merckmanuals.com/professional/injuries-poisoning/genitourinary-tract-trauma/bladder-trauma</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10061698</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004468 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by squamous metaplasia of the transitional epithelium and keratinization; it is a rare condition.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/1949238</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10051257</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder leukoplakia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004469 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by acute or chronic changes in the uterine shape or position; this can occur in women prior to labor, during labor, or postpartum.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://emedicine.medscape.com/article/272497-overview</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10049716</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder malposition acquired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004470 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by an overly distended bladder with flattened urothelium.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://ntp.niehs.nih.gov/nnl/urinary/urinary_bladder/dilation/urinary_bladder-dilation_508.pdf</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005033</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder dilatation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004471 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by being the putative precursor of urothelial carcinoma in situ (CIS) and invasive urothelial carcinoma of the urinary tract.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/10199474</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10069448</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004472 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by a number of urinary conditions in people who lack bladder control due to a brain, spinal cord, or nerve problem.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.urologyhealth.org/urologic-conditions/neurogenic-bladder</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10029279</obo:OAE_0004334>
        <rdfs:label>neurogenic bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004473 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by a problem that affects the urinary and genital tracts (reproductive organs)</obo:IAO_0000115>
        <obo:IAO_0000116>This term may need to move to a higher level. More work need to be done.</obo:IAO_0000116>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://intermountainhealthcare.org/services/pediatrics/services/urology/urogenital-disorders/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10046694</obo:OAE_0004334>
        <rdfs:label>urogenital disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004474 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>A procedural complication AE that occurs after a blood transfusion</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label xml:lang="en">blood transfusion reaction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004475 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a reversible form of acute renal dysfunction; it encompasses several different conditions that vary considerably.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3895370/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10001017</obo:OAE_0004334>
        <rdfs:label xml:lang="en">acute prerenal failure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004476 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by an abnormal amount of amino acids in the urine.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ucsfbenioffchildrens.org/tests/003366.html</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10001939</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aminoaciduria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004477 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>A congenital AE that is characterized by a wide range of kidney disease that are from birth; cystic disease may involve one or both kidneys and may or may not occur in the presence of other anomalies.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Cystic_kidney_disease</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10010428</obo:OAE_0004334>
        <rdfs:label xml:lang="en">congenital cystic kidney disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004478 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by a bladder whose muscles do not fully contract. This makes it hard to urinate.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>flaccid bladder, acontracile bladder</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.healthline.com/health/atonic-bladder</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10003629</obo:OAE_0004334>
        <rdfs:label xml:lang="en">atonic urinary bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004479 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a disease that causes abnormal blood clots to form in small blood vessels in the kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>atypical hemolytic uremic syndrome</obo:IAO_0000118>
        <obo:IAO_0000119>https://rarediseases.info.nih.gov/diseases/8702/atypical-hemolytic-uremic-syndrome</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10079840</obo:OAE_0004334>
        <rdfs:label xml:lang="en">atypical haemolytic uraemic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004480 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000498"/>
        <obo:IAO_0000115>A urinary tract infection AE that is characterized by a type of urinary tract infection caused by bacteria where one or both kidneys become infected.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.urologyhealth.org/urologic-conditions/kidney-(renal)-infection-pyelonephritis</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10059517</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bacterial pyelonephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004481 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by the presence of bacteria in urine. It is often accompanied by symptoms is a urinary tract infection while that without is known as asymptomatic bacteriuria.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Bacteriuria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10004056</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bacteriuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004482 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004436"/>
        <obo:IAO_0000115>A bladder neoplasm AE that is characterized by a non-cancerous tumor of the bladder that does not spread (metastasize) to other parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>http://www.cancer.ca/en/cancer-information/cancer-type/bladder/bladder-cancer/non-cancerous-tumours/?region=on</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10004302</obo:OAE_0004334>
        <rdfs:label xml:lang="en">benign neoplasm of bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004483 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000711"/>
        <obo:IAO_0000115>A bladder cancer AE that is characterized by cancer that has returned following initial treatment with surgery, radiation, chemotherapy, and immunotherapy.</obo:IAO_0000115>
        <obo:IAO_0000118>recurrent bladder cancer</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.texasoncology.com/types-of-cancer/bladder-cancer/recurrent-bladder-cancer</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005005</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder cancer recurrent AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004484 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004484">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by problems with urination. This may include urgency of urination, frequency of urination, ability to &quot;hold&quot; urine during day or night, urinary incontinence, infrequent voiding, constipation, or other diagnoses.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.choc.org/programs-services/urology/dysfunctional-bladder/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10069632</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004485 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by a blockage at the base or neck of the bladder. Such a blockage reduces or stops the flow of urine into the urethra, which carries urine from the body.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://my.clevelandclinic.org/health/diseases/15181-bladder-outlet-obstruction-</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005060</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder obstruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004486 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by a narrowing that can cause bladder obstruction that leads to incomplete bladder emptying.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://urobop.co.nz/our-services/id/62</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005082</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004487 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000711"/>
        <obo:IAO_0000115>A bladder cancer AE that is characterized by cancer that starts in the urothelial cells that line the inside of the bladder. It is the most common type of bladder cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>urothelial carcinoma</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.cancer.org/cancer/bladder-cancer/about/what-is-bladder-cancer.html</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10005084</obo:OAE_0004334>
        <rdfs:label xml:lang="en">bladder transitional cell carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004488 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by yeast in the urine which can range from procurement contamination to a sign of a life-threatening, opportunistic fungal infection.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pubmed/11095903</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10050762</obo:OAE_0004334>
        <rdfs:label xml:lang="en">candiduria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004489 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by a severe and long-standing reduction in bladder capacity.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.auajournals.org/article/S0022-5347(17)70833-6/pdf</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10010814</obo:OAE_0004334>
        <rdfs:label xml:lang="en">contracted bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004490 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a medical test in which pain is elicited by percussion of the area of the back overlying the kidney (the costovertebral angle, an angle made by the vertebral column and the costal margin).</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>CVA tenderness, Murphy&apos;s punch sign, Pasternacki&apos;s sign, Goldflam&apos;s sign</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Costovertebral _angle_tenderness</obo:IAO_0000119>
        <rdfs:label xml:lang="en">costovertebral angle tenderness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004491 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a major shock and renal failure after a crushing injury to skeletal muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>Traumatic rhabdomyolysis, Bywaters&apos; syndrome</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Crush_syndrome</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10050702</obo:OAE_0004334>
        <rdfs:label xml:lang="en">crush syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004492 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE thta is characterized by cloudy urine when the cause of cloudiness is due to crystals found in the urine when performing a urine test. It is considered often as a benign condition.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Crystalluria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10011509</obo:OAE_0004334>
        <rdfs:label xml:lang="en">crystalluria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004493 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001918"/>
        <obo:IAO_0000115>A cystitis AE that is characterized by a strong, persistent urge to urinate; a burning sensation when urinating; passing ferquent, small amounts of urine; blood in the urine (hematuria); passing cloudy or strong-smelling urine; pelvic discomfort; a feeling of pressure in the lower abdomen; and a low-grade fever.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://ww.mayoclinic.org/diseases-conditions/cystits/symptoms-causes/syc-20371306</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10050687</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cystitis-like symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004494 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a birth defect in which a kidney is located below, above, or on the opposite side of its usual position; about one in 900 people has an ectopic kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.niddk.nih.gov/health-information/kidney-disease/children/ectopic-kidney</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10063044</obo:OAE_0004334>
        <rdfs:label xml:lang="en">ectopic kidney AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004495 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by two ureters coming from a single kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.chop.edu/conditions-diseases/duplex-kidney</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10023416</obo:OAE_0004334>
        <rdfs:label xml:lang="en">kidney duplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004496 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a mixed bag of developmental abberations, all of which involve anatomical or major structural anomalies.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://adc.bmj.com/content/77/6/471</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10023430</obo:OAE_0004334>
        <rdfs:label xml:lang="en">kidney malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004497 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by either partial or complete fusion of the two kidneys.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.omicsonline.org/open-access/renal-fusion-anomalies-a-review-of-surgical-anatomy-2161-0940-S5-001.php?aid=57809</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10068033</obo:OAE_0004334>
        <rdfs:label xml:lang="en">renal fusion anomaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004498 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by either an anterior or posterior situation; the second type is the most common obstructive congenital malformation of the urethra. The condition presents with abnormal posterior urethral folds or membranes that prevent urine evacuation from the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.sciencedirect.com/topics/medicine-and-dentistry/urethral-valves</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10046479</obo:OAE_0004334>
        <rdfs:label xml:lang="en">urethral valves AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004499 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by the urodynamic description of bladder outlet obstruction from detrusor muscle contraction with concomitant involuntary urethral sphincter activation.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4739973</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10012660</obo:OAE_0004334>
        <rdfs:label xml:lang="en">detrusor sphincter dyssynergia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004500 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by the most advanced stage of kidney disease.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.heart.org/en/health-topics/diabetes/why-diabetes-matters/kidney-disease--diabetes</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10012660</obo:OAE_0004334>
        <rdfs:label xml:lang="en">diabetic end stage renal disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004501 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a serious kidney-related complication of type 1 diabetes and type 2 diabetes.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>diabetic kidney disease</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.mayoclinic.org/diseases-conditions/diabetic-nephropathy/symptoms-causes/syc-20354556</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10061835</obo:OAE_0004334>
        <rdfs:label xml:lang="en">diabetic nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004502 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a rare disease that attacks the kidney&apos;s filtering units (glomeruli) causing serious scarring which leads to permanent kidney damage and even failure.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://nephcure.org/livingwithkidneydisease/understanding-glomerular-disease/understanding-fsgs/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10067757</obo:OAE_0004334>
        <rdfs:label xml:lang="en">focal segmental glomerulosclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004503 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by urinary retention in young women; the problem is caused by the sphincter&apos;s failure to relax to allow urine to be passed.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.bladderandbowel.org/bladder/bladder-conditions-and-symptoms/fowlers-syndrome/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10071718</obo:OAE_0004334>
        <rdfs:label xml:lang="en">fowler&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004504 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by any symptom related to the urinary and genital organs.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.stanfordchildrens.org/en/topic/default?id=overview-of-genitourinary-disorders-90-P03103</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10075537</obo:OAE_0004334>
        <rdfs:label xml:lang="en">genitourinary symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004505 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by inflammation and subsequent damage of the glomeruli leading to hematuria, proteinuria, and azotemia; it may be caused by primary renal disease or systemic conditions. Acute glomerulonephritis is the third most common cause of end-stage renal disease.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://emedicine.medscape.com/article/777272-overview</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018366</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephritis acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004506 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by glomerulonephritis that develops silently (without symptoms) over several years, leading, often, to complete kidney failure.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.kidney.org/atoz/content/glomerul</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018367</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephritis chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004507 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a type of glomerulonephritis caused by deposits in the kidney glomerular mesangium and basement membrane thickening.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Membranoproliferative_glomerulonephritis</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018370</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephritis membranoproliferative AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004508 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a specific type of glomerulonephritis that develops when inflammation of your kidney structures causes problems with the functioning of your kidney.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.healthline.com/health/membranous-nephropathy</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018372</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephritis membranous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004509 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a disease affecting the kidneys which causes a nephrotic syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>minimal change disease</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Minimal_change_disease</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018374</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephritis minimal lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004510 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by an increased number of cells in the glomerulus.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Glomerulonephritis</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018376</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephritis proliferative AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004511 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by any disease of renal glomeruli.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018620</obo:OAE_0004334>
        <rdfs:label xml:lang="en">glomerulonephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004512 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>An autoimmune disorder AE that is characterized by a rare autoimmune disease in which antibodies attack the basement membrane in lungs and kidneys, leading to bleeding from the lungs and kidney failure.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>goodpasture syndrome</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Goodpasture_syndrome</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10018620</obo:OAE_0004334>
        <rdfs:label xml:lang="en">goodpasture&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004513 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by bleeding of the urinary tract that can happen without a clear cause or as a result of an injury.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>hemorrhage urinary tract</obo:IAO_0000118>
        <obo:IAO_0000119>https://www.hog.org/handbook/article/3/33/urinary-tract-bleeds</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10055847</obo:OAE_0004334>
        <rdfs:label xml:lang="en">haemorrhage urinary tract AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004514 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by a rare kidney disease leading to chronic kidney disease in a non-negligible percentage of patients.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://cjasn.asnjournals.org/content/6/3/679</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10069440</obo:OAE_0004334>
        <rdfs:label xml:lang="en">henoch-schonlein purpura nephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004515 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by when hemoglobin is released from RBCs into the bloodstream in excess of the binding capacity of haptoglobin. It occurs with chronic introvascular hemolysis and is called &quot;brown urine.&quot;</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>hemosiderinuria</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Hemosiderinuria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10069395</obo:OAE_0004334>
        <rdfs:label xml:lang="en">haemosiderinuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004516 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>A kidney AE that is characterized by rapid deterioration in kidney function in individuals with cirrhosis or fulminant liver failure. It is a life-threatening medical condition.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Hepatorenal_syndrome</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10019846</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hepatorenal syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004517 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by an excessive urinary excretion of oxalate.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Hyperoxaluria</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10020703</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hyperoxaluria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004518 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004443"/>
        <obo:IAO_0000115>A nephropathy AE that is characterized by a disease of the kidneys where the vasculature of the kidneys is damaged with an increase in blood pressure (high blood pressure).</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.myvmc.com/diseases/hypertensive-nephropathy/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10055171</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypertensive nephropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004519 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <obo:IAO_0000115>A urinary system AE that is characterized by low urinary-citrate excretion (defined as less than 320 mg/day), which can cause kidney stones in up to 2/3 of cases.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Kidney_stone_disease#Hypocitraturia</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10070871</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypocitraturia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004520 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>A congenital AE that is characterized by a congenital disorder of the urethra where the urinary opening is not at the usual location on the head of the penis.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Hypospadias</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10021093</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypospadias AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004521 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004457"/>
        <obo:IAO_0000115>A bladder AE that is characterized by the hypotonic bladder muscle failing to squeeze hard enough to completely empty the bladder.</obo:IAO_0000115>
        <obo:IAO_0000117>David Ameriguian, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>http://urologygroup.com/conditions-we-treat/urinary-retention/</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10058914</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypotonic urinary bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004522 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>An AE with the fragmentation of the nucleus</obo:IAO_0000115>
        <obo:IAO_0000117>Anthony Huffman, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Karyorrhexis</obo:IAO_0000119>
        <obo:IAO_0000119>https://jvi.asm.org/content/78/22/12672.long</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.nature.com/articles/43591</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10063393</obo:OAE_0004334>
        <rdfs:label xml:lang="en">karyorrhexis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004523 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002580"/>
        <obo:IAO_0000115>A cardiac disorder AE that shows a disorder of the heart&apos;s electrical activity, which can cause sudden, uncontrollable, dangerous arrhythmias in response to exercise or stress. The term &quot;long QT&quot; refers to an abnormal pattern seen on an EKG (electrocardiogram), a test that detects and records the heart&apos;s electrical activity.</obo:IAO_0000115>
        <obo:IAO_0000117>Madison Kalter, Jamie Ngai, Beccca Racz, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>LQTS AE</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Long_QT_syndrome</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.nhlbi.nih.gov/health-topics/long-qt-syndrome</obo:IAO_0000119>
        <rdfs:label xml:lang="en">long QT syndrome AE</rdfs:label>
    </owl:Class>
    


