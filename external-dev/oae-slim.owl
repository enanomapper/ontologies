    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006951 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the tonsillar.</obo:IAO_0000115>
