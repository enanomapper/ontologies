        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000168"/>
        <obo:IAO_0000115>This is an AE which Is an injury or abnormality that occurs in the neural pathway above the anterior horn cell of the spinal cord or motor nuclei of the cranial nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
