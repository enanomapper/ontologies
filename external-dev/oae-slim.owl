    <!-- http://purl.obolibrary.org/obo/OAE_0006431 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001666"/>
        <obo:IAO_0000115>This is an AE which is the cells of the immune system that are involved in protecting the body against both infectious disease and foreign invaders .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/White_blood_cell</obo:IAO_0000119>
        <obo:OAE_0001849>白细胞紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10061414</obo:OAE_0004334>
        <rdfs:label>white blood cell disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006432 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000115>This is an AE which is the formation of a blood clot inside a haemorrhoids blood vessel, obstructing the flow of blood through the circulatory system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombosis</obo:IAO_0000119>
        <obo:OAE_0001849>痔疮血栓</obo:OAE_0001849>
        <obo:OAE_0004334>10019023</obo:OAE_0004334>
        <rdfs:label>haemorrhoids thrombosed AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006433 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001977"/>
        <obo:IAO_0000115>This is an AE which is well recognized and not infrequent findings in hyperthyroidism in adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15469538/</obo:IAO_0000119>
        <obo:OAE_0001849>高转氨血症</obo:OAE_0001849>
        <obo:OAE_0004334>10068237</obo:OAE_0004334>
        <rdfs:label>hypertransaminasaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006434 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004539"/>
        <obo:IAO_0000115>This is an AE which occurs when a blood clot forms in the artery that provides blood flow to the peripheral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatic_artery_thrombosis</obo:IAO_0000119>
        <obo:OAE_0001849>外周动脉血栓形成</obo:OAE_0001849>
        <obo:OAE_0004334>10072564</obo:OAE_0004334>
        <rdfs:label>peripheral artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006435 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001422"/>
        <obo:IAO_0000115>This is an AE which refers to a term for the presence of toxins in the blood caused by staphylococcal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Toxemia</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌毒血症</obo:OAE_0001849>
        <obo:OAE_0004334>10041932</obo:OAE_0004334>
        <rdfs:label>staphylococcal toxaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006436 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a form of anemia due to hemolysis, the abnormal breakdown of red blood cells (RBCs), either in the blood vessels (intravascular hemolysis) or elsewhere in the human body (extravascular).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemolytic_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>溶血性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10018916</obo:OAE_0004334>
        <rdfs:label>hemolytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006437 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001012"/>
        <obo:IAO_0000115>This is an AE which is a group of blood disorders characterized by low red blood cells, acute kidney failure, and low platelets.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemolytic%E2%80%93uremic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>溶血性尿毒综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10018932</obo:OAE_0004334>
        <rdfs:label>hemolytic uraemic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006438 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001422"/>
        <obo:IAO_0000115>This is an AE which is a common cause of infection among acute myeloid leukemia (AML) patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10784625/</obo:IAO_0000119>
        <obo:OAE_0001849>溶血性链球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054265</obo:OAE_0004334>
        <rdfs:label>alpha hemolytic streptococcal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006439 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a decrease in the total amount of red blood cells (RBCs) or hemoglobin in the blood or a lowered ability of the blood to carry oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anemia</obo:IAO_0000119>
        <obo:OAE_0001849>贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10002034</obo:OAE_0004334>
        <rdfs:label>anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006440 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which occurs when antibodies directed against the person&apos;s own red blood cells (RBCs) cause them to burst (lyse), leading to an insufficient number of oxygen-carrying red blood cells in the circulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_hemolytic_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>溶血性贫血自身免疫性</obo:OAE_0001849>
        <obo:OAE_0004334>10002046</obo:OAE_0004334>
        <rdfs:label>anemia hemolytic autoimmune AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006441 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a type of macrocytic anemia. An anemia is a red blood cell defect that can lead to an undersupply of oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Megaloblastic_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>巨幼红细胞贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10002065</obo:OAE_0004334>
        <rdfs:label>anemia megaloblastic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006442 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which can be due to blood loss, decreased RBC production, or increased destruction of erythrocytes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18411074/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10002068</obo:OAE_0004334>
        <rdfs:label>anemia neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006443 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a form of anemia seen in chronic infection, chronic immune activation, and malignancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anemia_of_chronic_disease</obo:IAO_0000119>
        <obo:OAE_0001849>慢性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10002073</obo:OAE_0004334>
        <rdfs:label>anemia of chronic disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006444 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a decrease in the total red blood cells (RBCs) or hemoglobin in the blood during pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anemia_in_pregnancy</obo:IAO_0000119>
        <obo:OAE_0001849>妊娠贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10066468</obo:OAE_0004334>
        <rdfs:label>anemia of pregnancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006445 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which occurs when antibodies directed against the person&apos;s own red blood cells (RBCs) cause them to burst (lyse), leading to an insufficient number of oxygen-carrying red blood cells in the circulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_hemolytic_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性溶血性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10073785</obo:OAE_0004334>
        <rdfs:label>autoimmune hemolytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006446 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001422"/>
        <obo:IAO_0000115>This is an AE which is a type of streptococcus infection and  beta-hemolytic is a complete lysis of red cells in the media around and under the colonies: the area appears lightened (yellow) and transparent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Streptococcus</obo:IAO_0000119>
        <obo:OAE_0001849>溶血性链球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10052100</obo:OAE_0004334>
        <rdfs:label>beta hemolytic streptococcal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006447 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000379"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the white cell (leukocyte count) is above the normal range in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leukocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>高白细胞血症</obo:OAE_0001849>
        <obo:OAE_0004334>10078862</obo:OAE_0004334>
        <rdfs:label>hyperleukocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006448 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a group of blood cancers that usually begin in the bone marrow and result in high numbers of abnormal blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10024288</obo:OAE_0004334>
        <rdfs:label>leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006449 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000379"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the white cell (leukocyte count) is above the normal range in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leukocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>白细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10024378</obo:OAE_0004334>
        <rdfs:label>leukocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006450 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002568"/>
        <obo:IAO_0000115>This is an AE which is a long-term skin condition characterized by patches of the skin losing their pigment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vitiligo</obo:IAO_0000119>
        <obo:OAE_0001849>白癜风</obo:OAE_0001849>
        <obo:OAE_0004334>10024380</obo:OAE_0004334>
        <rdfs:label>leukoderma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006451 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a medical emergency most commonly seen in patients with acute myeloid leukemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leukostasis</obo:IAO_0000119>
        <obo:OAE_0001849>白细胞平衡综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10074608</obo:OAE_0004334>
        <rdfs:label>leukostasis syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006452 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare autosomal recessive disorder that arises from a mutation of a lysosomal trafficking regulator protein,which leads to a decrease in phagocytosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ch%C3%A9diak%E2%80%93Higashi_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>白细胞异常色素减退综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10008415</obo:OAE_0004334>
        <rdfs:label>chediak-higashi syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006453 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a skin condition, a variant of acrocyanosis caused by chronic exposure to cold.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythrocyanosis_crurum</obo:IAO_0000119>
        <obo:OAE_0001849>红细胞发绀</obo:OAE_0001849>
        <obo:OAE_0004334>10048995</obo:OAE_0004334>
        <rdfs:label>erythrocyanosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006454 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a rare form of acute myeloid leukemia (less than 5% of AML cases) where the myeloproliferation is of erythroblastic precursors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_erythroid_leukemia#M6a_(Erythroleukemia)</obo:IAO_0000119>
        <obo:OAE_0001849>红白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10015281</obo:OAE_0004334>
        <rdfs:label>erythroleukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006455 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is a fairly disabling microvascular phenomenon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/545362/</obo:IAO_0000119>
        <obo:OAE_0001849>造红细胞组织增殖，皮肤红变</obo:OAE_0001849>
        <obo:OAE_0004334>10056474</obo:OAE_0004334>
        <rdfs:label>erythrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006456 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is variation in cell shape: poikilocytes may be oval, teardrop-shaped, sickle-shaped or irregularly contracted.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Poikilocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>异形红细胞症</obo:OAE_0001849>
        <obo:OAE_0004334>10035774</obo:OAE_0004334>
        <rdfs:label>poikilocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006457 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a disease state in which the hematocrit (the volume percentage of red blood cells in the blood) and/or hemoglobin concentration are elevated in peripheral blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polycythemia</obo:IAO_0000119>
        <obo:OAE_0001849>多血性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10036051</obo:OAE_0004334>
        <rdfs:label>polycythaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006458 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001361"/>
        <obo:IAO_0000115>This is an AE which is the medical term for an abnormal decrease of reticulocytes in the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reticulocytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>网织红细胞减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10038795</obo:OAE_0004334>
        <rdfs:label>reticulocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006459 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001712"/>
        <obo:IAO_0000115>This is an AE which is a condition where there is an increase in reticulocytes, immature red blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reticulocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>网织红细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10038796</obo:OAE_0004334>
        <rdfs:label>reticulocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006460 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a common inherited disorder that is characterised by anaemia, jaundice, and splenomegaly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18940465/</obo:IAO_0000119>
        <obo:OAE_0001849>球形红细胞性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10041509</obo:OAE_0004334>
        <rdfs:label>spherocytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006461 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000286"/>
        <obo:IAO_0000115>This is an AE which refers to a type of aplastic anemia affecting the precursors to red blood cells but usually not to white blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pure_red_cell_aplasia</obo:IAO_0000119>
        <obo:OAE_0001849>发育不全纯红细胞</obo:OAE_0001849>
        <obo:OAE_0004334>10002965</obo:OAE_0004334>
        <rdfs:label>aplasia pure red cell AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006462 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a type of thrombocytopenic purpura defined as an isolated low platelet count with a normal bone marrow in the absence of other causes of low platelets.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immune_thrombocytopenic_purpura</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性血小板减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10050245</obo:OAE_0004334>
        <rdfs:label>autoimmune thrombocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006463 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a rare chronic blood cancer (myeloproliferative neoplasm) characterised by the overproduction of platelets (thrombocytes) by megakaryocytes in the bone marrow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Essential_thrombocythemia</obo:IAO_0000119>
        <obo:OAE_0001849>原发性血小板血症</obo:OAE_0001849>
        <obo:OAE_0004334>10015493</obo:OAE_0004334>
        <rdfs:label>essential thrombocythaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006464 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is the development of thrombocytopenia (a low platelet count), due to the administration of various forms of heparin, an anticoagulant.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heparin-induced_thrombocytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>肝素诱发的血小板减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10062506</obo:OAE_0004334>
        <rdfs:label>heparin-induced thrombocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006465 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a type of thrombocytopenic purpura defined as an isolated low platelet count with a normal bone marrow in the absence of other causes of low platelets.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immune_thrombocytopenic_purpura</obo:IAO_0000119>
        <obo:OAE_0001849>免疫性血小板减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10083842</obo:OAE_0004334>
        <rdfs:label>immune thrombocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006466 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a type of thrombocytopenic purpura defined as an isolated low platelet count with a normal bone marrow in the absence of other causes of low platelets.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Immune_thrombocytopenic_purpura</obo:IAO_0000119>
        <obo:OAE_0001849>免疫性血小板减少性紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10074667</obo:OAE_0004334>
        <rdfs:label>immune thrombocytopenic purpura AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006467 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a disease that affects babies in which the platelet count is decreased because the mother&apos;s immune system attacks her fetus&apos; or newborn&apos;s platelets.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_alloimmune_thrombocytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿同种免疫性血小板减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10075149</obo:OAE_0004334>
        <rdfs:label>neonatal alloimmune thrombocytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006468 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001731"/>
        <obo:IAO_0000115>This is an AE which is a medical term meaning that a patient&apos;s red blood cells(such as platelet ) are of unequal size.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anisocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>血小板异体细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10066294</obo:OAE_0004334>
        <rdfs:label>platelet anisocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006469 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001731"/>
        <obo:IAO_0000115>This is an AE which is a component of blood whose function (along with the coagulation factors) is to react to bleeding from blood vessel injury by clumping, thereby initiating a blood clot and its function is disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Platelet</obo:IAO_0000119>
        <obo:OAE_0001849>血小板疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10035532</obo:OAE_0004334>
        <rdfs:label>platelet disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006470 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001731"/>
        <obo:IAO_0000115>This is an AE which is deeply involved in the pathogenesis of psoriasis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32349003/</obo:IAO_0000119>
        <obo:OAE_0001849>血小板功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10073391</obo:OAE_0004334>
        <rdfs:label>platelet dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006471 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is a condition of high platelet (thrombocyte) count in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombocythemia#Causes</obo:IAO_0000119>
        <obo:OAE_0001849>继发性血小板增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10083158</obo:OAE_0004334>
        <rdfs:label>secondary thrombocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006472 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001448"/>
        <obo:IAO_0000115>This is an AE which is a condition characterized by abnormally low levels of platelets occurs on the neonatal, also known as thrombocytes, in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombocytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿血小板减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10043557</obo:OAE_0004334>
        <rdfs:label>thrombocytopenia neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006473 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000236"/>
        <obo:IAO_0000115>This is an AE which is a condition of high platelet (thrombocyte) count in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombocythemia</obo:IAO_0000119>
        <obo:OAE_0001849>血小板增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10043563</obo:OAE_0004334>
        <rdfs:label>thrombocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006474 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a crisis disease caused by production of abnormal hemoglobin, which binds with other abnormal hemoglobin molecules within the red blood cell to cause rigid deformation of the cell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11452073/</obo:IAO_0000119>
        <obo:OAE_0001849>镰状细胞性贫血伴危象</obo:OAE_0001849>
        <obo:OAE_0004334>10040642</obo:OAE_0004334>
        <rdfs:label>sickle cell anemia with crisis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006475 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is a group of blood disorders typically inherited from a person&apos;s parents.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sickle_cell_disease</obo:IAO_0000119>
        <obo:OAE_0001849>镰状细胞性贫血症</obo:OAE_0001849>
        <obo:OAE_0004334>10040644</obo:OAE_0004334>
        <rdfs:label>sickle cell disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006476 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which describes a condition in which a person has one abnormal allele of the hemoglobin beta gene (is heterozygous), but does not display the severe symptoms of sickle cell disease that occur in a person who has two copies of that allele (is homozygous).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sickle_cell_trait</obo:IAO_0000119>
        <obo:OAE_0001849>镰状细胞性状</obo:OAE_0001849>
        <obo:OAE_0004334>10040650</obo:OAE_0004334>
        <rdfs:label>sickle cell trait AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006477 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is associated with a poor prognosis, and liver transplant is the only definitive management.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33139258/</obo:IAO_0000119>
        <obo:OAE_0001849>细胞性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10052483</obo:OAE_0004334>
        <rdfs:label>spur cell anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006478 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a form of thalassemia involving the genes HBA1 and HBA2.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alpha-thalassemia</obo:IAO_0000119>
        <obo:OAE_0001849>α地中海贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10043390</obo:OAE_0004334>
        <rdfs:label>thalassaemia alpha AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006479 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is without achylia or the Addisonian symptoms of glossitis, flatulent dyspepsia, diarrhoea, paraesthesiae, or neurological symptoms is seen in achrestic anaemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/13160478/</obo:IAO_0000119>
        <obo:OAE_0001849>嗜铬性贫血，高色性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10020605</obo:OAE_0004334>
        <rdfs:label>hyperchromic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006480 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a decrease in the total amount of red blood cells (RBCs) or hemoglobin in the blood or a lowered ability of the blood to carry oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anemia</obo:IAO_0000119>
        <obo:OAE_0001849>发育不良性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10021074</obo:OAE_0004334>
        <rdfs:label>hypoplastic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006481 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is any of several types of anaemia characterized by small red blood cells (called microcytes).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Microcytic_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>小细胞性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10027538</obo:OAE_0004334>
        <rdfs:label>microcytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006482 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is a condition in which red blood cells are unusually small as measured by their mean corpuscular volume.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Microcytosis</obo:IAO_0000119>
        <obo:OAE_0001849>小细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10027540</obo:OAE_0004334>
        <rdfs:label>microcytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006483 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which appear to be the outcome of the impaired production of RBCs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33351438/</obo:IAO_0000119>
        <obo:OAE_0001849>正常色素的贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10029782</obo:OAE_0004334>
        <rdfs:label>normochromic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006484 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006484">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a common complication in chronic kidney disease and is associated with many adverse clinical consequences.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26372086/</obo:IAO_0000119>
        <obo:OAE_0001849>正色素性正细胞性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10029783</obo:OAE_0004334>
        <rdfs:label>normochromic normocytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006485 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which may be caused by chronic disease, hemolysis, or bone marrow disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20540485/</obo:IAO_0000119>
        <obo:OAE_0001849>正常红血球的贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10029784</obo:OAE_0004334>
        <rdfs:label>normocytic anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006486 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <obo:IAO_0000115>This is an AE which is a disease in which not enough red blood cells are produced due to a deficiency of vitamin B12.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vitamin_B12_deficiency_anemia</obo:IAO_0000119>
        <obo:OAE_0001849>恶性贫血</obo:OAE_0001849>
        <obo:OAE_0004334>10034695</obo:OAE_0004334>
        <rdfs:label>pernicious anemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006487 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a cancer of plasma cells, a type of white blood cell that normally produces antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_myeloma</obo:IAO_0000119>
        <obo:OAE_0001849>浆细胞骨髓瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10035226</obo:OAE_0004334>
        <rdfs:label>plasma cell myeloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006488 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is one of the most common serious bacterial infections worldwide.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21371655/</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10051017</obo:OAE_0004334>
        <rdfs:label>staphylococcal bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006489 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001256"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory bone disease that is caused by an infecting microorganism such as staphylococcal and leads to progressive bone destruction and loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29444953/</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌性骨髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064250</obo:OAE_0004334>
        <rdfs:label>staphylococcal osteomyelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006490 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by staphylococcal that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10056430</obo:OAE_0004334>
        <rdfs:label>staphylococcal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006491 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a family of serious medical conditions relating to an original diagnosis of leukemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>急性白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10000830</obo:OAE_0004334>
        <rdfs:label>acute leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006492 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001256"/>
        <obo:IAO_0000115>This is an AE which is a rare condition (1:1,000,000), in which the bones have lesions, inflammation, and pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_recurrent_multifocal_osteomyelitis</obo:IAO_0000119>
        <obo:OAE_0001849>慢性复发性多发性骨髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10071530</obo:OAE_0004334>
        <rdfs:label>chronic recurrent multifocal osteomyelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006493 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a rare malignancy affecting megakaryocytes, platelet-producing cells that reside in the bone marrow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31548219/</obo:IAO_0000119>
        <obo:OAE_0001849>急性巨核细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10000860</obo:OAE_0004334>
        <rdfs:label>acute megakaryocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006494 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a type of acute myeloid leukemia. In AML-M5 &gt;80% of the leukemic cells are of monocytic lineage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_monocytic_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>急性单核细胞的白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10000871</obo:OAE_0004334>
        <rdfs:label>acute monocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006495 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is usually associated with determined recurrent cytogenetic aberrations like inv(16), t(v;11) (MLL gene rearrangement), and t(8;16).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5843787/</obo:IAO_0000119>
        <obo:OAE_0001849>急性骨髓单核细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10000890</obo:OAE_0004334>
        <rdfs:label>acute myelomonocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006496 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a cancer of plasma cells, a type of white blood cell that normally produces antibodies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_myeloma</obo:IAO_0000119>
        <obo:OAE_0001849>多发性骨髓瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10028228</obo:OAE_0004334>
        <rdfs:label>multiple myeloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006497 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a subtype of acute myeloid leukemia (AML), a cancer of the white blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_promyelocytic_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>急性早幼粒细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10001019</obo:OAE_0004334>
        <rdfs:label>acute promyelocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006498 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is the transplantation of multipotent hematopoietic stem cells, usually derived from bone marrow, peripheral blood, or umbilical cord blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematopoietic_stem_cell_transplantation</obo:IAO_0000119>
        <obo:OAE_0001849>骨髓移植</obo:OAE_0001849>
        <obo:OAE_0004334>10051410</obo:OAE_0004334>
        <rdfs:label>bone marrow harvest AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006499 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is an uncommon and self-limited syndrome characterized by extremity pain of unknown etiology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27587374/</obo:IAO_0000119>
        <obo:OAE_0001849>骨髓水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051763</obo:OAE_0004334>
        <rdfs:label>bone marrow edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006500 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a type of leukemia affecting myeloid tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myeloid_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>髓样白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10028549</obo:OAE_0004334>
        <rdfs:label>myeloid leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006501 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a group of rare blood cancers in which excess red blood cells, white blood cells or platelets are produced in the bone marrow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myeloproliferative_neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>骨髓增殖性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10077465</obo:OAE_0004334>
        <rdfs:label>myeloproliferative neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006502 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001256"/>
        <obo:IAO_0000115>This is an AE which occurs in children who are otherwise healthy because of rich blood supply to the growing bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteomyelitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性骨髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10031253</obo:OAE_0004334>
        <rdfs:label>osteomyelitis acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006503 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001256"/>
        <obo:IAO_0000115>This is an AE which is an infection of bone caused by bacterial infection, but rarely can be a fungal infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteomyelitis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌骨髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065237</obo:OAE_0004334>
        <rdfs:label>osteomyelitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006504 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a form of upper extremity deep vein thrombosis (DVT), a medical condition in which blood clots form in the deep veins of the arms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paget%E2%80%93Schroetter_disease</obo:IAO_0000119>
        <obo:OAE_0001849>佩-施二氏综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10050216</obo:OAE_0004334>
        <rdfs:label>paget-schroetter syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006505 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a medical condition that may occur as a long-term complication of deep vein thrombosis (DVT).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Post-thrombotic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>后血栓性综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10048591</obo:OAE_0004334>
        <rdfs:label>post thrombotic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006506 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is the breakdown (lysis) of blood clots formed in blood vessels, using medication.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombolysis</obo:IAO_0000119>
        <obo:OAE_0001849>溶栓</obo:OAE_0001849>
        <obo:OAE_0004334>10043568</obo:OAE_0004334>
        <rdfs:label>thrombolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006507 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001449"/>
        <obo:IAO_0000115>This is an AE which is a thrombosis and inflammation of superficial veins which presents as a painful induration with erythema, often in a linear or branching configuration forming cords.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Superficial_thrombophlebitis</obo:IAO_0000119>
        <obo:OAE_0001849>血栓性浅静脉炎</obo:OAE_0001849>
        <obo:OAE_0004334>10043595</obo:OAE_0004334>
        <rdfs:label>thrombophlebitis superficial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006508 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000115>This is an AE which occurs more frequently than thrombosis of one or both umbilical arteries, but poor fetal outcome is more likely with arterial thrombosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/3041394/</obo:IAO_0000119>
        <obo:OAE_0001849>脐带血栓</obo:OAE_0001849>
        <obo:OAE_0004334>10071652</obo:OAE_0004334>
        <rdfs:label>umbilical cord thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006509 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000115>This is an AE which is a rare surgical complication which may cause serious leg damage and may occasionally be fatal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30219778/</obo:IAO_0000119>
        <obo:OAE_0001849>髂动脉血栓形成</obo:OAE_0001849>
        <obo:OAE_0004334>10021340</obo:OAE_0004334>
        <rdfs:label>iliac artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006510 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is a group of leukemias affecting circulating lymphocytes, a type of white blood cell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphoid_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>淋巴细胞性白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10025270</obo:OAE_0004334>
        <rdfs:label>lymphocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006511 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a form of lymphoid leukemia and lymphoma in which too many T-cell lymphoblasts (immature white blood cells) are found in the blood, bone marrow, and tissues, particularly mediastinal lymph nodes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/T-lymphoblastic_leukemia/lymphoma</obo:IAO_0000119>
        <obo:OAE_0001849>前体T淋巴细胞淋巴瘤/白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10036543</obo:OAE_0004334>
        <rdfs:label>precursor t-lymphoblastic lymphoma/leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006512 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is a mature T-cell leukemia with aggressive behavior and predilection for blood, bone marrow, lymph nodes, liver, spleen, and skin involvement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/T-cell_prolymphocytic_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>T细胞幼淋巴细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10042985</obo:OAE_0004334>
        <rdfs:label>t-cell prolymphocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006513 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is an aggressive malignancy that has historically been associated with a very poor prognosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31738819/</obo:IAO_0000119>
        <obo:OAE_0001849>T细胞型急性白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10042987</obo:OAE_0004334>
        <rdfs:label>t-cell type acute leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006514 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is an increase of abnormal white blood cells and  differs from acute leukemia, and is categorized as myelogenous or lymphocytic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>慢性白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10008943</obo:OAE_0004334>
        <rdfs:label>chronic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006515 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000115>This is an AE which is a type of cancer in which the bone marrow makes too many lymphocytes (a type of white blood cell).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_lymphocytic_leukemia</obo:IAO_0000119>
        <obo:OAE_0001849>慢性淋巴细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10008958</obo:OAE_0004334>
        <rdfs:label>chronic lymphocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006516 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a serious secondary disease that alters the events in the clotting cascade.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30567917/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿弥散性血管内凝血</obo:OAE_0001849>
        <obo:OAE_0004334>10013443</obo:OAE_0004334>
        <rdfs:label>disseminated intravascular coagulation in newborn AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006517 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a common feature of several tumors to the extent that individuals with coagulation defects often present with occult visceral cancers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27876232/</obo:IAO_0000119>
        <obo:OAE_0001849>凝血异常</obo:OAE_0001849>
        <obo:OAE_0004334>10020608</obo:OAE_0004334>
        <rdfs:label>hypercoagulation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006518 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a metabolic disorder that occurs in cattle when energy demand exceeds energy intake and results in a negative energy balance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31896507/</obo:IAO_0000119>
        <obo:OAE_0001849>丙酮血症</obo:OAE_0001849>
        <obo:OAE_0004334>10000410</obo:OAE_0004334>
        <rdfs:label>acetonaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006519 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001653"/>
        <obo:IAO_0000115>This is an AE which is an abnormal protein that forms precipitate only in plasma and can be detected both in healthy persons and patients with autoimmune diseases, cancer and infections.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27789759/</obo:IAO_0000119>
        <obo:OAE_0001849>冷纤维蛋白原血症</obo:OAE_0001849>
        <obo:OAE_0004334>10051229</obo:OAE_0004334>
        <rdfs:label>cryofibrinogenaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006520 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001653"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the blood contains large amounts of pathological cold sensitive antibodies called cryoglobulins – proteins (mostly immunoglobulins themselves) that become insoluble at reduced temperatures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cryoglobulinemia</obo:IAO_0000119>
        <obo:OAE_0001849>冷球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10011474</obo:OAE_0004334>
        <rdfs:label>cryoglobulinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006521 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000857"/>
        <obo:IAO_0000115>This is an AE which is a medical condition caused by cytomegalovirus where cytomegalovirus  enter the bloodstream and hence have access to the rest of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Viremia</obo:IAO_0000119>
        <obo:OAE_0001849>巨细胞病毒病毒血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058854</obo:OAE_0004334>
        <rdfs:label>cytomegalovirus viraemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006522 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001664"/>
        <obo:IAO_0000115>This is an AE which is a reduction in the number of mature blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cytopenia</obo:IAO_0000119>
        <obo:OAE_0001849>血球减少</obo:OAE_0001849>
        <obo:OAE_0004334>10066274</obo:OAE_0004334>
        <rdfs:label>cytopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006523 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is present in the systemic circulation; in septicaemia, whole microbes invade normally sterile parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27452161/</obo:IAO_0000119>
        <obo:OAE_0001849>内毒素血症</obo:OAE_0001849>
        <obo:OAE_0004334>10067410</obo:OAE_0004334>
        <rdfs:label>endotoxaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006524 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is severe complications after hematopoietic stem cell transplantation (HSCT).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29949208/</obo:IAO_0000119>
        <obo:OAE_0001849>巴尔病毒血症</obo:OAE_0001849>
        <obo:OAE_0004334>10065110</obo:OAE_0004334>
        <rdfs:label>epstein-barr viraemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006525 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by fungal  that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>真菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058872</obo:OAE_0004334>
        <rdfs:label>fungal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006526 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder that occurs in adults in whom hypogammaglobulinemia, deficient cell-mediated immunity, and thymoma (usually benign) may develop almost simultaneously.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thymoma_with_immunodeficiency</obo:IAO_0000119>
        <obo:OAE_0001849>胸腺瘤合并无丙种球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10079838</obo:OAE_0004334>
        <rdfs:label>good syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006527 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a type of neonatal infection  caused by group b streptococcusand specifically refers to the presence in a newborn baby of a bacterial blood stream infection (BSI) (such as meningitis, pneumonia, pyelonephritis, or gastroenteritis) in the setting of fever.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>b组新生儿链球菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10053588</obo:OAE_0004334>
        <rdfs:label>group b streptococcus neonatal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006528 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo:IAO_0000115>This is an AE which is an acquired clonal disorder of the hemopoietic stem cell that is characterized by chronic intravascular hemolysis, as indicated by the grossly elevated levels of LDH in almost all patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15811985/</obo:IAO_0000119>
        <obo:OAE_0001849>血红蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10018901</obo:OAE_0004334>
        <rdfs:label>hemoglobinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006529 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an uncommon hematologic disorder seen more often in children than in adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemophagocytic_lymphohistiocytosis</obo:IAO_0000119>
        <obo:OAE_0001849>噬血细胞性淋巴组织细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10071583</obo:OAE_0004334>
        <rdfs:label>haemophagocytic lymphohistiocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006530 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a genus of Gram-negative, pleomorphic, coccobacilli bacteria belonging to the family Pasteurellaceae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Haemophilus</obo:IAO_0000119>
        <obo:OAE_0001849>嗜血杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061190</obo:OAE_0004334>
        <rdfs:label>haemophilus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006531 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001013"/>
        <obo:IAO_0000115>This is an AE which is the coughing up of blood or blood-stained mucus from the bronchi, larynx, trachea, or lungs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemoptysis</obo:IAO_0000119>
        <obo:OAE_0001849>咯血</obo:OAE_0001849>
        <obo:OAE_0004334>10018964</obo:OAE_0004334>
        <rdfs:label>hemoptysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006532 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is an inherited disease of vitamin B12 metabolism with a wide spectrum of clinical manifestations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32443968/</obo:IAO_0000119>
        <obo:OAE_0001849>同型半胱氨酸血症</obo:OAE_0001849>
        <obo:OAE_0004334>10048707</obo:OAE_0004334>
        <rdfs:label>homocystinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006533 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a metabolic disturbance characterised by an excess of ammonia in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperammonemia</obo:IAO_0000119>
        <obo:OAE_0001849>高氨血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020575</obo:OAE_0004334>
        <rdfs:label>hyperammonaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006534 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which may also be due to an increase in the amylase content within the lung tissues; possibly the carcinoma provokes an inflammatory response resulting in release of amylase into the circulation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24194585/</obo:IAO_0000119>
        <obo:OAE_0001849>高淀粉酶血症</obo:OAE_0001849>
        <obo:OAE_0004334>10062770</obo:OAE_0004334>
        <rdfs:label>hyperamylasaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006535 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is abnormally elevated levels of any or all lipids (fats, cholesterol, or triglycerides) or lipoproteins in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperlipidemia</obo:IAO_0000119>
        <obo:OAE_0001849>其他高脂血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020606</obo:OAE_0004334>
        <rdfs:label>hyperchylomicronaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006536 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which  would arise as a consequence of increased cysteine synthesis associated with the provision of protective substances (glutathione and/or taurine).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/14520508/</obo:IAO_0000119>
        <obo:OAE_0001849>高肌酸血症</obo:OAE_0001849>
        <obo:OAE_0004334>10675350</obo:OAE_0004334>
        <rdfs:label>hypercreatinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006537 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a well-known feature of liver and testicular toxicity and we have recently proposed that hepatotoxin-induced hypercreatinuria would arise as a consequence of increased cysteine synthesis associated with the provision of protective substances (glutathione and/or taurine).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/14520508/</obo:IAO_0000119>
        <obo:OAE_0001849>高肌酐血症</obo:OAE_0001849>
        <obo:OAE_0004334>10062747</obo:OAE_0004334>
        <rdfs:label>hypercreatininaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006538 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a universal intracellular protein that stores iron and releases it in a controlled fashion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ferritin#Excess</obo:IAO_0000119>
        <obo:OAE_0001849>高铁血症</obo:OAE_0001849>
        <obo:OAE_0004334>10075046</obo:OAE_0004334>
        <rdfs:label>hyperferritinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006539 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which results in vascular remodelling, and fibrinogen (Fg) and amyloid β (Aβ) complex formation is a hallmark of Alzheimer&apos;s disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27121987/</obo:IAO_0000119>
        <obo:OAE_0001849>高纤维蛋白原血症</obo:OAE_0001849>
        <obo:OAE_0004334>10051124</obo:OAE_0004334>
        <rdfs:label>hyperfibrinogenaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006540 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is  considered important prognostic markers, with the monitoring of lactate blood levels being very important in critical patients, like those admitted to the intensive care units.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23704442/</obo:IAO_0000119>
        <obo:OAE_0001849>高乳酸血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020660</obo:OAE_0004334>
        <rdfs:label>hyperlactacidaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006541 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which may cause subcutaneous fat necrosis progression, with subsequent sterile &apos;abscess&apos; formation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7670790/</obo:IAO_0000119>
        <obo:OAE_0001849>高脂肪血症</obo:OAE_0001849>
        <obo:OAE_0004334>10067725</obo:OAE_0004334>
        <rdfs:label>hyperlipasaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006542 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is abnormally elevated levels of any or all lipids (fats, cholesterol, or triglycerides) or lipoproteins in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperlipidemia</obo:IAO_0000119>
        <obo:OAE_0001849>高脂血症</obo:OAE_0001849>
        <obo:OAE_0004334>10062060</obo:OAE_0004334>
        <rdfs:label>hyperlipidaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006543 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>this is an AE which is an electrolyte disorder in which there is an elevated level of phosphate in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperphosphatemia</obo:IAO_0000119>
        <obo:OAE_0001849>高磷酸血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020711</obo:OAE_0004334>
        <rdfs:label>hyperphosphataemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006544 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is closely associated with systemic expression and adverse outcomes (lymphoma development and death) in patients with primary SS.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15381790/</obo:IAO_0000119>
        <obo:OAE_0001849>低补体血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020974</obo:OAE_0004334>
        <rdfs:label>hypocomplementaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006545 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is characterized by an acute hemorrhagic state brought about by inability of the blood to clot, with massive hemorrhages into the skin producing blackish, purplish swellings and sloughing.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrinolysis_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>低纤维蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10051125</obo:OAE_0004334>
        <rdfs:label>hypofibrinogenaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006546 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a problem with the immune system in which not enough gamma globulins are produced in the blood (thus hypo- + gamma + globulin + -emia).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypogammaglobulinemia</obo:IAO_0000119>
        <obo:OAE_0001849>低丙种球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020983</obo:OAE_0004334>
        <rdfs:label>hypogammaglobulinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006547 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is associated with chronic or severe illnesses, and limited nutritional intake, but similar medical problems were absent in the acromegalic patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/955558/</obo:IAO_0000119>
        <obo:OAE_0001849>低球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058002</obo:OAE_0004334>
        <rdfs:label>hypoglobulinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006548 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is the medical condition where there is too much fluid in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypervolemia</obo:IAO_0000119>
        <obo:OAE_0001849>高容量血症</obo:OAE_0001849>
        <obo:OAE_0004334>10020919</obo:OAE_0004334>
        <rdfs:label>hypervolaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006549 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a rare condition and it can be caused by a genetic alteration or secondary factors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32430154/</obo:IAO_0000119>
        <obo:OAE_0001849>低脂血症</obo:OAE_0001849>
        <obo:OAE_0004334>10021024</obo:OAE_0004334>
        <rdfs:label>hypolipidaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006550 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a condition where there is an abnormally low level of protein in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoproteinemia</obo:IAO_0000119>
        <obo:OAE_0001849>低蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10021083</obo:OAE_0004334>
        <rdfs:label>hypoproteinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006551 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001217"/>
        <obo:IAO_0000115>This is an AE which may be the result of a low-grade, chronic inflammatory process with an abnormal excessive production of myelosuppressive cytokines in a study conducted in the island of Crete.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neutropenia?wprov=srpw1_0#Pathophysiology</obo:IAO_0000119>
        <obo:OAE_0001849>特发性嗜中性白血球减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10051645</obo:OAE_0004334>
        <rdfs:label>idiopathic neutropenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006552 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a biological role of human leucocyte lactotransferrin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2390069/</obo:IAO_0000119>
        <obo:OAE_0001849>低铁血症</obo:OAE_0001849>
        <obo:OAE_0004334>10053782</obo:OAE_0004334>
        <rdfs:label>hyposideraemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006553 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by klebsiella bacteria that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>克雷伯氏菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10054160</obo:OAE_0004334>
        <rdfs:label>klebsiella sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006554 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a complex of little prolactin and an immunoglobulin G antibody and the weight of the complex is more than 150 kDa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20712249/</obo:IAO_0000119>
        <obo:OAE_0001849>巨泌乳素血症</obo:OAE_0001849>
        <obo:OAE_0004334>10078846</obo:OAE_0004334>
        <rdfs:label>macroprolactinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006555 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is infections present in the blood caused by pneumococcal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bloodstream_infections</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎球菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058859</obo:OAE_0004334>
        <rdfs:label>pneumococcal bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006556 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by stenotrophomonas that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>狭养单胞菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10054137</obo:OAE_0004334>
        <rdfs:label>stenotrophomonas sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006557 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which caused by the Streptococcus pneumoniae bacteria, has been reported to cause autosplenectomy but is a very rare and poorly understood complication of the infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autosplenectomy#Pneumococcal_sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>肺炎球菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10054047</obo:OAE_0004334>
        <rdfs:label>pneumococcal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006558 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is infections present in the blood caused by pseudomonal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bloodstream_infections</obo:IAO_0000119>
        <obo:OAE_0001849>假单胞菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058923</obo:OAE_0004334>
        <rdfs:label>pseudomonal bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006559 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition caused by pseudomonal that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>败血症假单胞菌</obo:OAE_0001849>
        <obo:OAE_0004334>10058877</obo:OAE_0004334>
        <rdfs:label>pseudomonal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006560 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is a common, and frequently fatal, cause of bacteraemia in children and HIVinfected adults in sub-Saharan Africa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29523850/</obo:IAO_0000119>
        <obo:OAE_0001849>沙门氏菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058924</obo:OAE_0004334>
        <rdfs:label>salmonella bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006561 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a rare cause of neonatal sepsis and can present with life threating complications, thus leading to increase in neonatal mortality and morbidity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31043097/</obo:IAO_0000119>
        <obo:OAE_0001849>沙门氏菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058878</obo:OAE_0004334>
        <rdfs:label>salmonella sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006562 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a type of neonatal infection and specifically refers to the presence in a newborn baby of a bacterial blood stream infection (BSI) (such as meningitis, pneumonia, pyelonephritis, or gastroenteritis) in the setting of fever.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10040049</obo:OAE_0004334>
        <rdfs:label>sepsis neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006563 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which including fever, leukocytosis, elevated cardiac output, and reduced systemic vascular resistance has been associated with severe infection (i.e., sepsis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10695741/</obo:IAO_0000119>
        <obo:OAE_0001849>败血症综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10053879</obo:OAE_0004334>
        <rdfs:label>sepsis syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006564 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is frequent in neutropenic patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7783538/</obo:IAO_0000119>
        <obo:OAE_0001849>链球菌菌血症</obo:OAE_0001849>
        <obo:OAE_0004334>10051018</obo:OAE_0004334>
        <rdfs:label>streptococcal bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006565 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a form of hypogammaglobulinemia appearing after birth, leading to a reduction in the level of IgG, and also sometimes IgA and IgM.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transient_hypogammaglobulinemia_of_infancy</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿暂时性低丙种球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10044388</obo:OAE_0004334>
        <rdfs:label>transient hypogammaglobulinaemia of infancy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006566 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which refers to most common presenting symptoms or signs were of skin rash, cellulitis or abscess.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30287447/</obo:IAO_0000119>
        <obo:OAE_0001849>链球菌败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10048960</obo:OAE_0004334>
        <rdfs:label>streptococcal sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006567 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is an error of metabolism, usually inborn, in which the body cannot effectively break down the amino acid tyrosine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tyrosinemia</obo:IAO_0000119>
        <obo:OAE_0001849>酪氨酸血症</obo:OAE_0001849>
        <obo:OAE_0004334>10063443</obo:OAE_0004334>
        <rdfs:label>tyrosinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006568 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000115>This is an AE which is a medical condition where viruses enter the bloodstream and hence have access to the rest of the body and is similar to bacteremia, a condition where bacteria enter the bloodstream.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Viremia</obo:IAO_0000119>
        <obo:OAE_0001849>病毒血症</obo:OAE_0001849>
        <obo:OAE_0004334>10058874</obo:OAE_0004334>
        <rdfs:label>viraemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006569 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is caused by many  viruses and is a life-threatening condition that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10071362</obo:OAE_0004334>
        <rdfs:label>viral sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006570 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of cancer affecting two types of B cells: lymphoplasmacytoid cells and plasma cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Waldenstr%C3%B6m%27s_macroglobulinemia</obo:IAO_0000119>
        <obo:OAE_0001849>瓦尔登斯特伦巨球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10047801</obo:OAE_0004334>
        <rdfs:label>waldenstrom&apos;s macroglobulinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006571 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000618"/>
        <obo:IAO_0000115>This is an AE which is a life-threatening condition occued on post procedural that arises when the body&apos;s response to infection causes injury to its own tissues and organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sepsis</obo:IAO_0000119>
        <obo:OAE_0001849>手术后败血症</obo:OAE_0001849>
        <obo:OAE_0004334>10066593</obo:OAE_0004334>
        <rdfs:label>post procedural sepsis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006572 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a rare malignancy derived from plasmacyoid dendritic cells .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30350260/</obo:IAO_0000119>
        <obo:OAE_0001849>母细胞浆细胞样树突状细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10075460</obo:OAE_0004334>
        <rdfs:label>blastic plasmacytoid dendritic cell neoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006573 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>幼淋巴细胞白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10036888</obo:OAE_0004334>
        <rdfs:label>prolymphocytic leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006574 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>B前体型急性白血病</obo:OAE_0001849>
        <obo:OAE_0004334>10003890</obo:OAE_0004334>
        <rdfs:label>b precursor type acute leukaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006575 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>冷球蛋白血症</obo:OAE_0001849>
        <obo:OAE_0004334>10062714</obo:OAE_0004334>
        <rdfs:label>dysglobulinaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006576 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>低钠血症</obo:OAE_0001849>
        <obo:OAE_0004334>10077515</obo:OAE_0004334>
        <rdfs:label>hyponatriuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006577 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>黑色素血症，血色沉着病</obo:OAE_0001849>
        <obo:OAE_0004334>10054978</obo:OAE_0004334>
        <rdfs:label>melanemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006578 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a rare complication after endoscopic retrograde cholangiopancreatography (ERCP).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27158211/</obo:IAO_0000119>
        <obo:OAE_0001849>肝血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10019676</obo:OAE_0004334>
        <rdfs:label>hepatic hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006579 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000468"/>
        <obo:IAO_0000115>This is an AE which is a yellowish or greenish pigmentation of the skin and whites of the eyes due to high bilirubin levels and is acholuric.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Jaundice</obo:IAO_0000119>
        <obo:OAE_0001849>无胆色素尿性黄疸</obo:OAE_0001849>
        <obo:OAE_0004334>10023128</obo:OAE_0004334>
        <rdfs:label>jaundice acholuric AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006580 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by the hepatitis B virus (HBV) that affects the liver on the perinatal .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis_B</obo:IAO_0000119>
        <obo:OAE_0001849>围产期乙型肝炎病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10075233</obo:OAE_0004334>
        <rdfs:label>perinatal hbv infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006581 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is the process of using one&apos;s hands to check the body such as liver, especially while perceiving/diagnosing a disease or illness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palpation</obo:IAO_0000119>
        <obo:OAE_0001849>肝脏可触及</obo:OAE_0001849>
        <obo:OAE_0004334>10075895</obo:OAE_0004334>
        <rdfs:label>liver palpable AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006582 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001034"/>
        <obo:IAO_0000115>This is an AE which management aims to control viral replication, which is correlated with progression of disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hepatitis#Hepatitis_B_4</obo:IAO_0000119>
