        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is the lower part of the uterus (womb) in the human female reproductive system and is shortened.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cervix</obo:IAO_0000119>
        <obo:OAE_0001849>缩短的子宫颈</obo:OAE_0001849>
        <obo:OAE_0004334>10067726</obo:OAE_0004334>
