        <rdfs:label>dysacusis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005973 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>This is an AE which may be present at birth or acquired at any time afterwards.</obo:IAO_0000115>
