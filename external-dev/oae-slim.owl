    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005776 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001136"/>
        <obo:IAO_0000115>This is an AE which is the part of the throat behind the mouth and nasal cavity and it is swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pharynx</obo:IAO_0000119>
        <obo:OAE_0001849>口咽肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10031118</obo:OAE_0004334>
