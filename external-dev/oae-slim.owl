        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000625"/>
        <obo:IAO_0000115>This is an AE which is inflammation of a ulnar nerve or the general inflammation of the peripheral ulnar nervous system.</obo:IAO_0000115>
