        <rdfs:label xml:lang="en">neurological deficit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002562 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>An abscess AE that is caused by an Staphylococcus aureus infection.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>abscess</obo:IAO_0000118>
        <obo:IAO_0000119>http://medical-dictionary.thefreedictionary.com/staphylococcal+abscess</obo:IAO_0000119>
        <obo:OAE_0004334>10041917</obo:OAE_0004334>
        <rdfs:label xml:lang="en">staphylococcal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002563 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>An eye AE that results in an intermittent or constant misalignment of an eye so that its line of vision is not pointed at the same object. Strabismus is caused by an imbalance in the extraocular muscles which control the positioning of the eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>cross-eyed</obo:IAO_0000118>
        <obo:IAO_0000118>heterotropia</obo:IAO_0000118>
        <obo:IAO_0000118>wall-eyed</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Strabismus</obo:IAO_0000119>
        <obo:OAE_0004334>10042159</obo:OAE_0004334>
        <rdfs:label xml:lang="en">strabismus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002564 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001502"/>
        <obo:IAO_0000115>A vein discoloration AE that has an outcome of local dilatation of small vessels resulting in red discoloration of the skin or mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.wikipedia.org/wiki/Telangiectasia</obo:IAO_0000119>
        <obo:OAE_0004334>10043189</obo:OAE_0004334>
        <rdfs:label xml:lang="en">telangiectasia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13740</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C28194</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C28194</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002565 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <obo:IAO_0000115>A muscle spasm AE that results in the lack of ability to open the mouth fully due to decreased range of motion of the muscles of mastication.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=40739</obo:IAO_0000119>
        <obo:OAE_0004334>10044684</obo:OAE_0004334>
