        <rdfs:seeAlso>CTCAE:E12541</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78651</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002566 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>A bacterial infection AE with an outcome of thypoid fever, a bacterial infectious disorder caused by the Salmonella typhi bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>tyhpoid</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.webmd.com/a-to-z-guides/typhoid-fever</obo:IAO_0000119>
        <obo:OAE_0004334>10045275</obo:OAE_0004334>
