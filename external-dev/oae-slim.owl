        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <obo:IAO_0000115>This is an AE which is a bleeding into the brain&apos;s ventricular system, where the cerebrospinal fluid is produced and circulates through towards the subarachnoid space.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
