        <obo:OAE_0004334>10059625</obo:OAE_0004334>
        <rdfs:label>abdominal wall disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004594 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a abdominal wall  bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken abdominal wall  capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
