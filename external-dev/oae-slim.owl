    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005108 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <obo:IAO_0000115>This is an AE which is any cardiovascular disease process involving one or more of the four valves of the heart (the aortic and mitral valves on the left side of heart and the pulmonic and tricuspid valves on the right side of heart).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Valvular_heart_disease</obo:IAO_0000119>
        <obo:OAE_0001849>心脏瓣膜赘生物</obo:OAE_0001849>
        <obo:OAE_0004334>10057651</obo:OAE_0004334>
        <rdfs:label>cardiac valve vegetation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005109 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which are systemic diseases frequently affecting the heart and vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32883041/</obo:IAO_0000119>
        <obo:OAE_0001849>风湿性心包炎</obo:OAE_0001849>
