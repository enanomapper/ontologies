    <!-- http://purl.obolibrary.org/obo/OAE_0000521 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115 xml:lang="en">a muscle adverse event which has an outcome of muscle spasm, which is an involuntary and often painful muscle contraction or cramps having a number of causes ranging from nutritional deficiency to serious nervous system conditions</obo:IAO_0000115>
        <obo:IAO_0000117>SS, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0004334>10028334</obo:OAE_0004334>
        <rdfs:label>muscle spasm AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000743</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000522 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>a connective tissue disorder AE that occurs at the location of tendon</obo:IAO_0000115>
        <obo:IAO_0000116>A tendon (or sinew) is a tough band of fibrous connective tissue that usually connects muscle to bone and is capable of withstanding tension.</obo:IAO_0000116>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;tendon disorder&apos;; is an adverse event that was mentioned in 137 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:comment>Tendon disorder is a medical condition that results in a tendon not functioning normally.</rdfs:comment>
        <rdfs:label>tendon disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000523 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
