        <obo:OAE_0004334>10007522</obo:OAE_0004334>
        <rdfs:label>cardiac asthma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005145 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000019"/>
        <obo:IAO_0000115>This is an AE which is an injury to the heart as the result of blunt trauma, typically to the anterior chest wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blunt_cardiac_injury</obo:IAO_0000119>
