    <!-- http://purl.obolibrary.org/obo/OAE_0001530 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115 xml:lang="en">A groupd of disroders where the genetic susceptibility plays an important role to the seletctive susceptibility to poorly pathogenic mycobacterial species such as bacille Calmette-Guérin and environmental mycobacteria.</obo:IAO_0000115>
