        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Anorectal+Disorders</obo:IAO_0000119>
        <obo:OAE_0004334>10002644</obo:OAE_0004334>
        <rdfs:label xml:lang="en">anorectal disorder AE</rdfs:label>
