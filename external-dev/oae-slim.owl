    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004739 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001214"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor that develops on the vestibulocochlear nerve that passes from the inner ear to the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vestibular_schwannoma</obo:IAO_0000119>
