    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008025 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a disorder characterized by catching or locking of the involved finger.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trigger_finger</obo:IAO_0000119>
        <obo:OAE_0001849>扳机指</obo:OAE_0001849>
        <obo:OAE_0004334>10044654</obo:OAE_0004334>
        <rdfs:label>trigger finger AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008026 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002733"/>
        <obo:IAO_0000115>This is an AE whcih is a very rare medical syndrome that includes pleural effusions, lymphedema (due to under development of the lymphatic vessels) and yellow dystrophic nails.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Yellow_nail_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>黄指甲综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10048244</obo:OAE_0004334>
        <rdfs:label>yellow nail syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008027 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a medical condition that causes one or more fingers to be permanently bent and is acquired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Camptodactyly</obo:IAO_0000119>
        <obo:OAE_0001849>屈曲指收购</obo:OAE_0001849>
        <obo:OAE_0004334>10049132</obo:OAE_0004334>
        <rdfs:label>camptodactyly acquired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008028 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which refers to  a congenital deformity involving one foot or both , a relatively short and round thumb with an accompanying wide nail bed or a deformity of the fingers and fingernails.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Clubbing</obo:IAO_0000119>
        <obo:OAE_0001849>杵状指</obo:OAE_0001849>
        <obo:OAE_0004334>10009691</obo:OAE_0004334>
        <rdfs:label>clubbing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008029 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is inflammation of an entire digit (a finger or toe),and can be painful.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dactylitis</obo:IAO_0000119>
        <obo:OAE_0001849>指炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064769</obo:OAE_0004334>
        <rdfs:label>dactylitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008032 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of a body part or organ compared to the normal shape of that part such as finger.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>手指畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061156</obo:OAE_0004334>
        <rdfs:label>finger deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008033 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the bones and is a rare disease in which the outer part of the shafts of long bones is thinner than normal and there is an increased chance of fractures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metaphyseal_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>口指面骨发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10066147</obo:OAE_0004334>
        <rdfs:label>metaphyseal dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008034 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the nail.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>指甲萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10068058</obo:OAE_0004334>
        <rdfs:label>nail atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008035 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a collection of blood (hematoma) underneath a toenail or fingernail (subungal hematoma).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subungual_hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>甲床出血</obo:OAE_0001849>
        <obo:OAE_0004334>10048891</obo:OAE_0004334>
        <rdfs:label>nail bed bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008036 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which refers to the skin beneath the nail plate is disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nail_bed</obo:IAO_0000119>
        <obo:OAE_0001849>甲床疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10070533</obo:OAE_0004334>
        <rdfs:label>nail bed disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008037 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001203"/>
        <obo:IAO_0000115>This is an AE which refers onychomycosis or tinea unguium, is a fungal infection of the nail.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Onychomycosis</obo:IAO_0000119>
        <obo:OAE_0001849>甲床感染</obo:OAE_0001849>
        <obo:OAE_0004334>10067867</obo:OAE_0004334>
        <rdfs:label>nail bed infection fungal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008038 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004330"/>
        <obo:IAO_0000115>This is an AE which is a disease or deformity of the nail.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nail_disease</obo:IAO_0000119>
        <obo:OAE_0001849>甲营养不良</obo:OAE_0001849>
        <obo:OAE_0004334>10028698</obo:OAE_0004334>
        <rdfs:label>nail dystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008039 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which occurs by alteration of shape, partial loss, or absence of the nail, resulting in loss of the nail fold physiological limit.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/34604327/</obo:IAO_0000119>
        <obo:OAE_0001849>指甲肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10028700</obo:OAE_0004334>
        <rdfs:label>nail hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which can cause the nail plate to be torn from the nail bed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Avulsion_injury</obo:IAO_0000119>
        <obo:OAE_0001849>指甲受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10068655</obo:OAE_0004334>
        <rdfs:label>nail injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008041 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a much less frequent cause of brown-black nail color than other melanocytic and nonmelanocytic pigmentations, which include subungual hematoma, exogenous pigmentations, and melanonychia due to benign conditions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25828711/</obo:IAO_0000119>
        <obo:OAE_0001849>指甲色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10058455</obo:OAE_0004334>
        <rdfs:label>nail pigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008042 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is a form of extremely localized corrosion that leads to the creation of small holes in the metal on the nail.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pitting_corrosion</obo:IAO_0000119>
        <obo:OAE_0001849>指甲凹陷</obo:OAE_0001849>
        <obo:OAE_0004334>10028702</obo:OAE_0004334>
        <rdfs:label>nail pitting AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008043 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is an anomaly in humans and animals resulting in supernumerary fingers and/or toes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polydactyly</obo:IAO_0000119>
        <obo:OAE_0001849>多指多趾</obo:OAE_0001849>
        <obo:OAE_0004334>10036063</obo:OAE_0004334>
        <rdfs:label>polydactyly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008044 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001086"/>
        <obo:IAO_0000115>This is an AE which is a nail disease that can be a sign of hypochromic anemia, especially iron-deficiency anemia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Koilonychia</obo:IAO_0000119>
        <obo:OAE_0001849>凹甲</obo:OAE_0001849>
        <obo:OAE_0004334>10054999</obo:OAE_0004334>
        <rdfs:label>koilonychia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008045 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000201"/>
        <obo:IAO_0000115>This is an AE which is less common and typically more severe than hammer toe.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30309185/</obo:IAO_0000119>
        <obo:OAE_0001849>获得性爪趾</obo:OAE_0001849>
        <obo:OAE_0004334>10057689</obo:OAE_0004334>
        <rdfs:label>acquired claw toe AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008047 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which refers to a condition where a person walks on their toes without putting much or any weight on the heel or any other part of the foot.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Toe_walking</obo:IAO_0000119>
        <obo:OAE_0001849>脚趾走路</obo:OAE_0001849>
        <obo:OAE_0004334>10068872</obo:OAE_0004334>
        <rdfs:label>toe walking AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008048 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
