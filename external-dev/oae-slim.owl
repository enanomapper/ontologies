        <rdfs:seeAlso>HPO: HP_0004942</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003486</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001756 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001753"/>
        <obo:IAO_0000115>an aneurysm ruptured AE that occurs in the aorta</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>ruptured aortic aneurysm AE</obo:IAO_0000118>
        <obo:OAE_0004334>10002886</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aortic aneurysm rupture AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002622</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0741160</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001757 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <obo:IAO_0000115>an aortic disorder AE in which there is a separation of the aorta walls. The small tear can become larger. It can lead to bleeding into and along the wall of the aorta, the major artery carrying blood out of the heart.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000181.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10002895</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aortic dissection AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004933</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0340643</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001758 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001753"/>
        <obo:IAO_0000115>an aneurysm ruptured AE that occurs in the brain where blood spurts into the subarachnoid space under arterial pressure, continuing until increased local or generalized intracranial pressure stops the bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://ether.stanford.edu/library/neuroanesthesia/Journal%20Articles/Ruptured%20cerebral%20aneurysms.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/15647574</obo:IAO_0000119>
        <obo:OAE_0004334>10039330</obo:OAE_0004334>
        <rdfs:label xml:lang="en">ruptured cerebral aneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001759 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>an aneurysm AE that occurs in the brain</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>brain aneurysm AE</obo:IAO_0000118>
        <obo:IAO_0000118>cerebral aneurysm AE</obo:IAO_0000118>
        <obo:IAO_0000118>intracerebral aneurysm AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.ninds.nih.gov/disorders/cerebral_aneurysm/detail_cerebral_aneurysms.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10022758</obo:OAE_0004334>
        <rdfs:label xml:lang="en">intracranial aneurysm AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004944</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007766</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001760 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004574"/>
        <obo:IAO_0000115>a thrombosis AE that is a rare lesion and may be defined as a thrombosis of a vessel without any obvious underlying cause that occurs in the aorta</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://circ.ahajournals.org/content/17/5/941.full.pdf</obo:IAO_0000119>
        <obo:OAE_0004334>10002910</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aortic thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001761 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000318"/>
        <obo:IAO_0000115>an arterial thrombosis AE that is characterized by the occurrence of a thrombus in the carotid arteries (two large blood vessels that supply oxygenated blood to the large, front part of the brain)</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.webmd.com/heart-disease/carotid-artery-disease-causes-symptoms-tests-and-treatment</obo:IAO_0000119>
        <obo:OAE_0004334>10007688</obo:OAE_0004334>
        <rdfs:label xml:lang="en">carotid artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001762 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <obo:IAO_0000115>an arterial embolism AE that occurs in the cerebral artery</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>cerebral embolism AE</obo:IAO_0000118>
        <obo:IAO_0000118>embolic stroke AE</obo:IAO_0000118>
        <obo:IAO_0000118>thrombotic stroke AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/cerebral+embolism</obo:IAO_0000119>
        <obo:OAE_0004334>10008088</obo:OAE_0004334>
        <obo:OAE_0004334>10014498</obo:OAE_0004334>
        <obo:OAE_0004334>10043647</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cerebral artery embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001763 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004573"/>
        <obo:IAO_0000115>an arterial thrombosis AE that occurs in the cerebral artery, also referred to as an embolism AE</obo:IAO_0000115>
        <obo:IAO_0000116>[SS] Per DRA and KKB&apos;s comment, this term may also be characterized as a type of embolism even though labeled thrombosis.</obo:IAO_0000116>
        <obo:IAO_0000118>cerebral thrombosis AE</obo:IAO_0000118>
        <obo:OAE_0004334>10008092</obo:OAE_0004334>
        <obo:OAE_0004334>10008132</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cerebral artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001764 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004573"/>
        <obo:IAO_0000115>a venous thrombosis AE that is characterized by thrombosis of the venous channels in the brain. It is an uncommon cause of cerebral infarction relative to arterial disease, but it is an important consideration because of its potential morbidity.</obo:IAO_0000115>
        <obo:IAO_0000116>[SS] From http://medical-dictionary.thefreedictionary.com/cerebral+venous+thrombosis, Merwarth syndrome - progressive hemiplegia due to venous occlusion. Synonym(s): cerebral venous thrombosis</obo:IAO_0000116>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/1162804-overview</obo:IAO_0000119>
        <obo:OAE_0004334>10008138</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cerebral venous thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001765 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004573"/>
        <obo:IAO_0000115>a venous thrombosis AE that occurs when a blood clot forms in the brain’s venous sinuses that prevents blood from draining out of the brain. As a result, blood cells may break and leak blood into the brain tissues, forming a hemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>CVST</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/cerebral_venous_sinus_thrombosis_134,69/</obo:IAO_0000119>
        <obo:OAE_0004334>10061251</obo:OAE_0004334>
        <rdfs:label xml:lang="en">intracranial venous sinus thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001766 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>an embolism AE that is caused by a gas bubble that enters the vein</obo:IAO_0000115>
        <obo:IAO_0000116>[SS] The term &apos;gas embolism&apos; is listed as a unique term, and not a superset or a synonym of &apos;air embolism&apos; due to the different pathology reconized by physicians that air embolism is mostly recognized when an air bubble caused by IV or other injection device enters the vein, while a gas embolism is mostly caused by a gas bubble released as a product of an infection, or other devices such as nitrogen tank.</obo:IAO_0000116>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <rdfs:label>gas embolilsm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001767 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004583"/>
        <obo:IAO_0000115>a thrombosis that is characterized by a clot that blocks blood flow a mesenteric vein, one of two veins through which blood leaves the intestine. The condition interrupts the blood supply to the intestine and can result in damage to the intestines.</obo:IAO_0000115>
        <obo:IAO_0000116>[SS] http://emedicine.medscape.com/article/193921-overview, Mesenteric venous thrombosis (also known as visceral venous thrombosis) is a rare but lethal form of mesenteric ischemia (see the image below). Antonio Hodgson first described mesenteric ischemia in the latter part of the 15th century. In 1895, Elliot first described mesenteric venous thrombosis as a cause of mesenteric ischemia. By the turn of the 19th century, many review articles and texts were describing the recent advances in the characterization and treatment of mesenteric ischemia, particularly venous thrombosis. In 1935, Warren and Eberhard reported that intestinal infarction resulted from ischemia due to venous thrombosis, and they reported a mortality rate of 34% in patients with venous thrombosis after resection. Unfortunately, despite improvements in therapy, this mortality rate still holds.
</obo:IAO_0000116>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>mesenteric venous thrombosis AE</obo:IAO_0000118>
        <obo:IAO_0000118>visceral venous thrombosis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001157.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10027402</obo:OAE_0004334>
        <rdfs:label xml:lang="en">mesenteric vein thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001768 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000115>a thrombosis AE that is an uncommon condition induced by thrombotic or nonthrombotic obstruction of hepatic venous outflow and characterized by hepatomegaly, ascites, and abdominal pain.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/184430-overview</obo:IAO_0000119>
        <obo:OAE_0004334>10006537</obo:OAE_0004334>
        <rdfs:label xml:lang="en">Budd-Chiari syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001769 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004545"/>
        <obo:IAO_0000115>a thrombosis AE that occurs in the vein carrying the blood away from the retina</obo:IAO_0000115>
        <obo:IAO_0000116>[SS] The term &apos;retinal vein thrombosis&apos; is listed as a different class from &apos;retinal vein occlusion&apos; for the difference in the pathological process of how the blockage occurs in the vein.</obo:IAO_0000116>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:OAE_0004334>10038908</obo:OAE_0004334>
        <rdfs:label>retinal vein thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001771 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>an embolism AE that occurs in the artery. It is a sudden interruption of blood flow to an organ or body part due to a clot (embolus).</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>embolism arterial AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001102.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10014513</obo:OAE_0004334>
        <rdfs:label xml:lang="en">arterial embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001772 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>a thrombosis AE* that is a result of when a blood vessel is obstructed by a blood clot (embolus) that has been carried in the bloodstream from the site of its formation. Thromboembolic disease includes both venous thromboembolism (VTE) and arterial thrombosis. VTE is an general term which refers to mainly two conditions: deep vein thrombosis (DVT) and its potentially fatal acute complication, pulmonary embolism (PE). Arterial embolism is a frequent complication in patients with atrial fibrillation (AF) and can lead to stroke or systemic embolism.

* see editor note</obo:IAO_0000115>
        <obo:IAO_0000116>[SS] Per DRA and KKB&apos;s comment, this term is synonymous to venous thrombosis even though labeled embolism. Cross-reference is made via seeAlso.</obo:IAO_0000116>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>VTE</obo:IAO_0000118>
        <obo:IAO_0000118>embolism venous AE</obo:IAO_0000118>
        <obo:IAO_0000118>venous thromboembolism AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.boehringer-ingelheim.com/products/prescription_medicines/thromboembolic_diseases.html</obo:IAO_0000119>
        <obo:OAE_0004334>10014522</obo:OAE_0004334>
        <rdfs:label xml:lang="en">venous embolism AE</rdfs:label>
        <rdfs:seeAlso>OAE: 0001505</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001773 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>an embolism AE that is characterized by the obstruction of blood vessel by fat droplets</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/460524-overview#showall</obo:IAO_0000119>
        <obo:OAE_0004334>10016246</obo:OAE_0004334>
        <rdfs:label xml:lang="en">fat embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001774 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>a embolism AE that is infected with bacteria containing pus</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>septic embolism AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.medicalnewstoday.com/articles/153704.php</obo:IAO_0000119>
        <obo:OAE_0004334>10040067</obo:OAE_0004334>
        <rdfs:label xml:lang="en">septic embolus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001775 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000115>a thrombosis AE that occurs in or may be caused by an implanted device in the body</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:OAE_0004334>10062546</obo:OAE_0004334>
        <rdfs:label xml:lang="en">thrombosis in device AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001777 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000318"/>
        <obo:IAO_0000115>an arterial thrombosis AE that occurs in the limb(s) of the body</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:OAE_0004334>10003180</obo:OAE_0004334>
        <rdfs:label xml:lang="en">arterial thrombosis limb AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001778 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>an inflammation AE that occurs in eye.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, JX</obo:IAO_0000117>
        <rdfs:label xml:lang="en">eye inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001779 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:OAE_0004334>10022104</obo:OAE_0004334>
        <rdfs:label xml:lang="en">injection site thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001780 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000861"/>
        <obo:IAO_0000115>a deep vein thrombosis AE that occurs in the pelvis. Ovarian vein thrombosis arises out of the coincident conditions of venous stasis and hypercoagulability, which are commonly present in the recently postpartum patient.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>ovarian vein thrombosis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/404364-overview</obo:IAO_0000119>
        <obo:OAE_0004334>10034272</obo:OAE_0004334>
        <rdfs:label xml:lang="en">pelvic venous thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001781 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>an embolism AE that is charaterized by a sudden blockage in a lung artery. The blockage usually is caused by a blood clot that travels to the lung from a vein in the leg.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>PE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health/health-topics/topics/pe/</obo:IAO_0000119>
        <obo:OAE_0004334>10061340</obo:OAE_0004334>
        <rdfs:label xml:lang="en">peripheral embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001782 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004582"/>
        <obo:IAO_0000115>a thrombosis AE that occurs in subclavian vein. Among patients with effort-induced thrombosis with subclavian vein stenosis, the thrombosis occurs in the dominant arm in 80% of cases.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/424777-overview#showall</obo:IAO_0000119>
        <obo:OAE_0004334>10049446</obo:OAE_0004334>
        <rdfs:label xml:lang="en">subclavian vein thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001783 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001449"/>
        <obo:IAO_0000115>a thrombophlebitis AE that is characterized by an inflammation of a vein due to a blood clot in a vein located just below the skin&apos;s surface.</obo:IAO_0000115>
        <obo:IAO_0000116>YH: MedDRA: 10043595 is for &quot;thrombophlebitis superficial&quot;; MedDRA: 10042554 is for &quot;superficial thrombophlebitis&quot;</obo:IAO_0000116>
        <obo:IAO_0000117>SS, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>thrombophlebitis superficial AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000199.htm</obo:IAO_0000119>
        <obo:OAE_0001849>表在性血栓性静脈炎</obo:OAE_0001849>
        <rdfs:label xml:lang="en">superficial thrombophlebitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13817</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78634</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS CUI: C1510431</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001784 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:OAE_0004334>10061408</obo:OAE_0004334>
        <rdfs:label xml:lang="en">venous thrombosis limb AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001785 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>a thrombosis that is characterized by a blockage of the small veins that carry blood away from the retina. The retina is the layer of tissue at the back of the inner eye that converts light images to nerve signals and sends them to the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>RVO</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/007330.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10038907</obo:OAE_0004334>
        <rdfs:label xml:lang="en">retinal vein occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001786 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004574"/>
        <obo:IAO_0000115>a thrombosis AE that occurs in the atrium (left or right)</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://ehjcimaging.oxfordjournals.org/content/9/1/204.full</obo:IAO_0000119>
        <obo:OAE_0004334>10048632</obo:OAE_0004334>
        <rdfs:label xml:lang="en">atrial thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001787 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000318"/>
        <obo:IAO_0000115>an arterial thrombosis AE that occurs in the coronary artery</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>coronary embolism AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Coronary+embolism</obo:IAO_0000119>
        <obo:OAE_0004334>10011084</obo:OAE_0004334>
        <obo:OAE_0004334>10011091</obo:OAE_0004334>
        <rdfs:label xml:lang="en">coronary artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001790 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>a brain AE that occurs when flow of oxygen-rich blood to a portion of the brain is blocked</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>cardiovascular accident AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Stroke</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health/health-topics/topics/stroke/</obo:IAO_0000119>
        <obo:OAE_0001849>中风</obo:OAE_0001849>
        <obo:OAE_0004334>10042244</obo:OAE_0004334>
        <rdfs:label>stroke AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12826</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C3390</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001791 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <obo:IAO_0000115>a stroke AE that occurs when a blood vessel that supplies the brain becomes blocked or &quot;clogged&quot; and impairs blood flow to part of the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>ischaemic stroke AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo:IAO_0000119>
        <obo:OAE_0004334>10061256</obo:OAE_0004334>
        <rdfs:label xml:lang="en">ischemic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001792 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <obo:IAO_0000115>a stroke AE that occurs when a blood vessel that supplies the brain ruptures and bleeds causing the deficiency of oxygen and nutrients to brain cells and tissues</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>haemorrhagic stroke AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo:IAO_0000119>
        <obo:OAE_0004334>10019016</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hemorrhagic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001793 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001792"/>
        <obo:IAO_0000115>a haemorrhagic stroke AE that is cuased by hypertension (high blood pressure), and bleeding occurs suddenly and rapidly.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>intracerebral haemorrhagic stroke AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">intracerebral hemorrhagic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001794 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001792"/>
        <obo:IAO_0000115>a haemorrhagic stroke AE that is cuased by the bleeding (haemorrhage) between the brain and the meninges (the membrane that covers the brain) in the subarachnoid space.</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000118>subarachnoid haemorrhagic stroke AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">subarachnoid hemorrhagic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001795 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <obo:IAO_0000115>an ischaemic stroke AE that is caused by a thrombus (blood clot) that develops in the arteries supplying blood to the brain</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo:IAO_0000119>
        <obo:OAE_0004334>10043647</obo:OAE_0004334>
        <rdfs:label xml:lang="en">thrombotic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001796 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <obo:IAO_0000115>an ischaemic stroke AE that is caused by an embolus (a blood clot that formms elsewhere in the body and travels through the bloodstream to the brain).</obo:IAO_0000115>
        <obo:IAO_0000117>SS</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo:IAO_0000119>
        <obo:OAE_0004334>10014498</obo:OAE_0004334>
        <rdfs:label xml:lang="en">embolic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001797 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>a behavior and neurological AE that has an outcome of a mental illness or psychiatiric disorder. The mental illness is a mental or behavioral pattern or anomaly that causes either suffering or an impaired ability to function in ordinary life (disability), and which is not developmentally or socially normative.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">mental disorder AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Mental_disorder</obo:IAO_0000119>
        <obo:OAE_0004334>10037175</obo:OAE_0004334>
        <rdfs:label>psychiatric disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001798 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that has an outcome of a adjustment disorder. An adjustment disorder is an unexpectedly strong emotional or behavioral reaction that occurs in response to an identifiable stressful life event or life change that occurred within the previous three months.</obo:IAO_0000115>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthline.com/health/adjustment-disorder</obo:IAO_0000119>
        <obo:OAE_0004334>10001301</obo:OAE_0004334>
        <obo:OAE_0004334>10001302</obo:OAE_0004334>
        <rdfs:label xml:lang="en">adjustment disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001799 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001798"/>
        <obo:IAO_0000115>an adjustment disorder AE that has an additional depressed mood. The person is more depressed than would be expected after a stressful event.</obo:IAO_0000115>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.summitmedicalgroup.com/library/adult_health/bha_adjustment_disorder_with_depressed_mood/</obo:IAO_0000119>
        <obo:OAE_0004334>10001297</obo:OAE_0004334>
        <rdfs:label xml:lang="en">adjustment disorder with depressed mood AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001800 -->


