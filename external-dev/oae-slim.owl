    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005624 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>This is an AE which should be used to determine if an acute episode of diarrhea is invasive.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1070939/</obo:IAO_0000119>
