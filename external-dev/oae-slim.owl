    <!-- http://purl.obolibrary.org/obo/OAE_0008574 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002534"/>
        <obo:IAO_0000115>This is an AE which is a noncancerous increase in size of the prostate gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_prostatic_hyperplasia</obo:IAO_0000119>
