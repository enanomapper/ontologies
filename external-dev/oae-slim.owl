    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007123 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a blood infection caused by the bacteria Leptospira.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leptospirosis</obo:IAO_0000119>
        <obo:OAE_0001849>钩端螺旋体病</obo:OAE_0001849>
        <obo:OAE_0004334>10024238</obo:OAE_0004334>
        <rdfs:label>leptospirosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007124 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a vector-borne disease caused by infection with certain bacteria in the genus Borrelia, which is transmitted through the bites of lice or soft-bodied ticks (genus Ornithodoros).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Relapsing_fever</obo:IAO_0000119>
        <obo:OAE_0001849>回归热</obo:OAE_0001849>
        <obo:OAE_0004334>10038300</obo:OAE_0004334>
        <rdfs:label>relapsing fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007125 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection of the small intestine by some strains of the bacterium Vibrio cholerae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cholera</obo:IAO_0000119>
        <obo:OAE_0001849>霍乱</obo:OAE_0001849>
        <obo:OAE_0004334>10008631</obo:OAE_0004334>
        <rdfs:label>cholera AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007126 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a near-cosmopolitan zoonosis caused by adult or larval stages of cestodes belonging to the genus Echinococcus (family Taeniidae).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/14575976/</obo:IAO_0000119>
        <obo:OAE_0001849>棘球虫幼病，包虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10014096</obo:OAE_0004334>
        <rdfs:label>echinococciasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007127 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a tick-borne viral haemorrhagic fever endemic to South-western part of India.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kyasanur_Forest_disease</obo:IAO_0000119>
        <obo:OAE_0001849>夸赛纳森林病</obo:OAE_0001849>
        <obo:OAE_0004334>10023505</obo:OAE_0004334>
        <rdfs:label>kyasanur forest disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007128 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which can cause an indolent cellulitis, more commonly in individuals who handle fish and raw meat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erysipeloid</obo:IAO_0000119>
        <obo:OAE_0001849>类丹毒</obo:OAE_0001849>
        <obo:OAE_0004334>10015146</obo:OAE_0004334>
        <rdfs:label>erysipeloid AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007129 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a human parasitic disease caused by the nematode called Strongyloides stercoralis, or sometimes the closely related S.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Strongyloidiasis</obo:IAO_0000119>
        <obo:OAE_0001849>类圆线虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10042254</obo:OAE_0004334>
        <rdfs:label>strongyloidiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007130 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a disease caused by intracellular bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rickettsiosis</obo:IAO_0000119>
        <obo:OAE_0001849>立克次体病</obo:OAE_0001849>
        <obo:OAE_0004334>10061495</obo:OAE_0004334>
        <rdfs:label>rickettsiosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007131 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a viral disease of humans and livestock that can cause mild to severe symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rift_Valley_fever</obo:IAO_0000119>
        <obo:OAE_0001849>裂谷热</obo:OAE_0001849>
        <obo:OAE_0004334>10039143</obo:OAE_0004334>
        <rdfs:label>rift valley fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007132 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a sexually transmitted infection (STI) caused by the bacterium Neisseria gonorrhoeae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gonorrhea</obo:IAO_0000119>
        <obo:OAE_0001849>淋病</obo:OAE_0001849>
        <obo:OAE_0004334>10018612</obo:OAE_0004334>
        <rdfs:label>gonorrhoea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007133 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease that most often results from a scratch or bite of a cat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cat-scratch_disease</obo:IAO_0000119>
        <obo:OAE_0001849>猫抓热</obo:OAE_0001849>
        <obo:OAE_0004334>10007729</obo:OAE_0004334>
        <rdfs:label>cat scratch disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007134 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a tropical parasitic disease caused by Trypanosoma cruzi.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chagas_disease</obo:IAO_0000119>
        <obo:OAE_0001849>美洲锥虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10001935</obo:OAE_0004334>
        <rdfs:label>american trypanosomiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007135 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a rickettsial disease of sheep and cattle characterised by high fever and severe leucopaenia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/6349107/</obo:IAO_0000119>
        <obo:OAE_0001849>蜱传热</obo:OAE_0001849>
        <obo:OAE_0004334>10043841</obo:OAE_0004334>
        <rdfs:label>tick-borne fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007136 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection that produces tissue gas in gangrene.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gas_gangrene</obo:IAO_0000119>
        <obo:OAE_0001849>气性坏疽</obo:OAE_0001849>
        <obo:OAE_0004334>10017737</obo:OAE_0004334>
        <rdfs:label>gas gangrene AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007137 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <obo:IAO_0000115>This is an AE which is when a person is infected with Mycobacterium tuberculosis, but does not have active tuberculosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Latent_tuberculosis</obo:IAO_0000119>
        <obo:OAE_0001849>潜伏性结核</obo:OAE_0001849>
        <obo:OAE_0004334>10065048</obo:OAE_0004334>
        <rdfs:label>latent tuberculosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007138 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000319"/>
        <obo:IAO_0000115>This is an AE which is a variety of influenza caused by viruses adapted to birds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Avian_influenza</obo:IAO_0000119>
        <obo:OAE_0001849>禽流感</obo:OAE_0001849>
        <obo:OAE_0004334>10064097</obo:OAE_0004334>
        <rdfs:label>avian influenza AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007139 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a tick-borne, infectious disease caused by Anaplasma phagocytophilum, an obligate intracellular bacterium that is typically transmitted to humans by ticks of the Ixodes ricinus species complex, including Ixodes scapularis and Ixodes pacificus in North America.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_granulocytic_anaplasmosis</obo:IAO_0000119>
        <obo:OAE_0001849>人类边虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10071038</obo:OAE_0004334>
        <rdfs:label>human anaplasmosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007140 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which caused by avian paramyxovirus serotype 1 (APMV-1) viruses, is included in List A of the Office International des Epizooties.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10935273/</obo:IAO_0000119>
        <obo:OAE_0001849>新城疫</obo:OAE_0001849>
        <obo:OAE_0004334>10029393</obo:OAE_0004334>
        <rdfs:label>newcastle disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007141 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a disease resulting from a group A streptococcus (group A strep) infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scarlet_fever</obo:IAO_0000119>
        <obo:OAE_0001849>猩红热</obo:OAE_0001849>
        <obo:OAE_0004334>10039587</obo:OAE_0004334>
        <rdfs:label>scarlet fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007142 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a form of typhus caused by the intracellular parasite Orientia tsutsugamushi, a Gram-negative α-proteobacterium of family Rickettsiaceae first isolated and identified in 1930 in Japan.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scrub_typhus</obo:IAO_0000119>
        <obo:OAE_0001849>恙虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10039766</obo:OAE_0004334>
        <rdfs:label>scrub typhus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007143 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000319"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by any one of several types of swine influenza viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swine_influenza</obo:IAO_0000119>
        <obo:OAE_0001849>猪流感</obo:OAE_0001849>
        <obo:OAE_0004334>10069500</obo:OAE_0004334>
        <rdfs:label>swine influenza AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007144 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infestation of lice (blood-feeding ectoparasitic insects of the order Phthiraptera).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pediculosis</obo:IAO_0000119>
        <obo:OAE_0001849>虱病</obo:OAE_0001849>
        <obo:OAE_0004334>10024424</obo:OAE_0004334>
        <rdfs:label>lice infestation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007145 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>感染再激活</obo:OAE_0001849>
        <obo:OAE_0004334>10070891</obo:OAE_0004334>
        <rdfs:label>infection reactivation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007146 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the body internal tissue caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>内部损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061245</obo:OAE_0004334>
        <rdfs:label>internal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007147 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which results from damage, wear, or trauma to the bones, muscles, or other tissues of the back.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Back_injury</obo:IAO_0000119>
        <obo:OAE_0001849>背部损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10003986</obo:OAE_0004334>
        <rdfs:label>back injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007148 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000029"/>
        <obo:IAO_0000115>This is an AE which is damage to the bursa caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>囊损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10057602</obo:OAE_0004334>
        <rdfs:label>bursa injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007149 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is two rounded portions of the exterior anatomy of most mammals, located on the posterior of the pelvic region and is injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Buttocks</obo:IAO_0000119>
        <obo:OAE_0001849>臀部损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10078480</obo:OAE_0004334>
        <rdfs:label>buttock injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007150 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a resilient and smooth elastic tissue but is  injury, rubber-like padding that covers and protects the ends of long bones at the joints and nerves, and is a structural component of the rib cage, the ear, the nose, the bronchial tubes, the intervertebral discs, and many other body components.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cartilage</obo:IAO_0000119>
        <obo:OAE_0001849>软骨损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10007710</obo:OAE_0004334>
        <rdfs:label>cartilage injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007151 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which comprises nonfreezing injuries that include chilblain (aka pernio) and trench, or immersion, foot, as well as freezing injuries that affect core body tissues resulting in hypothermia of peripheral tissues, causing frostnip or frostbite.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19056919/</obo:IAO_0000119>
        <obo:OAE_0001849>冷暴露损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10009856</obo:OAE_0004334>
        <rdfs:label>cold exposure injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007152 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004491"/>
        <obo:IAO_0000115>This is an AE which is injury by an object that causes compression of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Crush_injury</obo:IAO_0000119>
        <obo:OAE_0001849>挤压伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061097</obo:OAE_0004334>
        <rdfs:label>crush injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007153 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which is injury on the consist of the mucosal tissue that lies over the mandible and maxilla inside the mouth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gums</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10049300</obo:OAE_0004334>
        <rdfs:label>gingival injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007154 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a preventable adverse effect of care (&quot;iatrogenesis&quot;), whether or not it is evident or harmful to the patient.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Medical_error</obo:IAO_0000119>
        <obo:OAE_0001849>医源性损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061213</obo:OAE_0004334>
        <rdfs:label>iatrogenic injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007155 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is injury lies on between adjacent vertebrae in the vertebral column.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intervertebral_disc</obo:IAO_0000119>
        <obo:OAE_0001849>椎间盘损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10055040</obo:OAE_0004334>
        <rdfs:label>intervertebral disc injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007156 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is injury on the connection made between bones in the body which link the skeletal system into a functional whole.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Joint</obo:IAO_0000119>
        <obo:OAE_0001849>关节损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10060820</obo:OAE_0004334>
        <rdfs:label>joint injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007157 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is injury on the fibrous connective tissue that connects bones to other bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ligament</obo:IAO_0000119>
        <obo:OAE_0001849>韧带损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061223</obo:OAE_0004334>
        <rdfs:label>ligament injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007158 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is injury on  a visible body part at the mouth of many animals, including humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lip</obo:IAO_0000119>
        <obo:OAE_0001849>嘴唇受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10055082</obo:OAE_0004334>
        <rdfs:label>lip injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007159 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is injury on crescent-shaped fibrocartilaginous structure that partly divides a joint cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Meniscus</obo:IAO_0000119>
        <obo:OAE_0001849>半月板损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10072970</obo:OAE_0004334>
        <rdfs:label>meniscus injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007160 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004225"/>
        <obo:IAO_0000115>This is an AE which refers to damage of muscular or skeletal systems, which is usually due to a strenuous activity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Musculoskeletal_injury</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉骨骼损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10073713</obo:OAE_0004334>
        <rdfs:label>musculoskeletal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007161 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a common source of pain and  has a great deal of functionality but is also subject to a lot of stress.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neck#Clinical_significance</obo:IAO_0000119>
        <obo:OAE_0001849>脖子受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10062211</obo:OAE_0004334>
        <rdfs:label>neck injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007162 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the kidneys are functioning at less than 15% of normal levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Kidney_failure</obo:IAO_0000119>
        <obo:OAE_0001849>肾损伤,肾衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10061481</obo:OAE_0004334>
        <rdfs:label>renal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007163 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which plays a key role in deterioration of renal function in both chronic kidney disease (CKD) and acute kidney injury (AKI).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29550485/</obo:IAO_0000119>
        <obo:OAE_0001849>肾小管损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10078933</obo:OAE_0004334>
        <rdfs:label>renal tubular injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007164 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002099"/>
        <obo:IAO_0000115>This is an AE which is an injury to part of the musculoskeletal or nervous system caused by repetitive use, vibrations, compression or long periods in a fixed position.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Repetitive_strain_injury</obo:IAO_0000119>
        <obo:OAE_0001849>重复性劳损</obo:OAE_0001849>
        <obo:OAE_0004334>10038584</obo:OAE_0004334>
        <rdfs:label>repetitive strain injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007165 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is injury on a structural frame that supports an animal body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skeleton</obo:IAO_0000119>
        <obo:OAE_0001849>骨骼损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061363</obo:OAE_0004334>
        <rdfs:label>skeletal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007166 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the spinal cord that causes temporary or permanent changes in its function.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_cord_injury</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10069689</obo:OAE_0004334>
        <rdfs:label>spinal column injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007167 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is injuries that occur during sport, athletic activities, or exercising.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sports_injury</obo:IAO_0000119>
        <obo:OAE_0001849>运动损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10041738</obo:OAE_0004334>
        <rdfs:label>sports injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007168 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is injury on  a tough, high-tensile-strength band of dense fibrous connective tissue that connects muscle to bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tendon</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10043242</obo:OAE_0004334>
        <rdfs:label>tendon injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007169 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <obo:IAO_0000115>This is an AE which is injury on a  muscular organ in the mouth of a typical vertebrate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tongue</obo:IAO_0000119>
        <obo:OAE_0001849>舌头受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10059924</obo:OAE_0004334>
        <rdfs:label>tongue injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007170 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001458"/>
        <obo:IAO_0000115>This is an AE which refers to trauma (injury) to the teeth and/or periodontium (gums, periodontal ligament, alveolar bone), and nearby soft tissues such as the lips, tongue, etc.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dental_trauma</obo:IAO_0000119>
        <obo:OAE_0001849>牙齿损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10044043</obo:OAE_0004334>
        <rdfs:label>tooth injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007171 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a non-medical term describing a range of injuries to the neck caused by or related to a sudden distortion of the neck associated with extension, although the exact injury mechanisms remain unknown.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Whiplash_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>挥鞭伤</obo:OAE_0001849>
        <obo:OAE_0004334>10047929</obo:OAE_0004334>
        <rdfs:label>whiplash injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007172 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002569"/>
        <obo:IAO_0000115>This is an AE which occurs when living tissue is exposed to a corrosive substance (such as a strong acid, base or oxidizer) or a cytotoxic agent (such as mustard gas, lewisite or arsine).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chemical_burn</obo:IAO_0000119>
        <obo:OAE_0001849>化学烧伤</obo:OAE_0001849>
        <obo:OAE_0004334>10008420</obo:OAE_0004334>
        <rdfs:label>chemical burn AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007173 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which refers macrophages present dysfunctional efferocytosis and abnormal phenotypes, which could result in excessive neutrophil accumulation and prolonged inflammation, thereby eventually hindering wound repair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32856346/</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病伤口</obo:OAE_0001849>
        <obo:OAE_0004334>10081558</obo:OAE_0004334>
        <rdfs:label>diabetic wound AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007174 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of wound tissues to harmful stimuli, such as pathogens, damaged cells, or irritants, and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>伤口炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10054923</obo:OAE_0004334>
        <rdfs:label>inflammation of wound AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007175 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is a type of injury which happens relatively quickly in which skin is torn, cut, or punctured (an open wound).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound#Open</obo:IAO_0000119>
        <obo:OAE_0001849>开放性伤口</obo:OAE_0001849>
        <obo:OAE_0004334>10058834</obo:OAE_0004334>
        <rdfs:label>open wound AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007176 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001517"/>
        <obo:IAO_0000115>This is an AE which is those wounds acquired during surgical procedures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Postoperative_wounds</obo:IAO_0000119>
        <obo:OAE_0001849>术后伤口并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10061468</obo:OAE_0004334>
        <rdfs:label>postoperative wound complication AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007177 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000482"/>
        <obo:IAO_0000115>This is an AE which refers associating anterograde amnesia persisting for fifteen years, with temporal disorientation, false recognitions, initially intense transitory confabulation and secondarily bursts of confabulation, intact remote memory and persistence of old learnings.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11865559/</obo:IAO_0000119>
        <obo:OAE_0001849>创伤后癫痫</obo:OAE_0001849>
        <obo:OAE_0004334>10036309</obo:OAE_0004334>
        <rdfs:label>post-traumatic amnestic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007178 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <obo:IAO_0000115>This is an AE which is a form of acquired epilepsy that results from brain damage caused by physical trauma to the brain (traumatic brain injury, abbreviated TBI).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Post-traumatic_epilepsy</obo:IAO_0000119>
        <obo:OAE_0001849>颈部创伤后综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10036312</obo:OAE_0004334>
        <rdfs:label>post-traumatic epilepsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007179 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder occured on post-traumatic that is associated with neck pain and tingling/numbness of the tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neck-tongue_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>创伤后疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10071366</obo:OAE_0004334>
        <rdfs:label>post-traumatic neck syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007180 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling on the post-traumatic often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>创伤后压力心理障碍症</obo:OAE_0001849>
        <obo:OAE_0004334>10065016</obo:OAE_0004334>
        <rdfs:label>post-traumatic pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007181 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000240"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder that can develop because of exposure to a traumatic event, such as sexual assault, warfare, traffic collisions, child abuse, domestic violence or other threats on a person&apos;s life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Post-traumatic_stress_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>创伤后精神失调</obo:OAE_0001849>
        <obo:OAE_0004334>10036316</obo:OAE_0004334>
        <rdfs:label>post-traumatic stress disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007182 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is a type of injury which happens relatively quickly in which skin is torn, cut, where blunt force trauma causes a contusion (a closed wound).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound#Closure</obo:IAO_0000119>
        <obo:OAE_0001849>闭合性伤口</obo:OAE_0001849>
        <obo:OAE_0004334>10057679</obo:OAE_0004334>
        <rdfs:label>wound closure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007183 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which usually resulting from accidental injury; there are pathogenic organisms and foreign bodies in the wound.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound</obo:IAO_0000119>
        <obo:OAE_0001849>伤口污染</obo:OAE_0001849>
        <obo:OAE_0004334>10068796</obo:OAE_0004334>
        <rdfs:label>wound contamination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007184 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is a localized wound  bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>伤口血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10071504</obo:OAE_0004334>
        <rdfs:label>wound hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007185 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged  wound haemorrhage blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>伤口出血</obo:OAE_0001849>
        <obo:OAE_0004334>10051373</obo:OAE_0004334>
        <rdfs:label>wound hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007186 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is a form of cell injury which results in the premature death of cells in living tissue by autolysis occured on the wound.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>伤口坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10053716</obo:OAE_0004334>
        <rdfs:label>wound necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007187 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is a type of application site injury which happens relatively quickly in which skin is torn, cut, or punctured (an open wound), or where blunt force trauma causes a contusion (a closed wound) .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound</obo:IAO_0000119>
        <obo:OAE_0001849>用药部位有伤口</obo:OAE_0001849>
        <obo:OAE_0004334>10078380</obo:OAE_0004334>
        <rdfs:label>application site wound AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007188 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection and is rupture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>水泡破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10073385</obo:OAE_0004334>
        <rdfs:label>blister rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007189 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a closed sac, having a distinct envelope and division compared with the nearby tissue and is rupture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>囊肿破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10061803</obo:OAE_0004334>
        <rdfs:label>cyst rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007190 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a rare injury that occurs primarily during strength training.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33876275/</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10028331</obo:OAE_0004334>
        <rdfs:label>muscle rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007191 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is breakage of the amniotic sac before the onset of labor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prelabor_rupture_of_membranes</obo:IAO_0000119>
        <obo:OAE_0001849>膜破裂时间延长</obo:OAE_0001849>
        <obo:OAE_0004334>10073027</obo:OAE_0004334>
        <rdfs:label>prolonged rupture of membranes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007192 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a common complication of chronic knee arthritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19390451/</obo:IAO_0000119>
        <obo:OAE_0001849>滑膜破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10042862</obo:OAE_0004334>
        <rdfs:label>synovial rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007193 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of tissue and is rupture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>肿瘤破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10070627</obo:OAE_0004334>
        <rdfs:label>tumor rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007194 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002575"/>
        <obo:IAO_0000115>This is an AE which is a specific form of penetrating trauma to the skin that results from a knife or a similar pointed object.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stab_wound</obo:IAO_0000119>
        <obo:OAE_0001849>刀伤</obo:OAE_0001849>
        <obo:OAE_0004334>10041899</obo:OAE_0004334>
        <rdfs:label>stab wound AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007195 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002144"/>
        <obo:IAO_0000115>This is an AE which is a wound, usually a puncture or laceration, caused by the teeth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Animal_bite</obo:IAO_0000119>
        <obo:OAE_0001849>动物咬伤</obo:OAE_0001849>
        <obo:OAE_0004334>10002515</obo:OAE_0004334>
        <rdfs:label>animal bite AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007196 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a skin injury that occurs when exposed to extreme low temperatures, causing the freezing of the skin or other tissues, commonly affecting the fingers, toes, nose, ears, cheeks and chin areas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Frostbite</obo:IAO_0000119>
        <obo:OAE_0001849>冻伤</obo:OAE_0001849>
        <obo:OAE_0004334>10017382</obo:OAE_0004334>
        <rdfs:label>frostbite AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007197 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which damage occurs to capillary beds in the skin, most often in the hands or feet, when blood perfuses into the nearby tissue resulting in redness, itching, inflammation, and possibly blisters.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chilblains</obo:IAO_0000119>
        <obo:OAE_0001849>冻疮</obo:OAE_0001849>
        <obo:OAE_0004334>10008528</obo:OAE_0004334>
        <rdfs:label>chillblains AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007198 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is substances that can cause death, injury or harm to organs, tissues, cells, and DNA usually by chemical reactions , when an organism is exposed to a sufficient quantity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Poison</obo:IAO_0000119>
        <obo:OAE_0001849>化学中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10008428</obo:OAE_0004334>
        <rdfs:label>chemical poisoning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007199 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a mark of abrasion on a surface.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scratch</obo:IAO_0000119>
        <obo:OAE_0001849>划痕</obo:OAE_0001849>
        <obo:OAE_0004334>10039737</obo:OAE_0004334>
        <rdfs:label>scratch AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007200 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a slough or piece of dead tissue that is cast off from the surface of the skin, particularly after a burn injury, but also seen in gangrene, ulcer, fungal infections, necrotizing spider bite wounds, tick bites associated with spotted fevers and exposure to cutaneous anthrax.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eschar</obo:IAO_0000119>
        <obo:OAE_0001849>焦痂</obo:OAE_0001849>
        <obo:OAE_0004334>10051814</obo:OAE_0004334>
        <rdfs:label>eschar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007201 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is the toxic effect of certain metals in certain forms and doses on life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metal_toxicity</obo:IAO_0000119>
        <obo:OAE_0001849>金属中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10027439</obo:OAE_0004334>
        <rdfs:label>metal poisoning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007202 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002687"/>
        <obo:IAO_0000115>This is an AE which is the negative behavior and physical effects caused by a recent consumption of alcohol.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alcohol_intoxication</obo:IAO_0000119>
        <obo:OAE_0001849>酒精中毒</obo:OAE_0001849>
        <obo:OAE_0004334>10001605</obo:OAE_0004334>
        <rdfs:label>alcohol poisoning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007203 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which refers irregular tear-like wounds caused by some blunt trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Laceration</obo:IAO_0000119>
        <obo:OAE_0001849>撕裂伤</obo:OAE_0001849>
        <obo:OAE_0004334>10023572</obo:OAE_0004334>
        <rdfs:label>laceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007204 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is physical damage to body tissues caused by a difference in pressure between a gas space inside, or in contact with, the body, and the surrounding gas or fluid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Barotrauma</obo:IAO_0000119>
        <obo:OAE_0001849>气压伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061688</obo:OAE_0004334>
        <rdfs:label>barotrauma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007205 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch scar.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>伤疤瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10050818</obo:OAE_0004334>
        <rdfs:label>itching scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007206 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002617"/>
        <obo:IAO_0000115>This is an AE which prior to lenvatinib administration prevented hyperammonemia and hepatic encephalopathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32782972/</obo:IAO_0000119>
        <obo:OAE_0001849>分流闭塞</obo:OAE_0001849>
        <obo:OAE_0004334>10040621</obo:OAE_0004334>
        <rdfs:label>shunt occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007207 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of administration site tissue, the most common cause being capillaries damaged by trauma, causing localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>给药部位擦伤</obo:OAE_0001849>
        <obo:OAE_0004334>10075094</obo:OAE_0004334>
        <rdfs:label>administration site bruise AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007208 -->


