    <!-- http://purl.obolibrary.org/obo/OAE_0007001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003306"/>
        <obo:IAO_0000115>This is an AE which is caused by substances derived from microbial plaque accumulating at or near the gingival sulcus; all other suspected local and systemic etiologic factors either enhance plaque accumulation or retention, or enhance the susceptibility of the gingival tissue to microbial attack.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/3522644/</obo:IAO_0000119>
        <obo:OAE_0001849>牙龈感染</obo:OAE_0001849>
        <obo:OAE_0004334>10058802</obo:OAE_0004334>
        <rdfs:label>gingival infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which might be underestimated due to its asymptomatic and non-specific mild infection, and the lack of simple standardized laboratory diagnostics in hospitals, especially in the developing countries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19736383/</obo:IAO_0000119>
        <obo:OAE_0001849>汉坦病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061198</obo:OAE_0004334>
        <rdfs:label>hantaviral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003240"/>
        <obo:IAO_0000115>This is an AE which is large macroparasites caused infection; adults can generally be seen with the naked eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parasitic_worm</obo:IAO_0000119>
        <obo:OAE_0001849>蠕虫感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061201</obo:OAE_0004334>
        <rdfs:label>helminthic infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a histological technique used to visualize acid-fast bacilli using fluorescence microscopy, notably species in the Mycobacterium genus and it can cause infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Auramine%E2%80%93rhodamine_stain</obo:IAO_0000119>
        <obo:OAE_0001849>抗酸杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054204</obo:OAE_0004334>
        <rdfs:label>acid fast bacilli infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007005 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which include skin infections such as cellulitis, pustules, and furuncles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aeromonas_infection</obo:IAO_0000119>
        <obo:OAE_0001849>气单胞菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054205</obo:OAE_0004334>
        <rdfs:label>aeromonas infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007006 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>This is an AE which is the closed sac between the embryo and the amnion, containing the amniotic fluid and is infected.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amniotic_sac</obo:IAO_0000119>
        <obo:OAE_0001849>羊膜腔感染</obo:OAE_0001849>
        <obo:OAE_0004334>10060937</obo:OAE_0004334>
        <rdfs:label>amniotic cavity infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007007 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an administration site by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>给药部位感染</obo:OAE_0001849>
        <obo:OAE_0004334>10066214</obo:OAE_0004334>
        <rdfs:label>administration site infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007008 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a genus consisting of a few hundred mold species found in various climates worldwide and it can cause infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aspergillus</obo:IAO_0000119>
        <obo:OAE_0001849>曲霉属真菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10074171</obo:OAE_0004334>
        <rdfs:label>aspergillus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007009 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002588"/>
        <obo:IAO_0000115>This is an AE which is uncommon and characterized by a chronic, indolent course before diagnosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28344532/</obo:IAO_0000119>
        <obo:OAE_0001849>非典型性分枝杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061663</obo:OAE_0004334>
        <rdfs:label>atypical mycobacterial infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007010 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a genus of Gram-positive, rod-shaped bacteria, a member of the phylum Firmicutes, with 266 named species and it caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bacillus</obo:IAO_0000119>
        <obo:OAE_0001849>芽孢杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10060976</obo:OAE_0004334>
        <rdfs:label>bacillus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007011 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is one of the common complications after hematopoietic stem cell transplantation(HSCT), which is also one of the reasons of the hemorrhagic cystitis．</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30501736/</obo:IAO_0000119>
        <obo:OAE_0001849>多瘤病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10055181</obo:OAE_0004334>
        <rdfs:label>bk virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007012 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a genus of single-celled heterokont parasites belonging to a group of organisms that are known as the Stramenopiles (also called Heterokonts) that includes algae, diatoms, and water molds and it can cause infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blastocystis</obo:IAO_0000119>
        <obo:OAE_0001849>人芽囊原虫感染，囊胚感染</obo:OAE_0001849>
        <obo:OAE_0004334>10005092</obo:OAE_0004334>
        <rdfs:label>blastocystis infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007013 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a small pocket of body fluid (lymph, serum, plasma, blood, or pus) within the upper layers of the skin, usually caused by forceful rubbing (friction), burning, freezing, chemical exposure or infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blister</obo:IAO_0000119>
        <obo:OAE_0001849>水泡感染</obo:OAE_0001849>
        <obo:OAE_0004334>10005192</obo:OAE_0004334>
        <rdfs:label>blister infected AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007014 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a genus of small (0.2 0.7 m), gram-negative coccobacilli of the phylum Proteobacteria. Bordetella species, with the exception of B. petrii, are obligate aerobes, as well as highly fastidious, or difficult to culture and all species can infect humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bordetella</obo:IAO_0000119>
        <obo:OAE_0001849>博代氏杆菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10052307</obo:OAE_0004334>
        <rdfs:label>bordetella infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000460"/>
        <obo:IAO_0000115>This is an AE which is an etiological factor which should be considered in patients suffering from vertigo especially if positional nystagmus is present.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/3421091/</obo:IAO_0000119>
        <obo:OAE_0001849>博氏菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061591</obo:OAE_0004334>
        <rdfs:label>borrelia infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007016 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an emerging pathogen causes life-threatening infections in cystic fibrosis patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30012345/</obo:IAO_0000119>
        <obo:OAE_0001849>洋葱伯克霍尔德氏菌复杂感染</obo:OAE_0001849>
        <obo:OAE_0004334>10069657</obo:OAE_0004334>
        <rdfs:label>burkholderia cepacia complex infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000026"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of one or more bursae (fluid filled sacs) of synovial fluid in the body and is infective.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bursitis</obo:IAO_0000119>
        <obo:OAE_0001849>滑囊炎感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061022</obo:OAE_0004334>
        <rdfs:label>bursitis infective AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007018 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection by the Campylobacter bacterium, most commonly C. jejuni.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Campylobacteriosis</obo:IAO_0000119>
        <obo:OAE_0001849>弯曲杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10051226</obo:OAE_0004334>
        <rdfs:label>campylobacter infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007019 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a fungal infection due to any type of Candida (a type of yeast) , when it affects the mouth, in some countries it is commonly called thrush.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Candidiasis</obo:IAO_0000119>
        <obo:OAE_0001849>念珠菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>100741710</obo:OAE_0004334>
        <rdfs:label>candida infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which refers a reemerging arbovirus, causes a crippling musculoskeletal inflammatory disease in humans characterized by fever, polyarthralgia, myalgia, rash, and headache.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28248203/</obo:IAO_0000119>
        <obo:OAE_0001849>基孔肯雅病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10067256</obo:OAE_0004334>
        <rdfs:label>chikungunya virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007021 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a sexually transmitted infection caused by the bacterium Chlamydia trachomatis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chlamydia</obo:IAO_0000119>
        <obo:OAE_0001849>衣原体感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061041</obo:OAE_0004334>
        <rdfs:label>chlamydial infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007022 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a genus of Gram-negative coliform bacteria in the family Enterobacteriaceae and it causes infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Citrobacter</obo:IAO_0000119>
        <obo:OAE_0001849>枸橼酸杆菌属感染，柠檬酸杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10051904</obo:OAE_0004334>
        <rdfs:label>citrobacter infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a group of related RNA viruses that cause diseases in mammals and birds and it caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coronavirus</obo:IAO_0000119>
        <obo:OAE_0001849>冠状病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10053983</obo:OAE_0004334>
        <rdfs:label>corona virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007024 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a group of related RNA viruses that cause diseases in mammals and birds and it caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coronavirus</obo:IAO_0000119>
        <obo:OAE_0001849>冠状病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10051905</obo:OAE_0004334>
        <rdfs:label>coronavirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007025 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a genus of bacteria that are Gram-positive and most are aerobic and it caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corynebacterium</obo:IAO_0000119>
        <obo:OAE_0001849>棒状杆菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061092</obo:OAE_0004334>
        <rdfs:label>corynebacterium infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007026 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004278"/>
        <obo:IAO_0000115>This is an AE which is a mainstay of adjunctive therapy for superficial bladder cancer that increases length of disease progression-free survival and it usually well tolerated, moderate to severe local and systemic infectious complications can occur with this immunotherapy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31711964/</obo:IAO_0000119>
        <obo:OAE_0001849>播散性卡介苗杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10076666</obo:OAE_0004334>
        <rdfs:label>disseminated bacillus calmette-guerin infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007027 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a polyphyletic group of viruses associated with enteric disease in humans and it caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Echovirus</obo:IAO_0000119>
        <obo:OAE_0001849>ECHO病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061113</obo:OAE_0004334>
        <rdfs:label>echo virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007028 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the skin, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>湿疹感染</obo:OAE_0001849>
        <obo:OAE_0004334>10014199</obo:OAE_0004334>
        <rdfs:label>eczema infected AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007029 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which include asymptomatic infections, the primary infection, infectious mononucleosis, and the progression of asymptomatic or primary infections .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epstein%E2%80%93Barr_virus_infection</obo:IAO_0000119>
        <obo:OAE_0001849>埃普斯坦-巴尔病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10015108</obo:OAE_0004334>
        <rdfs:label>epstein-barr virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an epilepsy syndrome in which new-onset refractory status epilepticus (NORSE) is preceded by febrile illness 24 hours to 2 weeks prior to the onset of seizures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Febrile_infection-related_epilepsy_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>发热性感染相关癫痫综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10079438</obo:OAE_0004334>
        <rdfs:label>febrile infection-related epilepsy syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a infection caused by genus of Gram-variable-staining facultative anaerobic bacteria of which Gardnerella vaginalis is the only species.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gardnerella_vaginalis</obo:IAO_0000119>
        <obo:OAE_0001849>加德纳菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10017728</obo:OAE_0004334>
        <rdfs:label>gardnerella infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007032 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is an infection by a type of intestinal parasite known as a hookworm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hookworm_infection</obo:IAO_0000119>
        <obo:OAE_0001849>钩虫感染</obo:OAE_0001849>
        <obo:OAE_0004334>10020376</obo:OAE_0004334>
        <rdfs:label>hookworm infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007033 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is the name given to all viruses in the genus Bocaparvovirus of virus family Parvoviridae that are known to infect humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_bocavirus</obo:IAO_0000119>
        <obo:OAE_0001849>人类博卡病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10077391</obo:OAE_0004334>
        <rdfs:label>human bocavirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007034 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which has been associated with different epilepsy syndromes, including febrile seizures and status epilepticus, acute symptomatic seizures secondary to encephalitis and temporal lobe epilepsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30953871/</obo:IAO_0000119>
        <obo:OAE_0001849>人类疱疹病毒6感染</obo:OAE_0001849>
        <obo:OAE_0004334>10020431</obo:OAE_0004334>
        <rdfs:label>human herpesvirus 6 infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007035 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by certain types of human herpes viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Roseola</obo:IAO_0000119>
        <obo:OAE_0001849>人类疱疹病毒7感染</obo:OAE_0001849>
        <obo:OAE_0004334>10063571</obo:OAE_0004334>
        <rdfs:label>human herpesvirus 7 infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007036 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a family of viruses whose natural hosts are primarily mammals such as human.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyomaviridae</obo:IAO_0000119>
        <obo:OAE_0001849>人类多瘤病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10057366</obo:OAE_0004334>
        <rdfs:label>human polyomavirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007037 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the causation of a disease, a harmful complication, or other ill effect by any medical activity, including diagnosis, intervention, error, or negligence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iatrogenesis</obo:IAO_0000119>
        <obo:OAE_0001849>医源性感染</obo:OAE_0001849>
        <obo:OAE_0004334>10064091</obo:OAE_0004334>
        <rdfs:label>iatrogenic infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007038 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an implant site by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>植入部位感染</obo:OAE_0001849>
        <obo:OAE_0004334>10059650</obo:OAE_0004334>
        <rdfs:label>implant site infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007039 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is defined as infections occurring up to 30 days after surgery (or up to one year after surgery in patients receiving implants) and affecting either the incision or deep tissue at the operation site.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19022115/</obo:IAO_0000119>
        <obo:OAE_0001849>切口部位感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065616</obo:OAE_0004334>
        <rdfs:label>incision site infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the passing of a pathogen causing communicable disease from an infected host individual or group to a particular individual or group, regardless of whether the other individual was previously infected such as indirect infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Transmission_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>间接感染传播</obo:OAE_0001849>
        <obo:OAE_0004334>10021714</obo:OAE_0004334>
        <rdfs:label>indirect infection transmission AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007041 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a wound received from the mouth of an animal or human and can caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bite_(disambiguation)</obo:IAO_0000119>
        <obo:OAE_0001849>被感染的叮咬</obo:OAE_0001849>
        <obo:OAE_0004334>10076911</obo:OAE_0004334>
        <rdfs:label>infected bite AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007042 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a closed infected sac , having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>受感染的囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10058015</obo:OAE_0004334>
        <rdfs:label>infected cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007043 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which has been widely documented in marine mammals and may cause morbidity and mortality at levels that result in population level effects.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27667806/</obo:IAO_0000119>
        <obo:OAE_0001849>原生动物的感染</obo:OAE_0001849>
        <obo:OAE_0004334>10021859</obo:OAE_0004334>
        <rdfs:label>infection protozoal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007044 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000004"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an organism&apos;s body tissues by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce such as  via vaccinee.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>通过接种疫苗感染</obo:OAE_0001849>
        <obo:OAE_0004334>10021875</obo:OAE_0004334>
        <rdfs:label>infection via vaccinee AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007045 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection usually caused by the Epstein–Barr virus (EBV).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infectious_mononucleosis</obo:IAO_0000119>
        <obo:OAE_0001849>传染性单核细胞增多</obo:OAE_0001849>
        <obo:OAE_0004334>10021914</obo:OAE_0004334>
        <rdfs:label>infectious mononucleosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007046 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is the inflammation with infective of the fluid-filled sheath (called the synovium) that surrounds a tendon, typically leading to joint pain, swelling, and stiffness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tenosynovitis</obo:IAO_0000119>
        <obo:OAE_0001849>感染性腱鞘炎</obo:OAE_0001849>
        <obo:OAE_0004334>10057619</obo:OAE_0004334>
        <rdfs:label>infective tenosynovitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007047 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which refers a member of polyomaviridae family, has been described as a cause of the progressive multifocal leukoencephalopathy (PML) and it is a potentially fatal, disabling demyelinating infection of the brain occurring mostly in the setting of immunosuppression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31142409/</obo:IAO_0000119>
        <obo:OAE_0001849>jc病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10023163</obo:OAE_0004334>
        <rdfs:label>jc virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007048 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a genus of pathogenic Gram-negative bacteria that includes the species L. pneumophila, causing legionellosis (all illnesses caused by Legionella) including a pneumonia-type illness called Legionnaires&apos; disease and a mild flu-like illness called Pontiac fever.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Legionella</obo:IAO_0000119>
        <obo:OAE_0001849>军团菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061266</obo:OAE_0004334>
        <rdfs:label>legionella infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007049 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002588"/>
        <obo:IAO_0000115>This is an AE which is an atypical mycobacterial infection, i.e. one with nontuberculous mycobacteria or NTM, caused by Mycobacterium avium complex (MAC), which is made of two Mycobacterium species, M. avium and M. intracellulare.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mycobacterium_avium-intracellulare_infection</obo:IAO_0000119>
        <obo:OAE_0001849>禽分枝杆菌复合感染</obo:OAE_0001849>
        <obo:OAE_0004334>10058806</obo:OAE_0004334>
        <rdfs:label>mycobacterium avium complex infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007050 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001410"/>
        <obo:IAO_0000115>This is an AE which occur after traumatic injuries, minor skin lesions, nonpenetrating injuries, natural childbirth, and in postsurgical and immunocompromised patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33303335/</obo:IAO_0000119>
        <obo:OAE_0001849>软组织坏死感染</obo:OAE_0001849>
        <obo:OAE_0004334>10076637</obo:OAE_0004334>
        <rdfs:label>necrotising soft tissue infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007051 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by  large genus of bacteria that colonize the mucosal surfaces of many animals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neisseria</obo:IAO_0000119>
        <obo:OAE_0001849>奈瑟氏菌属感染</obo:OAE_0001849>
        <obo:OAE_0004334>10062212</obo:OAE_0004334>
        <rdfs:label>neisseria infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007052 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is associated with high mortality and morbidity and is transmitted by direct and indirect contact.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22071827/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿念珠菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10028924</obo:OAE_0004334>
        <rdfs:label>neonatal candida infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007053 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000231"/>
        <obo:IAO_0000115>This is an AE which is infections of the neonate (newborn) acquired during prenatal development or in the first four weeks of life (neonatal period).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061308</obo:OAE_0004334>
        <rdfs:label>neonatal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007054 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which is inflammation with noninfective of the outermost layer of the white part of the eye and the inner surface of the eyelid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivitis</obo:IAO_0000119>
        <obo:OAE_0001849>非感染性结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074701</obo:OAE_0004334>
        <rdfs:label>noninfective conjunctivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007055 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001283"/>
        <obo:IAO_0000115>This is an AE which is a non-destructive and noninfective disease that causes inflammation of the gums.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gingivitis</obo:IAO_0000119>
        <obo:OAE_0001849>非感染性牙龈炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074863</obo:OAE_0004334>
        <rdfs:label>noninfective gingivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007056 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is serologically cross-reactive and cross-protective, and after the cessation of smallpox vaccination, CPXV and other OPV infections represent an emerging threat to human health.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21453121/</obo:IAO_0000119>
        <obo:OAE_0001849>正痘病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10069586</obo:OAE_0004334>
        <rdfs:label>orthopox virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007057 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is involved in both juvenile and adult laryngeal papilloma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23273988/</obo:IAO_0000119>
        <obo:OAE_0001849>乳头状瘤病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061331</obo:OAE_0004334>
        <rdfs:label>papilloma viral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007058 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a common cause of seasonal upper respiratory tract infections in children and adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/12603206/</obo:IAO_0000119>
        <obo:OAE_0001849>副流感嗜血杆菌病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061907</obo:OAE_0004334>
        <rdfs:label>parainfluenzae virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007059 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an important emerging infection in young infants, able to cause sepsis-like disease and meningoencephalitis, especially in newborns.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32656569/</obo:IAO_0000119>
        <obo:OAE_0001849>甲状病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10071449</obo:OAE_0004334>
        <rdfs:label>parechovirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007060 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which may cause significant fetal damage, and in rare cases, brain anomalies and neurodevelopmental insults, especially if infection occurs in the first 20 weeks of pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28398685/</obo:IAO_0000119>
        <obo:OAE_0001849>细小病毒b19感染</obo:OAE_0001849>
        <obo:OAE_0004334>10034099</obo:OAE_0004334>
        <rdfs:label>parvovirus b19 infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007061 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by viruses have linear, single-stranded DNA (ssDNA) genomes that typically contain two genes encoding for a replication initiator protein, called NS1, and the protein the viral capsid is made of.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parvoviridae</obo:IAO_0000119>
        <obo:OAE_0001849>细小病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10057343</obo:OAE_0004334>
        <rdfs:label>parvovirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007062 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by species of parasitic protozoa that causes tertian malaria in humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plasmodium_ovale</obo:IAO_0000119>
        <obo:OAE_0001849>卵圆形疟原虫感染</obo:OAE_0001849>
        <obo:OAE_0004334>10035502</obo:OAE_0004334>
        <rdfs:label>plasmodium ovale infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007063 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000314"/>
        <obo:IAO_0000115>This is an AE which is one of the most common causes of acute glomerulonephritis in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28891413/</obo:IAO_0000119>
        <obo:OAE_0001849>感染后肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074480</obo:OAE_0004334>
        <rdfs:label>post infection glomerulonephritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007064 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is the invasion of post procedural tissue by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>手术后感染</obo:OAE_0001849>
        <obo:OAE_0004334>10067268</obo:OAE_0004334>
        <rdfs:label>post procedural infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007065 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003305"/>
        <obo:IAO_0000115>This is an AE which is considered surgical site infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28790284/</obo:IAO_0000119>
        <obo:OAE_0001849>术后伤口感染</obo:OAE_0001849>
        <obo:OAE_0004334>10036410</obo:OAE_0004334>
        <rdfs:label>postoperative wound infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007066 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a gram-positive, anaerobic, rod-shaped genus of bacteria .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>丙酸杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10051946</obo:OAE_0004334>
        <rdfs:label>propionibacterium infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007067 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a genus of Gram-negative Proteobacteria caused infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Proteus_(bacterium)</obo:IAO_0000119>
        <obo:OAE_0001849>变形杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061470</obo:OAE_0004334>
        <rdfs:label>proteus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007068 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000226"/>
        <obo:IAO_0000115>This is an AE which is the invasion of puncture site  tissues by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>穿刺部位感染</obo:OAE_0001849>
        <obo:OAE_0004334>10063677</obo:OAE_0004334>
        <rdfs:label>puncture site infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007069 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a type of virus that inserts a copy of its RNA genome into the DNA of a host cell that it invades, thus changing the genome of that cell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retrovirus</obo:IAO_0000119>
        <obo:OAE_0001849>逆转录病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061493</obo:OAE_0004334>
        <rdfs:label>retroviral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007070 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a leading cause of severe, dehydrating gastroenteritis in children &lt;5 years of age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29119972/</obo:IAO_0000119>
        <obo:OAE_0001849>轮状病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10067470</obo:OAE_0004334>
        <rdfs:label>rotavirus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007071 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by the  species of rod-shaped, Gram-negative bacteria in the family Yersiniaceae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Serratia_marcescens</obo:IAO_0000119>
        <obo:OAE_0001849>沙雷氏菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061512</obo:OAE_0004334>
        <rdfs:label>serratia infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007072 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a  severe invasive  infection caused by genus of gram-positive coccus (plural cocci) or spherical bacteria that belongs to the family Streptococcaceae, within the order Lactobacillales (lactic acid bacteria), in the phylum Firmicutes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Streptococcus</obo:IAO_0000119>
        <obo:OAE_0001849>严重侵袭性链球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10072839</obo:OAE_0004334>
        <rdfs:label>severe invasive streptococcal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007073 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a  strictly aerobic Gram-negative bacterium that has a single polar flagellum with slow motility.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sphingomonas_paucimobilis</obo:IAO_0000119>
        <obo:OAE_0001849>鞘氨醇单胞菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10069639</obo:OAE_0004334>
        <rdfs:label>sphingomonas paucimobilis infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007074 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by that contains distinctive diderm (double-membrane) gram-negative bacteria, most of which have long, helically coiled (corkscrew-shaped or spiraled) cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spirochaete</obo:IAO_0000119>
        <obo:OAE_0001849>螺旋体感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061370</obo:OAE_0004334>
        <rdfs:label>spirochaetal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007075 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a  genus of Gram-negative bacteria,comprising at least ten species.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenotrophomonas</obo:IAO_0000119>
        <obo:OAE_0001849>狭养单胞菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054138</obo:OAE_0004334>
        <rdfs:label>stenotrophomonas infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007076 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a genus of gram-positive coccus (plural cocci) or spherical bacteria that belongs to the family Streptococcaceae, within the order Lactobacillales (lactic acid bacteria), in the phylum Firmicutes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Streptococcus</obo:IAO_0000119>
        <obo:OAE_0001849>链球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061372</obo:OAE_0004334>
        <rdfs:label>streptococcal infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007077 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by  small tubular structures of the skin that produce sweat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sweat_gland</obo:IAO_0000119>
        <obo:OAE_0001849>汗腺感染</obo:OAE_0001849>
        <obo:OAE_0004334>10055027</obo:OAE_0004334>
        <rdfs:label>sweat gland infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007078 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an systemic body tissues by disease-causing agents such as bacterial, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>全身细菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10078415</obo:OAE_0004334>
        <rdfs:label>systemic bacterial infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007079 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which occurs in allogeneic hematopoietic stem cell transplantation, but data in children receiving chemotherapy for acute leukemia are scarce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32918533/</obo:IAO_0000119>
        <obo:OAE_0001849>全身病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10078452</obo:OAE_0004334>
        <rdfs:label>systemic viral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007080 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a fungal infection of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatophytosis</obo:IAO_0000119>
        <obo:OAE_0001849>癣感染</obo:OAE_0001849>
        <obo:OAE_0004334>10060889</obo:OAE_0004334>
        <rdfs:label>tinea infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007081 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000004"/>
        <obo:IAO_0000115>This is an AE which is a case of illness in which a vaccinated individual becomes sick from the same illness that the vaccine is meant to prevent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Breakthrough_infection</obo:IAO_0000119>
        <obo:OAE_0001849>疫苗突破感染</obo:OAE_0001849>
        <obo:OAE_0004334>10067923</obo:OAE_0004334>
        <rdfs:label>vaccine breakthrough infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007082 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a large, complex, enveloped virus belonging to the poxvirus family.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vaccinia</obo:IAO_0000119>
        <obo:OAE_0001849>痘苗病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10046865</obo:OAE_0004334>
        <rdfs:label>vaccinia virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007083 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000359"/>
        <obo:IAO_0000115>This is an AE which causes varicella (chickenpox), which can be severe in immunocompromised individuals, infants and adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27188665/</obo:IAO_0000119>
        <obo:OAE_0001849>水痘带状疱疹病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10075611</obo:OAE_0004334>
        <rdfs:label>varicella zoster virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007084 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is the major route of HCV infection in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26350018/</obo:IAO_0000119>
        <obo:OAE_0001849>垂直感染传播</obo:OAE_0001849>
        <obo:OAE_0004334>10047337</obo:OAE_0004334>
