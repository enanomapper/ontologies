        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115 xml:lang="en">a muscle adverse event which has an outcome of muscle inflammation, which is a local accumulation of fluid, plasma proteins, and leukocytes in muscle</obo:IAO_0000115>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <rdfs:label>muscle inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0004511</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000615 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001676"/>
        <obo:IAO_0000115 xml:lang="en">a lymphocyte count abnormal AE that has an outcome of greater than normal number of the cells involved in adaptive immune reactions of the body in most inflammatory and autoimmune diseases, including B cells, T cells and natural killer cells</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;lymphocytosis&apos;; is an adverse event that was mentioned in 129 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>EB</obo:IAO_0000117>
        <obo:IAO_0000118>increased lymphocyte cell number AE</obo:IAO_0000118>
        <obo:IAO_0000118>lymphocyte cell number increased AE</obo:IAO_0000118>
        <obo:OAE_0004334>10025258</obo:OAE_0004334>
        <rdfs:label>lymphocyte count increased AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12195</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0005013</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C34791</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000616 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115 xml:lang="en">an abnormal defecation AE that has an outcome of diarrhea, which is abnormally frequent discharge of semi-solid or fluid fecal matter from the bowel</obo:IAO_0000115>
        <obo:IAO_0000118>diarrhoea AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/diarrhea</obo:IAO_0000119>
        <obo:OAE_0004334>10012735</obo:OAE_0004334>
        <rdfs:label>diarrhea AE</rdfs:label>
