        <obo:OAE_0004334>10058079</obo:OAE_0004334>
        <rdfs:label>anomalous pulmonary venous connection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005423 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000194"/>
        <obo:IAO_0000115>This is an AE which is the catheter site  inflammation of a vein, usually in the legs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phlebitis</obo:IAO_0000119>
