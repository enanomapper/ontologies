        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 hepatitis viral AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11412</rdfs:seeAlso>
    </owl:Class>
    


