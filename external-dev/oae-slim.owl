        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004456"/>
        <obo:IAO_0000115>This is an AE which is when a solid piece of material (kidney stone) develops in the urinary tract.</obo:IAO_0000115>
