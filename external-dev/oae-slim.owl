    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000069"/>
        <obo:IAO_0000115>a metabolism, endocrine, and exocrine system AE that has an outcome of acidosis, i.e.,  too much acid in the body fluids.</obo:IAO_0000115>
        <obo:IAO_0000118>Blood pH Decreased </obo:IAO_0000118>
        <obo:IAO_0000119>URL: http://www.nlm.nih.gov/medlineplus/ency/article/001181.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10000486</obo:OAE_0004334>
        <obo:OAE_0004334>10005706</obo:OAE_0004334>
        <dc:creator>YH, SJ, MW</dc:creator>
        <rdfs:label xml:lang="en">acidosis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12237</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C28228</rdfs:seeAlso>
    </owl:Class>
    


