    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007085 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a single-stranded RNA virus that causes West Nile fever.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/West_Nile_virus</obo:IAO_0000119>
        <obo:OAE_0001849>西尼罗河病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10057293</obo:OAE_0004334>
        <rdfs:label>west nile viral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007086 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by a genus of bacteria in the family Yersiniaceae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Yersinia</obo:IAO_0000119>
        <obo:OAE_0001849>耶尔森氏菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10061416</obo:OAE_0004334>
        <rdfs:label>yersinia infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007087 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001850"/>
        <obo:IAO_0000115>This is an AE which is an infection aggregation of macrophages that forms in response to chronic inflammation with septic on infantile .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Granuloma</obo:IAO_0000119>
        <obo:OAE_0001849>小儿感染性肉芽肿病</obo:OAE_0001849>
        <obo:OAE_0004334>10048708</obo:OAE_0004334>
        <rdfs:label>infantile septic granulomatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007088 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000448"/>
        <obo:IAO_0000115>This is an AE which is a generalized neurodevelopmental disorder characterized by significantly impaired intellectual and adaptive functioning and is severe.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intellectual_disability#Terminology</obo:IAO_0000119>
        <obo:OAE_0001849>严重侵袭性链球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10040443</obo:OAE_0004334>
        <rdfs:label>severe mental retardation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007089 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which refers a result of severe infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shock</obo:IAO_0000119>
        <obo:OAE_0001849>休克</obo:OAE_0001849>
        <obo:OAE_0004334>10040560</obo:OAE_0004334>
        <rdfs:label>shock AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007090 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a viral infection of the skin that results in small raised pink lesions with a dimple in the center.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Molluscum_contagiosum</obo:IAO_0000119>
        <obo:OAE_0001849>接触传染性软疣</obo:OAE_0001849>
        <obo:OAE_0004334>10027807</obo:OAE_0004334>
        <rdfs:label>molluscum contagiosum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007091 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection involving the inner layers of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10007882</obo:OAE_0004334>
        <rdfs:label>cellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007092 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which is inflammation of eye tissues behind the orbital septum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Orbital_cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>眼眶蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10007918</obo:OAE_0004334>
        <rdfs:label>cellulitis orbital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007093 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which describes an uncomplicated inflammation of the dermis and hypodermis from a noninfectious etiology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32301203/</obo:IAO_0000119>
        <obo:OAE_0001849>假性蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074969</obo:OAE_0004334>
        <rdfs:label>pseudocellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007094 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <obo:IAO_0000115>This is an AE which is characterized as a disruption to the microbiota homeostasis caused by an imbalance in the microflora, changes in their functional composition and metabolic activities, or a shift in their local distribution.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysbiosis</obo:IAO_0000119>
        <obo:OAE_0001849>菌群失调</obo:OAE_0001849>
        <obo:OAE_0004334>10064389</obo:OAE_0004334>
        <rdfs:label>dysbacteriosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007095 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection most commonly caused by Listeria monocytogenes,although L. ivanovii and L. grayi have been reported in certain cases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Listeriosis</obo:IAO_0000119>
        <obo:OAE_0001849>李氏杆菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10024641</obo:OAE_0004334>
        <rdfs:label>listeriosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007096 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a serious fungal infection, usually in people who are immunocompromised.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mucormycosis</obo:IAO_0000119>
        <obo:OAE_0001849>毛霉菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10028098</obo:OAE_0004334>
        <rdfs:label>mucormycosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007097 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease affecting either the lungs (pulmonary nocardiosis) or the whole body (systemic nocardiosis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nocardiosis</obo:IAO_0000119>
        <obo:OAE_0001849>诺卡氏菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10029444</obo:OAE_0004334>
        <rdfs:label>nocardiosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007098 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a mammalian fungal disease caused by Coccidioides immitis or Coccidioides posadasii.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coccidioidomycosis</obo:IAO_0000119>
        <obo:OAE_0001849>球孢子菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10009825</obo:OAE_0004334>
        <rdfs:label>coccidioidomycosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007099 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a symptomatic infection caused by bacteria of the Salmonella type.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Salmonellosis</obo:IAO_0000119>
        <obo:OAE_0001849>沙门氏菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10039447</obo:OAE_0004334>
        <rdfs:label>salmonellosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007100 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is localized redness, heat, swelling and pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性疾病载体</obo:OAE_0001849>
        <obo:OAE_0004334>10004017</obo:OAE_0004334>
        <rdfs:label>bacterial disease carrier AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007101 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is the most common form of cutaneous T-cell lymphoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mycosis_fungoides</obo:IAO_0000119>
        <obo:OAE_0001849>蕈样真菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10028483</obo:OAE_0004334>
        <rdfs:label>mycosis fungoides AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007102 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a potentially fatal fungal infection of mainly the lungs, presenting as a pneumonia, and brain, where it appears as a meningitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cryptococcosis</obo:IAO_0000119>
        <obo:OAE_0001849>隐球菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10011490</obo:OAE_0004334>
        <rdfs:label>cryptococcosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007103 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is disease caused by fungi.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fungal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>真菌疾病载体</obo:OAE_0001849>
        <obo:OAE_0004334>10080548</obo:OAE_0004334>
        <rdfs:label>fungal disease carrier AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007104 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000915"/>
        <obo:IAO_0000115>This is an AE which remains a rare disease occurring mostly in patients with predisposing host conditions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24126720/</obo:IAO_0000119>
        <obo:OAE_0001849>真菌性心内膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10017529</obo:OAE_0004334>
        <rdfs:label>fungal endocarditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007105 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000103"/>
        <obo:IAO_0000115>This is an AE which is a fungal infection caused by Histoplasma capsulatum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Histoplasmosis</obo:IAO_0000119>
        <obo:OAE_0001849>组织胞浆菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10020141</obo:OAE_0004334>
        <rdfs:label>histoplasmosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007106 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001886"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the uvea, the pigmented layer that lies between the inner retina and the outer fibrous layer composed of the sclera and cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uveitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性葡萄膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10071005</obo:OAE_0004334>
        <rdfs:label>viral uveitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007107 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease caused by one of two virus variants, Variola major and Variola minor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Smallpox</obo:IAO_0000119>
        <obo:OAE_0001849>天花</obo:OAE_0001849>
        <obo:OAE_0004334>10041197</obo:OAE_0004334>
        <rdfs:label>smallpox AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007108 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a infection caused by a cytolytic Coxsackievirus of the Picornaviridae family, an enterovirus (a group containing the polioviruses, coxsackieviruses, and echoviruses).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coxsackie_A_virus</obo:IAO_0000119>
        <obo:OAE_0001849>柯萨基病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10011261</obo:OAE_0004334>
        <rdfs:label>coxsackie viral infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007109 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which causes clinically significant illness during acute and recurrent infection accompanied by robust innate and acquired immune responses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30247598/</obo:IAO_0000119>
        <obo:OAE_0001849>播散性水痘带状疱疹疫苗病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10076667</obo:OAE_0004334>
        <rdfs:label>disseminated varicella zoster vaccine virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which causes clinically significant illness during acute and recurrent infection accompanied by robust innate and acquired immune responses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30247598/</obo:IAO_0000119>
        <obo:OAE_0001849>播散性水痘带状疱疹病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10084396</obo:OAE_0004334>
        <rdfs:label>disseminated varicella zoster virus infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007111 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is acute febrile tick-borne infectious diseases caused by  members from the genera Ehrlichia and Anaplasma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28457353/</obo:IAO_0000119>
        <obo:OAE_0001849>人埃利希体病</obo:OAE_0001849>
        <obo:OAE_0004334>10020429</obo:OAE_0004334>
        <rdfs:label>human ehrlichiosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007112 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by any of the amoebae of the Entamoeba genus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amoebiasis</obo:IAO_0000119>
        <obo:OAE_0001849>阿米巴疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10001980</obo:OAE_0004334>
        <rdfs:label>amoebiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007113 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is an infection caused by any of the amoebae of the Entamoeba genus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amoebiasis</obo:IAO_0000119>
        <obo:OAE_0001849>阿米巴痢疾</obo:OAE_0001849>
        <obo:OAE_0004334>10001986</obo:OAE_0004334>
        <rdfs:label>amoebic dysentery AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007114 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>This is an AE which is a viral hemorrhagic fever in humans and other primates, caused by ebolaviruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ebola</obo:IAO_0000119>
        <obo:OAE_0001849>埃博拉病</obo:OAE_0001849>
        <obo:OAE_0004334>10014071</obo:OAE_0004334>
        <rdfs:label>ebola disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007115 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a malaria-like parasitic disease caused by infection with a eukaryotic parasite in the order Piroplasmida, typically a Babesia or Theileria, in the phylum Apicomplexa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Babesiosis</obo:IAO_0000119>
        <obo:OAE_0001849>巴贝西虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10003965</obo:OAE_0004334>
        <rdfs:label>babesiosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007116 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease produced by bacteria of the genus Bartonella.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bartonellosis</obo:IAO_0000119>
        <obo:OAE_0001849>巴尔通体病</obo:OAE_0001849>
        <obo:OAE_0004334>10004145</obo:OAE_0004334>
        <rdfs:label>bartonellosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007117 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is a food-borne parasitic infection caused by the lung fluke, most commonly Paragonimus westermani.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paragonimiasis</obo:IAO_0000119>
        <obo:OAE_0001849>并殖吸虫病</obo:OAE_0001849>
        <obo:OAE_0004334>10033794</obo:OAE_0004334>
        <rdfs:label>paragonimiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007118 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000401"/>
        <obo:IAO_0000115>This is an AE which was a mysterious and contagious disease that struck England and later continental Europe in a series of epidemics beginning in 1485.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sweating_sickness</obo:IAO_0000119>
        <obo:OAE_0001849>出汗发热</obo:OAE_0001849>
        <obo:OAE_0004334>10042666</obo:OAE_0004334>
        <rdfs:label>sweating fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007119 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is a mosquito-borne tropical disease caused by the dengue virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dengue_fever</obo:IAO_0000119>
        <obo:OAE_0001849>登革热</obo:OAE_0001849>
        <obo:OAE_0004334>10012310</obo:OAE_0004334>
