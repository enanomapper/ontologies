    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007569 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is a rare but severe and potentially life-threatening complication of hyperthyroidism (overactivity of the thyroid gland).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_storm</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺毒性危象</obo:OAE_0001849>
        <obo:OAE_0004334>10043786</obo:OAE_0004334>
        <rdfs:label>thyrotoxic crisis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007570 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is mainly present in classical papillary thyroid carcinoma (PTC) and in medullary thyroid carcinoma (MTC), despite being described in benign lesions and in other subtypes of thyroid carcinomas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33086487/</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10078379</obo:OAE_0004334>
        <rdfs:label>thyroid calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007571 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001451"/>
        <obo:IAO_0000115>This is an AE which is a swelling with hypothyroidic in the neck resulting from an enlarged thyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Goitre</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺功能减退甲状腺肿</obo:OAE_0001849>
        <obo:OAE_0004334>10059844</obo:OAE_0004334>
        <rdfs:label>hypothyroidic goitre AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007572 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a medical condition that affects the function of the thyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_disease</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10043709</obo:OAE_0004334>
        <rdfs:label>thyroid disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007573 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a neoplasm or tumor of the thyroid and can be a benign tumor such as thyroid adenoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺良性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10004412</obo:OAE_0004334>
        <rdfs:label>benign neoplasm of thyroid gland AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007574 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001452"/>
        <obo:IAO_0000115>This is an AE which is nodules (raised areas of tissue or fluid) which commonly arise within an otherwise normal thyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_nodule#Presentation</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10043706</obo:OAE_0004334>
        <rdfs:label>thyroid cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007575 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of thethyroid gland .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051878</obo:OAE_0004334>
        <rdfs:label>thyroid gland abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007576 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is an endocrine gland in vertebrates and feel it pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺痛</obo:OAE_0001849>
        <obo:OAE_0004334>10043757</obo:OAE_0004334>
        <rdfs:label>thyroid pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007577 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a swelling in the neck resulting from an enlarged thyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Goitre</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺肿</obo:OAE_0001849>
        <obo:OAE_0004334>10018498</obo:OAE_0004334>
        <rdfs:label>goitre AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007578 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001364"/>
        <obo:IAO_0000115>This is an AE which is a common complication of critical illness affecting between 30 and 60% of critically ill patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21989699/</obo:IAO_0000119>
        <obo:OAE_0001849>急性肾功能衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10038436</obo:OAE_0004334>
        <rdfs:label>renal failure acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007579 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004318"/>
        <obo:IAO_0000115>This is an AE which the patient experiences high fever, abdominal pain and pain while passing urine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Excretory_system#Acute_Pyelonephritis</obo:IAO_0000119>
        <obo:OAE_0001849>急性肾盂肾炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037597</obo:OAE_0004334>
        <rdfs:label>pyelonephritis acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007580 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a tumor of the pancreas that is derived from beta cells and secretes insulin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Insulinoma</obo:IAO_0000119>
        <obo:OAE_0001849>胰岛瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10022498</obo:OAE_0004334>
        <rdfs:label>insulinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007581 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which is a form of diabetes that is characterized by high blood sugar, insulin resistance, and relative lack of insulin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Type_2_diabetes</obo:IAO_0000119>
        <obo:OAE_0001849>胰岛素抵抗糖尿病</obo:OAE_0001849>
        <obo:OAE_0004334>10022491</obo:OAE_0004334>
        <rdfs:label>insulin resistant diabetes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007582 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <obo:IAO_0000115>This is an AE which refers to an above normal level of insulin in the blood of a person or animal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperinsulinism</obo:IAO_0000119>
        <obo:OAE_0001849>胰岛素过多</obo:OAE_0001849>
        <obo:OAE_0004334>10061211</obo:OAE_0004334>
        <rdfs:label>hyperinsulinism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007583 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001977"/>
        <obo:IAO_0000115>This is an AE which is the condition that occurs due to excessive production of thyroid hormones by the thyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperthyroidism</obo:IAO_0000119>
        <obo:OAE_0001849>原发性甲亢</obo:OAE_0001849>
        <obo:OAE_0004334>10075899</obo:OAE_0004334>
        <rdfs:label>primary hyperthyroidism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007584 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003258"/>
        <obo:IAO_0000115>This is an AE which is usually caused by a tumor within the parathyroid gland.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_hyperparathyroidism</obo:IAO_0000119>
        <obo:OAE_0001849>原发性甲状旁腺功能亢进症</obo:OAE_0001849>
        <obo:OAE_0004334>10020707</obo:OAE_0004334>
        <rdfs:label>hyperparathyroidism primary AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007585 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001063"/>
        <obo:IAO_0000115>This is an AE which is a common endocrinological process, characterized by chronic elevation of serum concentrations of calcium and parathyroid hormone (PTH).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28992983/</obo:IAO_0000119>
        <obo:OAE_0001849>原发性甲状腺功能减退症</obo:OAE_0001849>
        <obo:OAE_0004334>10036697</obo:OAE_0004334>
        <rdfs:label>primary hypothyroidism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007586 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers to the excess production of the hormone aldosterone from the adrenal glands, resulting in low renin levels and high blood pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_aldosteronism</obo:IAO_0000119>
        <obo:OAE_0001849>原发性醛固酮增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10036692</obo:OAE_0004334>
        <rdfs:label>primary hyperaldosteronism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007587 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003255"/>
        <obo:IAO_0000115>This is an AE which is a rare long-term endocrine disorder characterized by inadequate production of the steroid hormones cortisol and aldosterone by the two outer layers of the cells of the adrenal glands (adrenal cortex), causing adrenal insufficiency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Addison%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>原发性肾上腺皮质功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10052381</obo:OAE_0004334>
        <rdfs:label>primary adrenal insufficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007588 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <obo:IAO_0000115>This is an AE which is an area of swelling (edema) of the lower layer of skin and tissue just under the skin or mucous membranes and is idiopathic .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angioedema</obo:IAO_0000119>
        <obo:OAE_0001849>原发性血管性水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10073257</obo:OAE_0004334>
        <rdfs:label>idiopathic angiedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by involuntary rhythmic contractions and relaxations (oscillations or twitching movements) of certain muscle groups in one or more body parts of unknown cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Essential_tremor</obo:IAO_0000119>
        <obo:OAE_0001849>原发性震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10015496</obo:OAE_0004334>
        <rdfs:label>essential tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007590 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001847"/>
        <obo:IAO_0000115>This is an AE which is a form of thyroiditis that can be a cause of both thyrotoxicosis and hypothyroidism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subacute_thyroiditis</obo:IAO_0000119>
        <obo:OAE_0001849>亚急性甲状腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10043784</obo:OAE_0004334>
        <rdfs:label>thyroiditis subacute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007591 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is an over-accumulation of dietary histamine in the human body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Histamine_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>组胺不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10068652</obo:OAE_0004334>
        <rdfs:label>histamine intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007592 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which refers a hereditary condition caused by a deficiency of liver enzymes that metabolise fructose.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fructose_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>果糖不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10072104</obo:OAE_0004334>
        <rdfs:label>fructose intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007593 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a common condition caused by a decreased ability to digest lactose, a sugar found in dairy products.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lactose_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>牛奶不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10011241</obo:OAE_0004334>
        <rdfs:label>cow&apos;s milk intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007594 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is a rare condition in which the cells lining the intestine cannot take in the sugars glucose and galactose, which prevents proper digestion of these molecules and larger molecules made from them.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glucose-galactose_malabsorption</obo:IAO_0000119>
        <obo:OAE_0001849>碳水化合物不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10071200</obo:OAE_0004334>
        <rdfs:label>carbohydrate intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007595 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>This is an AE which is the condition in which sucrase-isomaltase, an enzyme needed for proper metabolism of sucrose (sugar) and starch (e.g., grains), is not produced or the enzyme produced is either partially functional or non-functional in the small intestine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sucrose_intolerance</obo:IAO_0000119>
        <obo:OAE_0001849>蔗糖不耐受</obo:OAE_0001849>
        <obo:OAE_0004334>10042432</obo:OAE_0004334>
        <rdfs:label>sucrose intolerance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007596 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002493"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth or development of cells (microscopic scale) or organs (macroscopic scale), and the abnormal histology or anatomical structure resulting from such growth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10058314</obo:OAE_0004334>
        <rdfs:label>dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007597 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002493"/>
        <obo:IAO_0000115>This is an AE which is when a child who has reached a certain developmental stage begins to lose previously acquired milestones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Developmental_regression</obo:IAO_0000119>
        <obo:OAE_0001849>发育退化</obo:OAE_0001849>
        <obo:OAE_0004334>10076709</obo:OAE_0004334>
        <rdfs:label>developmental regression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007598 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002493"/>
        <obo:IAO_0000115>This is an AE which is a congenital abnormality of brain development where the neurons in an area of the brain failed to migrate in the proper formation in utero.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Focal_cortical_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>皮质发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10070666</obo:OAE_0004334>
        <rdfs:label>cortical dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000448"/>
        <obo:IAO_0000115>This is an AE which incidence rate was equal to 5.96/1,000 infants, which would result in 2.0 IQ points loss in 34.31% of the newborns.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30427427/</obo:IAO_0000119>
        <obo:OAE_0001849>轻度精神发育迟滞</obo:OAE_0001849>
        <obo:OAE_0004334>10027618</obo:OAE_0004334>
        <rdfs:label>mild mental retardation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007600 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <obo:IAO_0000115>This is an AE which comprise a group of psychiatric conditions originating in childhood that involve serious impairment in different areas such as speech disorder developmental.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Developmental_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>言语障碍发育</obo:OAE_0001849>
        <obo:OAE_0004334>10041467</obo:OAE_0004334>
        <rdfs:label>speech disorder developmental AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007601 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin disorder that generally presents, but not exclusively, as erythematous plaques or flat patches without hair primarily on the scalp, neck and face.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alopecia_mucinosa</obo:IAO_0000119>
        <obo:OAE_0001849>毛囊皮脂腺粘蛋白沉积症</obo:OAE_0001849>
        <obo:OAE_0004334>10056506</obo:OAE_0004334>
        <rdfs:label>follicular mucinosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007602 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001964"/>
        <obo:IAO_0000115>This is an AE which is an inflammation caused by viral of one or both parotid glands, the major salivary glands located on either side of the face, in humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parotitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性腮腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10072589</obo:OAE_0004334>
        <rdfs:label>viral parotitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007603 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000401"/>
        <obo:IAO_0000115>This is an AE which is small tubular structures of the skin that produce sweat and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sweat_gland</obo:IAO_0000119>
