        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a generic term applied to skin rashes in the diaper area that are caused by various skin disorders and/or irritants.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
