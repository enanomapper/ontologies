    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005422 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001752"/>
