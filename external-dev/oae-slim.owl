        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32636059/</obo:IAO_0000119>
        <obo:OAE_0001849>肛门括约肌张力亢进</obo:OAE_0001849>
        <obo:OAE_0004334>10066894</obo:OAE_0004334>
        <rdfs:label>anal sphincter hypertonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005723 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is a pre-cancerous condition which occurs when the lining of the anal canal undergoes abnormal changes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anal_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>肛门-生殖器发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10051999</obo:OAE_0004334>
        <rdfs:label>anogenital dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005724 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005724">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004229"/>
        <obo:IAO_0000115>This is an AE which is a sexually transmitted infection caused by certain types of human papillomavirus (HPV).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Genital_wart</obo:IAO_0000119>
        <obo:OAE_0001849>肛门-生殖器疣</obo:OAE_0001849>
        <obo:OAE_0004334>10059313</obo:OAE_0004334>
        <rdfs:label>anogenital warts AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005725 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which refers to acute or subacute arthritis in association with, or as a reaction to, an enteric (usually colonic) inflammatory condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enteropathic_arthropathy</obo:IAO_0000119>
        <obo:OAE_0001849>关节炎肠病</obo:OAE_0001849>
        <obo:OAE_0004334>10003253</obo:OAE_0004334>
        <rdfs:label>arthritis enteropathic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005726 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002358"/>
        <obo:IAO_0000115>This is an AE which refer to a transient abnormal enlargement of a body part or area such as anorectal not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>肛门直肠的肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10074526</obo:OAE_0004334>
        <rdfs:label>anorectal swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005727 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder of the immune system condition that affects infants, young children and (rarely) adults causing severe diarrhea, vomiting, and other morbidities of the digestive tract.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_enteropathy</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性肠病</obo:OAE_0001849>
        <obo:OAE_0004334>10081456</obo:OAE_0004334>
        <rdfs:label>autoimmune enteropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005728 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>This is an AE which is a mass often found trapped in the gastrointestinal system,though it can occur in other locations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bezoar</obo:IAO_0000119>
        <obo:OAE_0001849>胃肠石</obo:OAE_0001849>
        <obo:OAE_0004334>10004542</obo:OAE_0004334>
        <rdfs:label>bezoar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005729 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000496"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the gastrointestinal tract caused by campylobacter .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastroenteritis</obo:IAO_0000119>
        <obo:OAE_0001849>弯曲杆菌肠胃炎</obo:OAE_0001849>
        <obo:OAE_0004334>10007048</obo:OAE_0004334>
        <rdfs:label>campylobacter gastroenteritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005730 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000825"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory bowel disease affecting the colon specifically with peak incidence in the 5th decade of life, affecting women more than men.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Collagenous_colitis</obo:IAO_0000119>
        <obo:OAE_0001849>胶原性结肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048928</obo:OAE_0004334>
        <rdfs:label>colitis collagenous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005731 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor of epithelial tissue colon with glandular origin, glandular characteristics, or both.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adenoma</obo:IAO_0000119>
        <obo:OAE_0001849>结肠腺瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10048832</obo:OAE_0004334>
        <rdfs:label>colon adenoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005732 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which is any of various types of abnormal growth  or development of cells (microscopic scale) and/or organs (macroscopic scale) such as colon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>结肠发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10071161</obo:OAE_0004334>
        <rdfs:label>colon dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005733 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005733">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is the second most commonly injured intra-abdominal organ in penetrating trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23336650/</obo:IAO_0000119>
        <obo:OAE_0001849>结肠损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10057669</obo:OAE_0004334>
        <rdfs:label>colon injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005734 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004238"/>
        <obo:IAO_0000115>This is an AE which used this technique in infants with intestinal obstruction due to anorectal malformations, intestinal atresias, and post-NEC strictures, to good effect.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15243777/</obo:IAO_0000119>
        <obo:OAE_0001849>结肠灌洗</obo:OAE_0001849>
        <obo:OAE_0004334>10074741</obo:OAE_0004334>
        <rdfs:label>colonic lavage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005735 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005735">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004238"/>
        <obo:IAO_0000115>This is an AE which is a polyp (fleshy growth) occurring on the lining of the colon or rectum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Colorectal_polyp</obo:IAO_0000119>
        <obo:OAE_0001849>结肠息肉</obo:OAE_0001849>
        <obo:OAE_0004334>10010003</obo:OAE_0004334>
        <rdfs:label>colonic polyp AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005736 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001918"/>
        <obo:IAO_0000115>This is an AE which is an infection that affects part of the urinary tract caused by escherichia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Urinary_tract_infection</obo:IAO_0000119>
        <obo:OAE_0001849>膀胱炎大肠</obo:OAE_0001849>
        <obo:OAE_0004334>10011790</obo:OAE_0004334>
        <rdfs:label>cystitis escherichia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005738 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004230"/>
        <obo:IAO_0000115>This is an AE which is uncommonly found on upper endoscopy and can be categorized as subepithelial or mucosally-based.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26811610/</obo:IAO_0000119>
        <obo:OAE_0001849>十二指肠息肉</obo:OAE_0001849>
        <obo:OAE_0004334>10013833</obo:OAE_0004334>
        <rdfs:label>duodenal polyp AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005739 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004230"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the duodenum and  may persist acutely or chronically.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Duodenitis</obo:IAO_0000119>
        <obo:OAE_0001849>十二指肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10013864</obo:OAE_0004334>
        <rdfs:label>duodenitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005740 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004230"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the duodenum  with haemorrhagic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Duodenitis</obo:IAO_0000119>
        <obo:OAE_0001849>十二指肠炎出血</obo:OAE_0001849>
        <obo:OAE_0004334>10013865</obo:OAE_0004334>
        <rdfs:label>duodenitis hemorrhagic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005741 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which consists of retrograde passage of alkaline duodenal contents into the stomach; it may occur due to antroduodenal motility disorder (primary DGR) or may arise following surgical alteration of gastoduodenal anatomy or because of biliary pathology (secondary DGR).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17285081/</obo:IAO_0000119>
        <obo:OAE_0001849>十二指肠胃反流</obo:OAE_0001849>
        <obo:OAE_0004334>10060865</obo:OAE_0004334>
        <rdfs:label>duodenogastric reflux AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005742 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001234"/>
        <obo:IAO_0000115>This is an AE which is uncommon disease caused by Herpes simplex virus (HSV).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33054791/</obo:IAO_0000119>
        <obo:OAE_0001849>疱疹食管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052330</obo:OAE_0004334>
        <rdfs:label>herpes esophagitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005743 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001234"/>
        <obo:IAO_0000115>This is an AE which is the second most common cause of infectious esophagitis and it occurs in both immunocompromised and immunocompetent patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31106821/</obo:IAO_0000119>
        <obo:OAE_0001849>单纯疱疹食管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10074242</obo:OAE_0004334>
        <rdfs:label>herpes simplex esophagitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005744 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers to bleeding from a laceration in the mucosa at the junction of the stomach and esophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mallory%E2%80%93Weiss_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>食管贲门粘膜撕裂综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10026712</obo:OAE_0004334>
        <rdfs:label>mallory-weiss syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005745 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is a failure of smooth muscle fibers to relax, which can cause the lower esophageal sphincter to remain closed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Esophageal_achalasia</obo:IAO_0000119>
        <obo:OAE_0001849>食管失弛缓性</obo:OAE_0001849>
        <obo:OAE_0004334>10030136</obo:OAE_0004334>
        <rdfs:label>esophageal achalasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005746 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is the most common type of infectious esophagitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31772927/</obo:IAO_0000119>
        <obo:OAE_0001849>食管念珠菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10030154</obo:OAE_0004334>
        <rdfs:label>esophageal candidiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005747 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is a malignancy that develops from oesophageal epithelial cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>食管癌</obo:OAE_0001849>
        <obo:OAE_0004334>10030155</obo:OAE_0004334>
        <rdfs:label>esophageal carcinoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005748 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which includs a spectrum of disorders affecting the oesophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastrointestinal_disease</obo:IAO_0000119>
        <obo:OAE_0001849>食管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061318</obo:OAE_0004334>
        <rdfs:label>esophageal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005749 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is the ability of oesophageal to move independently, using metabolic energy</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Motility</obo:IAO_0000119>
        <obo:OAE_0001849>食管运动减弱</obo:OAE_0001849>
        <obo:OAE_0004334>10067752</obo:OAE_0004334>
        <rdfs:label>esophageal hypomotility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005750 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which can cause chest pain, heartburn, or dysphagia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32866357/</obo:IAO_0000119>
        <obo:OAE_0001849>食管运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10072419</obo:OAE_0004334>
        <rdfs:label>esophageal motility disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005751 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the oesophageal  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>食管的水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10064342</obo:OAE_0004334>
        <rdfs:label>esophageal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is an uncommon disease that does not appear to predispose to esophageal cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11555097/</obo:IAO_0000119>
        <obo:OAE_0001849>食管乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10071192</obo:OAE_0004334>
        <rdfs:label>esophageal papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005753 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is a rupture of the esophageal wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Esophageal_rupture</obo:IAO_0000119>
        <obo:OAE_0001849>食管破裂</obo:OAE_0001849>
        <obo:OAE_0004334>10052211</obo:OAE_0004334>
        <rdfs:label>esophageal rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005754 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is a disorder of motility of the esophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Esophageal_spasm</obo:IAO_0000119>
        <obo:OAE_0001849>食管痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10030184</obo:OAE_0004334>
        <rdfs:label>esophageal spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005755 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001233"/>
        <obo:IAO_0000115>This is an AE which is a predictor of poor prognosis in patients with oesophageal cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29617789/</obo:IAO_0000119>
        <obo:OAE_0001849>食管狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10030194</obo:OAE_0004334>
        <rdfs:label>esophageal stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005756 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003375"/>
        <obo:IAO_0000115>This is an AE which occur mainly as a result of gastro-oesophageal reflux disease (GERD).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17465462/</obo:IAO_0000119>
        <obo:OAE_0001849>食管溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10030201</obo:OAE_0004334>
        <rdfs:label>esophageal ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005757 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001234"/>
        <obo:IAO_0000115>This is an AE which is a chronic condition in which stomach contents rise up into the esophagus, resulting in either symptoms or complications.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastroesophageal_reflux_disease</obo:IAO_0000119>
        <obo:OAE_0001849>反流性食管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10038263</obo:OAE_0004334>
        <rdfs:label>reflux esophagitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005758 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000212"/>
        <obo:IAO_0000115>This is an AE which is an abnormal connection (fistula) between the esophagus and the trachea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tracheoesophageal_fistula</obo:IAO_0000119>
        <obo:OAE_0001849>气管食管瘘</obo:OAE_0001849>
        <obo:OAE_0004334>10044310</obo:OAE_0004334>
        <rdfs:label>tracheo-esophageal fistula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005759 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003414"/>
        <obo:IAO_0000115>This is an AE which is rare and the most common causes are tuberculosis and malignancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/8737559/</obo:IAO_0000119>
        <obo:OAE_0001849>获得性气管食管瘘</obo:OAE_0001849>
        <obo:OAE_0004334>10000582</obo:OAE_0004334>
        <rdfs:label>acquired tracheo-esophageal fistula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005760 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004228"/>
        <obo:IAO_0000115>This is an AE which is a condition in which there is an abnormal (metaplastic) change in the mucosal cells lining the lower portion of the esophagus, from normal stratified squamous epithelium to simple columnar epithelium with interspersed goblet cells that are normally present only in the small intestine and large intestine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Barrett%27s_esophagus</obo:IAO_0000119>
        <obo:OAE_0001849>巴雷特食管</obo:OAE_0001849>
        <obo:OAE_0004334>10004137</obo:OAE_0004334>
        <rdfs:label>barrett&apos;s oesophagus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005761 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001234"/>
        <obo:IAO_0000115>This is an AE which is a disease characterized by inflammation with erosive of the esophagus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Esophagitis</obo:IAO_0000119>
        <obo:OAE_0001849>侵蚀性食管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10063655</obo:OAE_0004334>
        <rdfs:label>erosive esophagitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005762 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which refers to the state in the stomach where gastric acid levels are higher than the reference range.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperchlorhydria</obo:IAO_0000119>
        <obo:OAE_0001849>胃酸过多症</obo:OAE_0001849>
        <obo:OAE_0004334>10020601</obo:OAE_0004334>
        <rdfs:label>hyperchlorhydria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005763 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which is an abnormality in the stomach caused by chemicals, e.g. bile, alcohol, and characteristically has minimal inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Reactive_gastropathy</obo:IAO_0000119>
        <obo:OAE_0001849>反应性胃病</obo:OAE_0001849>
        <obo:OAE_0004334>10075425</obo:OAE_0004334>
        <rdfs:label>reactive gastropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005764 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>This is an AE which refer to states where the production of hydrochloric acid in gastric secretions of the stomach and other digestive organs is absent or low, respectively.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Achlorhydria</obo:IAO_0000119>
        <obo:OAE_0001849>胃酸缺乏症</obo:OAE_0001849>
        <obo:OAE_0004334>10000451</obo:OAE_0004334>
        <rdfs:label>achlorhydria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005765 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000968"/>
        <obo:IAO_0000115>This is an AE which refers to a wide range of problems of the gastric tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastritis#Chronic</obo:IAO_0000119>
        <obo:OAE_0001849>慢性胃炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008882</obo:OAE_0004334>
        <rdfs:label>chronic gastritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005766 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001446"/>
        <obo:IAO_0000115>This is an AE which remains a common and potentially life-threatening complication of allogeneic hematopoietic stem cell transplantation (HCT).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25398933/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性移植物抗宿主病</obo:OAE_0001849>
        <obo:OAE_0004334>10066261</obo:OAE_0004334>
        <rdfs:label>chronic graft versus host disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005767 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000968"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the lining of the stomach caused by helicobacter.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gastritis</obo:IAO_0000119>
        <obo:OAE_0001849>幽门螺杆菌胃炎</obo:OAE_0001849>
        <obo:OAE_0004334>10054272</obo:OAE_0004334>
        <rdfs:label>helicobacter gastritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005768 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a genus of Gram-negative bacteria possessing a characteristic helical shape and causes infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Helicobacter</obo:IAO_0000119>
        <obo:OAE_0001849>幽门螺杆菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054263</obo:OAE_0004334>
        <rdfs:label>helicobacter infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005769 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000303"/>
        <obo:IAO_0000115>This is an AE which is a painful mouth infection caused by coxsackieviruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Herpangina</obo:IAO_0000119>
        <obo:OAE_0001849>疱疹性咽峡炎</obo:OAE_0001849>
        <obo:OAE_0004334>10019936</obo:OAE_0004334>
        <rdfs:label>herpangina AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005770 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000343"/>
        <obo:IAO_0000115>This is an AE which is inflammation caused by herpes of the back of the throat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pharyngitis</obo:IAO_0000119>
        <obo:OAE_0001849>疱疹咽炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066888</obo:OAE_0004334>
        <rdfs:label>herpes pharyngitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005771 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000343"/>
        <obo:IAO_0000115>This is an AE which is inflammation caused by herpes zoster of the back of the throat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pharyngitis</obo:IAO_0000119>
        <obo:OAE_0001849>带状疱疹咽炎</obo:OAE_0001849>
