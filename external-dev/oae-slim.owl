    <!-- http://purl.obolibrary.org/obo/OAE_0002488 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>skin cyst AE is a skin AE that occurs when  a cluster of cells that have grouped together to form a sac which may contain air, fluids, or semi-solid material.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, SJ</obo:IAO_0000117>
        <obo:IAO_0000118>cyst</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0004334>10011732</obo:OAE_0004334>
        <rdfs:label xml:lang="en">skin cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002489 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>conductive hearing loss AE is a hearing loss AE that results from probelms with the ear canal, ear drum, or middle ear and its little bones.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000118>sensorineural hearing loss (SNHL)</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.hearingloss.org/content/types-causes-and-treatment</obo:IAO_0000119>
        <obo:OAE_0004334>10010282</obo:OAE_0004334>
        <rdfs:label xml:lang="en">conductive hearing loss AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002490 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <obo:IAO_0000115>transient hearing loss AE is a hearing loss AE that results from poor ventilation of the middle ear in children.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000118>deafness transitory </obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3139416/
</obo:IAO_0000119>
        <obo:OAE_0004334>10011900</obo:OAE_0004334>
        <rdfs:label xml:lang="en">transient hearing loss AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002491 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>a psychiatric disorder AE that results in a persistent false psychotic belief regarding the self or objects outside the self that is maintained despite indisputable evidence to the contrary.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.merriam-webster.com/dictionary/delusion</obo:IAO_0000119>
        <obo:OAE_0004334>10012239</obo:OAE_0004334>
        <rdfs:label xml:lang="en">delusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002492 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>a behavioral and neurological AE that results in long-standing need for the person to be taken care of and a fear of being abandoned or separated from important individuals.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://psychcentral.com/disorders/dependent-personality-disorder-symptoms/</obo:IAO_0000119>
        <obo:OAE_0004334>10012355</obo:OAE_0004334>
        <rdfs:comment>Individuals with Dependent Personality Disorder are often characterized by pessimism and self-doubt, and tend to belittle their abilities and assets. This leads the person to engage in dependent and submissive behaviors that are designed to elicit care-giving behaviors in others.</rdfs:comment>
        <rdfs:label xml:lang="en">dependent personality disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002493 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>Nervous system AE that results in failure to meet certain developmental milestones, such as sitting, walking, and talking, at the average age.  Developmental delay may indicate a problem in development of the central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/developmental+delay</obo:IAO_0000119>
        <obo:OAE_0004334>10012559</obo:OAE_0004334>
        <rdfs:label xml:lang="en">developmental delay AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002494 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <obo:IAO_0000115>diabetic ketoacidosis AE  is a cardiovascular AE that develops when your body is unable to produce enough insulin and begins to break down fat as an alternate fuel, this process produces a buildup of toxic acids in the bloodstream called ketones.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/diabetic-ketoacidosis/basics/definition/con-20026470</obo:IAO_0000119>
        <obo:OAE_0004334>10012671</obo:OAE_0004334>
        <rdfs:label xml:lang="en">diabetic ketoacidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002496 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>congenital diaphragmatic hernia AE is a congential disorder in which an absent or partially formed diaphragm results in an abnormal opening that allows the stomach and intestines to move into the chest cavity and crowd the heart and lungs. This crowding can lead to underdevelopment of the lungs, potentially resulting in life-threatening breathing difficulties that are apparent from birth.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aspiration</obo:IAO_0000119>
        <obo:OAE_0004334>10061106</obo:OAE_0004334>
        <rdfs:label xml:lang="en">congenital diaphragmatic hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002497 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>a paralysis AE that has an outcome of  paralysis affecting symmetrical parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Diplegia</obo:IAO_0000119>
        <obo:OAE_0004334>10013033</obo:OAE_0004334>
        <rdfs:label xml:lang="en">diplegia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002498 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001918"/>
        <obo:IAO_0000115>cystitis interstitial AE is a cystitis AE that has an outcome of cystitis interstitial, which is a condition that causes discomfort or pain in the bladder and a need to urinate frequently and urgently.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/interstitialcystitis.html</obo:IAO_0000119>
        <obo:OAE_0004334>10011796</obo:OAE_0004334>
        <rdfs:label xml:lang="en">cystitis interstitial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002499 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <obo:IAO_0000115>A disseminated tuberculosis AE is a tuberculosis AE that has an outcome of disseminated tuberculosis, which is a contagious bacterial infection in which TB bacteria has spread from the lungs to other parts of the body through the blood or lymph system.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000624.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10013453</obo:OAE_0004334>
        <rdfs:label xml:lang="en">disseminated tuberculosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002500 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000533"/>
        <obo:IAO_0000115>Exotosis AE is a bone pain AE that has resulted in a non-neoplastic overgrowth of bone.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Exostosis</obo:IAO_0000119>
        <obo:OAE_0004334>10015688</obo:OAE_0004334>
        <rdfs:label xml:lang="en">exotosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002501 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115 xml:lang="en">An exudative retinopathy AE is an eye AE that shows an outcome of exudative retinopathy marked by masses of white or yellowish exudate in the posterior part of the fundus oculi, with deposits of cholesterol and blood debris from retinal hemorrhage, that leads to destruction of the macula and blindness.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Coats&apos; disease, Coats&apos; retinitis</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/exudative+retinopathy
</obo:IAO_0000119>
        <obo:OAE_0004334>10015901</obo:OAE_0004334>
        <rdfs:label xml:lang="en">exudative retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002502 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>A tendon disorder AE that has an outcome of tendinous which is damage to a tendon at a cellular level. It is thought to be caused by microtears in the connective tissue in and around the tendon, leading to an increase in tendon repair cells.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tendinosis
</obo:IAO_0000119>
        <obo:OAE_0004334>10016662</obo:OAE_0004334>
        <rdfs:label xml:lang="en">tendinous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002503 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001678"/>
        <obo:IAO_0000115>A monocyte percentage abnormal AE that results in abnormally high levels of monocytes in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Monocytosis</obo:IAO_0000119>
        <obo:OAE_0004334>10027906</obo:OAE_0004334>
        <rdfs:label xml:lang="en">monocytosis AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C35147</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002504 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>A male reproductive system AE that has an outcome of genital candidiasis, which is a fungal infection due to any types of Candida (types of yeasts). This is a fungal infection of the genital region.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Candidiasis</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.cdc.gov/fungal/diseases/candidiasis/genital/</obo:IAO_0000119>
        <obo:OAE_0004334>10018143</obo:OAE_0004334>
        <rdfs:label xml:lang="en">genital candidiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002505 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.webmd.com/pain-management/tc/groin-problems-and-injuries-topic-overview</obo:IAO_0000119>
        <obo:OAE_0004334>10018735</obo:OAE_0004334>
        <rdfs:comment>A groin pain AE is a pain AE that shows a pain in the groin area.</rdfs:comment>
        <rdfs:label xml:lang="en">groin pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002506 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>A blood disorder AE that has an outcome of the breakdown of red blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hemolysis
</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/002372.htm
</obo:IAO_0000119>
        <obo:OAE_0004334>10018910</obo:OAE_0004334>
        <rdfs:label xml:lang="en">haemolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002507 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000562"/>
        <obo:IAO_0000115>A hepatosplenomegaly AE is a liver inflammation AE that has an outcome of an abnormal enlargement of the liver and spleen.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB:  http://www.nlm.nih.gov/medlineplus/ency/imagepages/17215.htm
</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=3716</obo:IAO_0000119>
        <obo:OAE_0004334>10019847</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hepatosplenomegaly AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002508 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <obo:IAO_0000115>A gastric disorder AE that occurs when part of your stomach pushes upward through your diaphragm.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/hiatal-hernia/basics/definition/con-20030640
</obo:IAO_0000119>
        <obo:OAE_0004334>10020028</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hiatus hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002509 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <obo:IAO_0000115>A viral infection AE that is caused by the human immunodeficiency virus.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:OAE_0004334>10020161</obo:OAE_0004334>
        <rdfs:label xml:lang="en">HIV infection AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C3108
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002510 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>A hypertonic bladder AE is a digestive system AE that where the bladder-storage function that causes a sudden urge to urinate.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000118>irritable bladder</obo:IAO_0000118>
        <obo:IAO_0000118>overactive bladder
</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://healbladder.info/healbladder/hypertonic-bladder</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/overactive-bladder/basics/definition/con-20027632
</obo:IAO_0000119>
        <obo:OAE_0004334>10020853</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypertonic bladder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002511 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115>A hypovitaminosis AE is a gustatory system AE which shows an insufficiency of one or more essential vitamins.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypovitaminosis</obo:IAO_0000119>
        <obo:OAE_0004334>10021135</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypovitaminosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002512 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <obo:IAO_0000115>A gastrointestinal disorder AE that shows the inflammation of the ileum.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ileitis
</obo:IAO_0000119>
        <obo:OAE_0004334>10021312</obo:OAE_0004334>
        <rdfs:label xml:lang="en">ileitis AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C84782
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002513 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>A joint pain AE that occurs when there is an abnormal separation in the joint, where two or more bones meet.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>dislocated joint, luxation
</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Joint_dislocation
</obo:IAO_0000119>
        <obo:OAE_0004334>10023204</obo:OAE_0004334>
        <rdfs:label xml:lang="en">joint dislocation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002514 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>A syndrome AE that shows Kawasaki&apos;s disease, a vasculitis characterized by inflammation of the arteries, particularly the coronary arteries. The vasculitis may lead to aneurysm formation and possibly, heart attacks. It affects young children who usually present with persistent high fever, redness of the mucous membranes of the mouth, redness of the palms and soles, skin rashes, lymphadenitis, and joint pain and swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Mucocutaneous Lymph Node Syndrome
</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Kawasaki_disease
</obo:IAO_0000119>
        <obo:OAE_0004334>10023320</obo:OAE_0004334>
        <rdfs:label xml:lang="en">kawasaki disease AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C34825
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002515 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>An abscess AE where a bacterial, parasitic, or fungal abscess that develops in the liver. It is usually the result of an abdominal infection, trauma, or surgery in the right upper quadrant. Signs and symptoms include abdominal pain, nausea, vomiting, and fever.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Liver_abscess
</obo:IAO_0000119>
        <obo:OAE_0004334>10024652</obo:OAE_0004334>
        <rdfs:label xml:lang="en">liver abscess AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C99089
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002516 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <obo:IAO_0000115>A blood disorder AE that the body&apos;s blood supply will stop moving after the heart has stopped pumping it around the inside of the deceased.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.exploreforensics.co.uk/rigor-mortis-and-lividity.html
</obo:IAO_0000119>
        <obo:OAE_0004334>10024728</obo:OAE_0004334>
        <rdfs:label xml:lang="en">lividity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002517 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>A lymphangitis AE is an inflammation AE that has an infection of the lymph vessels (channels).</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/007296.htm
</obo:IAO_0000119>
        <obo:OAE_0004334>10025226</obo:OAE_0004334>
        <rdfs:label xml:lang="en">lymphangitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002518 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000112>An infection adverse event that results in malaria, a protozoan infection caused by the genus Plasmodium. There are four species of Plasmodium that can infect humans: Plasmodium falciparum, vivax, ovale, and malariae. It is transmitted to humans by infected mosquitoes. Signs and symptoms include paroxysmal high fever, sweating, chills, and anemia.</obo:IAO_0000112>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Malaria</obo:IAO_0000119>
        <obo:OAE_0004334>10025487</obo:OAE_0004334>
        <rdfs:label xml:lang="en">malaria AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C34797
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002519 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <obo:IAO_0000115>A metabolic disoder AE where there is increased acidity in the blood secondary to acid base imbalance. Causes include diabetes, kidney failure and shock.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Acidosis
</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000335.htm
</obo:IAO_0000119>
        <obo:OAE_0004334>10027417</obo:OAE_0004334>
        <rdfs:label xml:lang="en">metabolic acidosis AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C28228
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002520 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <obo:IAO_0000115>An abnormal stool AE that has an outcome of a significant amount of mucus in the stool. The mucus is accompanied by diarrhea, pain or blood may signify an intestinal condition such as infection or inflammation. Increased amounts of mucus in the stool can also occur with cancers of the colon or rectum or with bowel obstruction.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/mucus-in-stool</obo:IAO_0000119>
        <obo:OAE_0004334>10028140</obo:OAE_0004334>
        <rdfs:label xml:lang="en">mucous stool AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002521 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <obo:IAO_0000115>A muscle spasm AE that has an outcome of tight or stiff muscles and an inability to control those muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH, MW, MW</obo:IAO_0000117>
        <obo:IAO_0000118>spasticity AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.webmd.com/pain-management/pain-management-spasticity</obo:IAO_0000119>
        <obo:OAE_0004334>10028335</obo:OAE_0004334>
        <obo:OAE_0004334>10041416</obo:OAE_0004334>
        <rdfs:label xml:lang="en">muscle spasticity AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12820</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C79750</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002522 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <obo:IAO_0000115>A respiratory distress AE that has an outcome of a newborn dyspnea (i.e., impaired breathing) with cyanosis, most frequently occurring in premature infants, children of diabetic mothers and infants delivered by cesarean section, and sometimes with no predisposing cause.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Newborn Respiratory Distress Syndrome</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001563.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10001052</obo:OAE_0004334>
        <rdfs:label xml:lang="en">neonatal respiratory distress AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C27560</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002523 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000039"/>
        <obo:IAO_0000115>A neutrophil count increased AE that has an outcome of an abnormally high level of neutrophils in the blood.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Neutrophilia</obo:IAO_0000119>
        <obo:OAE_0004334>10029379</obo:OAE_0004334>
        <rdfs:label xml:lang="en">neutrophilia AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C35164</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002524 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>A male reproductive system AE that results in an inflammation of one or both testes due to viral or bacterial infections. Signs and symptoms include enlargement or tenderness of the affected testis, inguinal lymphadenopathy, blood in the semen, and pain during urination, intercourse, or ejaculation.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001280.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10031064</obo:OAE_0004334>
        <rdfs:label xml:lang="en">orchitis AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C97145</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002525 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>an inflammation AE that occurs in a bone.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Osteitis fibrosa</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001252.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10031149</obo:OAE_0004334>
        <rdfs:label xml:lang="en">osteitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002526 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>A bone disorder AE that has an dissolution of bone, especially the removal or loss of the calcium of bone.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Osteolysis</obo:IAO_0000119>
        <obo:OAE_0004334>10031248</obo:OAE_0004334>
        <rdfs:label xml:lang="en">osteolysis AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C50681</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002527 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>An arrhythmia AE that has an outcome of palpitations, an abnormality of heartbeat characterized by simultaneous awareness of one’s pulse and discomfort.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Palpitations</obo:IAO_0000119>
        <obo:OAE_0004334>10033557</obo:OAE_0004334>
        <rdfs:label xml:lang="en">palpitations AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10163</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C37999</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002528 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>A skin AE that shows a solid, raised spot on the skin that is up to 0.5 centimeter wide, which is a type of skin lesion.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003233.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10033733</obo:OAE_0004334>
        <rdfs:label xml:lang="en">papule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002529 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000535"/>
        <obo:IAO_0000115>A parotid gladn enlargement AE that has an outcome of parotitis, the inflammation of one or more of the parotid glands.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/882461-overview</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001041.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10034038</obo:OAE_0004334>
        <rdfs:label xml:lang="en">parotitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002530 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>A male reproductive system AE that has an disorder in a penis, including priapism, Peyronie&apos;s disease, balanitis, phimosis, paraphimosis, and penile cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/penis_disorders/article.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10034336</obo:OAE_0004334>
        <rdfs:label xml:lang="en">penis disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002531 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <obo:IAO_0000115>An abdominal AE that shows an inflammation of the peritoneum, the thin tissue that lines the inner wall of the abdomen and covers most of the abdominal organs.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Peritonitis</obo:IAO_0000119>
        <obo:OAE_0004334>10034674</obo:OAE_0004334>
        <rdfs:label xml:lang="en">peritonitis AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C26849</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002533 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>An arthritis AE that has an outcome of polyarthritis, which includes any type of arthritis that involves 5 or more joints simultaneously.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polyarthritis</obo:IAO_0000119>
        <obo:OAE_0004334>10036030</obo:OAE_0004334>
        <rdfs:label xml:lang="en">polyarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002534 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>A male reproductive system AE that affects prostatic gland in the male reproductive system.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.britannica.com/EBchecked/topic/479519/prostatic-disorder</obo:IAO_0000119>
        <obo:OAE_0004334>10036956</obo:OAE_0004334>
        <rdfs:label xml:lang="en">prostatic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002535 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>A tumor AE that shows a benign disorder of lymphoid cells or histiocytes that produces clinical features of a malignant lymphoma.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/pseudolymphoma</obo:IAO_0000119>
        <obo:OAE_0004334>10037108</obo:OAE_0004334>
        <rdfs:label xml:lang="en">pseudo lymphoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002536 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>A skin AE that shows a pyogenic skin disease. These include superficial bacterial infections such as impetigo, impetigo contagiosa, ecthyma, folliculitis, Bockhart&apos;s impetigo, furuncle, carbuncle, tropical ulcer, etc.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pyoderma</obo:IAO_0000119>
        <obo:OAE_0004334>10037632</obo:OAE_0004334>
        <rdfs:label xml:lang="en">pyoderma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002537 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <obo:IAO_0000115>A urine abnormality AE that shows the presence of white blood cells or pus in the urine, usually a sign of urinary tract infection.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pyuria</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/pyuria</obo:IAO_0000119>
        <obo:OAE_0004334>10037686</obo:OAE_0004334>
        <rdfs:label xml:lang="en">pyuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002538 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001579"/>
        <obo:IAO_0000115>a blood sodium abnormal AE that is characterized by an abnormally high level of sodium in the blood</obo:IAO_0000115>
        <obo:IAO_0000117>YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>hypernaetremia</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/241094-overview</obo:IAO_0000119>
        <obo:OAE_0004334>10020679</obo:OAE_0004334>
        <obo:OAE_0004334>10020680</obo:OAE_0004334>
        <rdfs:label xml:lang="en">hypernatremia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12293</rdfs:seeAlso>
        <rdfs:seeAlso>HPO: HP_0003228</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C37970</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0595878</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002539 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>A rash AE that shows a rash like measles. The rash consists of macular lesions that are red and usually 2–10 mm in diameter but may be confluent in places.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>measles-like maculopapular rash AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Morbilliform</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.wisegeek.com/what-is-a-morbilliform-rash.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10037870</obo:OAE_0004334>
        <rdfs:label xml:lang="en">morbilliform rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002540 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>A rash AE that shows a raised, blistery rash.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=11955</obo:IAO_0000119>
        <obo:OAE_0004334>10037898</obo:OAE_0004334>
        <rdfs:label xml:lang="en">vesicular rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002541 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001712"/>
        <obo:IAO_0000115>A red blood cell count increased AE that has an increased count of reticulocytes in the blood. Reticulocytes are slightly immature red blood cells.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003637.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10038792</obo:OAE_0004334>
        <rdfs:label xml:lang="en">reticulocyte count increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002542 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>a behavior and neurological AE that results in impaired or inhibited ego functioning in which the ability to process reality-based information is diminished and disordered.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/acute+psychosis</obo:IAO_0000119>
        <obo:OAE_0004334>10001022</obo:OAE_0004334>
        <rdfs:label xml:lang="en">acute psychosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002543 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>An eye AE that shows an abnormal blood vessel development in the retina of the eye and it occurs in infants that are born too early.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Terry syndrome</obo:IAO_0000118>
        <obo:IAO_0000118>retrolental fibroplasia</obo:IAO_0000118>
        <obo:IAO_0000118>retrolental fibroplasia (RLF)</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Retinopathy_of_prematurity</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001618.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10038933</obo:OAE_0004334>
        <rdfs:label xml:lang="en">retinopathy of prematurity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002544 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>A skin AE that results in a scar, a mark left on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Scar</obo:IAO_0000119>
        <obo:OAE_0004334>10039580</obo:OAE_0004334>
        <rdfs:label xml:lang="en">scar AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C34483</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002545 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>A skin AE that has an outcome of a localized or systemic chronic and progressive autoimmune disorder characterized by thickening of the skin and the connective tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Scleroderma</obo:IAO_0000119>
        <obo:OAE_0004334>10039710</obo:OAE_0004334>
        <rdfs:comment>Localized scleroderma affects only the skin. Systemic scleroderma affects internal organs, including the heart, lungs, gastrointestinal tract, and kidneys.</rdfs:comment>
        <rdfs:label xml:lang="en">scleroderma AE</rdfs:label>
        <rdfs:seeAlso>NCIT: C26746</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002546 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>A male reproductive system AE that has an outcome of an abnormal enlargement of the scrotum, the sac surrounding the testicles.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>scrotal edema</obo:IAO_0000118>
        <obo:IAO_0000118>scrotal swelling</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003161.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10039755</obo:OAE_0004334>
        <rdfs:label xml:lang="en">scrotal oedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002547 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>A skin AE that results in the degeneration and thinning of the epidermis and dermis.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>atrophy of the skin</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.wisegeek.com/what-is-skin-atrophy.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10040799</obo:OAE_0004334>
        <rdfs:label xml:lang="en">skin atrophy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13714</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C35163</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C35163</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002548 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <obo:IAO_0000115>A skin discoloration AE that shows the lightening of the skin, or loss of pigment.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>Depigmentation</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Depigmentation</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤脱色</obo:OAE_0001849>
        <obo:OAE_0004334>10040825</obo:OAE_0004334>
        <rdfs:label xml:lang="en">skin depigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002549 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <obo:IAO_0000115>A skin discoloration AE that shows abnormal lightening of skin due to decreased melanin production or deposition.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000118>Hypopigmentation, Pigment Dilution</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypopigmentation</obo:IAO_0000119>
        <obo:OAE_0004334>10040868</obo:OAE_0004334>
        <rdfs:comment>Vitiligo, albinism, and leukoderma are among the disorders that are associated with skin hypopigmentation.</rdfs:comment>
        <rdfs:label xml:lang="en">skin hypopigmentation AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E13721</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C78610</rdfs:seeAlso>
        <rdfs:seeAlso>http://en.wikipedia.org/wiki/Hypopigmentation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002550 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>An immune system disorder AE that has an disorder in spleen, the largest organ in the lymphatic system.</obo:IAO_0000115>
        <obo:IAO_0000117>KM, YH</obo:IAO_0000117>
        <obo:IAO_0000118>splenic diseases</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Splenic_disease</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.livescience.com/44725-spleen.html</obo:IAO_0000119>
        <obo:OAE_0004334>10041633</obo:OAE_0004334>
        <rdfs:label xml:lang="en">spleen disorder AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10056</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35823</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002551 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>a muscle AE that shows the absence or loss of control of voluntary muscle movements.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>URL: http://medical-dictionary.thefreedictionary.com/akinesia</obo:IAO_0000119>
        <obo:OAE_0004334>10001541</obo:OAE_0004334>
        <rdfs:label xml:lang="en">akinesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002552 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <obo:IAO_0000115>a seizure AE that shows a brief episode of signs and/or symptoms due to abnormal excessive or synchronous neuronal activity in the brain.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, YH</obo:IAO_0000117>
        <obo:IAO_0000118>epilepsy</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Epileptic_seizure</obo:IAO_0000119>
        <obo:OAE_0001849>癫痫</obo:OAE_0001849>
        <rdfs:label xml:lang="en">epileptic seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002553 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002601"/>
        <obo:IAO_0000115>a cranial neuropathy AE which shows an damage or abnormality to the nerves in the eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.allaboutvision.com/conditions/optic-neuritis.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10061323</obo:OAE_0004334>
        <rdfs:label xml:lang="en">optic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002554 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002553"/>
        <obo:IAO_0000115>an optic neuropathy AE characterized by optic disc swelling, peripapillary and macular hard exudates, and vitreous cells.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/6466175</obo:IAO_0000119>
        <obo:OAE_0004334>10060701</obo:OAE_0004334>
        <rdfs:label xml:lang="en">neuroretinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002555 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002056"/>
        <obo:IAO_0000115>an optic neuropathy AE characterized by vision loss, optic disc swelling, flame hemorrhages, and cotton-wool exudates. It occurs when blood flow is interrupted to the front (anterior) part of the optic nerve (also called optic nerve head).</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000118>AION</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/1216891-overview</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.geteyesmart.org/eyesmart/diseases/ischemic-optic-neuropathy/</obo:IAO_0000119>
        <obo:OAE_0004334>10068250</obo:OAE_0004334>
        <rdfs:label xml:lang="en">anterior ischemic optic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002556 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002555"/>
        <obo:IAO_0000115>a type of anterior ischemic optic neuropathy AE that presents primarily with vision loss, especially upon wakening, and sectorial disc edema.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://emedicine.medscape.com/article/1216891-clinical#a0217</obo:IAO_0000119>
        <obo:OAE_0004334>10068249</obo:OAE_0004334>
        <rdfs:label xml:lang="en">non-arteritic anterior ischemic optic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002557 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>a peripheral neuropathy AE that shows a combination of axonal and demyelinating neuropathy.</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.aafp.org/afp/2010/0401/p887.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">mixed neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002558 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001288"/>
        <obo:IAO_0000115>a peripheral sensory neuropathy AE that shows neuropathy in many sensory nerves at one time</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.merckmanuals.com/home/brain_spinal_cord_and_nerve_disorders/peripheral_nerve_disorders/polyneuropathy.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">sensory peripheral polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002559 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>a peripheral neuropathy AE that results from the loss of the myelin sheath on peripheral nerves roughly evenly distributed on both sides of the body</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <rdfs:label xml:lang="en">peripheral demyelinating polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002560 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>a neuropathy AE that shows nerve damage and occurs in a patient with diabetes</obo:IAO_0000115>
        <obo:IAO_0000117>RR, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/diabetic-neuropathy/basics/definition/con-20033336</obo:IAO_0000119>
        <obo:OAE_0004334>10012680</obo:OAE_0004334>
        <rdfs:label xml:lang="en">diabetic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002561 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>a nervous system AE that is an umbrella term referring to conditions relating to the nervous system, including loss of sensation and paralysis</obo:IAO_0000115>
