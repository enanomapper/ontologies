        <obo:OAE_0001849>寒冷的凝集素</obo:OAE_0001849>
        <obo:OAE_0004334>10050523</obo:OAE_0004334>
        <rdfs:label>cold agglutinins AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006967 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006967">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000419"/>
        <obo:IAO_0000115>This is an AE which is a rare adverse event following immunization (AEFI).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30808246/</obo:IAO_0000119>
        <obo:OAE_0001849>皮下结节</obo:OAE_0001849>
        <obo:OAE_0004334>10042348</obo:OAE_0004334>
        <rdfs:label>subcutaneous nodule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006968 -->


