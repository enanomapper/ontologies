        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000212"/>
        <obo:IAO_0000115>This is an AE which is an abnormal opening in the inner ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Labyrinthine_fistula</obo:IAO_0000119>
        <obo:OAE_0001849>迷宫状瘘</obo:OAE_0001849>
        <obo:OAE_0004334>10023563</obo:OAE_0004334>
        <rdfs:label>labyrinthine fistula AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005975 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005975">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>This is an AE which is a type of hearing disorder that is the perception of a single auditory stimulus as sounds of a different pitch in the two ears.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diplacusis</obo:IAO_0000119>
        <obo:OAE_0001849>复听</obo:OAE_0001849>
        <obo:OAE_0004334>10013032</obo:OAE_0004334>
        <rdfs:label>diplacusis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005976 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001561"/>
        <obo:IAO_0000115>This is an AE which is the obstruction of the nasolacrimal duct and may be acquired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nasolacrimal_duct_obstruction</obo:IAO_0000119>
        <obo:OAE_0001849>泪管狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10053990</obo:OAE_0004334>
        <rdfs:label>dacryostenosis acquired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005977 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002262"/>
        <obo:IAO_0000115>This is an AE which are due to either an acidic or alkali substance getting in the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chemical_eye_injury</obo:IAO_0000119>
        <obo:OAE_0001849>眼部化学灼伤</obo:OAE_0001849>
        <obo:OAE_0004334>10008422</obo:OAE_0004334>
        <rdfs:label>chemical burns of eye AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005978 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005978">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which can be visually devastating caused by herpes zoster.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26084658/</obo:IAO_0000119>
        <obo:OAE_0001849>带状疱疹坏死性视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10074253</obo:OAE_0004334>
        <rdfs:label>herpes zoster necrotising retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005979 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005979">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001296"/>
        <obo:IAO_0000115>This is an AE which forms the outer blood⁻retina barrier and facilitates the transepithelial transport of glucose into the outer retina via GLUT1.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30754662/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10038894</obo:OAE_0004334>
        <rdfs:label>retinal pigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005980 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005980">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003492"/>
        <obo:IAO_0000115>This is an AE which in contact lens wearers appears to be more common in patients wearing extended wear soft contact lenses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/8719670/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜浸润</obo:OAE_0001849>
        <obo:OAE_0004334>10011022</obo:OAE_0004334>
        <rdfs:label>corneal infiltrates AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005981 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a benign inflammatory condition usually confined to the orbit. This may involve single or multiple intraorbital structures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21546008/</obo:IAO_0000119>
        <obo:OAE_0001849>眼眶假瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10069692</obo:OAE_0004334>
        <rdfs:label>orbital pseudotumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005982 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a bodily function; it is a semi-autonomic rapid closing of the eyelid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blinking</obo:IAO_0000119>
        <obo:OAE_0001849>过度眨眼</obo:OAE_0001849>
        <obo:OAE_0004334>10065166</obo:OAE_0004334>
        <rdfs:label>excessive eye blinking AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005983 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a change of the human eyelid skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10074620</obo:OAE_0004334>
        <rdfs:label>eyelid rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005984 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000317"/>
        <obo:IAO_0000115>This is an AE which is a common side effect of various medical conditions which manifests as a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoesthesia</obo:IAO_0000119>
        <obo:OAE_0001849>触觉减退的眼睛</obo:OAE_0001849>
        <obo:OAE_0004334>10020939</obo:OAE_0004334>
        <rdfs:label>hypoesthesia eye AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005985 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000447"/>
        <obo:IAO_0000115>This is an AE which is a disorder of sight in which the brain fails to process inputs from one eye and over time favors the other eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amblyopia</obo:IAO_0000119>
        <obo:OAE_0001849>弱视，斜视</obo:OAE_0001849>
        <obo:OAE_0004334>10001912</obo:OAE_0004334>
        <rdfs:label>amblyopia strabismic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005986 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is a tissue that lines the inside of the eyelids and covers the sclera (the white of the eye) and its become discouration process.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctiva</obo:IAO_0000119>
        <obo:OAE_0001849>结膜变色</obo:OAE_0001849>
        <obo:OAE_0004334>10010712</obo:OAE_0004334>
        <rdfs:label>conjunctival discoloration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005987 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>This is an AE which is a type of rentinal detachment disease caused by  macular.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_disease#H35_Other_retinal_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑视网膜色素上皮脱落</obo:OAE_0001849>
        <obo:OAE_0004334>10071004</obo:OAE_0004334>
        <rdfs:label>detachment of macular retinal pigment epithelium AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005988 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a viral syndrome characterized by a panuveitis with necrotizing retinitis that may be complicated by retinal detachment, vaso-occlusion, optic neuropathy, and other causes of decreased visual acuity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26035758/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性视网膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10064997</obo:OAE_0004334>
        <rdfs:label>necrotising retinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005989 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune inflammatory disorder of the orbit and periorbital tissues, characterized by upper eyelid retraction, lid lag, swelling, redness (erythema), conjunctivitis, and bulging eyes (exophthalmos).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Graves%27_ophthalmopathy</obo:IAO_0000119>
        <obo:OAE_0001849>内分泌眼病</obo:OAE_0001849>
        <obo:OAE_0004334>10060742</obo:OAE_0004334>
        <rdfs:label>endocrine ophthalmopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005990 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an uncommon neurological condition in which the affected individuals see white or black dots or transparent dots in part or the whole of their visual fields.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_snow</obo:IAO_0000119>
        <obo:OAE_0001849>视觉雪症候群</obo:OAE_0001849>
        <obo:OAE_0004334>10079450</obo:OAE_0004334>
        <rdfs:label>visual snow syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005991 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is organs of the visual system and its functions get disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10015916</obo:OAE_0004334>
        <rdfs:label>eye disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005992 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is the ability to interpret the surrounding environment through color vision, scotopic vision, and mesopic vision, using light in the visible spectrum reflected by the objects in the environment and its gets  alter.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_perception</obo:IAO_0000119>
        <obo:OAE_0001849>视深度知觉改变</obo:OAE_0001849>
        <obo:OAE_0004334>10053549</obo:OAE_0004334>
        <rdfs:label>altered visual depth perception AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005993 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the dilation of the pupil, usually having a non-physiological cause, or sometimes a physiological pupillary response.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mydriasis</obo:IAO_0000119>
        <obo:OAE_0001849>瞳孔固定</obo:OAE_0001849>
        <obo:OAE_0004334>10037515</obo:OAE_0004334>
        <rdfs:label>pupil fixed AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005994 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003240"/>
        <obo:IAO_0000115>This is an AE which is the invasion of an eye tissues by toxoplasmal, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>眼部感染弓形虫</obo:OAE_0001849>
        <obo:OAE_0004334>10015939</obo:OAE_0004334>
        <rdfs:label>eye infection toxoplasmal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005995 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a clinical syndrome characterized by attacks of acute optic neuritis and transverse myelitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33093467/</obo:IAO_0000119>
        <obo:OAE_0001849>视神经脊髓炎</obo:OAE_0001849>
        <obo:OAE_0004334>10029322</obo:OAE_0004334>
        <rdfs:label>neuromyelitis optica AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005996 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an Ae which is an etiologically heterogeneous syndrome predominantly characterized by acute inflammation of the optic nerve (optic neuritis, ON) and the spinal cord (myelitis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuromyelitis_optica_spectrum_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>视神经脊髓炎谱系障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077875</obo:OAE_0004334>
        <rdfs:label>neuromyelitis optica spectrum disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005997 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the point of exit for ganglion cell axons leaving the eye and its function gets disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Optic_disc</obo:IAO_0000119>
        <obo:OAE_0001849>视神经盘障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061321</obo:OAE_0004334>
        <rdfs:label>optic disc disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005998 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is globules of mucoproteins and mucopolysaccharides that progressively calcify in the optic disc and  they are thought to be the remnants of the axonal transport system of degenerated retinal ganglion cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Optic_disc_drusen</obo:IAO_0000119>
        <obo:OAE_0001849>视盘玻璃膜疣</obo:OAE_0001849>
        <obo:OAE_0004334>10030617</obo:OAE_0004334>
        <rdfs:label>optic disc drusen AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005999 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is  strongly associated with the development and progression of glaucoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31023711/</obo:IAO_0000119>
        <obo:OAE_0001849>视神经盘出血</obo:OAE_0001849>
        <obo:OAE_0004334>10030919</obo:OAE_0004334>
        <rdfs:label>optic disc hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006000 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002037"/>
        <obo:IAO_0000115>This is an AE which is the increase of blood flow to different tissues in the optic disc.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperaemia</obo:IAO_0000119>
        <obo:OAE_0001849>视神经盘充血</obo:OAE_0001849>
        <obo:OAE_0004334>10071196</obo:OAE_0004334>
        <rdfs:label>optic disc hyperemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001509"/>
        <obo:IAO_0000115>This is an AE which blurring of an image due to incorrect focus occurs on optic discs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blurred</obo:IAO_0000119>
        <obo:OAE_0001849>视神经盘模糊</obo:OAE_0001849>
        <obo:OAE_0004334>10030923</obo:OAE_0004334>
        <rdfs:label>optic discs blurred AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers a form of glioma which affects the optic nerve, is often one of the central nervous system manifestations of neurofibromatosis .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Optic_nerve_glioma</obo:IAO_0000119>
        <obo:OAE_0001849>视神经胶质瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10030935</obo:OAE_0004334>
        <rdfs:label>optic nerve glioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a medical condition arising from the underdevelopment of the optic nerve(s).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Optic_nerve_hypoplasia</obo:IAO_0000119>
        <obo:OAE_0001849>视神经发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10062942</obo:OAE_0004334>
        <rdfs:label>optic nerve hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is optic nerve death (necrosis) due to inadequate blood supply to the affected area.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infarction</obo:IAO_0000119>
        <obo:OAE_0001849>视神经梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10030936</obo:OAE_0004334>
        <rdfs:label>optic nerve infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006005 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which maybe causes permanent and potentially severe loss of vision, as well as an abnormal pupillary reflex.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Optic_nerve</obo:IAO_0000119>
        <obo:OAE_0001849>视神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10030938</obo:OAE_0004334>
        <rdfs:label>optic nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006006 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged blood  optic nerve sheath vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>视神经鞘出血</obo:OAE_0001849>
        <obo:OAE_0004334>10030941</obo:OAE_0004334>
        <rdfs:label>optic nerve sheath hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006007 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000625"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of a papilla.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Papillitis</obo:IAO_0000119>
        <obo:OAE_0001849>视神经乳头炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033708</obo:OAE_0004334>
        <rdfs:label>papillitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006008 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a rare congenital malformation syndrome that features a combination of the underdevelopment of the optic nerve, pituitary gland dysfunction, and absence of the septum pellucidum (a midline part of the brain).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Septo-optic_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>视神经发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10067159</obo:OAE_0004334>
        <rdfs:label>septo-optic dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006009 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is the total or partial loss of vision in a normal-appearing eye caused by damage to the brain&apos;s occipital cortex and  can be acquired or congenital, and may also be transient in certain instances.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cortical_blindness</obo:IAO_0000119>
        <obo:OAE_0001849>皮质性盲</obo:OAE_0001849>
        <obo:OAE_0004334>10005177</obo:OAE_0004334>
        <rdfs:label>blindness cortical AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006010 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is an acute episode of ischemic origin in which one eye has profound visual loss, followed by full recovery within one hour.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29776764/</obo:IAO_0000119>
        <obo:OAE_0001849>一过性单眼盲</obo:OAE_0001849>
        <obo:OAE_0004334>10005184</obo:OAE_0004334>
        <rdfs:label>blindness transient AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006011 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is a decreased ability to see to a degree that causes problems not fixable by usual means occurd on unilateral eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_impairment</obo:IAO_0000119>
        <obo:OAE_0001849>单侧失明</obo:OAE_0001849>
        <obo:OAE_0004334>10005186</obo:OAE_0004334>
        <rdfs:label>blindness unilateral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006012 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is the decreased ability to see color or differences in color.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Color_blindness</obo:IAO_0000119>
        <obo:OAE_0001849>色盲</obo:OAE_0001849>
        <obo:OAE_0004334>10010050</obo:OAE_0004334>
        <rdfs:label>color blindness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006013 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which causes by diseases, drugs , and chemicals or organic solventsmay cause color blindness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Color_blindness</obo:IAO_0000119>
        <obo:OAE_0001849>获得性色盲</obo:OAE_0001849>
        <obo:OAE_0004334>10010051</obo:OAE_0004334>
        <rdfs:label>color blindness acquired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006014 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is a loss of vision or blindness (anopsia) in half the visual field, usually on one side of the vertical midline.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemianopsia</obo:IAO_0000119>
        <obo:OAE_0001849>偏盲</obo:OAE_0001849>
        <obo:OAE_0004334>10019452</obo:OAE_0004334>
        <rdfs:label>hemianopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is the loss of half of the visual field on different sides in both eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemianopsia</obo:IAO_0000119>
        <obo:OAE_0001849>异侧偏盲</obo:OAE_0001849>
        <obo:OAE_0004334>10019455</obo:OAE_0004334>
        <rdfs:label>hemianopia heteronymous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006016 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is hemianopic visual field loss on the same side of both eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Homonymous_hemianopsia</obo:IAO_0000119>
        <obo:OAE_0001849>同侧偏盲</obo:OAE_0001849>
        <obo:OAE_0004334>10019456</obo:OAE_0004334>
        <rdfs:label>hemianopia homonymous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which refers to an anopia affecting a quarter of the field of vision and associated with a lesion of an optic radiation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Quadrantanopia</obo:IAO_0000119>
        <obo:OAE_0001849>象限盲</obo:OAE_0001849>
        <obo:OAE_0004334>10077820</obo:OAE_0004334>
        <rdfs:label>quadrantanopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006018 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is an impairment in recognition of visually presented objects and it is not due to a deficit in vision (acuity, visual field, and scanning), language, memory, or intellect.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_agnosia</obo:IAO_0000119>
        <obo:OAE_0001849>视觉失认症</obo:OAE_0001849>
        <obo:OAE_0004334>10077168</obo:OAE_0004334>
        <rdfs:label>visual agnosia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006019 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a decreased ability to see to a degree that causes problems not fixable by usual means, such as glasses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_impairment</obo:IAO_0000119>
        <obo:OAE_0001849>视力障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10047471</obo:OAE_0004334>
        <rdfs:label>visual impairment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a form of visual impairment that is caused by a brain problem rather than an eye problem.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cortical_visual_impairment</obo:IAO_0000119>
        <obo:OAE_0001849>大脑皮层视觉缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10076660</obo:OAE_0004334>
        <rdfs:label>cortical visual impairment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006021 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is hallucinations accompanied by delusions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Visual_hallucinations_in_psychosis</obo:IAO_0000119>
        <obo:OAE_0001849>视觉幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10019075</obo:OAE_0004334>
        <rdfs:label>hallucination, visual AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006022 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which deficiencies in earliest stages of Parkinson disease (PD), plausibly associated with alpha-synuclein deposits in the inner retinal layers.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31992401/</obo:IAO_0000119>
        <obo:OAE_0001849>视觉对比度敏感度的丧失</obo:OAE_0001849>
        <obo:OAE_0004334>10064133</obo:OAE_0004334>
        <rdfs:label>loss of visual contrast sensitivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000577"/>
        <obo:IAO_0000115>This is an AE which is a sudden loss of the ability to see.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_visual_loss</obo:IAO_0000119>
        <obo:OAE_0001849>突然失明</obo:OAE_0001849>
        <obo:OAE_0004334>10042441</obo:OAE_0004334>
        <rdfs:label>sudden visual loss AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006024 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which refers to a group of diseases and conditions occurring in childhood or early adolescence of below 16 years old, which, if left untreated, result in blindness or severe visual impairment that are likely to be permanent blindness later in life.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_Blindness_Gene_Therapy</obo:IAO_0000119>
        <obo:OAE_0001849>先天性失明</obo:OAE_0001849>
        <obo:OAE_0004334>10005176</obo:OAE_0004334>
        <rdfs:label>blindness congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006025 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>This is an AE which is a type of  glaucoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/List_of_ICD-9_codes_320%E2%80%93389:_diseases_of_the_nervous_system_and_sense_organs</obo:IAO_0000119>
        <obo:OAE_0001849>边缘型青光眼</obo:OAE_0001849>
        <obo:OAE_0004334>10006027</obo:OAE_0004334>
        <rdfs:label>borderline glaucoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006026 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002262"/>
        <obo:IAO_0000115>This is an AE which is  due to either an acidic or alkali substance getting in the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chemical_eye_injury</obo:IAO_0000119>
        <obo:OAE_0001849>化学性眼睛受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10055116</obo:OAE_0004334>
        <rdfs:label>chemical eye injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006027 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which may be affected by congenital malformation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/12713104/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性眼部疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10059159</obo:OAE_0004334>
        <rdfs:label>congenital eye disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006028 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000048"/>
        <obo:IAO_0000115>This is an AE which is a condition of involuntary (or voluntary, in some cases) eye movement and it is congenital.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nystagmus</obo:IAO_0000119>
        <obo:OAE_0001849>先天性眼球震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10010562</obo:OAE_0004334>
        <rdfs:label>congenital nystagmus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006029 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which refers the relative darkening of lower eyelid skin and can impart a fatigued and less youthful appearance to the face.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25440739/</obo:IAO_0000119>
        <obo:OAE_0001849>黑眼圈</obo:OAE_0001849>
        <obo:OAE_0004334>10064729</obo:OAE_0004334>
        <rdfs:label>dark circles under eyes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>This is an AE which is a group of eye diseases which result in damage to the optic nerve (or retina) and cause vision loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glaucoma#Developmental_glaucoma</obo:IAO_0000119>
        <obo:OAE_0001849>发育性青光眼</obo:OAE_0001849>
        <obo:OAE_0004334>10012565</obo:OAE_0004334>
        <rdfs:label>developmental glaucoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is one of the main organs affected by this disease, being diabetic retinopathy the most well-known microvascular complication and the leading.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25817504/</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病眼病</obo:OAE_0001849>
        <obo:OAE_0004334>10012661</obo:OAE_0004334>
        <rdfs:label>diabetic eye disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006032 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000905"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the skin, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>湿疹眼睑</obo:OAE_0001849>
        <obo:OAE_0004334>10014194</obo:OAE_0004334>
        <rdfs:label>eczema eyelids AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006033 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the interior cavity of the eye, usually caused by infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endophthalmitis</obo:IAO_0000119>
        <obo:OAE_0001849>眼内炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014801</obo:OAE_0004334>
        <rdfs:label>endophthalmitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006034 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the posterior displacement of the eyeball within the orbit due to changes in the volume of the orbit (bone) relative to its contents (the eyeball and orbital fat), or loss of function of the orbitalis muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Enophthalmos</obo:IAO_0000119>
        <obo:OAE_0001849>眼球内陷</obo:OAE_0001849>
        <obo:OAE_0004334>10014853</obo:OAE_0004334>
        <rdfs:label>enophthalmos AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006035 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002142"/>
        <obo:IAO_0000115>This is an AE which is the seven extrinsic muscles of the human eye and its function gets disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Extraocular_muscles</obo:IAO_0000119>
        <obo:OAE_0001849>眼外肌疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10053635</obo:OAE_0004334>
        <rdfs:label>extraocular muscle disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006036 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000205"/>
        <obo:IAO_0000115>This is an AE which  refers to weakness (-paresis) or paralysis (-plegia) of one or more extraocular muscles which are responsible for eye movements.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ophthalmoparesis</obo:IAO_0000119>
        <obo:OAE_0001849>眼外肌轻度瘫痪</obo:OAE_0001849>
        <obo:OAE_0004334>10015829</obo:OAE_0004334>
        <rdfs:label>extraocular muscle paresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006037 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10015905</obo:OAE_0004334>
        <rdfs:label>eye abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006038 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a number of conditions caused by hypersensitivity of the  immune system of the eyes to typically harmless substances in the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Allergy</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10015907</obo:OAE_0004334>
        <rdfs:label>eye allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006039 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which during early childhood, puberty, pregnancy, and sometimes after serious trauma (like heterochromia) do represent cause for a plausible argument stating that some eyes can or do change, based on chemical reactions and hormonal changes within the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_color</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛颜色变化</obo:OAE_0001849>
        <obo:OAE_0004334>10072289</obo:OAE_0004334>
        <rdfs:label>eye color change AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>眼部挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10073354</obo:OAE_0004334>
        <rdfs:label>eye contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006041 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a  eye localized bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10079891</obo:OAE_0004334>
        <rdfs:label>eye hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006042 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003240"/>
        <obo:IAO_0000115>This is an AE which can cause a nonexudative but persistent conjunctivitis without much redness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivitis#Bacterial</obo:IAO_0000119>
        <obo:OAE_0001849>眼部细菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10015930</obo:OAE_0004334>
        <rdfs:label>eye infection bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006043 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003240"/>
        <obo:IAO_0000115>This is an AE which may cause responsible for nonacute bacterial conjunctivitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivitis#Bacterial</obo:IAO_0000119>
        <obo:OAE_0001849>眼部葡萄球菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10015937</obo:OAE_0004334>
        <rdfs:label>eye infection staphylococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006044 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003240"/>
        <obo:IAO_0000115>This is an AE which occurs when an organism&apos;s eye is invaded by pathogenic viruses,[not verified in body] and infectious virus particles (virions) attach to and enter susceptible cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Viral_disease</obo:IAO_0000119>
        <obo:OAE_0001849>眼部病毒感染</obo:OAE_0001849>
        <obo:OAE_0004334>10015940</obo:OAE_0004334>
        <rdfs:label>eye infection viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006045 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which refers to physical or chemical injuries of the eye can be a serious threat to vision if not treated appropriately and in a timely fashion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_injury</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061128</obo:OAE_0004334>
        <rdfs:label>eye injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006046 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a bulging of the eye anteriorly out of the orbit. Exophthalmos can be either bilateral (as is often seen in Graves&apos; disease) or unilateral (as is often seen in an orbital tumor).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exophthalmos</obo:IAO_0000119>
        <obo:OAE_0001849>眼球脱臼</obo:OAE_0001849>
        <obo:OAE_0004334>10015948</obo:OAE_0004334>
        <rdfs:label>eye luxation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006047 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which includes the voluntary or involuntary movement of the eyes, helping in acquiring, fixating and tracking visual stimuli. A special type of eye movement, rapid eye movement, occurs during REM sleep.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_movement#Disorders</obo:IAO_0000119>
        <obo:OAE_0001849>眼球运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061129</obo:OAE_0004334>
        <rdfs:label>eye movement disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006048 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a nonspecific medical term for a visible, circumscribed, chronic lesion of the eye skin or mucosa.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nevus</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛痣</obo:OAE_0001849>
        <obo:OAE_0004334>10051045</obo:OAE_0004334>
        <rdfs:label>eye naevus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006049 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which means loss of normal transparency of cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_opacity</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛混浊</obo:OAE_0001849>
        <obo:OAE_0004334>10078394</obo:OAE_0004334>
        <rdfs:label>eye opacity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006050 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <obo:IAO_0000115>This is an AE which is an abnormal sensation of the  eye skin (tingling, pricking, chilling, burning, numbness) with no apparent physical cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresthesia</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛感觉异常</obo:OAE_0001849>
        <obo:OAE_0004334>10076569</obo:OAE_0004334>
        <rdfs:label>eye paraesthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006051 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which injury that occurs when an object pierces the skin and enters a tissue of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Penetration</obo:IAO_0000119>
        <obo:OAE_0001849>穿透眼睛</obo:OAE_0001849>
        <obo:OAE_0004334>10015960</obo:OAE_0004334>
        <rdfs:label>eye penetration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006052 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a gesture in which a person briefly turns their eyes upward, often in an arcing motion from one side to the other. In the Anglosphere, it has been identified as a passive-aggressive response to an undesirable situation or person, or exasperation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye-rolling</obo:IAO_0000119>
        <obo:OAE_0001849>翻白眼</obo:OAE_0001849>
        <obo:OAE_0004334>10015964</obo:OAE_0004334>
        <rdfs:label>eye rolling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006053 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the observed or detectable signs, and experienced symptoms of an eye illness, injury, or condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Signs_and_symptoms</obo:IAO_0000119>
        <obo:OAE_0001849>眼部疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10075536</obo:OAE_0004334>
        <rdfs:label>eye symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006054 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000211"/>
        <obo:IAO_0000115>This is an AE which is a discontinuity or break in a bodily membrane that impedes normal function of the affected eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>眼溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10073423</obo:OAE_0004334>
        <rdfs:label>eye ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006055 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is an injury in which a eyeball structure is torn off by either trauma or surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Avulsion_injury</obo:IAO_0000119>
        <obo:OAE_0001849>眼球撕脱</obo:OAE_0001849>
        <obo:OAE_0004334>10015971</obo:OAE_0004334>
        <rdfs:label>eyeball avulsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006056 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000935"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged eyelid blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑出血</obo:OAE_0001849>
        <obo:OAE_0004334>10053196</obo:OAE_0004334>
        <rdfs:label>eyelid bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006057 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of eyelid tissue,the most common cause being capillaries damaged by trauma, causing localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10075018</obo:OAE_0004334>
        <rdfs:label>eyelid contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006058 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which an eye disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exfoliation</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑剥落</obo:OAE_0001849>
        <obo:OAE_0004334>10064580</obo:OAE_0004334>
        <rdfs:label>eyelid exfoliation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006059 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of eyelid blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10064976</obo:OAE_0004334>
        <rdfs:label>eyelid hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006060 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a thin fold of skin that covers and protects an eye and  the skin is susceptible to infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eyelid</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑感染</obo:OAE_0001849>
        <obo:OAE_0004334>10015988</obo:OAE_0004334>
        <rdfs:label>eyelid infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006061 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a thin fold of skin that covers and protects an eye and its is injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eyelid</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑受伤</obo:OAE_0001849>
        <obo:OAE_0004334>10069200</obo:OAE_0004334>
        <rdfs:label>eyelid injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006062 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a state of inflammation or painful reaction to allergy or eyelid cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10057385</obo:OAE_0004334>
        <rdfs:label>eyelid irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006063 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a brief, involuntary, irregular (lacking rhythm) twitching (different from clonus, which is rhythmic/ regular) of a muscle or a group of muscles and its occurs on eyelid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myoclonus</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑肌阵挛</obo:OAE_0001849>
        <obo:OAE_0004334>10076060</obo:OAE_0004334>
        <rdfs:label>eyelid myoclonus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006064 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000470"/>
        <obo:IAO_0000115>This is an AE which is a distressing feeling often caused by intense or damaging stimuli and its occurs on eyelid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10059208</obo:OAE_0004334>
        <rdfs:label>eyelid pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006065 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which presents within the first year of life either in isolation or as a part of many different ocular or systemic disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24657037/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性眼睑下垂</obo:OAE_0001849>
        <obo:OAE_0004334>10015996</obo:OAE_0004334>
        <rdfs:label>eyelid ptosis congenital AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006066 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is usually secondary to thyroid disorders, trauma, proptosis, seventh nerve palsy, or neurological abnormalities affecting the third nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/2393644/</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑收缩</obo:OAE_0001849>
        <obo:OAE_0004334>10015997</obo:OAE_0004334>
        <rdfs:label>eyelid retraction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006067 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch on the eyelids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10051627</obo:OAE_0004334>
        <rdfs:label>eyelids pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006068 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a cosmetic problem that results in an older and unnatural appearance.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29632789/</obo:IAO_0000119>
        <obo:OAE_0001849>眼睛凹陷</obo:OAE_0001849>
        <obo:OAE_0004334>10016013</obo:OAE_0004334>
        <rdfs:label>eyes sunken AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006070 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>This is an AE which is a group of eye diseases which result in damage to the optic nerve (or retina) and cause vision loss with traumatic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glaucoma</obo:IAO_0000119>
        <obo:OAE_0001849>创伤性青光眼</obo:OAE_0001849>
        <obo:OAE_0004334>10018330</obo:OAE_0004334>
        <rdfs:label>glaucoma traumatic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006071 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is the coordinated control of eye movement with hand movement and the processing of visual input to guide reaching and grasping along with the use of proprioception of the hands to guide the eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye%E2%80%93hand_coordination</obo:IAO_0000119>
        <obo:OAE_0001849>手眼协调能力受损</obo:OAE_0001849>
        <obo:OAE_0004334>10072649</obo:OAE_0004334>
        <rdfs:label>hand-eye coordination impaired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006072 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which is a form of ophthalmic caused by recurrent herpes simplex virus (HSV) infection in the cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Herpes_simplex_keratitis</obo:IAO_0000119>
        <obo:OAE_0001849>眼部单纯疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10019958</obo:OAE_0004334>
        <rdfs:label>herpes simplex ophthalmic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006073 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which occurs due to reactivation of the varicella zoster virus in the ophthalmic branch of the fifth cranial nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27644149/</obo:IAO_0000119>
        <obo:OAE_0001849>眼部带状疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10019983</obo:OAE_0004334>
        <rdfs:label>herpes zoster ophthalmic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006074 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is an eye condition in which the directions that the eyes are pointing at rest position, when not performing binocular fusion, are not the same as each other, or, &quot;not straight&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heterophoria</obo:IAO_0000119>
        <obo:OAE_0001849>隐斜视</obo:OAE_0001849>
        <obo:OAE_0004334>10020015</obo:OAE_0004334>
        <rdfs:label>heterophoria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006075 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a medical condition involving inflammatory cells in the anterior chamber of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypopyon</obo:IAO_0000119>
        <obo:OAE_0001849>眼前房积脓</obo:OAE_0001849>
        <obo:OAE_0004334>10021086</obo:OAE_0004334>
        <rdfs:label>hypopyon AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006076 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is an infrequent, yet potentially vision-threatening, entity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31029581/</obo:IAO_0000119>
        <obo:OAE_0001849>眼压减低</obo:OAE_0001849>
        <obo:OAE_0004334>10021124</obo:OAE_0004334>
        <rdfs:label>hypotony of eye AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006077 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is the inability to close the eyelids completely.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lagophthalmos</obo:IAO_0000119>
        <obo:OAE_0001849>兔眼症</obo:OAE_0001849>
        <obo:OAE_0004334>10023683</obo:OAE_0004334>
        <rdfs:label>lagophthalmos AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006078 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000935"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged lacrimal blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>泪腺出血</obo:OAE_0001849>
        <obo:OAE_0004334>10069930</obo:OAE_0004334>
        <rdfs:label>lacrimal hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006079 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a developmental disorder of the eye in which one (unilateral microphthalmia) or both (bilateral microphthalmia) eyes are abnormally small and have anatomic malformations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Microphthalmia</obo:IAO_0000119>
        <obo:OAE_0001849>小眼</obo:OAE_0001849>
        <obo:OAE_0004334>10027548</obo:OAE_0004334>
        <rdfs:label>microphthalmos AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006080 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a condition of involuntary (or voluntary, in some cases) eye movement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nystagmus</obo:IAO_0000119>
        <obo:OAE_0001849>眼球震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10029864</obo:OAE_0004334>
        <rdfs:label>nystagmus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006081 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002158"/>
        <obo:IAO_0000115>This is an AE which may be objectively quantifiable, independent of subjective expressions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30267090/</obo:IAO_0000119>
        <obo:OAE_0001849>眼部不适</obo:OAE_0001849>
        <obo:OAE_0004334>10052143</obo:OAE_0004334>
        <rdfs:label>ocular discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006082 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a form of dysmetria that involves the constant under- or over-shooting of the eyes when attempting to focus gaze on something.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ocular_dysmetria</obo:IAO_0000119>
        <obo:OAE_0001849>眼部屈光不正</obo:OAE_0001849>
        <obo:OAE_0004334>10063534</obo:OAE_0004334>
        <rdfs:label>ocular dysmetria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006083 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <obo:IAO_0000115>This is an AE which is the presence of elevated fluid pressure inside the eye (intraocular pressure), usually with no optic nerve damage or visual field loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ocular_hypertension</obo:IAO_0000119>
        <obo:OAE_0001849>眼高血压</obo:OAE_0001849>
        <obo:OAE_0004334>10030043</obo:OAE_0004334>
        <rdfs:label>ocular hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006084 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a disorder of ocular function that occurs subsequent to the stenosis of the carotid artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32809550/</obo:IAO_0000119>
        <obo:OAE_0001849>眼部缺血性综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10069385</obo:OAE_0004334>
        <rdfs:label>ocular ischemic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006085 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000405"/>
        <obo:IAO_0000115>This is an AE which is a form of myasthenia gravis in which weakness is restricted to the ocular muscles and may produce significant visual disability.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29655447/</obo:IAO_0000119>
        <obo:OAE_0001849>眼部肌无力</obo:OAE_0001849>
        <obo:OAE_0004334>10049168</obo:OAE_0004334>
        <rdfs:label>ocular myasthenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006086 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which can affect all parts of the eye, and can be a benign tumor or a malignant tumor (cancer).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>眼部肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10052448</obo:OAE_0004334>
        <rdfs:label>ocular neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006087 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000935"/>
        <obo:IAO_0000115>This is an AE which is a potentially blinding consequence of craniofacial trauma, but timely ophthalmic evaluation is difficult to obtain in some settings and clear standards for canthotomy/cantholysis are lacking.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32546417/</obo:IAO_0000119>
        <obo:OAE_0001849>眼眼球后的出血</obo:OAE_0001849>
        <obo:OAE_0004334>10057571</obo:OAE_0004334>
        <rdfs:label>ocular retrobulbar hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006088 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a manifestation of rosacea that affects the eyes and eyelids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ocular_rosacea</obo:IAO_0000119>
        <obo:OAE_0001849>眼部酒渣鼻</obo:OAE_0001849>
        <obo:OAE_0004334>10072139</obo:OAE_0004334>
        <rdfs:label>ocular rosacea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006089 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which constitute the most common cause of visual disability.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24769221/</obo:IAO_0000119>
        <obo:OAE_0001849>眼部血管疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10052896</obo:OAE_0004334>
        <rdfs:label>ocular vascular disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006090 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of blood vessels that leads to loss of perfusion and ischemia with necrosis and when this occurs in the orbit, the consequences are typically very conspicuous and can be devastating with decreased quality of life and loss of vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23888364/</obo:IAO_0000119>
        <obo:OAE_0001849>眼部血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066926</obo:OAE_0004334>
        <rdfs:label>ocular vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006091 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a loss of motor function in one or more muscles of oculofacial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>眼面麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10030069</obo:OAE_0004334>
        <rdfs:label>oculofacial paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006092 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is characterized by keratoconjunctivitis sicca and by scarring, fibrosis, metaplasia, and shrinkage of the conjunctiva.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oculomucocutaneous_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>眼-粘膜-皮肤综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10030081</obo:OAE_0004334>
        <rdfs:label>oculomucocutaneous syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006093 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a usually transient condition characterized by bilateral conjunctivitis, facial edema, and upper respiratory symptoms following influenza immunization.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oculo-respiratory_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>眼呼吸综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10067317</obo:OAE_0004334>
        <rdfs:label>oculo-respiratory syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006094 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a form of conjunctivitis (inflammation of the outer eye) which affects newborn babies following birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neonatal_conjunctivitis</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿眼炎</obo:OAE_0001849>
        <obo:OAE_0004334>10030861</obo:OAE_0004334>
        <rdfs:label>ophthalmia neonatorum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006095 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004559"/>
        <obo:IAO_0000115>This is an AE which is the formation of a blood clot inside a ophthalmic artery  blood vessel, obstructing the flow of blood through the circulatory system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombosis</obo:IAO_0000119>
        <obo:OAE_0001849>眼动脉血栓形成</obo:OAE_0001849>
        <obo:OAE_0004334>10081144</obo:OAE_0004334>
        <rdfs:label>ophthalmic artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006096 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which is a viral ophthalmic infection caused by the herpes simplex virus .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Herpes_simplex</obo:IAO_0000119>
        <obo:OAE_0001849>眼部单纯疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10073938</obo:OAE_0004334>
        <rdfs:label>ophthalmic herpes simplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006097 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003233"/>
        <obo:IAO_0000115>This is an AE which is shingles involving the eye or the surrounding area.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Herpes_zoster_ophthalmicus</obo:IAO_0000119>
        <obo:OAE_0001849>眼部带状疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10030865</obo:OAE_0004334>
        <rdfs:label>ophthalmic herpes zoster AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006098 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is a rare neurological disorder of unknown cause which appears to be the result of an autoimmune process involving the nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Opsoclonus_myoclonus_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>斜视眼阵挛肌阵挛</obo:OAE_0001849>
        <obo:OAE_0004334>10053854</obo:OAE_0004334>
        <rdfs:label>opsoclonus myoclonus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006099 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a collection of cranial nerve deficits associated with a mass lesion near the apex of the orbit of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Orbital_apex_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>眶尖综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10066383</obo:OAE_0004334>
        <rdfs:label>orbital apex syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006100 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003240"/>
        <obo:IAO_0000115>This is an AE which is the invasion of orbital tissue by disease-causing agents, their multiplication, and the reaction of host tissues to the infectious agents and the toxins they produce.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infection</obo:IAO_0000119>
        <obo:OAE_0001849>眼眶感染</obo:OAE_0001849>
        <obo:OAE_0004334>10064915</obo:OAE_0004334>
        <rdfs:label>orbital infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006101 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000613"/>
        <obo:IAO_0000115>This is an AE which typically occurs in an idiopathic acute form, with painful diplopia due to inflammation in 1 or more extraocular muscles of young adult females, which usually responds to a course of oral corticosteroids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31261163/</obo:IAO_0000119>
        <obo:OAE_0001849>眼眶肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10031050</obo:OAE_0004334>
        <rdfs:label>orbital myositis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006102 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004244"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the orbital  tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>眼眶水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10031051</obo:OAE_0004334>
        <rdfs:label>orbital edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006103 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of all coats of the animal eye including intraocular structures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panophthalmitis</obo:IAO_0000119>
        <obo:OAE_0001849>全眼球炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033683</obo:OAE_0004334>
        <rdfs:label>panophthalmitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006104 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the inability to close the eyelids completely with paralytic feel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lagophthalmos</obo:IAO_0000119>
        <obo:OAE_0001849>麻痹性兔眼</obo:OAE_0001849>
        <obo:OAE_0004334>10033842</obo:OAE_0004334>
        <rdfs:label>paralytic lagophthalmos AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006105 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is the appearance of swelling in the tissues around the eyes, called the orbits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periorbital_puffiness</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10042690</obo:OAE_0004334>
        <rdfs:label>swelling of eyelid AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006106 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002117"/>
        <obo:IAO_0000115>This is an AE which is a group of eye diseases which result in damage to the optic nerve (or retina[5]) and cause vision loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glaucoma</obo:IAO_0000119>
        <obo:OAE_0001849>闭角型青光眼</obo:OAE_0001849>
        <obo:OAE_0004334>10002500</obo:OAE_0004334>
        <rdfs:label>angle closure glaucoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006107 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is an eye condition that manifests through non-specific symptoms such as fatigue, pain in or around the eyes, blurred vision, headache, and occasional double vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_strain</obo:IAO_0000119>
        <obo:OAE_0001849>眼疲劳</obo:OAE_0001849>
        <obo:OAE_0004334>10003552</obo:OAE_0004334>
        <rdfs:label>asthenopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006108 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001999"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of eye globe.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>眼球萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10065684</obo:OAE_0004334>
        <rdfs:label>atrophy of globe AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006109 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease that affects the thyroid and it frequently results in and is the most common cause of hyperthyroidism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Graves%27_disease</obo:IAO_0000119>
        <obo:OAE_0001849>突眼性甲状腺肿</obo:OAE_0001849>
        <obo:OAE_0004334>10004161</obo:OAE_0004334>
        <rdfs:label>basedow&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a common finding especially in pediatric strabismus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27388203/</obo:IAO_0000119>
        <obo:OAE_0001849>过度的眼部融合</obo:OAE_0001849>
        <obo:OAE_0004334>10053693</obo:OAE_0004334>
        <rdfs:label>excessive ocular convergence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006111 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a bulging of the eye anteriorly out of the orbit. Exophthalmos can be either bilateral (as is often seen in Graves&apos; disease) or unilateral (as is often seen in an orbital tumor).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exophthalmos</obo:IAO_0000119>
        <obo:OAE_0001849>眼球突出</obo:OAE_0001849>
        <obo:OAE_0004334>10015683</obo:OAE_0004334>
        <rdfs:label>exophthalmos AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006112 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a condition of the eye where distant objects are seen clearly but near objects appear blurred.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Far-sightedness</obo:IAO_0000119>
        <obo:OAE_0001849>远视</obo:OAE_0001849>
        <obo:OAE_0004334>10020675</obo:OAE_0004334>
        <rdfs:label>hypermetropia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006113 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a type of distorted vision in which a grid of straight lines appears wavy and parts of the grid may appear blank.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metamorphopsia</obo:IAO_0000119>
        <obo:OAE_0001849>视物变形症</obo:OAE_0001849>
        <obo:OAE_0004334>10063341</obo:OAE_0004334>
        <rdfs:label>metamorphopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006114 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is an eye disorder where light focuses in front of, instead of on, the retina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myopia</obo:IAO_0000119>
        <obo:OAE_0001849>近视</obo:OAE_0001849>
        <obo:OAE_0004334>10028651</obo:OAE_0004334>
        <rdfs:label>myopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006115 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is a group of uncommon posterior segment complications of herpetic viral aetiology caused by members of Herpesviridae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26084658/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性疱疹的视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10065119</obo:OAE_0004334>
        <rdfs:label>necrotising herpetic retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006116 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>This is an AE which is an outward bulging, likened to a bubble or balloon, caused by a localized, abnormal, weak retinal spot on a blood vessel wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜动脉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10064145</obo:OAE_0004334>
        <rdfs:label>retinal aneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006117 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003420"/>
        <obo:IAO_0000115>This is an AE which is the lodging of an embolus, a blockage-causing piece of material, inside a retinal artery  blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Embolism</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜动脉栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10038826</obo:OAE_0004334>
        <rdfs:label>retinal artery embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006118 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003420"/>
        <obo:IAO_0000115>This is an AE which is the constellation of ocular signs and symptoms secondary to severe, chronic arterial hypoperfusion to the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ocular_ischemic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜动脉阻塞</obo:OAE_0001849>
        <obo:OAE_0004334>10038827</obo:OAE_0004334>
        <rdfs:label>retinal artery occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006119 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003420"/>
        <obo:IAO_0000115>This is an AE which is a sudden involuntary contraction of  retinal artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜动脉痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10038829</obo:OAE_0004334>
        <rdfs:label>retinal artery spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006120 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003420"/>
        <obo:IAO_0000115>This is an AE which is the formation of a blood clot inside a retinal artery vessel, obstructing the flow of blood through the circulatory system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thrombosis</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜动脉血栓形成</obo:OAE_0001849>
        <obo:OAE_0004334>10038831</obo:OAE_0004334>
        <rdfs:label>retinal artery thrombosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006121 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which may refer to retinopathy that one of several eye diseases or eye disorders in humans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retinal_degeneration</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜变性</obo:OAE_0001849>
        <obo:OAE_0004334>10038845</obo:OAE_0004334>
        <rdfs:label>retinal degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006122 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the lightening of the skin or loss of pigment on the oculocutaneous.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Depigmentation</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜色素脱失</obo:OAE_0001849>
        <obo:OAE_0004334>10038846</obo:OAE_0004334>
        <rdfs:label>retinal depigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006123 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the innermost, light-sensitive layer of tissue of the eye of most vertebrates and some molluscs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retina#Diseases_and_disorders</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10038853</obo:OAE_0004334>
        <rdfs:label>retinal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006124 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which from the German word for node or geode (singular, &quot;Druse&quot;), are tiny yellow or white accumulations of extracellular material that build up between Bruch&apos;s membrane and the retinal pigment epithelium of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Drusen</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜玻璃疣</obo:OAE_0001849>
        <obo:OAE_0004334>10062776</obo:OAE_0004334>
        <rdfs:label>retinal drusen AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006125 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the degeneration of rentinal tissue, due to disease or malnutrition, most likely due to heredity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dystrophy</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜营养不良</obo:OAE_0001849>
        <obo:OAE_0004334>10038857</obo:OAE_0004334>
        <rdfs:label>retinal dystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006126 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a fluid emitted by an rentinal through pores or a wound.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Exudate</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜渗出液</obo:OAE_0001849>
        <obo:OAE_0004334>10038862</obo:OAE_0004334>
        <rdfs:label>retinal exudates AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006127 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which an infarction can occur to the central retinal artery which supplies the retina causing sudden visual loss.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infarction</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10051742</obo:OAE_0004334>
        <rdfs:label>retinal infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006128 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which Physical or chemical injuries of the rentinal can be a serious threat to vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_injury</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10057430</obo:OAE_0004334>
        <rdfs:label>retinal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006129 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <obo:IAO_0000115>This is an AE which is a major cause of vision loss and impairment and a common underlying mechanism associated with diseases such as glaucoma, diabetic retinopathy, and central retinal artery occlusion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30654160/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜缺血</obo:OAE_0001849>
        <obo:OAE_0004334>10038871</obo:OAE_0004334>
        <rdfs:label>retinal ischaemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006130 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000479"/>
        <obo:IAO_0000115>This is an AE which is a retinal disease often accompanied by migraine headache and typically affects only one eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retinal_migraine</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜性偏头痛</obo:OAE_0001849>
        <obo:OAE_0004334>10052784</obo:OAE_0004334>
        <rdfs:label>retinal migraine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006131 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004244"/>
        <obo:IAO_0000115>This is an AE which occurs when fluid and protein deposits collect on or under the macula of the eye (a yellow central area of the retina) and causes it to thicken and swell (edema).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macular_edema</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10038886</obo:OAE_0004334>
        <rdfs:label>retinal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006132 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000606"/>
        <obo:IAO_0000115>This is an AE which is a pale color of the skin that can be caused by illness, emotional shock or stress, stimulant use, or anemia, and is the result of a reduced amount of oxyhaemoglobin and may also be visible as pallor of the conjunctivae of the eyes on physical examination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pallor</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜发白</obo:OAE_0001849>
        <obo:OAE_0004334>10038891</obo:OAE_0004334>
        <rdfs:label>retinal pallor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006133 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a relatively novel concept describing a phenotype characterized by attenuation of the choriocapillaris overlying dilated choroidal veins, and associated with progressive retinal pigment epithelium dysfunction and neovascularization.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29995841/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜色素上皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10038893</obo:OAE_0004334>
        <rdfs:label>retinal pigment epitheliopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006134 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is confined to inner retinal layers .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32779075/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜增厚</obo:OAE_0001849>
        <obo:OAE_0004334>10077890</obo:OAE_0004334>
        <rdfs:label>retinal thickening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006135 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002578"/>
        <obo:IAO_0000115>This is an AE which is the constellation of ocular signs and symptoms secondary to severe, chronic arterial hypoperfusion to the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ocular_ischemic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜血管阻塞</obo:OAE_0001849>
        <obo:OAE_0004334>10038903</obo:OAE_0004334>
        <rdfs:label>retinal vascular occlusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006136 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the vascular branches of the retinal artery, caused either by primary ocular disease processes, or as a specific presentation of any systemic form of vasculitis such as Behçet&apos;s disease, sarcoidosis, multiple sclerosis, or any form of systemic necrotizing vasculitis such as temporal arteritis, polyarteritis nodosa, and granulomatosis with polyangiitis, or due to lupus erythematosus, or rheumatoid arthritis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retinal_vasculitis</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜血管炎</obo:OAE_0001849>
        <obo:OAE_0004334>10038905</obo:OAE_0004334>
        <rdfs:label>retinal vasculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006137 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the retina in the eye, which can permanently damage the retina and lead to blindness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retinitis</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10038910</obo:OAE_0004334>
        <rdfs:label>retinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006138 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a genetic disorder of the eyes that causes loss of vision and symptoms include trouble seeing at night and decreased peripheral vision (side vision).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retinitis_pigmentosa</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜色素变性</obo:OAE_0001849>
        <obo:OAE_0004334>10038914</obo:OAE_0004334>
        <rdfs:label>retinitis pigmentosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006139 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a rare disease that implies involvement of Herpesviridae, a family of double-stranded DNA viruses characterised by latency within the host&apos;s cells after primary infection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30859706/</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性视网膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10038915</obo:OAE_0004334>
        <rdfs:label>retinitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006140 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is an eye disease characterized by the abnormal splitting of the retina&apos;s neurosensory layers, usually in the outer plexiform layer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retinoschisis</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜劈裂</obo:OAE_0001849>
        <obo:OAE_0004334>10061492</obo:OAE_0004334>
        <rdfs:label>retinoschisis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006141 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>This is an AE which typically presents with the perception of light flashes, floaters, or a &quot;dark curtain.&quot;</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24565273/</obo:IAO_0000119>
        <obo:OAE_0001849>孔源性视网膜脱离</obo:OAE_0001849>
        <obo:OAE_0004334>10065569</obo:OAE_0004334>
        <rdfs:label>rhegmatogenous retinal detachment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006142 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>This is an AE which with hypertensive choroidopathy presented with choroidal thickening that decreased after resolution, but the residual flow defects observed in the choriocapillaris on OCTA confirmed the long-hypothesized notion that ischemia is a mechanism underlying hypertensive choroidopathy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31089238/</obo:IAO_0000119>
        <obo:OAE_0001849>浆液性视网膜脱离</obo:OAE_0001849>
        <obo:OAE_0004334>10040114</obo:OAE_0004334>
        <rdfs:label>serous retinal detachment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006143 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001517"/>
        <obo:IAO_0000115>This is an AE which is a result of a wound healing response that follows choroidal neovascularization in neovascular age-related macular degeneration (nAMD).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25773985/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜下纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10062958</obo:OAE_0004334>
        <rdfs:label>subretinal fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006144 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001155"/>
        <obo:IAO_0000115>This is an AE which observed in association with choroidal neovascularization and to distinguish SHE from other forms of subretinal hyperreflective material (SHM) seen in patients with age-related macular degeneration and other macular disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/24695062/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜下高反射性渗出</obo:OAE_0001849>
        <obo:OAE_0004334>10082240</obo:OAE_0004334>
        <rdfs:label>subretinal hyperreflective exudation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006145 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which an anomalous posterior vitreous detachment (APVD) with persistant symptomatic vitreoretinal adhesion is seen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23842874/</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃体视网膜牵引综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10071181</obo:OAE_0004334>
        <rdfs:label>vitreoretinal traction syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006146 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is a rare retinal condition that features the sudden onset of bilateral central scotomata, which may be preceded by a viral prodrome in some patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://sci-hub.se/10.1001/archophthalmol.2011.22</obo:IAO_0000119>
        <obo:OAE_0001849>急性黄斑外视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10079367</obo:OAE_0004334>
        <rdfs:label>acute macular outer retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006147 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory retinopathy in the category of white dot syndromes typified by acute loss of one or more zones of outer retinal function associated with photopsia, minimal funduscopic changes and abnormal electroretinography findings.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_zonal_occult_outer_retinopathy</obo:IAO_0000119>
        <obo:OAE_0001849>急性带状隐匿性外视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10074444</obo:OAE_0004334>
        <rdfs:label>acute zonal occult outer retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006148 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is a rare disease in which the patient&apos;s immune system attacks proteins in the retina, leading to loss of eyesight.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Autoimmune_retinopathy</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10071578</obo:OAE_0004334>
        <rdfs:label>autoimmune retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006149 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which can be partially compensated by increased use of peripheral vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32965480/</obo:IAO_0000119>
        <obo:OAE_0001849>中心视力丧失</obo:OAE_0001849>
        <obo:OAE_0004334>10081186</obo:OAE_0004334>
        <rdfs:label>central vision loss AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006150 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the chorioretinal body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜脉络膜萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10008762</obo:OAE_0004334>
        <rdfs:label>chorioretinal atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006151 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is the vascular layer of the eye, containing connective tissues, and lying between the retina and the sclera that is gets disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Choroid</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜脉络膜疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061763</obo:OAE_0004334>
        <rdfs:label>chorioretinal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006152 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is an area of fibrous tissue that replaces normal chorioretinal skin after an injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scar</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜脉络膜疤痕</obo:OAE_0001849>
        <obo:OAE_0004334>10008766</obo:OAE_0004334>
        <rdfs:label>chorioretinal scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006153 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the choroid (thin pigmented vascular coat of the eye) and retina of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chorioretinitis</obo:IAO_0000119>
        <obo:OAE_0001849>绒毛膜视网膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008769</obo:OAE_0004334>
        <rdfs:label>chorioretinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006154 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is a posterior segment disease characterized by localized and limited serous detachments of the neurosensory retina often associated with focal detachments of an altered retinal pigment epithelium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26026923/</obo:IAO_0000119>
        <obo:OAE_0001849>视网膜脉络膜视网膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10063118</obo:OAE_0004334>
        <rdfs:label>chorioretinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006155 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is an impairment of the sense of vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vision_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>色视症</obo:OAE_0001849>
        <obo:OAE_0004334>10008795</obo:OAE_0004334>
        <rdfs:label>chromatopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006156 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which refers to a risk for myopia may be inherited from one&apos;s parents.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myopia#Genetics</obo:IAO_0000119>
        <obo:OAE_0001849>先天性近视</obo:OAE_0001849>
        <obo:OAE_0004334>10069153</obo:OAE_0004334>
        <rdfs:label>congenital myopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006157 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a medical term for seeing everything tinted with blue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyanopsia</obo:IAO_0000119>
        <obo:OAE_0001849>蓝视症</obo:OAE_0001849>
        <obo:OAE_0004334>10051819</obo:OAE_0004334>
        <rdfs:label>cyanopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006158 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000857"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the choroid (thin pigmented vascular coat of the eye) and retina of the eye caused by cytomegalovirus .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chorioretinitis</obo:IAO_0000119>
        <obo:OAE_0001849>巨细胞病毒脉络膜视网膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048843</obo:OAE_0004334>
        <rdfs:label>cytomegalovirus chorioretinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006159 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which damage occurs to the retina due to diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diabetic_retinopathy</obo:IAO_0000119>
        <obo:OAE_0001849>糖尿病性视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10012689</obo:OAE_0004334>
        <rdfs:label>diabetic retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006160 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is the simultaneous perception of two images of a single object that may be displaced horizontally or vertically in relation to each other.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Diplopia</obo:IAO_0000119>
        <obo:OAE_0001849>复视</obo:OAE_0001849>
        <obo:OAE_0004334>10013036</obo:OAE_0004334>
        <rdfs:label>diplopia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006161 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a lack of coordination of movement typified by the undershoot or overshoot of intended position with the hand, arm, leg, or eye. It is a type of ataxia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dysmetria</obo:IAO_0000119>
        <obo:OAE_0001849>辨距不良</obo:OAE_0001849>
        <obo:OAE_0004334>10013936</obo:OAE_0004334>
        <rdfs:label>dysmetria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006162 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a neuropsychological condition that causes a distortion of perception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alice_in_Wonderland_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>视物大小不对称症</obo:OAE_0001849>
        <obo:OAE_0004334>10067557</obo:OAE_0004334>
        <rdfs:label>dysmetropsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006163 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is less common but nonetheless a possible reason as to why a patient may fail the 4 PRT.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Four_prism_dioptre_reflex_test#Abnormal_response:_eccentric_fixation</obo:IAO_0000119>
        <obo:OAE_0001849>假黄斑注视</obo:OAE_0001849>
        <obo:OAE_0004334>10070917</obo:OAE_0004334>
        <rdfs:label>eccentric fixation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006164 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001979"/>
        <obo:IAO_0000115>This is an AE which may be a manifestation of a variety of isolated ocular or systemic diseases in children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30170046/</obo:IAO_0000119>
        <obo:OAE_0001849>渗出性视网膜病变</obo:OAE_0001849>
        <obo:OAE_0004334>10015901</obo:OAE_0004334>
        <rdfs:label>exudative retinopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006165 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a visual disturbance in which objects appear with a red hue, is a recognized phenomenon after surgical excision of the natural lens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17321412/</obo:IAO_0000119>
        <obo:OAE_0001849>红视症</obo:OAE_0001849>
        <obo:OAE_0004334>10015290</obo:OAE_0004334>
        <rdfs:label>erythropsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006166 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is sometimes visible deposits within the eye&apos;s vitreous humour (&quot;the vitreous&quot;), which is normally transparent, or between the vitreous and retina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Floater</obo:IAO_0000119>
        <obo:OAE_0001849>飞蝇症</obo:OAE_0001849>
        <obo:OAE_0004334>10028623</obo:OAE_0004334>
        <rdfs:label>myodesopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006167 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a visual disturbance in which objects in the visual field appear to oscillate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oscillopsia</obo:IAO_0000119>
        <obo:OAE_0001849>振动幻视</obo:OAE_0001849>
        <obo:OAE_0004334>10052087</obo:OAE_0004334>
        <rdfs:label>oscillopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006168 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is the phenomenon of seeing light without light entering the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Phosphene</obo:IAO_0000119>
        <obo:OAE_0001849>光幻视</obo:OAE_0001849>
        <obo:OAE_0004334>10034936</obo:OAE_0004334>
        <rdfs:label>phosphenes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006169 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a scratch to the surface of the cornea of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_abrasion</obo:IAO_0000119>
        <obo:OAE_0001849>角膜擦伤</obo:OAE_0001849>
        <obo:OAE_0004334>10010984</obo:OAE_0004334>
        <rdfs:label>corneal abrasion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006170 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>This is an AE which is a collection of pus that has built up within the tissue of the corneal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abscess</obo:IAO_0000119>
        <obo:OAE_0001849>角膜脓肿</obo:OAE_0001849>
        <obo:OAE_0004334>10010985</obo:OAE_0004334>
        <rdfs:label>corneal abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006171 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is severe enough to require corneal transplantation is a rare complication of uveitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31906778/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜失代偿</obo:OAE_0001849>
        <obo:OAE_0004334>10052117</obo:OAE_0004334>
        <rdfs:label>corneal decompensation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006172 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is deterioration in the medical sense on the corneal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Degeneration_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>角膜退化</obo:OAE_0001849>
        <obo:OAE_0004334>10010996</obo:OAE_0004334>
        <rdfs:label>corneal degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006173 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is the transparent front part of the eye that covers the iris, pupil, and anterior chamber.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cornea</obo:IAO_0000119>
        <obo:OAE_0001849>角膜沉积物</obo:OAE_0001849>
        <obo:OAE_0004334>10011000</obo:OAE_0004334>
        <rdfs:label>corneal deposits AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006174 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers to anything that interferes with the cornea&apos;s stromal architecture, contributes to blood vessel migration, increases corneal pigmentation, or predisposes to corneal edema, disrupts the corneas transparency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15948422/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061453</obo:OAE_0004334>
        <rdfs:label>corneal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006175 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a group of rare hereditary disorders characterised by bilateral abnormal deposition of substances in the transparent front part of the eye called the cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_dystrophy</obo:IAO_0000119>
        <obo:OAE_0001849>角膜营养不良</obo:OAE_0001849>
        <obo:OAE_0004334>10011005</obo:OAE_0004334>
        <rdfs:label>corneal dystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006176 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a single layer of endothelial cells on the inner surface of the cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_endothelium</obo:IAO_0000119>
        <obo:OAE_0001849>角膜内皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062621</obo:OAE_0004334>
        <rdfs:label>corneal endotheliitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006177 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001903"/>
        <obo:IAO_0000115>This is an AE which is made up of epithelial tissue and covers the front of the cornea and acts as a barrier to protect the cornea, resisting the free flow of fluids from the tears, and prevents bacteria from entering the epithelium and corneal stroma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_epithelium</obo:IAO_0000119>
        <obo:OAE_0001849>角膜上皮缺损</obo:OAE_0001849>
        <obo:OAE_0004334>10011010</obo:OAE_0004334>
        <rdfs:label>corneal epithelium defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006178 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the eyes characterized by the failure of the cornea&apos;s outermost layer of epithelial cells to attach to the underlying basement membrane (Bowman&apos;s layer).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Recurrent_corneal_erosion</obo:IAO_0000119>
        <obo:OAE_0001849>角膜糜烂</obo:OAE_0001849>
        <obo:OAE_0004334>10011013</obo:OAE_0004334>
        <rdfs:label>corneal erosion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006179 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is an age-related disease in which abnormal fibrillar extracellular material is produced and accumulates in many ocular tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11166342/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜脱落</obo:OAE_0001849>
        <obo:OAE_0004334>10064489</obo:OAE_0004334>
        <rdfs:label>corneal exfoliation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006180 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004375"/>
        <obo:IAO_0000115>This is an AE which comprises a sequence of complex immune responses that involves the recognition of the foreign histocompatibility antigens of the corneal graft by the host&apos;s immune system, leading to the initiation of the immune response cascade.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17574064/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜移植排斥反应</obo:OAE_0001849>
        <obo:OAE_0004334>10011017</obo:OAE_0004334>
        <rdfs:label>corneal graft rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006181 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the corneal tissue of an organism, usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>角膜损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10011026</obo:OAE_0004334>
        <rdfs:label>corneal lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006182 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is the in-growth of new blood vessels from the pericorneal plexus into avascular corneal tissue as a result of oxygen deprivation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_neovascularization</obo:IAO_0000119>
        <obo:OAE_0001849>角膜新血管化</obo:OAE_0001849>
        <obo:OAE_0004334>10055665</obo:OAE_0004334>
        <rdfs:label>corneal neovascularisation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006183 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004244"/>
        <obo:IAO_0000115>This is an AE which is a common sign of acute or protracted corneal disease of various aetiologies.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23679934/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10011033</obo:OAE_0004334>
        <rdfs:label>corneal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006184 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a transparent membrane which allows light to pass through it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_opacity</obo:IAO_0000119>
        <obo:OAE_0001849>角膜透明度</obo:OAE_0001849>
        <obo:OAE_0004334>10011035</obo:OAE_0004334>
        <rdfs:label>corneal opacity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006185 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002544"/>
        <obo:IAO_0000115>This is an AE which accumulate in reaction to inflammatory responses and remain permanently in corneal stroma, and conventionally correctable only by donor corneal transplantation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32979396/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜疤痕</obo:OAE_0001849>
        <obo:OAE_0004334>10011044</obo:OAE_0004334>
        <rdfs:label>corneal scar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006186 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the transparent front part of the eye that covers the iris, pupil, and anterior chamber and its is a process of becoming thin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cornea</obo:IAO_0000119>
        <obo:OAE_0001849>角膜变薄</obo:OAE_0001849>
        <obo:OAE_0004334>10054760</obo:OAE_0004334>
        <rdfs:label>corneal thinning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006187 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a  type of anterior uveitis and  inflammation of iris and the ciliary body with inflammation predominantly confined to ciliary body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uveitis#Classification</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜睫状体炎</obo:OAE_0001849>
        <obo:OAE_0004334>10022941</obo:OAE_0004334>
        <rdfs:label>iridocyclitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006188 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002352"/>
        <obo:IAO_0000115>This is an AE which is fibrous bands that form between iris tissues and organs,often as a result of injury during surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adhesion_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜粘连</obo:OAE_0001849>
        <obo:OAE_0004334>10022945</obo:OAE_0004334>
        <rdfs:label>iris adhesions AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006189 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a hole in one of the structures of the eye, such as the iris.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coloboma</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜孔</obo:OAE_0001849>
        <obo:OAE_0004334>10052642</obo:OAE_0004334>
        <rdfs:label>iris coloboma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006190 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is part of the eye and its functiuon gets disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iris</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061254</obo:OAE_0004334>
        <rdfs:label>iris disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006191 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is characterized specifically as an area of iris skin becoming lighter than the baseline skin color, but not completely devoid of pigment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypopigmentation</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜色素减退</obo:OAE_0001849>
        <obo:OAE_0004334>10063694</obo:OAE_0004334>
        <rdfs:label>iris hypopigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006192 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is damage to the iris caused by an external force.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10057413</obo:OAE_0004334>
        <rdfs:label>iris injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006193 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the uvea, the pigmented layer that lies between the inner retina and the outer fibrous layer composed of the sclera and cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Uveitis</obo:IAO_0000119>
        <obo:OAE_0001849>虹膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10022955</obo:OAE_0004334>
        <rdfs:label>iritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006194 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>This is an AE which is due to the lens cortex (outer layer) becoming opaque and they occur when changes in the fluid contained in the periphery of the lens causes fissuring.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cataract</obo:IAO_0000119>
        <obo:OAE_0001849>皮质性白内障</obo:OAE_0001849>
        <obo:OAE_0004334>10007748</obo:OAE_0004334>
        <rdfs:label>cataract cortical AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006195 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>This is an AE which is the most common type of cataract, and involves the central or &apos;nuclear&apos; part of the lens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cataract</obo:IAO_0000119>
        <obo:OAE_0001849>核性白内障</obo:OAE_0001849>
        <obo:OAE_0004334>10007759</obo:OAE_0004334>
        <rdfs:label>cataract nuclear AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006196 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>This is an AE which is cloudy at the back of the lens adjacent to the capsule (or bag) in which the lens sits and  because light becomes more focused toward the back of the lens, they can cause disproportionate symptoms for their size.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cataract</obo:IAO_0000119>
        <obo:OAE_0001849>囊下白内障</obo:OAE_0001849>
        <obo:OAE_0004334>10007764</obo:OAE_0004334>
        <rdfs:label>cataract subcapsular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006197 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is a tissue that lines the inside of the eyelids and covers the sclera (the white of the eye) and it has deposit.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctiva</obo:IAO_0000119>
        <obo:OAE_0001849>结膜沉积物</obo:OAE_0001849>
        <obo:OAE_0004334>10010708</obo:OAE_0004334>
        <rdfs:label>conjunctival deposit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006198 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which refers to a small spherical group of cells containing a cavity on the conjunctival.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Follicle</obo:IAO_0000119>
        <obo:OAE_0001849>结膜囊</obo:OAE_0001849>
        <obo:OAE_0004334>10010717</obo:OAE_0004334>
        <rdfs:label>conjunctival follicles AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006199 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is the increase of blood flow to different tissues in the conjunctial tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperaemia</obo:IAO_0000119>
        <obo:OAE_0001849>结膜充血</obo:OAE_0001849>
        <obo:OAE_0004334>10051625</obo:OAE_0004334>
        <rdfs:label>conjunctival hyperemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006200 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is a conjunctival state of inflammation or painful reaction to allergy or cell-lining damage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Irritation</obo:IAO_0000119>
        <obo:OAE_0001849>结膜刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10010725</obo:OAE_0004334>
        <rdfs:label>conjunctival irritation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006201 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is the swelling (or edema) of the conjunctiva.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chemosis</obo:IAO_0000119>
        <obo:OAE_0001849>结膜水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10010726</obo:OAE_0004334>
        <rdfs:label>conjunctival edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006202 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is a decrease in the total amount of red blood cells (RBCs) or hemoglobin in the blood or a lowered ability of the blood to carry oxygen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anemia</obo:IAO_0000119>
        <obo:OAE_0001849>结膜苍白</obo:OAE_0001849>
        <obo:OAE_0004334>10068819</obo:OAE_0004334>
        <rdfs:label>conjunctival pallor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006203 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is an eye finding occurring early in leptospirosis, which is caused by Leptospira interrogans.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctival_suffusion</obo:IAO_0000119>
        <obo:OAE_0001849>结膜弥漫</obo:OAE_0001849>
        <obo:OAE_0004334>10084034</obo:OAE_0004334>
        <rdfs:label>conjunctival suffusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006204 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory or, more seriously, infective condition of the cornea involving disruption of its epithelial layer with involvement of the corneal stroma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Corneal_ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>结膜溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10010736</obo:OAE_0004334>
        <rdfs:label>conjunctival ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006205 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the conjunctiva (the membrane covering the white part of the eye) due to allergy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Allergic_conjunctivitis</obo:IAO_0000119>
        <obo:OAE_0001849>结膜炎过敏</obo:OAE_0001849>
        <obo:OAE_0004334>10010744</obo:OAE_0004334>
        <rdfs:label>conjunctivitis allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006206 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which causes the rapid onset of conjunctival redness, swelling of the eyelid, and a sticky discharge.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivitis#Bacterial_3</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10061784</obo:OAE_0004334>
        <rdfs:label>conjunctivitis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006207 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which is often associated with an infection of the upper respiratory tract, a common cold, or a sore throat.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivitis#Viral</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10010755</obo:OAE_0004334>
        <rdfs:label>conjunctivitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006208 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which is a common eye surface condition characterized by the presence of excess folds of the conjunctiva located between the globe of the eye and the eyelid margin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivochalasis</obo:IAO_0000119>
        <obo:OAE_0001849>结膜松弛</obo:OAE_0001849>
        <obo:OAE_0004334>10064132</obo:OAE_0004334>
        <rdfs:label>conjunctivochalasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006209 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which is a derivative of the highly contagious conjunctivitis virus, otherwise known as pink eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acute_hemorrhagic_conjunctivitis</obo:IAO_0000119>
        <obo:OAE_0001849>急性出血性结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067817</obo:OAE_0004334>
        <rdfs:label>acute haemorrhagic conjunctivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006210 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000561"/>
        <obo:IAO_0000115>This is an AE which is the type of viral conjunctivitis and the most common cause of it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Conjunctivitis#Viral</obo:IAO_0000119>
        <obo:OAE_0001849>腺病毒性结膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10001257</obo:OAE_0004334>
        <rdfs:label>adenoviral conjunctivitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006211 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory cellular deposit seen on corneal endothelium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratic_precipitate</obo:IAO_0000119>
        <obo:OAE_0001849>角膜炎沉淀性</obo:OAE_0001849>
        <obo:OAE_0004334>10053703</obo:OAE_0004334>
        <rdfs:label>keratic precipitates AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006212 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003239"/>
        <obo:IAO_0000115>This is an AE which is a condition with  herpetic in which the eye&apos;s cornea, the clear dome on the front surface of the eye, becomes inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratitis</obo:IAO_0000119>
        <obo:OAE_0001849>角膜炎疱疹</obo:OAE_0001849>
        <obo:OAE_0004334>10023334</obo:OAE_0004334>
        <rdfs:label>keratitis herpetic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006213 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003239"/>
        <obo:IAO_0000115>This is an AE which is corneal scarring due to chronic inflammation of the corneal stroma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Interstitial_keratitis</obo:IAO_0000119>
        <obo:OAE_0001849>间质性角膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10023335</obo:OAE_0004334>
        <rdfs:label>keratitis interstitial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006214 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003239"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the eye&apos;s cornea, the clear dome on the front surface of the eye, becomes inflamed caused by viral.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性角膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062029</obo:OAE_0004334>
        <rdfs:label>keratitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006215 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the eye that results in progressive thinning of the cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratoconus</obo:IAO_0000119>
        <obo:OAE_0001849>圆锥形角膜</obo:OAE_0001849>
        <obo:OAE_0004334>10023353</obo:OAE_0004334>
        <rdfs:label>keratoconus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006216 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a palmoplantar eruption of air-filled bullae on an erythematous base, which results in lamellar peeling with hallmark superficial collarettes of scale.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26990340/</obo:IAO_0000119>
        <obo:OAE_0001849>角质溶解获得性剥离</obo:OAE_0001849>
        <obo:OAE_0004334>10052291</obo:OAE_0004334>
        <rdfs:label>keratolysis exfoliativa acquired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006217 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers a disease of the human eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratopathy</obo:IAO_0000119>
        <obo:OAE_0001849>角膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10023365</obo:OAE_0004334>
        <rdfs:label>keratopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006218 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers early manifestation of herpes zoster ophthalmicus .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32309125/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜葡萄膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10078693</obo:OAE_0004334>
        <rdfs:label>keratouveitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006219 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which is an inflammation and infection of the eyelid and portions of skin around the eye anterior to the orbital septum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periorbital_cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>眶周蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10057182</obo:OAE_0004334>
        <rdfs:label>periorbital cellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006220 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000019"/>
        <obo:IAO_0000115>This is an AE which is a type of hematoma of periorbital tissue, the most common cause being capillaries damaged by trauma, causing localized bleeding that extravasates into the surrounding interstitial tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruise</obo:IAO_0000119>
        <obo:OAE_0001849>眶周挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10062515</obo:OAE_0004334>
        <rdfs:label>periorbital contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006221 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which refers specifically to the layer of tissue surrounding the orbit that consists of periosteum feel discomfortable and may refer to anything that is around the orbit.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periorbita</obo:IAO_0000119>
        <obo:OAE_0001849>眶周疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10057425</obo:OAE_0004334>
        <rdfs:label>periorbital disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006222 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of periorbital blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>眶周血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10034544</obo:OAE_0004334>
        <rdfs:label>periorbital hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006223 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged periorbital  blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>眶周出血</obo:OAE_0001849>
        <obo:OAE_0004334>10071697</obo:OAE_0004334>
        <rdfs:label>periorbital hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006224 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of periorbital tissues to harmful stimuli, such as pathogens, damaged cells, or irritants,and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>眶周炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10080722</obo:OAE_0004334>
        <rdfs:label>periorbital inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006225 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004244"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the periorbital tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>眶周水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10034545</obo:OAE_0004334>
        <rdfs:label>periorbital edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006226 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000470"/>
        <obo:IAO_0000115>This is an AE which is a periorbital distressing feeling often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>眶周疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10034546</obo:OAE_0004334>
        <rdfs:label>periorbital pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006227 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000936"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of periorbital  area not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>眶周肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10056647</obo:OAE_0004334>
        <rdfs:label>periorbital swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006228 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003239"/>
        <obo:IAO_0000115>This is an AE which is a condition with herpetic caused by viral in which the eye&apos;s cornea, the clear dome on the front surface of the eye, becomes inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性角膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10078694</obo:OAE_0004334>
        <rdfs:label>viral keratouveitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006229 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is paralysis of the ciliary muscle of the eye, resulting in a loss of accommodation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cycloplegia</obo:IAO_0000119>
        <obo:OAE_0001849>睫状肌麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10011719</obo:OAE_0004334>
        <rdfs:label>cycloplegia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006231 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003239"/>
        <obo:IAO_0000115>This is an AE which is a pathology affecting the cornea.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Punctate_epithelial_erosions</obo:IAO_0000119>
        <obo:OAE_0001849>点状角膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037508</obo:OAE_0004334>
        <rdfs:label>punctate keratitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006232 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a rare, benign yet relapsing pustular dermatosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27349653/</obo:IAO_0000119>
        <obo:OAE_0001849>角膜下脓疱性皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10042342</obo:OAE_0004334>
        <rdfs:label>subcorneal pustular dermatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006233 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003239"/>
        <obo:IAO_0000115>This is an AE which is a condition with varicella in which the eye&apos;s cornea, the clear dome on the front surface of the eye, becomes inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Keratitis</obo:IAO_0000119>
        <obo:OAE_0001849>水痘角膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10077496</obo:OAE_0004334>
        <rdfs:label>varicella keratitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006234 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which can be a serious threat to vision if not treated appropriately and in a timely fashion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_injury</obo:IAO_0000119>
        <obo:OAE_0001849>角膜损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10022120</obo:OAE_0004334>
        <rdfs:label>injury corneal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006235 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a condition that results in the loss of eyelashes, and sometimes eyebrows.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Madarosis</obo:IAO_0000119>
        <obo:OAE_0001849>睫毛脱落</obo:OAE_0001849>
        <obo:OAE_0004334>10051235</obo:OAE_0004334>
        <rdfs:label>madarosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006236 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a medical term for abnormally positioned eyelashes that grow back toward the eye, touching the cornea or conjunctiva.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trichiasis</obo:IAO_0000119>
        <obo:OAE_0001849>倒睫</obo:OAE_0001849>
        <obo:OAE_0004334>10044604</obo:OAE_0004334>
        <rdfs:label>trichiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006237 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a part of the eye that includes the ciliary muscle, which controls the shape of the lens, and the ciliary epithelium, which produces the aqueous humor and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ciliary_body</obo:IAO_0000119>
        <obo:OAE_0001849>睫状体病症</obo:OAE_0001849>
        <obo:OAE_0004334>10057415</obo:OAE_0004334>
        <rdfs:label>ciliary body disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006238 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002037"/>
        <obo:IAO_0000115>This is an AE which is the increase of blood flow to different tissues in the ciliary.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperaemia</obo:IAO_0000119>
        <obo:OAE_0001849>纤毛性高血症</obo:OAE_0001849>
        <obo:OAE_0004334>10052129</obo:OAE_0004334>
        <rdfs:label>ciliary hyperemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006239 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <obo:IAO_0000115>This is an AE which is a sudden involuntary contraction of  ciliary muscle muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0001849>睫状肌痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10009185</obo:OAE_0004334>
        <rdfs:label>ciliary muscle spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006240 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is one of the hairs that grows at the edge of the eyelids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eyelash</obo:IAO_0000119>
        <obo:OAE_0001849>睫毛生长</obo:OAE_0001849>
        <obo:OAE_0004334>10048462</obo:OAE_0004334>
        <rdfs:label>growth of eyelashes AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006241 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare, ciliopathic, autosomal recessive genetic disorder that causes defects in the action of cilia lining the respiratory tract (lower and upper, sinuses, Eustachian tube, middle ear), fallopian tube, and flagellum of sperm cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_ciliary_dyskinesia</obo:IAO_0000119>
        <obo:OAE_0001849>不动纤毛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10060882</obo:OAE_0004334>
        <rdfs:label>immotile cilia syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006242 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which has also been observed in normal aging eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18418998/</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃体变性</obo:OAE_0001849>
        <obo:OAE_0004334>10047649</obo:OAE_0004334>
        <rdfs:label>vitreous degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006243 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a condition of the eye in which the vitreous membrane separates from the retina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Posterior_vitreous_detachment</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃体脱离</obo:OAE_0001849>
        <obo:OAE_0004334>10047650</obo:OAE_0004334>
        <rdfs:label>vitreous detachment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006244 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers a clear gel that fills the space between the lens and the retina in vertebrate eyes and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vitreous</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃体疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10047651</obo:OAE_0004334>
        <rdfs:label>vitreous disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006245 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is sometimes visible deposits within the eye&apos;s vitreous humour (&quot;the vitreous&quot;), which is normally transparent, or between the vitreous and retina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Floater</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃体漂浮物</obo:OAE_0001849>
        <obo:OAE_0004334>10047654</obo:OAE_0004334>
        <rdfs:label>vitreous floaters AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006246 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers a layer of collagen separating the vitreous body from the rest of the eye and it is haze.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vitreous</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃状混浊</obo:OAE_0001849>
        <obo:OAE_0004334>10077514</obo:OAE_0004334>
        <rdfs:label>vitreous haze AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006247 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which can be classified according to their aetiology as: genetic; inflammatory non-infectious; inflammatory infectious; inflammatory iatrogenic; degenerative, traumatic; neoplastic and idiopathic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18344965/</obo:IAO_0000119>
        <obo:OAE_0001849>玻璃体混浊</obo:OAE_0001849>
        <obo:OAE_0004334>10047658</obo:OAE_0004334>
        <rdfs:label>vitreous opacities AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006248 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003419"/>
        <obo:IAO_0000115>This is an AE which refers carries tears from the lacrimal sac of the eye into the nasal cavity and it is swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nasolacrimal_duct</obo:IAO_0000119>
        <obo:OAE_0001849>泪管肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10051209</obo:OAE_0004334>
        <rdfs:label>swollen tear duct AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006249 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is a common and reliable finding of brain herniation, ischaemia, and acute brain injury in critically ill patients.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32035804/</obo:IAO_0000119>
        <obo:OAE_0001849>瞳孔畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10057426</obo:OAE_0004334>
        <rdfs:label>pupillary deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006250 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which refers the  diagnosis of an afferent or efferent it  is crucial in the acquisition of a broad range of diseases of the brain or the peripheral nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30999363/</obo:IAO_0000119>
        <obo:OAE_0001849>瞳孔紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10037521</obo:OAE_0004334>
        <rdfs:label>pupillary disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006251 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is determined using dynamic pupillometry and is impaired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33551108/</obo:IAO_0000119>
        <obo:OAE_0001849>瞳孔反射受损</obo:OAE_0001849>
        <obo:OAE_0004334>10037532</obo:OAE_0004334>
        <rdfs:label>pupillary reflex impaired AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006252 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003424"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged scleral  blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>巩膜出血</obo:OAE_0001849>
        <obo:OAE_0004334>10050508</obo:OAE_0004334>
        <rdfs:label>scleral hemorrhage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006253 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004244"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the scleral tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>巩膜水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10057431</obo:OAE_0004334>
        <rdfs:label>scleral edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006254 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a benign, self-limiting inflammatory disease affecting part of the eye called the episclera.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Episcleritis</obo:IAO_0000119>
        <obo:OAE_0001849>巩膜外层炎</obo:OAE_0001849>
        <obo:OAE_0004334>10015084</obo:OAE_0004334>
        <rdfs:label>episcleritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006255 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is a serious inflammatory disease that affects the white outer coating of the eye, known as the sclera.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Scleritis</obo:IAO_0000119>
        <obo:OAE_0001849>巩膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10039705</obo:OAE_0004334>
        <rdfs:label>scleritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006256 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which consisted of cortical dots of various shapes that increased in number with the age of the carriers in older obligate carriers, subcapsular plaques were common.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/3763152/</obo:IAO_0000119>
        <obo:OAE_0001849>晶状体混浊</obo:OAE_0001849>
        <obo:OAE_0004334>10024214</obo:OAE_0004334>
        <rdfs:label>lenticular opacities AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006257 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002142"/>
        <obo:IAO_0000115>This is an AE which is a sudden involuntary contraction of a muscle when nictitating.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0001849>瞬目痉挛；瞬颤</obo:OAE_0001849>
        <obo:OAE_0004334>10078741</obo:OAE_0004334>
        <rdfs:label>nictitating spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006258 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a fold or line in the skin below the lower eyelid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dennie%E2%80%93Morgan_fold</obo:IAO_0000119>
        <obo:OAE_0001849>眶下皱襞</obo:OAE_0001849>
        <obo:OAE_0004334>10062918</obo:OAE_0004334>
        <rdfs:label>dennie-morgan fold AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is typical manifestations of systemic diseases (e. g. Graves&apos; disease) or typical complications of diseases in the vicinity of the orbit (e. g. orbital complications from inflammatory or tumorous sinus diseases).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33307575/</obo:IAO_0000119>
        <obo:OAE_0001849>眶病症</obo:OAE_0001849>
        <obo:OAE_0004334>10054717</obo:OAE_0004334>
        <rdfs:label>disorder of orbit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006260 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is the product of a mismatch between the axial length of the eye and its optical power, creating blurred vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31525141/</obo:IAO_0000119>
        <obo:OAE_0001849>屈光不正</obo:OAE_0001849>
        <obo:OAE_0004334>10038264</obo:OAE_0004334>
        <rdfs:label>refraction disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006261 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is vision loss or weakness that occurs without an apparent lesion affecting the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amaurosis</obo:IAO_0000119>
        <obo:OAE_0001849>黑内障，黑朦</obo:OAE_0001849>
        <obo:OAE_0004334>10001902</obo:OAE_0004334>
        <rdfs:label>amaurosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006262 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is the aqueous humor-filled space inside the eye between the iris and the cornea&apos;s innermost surface, the endothelium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anterior_chamber_of_eyeball</obo:IAO_0000119>
        <obo:OAE_0001849>前房细胞</obo:OAE_0001849>
        <obo:OAE_0004334>10053781</obo:OAE_0004334>
        <rdfs:label>anterior chamber cell AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006263 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is the aqueous humor-filled space inside the eye between the iris and the cornea&apos;s innermost surface  and it has  inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anterior_chamber_of_eyeball</obo:IAO_0000119>
        <obo:OAE_0001849>前房炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10054765</obo:OAE_0004334>
        <rdfs:label>anterior chamber inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006264 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a rare, late complication of cataract surgery, associated with impairment of visual function.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33425382/</obo:IAO_0000119>
        <obo:OAE_0001849>前囊收缩</obo:OAE_0001849>
        <obo:OAE_0004334>10054045</obo:OAE_0004334>
        <rdfs:label>anterior capsule contraction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006265 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is a type of refractive error due to rotational asymmetry in the eye&apos;s refractive power.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Astigmatism</obo:IAO_0000119>
        <obo:OAE_0001849>散光</obo:OAE_0001849>
        <obo:OAE_0004334>10003569</obo:OAE_0004334>
        <rdfs:label>astigmatism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006266 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which refers difficulty seeing in the presence of very bright light.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Glare</obo:IAO_0000119>
        <obo:OAE_0001849>眩光</obo:OAE_0001849>
        <obo:OAE_0004334>10052128</obo:OAE_0004334>
        <rdfs:label>glare AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006267 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is the most common complication after cataract surgery, with an incidence of 30%.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25455552/</obo:IAO_0000119>
        <obo:OAE_0001849>后发性白内障</obo:OAE_0001849>
        <obo:OAE_0004334>10036346</obo:OAE_0004334>
        <rdfs:label>posterior capsule opacification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006268 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a rare benign neuroepithelial intraventricular WHO grade I lesion found in the choroid plexus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Choroid_plexus_papilloma</obo:IAO_0000119>
        <obo:OAE_0001849>脉络丛乳头状瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10008777</obo:OAE_0004334>
        <rdfs:label>choroid plexus papilloma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006269 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which is a prevalent and potentially vision-threatening complication following glaucoma surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25325867/</obo:IAO_0000119>
        <obo:OAE_0001849>脉络膜的积液</obo:OAE_0001849>
        <obo:OAE_0004334>10063970</obo:OAE_0004334>
        <rdfs:label>choroidal effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006270 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the choroid (thin pigmented vascular coat of the eye) and retina of the eye.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chorioretinitis</obo:IAO_0000119>
        <obo:OAE_0001849>脉络膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008792</obo:OAE_0004334>
        <rdfs:label>choroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006271 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a closed  macular sac, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10025407</obo:OAE_0004334>
        <rdfs:label>macular cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006272 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002223"/>
        <obo:IAO_0000115>This is an AE which is formation of the fibrous tissue in place of the normal retinal tissue on the macular area of the retina which provides the sharpest vision in the eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macular_scarring</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑脱离</obo:OAE_0001849>
        <obo:OAE_0004334>10075873</obo:OAE_0004334>
        <rdfs:label>macular detachment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006273 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing in which connective tissue replaces normal parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue such as macular fibrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10071392</obo:OAE_0004334>
        <rdfs:label>macular fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006274 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is a small break in the macula, located in the center of the eye&apos;s light-sensitive tissue called the retina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macular_hole</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑孔</obo:OAE_0001849>
        <obo:OAE_0004334>10051058</obo:OAE_0004334>
        <rdfs:label>macular hole AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006275 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004244"/>
        <obo:IAO_0000115>This is an AE which occurs when fluid and protein deposits collect on or under the macula of the eye (a yellow central area of the retina) and causes it to thicken and swell (edema).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Macular_edema</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10025415</obo:OAE_0004334>
        <rdfs:label>macular edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006276 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001296"/>
        <obo:IAO_0000115>This is an AE which is a polygenic phenotypic character determined by two distinct factors: the pigmentation of the eye&apos;s iris and the frequency-dependence of the scattering of light by the turbid medium in the stroma of the iris.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eye_color</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑色素沉着</obo:OAE_0001849>
        <obo:OAE_0004334>10071041</obo:OAE_0004334>
        <rdfs:label>macular pigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006277 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>This is an AE which is supposed to be different from that of macular lamellar hole (LMH) and is thought to be caused by centripetal contraction of previously present epiretinal membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20703497/</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑假孔</obo:OAE_0001849>
        <obo:OAE_0004334>10060815</obo:OAE_0004334>
        <rdfs:label>macular pseudohole AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006278 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is any pathological condition of the macula, an area at the centre of the retina that is associated with highly sensitive, accurate vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Maculopathy</obo:IAO_0000119>
        <obo:OAE_0001849>黄斑病变</obo:OAE_0001849>
        <obo:OAE_0004334>10025425</obo:OAE_0004334>
        <rdfs:label>maculopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006279 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000115>This is an AE which is the presence of perceived flashes of light in the field of vision.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Photopsia</obo:IAO_0000119>
        <obo:OAE_0001849>闪光幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10034962</obo:OAE_0004334>
        <rdfs:label>photopsia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006280 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001886"/>
        <obo:IAO_0000115>This is an AE which is a form of uveitis localized to the vitreous and peripheral retina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intermediate_uveitis</obo:IAO_0000119>
        <obo:OAE_0001849>中度葡萄膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10022557</obo:OAE_0004334>
        <rdfs:label>intermediate uveitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006281 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:OAE_0001849>视力暂时下降</obo:OAE_0001849>
        <obo:OAE_0004334>10047532</obo:OAE_0004334>
        <rdfs:label>visual acuity reduced transiently AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006282 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
