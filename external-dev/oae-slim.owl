    <!-- http://purl.obolibrary.org/obo/OAE_0007122 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004320"/>
        <obo:IAO_0000115>This is an AE which is an insect-borne parasitic infection of humans and other animals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/African_trypanosomiasis</obo:IAO_0000119>
