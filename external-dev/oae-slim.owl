    <!-- http://purl.obolibrary.org/obo/OAE_0005599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases involving rectosigmoid abnormal cell growth with the potential to invade or spread to other parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
