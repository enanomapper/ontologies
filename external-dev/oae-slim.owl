    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007491 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is an abnormality that a person is born with in which one or both of the kidneys are smaller than normal (hypoplastic) but with normal structure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Renal_hypoplasia</obo:IAO_0000119>
        <obo:OAE_0001849>肾发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10049102</obo:OAE_0004334>
        <rdfs:label>renal hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007492 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <obo:IAO_0000115>This is an AE which is an arterial vascular event that may cause irreversible damage to kidney tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23204242/</obo:IAO_0000119>
        <obo:OAE_0001849>肾梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10038470</obo:OAE_0004334>
