        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a surgical procedure that is used to remove (ablate) or destroy the endometrial lining of the uterus in people with uteruses who have heavy menstrual bleeding.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endometrial_ablation</obo:IAO_0000119>
        <obo:OAE_0001849>子宫内膜消融</obo:OAE_0001849>
