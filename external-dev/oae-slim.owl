    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005146 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is a set of manifestations caused by the failure of the heart&apos;s function as a pump supporting the blood flow through the body; its signs and symptoms result from a structural and/or functional abnormality of the heart, that disrupts its filling with blood or its ejecting of it during each heart beat</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heart_failure</obo:IAO_0000119>
        <obo:OAE_0001849>心脏功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10079751</obo:OAE_0004334>
        <rdfs:label>cardiac dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005147 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <obo:IAO_0000115>This is an AE which is a syndrome defined as the new onset (de novo heart failure (HF)) or worsening (acutely decompensated heart failure (ADHF)) of symptoms and signs of HF, mostly related to systemic congestion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32139695/</obo:IAO_0000119>
        <obo:OAE_0001849>急性心力衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10007556</obo:OAE_0004334>
        <rdfs:label>cardiac failure acute AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005148 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <obo:IAO_0000115>This is an AE which is a long-term condition, usually kept stable by the treatment of symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Heart_failure#Classification_2</obo:IAO_0000119>
        <obo:OAE_0001849>慢性心脏衰竭</obo:OAE_0001849>
        <obo:OAE_0004334>10007558</obo:OAE_0004334>
