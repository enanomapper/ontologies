        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <obo:IAO_0000115>This is an AE which refers to a mass of lymphoid tissue in the pharynx.</obo:IAO_0000115>
