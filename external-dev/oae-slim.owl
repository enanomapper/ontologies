        <obo:IAO_0000115>a cardiac and vascular investigation result abnormal AE that is an abnormal result of a test that uses sound waves to create a moving picture of the heart</obo:IAO_0000115>
        <obo:IAO_0000117>EB</obo:IAO_0000117>
        <obo:OAE_0004334>10061593</obo:OAE_0004334>
        <rdfs:label xml:lang="en">echocardiogram result abnormal AE</rdfs:label>
    </owl:Class>
    


