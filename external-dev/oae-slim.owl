        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is a condition in which organs fall down or slip out of place such as ovarian prolapse.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Prolapse</obo:IAO_0000119>
        <obo:OAE_0001849>子宫脱垂</obo:OAE_0001849>
        <obo:OAE_0004334>10033277</obo:OAE_0004334>
        <rdfs:label>ovarian prolapse AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008441 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which is when an ovary twists on its attachment to other structures, such that blood flow is decreased.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ovarian_torsion</obo:IAO_0000119>
        <obo:OAE_0001849>卵巢扭转</obo:OAE_0001849>
        <obo:OAE_0004334>10033280</obo:OAE_0004334>
        <rdfs:label>ovarian torsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008442 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002425"/>
        <obo:IAO_0000115>This is an AE which is listed in the DSM-5 under Disruptive, impulse-control, and conduct disorders and defined as &quot;a pattern of angry/irritable mood, argumentative/defiant behavior, or vindictiveness&quot;.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oppositional_defiant_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>对立违抗性障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10056440</obo:OAE_0004334>
        <rdfs:label>oppositional defiant disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008443 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which occurs in young adult men, and leads to pain and swelling of the testis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33815357/</obo:IAO_0000119>
        <obo:OAE_0001849>睾丸炎流行性腮腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10031068</obo:OAE_0004334>
        <rdfs:label>orchitis mumps AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008444 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the testes and is noninfective.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Orchitis</obo:IAO_0000119>
