        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002038"/>
        <obo:IAO_0000115>This is an AE which is pain or discomfort when an affected abdominal area is touched.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tenderness_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>腹部压痛</obo:OAE_0001849>
        <obo:OAE_0004334>10000097</obo:OAE_0004334>
        <rdfs:label>abdominal tenderness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004592 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000241"/>
