    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a chronic, inflammatory skin disease of unknown cause which can affect any body part of any person but has a strong preference for the genitals (penis, vulva) and is also known as balanitis xerotica obliterans (BXO) when it affects the penis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lichen_sclerosus</obo:IAO_0000119>
        <obo:OAE_0001849>硬化性苔癣</obo:OAE_0001849>
        <obo:OAE_0004334>10024434</obo:OAE_0004334>
        <rdfs:label>lichen sclerosus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008864 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000481"/>
        <obo:IAO_0000115>This is an AE which is the most common demyelinating disease, in which the insulating covers of nerve cells in the brain and spinal cord are damaged and it has plaque.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>多发性硬化斑块</obo:OAE_0001849>
        <obo:OAE_0004334>10078558</obo:OAE_0004334>
        <rdfs:label>multiple sclerosis plaque AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>This is an AE which is a neuropathological condition with severe neuronal cell loss and gliosis in the hippocampus, specifically in the CA-1 (Cornu Ammonis area 1) and subiculum of the hippocampus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hippocampal_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>海马硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10063629</obo:OAE_0004334>
        <rdfs:label>hippocampal sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008866 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004263"/>
        <obo:IAO_0000115>This is an AE which is a form of Hodgkin&apos;s lymphoma that is the most common subtype of HL in developed countries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nodular_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>霍奇金氏病结节性硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10020244</obo:OAE_0004334>
        <rdfs:label>hodgkin&apos;s disease nodular sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008867 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is a genetic multisystem disorder characterised by widespread hamartomas in several organs, including the brain, heart, skin, eyes, kidney, lung, and liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18722871/</obo:IAO_0000119>
        <obo:OAE_0001849>结节性硬化症</obo:OAE_0001849>
        <obo:OAE_0004334>10045138</obo:OAE_0004334>
        <rdfs:label>tuberous sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008868 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which refers epidermal thickening characterized by visible and palpable thickening of the skin with accentuated skin markings.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Secondary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>苔藓样硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10024438</obo:OAE_0004334>
        <rdfs:label>lichenification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008869 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008869">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is a disease in which the white matter of the brain appears damaged in concentric layers, leaving the axis cylinder intact.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Balo_concentric_sclerosis</obo:IAO_0000119>
        <obo:OAE_0001849>向心性硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10010252</obo:OAE_0004334>
        <rdfs:label>concentric sclerosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008870 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000214"/>
        <obo:IAO_0000115>This is an AE which is dermal thickening causing the cutaneous surface to feel thicker and firmer.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Secondary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10060708</obo:OAE_0004334>
        <rdfs:label>induration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008871 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000894"/>
        <obo:IAO_0000115>This ia an AE which is a  eyelid skin condition characterized by excessively dry skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Xeroderma</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑皮肤干燥</obo:OAE_0001849>
        <obo:OAE_0004334>10071717</obo:OAE_0004334>
        <rdfs:label>eyelid skin dryness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008872 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which pressure is placed on the skin, the skin is damaged and is unable to be repaired due to the lack of blood perfusing the tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arterial_insufficiency_ulcer</obo:IAO_0000119>
        <obo:OAE_0001849>缺血性皮肤溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10077408</obo:OAE_0004334>
        <rdfs:label>ischemic skin ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008873 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the condition of dissimilar particles or surfaces to cling to one another  on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adhesion</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤粘连</obo:OAE_0001849>
        <obo:OAE_0004334>10074976</obo:OAE_0004334>
        <rdfs:label>skin adhesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008874 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin condition present at birth regardless of its cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect</obo:IAO_0000119>
        <obo:OAE_0001849>先天性皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10067769</obo:OAE_0004334>
        <rdfs:label>congenital skin disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008875 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a small elevation of the skin containing cloudy or purulent material (pus) usually consisting of necrotic inflammatory cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Pustule</obo:IAO_0000119>
        <obo:OAE_0001849>脓包</obo:OAE_0001849>
        <obo:OAE_0004334>10037578</obo:OAE_0004334>
        <rdfs:label>pustule AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008876 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an enlargement of skin tissue caused by an increase in the amount of organic tissue that results from cell proliferation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤增生</obo:OAE_0001849>
        <obo:OAE_0004334>10074507</obo:OAE_0004334>
        <rdfs:label>skin hyperplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008877 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the degeneration of skin tissue, due to disease or malnutrition, most likely due to heredity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dystrophy</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤营养不良</obo:OAE_0001849>
        <obo:OAE_0004334>10040836</obo:OAE_0004334>
        <rdfs:label>skin dystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008878 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an Ae which is the increase in the volume of skin tissue due to the enlargement of its component cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophy</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤肥大</obo:OAE_0001849>
        <obo:OAE_0004334>10040867</obo:OAE_0004334>
        <rdfs:label>skin hypertrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008879 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the result of a continuous process based on degenerative skin cell changes, affecting tissues or organs, which will increasingly deteriorate over time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Degenerative_disease</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤退化性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061531</obo:OAE_0004334>
        <rdfs:label>skin degenerative disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008880 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is underdevelopment or incomplete development of a skin tissue .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoplasia</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10040869</obo:OAE_0004334>
        <rdfs:label>skin hypoplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008881 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a mass of cells that lacks the ability to either invade neighboring tissue or metastasize and occurs on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤良性肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10004398</obo:OAE_0004334>
        <rdfs:label>benign neoplasm of skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008882 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a small cutaneous depressions that can be noted on any part of the body and may be caused by traumatic, mechanical, metabolic, and genetic factors as well as by exposure to infections or drugs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31602696/</obo:IAO_0000119>
        <obo:OAE_0001849>先天性皮肤酒窝</obo:OAE_0001849>
        <obo:OAE_0004334>10072978</obo:OAE_0004334>
        <rdfs:label>congenital skin dimples AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008883 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which may present as either a superficial or deep infection of the skin, hair, and/or nails.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_infection</obo:IAO_0000119>
        <obo:OAE_0001849>真菌性皮肤感染</obo:OAE_0001849>
        <obo:OAE_0004334>10017543</obo:OAE_0004334>
        <rdfs:label>fungal skin infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008884 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the most frequent and potentially fatal complication of an allogeneic hematopoietic progenitor cell transplantation  on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30309668/</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤移植抗宿主病</obo:OAE_0001849>
        <obo:OAE_0004334>10064675</obo:OAE_0004334>
        <rdfs:label>graft versus host disease in skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008885 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of diseases, characterized by a skin inflammatory reaction triggered by a wide variety of stimuli, including infections, foreign bodies, malignancy, metabolites, and chemicals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29352388/</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤肉芽肿</obo:OAE_0001849>
        <obo:OAE_0004334>10018698</obo:OAE_0004334>
        <rdfs:label>granuloma skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008886 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a usually benign vascular skin tumor derived from blood vessel cell types.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemangioma</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤血管瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10018823</obo:OAE_0004334>
        <rdfs:label>haemangioma of skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008887 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a sore on the skin or a mucous membrane, accompanied by the disintegration of tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ulcer_(dermatology)</obo:IAO_0000119>
        <obo:OAE_0001849>感染性皮肤溃疡</obo:OAE_0001849>
        <obo:OAE_0004334>10021784</obo:OAE_0004334>
        <rdfs:label>infected skin ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008888 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of skin tissue .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>肿瘤皮肤</obo:OAE_0001849>
        <obo:OAE_0004334>10029098</obo:OAE_0004334>
        <rdfs:label>neoplasm skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008889 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is skin neoplasms that arise from  cells of the endocrine  and nervous systems  .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuroendocrine_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤神经内分泌肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029266</obo:OAE_0004334>
        <rdfs:label>neuroendocrine carcinoma of the skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008890 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which refers to skin lesions with a degree of risk of progression to squamous cell carcinoma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27658688/</obo:IAO_0000119>
        <obo:OAE_0001849>癌前皮肤病变</obo:OAE_0001849>
        <obo:OAE_0004334>10049422</obo:OAE_0004334>
        <rdfs:label>precancerous skin lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008891 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is most commonly caused by infection by the bacterium Staphylococcus aureus, resulting in a painful swollen area on the skin caused by an accumulation of pus and dead tissue，meantime it often recurs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Boil</obo:IAO_0000119>
        <obo:OAE_0001849>复发性皮肤疖子</obo:OAE_0001849>
        <obo:OAE_0004334>10038143</obo:OAE_0004334>
        <rdfs:label>recurring skin boils AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008892 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin condition in which skin is prone to itching and irritation experienced as a subjective sensation when using cosmetics and toiletries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sensitive_skin</obo:IAO_0000119>
        <obo:OAE_0001849>敏感型皮肤</obo:OAE_0001849>
        <obo:OAE_0004334>10081765</obo:OAE_0004334>
        <rdfs:label>sensitive skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008893 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an  AE which bacterial skin infections include Cellulitis, Erysipelas,Folliculitis and Impetigo.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_infection</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤细菌感染</obo:OAE_0001849>
        <obo:OAE_0004334>10052891</obo:OAE_0004334>
        <rdfs:label>skin bacterial infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008894 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is  kind of cancers that arise from the skin and they are due to the development of abnormal cells that have the ability to invade or spread to other parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤癌</obo:OAE_0001849>
        <obo:OAE_0004334>10040808</obo:OAE_0004334>
        <rdfs:label>skin cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008895 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002455"/>
        <obo:IAO_0000115>This is an AE which is located on most of mucosal surfaces and mainly the skin and candida are almost universal in low numbers on healthy adult skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Candida_(fungus)</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤念珠菌</obo:OAE_0001849>
        <obo:OAE_0004334>10054152</obo:OAE_0004334>
        <rdfs:label>skin candida AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008896 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008896">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is  defined as necrotic lesions that should have required additional resection after breast reconstruction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30426185/</obo:IAO_0000119>
        <obo:OAE_0001849>皮瓣坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10068774</obo:OAE_0004334>
        <rdfs:label>skin flap necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008897 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a cutaneous condition characterized by trauma-induced blisters and erosions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_fragility_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤脆弱症</obo:OAE_0001849>
        <obo:OAE_0004334>10040851</obo:OAE_0004334>
        <rdfs:label>skin fragility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008898 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which refers to cause an indentation in the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wedding_ring</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤压痕</obo:OAE_0001849>
        <obo:OAE_0004334>10079274</obo:OAE_0004334>
        <rdfs:label>skin indentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008899 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of skin tissues to harmful stimuli, such as pathogens, damaged cells, or irritants,and is a protective response involving immune cells, blood vessels, and molecular mediators.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10062249</obo:OAE_0004334>
        <rdfs:label>skin inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008900 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008900">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which specifically refers to a sharp injury which damages the dermis of the skin in pathology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Injury</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061364</obo:OAE_0004334>
        <rdfs:label>skin injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008901 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is defined as the softening and breaking down of skin resulting from prolonged exposure to moisture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_maceration</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤浸渍</obo:OAE_0001849>
        <obo:OAE_0004334>10048625</obo:OAE_0004334>
        <rdfs:label>skin maceration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008902 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008902">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an area of  edema of the lower layer of skin  under the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angioedema</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10058679</obo:OAE_0004334>
        <rdfs:label>skin edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008903 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which has been described as a broad papule, or confluence of papules equal to or greater than 10 mm, or alternatively as an elevated, plateau-like lesion that is greater in its diameter than in its depth on the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Primary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤斑</obo:OAE_0001849>
        <obo:OAE_0004334>10067723</obo:OAE_0004334>
        <rdfs:label>skin plaque AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008904 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008904">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which specifically refers to a sharp injury which damages the epidermis of the skin in pathology .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wound</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤伤口</obo:OAE_0001849>
        <obo:OAE_0004334>10072170</obo:OAE_0004334>
        <rdfs:label>skin wound AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008905 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic condition characterized by sagging, wrinkled skin, low skin elasticity, and delayed fontanel (soft spot) closure along with a range of other symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Wrinkly_skin_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤皱纹</obo:OAE_0001849>
        <obo:OAE_0004334>10040954</obo:OAE_0004334>
        <rdfs:label>skin wrinkling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008906 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008906">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which comprises a number of different types of cancer that result from squamous cells that  form on the surface of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Squamous_cell_carcinoma</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤鳞状细胞癌</obo:OAE_0001849>
        <obo:OAE_0004334>10041834</obo:OAE_0004334>
        <rdfs:label>squamous cell carcinoma of skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008907 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008907">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a dermatological condition caused by Staphylococcus aureus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Staphylococcal_scalded_skin_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌性烫伤样皮肤综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10041929</obo:OAE_0004334>
        <rdfs:label>staphylococcal scalded skin syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008908 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an skin infection caused by members of the Staphylococcus genus of bacteria .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Staphylococcal_infection</obo:IAO_0000119>
        <obo:OAE_0001849>葡萄球菌皮肤感染</obo:OAE_0001849>
        <obo:OAE_0004334>10066409</obo:OAE_0004334>
        <rdfs:label>staphylococcal skin infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008909 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a popular name for an alleged ability of some people to attract objects to their skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Human_magnetism</obo:IAO_0000119>
        <obo:OAE_0001849>粘性皮肤</obo:OAE_0001849>
        <obo:OAE_0004334>10051788</obo:OAE_0004334>
        <rdfs:label>sticky skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008910 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a rash with central clearing in dermatology .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Target_lesion</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤靶样病变</obo:OAE_0001849>
        <obo:OAE_0004334>10081998</obo:OAE_0004334>
        <rdfs:label>target skin lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008911 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which refers to Virus-related cutaneous conditions caused by these obligate intracellular agents derive from both DNA and RNA viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_infection</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性皮肤感染</obo:OAE_0001849>
        <obo:OAE_0004334>10065173</obo:OAE_0004334>
        <rdfs:label>viral skin infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008912 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a yellowish or greenish pigmentation of the skin and whites of the eyes due to high bilirubin levels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Jaundice</obo:IAO_0000119>
        <obo:OAE_0001849>黄疸</obo:OAE_0001849>
        <obo:OAE_0004334>10048245</obo:OAE_0004334>
        <rdfs:label>yellow skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008913 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the loss of intercellular connections, such as desmosomes, resulting in loss of cohesion between keratinocytes, seen in diseases such as pemphigus vulgaris.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acantholysis</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤棘层松解</obo:OAE_0001849>
        <obo:OAE_0004334>10058820</obo:OAE_0004334>
        <rdfs:label>acantholysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008914 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008914">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin neoplasm composed of squamous or epidermal cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acanthoma</obo:IAO_0000119>
        <obo:OAE_0001849>棘皮瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10059394</obo:OAE_0004334>
        <rdfs:label>acanthoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008915 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is diffuse epidermal hyperplasia (thickening of the skin, and not to be confused with acanthocytes).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epidermis#Hyperplasia</obo:IAO_0000119>
        <obo:OAE_0001849>棘皮症</obo:OAE_0001849>
        <obo:OAE_0004334>10000349</obo:OAE_0004334>
        <rdfs:label>acanthosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008916 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This ia an AE which is a childhood form of dermatitis selectively affecting the hands and feet and may be accompanied by mild symptoms of fever and malaise.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acrodermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>螨性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10063409</obo:OAE_0004334>
        <rdfs:label>acarodermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008917 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000250"/>
        <obo:IAO_0000115>This is an AE which is a highly inflammatory disease presenting with comedones, nodules, abscesses, and draining sinus tracts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acne_conglobata</obo:IAO_0000119>
        <obo:OAE_0001849>聚合型痤疮</obo:OAE_0001849>
        <obo:OAE_0004334>10000501</obo:OAE_0004334>
        <rdfs:label>acne conglobata AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008918 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008918">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000250"/>
        <obo:IAO_0000115>This ia an AE which refers an inflammatory nodule with or without an associated epidermoid inclusion cyst.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>囊性痤疮</obo:OAE_0001849>
        <obo:OAE_0004334>10000503</obo:OAE_0004334>
        <rdfs:label>acne cystic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008919 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008919">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000250"/>
        <obo:IAO_0000115>This is an AE which is a form of acneiform eruption that occurs in infants from 6 weeks to 1 year of age.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infantile_acne</obo:IAO_0000119>
        <obo:OAE_0001849>婴儿痤疮</obo:OAE_0001849>
        <obo:OAE_0004334>10000507</obo:OAE_0004334>
        <rdfs:label>acne infantile AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008920 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000250"/>
        <obo:IAO_0000115>This is an AE which is a long-term skin condition with pustular that occurs when dead skin cells and oil from the skin clog hair follicles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acne</obo:IAO_0000119>
        <obo:OAE_0001849>脓疱性痤疮</obo:OAE_0001849>
        <obo:OAE_0004334>10000513</obo:OAE_0004334>
        <rdfs:label>acne pustular AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008921 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000250"/>
        <obo:IAO_0000115>This is an AE which is a rare condition consisting of follicular vesicopustules, sometimes occurring as solitary lesions that are usually very itchy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acne_miliaris_necrotica</obo:IAO_0000119>
        <obo:OAE_0001849>痘疱样痤疮</obo:OAE_0001849>
        <obo:OAE_0004334>10000518</obo:OAE_0004334>
        <rdfs:label>acne varioliformis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008922 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004303"/>
        <obo:IAO_0000115>This is an AE which is a chronic subepidermal blistering disease associated with autoimmunity to type VII collagen within anchoring fibril structures that are located at the dermoepidermal junction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epidermolysis_bullosa_acquisita</obo:IAO_0000119>
        <obo:OAE_0001849>后天性大疱性表皮松解</obo:OAE_0001849>
        <obo:OAE_0004334>10056508</obo:OAE_0004334>
        <rdfs:label>acquired epidermolysis bullosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008923 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a childhood form of dermatitis selectively affecting the hands and feet and may be accompanied by mild symptoms of fever and malaise.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acrodermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>肢皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10000593</obo:OAE_0004334>
        <rdfs:label>acrodermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008924 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a dermatological condition that takes a chronically progressive course and finally leads to a widespread atrophy of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Acrodermatitis_chronica_atrophicans</obo:IAO_0000119>
        <obo:OAE_0001849>慢性萎缩性肢皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10000594</obo:OAE_0004334>
        <rdfs:label>acrodermatitis chronica atrophicans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008925 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin disease characterized by the sudden onset of fever, an elevated white blood cell count, and tender, red, well-demarcated papules and plaques that show dense infiltrates by neutrophil granulocytes on histologic examination.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Febrile_neutrophilic_dermatosis</obo:IAO_0000119>
        <obo:OAE_0001849>急性发热性中性粒细胞性皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10000748</obo:OAE_0004334>
        <rdfs:label>acute febrile neutrophilic dermatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008926 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the application site  skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>用药部位皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10003054</obo:OAE_0004334>
        <rdfs:label>application site rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008927 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a rare, cutaneous condition that causes dermal atrophy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30085611/</obo:IAO_0000119>
        <obo:OAE_0001849>帕西尼和皮耶尼氏萎缩皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10066406</obo:OAE_0004334>
        <rdfs:label>atrophoderma of pasini and pierini AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008928 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10003694</obo:OAE_0004334>
        <rdfs:label>atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008929 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the skin, typically characterized by itchiness, redness and a rash and it is autoimmune.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10075689</obo:OAE_0004334>
        <rdfs:label>autoimmune dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008930 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which induced by heparin is a rare and benign side effect .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32005507/</obo:IAO_0000119>
        <obo:OAE_0001849>大疱性出血性皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10083809</obo:OAE_0004334>
        <rdfs:label>bullous haemorrhagic dermatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008931 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which is an cryptococcal infection of the skin in humans and other animals, that can also affect the associated soft tissues such as loose connective tissue and mucous membranes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_infection</obo:IAO_0000119>
        <obo:OAE_0001849>隐球菌皮肤感染</obo:OAE_0001849>
        <obo:OAE_0004334>10054216</obo:OAE_0004334>
        <rdfs:label>cryptococcal cutaneous infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008932 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000509"/>
        <obo:IAO_0000115>This is an AE which is a collection of autoimmune diseases in which the human immune system becomes hyperactive and attacks healthy tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lupus_erythematosus</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤红斑狼疮</obo:OAE_0001849>
        <obo:OAE_0004334>10056509</obo:OAE_0004334>
        <rdfs:label>cutaneous lupus erythematosus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008933 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a disease involving abnormal collections of inflammatory cells that form lumps known as granulomata.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sarcoidosis</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤结节病</obo:OAE_0001849>
        <obo:OAE_0004334>10011674</obo:OAE_0004334>
        <rdfs:label>cutaneous sarcoidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008934 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the layer of usually soft, flexible outer tissue covering the body of a vertebrate animal, with three main functions: protection, regulation, and sensation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤的症状</obo:OAE_0001849>
        <obo:OAE_0004334>10075531</obo:OAE_0004334>
        <rdfs:label>cutaneous symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008935 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a group of rare connective tissue disorders in which the skin becomes inelastic and hangs loosely in folds.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cutis_laxa</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤松弛</obo:OAE_0001849>
        <obo:OAE_0004334>10011692</obo:OAE_0004334>
        <rdfs:label>cutis laxa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008936 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin condition of the posterior neck, characterized by deep furrowing of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cutis_rhomboidalis_nuchae</obo:IAO_0000119>
        <obo:OAE_0001849>菱形皮肤</obo:OAE_0001849>
        <obo:OAE_0004334>10059441</obo:OAE_0004334>
        <rdfs:label>cutis rhomboidalis nuchae AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008937 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000549"/>
        <obo:IAO_0000115>This is an AE which is a generalized bluish discoloration of the body and the visible mucous membranes, which occurs due to inadequate oxygenation secondary to conditions that lead to an increase in deoxygenated hemoglobin or presence of abnormal hemoglobin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32644593/</obo:IAO_0000119>
        <obo:OAE_0001849>中枢性紫绀</obo:OAE_0001849>
        <obo:OAE_0004334>10011704</obo:OAE_0004334>
        <rdfs:label>cyanosis central AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008938 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000549"/>
        <obo:IAO_0000115>This is an AE which is the change of neonatal body tissue color to a bluish-purple hue as a result of having decreased amounts of oxygen bound to the hemoglobin in the red blood cells of the capillary bed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyanosis</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿紫绀</obo:OAE_0001849>
        <obo:OAE_0004334>10011705</obo:OAE_0004334>
        <rdfs:label>cyanosis neonatal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008939 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002488"/>
        <obo:IAO_0000115>This is an AE which is a closed dermal sac, having a distinct envelope and division compared with the nearby tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>真皮囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10012426</obo:OAE_0004334>
        <rdfs:label>dermal cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008940 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a sac or cavity in any organ or tissue, or an abnormal cavity or passage caused by the destruction of tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sinus_(anatomy)</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤窦</obo:OAE_0001849>
        <obo:OAE_0004334>10012428</obo:OAE_0004334>
        <rdfs:label>dermal sinus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008941 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a rare disease that seldom affects the genitals.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29463978/</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10065701</obo:OAE_0004334>
        <rdfs:label>dermatillomania AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008942 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a chronic inflammatory skin disease that is characterised by intense itching and recurrent eczematous lesions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26377142/</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10012434</obo:OAE_0004334>
        <rdfs:label>dermatitis allergic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008943 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>This is an AE which is a long-term type of inflammation of the skin (dermatitis).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atopic_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>特应性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10012438</obo:OAE_0004334>
        <rdfs:label>dermatitis atopic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008944 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is a type of inflammation of the skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Contact_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>接触性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10012442</obo:OAE_0004334>
        <rdfs:label>dermatitis contact AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008945 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is one of the most common skin conditions that infants suffer from and their caregivers manage in the first months post-birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29596731/</obo:IAO_0000119>
        <obo:OAE_0001849>皮炎尿布</obo:OAE_0001849>
        <obo:OAE_0004334>10012444</obo:OAE_0004334>
        <rdfs:label>dermatitis diaper AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008946 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is an uncommon but serious skin disorder that family physicians must be able to recognize and treat appropriately.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/10029788/</obo:IAO_0000119>
        <obo:OAE_0001849>皮炎剥脱性全身性</obo:OAE_0001849>
        <obo:OAE_0004334>10012456</obo:OAE_0004334>
