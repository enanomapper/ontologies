    <!-- http://purl.obolibrary.org/obo/OAE_0004534 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001764"/>
        <obo:IAO_0000115>An adverse event with the outcome of the cerebral venous sinus thrombosis (CVST), which occurs when a blood clot forms in the brain’s venous sinuses. CVST prevents blood from draining out of the brain. As a result, blood cells may break and leak blood into the brain tissues, forming a hemorrhage.</obo:IAO_0000115>
        <obo:IAO_0000117>Jessica DeGuise, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.hopkinsmedicine.org/health/conditions-and-diseases/cerebral-venous-sinus-thrombosis</obo:IAO_0000119>
        <obo:OAE_0004334 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10083037</obo:OAE_0004334>
        <rdfs:comment>CVST</rdfs:comment>
        <rdfs:label xml:lang="en">cerebral venous sinus thrombosis AE</rdfs:label>
    </owl:Class>
    


