    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005149 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is an irregular and uncoordinated contraction of the cardiac muscle of atria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrillation</obo:IAO_0000119>
        <obo:OAE_0001849>心脏颤动</obo:OAE_0001849>
        <obo:OAE_0004334>10061592</obo:OAE_0004334>
        <rdfs:label>cardiac fibrillation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005150 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which a common abnormal heart rhythm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Flutter</obo:IAO_0000119>
        <obo:OAE_0001849>心脏扑动</obo:OAE_0001849>
        <obo:OAE_0004334>10052840</obo:OAE_0004334>
        <rdfs:label>cardiac flutter AE</rdfs:label>
    </owl:Class>
    


