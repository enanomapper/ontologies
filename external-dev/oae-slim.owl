    <!-- http://purl.obolibrary.org/obo/OAE_0002101 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>an edema AE with an outcome of tracheal edema, which is the swelling of the airway between the throat and the lungs</obo:IAO_0000115>
        <obo:IAO_0000117>RR</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://firstaidcalgary.ca/causes-of-tracheal-edema/</obo:IAO_0000119>
        <obo:OAE_0004334>10044296</obo:OAE_0004334>
        <rdfs:label xml:lang="en">tracheal edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002102 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Allergic eruption AE is a skin AE that is most drug-induced cutaneous reactions, especially found in younger adults. Sometimes also be diagnosed with eczema.</obo:IAO_0000115>
        <obo:IAO_0000116>This term appears to be a synonym to the &apos;eczema AE&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>过敏性皮疹</obo:OAE_0001849>
        <rdfs:label>allergic eruption AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002103 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>Erythrodermia AE is a skin AE that is an inflammatory skin disease with erythema and scaling that affects nearly the entire cutaneous surface.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>dermatitis exfoliativa AE</obo:IAO_0000118>
        <obo:IAO_0000118>exfoliative dermatitis AE</obo:IAO_0000118>
        <obo:IAO_0000118>red man syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythroderma</obo:IAO_0000119>
        <obo:OAE_0001849>红皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10037165</obo:OAE_0004334>
        <rdfs:label>erythrodermia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002104 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>Mycotic dermatitis is a dermatitis AE that is a inflammation of skin which induced by mycetes.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>真菌性皮炎</obo:OAE_0001849>
        <rdfs:label>mycotic dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002105 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>Peritendinitis symptom AE is an inflammation AE that has an outcome of inflammation of the synovial lining of a tendon sheath. Causes include trauma, tendon stress, bacterial disease (gonorrhea, tuberculosis), rheumatic disease, and gout. Common sites are the hand, wrist, shoulder capsule, hip capsule, hamstring muscles, and Achilles tendon. The tendon sheaths become inflamed and painful, and accumulate fluid. Joint mobility is usually reduced.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>腱鞘炎样症状</obo:OAE_0001849>
        <rdfs:label>peritendinitis symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002106 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <obo:IAO_0000115>Orthostatic hypotension AE is a hypotension AE that is a form of hypotension in which a person&apos;s blood pressure falls when suddenly standing up or stretching. In medical terms, it is defined as a fall in systolic blood pressure of at least 20 mm Hg or diastolic blood pressure of at least 10 mm Hg when a person assumes a standing position.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>orthostasis AE</obo:IAO_0000118>
        <obo:IAO_0000118>postural hypotension AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Orthostatic_hypotension</obo:IAO_0000119>
        <obo:OAE_0001849>直立性低血压</obo:OAE_0001849>
        <obo:OAE_0004334>10031127</obo:OAE_0004334>
        <rdfs:label>orthostatic hypotension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002107 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>chromatopsia AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://ghr.nlm.nih.gov/condition/color-vision-deficiency</obo:IAO_0000119>
        <obo:OAE_0001849>色视力缺乏</obo:OAE_0001849>
        <rdfs:comment>Color vision deficiency AE is an abnormal vision AE that is a group of conditions that affect the perception of color. They cause a range of changes in color vision, from mild difficulty with distinguishing shades to a total inability to detect color. These conditions are divided into three major categories: red-green color vision defects, blue-yellow color vision defects, and a complete absence of color vision.</rdfs:comment>
        <rdfs:label>color vision deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002108 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>Carcinogenesis AE is a tumor AE that is literally the &apos;creation&apos; of cancer. It is a process by which normal cells are transformed into cancer cells.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>oncogenesis AE</obo:IAO_0000118>
        <obo:IAO_0000118>tumorigenesis AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Carcinogenesis</obo:IAO_0000119>
        <obo:OAE_0001849>致癌</obo:OAE_0001849>
        <rdfs:label>carcinogenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002109 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002109">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0000183"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0002118"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000183"/>
        <obo:IAO_0000115>a circulatory AE that is a serious allergic reaction associated with systemic vasodilation that causes low blood pressure which is by definition 30% lower than the person&apos;s baseline or below standard values.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH, RR</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Anaphylaxis</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://smschile.cl/documentos/cursos2010/MedicalClinicsNorthAmerica/Acute%20Symptoms%20of%20Drug%20Hypersensitivity%20%28Urticaria,%20Angioedema,%20Anaphylaxis,%20Anaphylactic%20Shock%29.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=10092</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性休克</obo:OAE_0001849>
        <obo:OAE_0004334>10002199</obo:OAE_0004334>
        <rdfs:label>anaphylactic shock AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>Pituitary adenomas AE is a tumor AE that is a tumor which occur in the pituitary gland. Pituitary adenomas are generally divided into three categories dependent upon their biological functioning: benign adenoma, invasive adenoma, and carcinomas, with carcinomas accounting for 0.1% to 0.2%, approximately 35% being invasive adenomas and most being benign adenomas. Pituitary adenomas represent from 10% to 25% of all intracranial neoplasms and the estimated prevalence rate in the general population is approximately 17%.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pituitary_adenoma</obo:IAO_0000119>
        <rdfs:label>pituitary adenomas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002111 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <obo:IAO_0000115>Fatty infiltration AE is an embolism AE that shows the abnormal accumulation of fat droplets in the cytoplasm of cells.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://dictionary.reference.com/browse/fatty+infiltration</obo:IAO_0000119>
        <obo:OAE_0001849>脂肪侵润</obo:OAE_0001849>
        <rdfs:label>fatty infiltration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002112 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>Epigastric discomfort is a discomfort AE that shows discomfort in the upper central region of the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>upper Abdominal discomfort AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/epigastric_discomfort.htm</obo:IAO_0000119>
        <obo:OAE_0001849>上腹部不适</obo:OAE_0001849>
        <obo:OAE_0004334>10053155</obo:OAE_0004334>
        <rdfs:label>epigastric discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002113 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <obo:IAO_0000115>Acute intravascular hemolysis AE is a cardiovascular AE that has an outcome of disruption of red blood cells occurs while they are within blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:OAE_0001849>急性血管内溶血</obo:OAE_0001849>
        <rdfs:label>acute intravascular hemolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002114 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000210"/>
        <obo:IAO_0000115>Allergic hepatitis AE is a hepatitis AE that is a tissue-specific inflammatory diease caused by hepersensitivity to a particular drug, accomopanied by a systemic allergic reaction such as eosinophilia.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/viral+hepatitis</obo:IAO_0000119>
        <obo:OAE_0001849>过敏性肝炎</obo:OAE_0001849>
        <obo:OAE_0004334>10071198</obo:OAE_0004334>
        <rdfs:label>allergic hepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002115 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <obo:IAO_0000115>Paranoid anxiety AE is a anxiety AE that is a term used in object relations theory, particularity in discussions about the Paranoid-schizoid and depressive positions. The term was frequently used by Melanie Klein, especially to refer to a pre-depressive and persecutory sense of anxiety characterised by the psychological splitting of objects.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Paranoid_anxiety</obo:IAO_0000119>
        <obo:OAE_0001849>偏执性焦虑</obo:OAE_0001849>
        <rdfs:label>paranoid anxietas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002116 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000480"/>
        <obo:IAO_0000115>Thrombotic thrombocytopenic purpura AE is a thrombocytopenic purpura AE that is a rare disorder of the blood-coagulation system, causing extensive microscopic clots to form in the small blood vessels throughout the body.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>moschcowitz syndrome AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Thrombotic_thrombocytopenic_purpura</obo:IAO_0000119>
        <obo:OAE_0001849>血栓性血小板减少性紫癜</obo:OAE_0001849>
        <obo:OAE_0004334>10043648</obo:OAE_0004334>
        <rdfs:label>thrombotic thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10061</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C78797</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002117 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <obo:IAO_0000115>Glaucoma AE is an eye AE that is a term describing a group of ocular (eye) disorders resulting in optic nerve damage or loss to the field of vision, in many patients caused by a clinically characterized pressure buildup in regards to the fluid of the eye (intraocular pressure-associated optic neuropathy).</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Glaucoma</obo:IAO_0000119>
        <obo:OAE_0001849>青光眼</obo:OAE_0001849>
        <obo:OAE_0004334>10018304</obo:OAE_0004334>
        <rdfs:label>glaucoma AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10392</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C26782</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002118 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>an allergy AE that shows a serious allergic reaction that is rapid in onset and may cause death. It typically causes a number of symptoms including an itchy rash, throat swelling, and low blood pressure. Common causes include insect bites and stings, foods, and medications.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Anaphylaxis</obo:IAO_0000119>
        <obo:OAE_0001849>过敏症</obo:OAE_0001849>
        <obo:OAE_0004334>10002218</obo:OAE_0004334>
        <rdfs:label>anaphylaxis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11254</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C50460</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002119 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <obo:IAO_0000115>an allergy AE which occur during certain times of the year, usually when outdoor molds release their spores, and trees, grasses, and weeds release tiny pollen particles into the air to fertilize other plants.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://kidshealth.org/parent/medical/allergies/seasonal_allergies.html</obo:IAO_0000119>
        <obo:OAE_0001849>季节性变态反应</obo:OAE_0001849>
        <obo:OAE_0004334>10048908</obo:OAE_0004334>
        <rdfs:label>seasonal allergy AE</rdfs:label>
    </owl:Class>
    


