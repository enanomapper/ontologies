    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000765"/>
        <obo:IAO_0000115>a breast infection AE that has severe infection; axillary adenitis; IV antibacterial, antifungal, or antiviral intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 breast infection AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11320</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003613 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <obo:IAO_0000115>a cardiac failure AE that is asymptomatic with laboratory (e.g., BNP [B-Natriuretic Peptide ]) or cardiac imaging abnormalities</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 cardiac failure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10125</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003614 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <obo:IAO_0000115>a cardiac failure AE that has symptoms with mild to moderate activity or exertion</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 cardiac failure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10126</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003615 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <obo:IAO_0000115>a cardiac failure AE that has severe with symptoms at rest or with minimal activity or exertion; intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 cardiac failure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10127</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003616 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <obo:IAO_0000115>a cardiac failure AE that has life-threatening consequences; urgent intervention indicated (e.g., continuous IV therapy or mechanical hemodynamic support)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 cardiac failure AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10128</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003617 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>a cataract AE that is symptomatic; moderate decrease in visual acuity (20/40 or better)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 cataract AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10352</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003618 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>a cataract AE that is symptomatic with marked decrease in visual acuity (worse than 20/40 but better than 20/200); operative intervention indicated (e.g., cataract surgery)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 cataract AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10353</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003619 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000789"/>
        <obo:IAO_0000115>a cataract AE that is characterized by blindness (20/200 or worse) in the affected eye</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 4 cataract AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10354</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003620 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000791"/>
        <obo:IAO_0000115>a catheter related infection AE that is localized; local intervention indicated; oral intervention indicated (e.g., antibiotic, antifungal, antiviral)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 catheter related infection AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11329</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003621 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000791"/>
        <obo:IAO_0000115>a catheter related infection AE where IV antibiotic, antifungal, or antiviral intervention indicated; radiologic or operative intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 catheter related infection AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11330</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003622 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000825"/>
        <obo:IAO_0000115>a colitis AE that has abdominal pain; mucus or blood in stool</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 colitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10523</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003623 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000825"/>
        <obo:IAO_0000115>a colitis AE that has severe abdominal pain; change in bowel habits; medical intervention indicated; peritoneal signs</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 colitis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10524</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003624 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000854"/>
        <obo:IAO_0000115>a cytokine release syndrome AE that has a mild reaction; infusion interruption not indicated; intervention not indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 cytokine release syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11265</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003625 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000854"/>
        <obo:IAO_0000115>a cytokine release syndrome AE where therapy or infusion interruption indicated but responds promptly to symptomatic treatment (e.g., antihistamines, NSAIDS, narcotics, IV fluids); prophylactic medications indicated for less than or equal to 24 hrs</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 cytokine release syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11266</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003626 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000854"/>
        <obo:IAO_0000115>a cytokine release syndrome AEthat is prolonged (e.g., not rapidly responsive to symptomatic medication and/or brief interruption of infusion); recurrence of symptoms following initial improvement; hospitalization indicated for clinical sequelae (e.g., renal impairment, pulmonary infiltrates)</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 cytokine release syndrome AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11267</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003627 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000863"/>
        <obo:IAO_0000115>a dental caries AE that has one or more dental caries, not involving the root</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 1 dental caries AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10569</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003628 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000863"/>
        <obo:IAO_0000115>a dental caries AE that has dental caries involving the root</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 dental caries AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10570</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003629 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000863"/>
        <obo:IAO_0000115>a dental caries AE that has dental caries resulting in pulpitis or periapical abscess or resulting in tooth loss</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 dental caries AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10571</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003630 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000871"/>
        <obo:IAO_0000115>a device related infection AE where IV antibiotic, antifungal, or antiviral intervention indicated; radiologic or operative intervention indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 device related infection AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11357</rdfs:seeAlso>
