    <!-- http://purl.obolibrary.org/obo/OAE_0008955 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which has diffuse involvement in which the entire integument may be thickened and infiltrated with mast cells to produce a peculiar orange color, giving rise to the term &quot;homme orange.&quot;</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mastocytosis#Classification</obo:IAO_0000119>
        <obo:OAE_0001849>弥漫性皮肤肥大细胞增多症</obo:OAE_0001849>
        <obo:OAE_0004334>10012812</obo:OAE_0004334>
        <rdfs:label>diffuse cutaneous mastocytosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008956 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is any medical condition that affects the integumentary system—the organ system that encloses the body and includes skin, hair, nails, and related muscle and glands.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition</obo:IAO_0000119>
        <obo:OAE_0001849>皮肤病</obo:OAE_0001849>
        <obo:OAE_0004334>10048768</obo:OAE_0004334>
        <rdfs:label>dermatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008957 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a teratoma of a cystic nature that contains an array of developmentally mature, solid tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermoid_cyst</obo:IAO_0000119>
        <obo:OAE_0001849>皮样囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10012522</obo:OAE_0004334>
        <rdfs:label>dermoid cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008958 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which refers a neurophysiologic factor in functional disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/4231964/</obo:IAO_0000119>
        <obo:OAE_0001849>皮层运动区活动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10065699</obo:OAE_0004334>
        <rdfs:label>dysponesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008959 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001153"/>
        <obo:IAO_0000115>This is an AE which is the enlargement and hardening of limbs or body parts due to tissue swelling.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Elephantiasis</obo:IAO_0000119>
        <obo:OAE_0001849>象皮病</obo:OAE_0001849>
        <obo:OAE_0004334>10014472</obo:OAE_0004334>
        <rdfs:label>elephantiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008960 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <obo:IAO_0000115>This is an AE which is a iatrogenic cutaneous reaction that occurs immediately after a drug injection.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Livedoid_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>药物性皮肤栓塞</obo:OAE_0001849>
        <obo:OAE_0004334>10058729</obo:OAE_0004334>
        <rdfs:label>embolia cutis medicamentosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008961 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000668"/>
        <obo:IAO_0000115>This is an AE which refers a punctate or linear abrasion produced by mechanical means (often scratching), usually involving only the epidermis, but commonly reaching the papillary dermis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Secondary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>表皮脱落</obo:OAE_0001849>
        <obo:OAE_0004334>10049796</obo:OAE_0004334>
        <rdfs:label>excoriation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008962 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the human skin which affects its color, appearance, or texture and is exfoliative.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>表皮剥脱的皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10064579</obo:OAE_0004334>
        <rdfs:label>exfoliative rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008963 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which is immune-mediated inflammation of the skin, typically characterized by itchiness, redness and a rash.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>免疫介导性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10083156</obo:OAE_0004334>
        <rdfs:label>immune-mediated dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008964 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000668"/>
        <obo:IAO_0000115>This is an AE which refers a  punctate or linear abrasion produced by mechanical means (often scratching), usually involving only the mucosal epidermis, but commonly reaching the papillary dermis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_condition#Secondary_lesions</obo:IAO_0000119>
        <obo:OAE_0001849>粘膜表皮脱落</obo:OAE_0001849>
