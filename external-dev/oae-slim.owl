        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001147"/>
        <obo:IAO_0000115>This is an AE which is a disease of the mesenteric  lymph nodes, in which they are abnormal in size or consistency.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lymphadenopathy</obo:IAO_0000119>
