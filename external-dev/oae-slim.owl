        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: https://www.nlm.nih.gov/medlineplus/eyeinfections.html</obo:IAO_0000119>
        <obo:OAE_0004334>10015929</obo:OAE_0004334>
        <rdfs:label xml:lang="en">eye infection AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11391</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C45372</rdfs:seeAlso>
    </owl:Class>
    


