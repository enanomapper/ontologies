        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <obo:IAO_0000115>This is an AE which is a rare form of bleeding disorder that affects newborns and young infants due to low stores of vitamin K at birth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
