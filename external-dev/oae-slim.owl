    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006596 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000195"/>
        <obo:IAO_0000115>This is an AE which is the most dreadful evolution associated to a poor prognosis: mortality is approximately 15% and up to 30-39% in case of infected necrosis, which is the major cause of death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26708848/</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性胰腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10033654</obo:OAE_0004334>
        <rdfs:label>pancreatitis necrotising AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006597 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000195"/>
        <obo:IAO_0000115>This is an AE which is a condition caused by viral characterized by inflammation of the pancreas.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pancreatitis</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性胰腺炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065192</obo:OAE_0004334>
        <rdfs:label>pancreatitis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006599 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0006599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <obo:IAO_0000115>This is an AE which is a type of damage to or disease of the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Liver_disease</obo:IAO_0000119>
        <obo:OAE_0001849>肝脏疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10024670</obo:OAE_0004334>
        <rdfs:label>liver disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0006600 -->


