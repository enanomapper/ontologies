    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005094 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002466"/>
        <obo:IAO_0000115>This is an AE which is any of three medical signs, all of which may occur in meningitis or meningism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Brudzi%C5%84ski%27s_sign</obo:IAO_0000119>
