    <!-- http://purl.obolibrary.org/obo/OAE_0002355 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002354"/>
