    <!-- http://purl.obolibrary.org/obo/OAE_0007659 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a pain of responsible for adduction of the jaw, and one (the lateral pterygoid) helps to abduct it.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Muscles_of_mastication</obo:IAO_0000119>
        <obo:OAE_0001849>肌痛</obo:OAE_0001849>
        <obo:OAE_0004334>10077030</obo:OAE_0004334>
        <rdfs:label>masticatory pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007660 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000333"/>
        <obo:IAO_0000115>This is an AE which is a pathology affecting the vocal folds (commonly referred to as the vocal cords) characterized by full or partial vocal fold closure causing difficulty and distress during respiration, especially during inhalation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vocal_cord_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>声带收肌无力</obo:OAE_0001849>
        <obo:OAE_0004334>10001136</obo:OAE_0004334>
        <rdfs:label>adductor vocal cord weakness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007661 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000405"/>
        <obo:IAO_0000115>This is an AE which is a rare autoimmune disorder characterized by muscle weakness of the limbs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lambert%E2%80%93Eaton_myasthenic_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肌无力综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10028424</obo:OAE_0004334>
        <rdfs:label>myasthenic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007662 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is organs of the vertebrate muscular system that are mostly attached by tendons to bones of the skeleton.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skeletal_muscle</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10056720</obo:OAE_0004334>
        <rdfs:label>muscle mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007663 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>骨萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10068975</obo:OAE_0004334>
        <rdfs:label>bone atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007664 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is an abnormal growth of tissue in bone, traditionally classified as noncancerous (benign) or cancerous (malignant).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>骨癌</obo:OAE_0001849>
        <obo:OAE_0004334>10005949</obo:OAE_0004334>
        <rdfs:label>bone cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007665 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000019"/>
        <obo:IAO_0000115>This is an AE which is characterized by a diffuse or localized pattern of low signal intensity on T1-weighted images without a defined fracture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/7803074/</obo:IAO_0000119>
        <obo:OAE_0001849>骨挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10066251</obo:OAE_0004334>
        <rdfs:label>bone contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007666 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is the softening of bones due to the removal of calcium ions, and can be performed as a histological technique to study bones and extract DNA.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_decalcification</obo:IAO_0000119>
        <obo:OAE_0001849>骨脱钙</obo:OAE_0001849>
        <obo:OAE_0004334>10070817</obo:OAE_0004334>
        <rdfs:label>bone decalcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007667 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is rare diseases and about 1 in 5,000 babies are born with some type of skeletal dysplasia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteochondrodysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>骨骼畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10070918</obo:OAE_0004334>
        <rdfs:label>bone deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007668 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which refers to the medical conditions which affect the bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_disease</obo:IAO_0000119>
        <obo:OAE_0001849>骨疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10005956</obo:OAE_0004334>
        <rdfs:label>bone disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007669 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is the loss of bone from disease processes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_erosion</obo:IAO_0000119>
        <obo:OAE_0001849>骨侵蚀</obo:OAE_0001849>
        <obo:OAE_0004334>10051728</obo:OAE_0004334>
        <rdfs:label>bone erosion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007670 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is sorted by size and the proportional weights of each size category were compared to isolate any differences in fragmentation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23756520/</obo:IAO_0000119>
        <obo:OAE_0001849>骨头碎片</obo:OAE_0001849>
        <obo:OAE_0004334>10064211</obo:OAE_0004334>
        <rdfs:label>bone fragmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007671 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is the darkening of an area of skin or nails or bone caused by increased melanin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperpigmentation</obo:IAO_0000119>
        <obo:OAE_0001849>骨色素沉着过度</obo:OAE_0001849>
        <obo:OAE_0004334>10070598</obo:OAE_0004334>
        <rdfs:label>bone hyperpigmentation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007672 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is the loss of skeletal muscle mass.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Muscle_atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10028289</obo:OAE_0004334>
        <rdfs:label>muscle atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007673 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007673">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000019"/>
        <obo:IAO_0000115>This is an AE which is second only to strain as the leading cause of morbidity from sports-related injuries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11476532/</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉挫伤</obo:OAE_0001849>
        <obo:OAE_0004334>10070757</obo:OAE_0004334>
        <rdfs:label>muscle contusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007674 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is injuries or pain in the human musculoskeletal system, including the joints, ligaments, muscles, nerves, tendons, and structures that support limbs, neck and back.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Musculoskeletal_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10028300</obo:OAE_0004334>
        <rdfs:label>muscle disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007675 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000617"/>
        <obo:IAO_0000115>This is an AE which is a condition in which the muscle of the body is deprived of adequate oxygen supply at the tissue level.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypoxia_(medical)</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉缺氧</obo:OAE_0001849>
        <obo:OAE_0004334>10078053</obo:OAE_0004334>
        <rdfs:label>muscle hypoxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007676 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a form of muscle cell injury which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10028320</obo:OAE_0004334>
        <rdfs:label>muscle necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007677 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of muscle tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061692</obo:OAE_0004334>
        <rdfs:label>muscle neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007678 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the muscle tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10071759</obo:OAE_0004334>
        <rdfs:label>muscle edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007679 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of the muscle not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10064470</obo:OAE_0004334>
        <rdfs:label>muscle swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007680 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a highly aggressive form of cancer that develops from mesenchymal cells that have failed to fully differentiate into myocytes of skeletal muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rhabdomyosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>横纹肌肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10039022</obo:OAE_0004334>
        <rdfs:label>rhabdomyosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007681 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is a type of muscle loss (muscle atrophy) that occurs with aging and/or immobility.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sarcopenia</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉减少症</obo:OAE_0001849>
        <obo:OAE_0004334>10063024</obo:OAE_0004334>
        <rdfs:label>sarcopenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007682 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is benign tumors that are composed of fibrous or connective tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibroma</obo:IAO_0000119>
        <obo:OAE_0001849>纤维瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10016629</obo:OAE_0004334>
        <rdfs:label>fibroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007683 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is a non-atherosclerotic, non-inflammatory disease of the blood vessels that causes abnormal growth within the wall of an artery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibromuscular_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>纤维肌性的发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10054794</obo:OAE_0004334>
        <rdfs:label>fibromuscular dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007684 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001953"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by chronic widespread pain and a heightened pain response to pressure.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibromyalgia</obo:IAO_0000119>
        <obo:OAE_0001849>纤维肌痛症</obo:OAE_0001849>
        <obo:OAE_0004334>10048439</obo:OAE_0004334>
        <rdfs:label>fibromyalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007685 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007685">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <obo:IAO_0000115>This is an AE which is a malignant mesenchymal tumour derived from fibrous connective tissue and characterized by the presence of immature proliferating fibroblasts or undifferentiated anaplastic spindle cells in a storiform pattern.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>纤维肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10016632</obo:OAE_0004334>
        <rdfs:label>fibrosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007686 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing in which connective tissue replaces normal parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>纤维化</obo:OAE_0001849>
        <obo:OAE_0004334>10016642</obo:OAE_0004334>
        <rdfs:label>fibrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007687 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004237"/>
        <obo:IAO_0000115>This is an AE which is a pathological wound healing in which connective tissue replaces normal tendinous parenchymal tissue to the extent that it goes unchecked, leading to considerable tissue remodelling and the formation of permanent scar tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fibrosis</obo:IAO_0000119>
        <obo:OAE_0001849>纤维化腱</obo:OAE_0001849>
        <obo:OAE_0004334>10016662</obo:OAE_0004334>
        <rdfs:label>fibrosis tendinous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007688 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a benign, non-neoplastic proliferative process that is relatively common in the long bones of skeletally immature adolescents.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20692185/</obo:IAO_0000119>
        <obo:OAE_0001849>纤维皮质缺损</obo:OAE_0001849>
        <obo:OAE_0004334>10052753</obo:OAE_0004334>
        <rdfs:label>fibrous cortical defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007689 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001400"/>
        <obo:IAO_0000115>This is an AE which is a benign skin growth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dermatofibroma</obo:IAO_0000119>
        <obo:OAE_0001849>纤维组织细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10053717</obo:OAE_0004334>
        <rdfs:label>fibrous histiocytoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007690 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007690">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a fracture of the lower legs bones meaning either or both of the tibia and fibula.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Crus_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>腓骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10016667</obo:OAE_0004334>
        <rdfs:label>fibula fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007691 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004223"/>
        <obo:IAO_0000115>This is an AE which is an inability or impairment of an individual to perform tasks that require a degree of manual dexterity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/33085413/</obo:IAO_0000119>
        <obo:OAE_0001849>精细动作延迟</obo:OAE_0001849>
        <obo:OAE_0004334>10066088</obo:OAE_0004334>
        <rdfs:label>fine motor delay AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007692 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007692">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004223"/>
        <obo:IAO_0000115>This is an AE which is a function that involves specific movements of the bodies muscles to perform a certain task but it has dysfunction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Motor_skill</obo:IAO_0000119>
        <obo:OAE_0001849>精细运动技能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10076288</obo:OAE_0004334>
        <rdfs:label>fine motor skill dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007693 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002413"/>
        <obo:IAO_0000115>This is an AE which is a permanent shortening of a extremity  muscle or joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Contracture</obo:IAO_0000119>
        <obo:OAE_0001849>肢体挛缩</obo:OAE_0001849>
        <obo:OAE_0004334>10050732</obo:OAE_0004334>
        <rdfs:label>extremity contracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007694 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a form of extremity cell injury which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肢体坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10059385</obo:OAE_0004334>
        <rdfs:label>extremity necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007696 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007696">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which damage to the anterior interosseous nerve (AIN), a distal motor and sensory branch of the median nerve, classically with severe weakness of the pincer movement of the thumb and index finger, and can cause transient pain in the wrist (the terminal, sensory branch of the AIN innervates the bones of the carpal tunnel).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Anterior_interosseous_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>前骨间的综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10065536</obo:OAE_0004334>
        <rdfs:label>anterior interosseous syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007697 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a bone fracture which occurs when a fragment of bone tears away from the main mass of bone as a result of physical trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Avulsion_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>撕裂骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10066184</obo:OAE_0004334>
        <rdfs:label>avulsion fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007698 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007698">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a resilient and smooth elastic tissue and its development is disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cartilage</obo:IAO_0000119>
        <obo:OAE_0001849>软骨发育障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061745</obo:OAE_0004334>
        <rdfs:label>cartilage development disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007699 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which exists when the capacity of the pelvis is inadequate to allow the fetus to negotiate the birth canal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cephalopelvic_disproportion</obo:IAO_0000119>
        <obo:OAE_0001849>头骨盆不成比例</obo:OAE_0001849>
        <obo:OAE_0004334>10008020</obo:OAE_0004334>
        <rdfs:label>cephalo-pelvic disproportion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007700 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007700">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a fracture of any of the seven cervical vertebrae in the neck.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cervical_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>颈椎骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10049946</obo:OAE_0004334>
        <rdfs:label>cervical vertebral fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007701 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is inflammation of cartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chondritis</obo:IAO_0000119>
        <obo:OAE_0001849>软骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008685</obo:OAE_0004334>
        <rdfs:label>chondritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007702 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007702">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is calcification (accumulation of calcium salts) in hyaline cartilage and/or fibrocartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chondrocalcinosis</obo:IAO_0000119>
        <obo:OAE_0001849>软骨钙化沉着病</obo:OAE_0001849>
        <obo:OAE_0004334>10061761</obo:OAE_0004334>
        <rdfs:label>chondrocalcinosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007703 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which refers to a skeletal disorder caused by one of myriad genetic mutations that can affect the development of cartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chondrodystrophy</obo:IAO_0000119>
        <obo:OAE_0001849>软骨营养不良</obo:OAE_0001849>
        <obo:OAE_0004334>10008723</obo:OAE_0004334>
        <rdfs:label>chondrodystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007704 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a bone sarcoma, a primary cancer composed of cells derived from transformed cells that produce cartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chondrosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>软骨肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10008734</obo:OAE_0004334>
        <rdfs:label>chondrosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007705 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a bone fracture of the clavicle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Clavicle_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>锁骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10009245</obo:OAE_0004334>
        <rdfs:label>clavicle fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007706 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000533"/>
        <obo:IAO_0000115>This is an AE which is a medical term meaning pain in the coccyx or tailbone area, often brought on by a fall onto the coccyx or by persistent irritation usually from sitting.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coccydynia</obo:IAO_0000119>
        <obo:OAE_0001849>尾骨痛</obo:OAE_0001849>
        <obo:OAE_0004334>10009829</obo:OAE_0004334>
        <rdfs:label>coccydynia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007707 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which refers a fracture in which the bone has broken into several pieces.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_fracture#Fragments</obo:IAO_0000119>
        <obo:OAE_0001849>粉碎性骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10052614</obo:OAE_0004334>
        <rdfs:label>comminuted fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007708 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a collapse of a vertebra. It may be due to trauma or due to a weakening of the vertebra (compare with burst fracture).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vertebral_compression_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>压缩性骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10010214</obo:OAE_0004334>
        <rdfs:label>compression fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007709 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a benign inflammatory condition affecting the upper costochondral junctions and costosternal joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Costochondritis</obo:IAO_0000119>
        <obo:OAE_0001849>肋软骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10011219</obo:OAE_0004334>
        <rdfs:label>costochondritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007710 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which refers the bone remodeling is the process of laying down new bone material by cells named osteoblasts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ossification</obo:IAO_0000119>
        <obo:OAE_0001849>骨骼外骨形成</obo:OAE_0001849>
        <obo:OAE_0004334>10049811</obo:OAE_0004334>
        <rdfs:label>extraskeletal ossification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007711 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which represents a relatively uncommon injury in the non-elderly population often resulting from high-energy trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31203740/</obo:IAO_0000119>
        <obo:OAE_0001849>股骨颈骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10016450</obo:OAE_0004334>
        <rdfs:label>femoral neck fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007712 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a bone fracture that involves the femur.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Femoral_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>股骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10016454</obo:OAE_0004334>
        <rdfs:label>femur fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007713 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the foot that can be congenital or acquired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Foot_deformity</obo:IAO_0000119>
        <obo:OAE_0001849>脚骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10061159</obo:OAE_0004334>
        <rdfs:label>foot deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007714 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which includes lisfranc fracture,Jones fracture , march fracture , calcaneal fracture,  broken toe and  cuneiform fracture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Foot#fracture</obo:IAO_0000119>
        <obo:OAE_0001849>脚骨伤</obo:OAE_0001849>
        <obo:OAE_0004334>10016970</obo:OAE_0004334>
        <rdfs:label>foot fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007715 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <obo:IAO_0000115>This is an AE which is one of the serious neurological complications in ACH.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27767902/</obo:IAO_0000119>
        <obo:OAE_0001849>枕骨大孔狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10064157</obo:OAE_0004334>
        <rdfs:label>foramen magnum stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007716 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is the region of the upper limb between the elbow and the wrist which is fracture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Forearm#Fracture</obo:IAO_0000119>
        <obo:OAE_0001849>前臂骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10016997</obo:OAE_0004334>
        <rdfs:label>forearm fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007717 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is when a fractured bone does not heal properly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Malunion</obo:IAO_0000119>
        <obo:OAE_0001849>骨折畸形愈合</obo:OAE_0001849>
        <obo:OAE_0004334>10017085</obo:OAE_0004334>
        <rdfs:label>fracture malunion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007718 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is broadly classified as surgical or conservative, the latter basically referring to any non-surgical procedure, such as pain management, immobilization or other non-surgical stabilization.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_fracture#Treatment</obo:IAO_0000119>
        <obo:OAE_0001849>骨折的治疗</obo:OAE_0001849>
        <obo:OAE_0004334>10061959</obo:OAE_0004334>
        <rdfs:label>fracture treatment AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007719 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a fracture of the coccyx.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Coccyx_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>尾骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10049164</obo:OAE_0004334>
        <rdfs:label>fractured coccyx AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007720 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a scaphoid fracture—a fracture of the scaphoid bone, one of the carpal bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hand#fracture</obo:IAO_0000119>
        <obo:OAE_0001849>手骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10019114</obo:OAE_0004334>
        <rdfs:label>hand fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007721 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a break of the humerus bone in the upper arm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Humerus_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>肱骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10020462</obo:OAE_0004334>
        <rdfs:label>humerus fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007722 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a medical condition combining clubbing and periostitis of the small hand joints, especially the distal interphalangeal joints and the metacarpophalangeal joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypertrophic_osteoarthropathy</obo:IAO_0000119>
        <obo:OAE_0001849>肥厚性骨关节病</obo:OAE_0001849>
        <obo:OAE_0004334>10020877</obo:OAE_0004334>
        <rdfs:label>hypertrophic osteoarthropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007723 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is the second most common knee injury caused by inflammation located on the lateral aspect of the knee due to friction between the iliotibial band and the lateral epicondyle of the femur.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Iliotibial_band_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>髂胫骨带综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10060813</obo:OAE_0004334>
        <rdfs:label>iliotibial band syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007724 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007724">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is the separation of ilium into two or more pieces under the action of stress.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fracture</obo:IAO_0000119>
        <obo:OAE_0001849>髂骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10021343</obo:OAE_0004334>
        <rdfs:label>ilium fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007725 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is the separation of limb into two or more pieces under the action of stress.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fracture</obo:IAO_0000119>
        <obo:OAE_0001849>四肢骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10074551</obo:OAE_0004334>
        <rdfs:label>limb fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007726 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is the separation of lower limb into two or more pieces under the action of stress.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fracture</obo:IAO_0000119>
        <obo:OAE_0001849>下肢骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10061599</obo:OAE_0004334>
        <rdfs:label>lower limb fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007727 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which can directly produce massive RPH leading to hemorrhagic death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29368084/</obo:IAO_0000119>
        <obo:OAE_0001849>腰骨伤</obo:OAE_0001849>
        <obo:OAE_0004334>10049947</obo:OAE_0004334>
        <rdfs:label>lumbar vertebral fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007728 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is pain along the inside edge of the shinbone (tibia) due to inflammation of tissue in the area.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Shin_splints</obo:IAO_0000119>
        <obo:OAE_0001849>内侧胫骨应力综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10065303</obo:OAE_0004334>
        <rdfs:label>medial tibial stress syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007729 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is any painful foot condition affecting the metatarsal region of the foot.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metatarsalgia</obo:IAO_0000119>
        <obo:OAE_0001849>跖骨痛</obo:OAE_0001849>
        <obo:OAE_0004334>10027487</obo:OAE_0004334>
        <rdfs:label>metatarsalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007730 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a rare genetic disorder (dominant form: 1 in 10,000 births) that affects the growing ends of bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multiple_epiphyseal_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>多发性骨骺发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10028197</obo:OAE_0004334>
        <rdfs:label>multiple epiphyseal dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007731 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is of high clinical relevance, as a significant increase in mortality rate has been described.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30747275/</obo:IAO_0000119>
        <obo:OAE_0001849>多发性骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10028200</obo:OAE_0004334>
        <rdfs:label>multiple fractures AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007732 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000613"/>
        <obo:IAO_0000115>This is an AE which comprises two syndromes characterized by heterotopic ossification (calcification) of muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myositis_ossificans</obo:IAO_0000119>
        <obo:OAE_0001849>骨化性肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048618</obo:OAE_0004334>
        <rdfs:label>myositis ossificans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007733 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007733">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002525"/>
        <obo:IAO_0000115>This is an AE which is a noninflammatory condition of an uncertain etiology, characterized by sclerotic bone lesions located mainly in the iliac region of the sacroiliac joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32328707/</obo:IAO_0000119>
        <obo:OAE_0001849>致密性骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10031150</obo:OAE_0004334>
        <rdfs:label>osteitis condensans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007734 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a painful type of osteochondrosis where the cartilage or bone in a joint is inflamed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteochondritis</obo:IAO_0000119>
        <obo:OAE_0001849>骨软骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10031230</obo:OAE_0004334>
        <rdfs:label>osteochondritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007735 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007735">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is the most common benign tumors of the bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteochondroma</obo:IAO_0000119>
        <obo:OAE_0001849>骨软骨瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10059587</obo:OAE_0004334>
        <rdfs:label>osteochondroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007736 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a family of orthopedic diseases of the joint that occur in children, adolescents and rapidly growing animals, particularly pigs, horses, dogs, and broiler chickens.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteochondrosis</obo:IAO_0000119>
        <obo:OAE_0001849>骨软骨病</obo:OAE_0001849>
        <obo:OAE_0004334>10031233</obo:OAE_0004334>
        <rdfs:label>osteochondrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007737 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <obo:IAO_0000115>This is an AE which is a group of genetic disorders that all result in bone that breaks easily.[9][1]: 85  The range of symptoms—on the skeleton as well as on the body&apos;s other organs—may be mild to severe.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteogenesis_imperfecta</obo:IAO_0000119>
        <obo:OAE_0001849>成骨不全症</obo:OAE_0001849>
        <obo:OAE_0004334>10031243</obo:OAE_0004334>
        <rdfs:label>osteogenesis imperfecta AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007738 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a new piece of bone usually growing on another piece of bone, typically the skull.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteoma</obo:IAO_0000119>
        <obo:OAE_0001849>骨瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10031249</obo:OAE_0004334>
        <rdfs:label>osteoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007739 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a disease characterized by the softening of the bones caused by impaired bone metabolism primarily due to inadequate levels of available phosphate, calcium, and vitamin D, or because of resorption of calcium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteomalacia</obo:IAO_0000119>
        <obo:OAE_0001849>骨软化</obo:OAE_0001849>
        <obo:OAE_0004334>10031250</obo:OAE_0004334>
        <rdfs:label>osteomalacia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007740 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is an extremely rare inherited disorder whereby the bones harden, becoming denser, in contrast to more prevalent conditions like osteoporosis, in which the bones become less dense and more brittle, or osteomalacia, in which the bones soften. Osteopetrosis can cause bones to dissolve and break.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteopetrosis</obo:IAO_0000119>
        <obo:OAE_0001849>骨硬化病</obo:OAE_0001849>
        <obo:OAE_0004334>10031280</obo:OAE_0004334>
        <rdfs:label>osteopetrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007741 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a bone fracture caused by weakness of the bone structure that leads to decrease mechanical resistance to normal mechanical loads.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pathologic_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>骨质疏松性骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10031290</obo:OAE_0004334>
        <rdfs:label>osteoporotic fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007742 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a cancerous tumor in a bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>骨肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10031291</obo:OAE_0004334>
        <rdfs:label>osteosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007743 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a break of the kneecap.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Patella_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>髌骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10034122</obo:OAE_0004334>
        <rdfs:label>patella fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007744 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a bone fracture caused by weakness of the bone structure that leads to decrease mechanical resistance to normal mechanical loads.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pathologic_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>病理性骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10034156</obo:OAE_0004334>
        <rdfs:label>pathological fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007745 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002352"/>
        <obo:IAO_0000115>This is an AE which is fibrous bands that form between joint tissues and organs, often as a result of injury during surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Adhesion_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>关节粘连</obo:OAE_0001849>
        <obo:OAE_0004334>10058031</obo:OAE_0004334>
        <rdfs:label>joint adhesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007746 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a stiffness of a joint due to abnormal adhesion and rigidity of the bones of the joint, which may be the result of injury or disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ankylosis</obo:IAO_0000119>
        <obo:OAE_0001849>关节僵硬</obo:OAE_0001849>
        <obo:OAE_0004334>10023198</obo:OAE_0004334>
        <rdfs:label>joint ankylosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007747 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a permanent shortening of a muscle or joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Contracture</obo:IAO_0000119>
        <obo:OAE_0001849>关节挛缩</obo:OAE_0001849>
        <obo:OAE_0004334>10023201</obo:OAE_0004334>
        <rdfs:label>joint contracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007748 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002484"/>
        <obo:IAO_0000115>This is an AE which refers a crunching sensation felt in certain medical problems on joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Crepitation</obo:IAO_0000119>
        <obo:OAE_0001849>关节爆裂声</obo:OAE_0001849>
        <obo:OAE_0004334>10051374</obo:OAE_0004334>
        <rdfs:label>joint crepitation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007749 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which refers to damage to joint (physical vandalism) beyond the capability to repair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Destruction</obo:IAO_0000119>
        <obo:OAE_0001849>关节破坏</obo:OAE_0001849>
        <obo:OAE_0004334>10023203</obo:OAE_0004334>
        <rdfs:label>joint destruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007750 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002513"/>
        <obo:IAO_0000115>This is an AE which occurs when there is an abnormal separation in the joint, where two or more bones meet.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Joint_dislocation?wprov=srpw1_0</obo:IAO_0000119>
        <obo:OAE_0001849>减少关节脱位</obo:OAE_0001849>
        <obo:OAE_0004334>10052988</obo:OAE_0004334>
        <rdfs:label>joint dislocation reduction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007751 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a deformity in the knee joint, so that the knee bends backwards.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Genu_recurvatum</obo:IAO_0000119>
        <obo:OAE_0001849>关节过伸</obo:OAE_0001849>
        <obo:OAE_0004334>10062310</obo:OAE_0004334>
        <rdfs:label>joint hyperextension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007752 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which refers to the resistance offered by various musculoskeletal tissues that surround a skeletal joint which is  instability.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Joint_stability</obo:IAO_0000119>
        <obo:OAE_0001849>关节不稳定</obo:OAE_0001849>
        <obo:OAE_0004334>10064931</obo:OAE_0004334>
        <rdfs:label>joint instability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007754 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which has been implicated in ankle sprains, anterior cruciate ligament injury, shoulder instability, and osteoarthritis of the hand.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21807914/</obo:IAO_0000119>
        <obo:OAE_0001849>关节松弛</obo:OAE_0001849>
        <obo:OAE_0004334>10070874</obo:OAE_0004334>
        <rdfs:label>joint laxity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007755 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is a common symptom that often leads to outpatient clinic visits.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29564040/</obo:IAO_0000119>
        <obo:OAE_0001849>关节噪声</obo:OAE_0001849>
        <obo:OAE_0004334>10074329</obo:OAE_0004334>
        <rdfs:label>joint noise AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007756 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which is considered an important physical sign of joint dysfunction and/or joint pathology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/19697644/</obo:IAO_0000119>
        <obo:OAE_0001849>关节振动</obo:OAE_0001849>
        <obo:OAE_0004334>10074327</obo:OAE_0004334>
        <rdfs:label>joint vibration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007757 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <obo:IAO_0000115>This is an AE which refers a  somewhat high temperature on joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Warm</obo:IAO_0000119>
        <obo:OAE_0001849>关节发热</obo:OAE_0001849>
        <obo:OAE_0004334>10054106</obo:OAE_0004334>
        <rdfs:label>joint warmth AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007758 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is any form of chronic arthritis or chronic arthritis-related conditions which affects individuals under the age of 16.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Childhood_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>少年关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10059177</obo:OAE_0004334>
        <rdfs:label>juvenile arthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007759 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is the most common, chronic rheumatic disease of childhood, affecting approximately one per 1,000 children.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Juvenile_idiopathic_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>青少年特发性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10059176</obo:OAE_0004334>
        <rdfs:label>juvenile idiopathic arthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007760 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a fairly common form of generalized epilepsy of presumed genetic origin (previously known an idiopathic generalized epilepsy), representing 5-10% of all epilepsy cases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Juvenile_myoclonic_epilepsy</obo:IAO_0000119>
        <obo:OAE_0001849>青少年肌阵挛性癫痫</obo:OAE_0001849>
        <obo:OAE_0004334>10071082</obo:OAE_0004334>
        <rdfs:label>juvenile myoclonic epilepsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007761 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is thought to be important regulators of disc cell metabolism.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17978649/</obo:IAO_0000119>
        <obo:OAE_0001849>椎间盘压迫</obo:OAE_0001849>
        <obo:OAE_0004334>10055039</obo:OAE_0004334>
        <rdfs:label>intervertebral disc compression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007762 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which refers anything arising from the intervertebral disc may be termed discogenic in particular when referring to associated pain as discogenic pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Intervertebral_disc#Clinical_significance</obo:IAO_0000119>
        <obo:OAE_0001849>椎间盘疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061521</obo:OAE_0004334>
        <rdfs:label>intervertebral disc disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007763 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is an injury to the cushioning and connective tissue between vertebrae, usually caused by excessive strain or trauma to the spine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_disc_herniation</obo:IAO_0000119>
        <obo:OAE_0001849>椎间盘移位</obo:OAE_0001849>
        <obo:OAE_0004334>10022636</obo:OAE_0004334>
        <rdfs:label>intervertebral disc displacement AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007764 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which associated strongly with the enhancement (Pearson&apos;s correlation coefficient 0.46, P &lt; 0.001).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18949498/</obo:IAO_0000119>
        <obo:OAE_0001849>椎间盘间隙变窄</obo:OAE_0001849>
        <obo:OAE_0004334>10055041</obo:OAE_0004334>
        <rdfs:label>intervertebral disc space narrowing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007765 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a rare disorder which is easily missed and  presents with non-specific symptoms such as irritability, abdominal pain, decreased appetite and limping.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27649709/</obo:IAO_0000119>
        <obo:OAE_0001849>椎间关节盘炎</obo:OAE_0001849>
        <obo:OAE_0004334>10060738</obo:OAE_0004334>
        <rdfs:label>intervertebral discitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007766 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002601"/>
        <obo:IAO_0000115>This is an AE which is a very rare neurologic disorder classically characterised by pronounced startle responses to tactile or acoustic stimuli and hypertonia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperekplexia</obo:IAO_0000119>
        <obo:OAE_0001849>肌张力过度</obo:OAE_0001849>
        <obo:OAE_0004334>10058271</obo:OAE_0004334>
        <rdfs:label>hyperexplexia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007767 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare, sometimes fatal neurological condition linked to the ingestion of the dietary supplement L-tryptophan.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilia%E2%80%93myalgia_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸细胞增多性肌痛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10014952</obo:OAE_0004334>
        <rdfs:label>eosinophilia myalgia syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007768 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002142"/>
        <obo:IAO_0000115>This is an AE which refers to a group of functional disorders leading to abdominal pain due to dysfunction of the Sphincter of Oddi: functional biliary sphincter of Oddi and functional pancreatic sphincter of Oddi disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sphincter_of_Oddi_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>奥迪括约肌功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10066424</obo:OAE_0004334>
        <rdfs:label>sphincter of oddi dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007769 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000613"/>
        <obo:IAO_0000115>This is an AE which is the most common inflammatory muscle disease in older adults.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inclusion_body_myositis</obo:IAO_0000119>
        <obo:OAE_0001849>包涵体肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10066407</obo:OAE_0004334>
        <rdfs:label>inclusion body myositis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007770 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000613"/>
        <obo:IAO_0000115>This is an AE which is a complication after a viral infection mainly caused by Influenza A and B viruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31560498/</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10051512</obo:OAE_0004334>
        <rdfs:label>viral myositis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007771 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a relatively common infectious condition characterized by bullae or vesicles on the tympanic membrane (TM), without affecting the contents of the external or middle ear.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31971705/</obo:IAO_0000119>
        <obo:OAE_0001849>大疱性肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10028659</obo:OAE_0004334>
        <rdfs:label>myringitis bullous AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007772 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000525"/>
        <obo:IAO_0000115>This is an AE which is myopathies that result from defects in biochemical metabolism that primarily affect muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Metabolic_myopathy</obo:IAO_0000119>
        <obo:OAE_0001849>代谢性肌病</obo:OAE_0001849>
        <obo:OAE_0004334>10068836</obo:OAE_0004334>
        <rdfs:label>metabolic myopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007773 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000333"/>
        <obo:IAO_0000115>This is an AE which symptoms usually appear about two years after adolescent growth spurt and is significantly more common in males (average age of onset, 15- to 25-year-old).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Monomelic_amyotrophy</obo:IAO_0000119>
        <obo:OAE_0001849>单肢肌萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10069681</obo:OAE_0004334>
        <rdfs:label>monomelic amyotrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007774 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000613"/>
        <obo:IAO_0000115>This is an AE which is a type of chronic inflammation of the muscles (inflammatory myopathy) related to dermatomyositis and inclusion body myositis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polymyositis</obo:IAO_0000119>
        <obo:OAE_0001849>多肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10036102</obo:OAE_0004334>
        <rdfs:label>polymyositis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007775 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000785"/>
        <obo:IAO_0000115>This is an AE which is a form of dilated cardiomyopathy that is defined as a deterioration in cardiac function presenting typically between the last month of pregnancy and up to six months postpartum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peripartum_cardiomyopathy</obo:IAO_0000119>
        <obo:OAE_0001849>分娩前后心肌病</obo:OAE_0001849>
        <obo:OAE_0004334>10049430</obo:OAE_0004334>
        <rdfs:label>peripartum cardiomyopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007776 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000286"/>
        <obo:IAO_0000115>This is an AE which is a birth defect where diaphragmatic  tissue is wholly or largely absent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aplasia</obo:IAO_0000119>
        <obo:OAE_0001849>膈肌发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10012711</obo:OAE_0004334>
        <rdfs:label>diaphragmatic aplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007777 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <obo:IAO_0000115>This is an AE which is a disorder of a sheet of internal skeletal muscle in humans and other mammals that extends across the bottom of the thoracic cavity .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thoracic_diaphragm</obo:IAO_0000119>
        <obo:OAE_0001849>膈肌疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061106</obo:OAE_0004334>
        <rdfs:label>diaphragmatic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007778 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is an intense itching sensation of the arm usually between the wrist and elbow of either or both arms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Brachioradial_pruritus</obo:IAO_0000119>
        <obo:OAE_0001849>肱桡肌瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10071443</obo:OAE_0004334>
        <rdfs:label>brachioradial pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007779 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001107"/>
        <obo:IAO_0000115>This is an AE which could result from external carotid artery (ECA) occlusive disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21397442/</obo:IAO_0000119>
        <obo:OAE_0001849>颌肌跛行</obo:OAE_0001849>
        <obo:OAE_0004334>10009243</obo:OAE_0004334>
        <rdfs:label>claudication of jaw muscles AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007780 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a benign tumor of striated muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rhabdomyoma</obo:IAO_0000119>
        <obo:OAE_0001849>横纹肌瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10039021</obo:OAE_0004334>
        <rdfs:label>rhabdomyoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007781 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <obo:IAO_0000115>This is an AE which is a bacterial infection of the skeletal muscles which results in an abscess.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pyomyositis</obo:IAO_0000119>
        <obo:OAE_0001849>化脓性肌炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037652</obo:OAE_0004334>
        <rdfs:label>pyomyositis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007782 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000525"/>
        <obo:IAO_0000115>This is an AE which is a disease of the muscle  in which the muscle fibers do not function properly.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myopathy</obo:IAO_0000119>
        <obo:OAE_0001849>肌病</obo:OAE_0001849>
        <obo:OAE_0004334>10028641</obo:OAE_0004334>
        <rdfs:label>myopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007783 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <obo:IAO_0000115>This is an AE which is a tough, high-tensile-strength band of dense fibrous connective tissue that connects muscle to bone and feel it discomfortable.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tendon</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱不适</obo:OAE_0001849>
        <obo:OAE_0004334>10074599</obo:OAE_0004334>
        <rdfs:label>tendon discomfort AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007784 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is a painful shoulder disorder characterised by either single or multiple deposits in the rotator cuff tendon.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26163832/</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10057888</obo:OAE_0004334>
        <rdfs:label>tendon calcification AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007785 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is a form of tendon  cell injury which results in the premature death of cells in living tissue by autolysis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Necrosis</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱坏死</obo:OAE_0001849>
        <obo:OAE_0004334>10069650</obo:OAE_0004334>
        <rdfs:label>tendon necrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007786 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is a permanent shortening of a tendinous muscle or joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Contracture</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱挛缩</obo:OAE_0001849>
        <obo:OAE_0004334>10043233</obo:OAE_0004334>
        <rdfs:label>tendinous contracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007787 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <obo:IAO_0000115>This is an AE which is a tough, high-tensile-strength band of dense fibrous connective tissue that connects muscle to bone and feel it pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tendon</obo:IAO_0000119>
        <obo:OAE_0001849>肌腱痛</obo:OAE_0001849>
        <obo:OAE_0004334>10066371</obo:OAE_0004334>
        <rdfs:label>tendon pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007788 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <obo:IAO_0000115>This is an AE which is a sudden involuntary contraction of myofascial tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasm</obo:IAO_0000119>
        <obo:OAE_0001849>肌筋膜痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10051378</obo:OAE_0004334>
        <rdfs:label>myofascial spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007789 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome characterized by chronic pain in multiple myofascial trigger points (&quot;knots&quot;) and fascial (connective tissue) constrictions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myofascial_pain_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>肌筋膜疼痛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10048780</obo:OAE_0004334>
        <rdfs:label>myofascial pain syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007790 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004238"/>
        <obo:IAO_0000115>This is an AE which main cause of the disease is aseptic inflammation of local muscles and connective tissues such as myofascial, which can be manifested as paralysis, distension, and other discomfort, local muscle stiffness, spasm or palpable strain-like nodules.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/34114979/</obo:IAO_0000119>
        <obo:OAE_0001849>肌筋膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10052443</obo:OAE_0004334>
        <rdfs:label>myofascitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007791 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001194"/>
        <obo:IAO_0000115>This is an AE which is a type of muscular dystrophy, a group of genetic disorders that cause progressive muscle loss and weakness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myotonic_dystrophy</obo:IAO_0000119>
        <obo:OAE_0001849>肌强直性营养不良</obo:OAE_0001849>
        <obo:OAE_0004334>10068871</obo:OAE_0004334>
        <rdfs:label>myotonic dystrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007792 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <obo:IAO_0000115>This is an AE which is the medical term for intercostal muscle pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myalgia</obo:IAO_0000119>
        <obo:OAE_0001849>肌痛肋间</obo:OAE_0001849>
        <obo:OAE_0004334>10028413</obo:OAE_0004334>
        <rdfs:label>myalgia intercostal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007793 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001194"/>
        <obo:IAO_0000115>This is an AE which is progressive wasting of muscle tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amyotrophy</obo:IAO_0000119>
        <obo:OAE_0001849>肌萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10002027</obo:OAE_0004334>
        <rdfs:label>amyotrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007794 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000422"/>
        <obo:IAO_0000115>This is an AE which is an involuntary, spontaneous, localized quivering of a few muscles, or bundles within a muscle, but which are insufficient to move a joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myokymia</obo:IAO_0000119>
        <obo:OAE_0001849>肌纤维颤搐</obo:OAE_0001849>
        <obo:OAE_0004334>10028632</obo:OAE_0004334>
        <rdfs:label>myokymia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007795 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <obo:IAO_0000115>This is an AE which occurs in individuals of all ages who are affected by dystonia, a movement disorder in which sustained involuntary muscle contractions cause twisting and repetitive motions or painful and abnormal postures or positions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tremor#Types</obo:IAO_0000119>
        <obo:OAE_0001849>肌张力异常性颤抖</obo:OAE_0001849>
        <obo:OAE_0004334>10073210</obo:OAE_0004334>
        <rdfs:label>dystonic tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007796 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is a disorder of  the continuous and passive partial contraction of the muscles, or the muscle&apos;s resistance to passive stretch during resting state.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Muscle_tone</obo:IAO_0000119>
        <obo:OAE_0001849>肌张力障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10072889</obo:OAE_0004334>
        <rdfs:label>muscle tone disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007797 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is a brief, involuntary, irregular (lacking rhythm) twitching (different from clonus, which is rhythmic/ regular) of a muscle or a group of muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myoclonus</obo:IAO_0000119>
        <obo:OAE_0001849>肌阵挛</obo:OAE_0001849>
        <obo:OAE_0004334>10028622</obo:OAE_0004334>
        <rdfs:label>myoclonus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007798 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000333"/>
        <obo:IAO_0000115>This is an AE which refers to a family of epilepsies that present with myoclonus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myoclonic_epilepsy</obo:IAO_0000119>
        <obo:OAE_0001849>肌阵挛性癫痫</obo:OAE_0001849>
        <obo:OAE_0004334>10054859</obo:OAE_0004334>
        <rdfs:label>myoclonic epilepsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007799 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004236"/>
        <obo:IAO_0000115>This is an AE which is a benign, soft tissue tumor composed of myofibroblasts (i.e. immature cells that contain features of myocytes and fibroblasts) that typically occurs in subcutaneous tissue (i.e. lowermost layer of the skin), fascia (i.e. band of connective tissue just beneath the skin), and/or muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nodular_fasciitis</obo:IAO_0000119>
        <obo:OAE_0001849>结节性筋膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065988</obo:OAE_0004334>
        <rdfs:label>nodular fasciitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007800 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007800">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000304"/>
        <obo:IAO_0000115>This is an AE which is a skin disease that presents with painful, red, raised, and warm patches of skin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_cellulitis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性蜂窝织炎</obo:OAE_0001849>
        <obo:OAE_0004334>10053776</obo:OAE_0004334>
        <rdfs:label>eosinophilic cellulitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007801 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004236"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory disease that affects the fascia, other connective tissues, surrounding muscles, blood vessels and nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Eosinophilic_fasciitis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜酸性筋膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10014954</obo:OAE_0004334>
        <rdfs:label>eosinophilic fasciitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007802 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007802">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000848"/>
        <obo:IAO_0000115>This is an AE which is an infectious and sometimes fatal viral disease that affects cloven-hoofed animals, including domestic and wild bovids.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Foot-and-mouth_disease</obo:IAO_0000119>
        <obo:OAE_0001849>口蹄疫</obo:OAE_0001849>
        <obo:OAE_0004334>10016961</obo:OAE_0004334>
        <rdfs:label>foot and mouth disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007803 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is primarily a disorder of healthy children and young adults, characterized by lesions that are primarily painful, subcutaneous nodules on the plantar surface, resembling erythema nodosum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Recurrent_palmoplantar_hidradenitis</obo:IAO_0000119>
        <obo:OAE_0001849>足底红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10051170</obo:OAE_0004334>
        <rdfs:label>plantar erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007804 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007804">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004236"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the plantar fascia, which is the connective tissue which supports the arch of the foot.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Plantar_fasciitis</obo:IAO_0000119>
        <obo:OAE_0001849>足底筋膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10035155</obo:OAE_0004334>
        <rdfs:label>plantar fasciitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007805 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which is a common skin infection of the feet caused by fungus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Athlete%27s_foot</obo:IAO_0000119>
        <obo:OAE_0001849>足癣</obo:OAE_0001849>
        <obo:OAE_0004334>10043873</obo:OAE_0004334>
        <rdfs:label>tinea pedis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007806 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing of the spinal canal or neural foramen that results in pressure on the spinal cord or nerve roots.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spinal_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>椎管狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10082214</obo:OAE_0004334>
        <rdfs:label>spinal stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007807 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002578"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a blood vessel or other tubular organ or structure such as vertebral foraminal .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>椎间孔狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10069690</obo:OAE_0004334>
        <rdfs:label>vertebral foraminal stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007808 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a defect or stress fracture in the pars interarticularis of the vertebral arch.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spondylolysis</obo:IAO_0000119>
        <obo:OAE_0001849>椎间盘突出症</obo:OAE_0001849>
        <obo:OAE_0004334>10052013</obo:OAE_0004334>
        <rdfs:label>spondylolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007809 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002578"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a blood vessel or other tubular organ or structure such as vertebral lateral recess.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>椎体侧隐窝狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10081612</obo:OAE_0004334>
        <rdfs:label>vertebral lateral recess stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007810 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000880"/>
        <obo:IAO_0000115>This is an AE which is a dislocation of an irregular bone with a complex structure composed of bone and some hyaline cartilage, the proportions of which vary according to the segment of the backbone and the species of vertebrate.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vertebra</obo:IAO_0000119>
        <obo:OAE_0001849>椎体脱位，腰椎脱位</obo:OAE_0001849>
        <obo:OAE_0004334>10013183</obo:OAE_0004334>
        <rdfs:label>dislocation of vertebra AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007811 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which refers to any clinical syndrome with either an excess of movement or a paucity of voluntary and involuntary movements, unrelated to weakness or spasticity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Movement_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>锥体外系疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10015832</obo:OAE_0004334>
        <rdfs:label>extrapyramidal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007812 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002774"/>
        <obo:IAO_0000115>This is an AE which is the absence of, or a violation of, symmetry  such as limb asymmetry.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Asymmetry#Asymmetry_in_biology</obo:IAO_0000119>
        <obo:OAE_0001849>肢体不对称</obo:OAE_0001849>
        <obo:OAE_0004334>10070670</obo:OAE_0004334>
        <rdfs:label>limb asymmetry AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007813 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is congenital musculoskeletal disorders which primarily affect the upper and lower limbs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Congenital_limb_deformities</obo:IAO_0000119>
        <obo:OAE_0001849>肢体畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10053652</obo:OAE_0004334>
        <rdfs:label>limb deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007814 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007814">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which is a physical anomaly that is deleterious, i.e. a structural defect perceived as a problem such as limb malformation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>肢体畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10024500</obo:OAE_0004334>
        <rdfs:label>limb malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007815 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a mass on  appendage of a human .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Limb</obo:IAO_0000119>
        <obo:OAE_0001849>肢体肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10078503</obo:OAE_0004334>
        <rdfs:label>limb mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007817 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000414"/>
        <obo:IAO_0000115>This is an AE which is a rare condition and should be considered a rare differential diagnosis to unexplained back pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20334799/</obo:IAO_0000119>
        <obo:OAE_0001849>腰疝</obo:OAE_0001849>
        <obo:OAE_0004334>10024995</obo:OAE_0004334>
        <rdfs:label>lumbar hernia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007818 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which the spinal canal narrows and compresses the nerves and blood vessels at the level of the lumbar vertebrae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lumbar_spinal_stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>腰椎管狭窄症</obo:OAE_0001849>
        <obo:OAE_0004334>10025005</obo:OAE_0004334>
        <rdfs:label>lumbar spinal stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007819 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is the displacement of one spinal vertebra compared to another.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spondylolisthesis</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱滑脱</obo:OAE_0001849>
        <obo:OAE_0004334>10063550</obo:OAE_0004334>
        <rdfs:label>spondylolisthesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007820 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is flattening of the five vertebrae between the rib cage and the pelvis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lumbar_vertebrae</obo:IAO_0000119>
        <obo:OAE_0001849>腰椎扁平化</obo:OAE_0001849>
        <obo:OAE_0004334>10051823</obo:OAE_0004334>
        <rdfs:label>lumbar spine flattening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007821 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome in which the facet joints (synovial diarthroses, from L2 to S1) cause painful symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Facet_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>小关节综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10054813</obo:OAE_0004334>
        <rdfs:label>facet joint syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007822 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a disorder of the hand that can be congenital or acquired.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hand_deformity</obo:IAO_0000119>
        <obo:OAE_0001849>手畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061194</obo:OAE_0004334>
        <rdfs:label>hand deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007823 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which in older people is common following treatment for a wrist fracture, particularly after non-surgical treatment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32197641/</obo:IAO_0000119>
        <obo:OAE_0001849>手腕畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061415</obo:OAE_0004334>
        <rdfs:label>wrist deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007824 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <obo:IAO_0000115>This is an AE which presents with hyperkeratotic, fissure-prone, erythematous areas of the middle or proximal palm, and the volar surfaces of the fingers may also be involved.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hyperkeratotic_hand_dermatitis</obo:IAO_0000119>
        <obo:OAE_0001849>手性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10058898</obo:OAE_0004334>
        <rdfs:label>hand dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007825 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001398"/>
        <obo:IAO_0000115>This is an AE which is a fungal infection of the hand, mostly a type of dermatophytosis, often part of two feet-one hand syndrome.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tinea_manuum</obo:IAO_0000119>
        <obo:OAE_0001849>手癣</obo:OAE_0001849>
        <obo:OAE_0004334>10067197</obo:OAE_0004334>
        <rdfs:label>tinea manuum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007826 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>This is an AE which is a common infection caused by a group of enteroviruses.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hand,_foot,_and_mouth_disease</obo:IAO_0000119>
        <obo:OAE_0001849>手足口病</obo:OAE_0001849>
        <obo:OAE_0004334>10019113</obo:OAE_0004334>
        <rdfs:label>hand-foot-and-mouth disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007827 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007827">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a symptom characterized by slow, involuntary, convoluted, writhing movements of the fingers, hands, toes, and feet and in some cases, arms, legs, neck and tongue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Athetosis</obo:IAO_0000119>
        <obo:OAE_0001849>手足徐动症</obo:OAE_0001849>
        <obo:OAE_0004334>10003620</obo:OAE_0004334>
        <rdfs:label>athetosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007828 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a small benign tumor that forms primarily in areas where the skin forms creases (or rubs together), such as the neck, armpit and groin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Skin_tag</obo:IAO_0000119>
        <obo:OAE_0001849>软垂疣</obo:OAE_0001849>
        <obo:OAE_0004334>10000591</obo:OAE_0004334>
        <rdfs:label>acrochordon AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007829 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a heritable connective tissue disorder that affects joints and ligaments.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypermobility_spectrum_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>软筋症候群</obo:OAE_0001849>
        <obo:OAE_0004334>10020677</obo:OAE_0004334>
        <rdfs:label>hypermobility syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007830 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is medical conditions affecting soft tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Soft_tissue#Disorders</obo:IAO_0000119>
        <obo:OAE_0001849>软组织疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10061366</obo:OAE_0004334>
        <rdfs:label>soft tissue disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007831 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a mass of  all the tissue in the body that is not hardened by the processes of ossification or calcification such as bones and teeth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Soft_tissue</obo:IAO_0000119>
        <obo:OAE_0001849>软组织块</obo:OAE_0001849>
        <obo:OAE_0004334>10071051</obo:OAE_0004334>
        <rdfs:label>soft tissue mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007832 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a malignant tumour, a type of cancer, that develops in soft tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Soft-tissue_sarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>软组织肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10075333</obo:OAE_0004334>
        <rdfs:label>soft tissue sarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007833 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is the partial or complete wasting away of a part of the soft tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Atrophy</obo:IAO_0000119>
        <obo:OAE_0001849>软组织萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10068548</obo:OAE_0004334>
        <rdfs:label>soft tissue atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007834 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is part of the complex biological response of soft tissue to harmful stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inflammation</obo:IAO_0000119>
        <obo:OAE_0001849>软组织炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10041290</obo:OAE_0004334>
        <rdfs:label>soft tissue inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007835 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a type of abnormal and excessive growth of soft tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neoplasm</obo:IAO_0000119>
        <obo:OAE_0001849>软组织肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10068771</obo:OAE_0004334>
        <rdfs:label>soft tissue neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007836 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which refers a transient abnormal enlargement of soft tissue not caused by a tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Swelling</obo:IAO_0000119>
        <obo:OAE_0001849>软组织肿胀</obo:OAE_0001849>
        <obo:OAE_0004334>10076991</obo:OAE_0004334>
        <rdfs:label>soft tissue swelling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007837 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is  rupture of  the fibrous connective tissue that connects bones to other bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ligament</obo:IAO_0000119>
        <obo:OAE_0001849>韧带断裂</obo:OAE_0001849>
        <obo:OAE_0004334>10065433</obo:OAE_0004334>
        <rdfs:label>ligament rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007838 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001940"/>
        <obo:IAO_0000115>This is an AE which is the stretching or tearing of ligaments within a joint, often caused by an injury abruptly forcing the joint beyond its functional range of motion.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sprain</obo:IAO_0000119>
        <obo:OAE_0001849>韧带扭伤</obo:OAE_0001849>
        <obo:OAE_0004334>10024453</obo:OAE_0004334>
        <rdfs:label>ligament sprain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007839 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a cause of chronic body pain characterized by loose ligaments.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ligamentous_laxity</obo:IAO_0000119>
        <obo:OAE_0001849>韧带松弛</obo:OAE_0001849>
        <obo:OAE_0004334>10024452</obo:OAE_0004334>
        <rdfs:label>ligament laxity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007840 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007840">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a disorder of  the fibrous connective tissue that connects bones to other bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ligament</obo:IAO_0000119>
        <obo:OAE_0001849>韧带障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061222</obo:OAE_0004334>
        <rdfs:label>ligament disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007841 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is any disease that has the connective tissues of the body as a target of pathology.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Connective_tissue_disease?wprov=srpw1_0</obo:IAO_0000119>
        <obo:OAE_0001849>结缔组织炎症</obo:OAE_0001849>
        <obo:OAE_0004334>10057254</obo:OAE_0004334>
        <rdfs:label>connective tissue inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007842 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which refers to any joint disease of the vertebral column.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spondyloarthropathy</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱关节病</obo:OAE_0001849>
        <obo:OAE_0004334>10051265</obo:OAE_0004334>
        <rdfs:label>spondyloarthropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007843 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a spinal of  posterior displacement of one vertebral body with respect to the subjacent vertebra to a degree less than a luxation (dislocation).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Retrolisthesis</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱后滑脱</obo:OAE_0001849>
        <obo:OAE_0004334>10081602</obo:OAE_0004334>
        <rdfs:label>spinal retrolisthesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007844 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a physical anomaly that is deleterious, i.e. a structural defect perceived as a problem such as spine malformation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Birth_defect#congenital_malformation</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10041611</obo:OAE_0004334>
        <rdfs:label>spine malformation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007845 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a birth defect in which there is incomplete closing of the spine and the membranes around the spinal cord during early development in pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spina_bifida</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱裂</obo:OAE_0001849>
        <obo:OAE_0004334>10041524</obo:OAE_0004334>
        <rdfs:label>spina bifida AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007846 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a mass on the part of the axial skeleton.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Vertebral_column</obo:IAO_0000119>
        <obo:OAE_0001849>脊柱肿块</obo:OAE_0001849>
        <obo:OAE_0004334>10054820</obo:OAE_0004334>
        <rdfs:label>vertebral column mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007847 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which feels pain of a small membranous protrusion from a neuron&apos;s dendrite.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spine</obo:IAO_0000119>
        <obo:OAE_0001849>脊椎痛</obo:OAE_0001849>
        <obo:OAE_0004334>10072005</obo:OAE_0004334>
        <rdfs:label>spinal pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007848 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the vertebrae.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spondylitis</obo:IAO_0000119>
        <obo:OAE_0001849>脊椎炎</obo:OAE_0001849>
        <obo:OAE_0004334>10061371</obo:OAE_0004334>
        <rdfs:label>spondylitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007849 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007849">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000544"/>
        <obo:IAO_0000115>This is an AE which is a form of gait abnormality.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spastic_gait</obo:IAO_0000119>
        <obo:OAE_0001849>步态痉挛性</obo:OAE_0001849>
        <obo:OAE_0004334>10017585</obo:OAE_0004334>
        <rdfs:label>gait spastic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007850 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000544"/>
        <obo:IAO_0000115>This is an AE which is nominally referred to as any variation of standard human gait, typically manifesting as a coping mechanism in response to an anatomical impairment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gait_deviations</obo:IAO_0000119>
        <obo:OAE_0001849>步态偏差</obo:OAE_0001849>
        <obo:OAE_0004334>10054197</obo:OAE_0004334>
        <rdfs:label>gait deviation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007851 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000544"/>
        <obo:IAO_0000115>This is an AE which is characterised by an inability to initiate the process of walking, despite the power and coordination of the legs being normal when tested in the seated or lying position.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bruns_apraxia</obo:IAO_0000119>
        <obo:OAE_0001849>步态失用症</obo:OAE_0001849>
        <obo:OAE_0004334>10070635</obo:OAE_0004334>
        <rdfs:label>gait apraxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007852 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000544"/>
        <obo:IAO_0000115>This is an AE which is nominally referred to as any variation of standard human gait, typically manifesting as a coping mechanism in response to an anatomical impairment.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gait_deviations</obo:IAO_0000119>
        <obo:OAE_0001849>步态障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10017577</obo:OAE_0004334>
        <rdfs:label>gait disturbance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007853 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is the inflammation of the fluid-filled sheath (called the synovium) that surrounds a tendon, typically leading to joint pain, swelling, and stiffness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tenosynovitis</obo:IAO_0000119>
        <obo:OAE_0001849>腱鞘炎</obo:OAE_0001849>
        <obo:OAE_0004334>10043261</obo:OAE_0004334>
        <rdfs:label>tenosynovitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007854 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which can occur in apparently healthy subjects having no atypical appearance and who may be unaware of carrying risk.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/20207434/</obo:IAO_0000119>
        <obo:OAE_0001849>腱索断裂</obo:OAE_0001849>
        <obo:OAE_0004334>10008745</obo:OAE_0004334>
        <rdfs:label>chordae tendinae rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007855 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a rare neurologic disorder of unclear cause characterized by progressive rigidity and stiffness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stiff-person_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>僵人综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10072148</obo:OAE_0004334>
        <rdfs:label>stiff person syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007856 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an uncommon focal variant of the stiff person syndrome and is characterized by stiffness and painful spasms of the lower limbs, with no axial involvement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/27000980/</obo:IAO_0000119>
        <obo:OAE_0001849>僵腿综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10079359</obo:OAE_0004334>
        <rdfs:label>stiff leg syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007857 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is defined as arthritis affecting two to four joints during the first six months of disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oligoarthritis</obo:IAO_0000119>
        <obo:OAE_0001849>少关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10082100</obo:OAE_0004334>
        <rdfs:label>oligoarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007858 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which refers to a height of a human which is below typical.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Short_stature</obo:IAO_0000119>
        <obo:OAE_0001849>身材矮小</obo:OAE_0001849>
        <obo:OAE_0004334>10040600</obo:OAE_0004334>
        <rdfs:label>short stature AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007859 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is a limitation on a person&apos;s physical functioning, mobility, dexterity or stamina.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Physical_disability</obo:IAO_0000119>
        <obo:OAE_0001849>身体残疾</obo:OAE_0001849>
        <obo:OAE_0004334>10048624</obo:OAE_0004334>
        <rdfs:label>physical disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007860 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002144"/>
        <obo:IAO_0000115>This is an AE which is any intentional act causing injury or trauma to another person or animal by way of bodily contact.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Physical_abuse</obo:IAO_0000119>
        <obo:OAE_0001849>虐待身体</obo:OAE_0001849>
        <obo:OAE_0004334>10034982</obo:OAE_0004334>
        <rdfs:label>physical abuse AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007861 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001517"/>
        <obo:IAO_0000115>This is an AE which is the removal of a leg by trauma, medical illness, or surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amputation</obo:IAO_0000119>
        <obo:OAE_0001849>腿部截肢</obo:OAE_0001849>
        <obo:OAE_0004334>10024124</obo:OAE_0004334>
        <rdfs:label>leg amputation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007862 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000307"/>
        <obo:IAO_0000115>This is an AE which is a deviation from normal walking (gait).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gait_abnormality</obo:IAO_0000119>
        <obo:OAE_0001849>行走困难</obo:OAE_0001849>
        <obo:OAE_0004334>10012794</obo:OAE_0004334>
        <rdfs:label>difficulty in walking AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007863 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000635"/>
        <obo:IAO_0000115>This is an AE which is one of the most widespread and impactful consequences of multiple sclerosis (MS).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29772185/</obo:IAO_0000119>
        <obo:OAE_0001849>行走障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10053204</obo:OAE_0004334>
        <rdfs:label>walking disability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007864 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002413"/>
        <obo:IAO_0000115>This is an AE which is a condition in which one or more fingers become permanently bent in a flexed position.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Dupuytren%27s_contracture</obo:IAO_0000119>
        <obo:OAE_0001849>掌腱膜挛缩</obo:OAE_0001849>
        <obo:OAE_0004334>10013872</obo:OAE_0004334>
        <rdfs:label>dupuytren&apos;s contracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007865 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a heterogeneous group of disorders characterized by abnormal thickening of the stratum corneum of the palms and soles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palmoplantar_keratoderma</obo:IAO_0000119>
        <obo:OAE_0001849>掌跖角化病</obo:OAE_0001849>
        <obo:OAE_0004334>10033554</obo:OAE_0004334>
        <rdfs:label>palmoplantar keratoderma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007866 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001844"/>
        <obo:IAO_0000115>This is an AE which is a bleeding into joint spaces. It is a common feature of hemophilia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemarthrosis</obo:IAO_0000119>
        <obo:OAE_0001849>关节积血</obo:OAE_0001849>
        <obo:OAE_0004334>10018829</obo:OAE_0004334>
        <rdfs:label>haemarthrosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007867 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is very frequent and usually self limited to a few weeks.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16604875/</obo:IAO_0000119>
        <obo:OAE_0001849>病毒性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10003274</obo:OAE_0004334>
        <rdfs:label>arthritis viral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007868 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is a form of osteoarthritis following an injury to a joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Post-traumatic_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>创伤性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10048873</obo:OAE_0004334>
        <rdfs:label>traumatic arthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007869 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007869">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which should be regarded as infectious until proved otherwise.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/9217557/</obo:IAO_0000119>
        <obo:OAE_0001849>单关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10027811</obo:OAE_0004334>
        <rdfs:label>monarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007870 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is inflammation within the sacroiliac joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sacroiliitis</obo:IAO_0000119>
        <obo:OAE_0001849>骶髂关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10039361</obo:OAE_0004334>
        <rdfs:label>sacroiliitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007871 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003251"/>
        <obo:IAO_0000115>This is an AE which is recurring pain symptoms that are relatively common in children ages 3 to 12.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Growing_pains</obo:IAO_0000119>
        <obo:OAE_0001849>发育期痛</obo:OAE_0001849>
        <obo:OAE_0004334>10018745</obo:OAE_0004334>
        <rdfs:label>growing pains AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007872 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of the hip joint where the socket portion does not fully cover the ball portion, resulting in an increased risk for joint dislocation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hip_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>发育性髋关节发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10073767</obo:OAE_0004334>
        <rdfs:label>developmental hip dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007873 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is an infection with arthritis caused by the rubella virus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rubella</obo:IAO_0000119>
        <obo:OAE_0001849>关节炎风疹</obo:OAE_0001849>
        <obo:OAE_0004334>10003270</obo:OAE_0004334>
        <rdfs:label>arthritis rubella AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007874 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is the invasion of a joint by an infectious agent streptococcal resulting in joint inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Septic_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>链球菌化脓性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10067323</obo:OAE_0004334>
        <rdfs:label>septic arthritis streptococcal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007875 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is the invasion of a joint by an infectious agent haemophilus resulting in joint inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Septic_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>嗜血杆菌化脓性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10040059</obo:OAE_0004334>
        <rdfs:label>septic arthritis haemophilus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007876 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is associated with conditions such as clubfoot, cerebral palsy, and myelodysplasia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32398628/</obo:IAO_0000119>
        <obo:OAE_0001849>踝关节畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10071050</obo:OAE_0004334>
        <rdfs:label>ankle deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007877 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002397"/>
        <obo:IAO_0000115>This is an AE which is a class of joint disorder (called arthropathy) that is characterized by accumulation of tiny crystals in one or more joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Crystal_arthropathy</obo:IAO_0000119>
        <obo:OAE_0001849>晶体关节病</obo:OAE_0001849>
        <obo:OAE_0004334>10061419</obo:OAE_0004334>
        <rdfs:label>crystal arthropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007878 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is an abnormality of the hip joint where the socket portion does not fully cover the ball portion, resulting in an increased risk for joint dislocation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hip_dysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>髋关节发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10063175</obo:OAE_0004334>
        <rdfs:label>hip dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007879 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of hip compared to the normal shape of that part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>髋关节畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061209</obo:OAE_0004334>
        <rdfs:label>hip deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007880 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a disease in which the body mistakenly attacks its own tissues.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Undifferentiated_connective_tissue_disease</obo:IAO_0000119>
        <obo:OAE_0001849>未分化结缔组织病</obo:OAE_0001849>
        <obo:OAE_0004334>10071575</obo:OAE_0004334>
        <rdfs:label>undifferentiated connective tissue disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007881 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease characterized by the presence of elevated blood levels of a specific autoantibody, now called anti-U1 ribonucleoprotein (RNP) together with a mix of symptoms of systemic lupus erythematosus (SLE), scleroderma, and polymyositis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mixed_connective_tissue_disease</obo:IAO_0000119>
        <obo:OAE_0001849>混合性结缔组织病</obo:OAE_0001849>
        <obo:OAE_0004334>10027754</obo:OAE_0004334>
        <rdfs:label>mixed connective tissue disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007882 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a type of arthritis in which there is a long-term inflammation of the joints of the spine.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ankylosing_spondylitis</obo:IAO_0000119>
        <obo:OAE_0001849>强直性脊柱炎</obo:OAE_0001849>
        <obo:OAE_0004334>10002556</obo:OAE_0004334>
        <rdfs:label>ankylosing spondylitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007883 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is paralysis caused by illness or injury that results in the partial or total loss of use of all four limbs and torso; paraplegia is similar but does not affect the arms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tetraplegia</obo:IAO_0000119>
        <obo:OAE_0001849>四肢瘫痪</obo:OAE_0001849>
        <obo:OAE_0004334>10049680</obo:OAE_0004334>
        <rdfs:label>quadriparesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007884 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a sleep disorder where the patient moves limbs involuntarily and periodically during sleep, and has symptoms or problems related to the movement.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periodic_limb_movement_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>周期性肢体运动障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10064600</obo:OAE_0004334>
        <rdfs:label>periodic limb movement disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007885 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a stump pain of the removal of a limb by trauma, medical illness, or surgery.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amputation</obo:IAO_0000119>
        <obo:OAE_0001849>截肢残肢疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10069724</obo:OAE_0004334>
        <rdfs:label>amputation stump pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007886 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>This is an AE which is frequently associated with other cerebral malformations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/11826610/</obo:IAO_0000119>
        <obo:OAE_0001849>透明隔发育不全</obo:OAE_0001849>
        <obo:OAE_0004334>10062267</obo:OAE_0004334>
        <rdfs:label>septum pellucidum agenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007887 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the tissues in the mid-chest, or mediastinum.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mediastinitis</obo:IAO_0000119>
        <obo:OAE_0001849>纵隔炎</obo:OAE_0001849>
        <obo:OAE_0004334>10027082</obo:OAE_0004334>
        <rdfs:label>mediastinitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007888 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000333"/>
        <obo:IAO_0000115>This is an AE which refers a consequence of diaphragm dysfunction and atrophy, is common in the ICU and associated with serious clinical consequences.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31876624/</obo:IAO_0000119>
        <obo:OAE_0001849>横膈轻瘫</obo:OAE_0001849>
        <obo:OAE_0004334>10012708</obo:OAE_0004334>
        <rdfs:label>diaphragm muscle weakness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007889 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of shoulder compared to the normal shape of that part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>肩部畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10062241</obo:OAE_0004334>
        <rdfs:label>shoulder deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007890 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is typically a symptom-limiting condition that resolves spontaneously.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23370373/</obo:IAO_0000119>
        <obo:OAE_0001849>肩周炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034464</obo:OAE_0004334>
        <rdfs:label>periarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007891 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of neck compared to the normal shape of that part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>颈部畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061307</obo:OAE_0004334>
        <rdfs:label>neck deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007892 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of cervical plexus, usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>颈丛病变</obo:OAE_0001849>
        <obo:OAE_0004334>10067785</obo:OAE_0004334>
        <rdfs:label>cervical plexus lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007893 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a cervical root distressing feeling often caused by intense or damaging stimuli.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pain</obo:IAO_0000119>
        <obo:OAE_0001849>颈根疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10008303</obo:OAE_0004334>
        <rdfs:label>cervical root pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007894 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is flattening of  the vertebrae of the neck, immediately below the skull.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cervical_vertebrae</obo:IAO_0000119>
        <obo:OAE_0001849>颈椎扁平化</obo:OAE_0001849>
        <obo:OAE_0004334>10051824</obo:OAE_0004334>
        <rdfs:label>cervical spine flattening AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007895 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a medical condition of pregnancy in which the cervix begins to dilate (widen) and efface (thin) before the pregnancy has reached term.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cervical_weakness</obo:IAO_0000119>
        <obo:OAE_0001849>颈锥功能不全</obo:OAE_0001849>
        <obo:OAE_0004334>10008267</obo:OAE_0004334>
        <rdfs:label>cervical incompetence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007897 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000900"/>
        <obo:IAO_0000115>This is an AE which is a disorder in which the muscles that generate a person&apos;s voice go into periods of spasm.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasmodic_dysphonia</obo:IAO_0000119>
        <obo:OAE_0001849>喉肌痉挛症</obo:OAE_0001849>
        <obo:OAE_0004334>10067672</obo:OAE_0004334>
        <rdfs:label>spasmodic dysphonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007898 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004289"/>
        <obo:IAO_0000115>This is an AE which is a group of inherited diseases whose main feature is a progressive gait disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hereditary_spastic_paraplegia</obo:IAO_0000119>
        <obo:OAE_0001849>痉挛性截瘫</obo:OAE_0001849>
        <obo:OAE_0004334>10048792</obo:OAE_0004334>
        <rdfs:label>spastic paraplegia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007899 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is a feature of altered skeletal muscle performance with a combination of paralysis, increased tendon reflex activity, and hypertonia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Spasticity</obo:IAO_0000119>
        <obo:OAE_0001849>痉挛性麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10041415</obo:OAE_0004334>
        <rdfs:label>spastic paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007900 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007900">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <obo:IAO_0000115>This is an AE which is a highly characteristic, abnormal, sustained spasm of the facial muscles that appears to produce grinning.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Risus_sardonicus</obo:IAO_0000119>
        <obo:OAE_0001849>痉笑</obo:OAE_0001849>
        <obo:OAE_0004334>10039198</obo:OAE_0004334>
        <rdfs:label>risus sardonicus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007901 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is a behavioral characteristic assigned to those with conditions that are regarded as rare or dysfunctional such as somatic dysfunction.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abnormality_(behavior)</obo:IAO_0000119>
        <obo:OAE_0001849>躯体功能障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10077554</obo:OAE_0004334>
        <rdfs:label>somatic dysfunction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007902 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007902">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <obo:IAO_0000115>This is an AE which is a mental and behavioral disorder characterized by recurring, multiple, and current, clinically significant complaints about somatic symptoms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Somatization_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>躯体化障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10041318</obo:OAE_0004334>
        <rdfs:label>somatisation disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007903 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000512"/>
        <obo:IAO_0000115>This is an AE which is a perception in the absence of an external stimulus that has the qualities of a real perception.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hallucination</obo:IAO_0000119>
        <obo:OAE_0001849>躯体幻觉</obo:OAE_0001849>
        <obo:OAE_0004334>10062684</obo:OAE_0004334>
        <rdfs:label>somatic hallucination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007904 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007904">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002491"/>
        <obo:IAO_0000115>This is an AE which is a fixed belief  that is not amenable to change in light of conflicting evidence.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Delusion</obo:IAO_0000119>
        <obo:OAE_0001849>躯体妄想</obo:OAE_0001849>
        <obo:OAE_0004334>10041317</obo:OAE_0004334>
        <rdfs:label>somatic delusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007907 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007907">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <obo:IAO_0000115>This is an AE which is a method of medication administration in which a medicine is injected into the epidural space around the spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Epidural_administration</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜外镇痛</obo:OAE_0001849>
        <obo:OAE_0004334>10054891</obo:OAE_0004334>
        <rdfs:label>epidural analgesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007908 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a form of empyema – a collection of pus, in the subdural space.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subdural_empyema</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜下积脓</obo:OAE_0001849>
        <obo:OAE_0004334>10042360</obo:OAE_0004334>
        <rdfs:label>subdural empyema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007909 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000906"/>
        <obo:IAO_0000115>This is an AE which refers to an effusion in the subdural space, usually of cerebrospinal fluid.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Subdural_effusion</obo:IAO_0000119>
        <obo:OAE_0001849>硬膜下积液</obo:OAE_0001849>
        <obo:OAE_0004334>10054797</obo:OAE_0004334>
        <rdfs:label>subdural effusion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007910 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which is postictal process of a loss of motor function in one or more muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>发作后麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10052469</obo:OAE_0004334>
        <rdfs:label>postictal paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007911 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo:IAO_0000115>This is an AE which has a variable definition in the literature without consideration of degree or substratification of other confounders such as the presence of arthritis or pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28526423/</obo:IAO_0000119>
        <obo:OAE_0001849>假性麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10056300</obo:OAE_0004334>
        <rdfs:label>pseudoparalysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007912 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a disorder of viscous, non-Newtonian fluid found in the cavities of synovial joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Synovial_fluid</obo:IAO_0000119>
        <obo:OAE_0001849>滑膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10061374</obo:OAE_0004334>
        <rdfs:label>synovial disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007913 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is the medical term for inflammation of the synovial membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Synovitis</obo:IAO_0000119>
        <obo:OAE_0001849>滑膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10042868</obo:OAE_0004334>
        <rdfs:label>synovitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007914 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007914">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is crystal of  viscous, non-Newtonian fluid found in the cavities of synovial joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Synovial_fluid</obo:IAO_0000119>
        <obo:OAE_0001849>滑液结晶</obo:OAE_0001849>
        <obo:OAE_0004334>10063369</obo:OAE_0004334>
        <rdfs:label>synovial fluid crystal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007915 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <obo:IAO_0000115>This is an AE which is a group of diseases with necrotising whose hallmark is inflammation of subcutaneous adipose tissue (the fatty layer under the skin panniculus adiposus).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Panniculitis</obo:IAO_0000119>
        <obo:OAE_0001849>坏死性脂膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062579</obo:OAE_0004334>
        <rdfs:label>necrotising panniculitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007916 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <obo:IAO_0000115>This is an AE which is a collection or gathering of pus within a naturally existing anatomical cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Empyema</obo:IAO_0000119>
        <obo:OAE_0001849>积脓症</obo:OAE_0001849>
        <obo:OAE_0004334>10014568</obo:OAE_0004334>
        <rdfs:label>empyema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007917 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is an accumulation of serous fluid in a body cavity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hydrocele</obo:IAO_0000119>
        <obo:OAE_0001849>积水</obo:OAE_0001849>
        <obo:OAE_0004334>10020488</obo:OAE_0004334>
        <rdfs:label>hydrocele AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007918 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007918">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is conditions causing chronic, often intermittent pain affecting the joints or connective tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rheumatism</obo:IAO_0000119>
        <obo:OAE_0001849>风湿病</obo:OAE_0001849>
        <obo:OAE_0004334>10072736</obo:OAE_0004334>
        <rdfs:label>rheumatic disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007919 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007919">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <obo:IAO_0000115>This is an AE which is an inflammatory disease that can involve the heart, joints, skin, and brain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rheumatic_fever</obo:IAO_0000119>
        <obo:OAE_0001849>风湿热</obo:OAE_0001849>
        <obo:OAE_0004334>10039054</obo:OAE_0004334>
        <rdfs:label>rheumatic fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007920 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is a syndrome characterised by recurrent, self-resolving inflammatory attacks in and around the joints, consists of arthritis or periarticular soft tissue inflammation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palindromic_rheumatism</obo:IAO_0000119>
        <obo:OAE_0001849>复发性风湿病</obo:OAE_0001849>
        <obo:OAE_0004334>10033534</obo:OAE_0004334>
        <rdfs:label>palindromic rheumatism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007921 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is a neurodegenerative disease that is mostly inherited.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Huntington%27s_disease</obo:IAO_0000119>
        <obo:OAE_0001849>亨廷顿氏舞蹈症</obo:OAE_0001849>
        <obo:OAE_0004334>10070668</obo:OAE_0004334>
        <rdfs:label>huntington&apos;s disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007922 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is the occurrence of involuntary movements in a combination of chorea (irregular migrating contractions) and athetosis (twisting and writhing).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Choreoathetosis</obo:IAO_0000119>
        <obo:OAE_0001849>舞蹈手足徐动症</obo:OAE_0001849>
        <obo:OAE_0004334>10008754</obo:OAE_0004334>
        <rdfs:label>choreoathetosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007923 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which is crystal of  viscous, non-Newtonian fluid found in the cavities of synovial joints.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Synovial_fluid</obo:IAO_0000119>
        <obo:OAE_0001849>存在滑液结晶</obo:OAE_0001849>
        <obo:OAE_0004334>10057112</obo:OAE_0004334>
        <rdfs:label>synovial fluid crystal present AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007924 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002413"/>
        <obo:IAO_0000115>This is an AE which is a basal ganglia syndrome resulting from damage to the subthalamic nucleus in the basal ganglia.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemiballismus</obo:IAO_0000119>
        <obo:OAE_0001849>颤搐</obo:OAE_0001849>
        <obo:OAE_0004334>10058504</obo:OAE_0004334>
        <rdfs:label>ballismus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007925 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002413"/>
        <obo:IAO_0000115>This is an AE which is a medical sign consisting of the involuntary contraction of muscles, which may be caused by disorders that increase the action potential frequency of muscle cells or the nerves that innervate them.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tetany</obo:IAO_0000119>
        <obo:OAE_0001849>抽搐</obo:OAE_0001849>
        <obo:OAE_0004334>10043380</obo:OAE_0004334>
        <rdfs:label>tetany AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007926 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002625"/>
        <obo:IAO_0000115>This is an AE which is a medical condition where  local body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Convulsion</obo:IAO_0000119>
        <obo:OAE_0001849>局部抽搐</obo:OAE_0001849>
        <obo:OAE_0004334>10010920</obo:OAE_0004334>
        <rdfs:label>convulsions local AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007927 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <obo:IAO_0000115>This is an AE which is an involuntary, somewhat rhythmic, muscle contraction and relaxation involving oscillations or twitching movements of one or more body parts.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tremor</obo:IAO_0000119>
        <obo:OAE_0001849>静止性震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10071390</obo:OAE_0004334>
        <rdfs:label>resting tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007928 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002413"/>
        <obo:IAO_0000115>This is an AE which is a medical sign observed in patients with low calcium.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trousseau_sign_of_latent_tetany</obo:IAO_0000119>
        <obo:OAE_0001849>潜在性手足搐搦</obo:OAE_0001849>
        <obo:OAE_0004334>10052067</obo:OAE_0004334>
        <rdfs:label>latent tetany AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007929 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of meniscus , usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>半月板损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10053777</obo:OAE_0004334>
        <rdfs:label>meniscus lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007930 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003321"/>
        <obo:IAO_0000115>This is an AE which is a form of inflammatory arthritis characterized by recurrent attacks of a red, tender, hot, and swollen joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gout</obo:IAO_0000119>
        <obo:OAE_0001849>痛风</obo:OAE_0001849>
        <obo:OAE_0004334>10018627</obo:OAE_0004334>
        <rdfs:label>gout AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007931 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a disorder characterized by catching or locking of the involved finger.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Trigger_finger</obo:IAO_0000119>
        <obo:OAE_0001849>狭窄性腱鞘炎</obo:OAE_0001849>
        <obo:OAE_0004334>10056698</obo:OAE_0004334>
        <rdfs:label>tenosynovitis stenosans AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007932 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is a disorder characterized by rapid, uncoordinated jerking movements primarily affecting the face, hands and feet.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sydenham%27s_chorea</obo:IAO_0000119>
        <obo:OAE_0001849>西德纳姆舞蹈病</obo:OAE_0001849>
        <obo:OAE_0004334>10042732</obo:OAE_0004334>
        <rdfs:label>sydenham&apos;s chorea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007933 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000306"/>
        <obo:IAO_0000115>This is an AE which is a medical condition where body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking and is clonic.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Convulsion</obo:IAO_0000119>
        <obo:OAE_0001849>阵发性痉挛</obo:OAE_0001849>
        <obo:OAE_0004334>10053398</obo:OAE_0004334>
        <rdfs:label>clonic convulsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007934 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by involuntary rhythmic contractions and relaxations (oscillations or twitching movements) of certain muscle groups in one or more body parts of unknown cause.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Essential_tremor</obo:IAO_0000119>
        <obo:OAE_0001849>姿势震颤</obo:OAE_0001849>
        <obo:OAE_0004334>10073211</obo:OAE_0004334>
        <rdfs:label>postural tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007935 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002441"/>
        <obo:IAO_0000115>This is an AE which preceding convulsion has been observed in sports injuries at the moment of impact where extension and flexion of opposite arms occur despite body position or gravity.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Fencing_response</obo:IAO_0000119>
        <obo:OAE_0001849>强直姿势</obo:OAE_0001849>
        <obo:OAE_0004334>10075125</obo:OAE_0004334>
        <rdfs:label>tonic posturing AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007936 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which results in avascular necrosis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Infarction</obo:IAO_0000119>
        <obo:OAE_0001849>骨梗死</obo:OAE_0001849>
        <obo:OAE_0004334>10049824</obo:OAE_0004334>
        <rdfs:label>bone infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007937 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which may refer to a number of entities: Osteoporosis, a condition in which overall bone density decreases Periodontitis, a condition in which the supporting bone around teeth exhibits resorption.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_loss</obo:IAO_0000119>
        <obo:OAE_0001849>骨质流失</obo:OAE_0001849>
        <obo:OAE_0004334>10065687</obo:OAE_0004334>
        <rdfs:label>bone loss AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007938 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is an abnormal growth of tissue in bone, traditionally classified as noncancerous (benign) or cancerous (malignant).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>骨肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10005995</obo:OAE_0004334>
        <rdfs:label>bone neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007939 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which the primary symptom of is pain, which often occurs at rest or at night.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18399615/</obo:IAO_0000119>
        <obo:OAE_0001849>恶性骨肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10053650</obo:OAE_0004334>
        <rdfs:label>bone neoplasm malignant AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007940 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a primary malignant bone tumour, a type of sarcoma that starts in the bones.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_sarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>骨肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10006007</obo:OAE_0004334>
        <rdfs:label>bone sarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007941 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is an infectious disease usually caused by Mycobacterium tuberculosis (MTB) bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tuberculosis</obo:IAO_0000119>
        <obo:OAE_0001849>骨结核病</obo:OAE_0001849>
        <obo:OAE_0004334>10056377</obo:OAE_0004334>
        <rdfs:label>bone tuberculosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007942 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a medical condition in which there is a partial or complete break in the continuity of a facial  bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bone_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>面部骨骼断裂</obo:OAE_0001849>
        <obo:OAE_0004334>10016042</obo:OAE_0004334>
        <rdfs:label>facial bones fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007943 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a subtype of the rhabdomyosarcoma soft tissue cancer family whose lineage is from mesenchymal cells and are related to skeletal muscle cells.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Alveolar_rhabdomyosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>腺泡状横纹肌肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10065867</obo:OAE_0004334>
        <rdfs:label>alveolar rhabdomyosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007944 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004225"/>
        <obo:IAO_0000115>This is an AE which is pain syndromes where excessive, acute and chronic pain are observed for which no overt primary cause can be found or surmised.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Amplified_musculoskeletal_pain_syndromes</obo:IAO_0000119>
        <obo:OAE_0001849>放大肌肉骨骼疼痛综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10082375</obo:OAE_0004334>
        <rdfs:label>amplified musculoskeletal pain syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007945 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a mass of muscle  cells (tumor) that lacks the ability to either invade neighboring tissue or metastasize (spread throughout the body).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Benign_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>良性肌肉肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10061692</obo:OAE_0004334>
        <rdfs:label>benign muscle neoplasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007946 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo:IAO_0000115>This is an AE which is the accumulation of calcium salts in a body  muscle tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Calcification</obo:IAO_0000119>
        <obo:OAE_0001849>肌肉钙化</obo:OAE_0001849>
        <obo:OAE_0004334>10049797</obo:OAE_0004334>
        <rdfs:label>calcification of muscle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007947 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a malignant (cancerous) smooth muscle tumor.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leiomyosarcoma</obo:IAO_0000119>
        <obo:OAE_0001849>平滑肌肉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10024189</obo:OAE_0004334>
        <rdfs:label>leiomyosarcoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007948 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by the inability to control facial movements (such as chewing and speaking) and caused by a variety of neurological disorders.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pseudobulbar_palsy</obo:IAO_0000119>
        <obo:OAE_0001849>假性球麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10037114</obo:OAE_0004334>
        <rdfs:label>pseudobulbar palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007949 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is a medical condition. It belongs to a group of disorders known as motor neuron diseases.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Progressive_bulbar_palsy</obo:IAO_0000119>
        <obo:OAE_0001849>进行性延髓麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10036800</obo:OAE_0004334>
        <rdfs:label>progressive bulbar palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007950 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which refers to a range of different signs and symptoms linked to impairment of function of the glossopharyngeal nerve (CN IX), the vagus nerve (CN X), the accessory nerve (CN XI), and the hypoglossal nerve (CN XII).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bulbar_palsy</obo:IAO_0000119>
        <obo:OAE_0001849>延髓性麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10006542</obo:OAE_0004334>
        <rdfs:label>bulbar palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007951 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <obo:IAO_0000115>This is an AE which is any mental disorder that manifests as physical symptoms that suggest illness or injury, but cannot be explained fully by a general medical condition or by the direct effect of a substance, and are not attributable to another mental disorder (e.g., panic disorder).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Somatic_symptom_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>躯体症状障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10078076</obo:OAE_0004334>
        <rdfs:label>somatic symptom disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007952 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is a form of inflammatory arthritis characterized by recurrent attacks of a red, tender, hot, and swollen joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Gout</obo:IAO_0000119>
        <obo:OAE_0001849>痛风性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10018634</obo:OAE_0004334>
        <rdfs:label>gouty arthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007953 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <obo:IAO_0000115>This is an AE which is a term often used to mean any disorder that affects joints caused by bacterial.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>细菌性关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10053555</obo:OAE_0004334>
        <rdfs:label>arthritis bacterial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007954 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002397"/>
        <obo:IAO_0000115>This is an AE which is a long-term inflammatory arthritis that occurs in people affected by the autoimmune disease psoriasis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psoriatic_arthritis</obo:IAO_0000119>
        <obo:OAE_0001849>银屑病关节病</obo:OAE_0001849>
        <obo:OAE_0004334>10037162</obo:OAE_0004334>
        <rdfs:label>psoriatic arthropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007955 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a chronic, autoinflammatory disease predominantly affecting the axial skeleton (sacroiliac joints and spine).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Axial_spondyloarthritis</obo:IAO_0000119>
        <obo:OAE_0001849>轴向脊椎关节炎</obo:OAE_0001849>
        <obo:OAE_0004334>10071400</obo:OAE_0004334>
        <rdfs:label>axial spondyloarthritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007956 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a major abnormality in the shape of elbow compared to the normal shape of that part.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Deformity</obo:IAO_0000119>
        <obo:OAE_0001849>肘关节畸形</obo:OAE_0001849>
        <obo:OAE_0004334>10061833</obo:OAE_0004334>
        <rdfs:label>elbow deformity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007957 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a complex, rare, and severe childhood-onset epilepsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lennox%E2%80%93Gastaut_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>伦诺克斯-胃肠综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10048816</obo:OAE_0004334>
        <rdfs:label>lennox-gastaut syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007958 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004374"/>
        <obo:IAO_0000115>This is an AE which is a paralytic illness that resembles poliomyelitis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31503131/</obo:IAO_0000119>
        <obo:OAE_0001849>急性哮喘后肌萎缩症</obo:OAE_0001849>
        <obo:OAE_0004334>10066224</obo:OAE_0004334>
        <rdfs:label>acute post asthmatic amyotrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007959 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a condition which is believed to result from compression of the sciatic nerve by the piriformis muscle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Piriformis_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>梨状肌综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10049433</obo:OAE_0004334>
        <rdfs:label>piriformis syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007960 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a benign smooth muscle tumor that very rarely becomes cancer (0.1%).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Leiomyoma</obo:IAO_0000119>
        <obo:OAE_0001849>平滑肌瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10024184</obo:OAE_0004334>
        <rdfs:label>leiomyoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007961 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003248"/>
        <obo:IAO_0000115>This is an AE which is a rare, but catastrophic mechanical complication of acute myocardial infarction (AMI).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/15362545/</obo:IAO_0000119>
        <obo:OAE_0001849>乳头状肌断裂</obo:OAE_0001849>
        <obo:OAE_0004334>10033698</obo:OAE_0004334>
        <rdfs:label>papillary muscle rupture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007962 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000405"/>
        <obo:IAO_0000115>This is an AE which is a crisis of a long-term neuromuscular disease that leads to varying degrees of skeletal muscle weakness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myasthenia_gravis</obo:IAO_0000119>
        <obo:OAE_0001849>重症肌无力危象</obo:OAE_0001849>
        <obo:OAE_0004334>10062758</obo:OAE_0004334>
        <rdfs:label>myasthenia gravis crisis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007963 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000038"/>
        <obo:IAO_0000115>This is an AE which occurs when blood flow decreases or stops to the coronary artery of the heart, causing damage to the heart muscle and it is silent.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myocardial_infarction</obo:IAO_0000119>
        <obo:OAE_0001849>无症状心肌梗塞</obo:OAE_0001849>
        <obo:OAE_0004334>10049768</obo:OAE_0004334>
        <rdfs:label>silent myocardial infarction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007964 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004354"/>
        <obo:IAO_0000115>This is an AE which is a form of focal dystonia affecting the mouth, jaw and tongue, and in this disease it is hard to speak.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oromandibular_dystonia</obo:IAO_0000119>
        <obo:OAE_0001849>下颌肌张力障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10067954</obo:OAE_0004334>
        <rdfs:label>oromandibular dystonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007965 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000525"/>
        <obo:IAO_0000115>This is an AE which is types of myopathies associated with mitochondrial disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Mitochondrial_myopathy</obo:IAO_0000119>
        <obo:OAE_0001849>线粒体肌病</obo:OAE_0001849>
        <obo:OAE_0004334>10027710</obo:OAE_0004334>
        <rdfs:label>mitochondrial myopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007966 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is an injury where one or more of the tendons or muscles of the rotator cuff of the shoulder get torn.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rotator_cuff_tear</obo:IAO_0000119>
        <obo:OAE_0001849>旋转肌综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10039227</obo:OAE_0004334>
        <rdfs:label>rotator cuff syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007967 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007967">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000405"/>
        <obo:IAO_0000115>This is an AE which is a long-term neuromuscular disease that leads to varying degrees of skeletal muscle weakness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Myasthenia_gravis</obo:IAO_0000119>
        <obo:OAE_0001849>重症肌无力</obo:OAE_0001849>
        <obo:OAE_0004334>10028417</obo:OAE_0004334>
        <rdfs:label>myasthenia gravis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007968 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the perichondrium, a layer of connective tissue which surrounds cartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Perichondritis</obo:IAO_0000119>
        <obo:OAE_0001849>软骨膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10062067</obo:OAE_0004334>
        <rdfs:label>perichondritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007969 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a medical condition caused by inflammation of the periosteum, a layer of connective tissue that surrounds bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Periostitis</obo:IAO_0000119>
        <obo:OAE_0001849>骨膜炎</obo:OAE_0001849>
        <obo:OAE_0004334>10034551</obo:OAE_0004334>
        <rdfs:label>periostitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007970 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000585"/>
        <obo:IAO_0000115>This is an AE which is a hereditary motor and sensory neuropathy of the peripheral nervous system characterized by progressive loss of muscle tissue and touch sensation across various parts of the body.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Charcot%E2%80%93Marie%E2%80%93Tooth_disease</obo:IAO_0000119>
        <obo:OAE_0001849>腓骨肌萎缩症</obo:OAE_0001849>
        <obo:OAE_0004334>10034699</obo:OAE_0004334>
        <rdfs:label>peroneal muscular atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007971 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000751"/>
        <obo:IAO_0000115>This is an AE which is a multi-systemic condition characterized by repeated episodes of inflammation and deterioration of cartilage.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Relapsing_polychondritis</obo:IAO_0000119>
        <obo:OAE_0001849>多软骨炎</obo:OAE_0001849>
        <obo:OAE_0004334>10065159</obo:OAE_0004334>
        <rdfs:label>polychondritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007972 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007972">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is the most forward-facing (ventral and anterior) of the three main bones making up the pelvis and feel it pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Pubis_(bone)</obo:IAO_0000119>
        <obo:OAE_0001849>耻骨痛</obo:OAE_0001849>
        <obo:OAE_0004334>10049747</obo:OAE_0004334>
        <rdfs:label>pubic pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007973 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is the ventral and anterior of the three parts forming the hip bone and has fracture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hip_bone#Pubis</obo:IAO_0000119>
        <obo:OAE_0001849>耻骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10070286</obo:OAE_0004334>
        <rdfs:label>pubis fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007974 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is one of the most commonly treated fractures in the United States. The highest rates are seen among the elderly, second only to hip fractures.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29499822/</obo:IAO_0000119>
        <obo:OAE_0001849>桡骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10037802</obo:OAE_0004334>
        <rdfs:label>radius fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007975 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007975">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a break in a rib bone.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rib_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>肋骨骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10039117</obo:OAE_0004334>
        <rdfs:label>rib fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007976 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001529"/>
        <obo:IAO_0000115>This is an AE which is different classification of osteoporosis: primary, in which bone loss is a result of aging and secondary, in which bone loss occurs from various clinical and lifestyle factors.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Senile_osteoporosis</obo:IAO_0000119>
        <obo:OAE_0001849>老年性骨质疏松症</obo:OAE_0001849>
        <obo:OAE_0004334>10039984</obo:OAE_0004334>
        <rdfs:label>senile osteoporosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007977 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <obo:IAO_0000115>This is an AE which is a general term for a disorder of the development (dysplasia) of bone (&quot;osteo&quot;) and cartilage (&quot;chondro&quot;).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Osteochondrodysplasia</obo:IAO_0000119>
        <obo:OAE_0001849>骨骼发育不良</obo:OAE_0001849>
        <obo:OAE_0004334>10072610</obo:OAE_0004334>
        <rdfs:label>skeletal dysplasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007978 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007978">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000956"/>
        <obo:IAO_0000115>This is an AE which is a fatigue-induced bone fracture caused by repeated stress over time.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stress_fracture</obo:IAO_0000119>
        <obo:OAE_0001849>应力性骨折</obo:OAE_0001849>
        <obo:OAE_0004334>10042212</obo:OAE_0004334>
        <rdfs:label>stress fracture AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0007979 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0007979">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo:IAO_0000115>This is an AE which is a region of the abdomen located below the umbilical region and feels pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hypogastrium</obo:IAO_0000119>
        <obo:OAE_0001849>耻骨上痛</obo:OAE_0001849>
        <obo:OAE_0004334>10050822</obo:OAE_0004334>
