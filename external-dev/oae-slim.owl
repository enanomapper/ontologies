        <rdfs:label>cleft lip and palate AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008051 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which is inflammation of one or both corners of the mouth.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Angular_cheilitis</obo:IAO_0000119>
        <obo:OAE_0001849>唇炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008418</obo:OAE_0004334>
        <rdfs:label>cheilosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008052 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <obo:IAO_0000115>This is an AE which is redness of the lip skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Erythema</obo:IAO_0000119>
        <obo:OAE_0001849>唇红斑</obo:OAE_0001849>
        <obo:OAE_0004334>10080124</obo:OAE_0004334>
        <rdfs:label>lip erythema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008053 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001399"/>
        <obo:IAO_0000115>This is an AE which is a group of conditions that includes cleft lip, cleft palate, and both together.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cleft_lip_and_cleft_palate</obo:IAO_0000119>
        <obo:OAE_0001849>唇裂</obo:OAE_0001849>
        <obo:OAE_0004334>10009259</obo:OAE_0004334>
        <rdfs:label>cleft lip AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008054 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <obo:IAO_0000115>This is an AE which is a sensation that causes the desire or reflex to scratch lip.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Itch</obo:IAO_0000119>
        <obo:OAE_0001849>唇瘙痒</obo:OAE_0001849>
        <obo:OAE_0004334>10070721</obo:OAE_0004334>
        <rdfs:label>lip pruritus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008055 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>This is an AE which is the build-up of fluid in the body&apos;s tissue such as lip oedema.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Edema</obo:IAO_0000119>
        <obo:OAE_0001849>唇水肿</obo:OAE_0001849>
        <obo:OAE_0004334>10024558</obo:OAE_0004334>
        <rdfs:label>lip edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008056 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of lip blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>唇血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10066304</obo:OAE_0004334>
        <rdfs:label>lip hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008057 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000805"/>
        <obo:IAO_0000115>This is an AE which is a medical condition characterized by inflammation of the lips.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cheilitis</obo:IAO_0000119>
        <obo:OAE_0001849>唇炎</obo:OAE_0001849>
        <obo:OAE_0004334>10008417</obo:OAE_0004334>
        <rdfs:label>cheilitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008058 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is the roof of the mouth in humans  and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palate</obo:IAO_0000119>
