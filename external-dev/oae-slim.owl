        <rdfs:label>coeliac artery compression syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004603 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <obo:IAO_0000115>This is an AE which is an abnormal narrowing in a blood vessel or other tubular organ or structure such as foramina and canals occured on coeliac artery  .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Stenosis</obo:IAO_0000119>
        <obo:OAE_0001849>腹腔动脉狭窄</obo:OAE_0001849>
        <obo:OAE_0004334>10067325</obo:OAE_0004334>
        <rdfs:label>coeliac artery stenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004604 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <obo:IAO_0000115>This is an AE which is a protrusion of abdominal-cavity contents through the inguinal canal and it is congenital.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Inguinal_hernia</obo:IAO_0000119>
