        <obo:OAE_0004334>10073169</obo:OAE_0004334>
        <rdfs:label>diastasis recti abdominis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004607 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003315"/>
        <obo:IAO_0000115>This is an AE which is inflammation of the focal peritoneum, the lining of the inner wall of the abdomen and cover of the abdominal organs.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peritonitis</obo:IAO_0000119>
