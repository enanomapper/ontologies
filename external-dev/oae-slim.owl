    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002360 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001893"/>
        <obo:IAO_0000115>Brain damage AE that results in a persistent vegetative state</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.rightdiagnosis.com/a/apallic_syndrome/intro.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10002941</obo:OAE_0004334>
        <rdfs:label xml:lang="en">apallic syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002361 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <obo:IAO_0000115>APGAR is a quick test performed on a neonate at 1 and 5 minutes after birth. The 1-minute score determines how well the baby tolerated the birthing process. The 5-minute score tells the doctor how well the baby is doing outside the mother&apos;s womb. Any score lower than 7 is a sign that the baby needs medical attention. The lower the score, the more help the baby needs to adjusting outside the mother&apos;s womb</obo:IAO_0000115>
        <obo:IAO_0000117>YH, SJ </obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003402.htm</obo:IAO_0000119>
        <obo:OAE_0004334>10002944</obo:OAE_0004334>
        <obo:OAE_0004334>10062552</obo:OAE_0004334>
        <rdfs:label xml:lang="en">APGAR score low AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002362 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <obo:IAO_0000115>a brain disorder AE  that causes a person to lose the ability to communicate. Aphasia can affect the ability to express and understand language, both verbal and written. Aphasia typically occurs suddenly after a stroke or a head injury, but it can also come on gradually from a slowly growing brain tumor or a degenerative disease</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/aphasia/basics/definition/con-20027061</obo:IAO_0000119>
        <obo:OAE_0004334>10002948</obo:OAE_0004334>
        <rdfs:label xml:lang="en">aphasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002363 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>a tumor AE that results in pouches of cerebrospinal fluid covered by arachnoidal cells and collagen that may develop between the surface of the brain and the cranial base or on the arachnoid membrane</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB:http://en.wikipedia.org/wiki/Arachnoid_cyst</obo:IAO_0000119>
        <obo:OAE_0004334>10049005</obo:OAE_0004334>
        <rdfs:label xml:lang="en">arachnoid cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002364 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <obo:IAO_0000115>a brain disorder AE  that causes inflammation of the arachnoid, one of the membranes known as meninges that surround and protect the nerves of the central nervous system, including the brain and spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH, MW</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Arachnoiditis</obo:IAO_0000119>
        <obo:OAE_0004334>10003074</obo:OAE_0004334>
        <rdfs:label xml:lang="en">arachnoiditis AE</rdfs:label>
        <rdfs:seeAlso>CTCAE:E12591</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt:C37913</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002365 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <obo:IAO_0000115>A pregnancy AE that results in an interruption in the labor process that is associated with uterine contractions.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/arrested+labor</obo:IAO_0000119>
        <obo:OAE_0004334>10003118</obo:OAE_0004334>
        <rdfs:label xml:lang="en">arrested labor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002366 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <obo:IAO_0000115>an arrhythmia AE that is characterized by shortness of breath, heart palpitations, chest tightness, and a very fast pulse. Supraventricular arrhythmias begin in the areas above the heart’s lower chambers, such as the upper chambers (the atria) or the atrial conduction pathways.</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000118>atrial arrhythmia</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://www.texasheart.org/HIC/Topics/cond/arrhycat.cfm</obo:IAO_0000119>
        <obo:OAE_0004334>10003130</obo:OAE_0004334>
        <rdfs:label xml:lang="en">supraventricular arrhythmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002367 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <obo:IAO_0000115>a cardiac disorder AE which causes a spasm of the large- or medium-sized coronary arteries</obo:IAO_0000115>
        <obo:IAO_0000117>SJ, YH</obo:IAO_0000117>
        <obo:IAO_0000118>coronary artery spasm</obo:IAO_0000118>
        <obo:IAO_0000118>coronary artery vasospasm</obo:IAO_0000118>
        <obo:IAO_0000118>coronary vasospasm</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://sideeffects.embl.de/se/C0010073/pt</obo:IAO_0000119>
        <obo:OAE_0004334>10003225</obo:OAE_0004334>
