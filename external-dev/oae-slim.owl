        <rdfs:label>Grade 1 weight loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12229</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003550 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000541"/>
        <obo:IAO_0000115>a weight loss AE that is 10 - less than 20% from baseline; nutritional support indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 2 weight loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12230</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0003551 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0003551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000541"/>
        <obo:IAO_0000115>a weight loss AE that is greater than or equal to 20% from baseline; tube feeding or TPN indicated</obo:IAO_0000115>
        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 weight loss AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E12231</rdfs:seeAlso>
