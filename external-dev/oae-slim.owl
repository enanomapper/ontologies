    <!-- http://purl.obolibrary.org/obo/OAE_0000681 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <obo:IAO_0000115>periorbial edema AE is an edema AE that has an outcome of swelling around the eye.</obo:IAO_0000115>
        <obo:IAO_0000116>MedDRA: 10034545 is for &quot;periorbital edema&quot;; MedDRA: 10054541 is for &quot;periorbital oedema&quot;</obo:IAO_0000116>
        <obo:IAO_0000117>SS, YH</obo:IAO_0000117>
        <obo:IAO_0000118>periorbital oedema AE</obo:IAO_0000118>
        <obo:IAO_0000118>periorbital puffiness</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Periorbital_puffiness</obo:IAO_0000119>
        <rdfs:comment>Periorbital puffiness, also known as &quot;puffy eyes&quot; or swelling around the eyes, refers to the appearance of swelling in the tissues around the eyes, called the orbits.</rdfs:comment>
        <rdfs:label>periorbital edema AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13676</rdfs:seeAlso>
