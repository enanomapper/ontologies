        <obo:IAO_0000117>MW, YH</obo:IAO_0000117>
        <rdfs:label>Grade 3 febrile neutropenia AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E10034</rdfs:seeAlso>
