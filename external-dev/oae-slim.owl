        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002038"/>
        <obo:IAO_0000115>This is an AE which is a clinical sign in which there is pain upon removal of pressure rather than application of pressure to the abdomen.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Blumberg_sign</obo:IAO_0000119>
        <obo:OAE_0001849>腹部反弹压痛</obo:OAE_0001849>
        <obo:OAE_0004334>10052489</obo:OAE_0004334>
        <rdfs:label>abdominal rebound tenderness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004589 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002063"/>
        <obo:IAO_0000115>This is an AE which is the tensing of the abdominal wall muscles to guard inflamed organs within the abdomen from the pain of pressure upon them.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Abdominal_guarding</obo:IAO_0000119>
        <obo:OAE_0001849>腹部僵硬</obo:OAE_0001849>
        <obo:OAE_0004334>10000090</obo:OAE_0004334>
        <rdfs:label>abdominal rigidity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004590 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <obo:IAO_0000115>This is an AE which is the observed or detectable abdominal signs, and experienced symptoms of an illness, injury, or condition .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Signs_and_symptoms</obo:IAO_0000119>
