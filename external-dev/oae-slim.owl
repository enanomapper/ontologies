        <rdfs:label>mesenteritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005603 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <obo:IAO_0000115>This is an AE which is an autoimmune disease of the liver.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Primary_biliary_cholangitis</obo:IAO_0000119>
        <obo:OAE_0001849>胆汁性肝硬化</obo:OAE_0001849>
        <obo:OAE_0004334>10004659</obo:OAE_0004334>
        <rdfs:label>biliary cirrhosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005604 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000825"/>
        <obo:IAO_0000115>This is an AE which is an inflammation of the colon and is autoimmune.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Colitis</obo:IAO_0000119>
        <obo:OAE_0001849>自身免疫性结肠炎</obo:OAE_0001849>
        <obo:OAE_0004334>10075761</obo:OAE_0004334>
        <rdfs:label>autoimmune colitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005605 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <obo:IAO_0000115>This is an AE which is an outward bulging on the mesenteric artery wall, likened to a bubble or balloon, caused by a localized, abnormal, weak spot on a blood vessel wall.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Aneurysm</obo:IAO_0000119>
        <obo:OAE_0001849>肠系膜动脉动脉瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10079556</obo:OAE_0004334>
        <rdfs:label>mesenteric artery aneurysm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0005606 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <obo:IAO_0000115>This is an AE which is an unfavorable result of a disease, health condition, or treatment on the urinary tract .</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Complication_(medicine)</obo:IAO_0000119>
        <obo:OAE_0001849>泌尿道手术并发症</obo:OAE_0001849>
        <obo:OAE_0004334>10081331</obo:OAE_0004334>
