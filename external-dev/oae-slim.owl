    <!-- http://purl.obolibrary.org/obo/OAE_0005614 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <obo:IAO_0000115>This is an AE which is the final act of digestion become disorder, by which organisms eliminate a solid, semisolid, or liquid waste material known as feces from the digestive tract via the anus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Defecation</obo:IAO_0000119>
