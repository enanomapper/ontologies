        <rdfs:label>mucosal excoriation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008965 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <obo:IAO_0000115>This is an AE which is a change of the incision site skin which affects its color, appearance, or texture.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Rash</obo:IAO_0000119>
        <obo:OAE_0001849>切口部位皮疹</obo:OAE_0001849>
        <obo:OAE_0004334>10073411</obo:OAE_0004334>
        <rdfs:label>incision site rash AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008966 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is an immune disorder of T cells, it is characterized by chronic infections with Candida that are limited to mucosal surfaces, skin, and nails.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Chronic_mucocutaneous_candidiasis</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜与皮肤的念珠菌病</obo:OAE_0001849>
        <obo:OAE_0004334>10028080</obo:OAE_0004334>
        <rdfs:label>mucocutaneous candidiasis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008967 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008967">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is blood escaping from the circulatory system from damaged mucocutaneous blood vessels.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Bleeding</obo:IAO_0000119>
        <obo:OAE_0001849>黏膜与皮肤的出血</obo:OAE_0001849>
