        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Thyroid_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>甲状腺癌</obo:OAE_0001849>
        <obo:OAE_0004334>10043738</obo:OAE_0004334>
