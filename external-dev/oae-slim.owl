    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008573 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <obo:IAO_0000115>This is an AE which is a person&apos;s overall sexual drive or desire for sexual activity that is became disorder.</obo:IAO_0000115>
