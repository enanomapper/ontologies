        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000117>a bacteraemia AE that is more specifically associated with a Gram-negative bacterium.</obo:IAO_0000117>
        <obo:OAE_0004334>10054228</obo:OAE_0004334>
        <rdfs:label xml:lang="en">Gram-negative bacteremia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001805 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>a hemorrhage AE that has an outcome of massive amounts of blood loss. A typical Intraoperative hemorrhage has a blood loss exceeding 1000 mL or requires a blood transfusion</obo:IAO_0000115>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.uptodate.com/contents/management-of-hemorrhage-in-gynecologic-surgery</obo:IAO_0000119>
        <obo:OAE_0004334>10055298</obo:OAE_0004334>
        <rdfs:label>Intraoperative hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11810</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C35135</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001806 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <obo:IAO_0000115>an abscess AE that shows a cavity of pus within the pancreas</obo:IAO_0000115>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000270.htm </obo:IAO_0000119>
        <obo:OAE_0004334>10048984</obo:OAE_0004334>
        <rdfs:label>pancreatic abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001807 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>a sugery AE that has an adverse outcome where the recipient’s body rejects the pancreas transplantation.</obo:IAO_0000115>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medscape.com/viewarticle/436542_13 </obo:IAO_0000119>
        <obo:OAE_0004334>10049169</obo:OAE_0004334>
        <rdfs:label>pancreas transplant rejection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001808 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo:IAO_0000115>an infection AE that has an outcome of a severe local inflammation, usually with pus formation, generally caused by one of the pyogenic bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>Yongqun He, Izabela Birsanescu</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=44396 </obo:IAO_0000119>
        <obo:OAE_0004334>10021861</obo:OAE_0004334>
        <rdfs:label>pyogenic infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001809 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001809">
