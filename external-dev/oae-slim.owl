        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <obo:IAO_0000115>This is an AE which may be an aetiological factor in the development of urinary incontinence in women.</obo:IAO_0000115>
