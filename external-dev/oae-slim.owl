    <!-- http://purl.obolibrary.org/obo/OAE_0005190 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0005190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001792"/>
        <obo:IAO_0000115>This is an AE which is part of the natural history of some forms of ischaemic infarction, especially cerebral embolism, but it can be precipitated or enhanced by therapeutic interventions used in the acute phase of ischaemic stroke.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
