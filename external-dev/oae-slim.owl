    <!-- http://purl.obolibrary.org/obo/OAE_0002359 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <obo:IAO_0000115>a hemorrhage AE that has an outcome of  bleeding from or in to the genital tract, occurring from 24 weeks of pregnancy and prior to the birth of the baby.</obo:IAO_0000115>
        <obo:IAO_0000117>YH, SJ</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: https://www.rcog.org.uk/globalassets/documents/guidelines/gtg63_05122011aph.pdf</obo:IAO_0000119>
        <obo:OAE_0004334>10055228</obo:OAE_0004334>
