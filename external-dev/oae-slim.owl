        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23714577/</obo:IAO_0000119>
        <obo:OAE_0001849>新生儿呼吸暂停</obo:OAE_0001849>
        <obo:OAE_0004334>10002976</obo:OAE_0004334>
