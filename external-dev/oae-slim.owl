    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008489 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is a cancer that arises from the endometrium (the lining of the uterus or womb).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endometrial_cancer</obo:IAO_0000119>
        <obo:OAE_0001849>子宫内膜癌</obo:OAE_0001849>
        <obo:OAE_0004334>10014733</obo:OAE_0004334>
        <rdfs:label>endometrial cancer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0008490 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0008490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004304"/>
        <obo:IAO_0000115>This is an AE which is the inner epithelial layer, along with its mucous membrane, of the mammalian uterus and its function becomes disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Endometrium</obo:IAO_0000119>
