    <!-- http://purl.obolibrary.org/obo/OAE_0004646 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002713"/>
        <obo:IAO_0000115>This is an AE which is a condition typified by a weakness of voluntary movement, or by partial loss of voluntary movement or by impaired movement and its occurs on IVth nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresis</obo:IAO_0000119>
        <obo:OAE_0001849>ivth神经麻痹性痴呆</obo:OAE_0001849>
        <obo:OAE_0004334>10054201</obo:OAE_0004334>
        <rdfs:label>ivth nerve paresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004647 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which refers to long thoracic nerve of paralysis, often accompanied by weakness and the loss of feeling and uncontrolled body movements such as shaking.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palsy</obo:IAO_0000119>
        <obo:OAE_0001849>胸长神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10067925</obo:OAE_0004334>
        <rdfs:label>long thoracic nerve palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004648 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is paralysis caused by illness or injury that results in the partial or total loss of use of all four limbs and torso; paraplegia is similar but does not affect the arms.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Tetraplegia</obo:IAO_0000119>
        <obo:OAE_0001849>颈脊髓麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10057276</obo:OAE_0004334>
        <rdfs:label>cervical spinal cord paralysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004649 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004649">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>This is an AE which is a localized bleeding outside of blood vessels, due to either disease or trauma including injury or surgery and may involve blood continuing to seep from broken capillaries and it is spontaneous.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hematoma</obo:IAO_0000119>
        <obo:OAE_0001849>自发性血肿</obo:OAE_0001849>
        <obo:OAE_0004334>10065304</obo:OAE_0004334>
        <rdfs:label>spontaneous hematoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004650 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004650">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <obo:IAO_0000115>This is an AE which is a symptom related to a spectrum of disorders characterized by unintentional and purposeless motions and restlessness, often but not always accompanied by emotional distress.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Psychomotor_agitation</obo:IAO_0000119>
        <obo:OAE_0001849>精神运动过度活跃</obo:OAE_0001849>
        <obo:OAE_0004334>10037211</obo:OAE_0004334>
        <rdfs:label>psychomotor hyperactivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004651 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is any deliberate interruption of signals traveling along a nerve, often for the purpose of pain relief.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nerve_block</obo:IAO_0000119>
        <obo:OAE_0001849>神经阻滞</obo:OAE_0001849>
        <obo:OAE_0004334>10029173</obo:OAE_0004334>
        <rdfs:label>nerve block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004652 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is deterioration in the medical sense and it is the change from a higher to a lower form nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Degeneration_(medical)</obo:IAO_0000119>
        <obo:OAE_0001849>神经变性</obo:OAE_0001849>
        <obo:OAE_0004334>10056677</obo:OAE_0004334>
        <rdfs:label>nerve degeneration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004653 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is injury to nervous tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nerve_injury</obo:IAO_0000119>
        <obo:OAE_0001849>神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10052897</obo:OAE_0004334>
        <rdfs:label>nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004654 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001212"/>
        <obo:IAO_0000115>This is an AE which will produce functional disability.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28453446/</obo:IAO_0000119>
        <obo:OAE_0001849>神经根损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10061310</obo:OAE_0004334>
        <rdfs:label>nerve root injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004655 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001212"/>
        <obo:IAO_0000115>This is an AE which is a disease of the cervical spine and a space-occupying lesion that occurs because of pathological problems with cervical nerve roots.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28453446/</obo:IAO_0000119>
        <obo:OAE_0001849>颈神经根损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10029183</obo:OAE_0004334>
        <rdfs:label>nerve root injury cervical AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004656 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which refers to a small class of medical conditions affecting the nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nervous_system_disease</obo:IAO_0000119>
        <obo:OAE_0001849>神经系统紊乱</obo:OAE_0001849>
        <obo:OAE_0004334>10029202</obo:OAE_0004334>
        <rdfs:label>nervous system disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004657 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is injury to nervous tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Nerve_injury</obo:IAO_0000119>
        <obo:OAE_0001849>神经系统损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10080898</obo:OAE_0004334>
        <rdfs:label>nervous system injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004658 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004658">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000636"/>
        <obo:IAO_0000115>This is an AE which are a group of birth defects in which an opening in the spine or cranium remains from early in human development.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neural_tube_defect</obo:IAO_0000119>
        <obo:OAE_0001849>神经管缺陷</obo:OAE_0001849>
        <obo:OAE_0004334>10052046</obo:OAE_0004334>
        <rdfs:label>neural tube defect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004659 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a syndrome of unknown cause; although many specific risk factors have been identified (such as; post-operatively, post-infectious, post-traumatic or post-vaccination), the cause is still unknown.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Parsonage%E2%80%93Turner_syndrome</obo:IAO_0000119>
        <obo:OAE_0001849>神经性肌萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10029229</obo:OAE_0004334>
        <rdfs:label>neuralgic amyotrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004660 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a usually benign nerve sheath tumor composed of Schwann cells, which normally produce the insulating myelin sheath covering peripheral nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schwannoma</obo:IAO_0000119>
        <obo:OAE_0001849>神经膜瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029234</obo:OAE_0004334>
        <rdfs:label>neurilemmoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004661 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000079"/>
        <obo:IAO_0000115>This is an AE which is a usually benign nerve sheath tumor composed of Schwann cells, which normally produce the insulating myelin sheath covering peripheral nerves.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Schwannoma</obo:IAO_0000119>
        <obo:OAE_0001849>良性神经膜瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029235</obo:OAE_0004334>
        <rdfs:label>neurilemmoma benign AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004662 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000625"/>
        <obo:IAO_0000115>This is an AE which is inflammation of a  cranial nerveor the general inflammation of the peripheral nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuritis</obo:IAO_0000119>
        <obo:OAE_0001849>神经炎颅</obo:OAE_0001849>
        <obo:OAE_0004334>10029244</obo:OAE_0004334>
        <rdfs:label>neuritis cranial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004663 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001205"/>
        <obo:IAO_0000115>This is an AE which is a type of cancer that forms in certain types of nerve tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuroblastoma</obo:IAO_0000119>
        <obo:OAE_0001849>神经母细胞瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029260</obo:OAE_0004334>
        <rdfs:label>neuroblastoma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004664 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the progressive loss of structure or function of neurons, which may ultimately involve cell death.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurodegeneration</obo:IAO_0000119>
        <obo:OAE_0001849>神经退行性疾病</obo:OAE_0001849>
        <obo:OAE_0004334>10053643</obo:OAE_0004334>
        <rdfs:label>neurodegenerative disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004665 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <obo:IAO_0000115>This is an AE which is a skin disorder characterized by chronic itching and scratching.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lichen_simplex_chronicus</obo:IAO_0000119>
        <obo:OAE_0001849>神经性皮炎</obo:OAE_0001849>
        <obo:OAE_0004334>10029263</obo:OAE_0004334>
        <rdfs:label>neurodermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004666 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a group of disorders that affect the development of the nervous system, leading to abnormal brain function which may affect emotion, learning ability, self-control, and memory.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurodevelopmental_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>神经发育障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10064062</obo:OAE_0004334>
        <rdfs:label>neuro developmental disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004667 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which are neoplasms that arise from cells of the endocrine (hormonal) and nervous systems.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuroendocrine_tumor</obo:IAO_0000119>
        <obo:OAE_0001849>神经内分泌肿瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10052399</obo:OAE_0004334>
        <rdfs:label>neuroendocrine tumor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004668 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a benign nerve-sheath tumor in the peripheral nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurofibroma</obo:IAO_0000119>
        <obo:OAE_0001849>神经纤维瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10029267</obo:OAE_0004334>
        <rdfs:label>neurofibroma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004669 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a group of three conditions in which tumors grow in the nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurofibromatosis</obo:IAO_0000119>
        <obo:OAE_0001849>神经纤维瘤病</obo:OAE_0001849>
        <obo:OAE_0004334>10029268</obo:OAE_0004334>
        <rdfs:label>neurofibromatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004670 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the inability to control defecation due to a deterioration of or injury to the nervous system, resulting in faecal incontinence or constipation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurogenic_bowel_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>神经源性肠</obo:OAE_0001849>
        <obo:OAE_0004334>10048657</obo:OAE_0004334>
        <rdfs:label>neurogenic bowel AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004671 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a distributive type of shock resulting in hypotension (low blood pressure), often with bradycardia (slowed heart rate), caused by disruption of autonomic nervous system pathways.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurogenic_shock</obo:IAO_0000119>
        <obo:OAE_0001849>神经源性休克</obo:OAE_0001849>
        <obo:OAE_0004334>10058119</obo:OAE_0004334>
        <rdfs:label>neurogenic shock AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004672 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is a neuropsychological condition in which, after damage to one hemisphere of the brain is sustained, a deficit in attention to and awareness of one side of the field of vision is observed.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hemispatial_neglect</obo:IAO_0000119>
        <obo:OAE_0001849>神经系统忽视综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10029289</obo:OAE_0004334>
        <rdfs:label>neurologic neglect syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004673 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004673">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which is any mental neurologic  disorder that manifests as physical symptoms that suggest illness or injury, but cannot be explained fully by a general medical condition or by the direct effect of a substance, and are not attributable to another mental disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Somatic_symptom_disorder</obo:IAO_0000119>
        <obo:OAE_0001849>神经躯体症状障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10078080</obo:OAE_0004334>
        <rdfs:label>neurologic somatic symptom disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004674 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <obo:IAO_0000115>This is an AE which is a drooping or falling of the upper eyelid caused by neurological disorder.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Ptosis_(eyelid)</obo:IAO_0000119>
        <obo:OAE_0001849>眼睑神经障碍</obo:OAE_0001849>
        <obo:OAE_0004334>10061312</obo:OAE_0004334>
        <rdfs:label>neurological eyelid disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004675 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000839"/>
        <obo:IAO_0000115>This is an AE which block neuromuscular transmission at the neuromuscular junction, causing paralysis of the affected skeletal muscles.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuromuscular-blocking_drug</obo:IAO_0000119>
        <obo:OAE_0001849>神经肌肉阻滞</obo:OAE_0001849>
        <obo:OAE_0004334>10029315</obo:OAE_0004334>
        <rdfs:label>neuromuscular blockade AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004676 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000383"/>
        <obo:IAO_0000115>This is an AE which ailments that impair the functioning of the muscles, either directly, being pathologies of the voluntary muscle, or indirectly, being pathologies of nerves or neuromuscular junctions and it will cause pain.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuromuscular_disease</obo:IAO_0000119>
        <obo:OAE_0001849>神经肌肉疼痛</obo:OAE_0001849>
        <obo:OAE_0004334>10074313</obo:OAE_0004334>
        <rdfs:label>neuromuscular pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004677 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001215"/>
        <obo:IAO_0000115>This is an AE which is the degree to which a chemical substance or a particular mixture of substances can damage neuromuscular.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Toxicity</obo:IAO_0000119>
        <obo:OAE_0001849>神经肌肉毒性</obo:OAE_0001849>
        <obo:OAE_0004334>10062284</obo:OAE_0004334>
        <rdfs:label>neuromuscular toxicity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004678 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>This is an AE which is a form of peripheral nerve hyperexcitability that causes spontaneous muscular activity resulting from repetitive motor unit action potentials of peripheral origin.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuromyotonia</obo:IAO_0000119>
        <obo:OAE_0001849>神经性肌强直</obo:OAE_0001849>
        <obo:OAE_0004334>10072359</obo:OAE_0004334>
        <rdfs:label>neuromyotonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004679 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000585"/>
        <obo:IAO_0000115>This is an AE which refers to progressive degeneration of a weight-bearing joint and musclar , a process marked by bony destruction, bone resorption, and eventual deformity due to loss of sensation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuropathic_arthropathy</obo:IAO_0000119>
        <obo:OAE_0001849>神经性肌肉萎缩</obo:OAE_0001849>
        <obo:OAE_0004334>10075469</obo:OAE_0004334>
        <rdfs:label>neuropathic muscular atrophy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004680 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <obo:IAO_0000115>This is an AE which is a general term describing disease affecting the peripheral nerves, meaning nerves beyond the brain and spinal cord.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peripheral_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>周围神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10029331</obo:OAE_0004334>
        <rdfs:label>neuropathy peripheral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004681 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000509"/>
        <obo:IAO_0000115>This is an AE which refers to the neurological and psychiatric manifestations of systemic lupus erythematosus.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuropsychiatric_systemic_lupus_erythematosus</obo:IAO_0000119>
        <obo:OAE_0001849>神经精神狼疮</obo:OAE_0001849>
        <obo:OAE_0004334>10063663</obo:OAE_0004334>
        <rdfs:label>neuropsychiatric lupus AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004682 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which are the observed or detectable signs, and experienced symptoms of an illness, injury, or condition.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Signs_and_symptoms#Neuropsychiatric</obo:IAO_0000119>
        <obo:OAE_0001849>神经精神症状</obo:OAE_0001849>
        <obo:OAE_0004334>10078497</obo:OAE_0004334>
        <rdfs:label>neuropsychiatric symptoms AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004683 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002627"/>
        <obo:IAO_0000115>This is an AE which refers to a type of sarcoidosis, a condition of unknown cause featuring granulomas in various tissues, in this type involving the central nervous system (brain and spinal cord).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurosarcoidosis</obo:IAO_0000119>
        <obo:OAE_0001849>神经类肉瘤病</obo:OAE_0001849>
        <obo:OAE_0004334>10078011</obo:OAE_0004334>
        <rdfs:label>neurosarcoidosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004684 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002129"/>
        <obo:IAO_0000115>This is an AE which is a partial or total inability to hear caused by neurosensory.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Hearing_loss</obo:IAO_0000119>
        <obo:OAE_0001849>感觉神经的听觉迟钝</obo:OAE_0001849>
        <obo:OAE_0004334>10067587</obo:OAE_0004334>
        <rdfs:label>neurosensory hypoacusis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004685 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004685">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a class of functional mental disorders involving chronic distress, but neither delusions nor hallucinations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurosis</obo:IAO_0000119>
        <obo:OAE_0001849>神经衰弱症</obo:OAE_0001849>
        <obo:OAE_0004334>10029333</obo:OAE_0004334>
        <rdfs:label>neurosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004686 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000797"/>
        <obo:IAO_0000115>This is an AE which refers to infection of the central nervous system in a patient with syphilis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurosyphilis</obo:IAO_0000119>
        <obo:OAE_0001849>神经性梅毒</obo:OAE_0001849>
        <obo:OAE_0004334>10029339</obo:OAE_0004334>
        <rdfs:label>neurosyphilis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004687 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001215"/>
        <obo:IAO_0000115>This is an AE which is a form of toxicity in which a biological, chemical, or physical agent produces an adverse effect on the structure or function of the central and/or peripheral nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurotoxicity</obo:IAO_0000119>
        <obo:OAE_0001849>神经毒性</obo:OAE_0001849>
        <obo:OAE_0004334>10029350</obo:OAE_0004334>
        <rdfs:label>neurotoxicity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004688 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0003492"/>
        <obo:IAO_0000115>This is an AE which refers to a condition where corneal epitheliopathy leading to frank epithelial defect with or without stromal ulceration (melting) is associated with reduced or absent corneal sensations.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29698813/</obo:IAO_0000119>
        <obo:OAE_0001849>向神经角膜病</obo:OAE_0001849>
        <obo:OAE_0004334>10069732</obo:OAE_0004334>
        <rdfs:label>neurotrophic keratopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004689 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000514"/>
        <obo:IAO_0000115>This is an AE which is a painful condition affecting the posterior head in the distributions of the greater occipital nerve (GON), lesser occipital nerve (LON), third occipital nerve (TON), or a combination of the three.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Occipital_neuralgia</obo:IAO_0000119>
        <obo:OAE_0001849>枕神经痛</obo:OAE_0001849>
        <obo:OAE_0004334>10068106</obo:OAE_0004334>
        <rdfs:label>occipital neuralgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004690 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004690">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000226"/>
        <obo:IAO_0000115>This is an AE which is the name of a dystonic reaction to certain drugs or medical conditions characterized by a prolonged involuntary upward deviation of the eyes.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oculogyric_crisis</obo:IAO_0000119>
        <obo:OAE_0001849>动眼神经危象</obo:OAE_0001849>
        <obo:OAE_0004334>10030071</obo:OAE_0004334>
        <rdfs:label>oculogyric crisis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004691 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which is a type of glioma that are believed to originate from the oligodendrocytes of the brain or from a glial precursor cell.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Oligodendroglioma</obo:IAO_0000119>
        <obo:OAE_0001849>少突神经胶质瘤</obo:OAE_0001849>
        <obo:OAE_0004334>10030286</obo:OAE_0004334>
        <rdfs:label>oligodendroglioma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004692 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004692">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>This is an AE which is associated with typical vascular risk factors and with one systemic disease in particular: giant cell arteritis (GCA).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31584535/</obo:IAO_0000119>
        <obo:OAE_0001849>光学缺血性神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10030924</obo:OAE_0004334>
        <rdfs:label>optic ischemic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004693 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <obo:IAO_0000115>This is an AE which can be defined as remote effects of cancer that are not caused by the tumor and its metastasis, or by infection, ischemia or metabolic disruptions.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17480225/</obo:IAO_0000119>
        <obo:OAE_0001849>多种神经综合症</obo:OAE_0001849>
        <obo:OAE_0004334>10072106</obo:OAE_0004334>
        <rdfs:label>paraneoplastic neurological syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004694 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which  resulting from a lesion involving the cisternal portion of the nerve prior to its anatomical bifurcation.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/16682550/</obo:IAO_0000119>
        <obo:OAE_0001849>麻痹性痴呆脑神经</obo:OAE_0001849>
        <obo:OAE_0004334>10061911</obo:OAE_0004334>
        <rdfs:label>paresis cranial nerve AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004695 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a syndrome that causes episodes of increased activity of the sympathetic nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paroxysmal_sympathetic_hyperactivity</obo:IAO_0000119>
        <obo:OAE_0001849>阵发性交感神经过度活跃</obo:OAE_0001849>
        <obo:OAE_0004334>10078476</obo:OAE_0004334>
        <rdfs:label>paroxysmal sympathetic hyperactivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004696 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004696">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000168"/>
        <obo:IAO_0000115>This is an AE which is a progressively worsening condition where muscles in the extremities gradually weaken.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Multifocal_motor_neuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>多病灶的运动神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10065579</obo:OAE_0004334>
        <rdfs:label>multifocal motor neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004697 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a closed sac, having a distinct envelope and division compared with the nearby perineurial tissue.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Cyst</obo:IAO_0000119>
        <obo:OAE_0001849>神经束膜囊肿</obo:OAE_0001849>
        <obo:OAE_0004334>10051766</obo:OAE_0004334>
        <rdfs:label>perineurial cyst AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004698 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004698">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is a medical condition caused by dissolved gases emerging from solution as bubbles inside the peripheral nerve tissues during decompression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Decompression_sickness</obo:IAO_0000119>
        <obo:OAE_0001849>周围神经减压</obo:OAE_0001849>
        <obo:OAE_0004334>10057610</obo:OAE_0004334>
        <rdfs:label>peripheral nerve decompression AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004699 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which refers to damage to peripheral nerve beyond the capability to repair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Destruction</obo:IAO_0000119>
        <obo:OAE_0001849>周围神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10034584</obo:OAE_0004334>
        <rdfs:label>peripheral nerve destruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004700 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004700">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which resulting from trauma can be severe and permanently debilitating.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30187777/</obo:IAO_0000119>
        <obo:OAE_0001849>周围神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10034586</obo:OAE_0004334>
        <rdfs:label>peripheral nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004701 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is any damage or abnormal change in the tissue of an peripheral nerve , usually caused by disease or trauma.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Lesion</obo:IAO_0000119>
        <obo:OAE_0001849>周围神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10067633</obo:OAE_0004334>
        <rdfs:label>peripheral nerve lesion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004702 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004702">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is the purposeful modulation of the nervous system&apos;s activity using invasive or non-invasive means on the peripheral nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neurostimulation</obo:IAO_0000119>
        <obo:OAE_0001849>周围神经神经刺激</obo:OAE_0001849>
        <obo:OAE_0004334>10034587</obo:OAE_0004334>
        <rdfs:label>peripheral nerve neurostimulation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004703 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is a paralysis on common fibular nerve that affects patient’s ability to lift the foot at the ankle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peroneal_nerve_paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>外周神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10058530</obo:OAE_0004334>
        <rdfs:label>peripheral nerve palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004704 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000205"/>
        <obo:IAO_0000115>This is an AE which is a paralysis on common fibular nerve that affects patient’s ability to lift the foot at the ankle.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Peroneal_nerve_paralysis</obo:IAO_0000119>
        <obo:OAE_0001849>外周神经麻痹性痴呆</obo:OAE_0001849>
        <obo:OAE_0004334>10071663</obo:OAE_0004334>
        <rdfs:label>peripheral nerve paresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004705 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo:IAO_0000115>This is an AE which is a nerve in the lower leg that provides sensation over the posteriolateral part of the leg and the knee joint.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Common_peroneal_nerve</obo:IAO_0000119>
        <obo:OAE_0001849>腓神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10034700</obo:OAE_0004334>
        <rdfs:label>peroneal nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004706 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000169"/>
        <obo:IAO_0000115>This is an AE which is a chronic disabling condition of the peripheral nerves, characterized by symmetrical distal numbness and paresthesia, often accompanied with pain and weakness.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/26700499/</obo:IAO_0000119>
        <obo:OAE_0001849>慢性多发性神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10064135</obo:OAE_0004334>
        <rdfs:label>polyneuropathy chronic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004707 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000169"/>
        <obo:IAO_0000115>This is an AE which is damage or disease affecting peripheral nerves (peripheral neuropathy) in roughly the same areas on both sides of the body, featuring weakness, numbness, and burning pain in malignant disease.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Polyneuropathy</obo:IAO_0000119>
        <obo:OAE_0001849>恶性疾病中的多神经病变</obo:OAE_0001849>
        <obo:OAE_0004334>10036115</obo:OAE_0004334>
        <rdfs:label>polyneuropathy in malignant disease AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004708 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000514"/>
        <obo:IAO_0000115>This is an AE which is neuropathic pain that occurs due to damage to a peripheral nerve caused by the reactivation of the varicella zoster virus (herpes zoster, also known as shingles).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Postherpetic_neuralgia</obo:IAO_0000119>
        <obo:OAE_0001849>后疱疹的神经痛</obo:OAE_0001849>
        <obo:OAE_0004334>10036376</obo:OAE_0004334>
        <rdfs:label>post herpetic neuralgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004709 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which is a nerve in the human body that supplies the posterior portion of the upper limb and its funtion get injury.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Radial_nerve</obo:IAO_0000119>
        <obo:OAE_0001849>桡神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10037749</obo:OAE_0004334>
        <rdfs:label>radial nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004710 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE whichis a problem associated with the radial nerve resulting from injury consisting of acute trauma to the radial nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Radial_nerve_dysfunction</obo:IAO_0000119>
        <obo:OAE_0001849>桡神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10037749</obo:OAE_0004334>
        <rdfs:label>radial nerve palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004711 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000514"/>
        <obo:IAO_0000115>This is an AE which is pain &quot;radiated&quot; along the dermatome (sensory distribution) of a nerve due to inflammation or other irritation of the nerve root (radiculopathy) at its connection to the spinal column.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Radicular_pain</obo:IAO_0000119>
        <obo:OAE_0001849>神经根痛</obo:OAE_0001849>
        <obo:OAE_0004334>10059604</obo:OAE_0004334>
        <rdfs:label>radicular pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004712 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <obo:IAO_0000115>This is an AE which refers to a set of conditions in which one or more nerves are affected and do not work properly (a neuropathy).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Radiculopathy</obo:IAO_0000119>
        <obo:OAE_0001849>神经根综合征</obo:OAE_0001849>
        <obo:OAE_0004334>10052442</obo:OAE_0004334>
        <rdfs:label>radicular syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004713 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002754"/>
        <obo:IAO_0000115>This is an AE which is pain &quot;radiated&quot; along the dermatome (sensory distribution) of a  brachial nerve due to inflammation or other irritation of the nerve root (radiculopathy) at its connection to the spinal column.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Radicular_pain</obo:IAO_0000119>
        <obo:OAE_0001849>臂神经根炎</obo:OAE_0001849>
        <obo:OAE_0004334>10037778</obo:OAE_0004334>
        <rdfs:label>radiculitis brachial AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004714 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002754"/>
        <obo:IAO_0000115>This is an AE which is a relatively common neurological disorder resulting from nerve root dysfunction, which is often due to mechanical compression.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25985461/</obo:IAO_0000119>
        <obo:OAE_0001849>颈神经根炎</obo:OAE_0001849>
        <obo:OAE_0004334>10050092</obo:OAE_0004334>
        <rdfs:label>radiculitis cervical AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004715 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002754"/>
        <obo:IAO_0000115>This is an AE which is one of the most common disorders evaluated by neurologists and is a leading referral diagnosis for the performance of electromyography.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/17445735/</obo:IAO_0000119>
        <obo:OAE_0001849>腰骶神经根炎</obo:OAE_0001849>
        <obo:OAE_0004334>10050085</obo:OAE_0004334>
        <rdfs:label>radiculitis lumbosacral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004716 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001212"/>
        <obo:IAO_0000115>This is an AE which refers to a set of conditions in which one or more nerves are affected and do not work properly (a neuropathy).</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Radiculopathy</obo:IAO_0000119>
        <obo:OAE_0001849>神经根病</obo:OAE_0001849>
        <obo:OAE_0004334>10037779</obo:OAE_0004334>
        <rdfs:label>radiculopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004717 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>This is an AE which a condition affecting the nerves of the peripheral sciatic nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Neuropathy_(disambiguation)</obo:IAO_0000119>
        <obo:OAE_0001849>坐骨神经神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10048950</obo:OAE_0004334>
        <rdfs:label>sciatic nerve neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004718 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is a large nerve in humans and other vertebrate animals which is the largest branch of the sacral plexus and runs alongside the hip joint and down the lower limb and it maybe palsy.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sciatic_nerve</obo:IAO_0000119>
        <obo:OAE_0001849>坐骨神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10039672</obo:OAE_0004334>
        <rdfs:label>sciatic nerve palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004719 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>This is an AE which has been traditionally considered presenting with symptoms reflecting the length-dependent  impairment of unmyelinated C and thinly myelinated A@ fibres, most commonly reported as burning feet.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28665811/</obo:IAO_0000119>
        <obo:OAE_0001849>小纤维神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10073928</obo:OAE_0004334>
        <rdfs:label>small fibre neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004720 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000169"/>
        <obo:IAO_0000115>This is an AE which is a rapid-onset muscle weakness caused by the immune system damaging the peripheral nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Guillain%E2%80%93Barr%C3%A9_syndrome#Clinical_subtypes</obo:IAO_0000119>
        <obo:OAE_0001849>亚急性炎性脱髓鞘性多发性神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10081726</obo:OAE_0004334>
        <rdfs:label>subacute inflammatory demyelinating polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004721 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which refers to damage to sympathetic nerve beyond the capability to repair.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Destruction</obo:IAO_0000119>
        <obo:OAE_0001849>交感神经破坏</obo:OAE_0001849>
        <obo:OAE_0004334>10042740</obo:OAE_0004334>
        <rdfs:label>sympathetic nerve destruction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004722 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <obo:IAO_0000115>This is an AE which is one of two divisions of the autonomic nervous system, along with the parasympathetic nervous system.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Sympathetic_nervous_system#Sympathicotonia</obo:IAO_0000119>
        <obo:OAE_0001849>交感神经症</obo:OAE_0001849>
        <obo:OAE_0004334>10051691</obo:OAE_0004334>
        <rdfs:label>sympathicotonia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004723 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <obo:IAO_0000115>This is an AE which includes those caused by industrial toxins (organic solvents and organophosphates), heavy metals (arsenic, thallium, and lead), drugs and alcohol.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/21897232/</obo:IAO_0000119>
        <obo:OAE_0001849>中毒性神经病</obo:OAE_0001849>
        <obo:OAE_0004334>10067722</obo:OAE_0004334>
        <rdfs:label>toxic neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004724 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004724">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002635"/>
        <obo:IAO_0000115>This is an AE which is a condition typified by a weakness of voluntary movement, or by partial loss of voluntary movement or by impaired movement caused by trigeminal nerve.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Paresis</obo:IAO_0000119>
        <obo:OAE_0001849>三叉神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10068008</obo:OAE_0004334>
        <rdfs:label>trigeminal nerve paresis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004725 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002635"/>
        <obo:IAO_0000115>This is an AE which refers to various types of paralysis, often accompanied by weakness and the loss of feeling and uncontrolled body movements such as shaking and occurs on trigeminal.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>http://en.volupedia.org/wiki/Palsy</obo:IAO_0000119>
        <obo:OAE_0001849>三叉神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10049788</obo:OAE_0004334>
        <rdfs:label>trigeminal palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004726 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <obo:IAO_0000115>This is an AE which takes three clinical forms: meningitis (TBM), intracranial tuberculoma, and spinal arachnoiditis.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/28281443/</obo:IAO_0000119>
        <obo:OAE_0001849>中枢神经系统结核</obo:OAE_0001849>
        <obo:OAE_0004334>10061391</obo:OAE_0004334>
        <rdfs:label>tuberculosis of central nervous system AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004727 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <obo:IAO_0000115>This is an AE which result in both sensory and motor deficits within the hand.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/25442770/</obo:IAO_0000119>
        <obo:OAE_0001849>尺神经损伤</obo:OAE_0001849>
        <obo:OAE_0004334>10045378</obo:OAE_0004334>
        <rdfs:label>ulnar nerve injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004728 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0004344"/>
        <obo:IAO_0000115>This is an AE which is a chronic clinical condition characterized by a delayed onset ulnar neuropathy after an injury to the elbow.</obo:IAO_0000115>
        <obo:IAO_0000117>QY, JX, HY</obo:IAO_0000117>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30939566/</obo:IAO_0000119>
        <obo:OAE_0001849>尺神经麻痹</obo:OAE_0001849>
        <obo:OAE_0004334>10059790</obo:OAE_0004334>
        <rdfs:label>ulnar nerve palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0004729 -->


